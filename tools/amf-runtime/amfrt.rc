#include <winver.h>
// The AMF version it implements (amf/core/Version.h): Windows' file copy compares it with an installed runtime and
// never replaces a newer one (the driver's INF copies it with COPYFLG_NO_VERSION_DIALOG)
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,4,36,0
PRODUCTVERSION 1,4,36,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "WinBoat"
      VALUE "FileDescription", "AMF runtime for WinBoat's virtual GPU (encoding on Vulkan Video)"
      VALUE "FileVersion", "1.4.36.0"
      VALUE "OriginalFilename", "amfrt64.dll"
      VALUE "ProductName", "WinBoat"
      VALUE "ProductVersion", "1.4.36.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
