+/*
+ * WinBoat: Vulkan presents through Direct3D 11 for Venus (wsi_common_win32_d3d11.cpp)
+ */
+#ifndef WSI_COMMON_WIN32_D3D11_H
+#define WSI_COMMON_WIN32_D3D11_H
+
+#include <windows.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <vulkan/vulkan_core.h>
+
+/* A window surface's Direct3D 11 device, DXGI swap chain and kernel device */
+struct wsi_win32_d3d11;
+
+struct wsi_win32_d3d11 *wsi_win32_d3d11_create(HWND hwnd);
+void wsi_win32_d3d11_destroy(struct wsi_win32_d3d11 *d);
+bool wsi_win32_d3d11_resize(struct wsi_win32_d3d11 *d, uint32_t width, uint32_t height);
+/* an ID3D11Texture2D (shared, RGBA8) and its host resource id */
+void *wsi_win32_d3d11_texture(struct wsi_win32_d3d11 *d, uint32_t width, uint32_t height, uint32_t *res_id);
+void wsi_win32_d3d11_texture_release(void *texture);
+bool wsi_win32_d3d11_present(struct wsi_win32_d3d11 *d, void *texture, VkPresentModeKHR mode);
+
+#endif
