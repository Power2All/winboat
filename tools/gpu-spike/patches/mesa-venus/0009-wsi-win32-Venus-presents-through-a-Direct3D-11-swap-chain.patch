+/* WinBoat: Venus presents through Direct3D 11 where it can (wsi_common_win32_d3d11.cpp): an 8-bit RGBA/BGRA
+ * swapchain of one layer, the window's device and DXGI swap chain made (or resized) for it */
+static bool
+wsi_win32_d3d11_usable(struct wsi_win32 *wsi, wsi_win32_surface *surface, const VkSwapchainCreateInfoKHR *create_info)
+{
+   if (!wsi->venus || surface->d3d11_failed || create_info->imageArrayLayers != 1)
+      return false;
+   switch (create_info->imageFormat) {
+   case VK_FORMAT_B8G8R8A8_UNORM:
+   case VK_FORMAT_B8G8R8A8_SRGB:
+   case VK_FORMAT_R8G8B8A8_UNORM:
+   case VK_FORMAT_R8G8B8A8_SRGB:
+      break;
+   default:
+      return false;
+   }
+   if (!surface->d3d11)
+      surface->d3d11 = wsi_win32_d3d11_create(surface->base.hwnd);
+   return surface->d3d11 &&
+          wsi_win32_d3d11_resize(surface->d3d11, create_info->imageExtent.width, create_info->imageExtent.height);
+}
+
+static VkResult
+wsi_win32_surface_create_swapchain(
+   VkIcdSurfaceBase *icd_surface,
+   VkDevice device,
+   struct wsi_device *wsi_device,
+   const VkSwapchainCreateInfoKHR *create_info,
+   const VkAllocationCallbacks *allocator,
+   struct wsi_swapchain **swapchain_out)
+{
+   wsi_win32_surface *surface = (wsi_win32_surface *)icd_surface;
+   struct wsi_win32 *wsi = (struct wsi_win32 *)wsi_device->wsi[VK_ICD_WSI_PLATFORM_WIN32];
+
+   if (wsi_win32_d3d11_usable(wsi, surface, create_info)) {
+      VkResult result = wsi_win32_surface_create_swapchain_impl(icd_surface, device, wsi_device, create_info, allocator,
+                                                                swapchain_out, true);
+      if (result == VK_SUCCESS)
+         return result;
+      /* something missing (a host without Vulkan-backed shared textures: Venus' import fails): the copying path
+       * for this surface from now on, without the window's DXGI swap chain, so GDI's drawing shows */
+      wsi_win32_d3d11_destroy(surface->d3d11);
+      surface->d3d11 = NULL;
+      surface->d3d11_failed = true;
+   }
+   return wsi_win32_surface_create_swapchain_impl(icd_surface, device, wsi_device, create_info, allocator,
+                                                  swapchain_out, false);
+}
+
 static IDXGIFactory4 *
 dxgi_get_factory(bool debug)
 {
@@ -1220,6 +1386,12 @@ wsi_win32_init_wsi(struct wsi_device *wsi_device,
    wsi->physical_device = physical_device;
    wsi->alloc = alloc;
    wsi->wsi = wsi_device;
+   {
+      /* WINBOAT_VK_PRESENT=copy: the copying path (presents through the CPU) as before */
+      VK_FROM_HANDLE(vk_physical_device, pdevice, physical_device);
+      const char *present = getenv("WINBOAT_VK_PRESENT");
+      wsi->venus = pdevice->properties.driverID == VK_DRIVER_ID_MESA_VENUS && !(present && !strcmp(present, "copy"));
+   }
 
    if (!wsi_device->sw) {
       wsi->dxgi.factory = dxgi_get_factory(WSI_DEBUG & WSI_DEBUG_DXGI);
diff --git a/src/vulkan/wsi/wsi_common_win32_d3d11.cpp b/src/vulkan/wsi/wsi_common_win32_d3d11.cpp
new file mode 100644
index 0000000..13e3154
--- /dev/null
+++ b/src/vulkan/wsi/wsi_common_win32_d3d11.cpp
@@ -0,0 +1,308 @@
+/*
+ * WinBoat: Vulkan presents through Direct3D 11 for Venus (wsi_common_win32.cpp's d3d11 path).
+ *
+ * Venus has no Direct3D 12 queue for DXGI, so its presents went through the CPU: the frame read back into memory
+ * and drawn with GDI (StretchDIBits), ~1 ms a frame at 1080p and more with the size. The GPU driver's own Direct3D 11
+ * driver has a DXGI swap chain for the window instead; each swapchain image gets a shared Direct3D 11 texture whose
+ * host storage is Vulkan memory (VIRGL_BIND_VK_SHARED, the host's VIRGL_CAP_V2_VK_SHARED) that Venus imports by its
+ * host resource id. A present blits the app's image into it on the app's queue, then copies it into the swap chain's
+ * buffer and presents, all on the host's GPU.
+ *
+ * Kept apart from wsi_common_win32.cpp: that file has DirectX-Headers' d3d12.h, this one the SDK's d3d11.h.
+ */
+
+#include <windows.h>
+#include <winternl.h>
+#include <d3dkmthk.h>
+#include <d3d11.h>
+#include <dxgi1_5.h>
+
+#include <stdint.h>
+#include <stdlib.h>
+
+#include "wsi_common_win32_d3d11.h"
+
+/* The kernel driver's escape: an allocation's host resource id (viogpu_wddm_driver.h's VIOGPU_RES_INFO) */
+#pragma pack(push, 1)
+struct viogpu_res_info_escape {
+   USHORT Type;
+   USHORT DataLength;
+   D3DKMT_HANDLE ResHandle;
+   ULONG Id;
+};
+#pragma pack(pop)
+#define VIOGPU_RES_INFO 0x100
+
+typedef NTSTATUS(APIENTRY *PFN_OpenAdapterFromLuid)(D3DKMT_OPENADAPTERFROMLUID *);
+typedef NTSTATUS(APIENTRY *PFN_CloseAdapter)(const D3DKMT_CLOSEADAPTER *);
+typedef NTSTATUS(APIENTRY *PFN_CreateDevice)(D3DKMT_CREATEDEVICE *);
+typedef NTSTATUS(APIENTRY *PFN_DestroyDevice)(const D3DKMT_DESTROYDEVICE *);
+typedef NTSTATUS(APIENTRY *PFN_QueryResourceInfo)(D3DKMT_QUERYRESOURCEINFO *);
+typedef NTSTATUS(APIENTRY *PFN_OpenResource)(D3DKMT_OPENRESOURCE *);
+typedef NTSTATUS(APIENTRY *PFN_DestroyAllocation)(const D3DKMT_DESTROYALLOCATION *);
+typedef NTSTATUS(APIENTRY *PFN_Escape)(const D3DKMT_ESCAPE *);
+
+struct wsi_win32_d3d11 {
+   SRWLOCK lock;
+   ID3D11Device *dev;
+   ID3D11DeviceContext *ctx;
+   IDXGIFactory2 *factory;
+   IDXGISwapChain1 *swapchain;
+   HWND hwnd;
+   UINT width, height;
+   bool tearing;
+   D3DKMT_HANDLE adapter, device;
+   PFN_CloseAdapter CloseAdapter;
+   PFN_DestroyDevice DestroyDevice;
+   PFN_QueryResourceInfo QueryResourceInfo;
+   PFN_OpenResource OpenResource;
+   PFN_DestroyAllocation DestroyAllocation;
+   PFN_Escape Escape;
+};
+
+void
+wsi_win32_d3d11_destroy(struct wsi_win32_d3d11 *d)
+{
+   if (!d)
+      return;
+   if (d->swapchain)
+      d->swapchain->Release();
+   if (d->ctx)
+      d->ctx->Release();
+   if (d->factory)
+      d->factory->Release();
+   if (d->dev)
+      d->dev->Release();
+   if (d->device) {
+      D3DKMT_DESTROYDEVICE destroy = {};
+      destroy.hDevice = d->device;
+      d->DestroyDevice(&destroy);
+   }
+   if (d->adapter) {
+      D3DKMT_CLOSEADAPTER close = {};
+      close.hAdapter = d->adapter;
+      d->CloseAdapter(&close);
+   }
+   free(d);
+}
+
+struct wsi_win32_d3d11 *
+wsi_win32_d3d11_create(HWND hwnd)
+{
+   HMODULE gdi = GetModuleHandleA("gdi32.dll");
+   HMODULE d3d11 = LoadLibraryA("d3d11.dll");
+   if (!gdi || !d3d11)
+      return NULL;
+   PFN_D3D11_CREATE_DEVICE create_device = (PFN_D3D11_CREATE_DEVICE)GetProcAddress(d3d11, "D3D11CreateDevice");
+   PFN_OpenAdapterFromLuid open_adapter = (PFN_OpenAdapterFromLuid)GetProcAddress(gdi, "D3DKMTOpenAdapterFromLuid");
+   PFN_CreateDevice create_kmt_device = (PFN_CreateDevice)GetProcAddress(gdi, "D3DKMTCreateDevice");
+
+   struct wsi_win32_d3d11 *d = (struct wsi_win32_d3d11 *)calloc(1, sizeof(*d));
+   if (!d || !create_device || !open_adapter || !create_kmt_device)
+      goto fail;
+   InitializeSRWLock(&d->lock);
+   d->hwnd = hwnd;
+   d->CloseAdapter = (PFN_CloseAdapter)GetProcAddress(gdi, "D3DKMTCloseAdapter");
+   d->DestroyDevice = (PFN_DestroyDevice)GetProcAddress(gdi, "D3DKMTDestroyDevice");
+   d->QueryResourceInfo = (PFN_QueryResourceInfo)GetProcAddress(gdi, "D3DKMTQueryResourceInfo");
+   d->OpenResource = (PFN_OpenResource)GetProcAddress(gdi, "D3DKMTOpenResource");
+   d->DestroyAllocation = (PFN_DestroyAllocation)GetProcAddress(gdi, "D3DKMTDestroyAllocation");
+   d->Escape = (PFN_Escape)GetProcAddress(gdi, "D3DKMTEscape");
+   if (!d->CloseAdapter || !d->DestroyDevice || !d->QueryResourceInfo || !d->OpenResource || !d->DestroyAllocation ||
+       !d->Escape)
+      goto fail;
+
+   {
+      const D3D_FEATURE_LEVEL levels[] = {D3D_FEATURE_LEVEL_11_0, D3D_FEATURE_LEVEL_10_0};
+      if (FAILED(create_device(NULL, D3D_DRIVER_TYPE_HARDWARE, NULL, 0, levels, 2, D3D11_SDK_VERSION, &d->dev, NULL,
+                               &d->ctx)))
+         goto fail;
+      IDXGIDevice *dxgi_device = NULL;
+      IDXGIAdapter *adapter = NULL;
+      DXGI_ADAPTER_DESC desc = {};
+      bool ok = SUCCEEDED(d->dev->QueryInterface(IID_PPV_ARGS(&dxgi_device))) &&
+                SUCCEEDED(dxgi_device->GetAdapter(&adapter)) && SUCCEEDED(adapter->GetDesc(&desc)) &&
+                SUCCEEDED(adapter->GetParent(IID_PPV_ARGS(&d->factory)));
+      if (adapter)
+         adapter->Release();
+      if (dxgi_device)
+         dxgi_device->Release();
+      if (!ok)
+         goto fail;
+
+      /* tearing (IMMEDIATE) where DXGI has it */
+      IDXGIFactory5 *factory5 = NULL;
+      BOOL tearing = FALSE;
+      if (SUCCEEDED(d->factory->QueryInterface(IID_PPV_ARGS(&factory5)))) {
+         d->tearing = SUCCEEDED(factory5->CheckFeatureSupport(DXGI_FEATURE_PRESENT_ALLOW_TEARING, &tearing,
+                                                              sizeof(tearing))) &&
+                      tearing;
+         factory5->Release();
+      }
+
+      /* a kernel device of this process's on the adapter: opening the shared textures to name them to Venus */
+      D3DKMT_OPENADAPTERFROMLUID open = {};
+      open.AdapterLuid = desc.AdapterLuid;
+      if (open_adapter(&open) < 0)
+         goto fail;
+      d->adapter = open.hAdapter;
+      D3DKMT_CREATEDEVICE create = {};
+      create.hAdapter = d->adapter;
+      if (create_kmt_device(&create) < 0)
+         goto fail;
+      d->device = create.hDevice;
+   }
+   return d;
+
+fail:
+   wsi_win32_d3d11_destroy(d);
+   return NULL;
+}
+
+/* The window's swap chain, of the swapchain's size (DXGI stretches it to the window): made the first time, resized
+ * after (one flip-model swap chain per window, which a new Vulkan swapchain for the same surface takes over) */
+bool
+wsi_win32_d3d11_resize(struct wsi_win32_d3d11 *d, uint32_t width, uint32_t height)
+{
+   AcquireSRWLockExclusive(&d->lock);
+   bool ok = true;
+   UINT flags = d->tearing ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0;
+   if (!d->swapchain) {
+      DXGI_SWAP_CHAIN_DESC1 desc = {};
+      desc.Width = width;
+      desc.Height = height;
+      desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+      desc.SampleDesc.Count = 1;
+      desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+      desc.BufferCount = 2;
+      desc.Scaling = DXGI_SCALING_STRETCH;
+      desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+      desc.AlphaMode = DXGI_ALPHA_MODE_IGNORE;
+      desc.Flags = flags;
+      ok = SUCCEEDED(d->factory->CreateSwapChainForHwnd(d->dev, d->hwnd, &desc, NULL, NULL, &d->swapchain));
+   } else if (width != d->width || height != d->height) {
+      ok = SUCCEEDED(d->swapchain->ResizeBuffers(0, width, height, DXGI_FORMAT_UNKNOWN, flags));
+   }
+   if (ok) {
+      d->width = width;
+      d->height = height;
+   }
+   ReleaseSRWLockExclusive(&d->lock);
+   return ok;
+}
+
+/* A shared RGBA8 texture whose host storage Venus can import, and its host resource id; NULL where that isn't so
+ * (the host or the driver without VIRGL_BIND_VK_SHARED: the id comes back, but Venus' import fails) */
+void *
+wsi_win32_d3d11_texture(struct wsi_win32_d3d11 *d, uint32_t width, uint32_t height, uint32_t *res_id)
+{
+   *res_id = 0;
+   D3D11_TEXTURE2D_DESC desc = {};
+   desc.Width = width;
+   desc.Height = height;
+   desc.MipLevels = 1;
+   desc.ArraySize = 1;
+   desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+   desc.SampleDesc.Count = 1;
+   desc.Usage = D3D11_USAGE_DEFAULT;
+   desc.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+   desc.MiscFlags = D3D11_RESOURCE_MISC_SHARED;
+
+   AcquireSRWLockExclusive(&d->lock);
+   ID3D11Texture2D *texture = NULL;
+   IDXGIResource *resource = NULL;
+   HANDLE shared = NULL;
+   bool ok = SUCCEEDED(d->dev->CreateTexture2D(&desc, NULL, &texture)) &&
+             SUCCEEDED(texture->QueryInterface(IID_PPV_ARGS(&resource))) &&
+             SUCCEEDED(resource->GetSharedHandle(&shared)) && shared;
+   if (resource)
+      resource->Release();
+   /* the allocation is made when the runtime flushes the creation */
+   if (ok)
+      d->ctx->Flush();
+
+   /* its allocation, opened on this process's kernel device, named by the kernel driver */
+   if (ok) {
+      D3DKMT_QUERYRESOURCEINFO query = {};
+      query.hDevice = d->device;
+      query.hGlobalShare = (D3DKMT_HANDLE)(uintptr_t)shared;
+      ok = d->QueryResourceInfo(&query) >= 0 && query.NumAllocations >= 1;
+      void *runtime = ok ? calloc(1, query.PrivateRuntimeDataSize + 1) : NULL;
+      void *resource_data = ok ? calloc(1, query.ResourcePrivateDriverDataSize + 1) : NULL;
+      void *total = ok ? calloc(1, query.TotalPrivateDriverDataSize + 1) : NULL;
+      D3DDDI_OPENALLOCATIONINFO *allocations =
+         ok ? (D3DDDI_OPENALLOCATIONINFO *)calloc(query.NumAllocations, sizeof(*allocations)) : NULL;
+      D3DKMT_OPENRESOURCE open = {};
+      ok = ok && runtime && resource_data && total && allocations;
+      if (ok) {
+         open.hDevice = d->device;
+         open.hGlobalShare = query.hGlobalShare;
+         open.NumAllocations = query.NumAllocations;
+         open.pOpenAllocationInfo = allocations;
+         open.pPrivateRuntimeData = runtime;
+         open.PrivateRuntimeDataSize = query.PrivateRuntimeDataSize;
+         open.pResourcePrivateDriverData = resource_data;
+         open.ResourcePrivateDriverDataSize = query.ResourcePrivateDriverDataSize;
+         open.pTotalPrivateDriverDataBuffer = total;
+         open.TotalPrivateDriverDataBufferSize = query.TotalPrivateDriverDataSize;
+         ok = d->OpenResource(&open) >= 0;
+      }
+      if (ok) {
+         struct viogpu_res_info_escape info = {};
+         info.Type = VIOGPU_RES_INFO;
+         info.DataLength = sizeof(info.ResHandle) + sizeof(info.Id);
+         info.ResHandle = allocations[0].hAllocation;
+         D3DKMT_ESCAPE escape = {};
+         escape.hAdapter = d->adapter;
+         escape.hDevice = d->device;
+         escape.Type = D3DKMT_ESCAPE_DRIVERPRIVATE;
+         escape.pPrivateDriverData = &info;
+         escape.PrivateDriverDataSize = sizeof(info);
+         ok = d->Escape(&escape) >= 0 && info.Id;
+         *res_id = info.Id;
+         /* the texture keeps the allocation: this process's opening of it goes */
+         D3DKMT_DESTROYALLOCATION destroy = {};
+         destroy.hDevice = d->device;
+         destroy.hResource = open.hResource;
+         d->DestroyAllocation(&destroy);
+      }
+      free(runtime);
+      free(resource_data);
+      free(total);
+      free(allocations);
+   }
+   ReleaseSRWLockExclusive(&d->lock);
+   if (!ok && texture) {
+      texture->Release();
+      texture = NULL;
+   }
+   return texture;
+}
+
+void
+wsi_win32_d3d11_texture_release(void *texture)
+{
+   if (texture)
+      ((ID3D11Texture2D *)texture)->Release();
+}
+
+/* The texture (drawn: the app's queue blitted into it, and the caller waited for that) into the swap chain's buffer,
+ * presented. FIFO waits for the vertical blank; MAILBOX doesn't, the newest frame replaces the waiting one;
+ * IMMEDIATE tears where DXGI allows it */
+bool
+wsi_win32_d3d11_present(struct wsi_win32_d3d11 *d, void *texture, VkPresentModeKHR mode)
+{
+   AcquireSRWLockExclusive(&d->lock);
+   ID3D11Texture2D *buffer = NULL;
+   bool ok = d->swapchain && SUCCEEDED(d->swapchain->GetBuffer(0, IID_PPV_ARGS(&buffer)));
+   if (ok) {
+      d->ctx->CopyResource(buffer, (ID3D11Texture2D *)texture);
+      buffer->Release();
+      UINT interval = mode == VK_PRESENT_MODE_FIFO_KHR || mode == VK_PRESENT_MODE_FIFO_RELAXED_KHR ? 1 : 0;
+      UINT flags = mode == VK_PRESENT_MODE_IMMEDIATE_KHR && d->tearing ? DXGI_PRESENT_ALLOW_TEARING : 0;
+      HRESULT hr = d->swapchain->Present(interval, flags);
+      ok = SUCCEEDED(hr) || hr == DXGI_STATUS_OCCLUDED;
+   }
+   ReleaseSRWLockExclusive(&d->lock);
+   return ok;
+}
