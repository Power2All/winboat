+/* Venus' VkImportMemoryResourceInfoMESA: the memory of a host resource (the shared texture's) */
+#define WSI_STRUCTURE_TYPE_IMPORT_MEMORY_RESOURCE_INFO_MESA ((VkStructureType)1000384002)
+struct wsi_import_memory_resource_info_mesa {
+   VkStructureType sType;
+   const void *pNext;
+   uint32_t resourceId;
+};
+
+/* WinBoat: an image of a swapchain presenting through Direct3D 11 (Venus): the app's image, and as the blit's
+ * destination a Venus image on a shared Direct3D 11 texture's host storage, of the host's parameters for it (RGBA8,
+ * mutable format, optimal tiling: virglrenderer's VREND_VK_IMAGE_USAGE; the sRGB view for sRGB images, so the blit
+ * keeps their encoding) */
+static VkResult
+wsi_create_venus_d3d11_image_mem(const struct wsi_swapchain *drv_chain,
+                                 const struct wsi_image_info *info,
+                                 struct wsi_image *image)
+{
+   struct wsi_win32_swapchain *chain = (struct wsi_win32_swapchain *)drv_chain;
+   const struct wsi_device *wsi = chain->base.wsi;
+   struct wsi_win32_image *win32_image = container_of(image, struct wsi_win32_image, base);
+
+   uint32_t res_id = 0;
+   win32_image->d3d11_texture = wsi_win32_d3d11_texture(chain->surface->d3d11, info->create.extent.width,
+                                                        info->create.extent.height, &res_id);
+   if (!win32_image->d3d11_texture)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   const VkExternalMemoryImageCreateInfo external = {
+      VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO, NULL, VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   VkImageCreateInfo create = {};
+   create.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+   create.pNext = &external;
+   create.flags = VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT;
+   create.imageType = VK_IMAGE_TYPE_2D;
+   create.format = info->blit_dst_format;
+   create.extent = info->create.extent;
+   create.mipLevels = 1;
+   create.arrayLayers = 1;
+   create.samples = VK_SAMPLE_COUNT_1_BIT;
+   create.tiling = VK_IMAGE_TILING_OPTIMAL;
+   create.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+                  VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+   create.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+   VkResult result = wsi->CreateImage(chain->base.device, &create, &chain->base.alloc, &image->blit.image);
+   if (result != VK_SUCCESS)
+      return result;
+
+   VkMemoryRequirements reqs;
+   wsi->GetImageMemoryRequirements(chain->base.device, image->blit.image, &reqs);
+   const struct wsi_import_memory_resource_info_mesa import = {
+      WSI_STRUCTURE_TYPE_IMPORT_MEMORY_RESOURCE_INFO_MESA, NULL, res_id,
+   };
+   const VkMemoryDedicatedAllocateInfo dedicated = {
+      VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO, &import, image->blit.image, VK_NULL_HANDLE,
+   };
+   const VkMemoryAllocateInfo import_info = {
+      VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, &dedicated, reqs.size,
+      wsi_select_device_memory_type(wsi, reqs.memoryTypeBits),
+   };
+   result = wsi->AllocateMemory(chain->base.device, &import_info, &chain->base.alloc, &image->blit.memory);
+   if (result != VK_SUCCESS)
+      return result;
+   result = wsi->BindImageMemory(chain->base.device, image->blit.image, image->blit.memory, 0);
+   if (result != VK_SUCCESS)
+      return result;
+
+   /* the app's image */
+   wsi->GetImageMemoryRequirements(chain->base.device, image->image, &reqs);
+   const VkMemoryDedicatedAllocateInfo memory_dedicated_info = {
+      VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO, NULL, image->image, VK_NULL_HANDLE,
+   };
+   const VkMemoryAllocateInfo memory_info = {
+      VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, &memory_dedicated_info, reqs.size,
+      info->select_image_memory_type(wsi, reqs.memoryTypeBits),
+   };
+   return wsi->AllocateMemory(chain->base.device, &memory_info, &chain->base.alloc, &image->memory);
+}
