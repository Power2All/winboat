@@ -193,6 +193,7 @@ wsi_device_init(struct wsi_device *wsi,
    WSI_GET_CB(BindImageMemory);
    WSI_GET_CB(BeginCommandBuffer);
    WSI_GET_CB(CmdPipelineBarrier);
+   WSI_GET_CB(CmdBlitImage);
    WSI_GET_CB(CmdCopyImage);
    WSI_GET_CB(CmdCopyImageToBuffer);
    WSI_GET_CB(CmdResetQueryPool);
@@ -3380,12 +3381,30 @@ wsi_cmd_blit_image_to_image(VkCommandBuffer cmd_buffer,
       .dstOffset = { .x = 0, .y = 0, .z = 0 },
       .extent = info->create.extent,
    };
-   wsi->CmdCopyImage(cmd_buffer,
-                     image->image,
-                     VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
-                     image->blit.image,
-                     VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
-                     1, &image_copy);
+   if (info->blit_dst_format != VK_FORMAT_UNDEFINED && info->blit_dst_format != info->create.format) {
+      /* another format (BGRA into RGBA): a blit converts, a copy would keep the bytes */
+      const VkImageBlit image_blit = {
+         .srcSubresource = image_copy.srcSubresource,
+         .srcOffsets = { { 0, 0, 0 },
+                         { (int32_t)info->create.extent.width, (int32_t)info->create.extent.height, 1 } },
+         .dstSubresource = image_copy.dstSubresource,
+         .dstOffsets = { { 0, 0, 0 },
+                         { (int32_t)info->create.extent.width, (int32_t)info->create.extent.height, 1 } },
+      };
+      wsi->CmdBlitImage(cmd_buffer,
+                        image->image,
+                        VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                        image->blit.image,
+                        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                        1, &image_blit, VK_FILTER_NEAREST);
+   } else {
+      wsi->CmdCopyImage(cmd_buffer,
+                        image->image,
+                        VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                        image->blit.image,
+                        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                        1, &image_copy);
+   }
 
    img_mem_barriers[0].srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
    img_mem_barriers[0].dstAccessMask = 0;
