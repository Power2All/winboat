+struct vn_video_session_parameters {
+   struct vn_object_base base;
+};
+VK_DEFINE_NONDISP_HANDLE_CASTS(vn_video_session_parameters,
+                               base.vk,
+                               VkVideoSessionParametersKHR,
+                               VK_OBJECT_TYPE_VIDEO_SESSION_PARAMETERS_KHR)
+
+#endif /* VN_VIDEO_H */
