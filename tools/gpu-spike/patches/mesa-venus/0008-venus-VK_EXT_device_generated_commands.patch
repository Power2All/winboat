new file mode 100644
index 0000000..8c03ba2
--- /dev/null
+++ b/src/virtio/vulkan/vn_generated_commands.c
@@ -0,0 +1,115 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* VK_EXT_device_generated_commands: indirect commands layouts, passed through. Indirect execution sets aren't
+ * (the physical device reports no stage bindable through them) */
+
+#include "vn_generated_commands.h"
+
+#include "venus-protocol/vn_protocol_driver_transport.h"
+
+#include "vn_device.h"
+
+VKAPI_ATTR VkResult VKAPI_CALL
+vn_CreateIndirectCommandsLayoutEXT(
+   VkDevice device,
+   const VkIndirectCommandsLayoutCreateInfoEXT *pCreateInfo,
+   const VkAllocationCallbacks *pAllocator,
+   VkIndirectCommandsLayoutEXT *pIndirectCommandsLayout)
+{
+   struct vn_device *dev = vn_device_from_handle(device);
+   const VkAllocationCallbacks *alloc =
+      pAllocator ? pAllocator : &dev->base.vk.alloc;
+
+   struct vn_indirect_commands_layout *layout =
+      vk_zalloc(alloc, sizeof(*layout), VN_DEFAULT_ALIGN,
+                VK_SYSTEM_ALLOCATION_SCOPE_OBJECT);
+   if (!layout)
+      return vn_error(dev->instance, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   vn_object_base_init(&layout->base,
+                       VK_OBJECT_TYPE_INDIRECT_COMMANDS_LAYOUT_EXT,
+                       &dev->base);
+
+   VkIndirectCommandsLayoutEXT layout_handle =
+      vn_indirect_commands_layout_to_handle(layout);
+   vn_async_vkCreateIndirectCommandsLayoutEXT(dev->primary_ring, device,
+                                              pCreateInfo, NULL,
+                                              &layout_handle);
+
+   *pIndirectCommandsLayout = layout_handle;
+
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+vn_DestroyIndirectCommandsLayoutEXT(
+   VkDevice device,
+   VkIndirectCommandsLayoutEXT indirectCommandsLayout,
+   const VkAllocationCallbacks *pAllocator)
+{
+   struct vn_device *dev = vn_device_from_handle(device);
+   struct vn_indirect_commands_layout *layout =
+      vn_indirect_commands_layout_from_handle(indirectCommandsLayout);
+   const VkAllocationCallbacks *alloc =
+      pAllocator ? pAllocator : &dev->base.vk.alloc;
+
+   if (!layout)
+      return;
+
+   vn_async_vkDestroyIndirectCommandsLayoutEXT(dev->primary_ring, device,
+                                               indirectCommandsLayout, NULL);
+
+   vn_object_base_fini(&layout->base);
+   vk_free(alloc, layout);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+vn_GetGeneratedCommandsMemoryRequirementsEXT(
+   VkDevice device,
+   const VkGeneratedCommandsMemoryRequirementsInfoEXT *pInfo,
+   VkMemoryRequirements2 *pMemoryRequirements)
+{
+   struct vn_device *dev = vn_device_from_handle(device);
+
+   vn_call_vkGetGeneratedCommandsMemoryRequirementsEXT(
+      dev->primary_ring, device, pInfo, pMemoryRequirements);
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+vn_CreateIndirectExecutionSetEXT(
+   VkDevice device,
+   const VkIndirectExecutionSetCreateInfoEXT *pCreateInfo,
+   const VkAllocationCallbacks *pAllocator,
+   VkIndirectExecutionSetEXT *pIndirectExecutionSet)
+{
+   struct vn_device *dev = vn_device_from_handle(device);
+   return vn_error(dev->instance, VK_ERROR_FEATURE_NOT_PRESENT);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+vn_DestroyIndirectExecutionSetEXT(VkDevice device,
+                                  VkIndirectExecutionSetEXT indirectExecutionSet,
+                                  const VkAllocationCallbacks *pAllocator)
+{
+}
+
+VKAPI_ATTR void VKAPI_CALL
+vn_UpdateIndirectExecutionSetPipelineEXT(
+   VkDevice device,
+   VkIndirectExecutionSetEXT indirectExecutionSet,
+   uint32_t executionSetWriteCount,
+   const VkWriteIndirectExecutionSetPipelineEXT *pExecutionSetWrites)
+{
+}
+
+VKAPI_ATTR void VKAPI_CALL
+vn_UpdateIndirectExecutionSetShaderEXT(
+   VkDevice device,
+   VkIndirectExecutionSetEXT indirectExecutionSet,
+   uint32_t executionSetWriteCount,
+   const VkWriteIndirectExecutionSetShaderEXT *pExecutionSetWrites)
+{
+}
