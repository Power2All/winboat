+#pragma once
+
+#include <d3dkmthk.h>
+
+
+#pragma pack(1)
+typedef struct _VIOGPU_BOX {
+    ULONG x;
+    ULONG y;
+    ULONG z;
+    ULONG width;
+    ULONG height;
+    ULONG depth;
+} VIOGPU_BOX;
+#pragma pack()
+
+// ================= QueryAdapterInfo UMDRIVERPRIVATE
+#define VIOGPU_IAM 0x56696f475055 // Identified for queryadapterinfo (VioGPU as hex)
+
+typedef struct _VIOGPU_ADAPTERINFO {
+    ULONGLONG IamVioGPU; // Should be set by driver to VIOGPU_IAM
+    struct {
+        UINT Supports3d : 1;
+        UINT SupportsBlob : 1; // Venus: blob resources with a host-visible memory window (VIOGPU_BLOB_*)
+        UINT Wddm2 : 1;        // a WDDM 2.0 kernel driver: user-mode drivers make their allocations resident
+        UINT Reserved : 29;
+    } Flags;
+    ULONGLONG SupportedCapsetIDs;
+} VIOGPU_ADAPTERINFO;
+
+// ================= ESCAPES
+#define VIOGPU_GET_DEVICE_ID                              0x000
+#define VIOGPU_GET_CUSTOM_RESOLUTION                      0x001
+#define VIOGPU_GET_CAPS                                   0x002
+
+#define VIOGPU_RES_INFO                                   0x100
+#define VIOGPU_RES_BUSY                                   0x101
+
+#define VIOGPU_CTX_INIT                                   0x200
+
+#define VIOGPU_BLOB_CREATE           0x300
+#define VIOGPU_BLOB_MAP              0x301
+#define VIOGPU_BLOB_DESTROY          0x302
+#define VIOGPU_EXECBUFFER            0x303
+
+
+#pragma pack(1)
+typedef struct _VIOGPU_DISP_MODE {
+    USHORT XResolution;
+    USHORT YResolution;
+}VIOGPU_DISP_MODE, *PVIOGPU_DISP_MODE;
+#pragma pack()
+
+
+#pragma pack(1)
+typedef struct _VIOGPU_PARAM_REQ {
+    ULONG ParamId;
+    UINT64 Value;
+}VIOGPU_PARAM_REQ;
+#pragma pack()
+
+
+#pragma pack(1)
+typedef struct _VIOGPU_CAPSET_REQ {
+    ULONG CapsetId;
+    ULONG Version;
+    ULONG Size;
+    UINT64 Capset; // buffer address; 64 bits wide so 32-bit (WOW64) callers use the same layout as the driver
+}VIOGPU_CAPSET_REQ;
+#pragma pack()
+
+
+#pragma pack(1)
+typedef struct _VIOGPU_RES_INFO_REQ {
+    D3DKMT_HANDLE ResHandle;
+    ULONG Id;
+}VIOGPU_RES_INFO_REQ;
+#pragma pack()
+
+
+#pragma pack(1)
+typedef struct _VIOGPU_RES_BUSY_REQ {
+    D3DKMT_HANDLE ResHandle;
+    BOOL Wait;
+    BOOL IsBusy;
+}VIOGPU_RES_BUSY_REQ;
+#pragma pack()
+
+
+#pragma pack(1)
+typedef struct _VIOGPU_CTX_INIT_REQ {   
+    UINT CapsetID;
+}VIOGPU_CTX_INIT_REQ;
+#pragma pack()
+
+
+// Venus (Vulkan): blob resources, mapped into the calling process, and command streams for a Venus context.
+// The device (D3DKMTCreateDevice) owns its blobs: the driver destroys what is left when the device goes away.
+#define VIOGPU_BLOB_MEM_GUEST         0x0001
+#define VIOGPU_BLOB_MEM_HOST3D        0x0002
+#define VIOGPU_BLOB_MEM_HOST3D_GUEST  0x0003
+#define VIOGPU_BLOB_FLAG_USE_MAPPABLE    0x0001
+#define VIOGPU_BLOB_FLAG_USE_SHAREABLE   0x0002
+#define VIOGPU_BLOB_FLAG_USE_CROSS_DEVICE 0x0004
+
+#pragma pack(1)
+typedef struct _VIOGPU_BLOB_CREATE_REQ
+{
+    ULONG BlobMem;   // VIOGPU_BLOB_MEM_*
+    ULONG BlobFlags; // VIOGPU_BLOB_FLAG_*
+    UINT64 BlobId;   // the context's object (Venus: a VkDeviceMemory's id, 0 for shared memory)
+    UINT64 Size;
+    ULONG ResId;     // out: the host resource
+} VIOGPU_BLOB_CREATE_REQ;
+#pragma pack()
+
+#pragma pack(1)
+typedef struct _VIOGPU_BLOB_MAP_REQ
+{
+    ULONG ResId;
+    ULONG MapInfo;   // out: VIRTIO_GPU_MAP_CACHE_* the host asked for
+    UINT64 Address;  // out: where the blob is in the calling process
+} VIOGPU_BLOB_MAP_REQ;
+#pragma pack()
+
+#pragma pack(1)
+typedef struct _VIOGPU_BLOB_DESTROY_REQ
+{
+    ULONG ResId;     // unmapped too, if it is mapped
+} VIOGPU_BLOB_DESTROY_REQ;
+#pragma pack()
+
+// A command stream for the device's context. With Event, the host answers once the ring's work is done
+// (ring 0: once the host processed the commands) and the driver then sets the event.
+#pragma pack(1)
+typedef struct _VIOGPU_EXECBUFFER_REQ
+{
+    UINT64 Command;  // user-mode address of the commands
+    ULONG Size;      // their size in bytes (at most VIOGPU_EXECBUFFER_MAX_SIZE)
+    ULONG RingIdx;
+    UINT64 Event;    // HANDLE of an event to set when done, or 0
+} VIOGPU_EXECBUFFER_REQ;
+#pragma pack()
+#define VIOGPU_EXECBUFFER_MAX_SIZE (512 * 1024)
+
+#pragma pack(1)
+typedef struct  _VIOGPU_ESCAPE{
+    USHORT      Type;
+    USHORT      DataLength;
+    union {
+        ULONG Id;
+        VIOGPU_DISP_MODE Resolution;
+        VIOGPU_PARAM_REQ Parameter;
