diff --git a/src/virtio/vulkan/vn_icd.c b/src/virtio/vulkan/vn_icd.c
--- a/src/virtio/vulkan/vn_icd.c
+++ b/src/virtio/vulkan/vn_icd.c
@@ -11,10 +11,54 @@
 #include "vn_icd.h"
 
 #include "vn_instance.h"
+#include "vn_physical_device.h"
+
+#if DETECT_OS_WINDOWS
+/* WinBoat: the physical devices of a DXGI adapter, by LUID (Venus reports its adapter's). The Windows loader sorts
+ * devices by DXGI adapter through this entry point, and puts layered drivers on the same adapter (Dozen, Vulkan on
+ * D3D12) after native ones; without it Venus came last and programs picking the first GPU took Dozen. The common
+ * runtime's version looks at a device list Venus doesn't use. */
+static VKAPI_ATTR VkResult VKAPI_CALL
+vn_icdEnumerateAdapterPhysicalDevices(VkInstance _instance,
+                                      LUID adapterLUID,
+                                      uint32_t *pPhysicalDeviceCount,
+                                      VkPhysicalDevice *pPhysicalDevices)
+{
+   struct vn_instance *instance = vn_instance_from_handle(_instance);
+
+   uint32_t count = 0;
+   VkResult result = vn_EnumeratePhysicalDevices(_instance, &count, NULL);
+   if (result != VK_SUCCESS)
+      return result;
+   STACK_ARRAY(VkPhysicalDevice, devices, count);
+   result = vn_EnumeratePhysicalDevices(_instance, &count, devices);
+
+   VK_OUTARRAY_MAKE_TYPED(VkPhysicalDevice, out, pPhysicalDevices,
+                          pPhysicalDeviceCount);
+   for (uint32_t i = 0; result == VK_SUCCESS && i < count; i++) {
+      const struct vk_properties *props =
+         &vn_physical_device_from_handle(devices[i])->base.vk.properties;
+      if (props->deviceLUIDValid &&
+          !memcmp(props->deviceLUID, &adapterLUID, sizeof(adapterLUID))) {
+         vk_outarray_append_typed(VkPhysicalDevice, &out, dev) {
+            *dev = devices[i];
+         }
+      }
+   }
+   STACK_ARRAY_FINISH(devices);
+   (void)instance;
+
+   return result == VK_SUCCESS ? vk_outarray_status(&out) : result;
+}
+#endif
 
 VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
 vk_icdGetInstanceProcAddr(VkInstance instance, const char *pName)
 {
+#if DETECT_OS_WINDOWS
+   if (!strcmp(pName, "vk_icdEnumerateAdapterPhysicalDevices"))
+      return (PFN_vkVoidFunction)vn_icdEnumerateAdapterPhysicalDevices;
+#endif
    return vn_GetInstanceProcAddr(instance, pName);
 }
 
