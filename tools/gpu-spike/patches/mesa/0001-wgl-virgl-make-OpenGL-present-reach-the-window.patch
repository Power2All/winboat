+#ifdef GALLIUM_VIRGL
+/* Presents by reading the frame back and drawing it with GDI. Used when there is no DXGI swapchain (pixel formats
+ * with PFD_SUPPORT_GDI, or the swapchain couldn't be created): presenting through the kernel driver
+ * (gdikmt present) isn't implemented. */
+static void
+virgl_gdi_present(struct pipe_context *ctx, struct pipe_resource *res, HDC hDC)
+{
+   if (!ctx || !res)
+      return;
+
+   unsigned width = res->width0, height = res->height0;
+   struct pipe_transfer *transfer;
+   const uint8_t *map = pipe_texture_map(ctx, res, 0, 0, PIPE_MAP_READ, 0, 0, width, height, &transfer);
+   if (!map)
+      return;
+
+   const void *pixels = map;
+   unsigned stride = transfer->stride;
+   void *converted = NULL;
+   if (res->format != PIPE_FORMAT_B8G8R8A8_UNORM && res->format != PIPE_FORMAT_B8G8R8X8_UNORM) {
+      converted = malloc((size_t)width * height * 4);
+      if (!converted ||
+          !util_format_translate(PIPE_FORMAT_B8G8R8A8_UNORM, converted, width * 4, 0, 0, res->format, map,
+                                 transfer->stride, 0, 0, width, height)) {
+         free(converted);
+         pipe_texture_unmap(ctx, transfer);
+         return;
+      }
+      pixels = converted;
+      stride = width * 4;
+   }
+
+   BITMAPINFO bmi;
+   memset(&bmi, 0, sizeof(bmi));
+   bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+   bmi.bmiHeader.biWidth = stride / 4; /* rows can be padded; only the first width pixels are drawn */
+   bmi.bmiHeader.biHeight = -(LONG)height; /* top-down */
+   bmi.bmiHeader.biPlanes = 1;
+   bmi.bmiHeader.biBitCount = 32;
+   bmi.bmiHeader.biCompression = BI_RGB;
+   StretchDIBits(hDC, 0, 0, width, height, 0, 0, width, height, pixels, &bmi, DIB_RGB_COLORS, SRCCOPY);
+
+   free(converted);
+   pipe_texture_unmap(ctx, transfer);
+}
+#endif
+
+
 static void
 wgl_present(struct pipe_screen *screen,
             struct pipe_context *ctx,
@@ -193,7 +243,7 @@ wgl_present(struct pipe_screen *screen,
 
 #ifdef GALLIUM_VIRGL
    if (use_virgl) {
-      screen->flush_frontbuffer(screen, ctx, res, 0, 0, hDC, 0, NULL);
+      virgl_gdi_present(ctx, res, hDC);
       return;
    }
 #endif
