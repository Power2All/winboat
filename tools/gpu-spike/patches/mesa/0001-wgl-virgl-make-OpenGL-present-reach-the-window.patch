+/* The adapter Windows renders this window's DC with. The virgl screen opens the same one (gdikmt_create_from_hdc),
+ * and the swapchain textures it imports through shared handles can only be opened there. In an RDP session DXGI
+ * lists the GPU more than once, so the default adapter isn't necessarily the right one. */
+static ComPtr<IDXGIAdapter>
+wgl_dxgi_adapter_for_window(HWND hWnd)
+{
+   ComPtr<IDXGIAdapter> result;
+   HMODULE gdi32 = GetModuleHandleA("gdi32.dll");
+   HMODULE dxgi = GetModuleHandleA("dxgi.dll"); /* loaded along with d3d11.dll */
+   auto openFromHdc = gdi32 ? (PFND3DKMT_OPENADAPTERFROMHDC)GetProcAddress(gdi32, "D3DKMTOpenAdapterFromHdc") : NULL;
+   auto closeAdapter = gdi32 ? (PFND3DKMT_CLOSEADAPTER)GetProcAddress(gdi32, "D3DKMTCloseAdapter") : NULL;
+   auto createFactory = dxgi ? (HRESULT(WINAPI *)(REFIID, void **))GetProcAddress(dxgi, "CreateDXGIFactory1") : NULL;
+   if (!openFromHdc || !closeAdapter || !createFactory)
+      return result;
+
+   D3DKMT_OPENADAPTERFROMHDC open;
+   memset(&open, 0, sizeof(open));
+   open.hDc = GetDC(hWnd);
+   NTSTATUS status = openFromHdc(&open);
+   ReleaseDC(hWnd, open.hDc);
+   if (status < 0)
+      return result;
+   D3DKMT_CLOSEADAPTER close;
+   close.hAdapter = open.hAdapter;
+   closeAdapter(&close);
+
+   ComPtr<IDXGIFactory1> factory;
+   if (FAILED(createFactory(__uuidof(IDXGIFactory1), &factory)))
+      return result;
+   ComPtr<IDXGIAdapter1> adapter;
+   for (UINT i = 0; factory->EnumAdapters1(i, &adapter) != DXGI_ERROR_NOT_FOUND; i++) {
+      DXGI_ADAPTER_DESC1 desc;
+      if (SUCCEEDED(adapter->GetDesc1(&desc)) && desc.AdapterLuid.LowPart == open.AdapterLuid.LowPart &&
+          desc.AdapterLuid.HighPart == open.AdapterLuid.HighPart) {
+         result = adapter;
+         break;
+      }
+   }
+   return result;
+}
+
 extern "C" {
 struct stw_winsys_framebuffer *
 wgl_create_dxgi_framebuffer(struct pipe_screen *screen, HWND hWnd,
@@ -278,7 +315,44 @@ wgl_create_dxgi_framebuffer(struct pipe_screen *screen, HWND hWnd,
    if (!fb)
       return NULL;
 
+   /* Create the device now, so a failure falls back to presenting through GDI instead of a framebuffer that can
+    * never be shown. No D3D11_CREATE_DEVICE_DEBUG: it fails unless the optional Graphics Tools are installed. */
+   static const D3D_FEATURE_LEVEL FeatureLevels[] = {D3D_FEATURE_LEVEL_10_0};
    fb->d3d11 = LoadLibraryA("d3d11.dll");
+   PFN_D3D11_CREATE_DEVICE createDevice =
+      fb->d3d11 ? (PFN_D3D11_CREATE_DEVICE)GetProcAddress(fb->d3d11, "D3D11CreateDevice") : NULL;
+   ComPtr<IDXGIAdapter> windowAdapter = wgl_dxgi_adapter_for_window(hWnd);
+   HRESULT hr = createDevice ? createDevice(windowAdapter.Get(),
+                                            windowAdapter ? D3D_DRIVER_TYPE_UNKNOWN : D3D_DRIVER_TYPE_HARDWARE, NULL,
+                                            0, FeatureLevels, _countof(FeatureLevels), D3D11_SDK_VERSION,
+                                            &fb->device, NULL, &fb->context)
+                             : E_FAIL;
+   ComPtr<IDXGIDevice> dxgiDevice;
+   ComPtr<IDXGIAdapter> adapter;
+   if (SUCCEEDED(hr))
+      hr = fb->device.As(&dxgiDevice);
+   if (SUCCEEDED(hr))
+      hr = dxgiDevice->GetAdapter(&adapter);
+   if (SUCCEEDED(hr))
+      hr = adapter->GetParent(__uuidof(IDXGIFactory), &fb->factory);
+   if (FAILED(hr)) {
+      _debug_printf("Failed to create framebuffer dxgi device: %x\n", hr);
+      fb->factory.Reset();
+      fb->context.Reset();
+      fb->device.Reset();
+      if (fb->d3d11)
+         FreeLibrary(fb->d3d11);
+      free(fb);
+      return NULL;
+   }
+
+   /* Tearing (for swap interval 0) needs DXGI 1.5 and OS support */
+   ComPtr<IDXGIFactory5> factory5;
+   BOOL tearing = FALSE;
+   fb->allow_tearing = SUCCEEDED(fb->factory.As(&factory5)) &&
+                       SUCCEEDED(factory5->CheckFeatureSupport(DXGI_FEATURE_PRESENT_ALLOW_TEARING, &tearing,
+                                                               sizeof(tearing))) &&
+                       tearing;
 
    fb->window = hWnd;
    fb->screen = screen;
