@@ -225,6 +225,10 @@ CreateDevice(HANDLE hAdapter, D3DDDIARG_CREATEDEVICE *pCreateData)
    device->kmt.hRTAdapter = adapter->hRTAdapter;
    device->kmt.hRTDevice = pCreateData->hDevice;
    device->kmt.callbacks = *pCreateData->pCallbacks;
