diff --git a/src/util/futex.c b/src/util/futex.c
index df3e949..f72f7b2 100644
--- a/src/util/futex.c
+++ b/src/util/futex.c
@@ -122,16 +122,54 @@ int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
 #include <assert.h>
 #include <errno.h>
 
+#include "util/macros.h"
+#include "util/u_atomic.h"
+
+/* WaitOnAddress is Windows 8's: looked up, so the drivers load on Windows 7 too, which waits on a condition variable
+ * of the address's bucket instead (a waiter checks the value under the bucket's lock, a waker takes it to wake all of
+ * the bucket's waiters: they check their values again)
+ */
+typedef BOOL (WINAPI *PFN_WaitOnAddress)(volatile VOID *, PVOID, SIZE_T, DWORD);
+typedef VOID (WINAPI *PFN_WakeByAddress)(PVOID);
+static PFN_WaitOnAddress wait_on_address;
+static PFN_WakeByAddress wake_by_address_single, wake_by_address_all;
+static INIT_ONCE futex_once = INIT_ONCE_STATIC_INIT;
+static struct {
+   SRWLOCK lock;
+   CONDITION_VARIABLE cond;
+} futex_buckets[64]; /* zeroed: SRWLOCK_INIT, CONDITION_VARIABLE_INIT */
+
+static BOOL CALLBACK
+futex_init(PINIT_ONCE once, PVOID param, PVOID *context)
+{
+   HMODULE kernelbase = GetModuleHandleA("kernelbase.dll");
+   if (kernelbase) {
+      wait_on_address = (PFN_WaitOnAddress)GetProcAddress(kernelbase, "WaitOnAddress");
+      wake_by_address_single = (PFN_WakeByAddress)GetProcAddress(kernelbase, "WakeByAddressSingle");
+      wake_by_address_all = (PFN_WakeByAddress)GetProcAddress(kernelbase, "WakeByAddressAll");
+   }
+   if (!wake_by_address_single || !wake_by_address_all)
+      wait_on_address = NULL;
+   return TRUE;
+}
+
+#define futex_bucket(addr) (&futex_buckets[((uintptr_t)(addr) >> 2) % ARRAY_SIZE(futex_buckets)])
+
 int futex_wake(uint32_t *addr, int32_t count)
 {
    /* All current callers fall into one of these buckets, and we'll get the semantics
     * wrong if someone tries to be more clever.
     */
    assert(count == 1 || count == INT32_MAX);
-   if (count == 1)
-      WakeByAddressSingle(addr);
+   InitOnceExecuteOnce(&futex_once, futex_init, NULL, NULL);
+   if (!wait_on_address) {
+      AcquireSRWLockExclusive(&futex_bucket(addr)->lock);
+      WakeAllConditionVariable(&futex_bucket(addr)->cond);
+      ReleaseSRWLockExclusive(&futex_bucket(addr)->lock);
+   } else if (count == 1)
+      wake_by_address_single(addr);
    else
-      WakeByAddressAll(addr);
+      wake_by_address_all(addr);
    return count;
 }
 
@@ -146,7 +184,19 @@ int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
                    (timeout->tv_nsec - tsnow.tv_nsec) / 1000000;
    }
 
-   if (WaitOnAddress(addr, &value, sizeof(value), timeout_ms))
+   InitOnceExecuteOnce(&futex_once, futex_init, NULL, NULL);
+   if (!wait_on_address) {
+      BOOL woken = TRUE;
+      AcquireSRWLockExclusive(&futex_bucket(addr)->lock);
+      if (p_atomic_read(addr) == (uint32_t)value)
+         woken = SleepConditionVariableSRW(&futex_bucket(addr)->cond, &futex_bucket(addr)->lock, timeout_ms, 0);
+      ReleaseSRWLockExclusive(&futex_bucket(addr)->lock);
+      if (woken)
+         return 0;
+      return GetLastError() == ERROR_TIMEOUT ? ETIMEDOUT : -1;
+   }
+
+   if (wait_on_address(addr, &value, sizeof(value), timeout_ms))
       return 0;
    return GetLastError() == ERROR_TIMEOUT ? ETIMEDOUT : -1;
 }
