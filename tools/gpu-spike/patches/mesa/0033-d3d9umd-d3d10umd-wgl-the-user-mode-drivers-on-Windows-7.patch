    device->kmt.adapterCallbacks = &adapter->callbacks;
    gdikmt_d3d9_init(&device->kmt);
    /* A WDDM 1.3 kernel driver (Windows 8.1): its runtime's callbacks end before WDDM 2.0's residency ones, whatever
@@ -248,15 +252,16 @@ CreateDevice(HANDLE hAdapter, D3DDDIARG_CREATEDEVICE *pCreateData)
    device->viewport.max_z = 1.0f;
 
    /* The runtime's table ends where its interface version does: Windows 8.1's (WDDM 1.3) before the WDDM 2.0 entries
-    * (TrimResidencySet on). Writing ours whole there corrupted its heap (0xC0000374). SetMarker and SetMarkerMode are
+    * (TrimResidencySet on), Windows 7's before Windows 8's (VolBlt1 on). Writing ours whole there corrupted its heap (0xC0000374). SetMarker and SetMarkerMode are
     * 8.1's though: without them its runtime doesn't take Flush1 and Present1 but calls the (null) Flush */
    const size_t size = pCreateData->Version >= D3D_UMD_INTERFACE_VERSION_WDDM2_0 ? sizeof(D3DDDI_DEVICEFUNCS)
-                                                                               : offsetof(D3DDDI_DEVICEFUNCS, pfnTrimResidencySet);
+                       : pCreateData->Version >= D3D_UMD_INTERFACE_VERSION_WIN8 ? offsetof(D3DDDI_DEVICEFUNCS, pfnTrimResidencySet)
+                                                                                : offsetof(D3DDDI_DEVICEFUNCS, pfnVolBlt1);
    /* (starting from what the runtime put in its table: entries we don't fill stay its own) */
    D3DDDI_DEVICEFUNCS funcs = {};
    memcpy(&funcs, pCreateData->pDeviceFuncs, size);
    D3D9UmdFillStubs(&funcs);
-   D3D9UmdFillDeviceFuncs(&funcs);
+   D3D9UmdFillDeviceFuncs(&funcs, pCreateData->Version);
    memcpy(pCreateData->pDeviceFuncs, &funcs, size);
    for (size_t i = 0; i < size / sizeof(void *); i++) {
       if (!((void *const *)&funcs)[i])
diff --git a/src/gallium/frontends/d3d9umd/d3d9umd.h b/src/gallium/frontends/d3d9umd/d3d9umd.h
