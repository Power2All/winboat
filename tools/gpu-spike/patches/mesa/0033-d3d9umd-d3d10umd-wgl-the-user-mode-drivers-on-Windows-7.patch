    PFND3DKMT_DESTROYCONTEXT destroyContext;
    PFND3DKMT_CREATEALLOCATION createAllocation;
@@ -40,9 +39,6 @@ gdikmt_load_callbacks(HINSTANCE gdi32lib, struct d3dkmt_callbacks *cb)
       gdi32lib, "D3DKMTQueryAdapterInfo");
    cb->escape = (PFND3DKMT_ESCAPE)GetProcAddress(gdi32lib, "D3DKMTEscape");
    cb->render = (PFND3DKMT_RENDER)GetProcAddress(gdi32lib, "D3DKMTRender");
-   cb->signalSynchronizationObject2 =
-      (PFND3DKMT_SIGNALSYNCHRONIZATIONOBJECT2)GetProcAddress(
-         gdi32lib, "D3DKMTSignalSynchronizationObject2");
    cb->createContext =
       (PFND3DKMT_CREATECONTEXT)GetProcAddress(gdi32lib, "D3DKMTCreateContext");
    cb->destroyContext = (PFND3DKMT_DESTROYCONTEXT)GetProcAddress(
@@ -169,16 +165,8 @@ gdikmt_d3dkmt_render(struct gdikmt_context *_ctx, struct gdikmt_render *options)
 
    NTSTATUS Status = device->cb.render(&render);
 
-   if (options->CompletionEvent) {
-      D3DKMT_SIGNALSYNCHRONIZATIONOBJECT2 signalEvent;
-      memset(&signalEvent, 0, sizeof(signalEvent));
-      signalEvent.hContext = ctx->hContext;
-      signalEvent.ObjectCount = 0;
-      signalEvent.BroadcastContextCount = 0;
-      signalEvent.Flags.EnqueueCpuEvent = TRUE;
-      signalEvent.CpuEventHandle = options->CompletionEvent;
-      device->cb.signalSynchronizationObject2(&signalEvent);
-   }
+   if (options->CompletionEvent)
+      gdikmt_signal_cpu_event(ctx->hContext, options->CompletionEvent);
 
    ctx->base.pCommandBuffer = render.pNewCommandBuffer;
    ctx->base.pAllocationList = render.pNewAllocationList;
@@ -534,8 +522,23 @@ gdikmt_create_from_luid(LUID luid)
    D3DKMT_OPENADAPTERFROMLUID openFromLuid;
    memset(&openFromLuid, 0, sizeof(openFromLuid));
    openFromLuid.AdapterLuid = luid;
-   NTSTATUS Status = device->cb.openAdapterFromLuid ? device->cb.openAdapterFromLuid(&openFromLuid)
-                                                     : (NTSTATUS)0xC00000BBL /* STATUS_NOT_SUPPORTED */;
+   NTSTATUS Status = (NTSTATUS)0xC00000BBL; /* STATUS_NOT_SUPPORTED */
+   if (device->cb.openAdapterFromLuid) {
+      Status = device->cb.openAdapterFromLuid(&openFromLuid);
+   } else {
+      /* Windows 7 has no D3DKMTOpenAdapterFromLuid: the enumerated adapter with that LUID */
+      D3DKMT_ADAPTERINFO adapters[16];
+      UINT count = gdikmt_enum_adapters(adapters, ARRAY_SIZE(adapters));
+      for (UINT i = 0; i < count; i++) {
+         if (!NT_SUCCESS(Status) && !memcmp(&adapters[i].AdapterLuid, &luid, sizeof(luid))) {
+            openFromLuid.hAdapter = adapters[i].hAdapter;
+            Status = 0;
+         } else {
+            D3DKMT_CLOSEADAPTER close = {adapters[i].hAdapter};
+            device->cb.closeAdapter(&close);
+         }
+      }
+   }
    if (!NT_SUCCESS(Status)) {
       _debug_printf(
          "Failed to open device(D3DKMTOpenAdapterFromLuid) with status code: %lx\n",
@@ -547,6 +550,35 @@ gdikmt_create_from_luid(LUID luid)
    return gdikmt_create_on_adapter(device, openFromLuid.hAdapter);
 }
 
+bool
+gdikmt_windows7(void)
+{
+   /* (Windows 8's gdi32 has it) */
+   HMODULE gdi32 = GetModuleHandleA("gdi32.dll");
+   return gdi32 && !GetProcAddress(gdi32, "D3DKMTOpenAdapterFromLuid");
+}
+
+NTSTATUS
+gdikmt_signal_cpu_event(D3DKMT_HANDLE hContext, HANDLE event)
+{
+   HMODULE gdi32 = GetModuleHandleA("gdi32.dll");
+   PFND3DKMT_SIGNALSYNCHRONIZATIONOBJECT2 signal =
+      gdi32 ? (PFND3DKMT_SIGNALSYNCHRONIZATIONOBJECT2)GetProcAddress(gdi32, "D3DKMTSignalSynchronizationObject2") : NULL;
+   D3DKMT_SIGNALSYNCHRONIZATIONOBJECT2 signalEvent;
+   memset(&signalEvent, 0, sizeof(signalEvent));
+   signalEvent.hContext = hContext;
+   signalEvent.Flags.EnqueueCpuEvent = TRUE;
+   signalEvent.CpuEventHandle = event;
+   NTSTATUS status = signal ? signal(&signalEvent) : (NTSTATUS)0xC00000BBL; /* STATUS_NOT_SUPPORTED */
+   /* Windows 7 has the function but not EnqueueCpuEvent (Windows 8's): the event set now. The host runs all contexts'
+    * work in submission order and the CPU's reads wait for their resources (VIOGPU_RES_BUSY), so only the CPU's pacing
+    * is lost. ponytail: no frame throttling on Windows 7; a kernel escape setting the event at the submission's
+    * completion if games run ahead */
+   if (!NT_SUCCESS(status))
+      SetEvent(event);
+   return status;
+}
+
 UINT
 gdikmt_enum_adapters(D3DKMT_ADAPTERINFO *adapters, UINT max)
 {
diff --git a/src/gallium/frontends/d3d10umd/Device.cpp b/src/gallium/frontends/d3d10umd/Device.cpp
index be31819..c6fc75d 100644
--- a/src/gallium/frontends/d3d10umd/Device.cpp
+++ b/src/gallium/frontends/d3d10umd/Device.cpp
@@ -148,6 +148,10 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
    pDevice->device.hRTDevice = (HANDLE)pCreateData->hRTDevice.handle;
 
    pDevice->device.KTCallbacks = *pCreateData->pKTCallbacks;
+   /* Windows 7's callbacks end before Windows 8's: what follows them in the copy isn't the runtime's */
+   if (gdikmt_windows7())
+      memset(&pDevice->device.KTCallbacks.pfnOfferAllocationsCb, 0,
+             sizeof(pDevice->device.KTCallbacks) - offsetof(D3DDDI_DEVICECALLBACKS, pfnOfferAllocationsCb));
    /* Windows 8.1's callbacks have no WDDM 2.0 residency ones: what follows them isn't ours to call */
    pDevice->device.residency.tried = HostKernelIsWddm1();
    pDevice->device.pAdapterCallbacks = &pAdapter->AdapterCallbacks;
diff --git a/src/gallium/frontends/d3d10umd/gdikmt_d3dddi.cpp b/src/gallium/frontends/d3d10umd/gdikmt_d3dddi.cpp
index fabf12c..999d6dd 100644
