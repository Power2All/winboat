+++ b/src/gallium/frontends/d3d10umd/gdikmt_d3dddi.cpp
@@ -85,7 +85,10 @@ gdikmt_d3dddi_render(struct gdikmt_context *_ctx, struct gdikmt_render *options)
       signalEvent.BroadcastContextCount = 0;
       signalEvent.Flags.EnqueueCpuEvent = TRUE;
       signalEvent.CpuEventHandle = options->CompletionEvent;
-      dev->KTCallbacks.pfnSignalSynchronizationObject2Cb(dev->hRTDevice, &signalEvent);
+      if (dev->KTCallbacks.pfnSignalSynchronizationObject2Cb)
+         dev->KTCallbacks.pfnSignalSynchronizationObject2Cb(dev->hRTDevice, &signalEvent);
+      else
+         gdikmt_signal_cpu_event((D3DKMT_HANDLE)(uintptr_t)ctx->hContext, options->CompletionEvent);
    }
 
    ctx->base.pCommandBuffer = render.pNewCommandBuffer;
