+
+void
+VideoLog(const char *format, ...)
+{
+   static FILE *log = getenv("VIOGPU_VIDEO_LOG") ? fopen(getenv("VIOGPU_VIDEO_LOG"), "a") : NULL;
+   if (log) {
+      va_list ap;
+      va_start(ap, format);
+      vfprintf(log, format, ap);
+      va_end(ap);
+      fflush(log);
+   }
+}
+
+bool
+ProfileSupported(struct pipe_screen *screen, const VideoProfileInfo &p)
+{
+   return screen->get_video_param &&
+          screen->get_video_param(screen, p.profile, PIPE_VIDEO_ENTRYPOINT_BITSTREAM, PIPE_VIDEO_CAP_SUPPORTED);
+}
+
+const VideoProfileInfo *
+FindProfile(struct pipe_screen *screen, const GUID *guid)
+{
+   for (auto &p : PROFILES) {
+      if (IsEqualGUID(p.guid, *guid) && ProfileSupported(screen, p)) {
+         return &p;
+      }
+   }
+   return NULL;
+}
+
+void
+DxvaBeginFrame(DxvaDecoder *dec)
+{
+   dec->pic_params.clear();
+   dec->qmatrix.clear();
+   dec->stream.clear();
+   dec->slices = 0;
+   dec->tiles.clear();
+}
+
+/* A bitstream buffer and its slice control: the slices where the slice control says they are. False when one
+ * lies outside the bitstream */
+bool
+DxvaAddSlices(DxvaDecoder *dec, const uint8_t *slice_control, unsigned slice_control_size,
+              const uint8_t *bitstream, unsigned bitstream_size)
+{
+   /* the slices of this call's bitstream buffer, where its slice control says they are: H.264 and HEVC slices each
+    * after a start code (the host's VA-API driver gets them one by one, split at the start codes) */
+   /* AV1: the bitstream buffer as it is, its tiles where the slice control says */
+   if (slice_control && bitstream && dec->profile->codec == CODEC_AV1) {
+      uint32_t base = (uint32_t)dec->stream.size();
+      for (unsigned i = 0; i < slice_control_size / sizeof(DxvaTile_AV1); i++) {
+         DxvaTile_AV1 t;
+         memcpy(&t, slice_control + i * sizeof t, sizeof t);
+         if (t.DataOffset > bitstream_size || t.DataSize > bitstream_size - t.DataOffset) {
+            VideoLog("SubmitBuffers: tile %u (%u bytes at %u) outside the bitstream (%u bytes)\n", i, t.DataSize,
+                     t.DataOffset, bitstream_size);
+            return false;
+         }
+         t.DataOffset += base;
+         dec->tiles.push_back(t);
+      }
+      dec->stream.insert(dec->stream.end(), bitstream, bitstream + bitstream_size);
+      dec->slices = (unsigned)dec->tiles.size();
+   } else if (slice_control && bitstream && dec->profile->codec == CODEC_MPEG2) {
+      /* MPEG-2: the slices with their start codes, as they are */
+      for (unsigned i = 0; i < slice_control_size / sizeof(DxvaSliceInfo); i++) {
+         DxvaSliceInfo si;
+         memcpy(&si, slice_control + i * sizeof si, sizeof si);
+         uint32_t bytes = si.dwSliceBitsInBuffer / 8;
+         if (si.dwSliceDataLocation > bitstream_size || bytes > bitstream_size - si.dwSliceDataLocation) {
+            VideoLog("SubmitBuffers: slice %u (%u bytes at %u) outside the bitstream (%u bytes)\n", i, bytes,
+                     si.dwSliceDataLocation, bitstream_size);
+            return false;
+         }
+         dec->stream.insert(dec->stream.end(), bitstream + si.dwSliceDataLocation,
+                            bitstream + si.dwSliceDataLocation + bytes);
+         dec->slices++;
+      }
+   } else if (slice_control && bitstream) {
+      static const uint8_t start_code[3] = {0, 0, 1};
+      bool annexb = dec->profile->codec != CODEC_VP9;
+      for (unsigned i = 0; i < slice_control_size / sizeof(DxvaSlice_Short); i++) {
+         DxvaSlice_Short s;
+         memcpy(&s, slice_control + i * sizeof s, sizeof s);
+         if (s.BSNALunitDataLocation > bitstream_size || s.SliceBytesInBuffer > bitstream_size - s.BSNALunitDataLocation) {
+            VideoLog("SubmitBuffers: slice %u (%u bytes at %u) outside the bitstream (%u bytes)\n", i,
+                     s.SliceBytesInBuffer, s.BSNALunitDataLocation, bitstream_size);
+            return false;
+         }
+         const uint8_t *slice = bitstream + s.BSNALunitDataLocation;
+         if (annexb && (s.SliceBytesInBuffer < 3 || memcmp(slice, start_code, 3))) {
+            dec->stream.insert(dec->stream.end(), start_code, start_code + 3);
+         }
+         dec->stream.insert(dec->stream.end(), slice, slice + s.SliceBytesInBuffer);
+         dec->slices++;
+      }
+   }
+   return true;
+}
+
+static struct pipe_video_buffer *
+Surface(DxvaDecoder *dec, unsigned index)
+{
+   return dec->surface(dec, index);
+}
+
+static bool
+H264Picture(DxvaDecoder *dec)
+{
+   if (dec->pic_params.size() < sizeof(DxvaPicParams_H264)) {
+      return false;
+   }
+   const DxvaPicParams_H264 *pp = (const DxvaPicParams_H264 *)dec->pic_params.data();
+   struct pipe_h264_picture_desc *d = &dec->desc.h264;
+   struct pipe_h264_pps *pps = &dec->h264_pps;
+   struct pipe_h264_sps *sps = &dec->h264_sps;
+   memset(d, 0, sizeof *d);
+   memset(pps, 0, sizeof *pps);
+   memset(sps, 0, sizeof *sps);
+   d->pps = pps;
+   pps->sps = sps;
+
+   sps->chroma_format_idc = pp->chroma_format_idc;
+   sps->separate_colour_plane_flag = pp->residual_colour_transform_flag;
+   sps->bit_depth_luma_minus8 = pp->bit_depth_luma_minus8;
+   sps->bit_depth_chroma_minus8 = pp->bit_depth_chroma_minus8;
+   sps->log2_max_frame_num_minus4 = pp->log2_max_frame_num_minus4;
+   sps->pic_order_cnt_type = pp->pic_order_cnt_type;
+   sps->log2_max_pic_order_cnt_lsb_minus4 = pp->log2_max_pic_order_cnt_lsb_minus4;
+   sps->delta_pic_order_always_zero_flag = pp->delta_pic_order_always_zero_flag;
+   sps->max_num_ref_frames = pp->num_ref_frames;
+   sps->frame_mbs_only_flag = pp->frame_mbs_only_flag;
+   sps->mb_adaptive_frame_field_flag = pp->MbaffFrameFlag;
+   sps->direct_8x8_inference_flag = pp->direct_8x8_inference_flag;
+   sps->MinLumaBiPredSize8x8 = pp->MinLumaBipredSize8x8Flag;
+
+   pps->entropy_coding_mode_flag = pp->entropy_coding_mode_flag;
+   pps->bottom_field_pic_order_in_frame_present_flag = pp->pic_order_present_flag;
+   pps->num_slice_groups_minus1 = pp->num_slice_groups_minus1;
+   pps->slice_group_map_type = pp->slice_group_map_type;
+   pps->slice_group_change_rate_minus1 = pp->slice_group_change_rate_minus1;
+   pps->num_ref_idx_l0_default_active_minus1 = pp->num_ref_idx_l0_active_minus1;
+   pps->num_ref_idx_l1_default_active_minus1 = pp->num_ref_idx_l1_active_minus1;
+   pps->weighted_pred_flag = pp->weighted_pred_flag;
+   pps->weighted_bipred_idc = pp->weighted_bipred_idc;
+   pps->pic_init_qp_minus26 = pp->pic_init_qp_minus26;
+   pps->pic_init_qs_minus26 = pp->pic_init_qs_minus26;
+   pps->chroma_qp_index_offset = pp->chroma_qp_index_offset;
+   pps->second_chroma_qp_index_offset = pp->second_chroma_qp_index_offset;
+   pps->deblocking_filter_control_present_flag = pp->deblocking_filter_control_present_flag;
+   pps->constrained_intra_pred_flag = pp->constrained_intra_pred_flag;
+   pps->redundant_pic_cnt_present_flag = pp->redundant_pic_cnt_present_flag;
+   pps->transform_8x8_mode_flag = pp->transform_8x8_mode_flag;
+
+   /* the scaling lists: DXVA's in zig-zag order, gallium's (VA-API's) in raster order; flat without them */
+   memset(pps->ScalingList4x4, 16, sizeof pps->ScalingList4x4);
+   memset(pps->ScalingList8x8, 16, sizeof pps->ScalingList8x8);
+   if (dec->qmatrix.size() >= sizeof(DxvaQmatrix_H264)) {
+      const DxvaQmatrix_H264 *qm = (const DxvaQmatrix_H264 *)dec->qmatrix.data();
+      for (unsigned i = 0; i < 6; i++) {
+         for (unsigned j = 0; j < 16; j++) {
+            pps->ScalingList4x4[i][vl_zscan_normal_16[j]] = qm->bScalingLists4x4[i][j];
+         }
+      }
+      for (unsigned i = 0; i < 2; i++) {
+         for (unsigned j = 0; j < 64; j++) {
+            pps->ScalingList8x8[i][vl_zscan_normal[j]] = qm->bScalingLists8x8[i][j];
+         }
+      }
+   }
+
+   d->frame_num = pp->frame_num;
+   d->field_pic_flag = pp->field_pic_flag;
+   d->bottom_field_flag = pp->field_pic_flag && pp->CurrPic.AssociatedFlag;
+   d->num_ref_idx_l0_active_minus1 = pp->num_ref_idx_l0_active_minus1;
+   d->num_ref_idx_l1_active_minus1 = pp->num_ref_idx_l1_active_minus1;
+   d->slice_count = dec->slices;
+   d->field_order_cnt[0] = pp->CurrFieldOrderCnt[0];
+   d->field_order_cnt[1] = pp->CurrFieldOrderCnt[1];
+   d->is_reference = pp->RefPicFlag;
+   d->num_ref_frames = pp->num_ref_frames;
+
+   /* the references, packed from the first entry (virgl's host reads entries up to num_ref_frames) */
+   unsigned n = 0;
+   for (unsigned i = 0; i < 16; i++) {
+      DxvaPicEntry e = pp->RefFrameList[i];
+      bool top = pp->UsedForReferenceFlags & (1u << (2 * i)), bottom = pp->UsedForReferenceFlags & (2u << (2 * i));
+      struct pipe_video_buffer *ref = e.bPicEntry == DxvaInvalidEntry ? NULL : Surface(dec, e.Index7Bits);
+      if (!ref || (!top && !bottom) || (pp->NonExistingFrameFlags & (1u << i))) {
+         continue;
+      }
+      d->ref[n] = ref;
+      d->is_long_term[n] = e.AssociatedFlag;
+      d->top_is_reference[n] = top;
+      d->bottom_is_reference[n] = bottom;
+      d->field_order_cnt_list[n][0] = pp->FieldOrderCntList[i][0];
+      d->field_order_cnt_list[n][1] = pp->FieldOrderCntList[i][1];
+      d->frame_num_list[n] = pp->FrameNumList[i];
+      n++;
+   }
+   return true;
+}
+
+static bool
+HEVCPicture(DxvaDecoder *dec)
+{
+   if (dec->pic_params.size() < sizeof(DxvaPicParams_HEVC)) {
+      return false;
+   }
+   const DxvaPicParams_HEVC *pp = (const DxvaPicParams_HEVC *)dec->pic_params.data();
+   struct pipe_h265_picture_desc *d = &dec->desc.h265;
+   struct pipe_h265_pps *pps = &dec->h265_pps;
+   struct pipe_h265_sps *sps = &dec->h265_sps;
+   memset(d, 0, sizeof *d);
+   memset(pps, 0, sizeof *pps);
+   memset(sps, 0, sizeof *sps);
+   d->pps = pps;
+   pps->sps = sps;
+
+   unsigned log2_min_cb = pp->log2_min_luma_coding_block_size_minus3 + 3;
+   sps->chroma_format_idc = pp->chroma_format_idc;
+   sps->separate_colour_plane_flag = pp->separate_colour_plane_flag;
+   sps->pic_width_in_luma_samples = pp->PicWidthInMinCbsY << log2_min_cb;
+   sps->pic_height_in_luma_samples = pp->PicHeightInMinCbsY << log2_min_cb;
+   sps->bit_depth_luma_minus8 = pp->bit_depth_luma_minus8;
+   sps->bit_depth_chroma_minus8 = pp->bit_depth_chroma_minus8;
+   sps->log2_max_pic_order_cnt_lsb_minus4 = pp->log2_max_pic_order_cnt_lsb_minus4;
+   sps->sps_max_dec_pic_buffering_minus1 = pp->sps_max_dec_pic_buffering_minus1;
+   sps->log2_min_luma_coding_block_size_minus3 = pp->log2_min_luma_coding_block_size_minus3;
+   sps->log2_diff_max_min_luma_coding_block_size = pp->log2_diff_max_min_luma_coding_block_size;
+   sps->log2_min_transform_block_size_minus2 = pp->log2_min_transform_block_size_minus2;
+   sps->log2_diff_max_min_transform_block_size = pp->log2_diff_max_min_transform_block_size;
+   sps->max_transform_hierarchy_depth_inter = pp->max_transform_hierarchy_depth_inter;
+   sps->max_transform_hierarchy_depth_intra = pp->max_transform_hierarchy_depth_intra;
+   sps->num_short_term_ref_pic_sets = pp->num_short_term_ref_pic_sets;
+   sps->num_long_term_ref_pics_sps = pp->num_long_term_ref_pics_sps;
+   sps->scaling_list_enabled_flag = pp->scaling_list_enabled_flag;
+   sps->amp_enabled_flag = pp->amp_enabled_flag;
+   sps->sample_adaptive_offset_enabled_flag = pp->sample_adaptive_offset_enabled_flag;
+   sps->pcm_enabled_flag = pp->pcm_enabled_flag;
+   sps->pcm_sample_bit_depth_luma_minus1 = pp->pcm_sample_bit_depth_luma_minus1;
+   sps->pcm_sample_bit_depth_chroma_minus1 = pp->pcm_sample_bit_depth_chroma_minus1;
+   sps->log2_min_pcm_luma_coding_block_size_minus3 = pp->log2_min_pcm_luma_coding_block_size_minus3;
+   sps->log2_diff_max_min_pcm_luma_coding_block_size = pp->log2_diff_max_min_pcm_luma_coding_block_size;
+   sps->pcm_loop_filter_disabled_flag = pp->pcm_loop_filter_disabled_flag;
+   sps->long_term_ref_pics_present_flag = pp->long_term_ref_pics_present_flag;
+   sps->sps_temporal_mvp_enabled_flag = pp->sps_temporal_mvp_enabled_flag;
+   sps->strong_intra_smoothing_enabled_flag = pp->strong_intra_smoothing_enabled_flag;
+
+   pps->dependent_slice_segments_enabled_flag = pp->dependent_slice_segments_enabled_flag;
+   pps->output_flag_present_flag = pp->output_flag_present_flag;
+   pps->num_extra_slice_header_bits = pp->num_extra_slice_header_bits;
+   pps->sign_data_hiding_enabled_flag = pp->sign_data_hiding_enabled_flag;
+   pps->cabac_init_present_flag = pp->cabac_init_present_flag;
+   pps->num_ref_idx_l0_default_active_minus1 = pp->num_ref_idx_l0_default_active_minus1;
+   pps->num_ref_idx_l1_default_active_minus1 = pp->num_ref_idx_l1_default_active_minus1;
+   pps->init_qp_minus26 = pp->init_qp_minus26;
+   pps->constrained_intra_pred_flag = pp->constrained_intra_pred_flag;
+   pps->transform_skip_enabled_flag = pp->transform_skip_enabled_flag;
+   pps->cu_qp_delta_enabled_flag = pp->cu_qp_delta_enabled_flag;
+   pps->diff_cu_qp_delta_depth = pp->diff_cu_qp_delta_depth;
+   pps->pps_cb_qp_offset = pp->pps_cb_qp_offset;
+   pps->pps_cr_qp_offset = pp->pps_cr_qp_offset;
+   pps->pps_slice_chroma_qp_offsets_present_flag = pp->pps_slice_chroma_qp_offsets_present_flag;
+   pps->weighted_pred_flag = pp->weighted_pred_flag;
+   pps->weighted_bipred_flag = pp->weighted_bipred_flag;
+   pps->transquant_bypass_enabled_flag = pp->transquant_bypass_enabled_flag;
+   pps->tiles_enabled_flag = pp->tiles_enabled_flag;
+   pps->entropy_coding_sync_enabled_flag = pp->entropy_coding_sync_enabled_flag;
+   pps->uniform_spacing_flag = pp->uniform_spacing_flag;
+   pps->loop_filter_across_tiles_enabled_flag = pp->loop_filter_across_tiles_enabled_flag;
+   pps->pps_loop_filter_across_slices_enabled_flag = pp->pps_loop_filter_across_slices_enabled_flag;
+   pps->deblocking_filter_override_enabled_flag = pp->deblocking_filter_override_enabled_flag;
+   pps->pps_deblocking_filter_disabled_flag = pp->pps_deblocking_filter_disabled_flag;
+   pps->lists_modification_present_flag = pp->lists_modification_present_flag;
+   pps->slice_segment_header_extension_present_flag = pp->slice_segment_header_extension_present_flag;
+   pps->pps_beta_offset_div2 = pp->pps_beta_offset_div2;
+   pps->pps_tc_offset_div2 = pp->pps_tc_offset_div2;
+   pps->log2_parallel_merge_level_minus2 = pp->log2_parallel_merge_level_minus2;
+   pps->st_rps_bits = pp->wNumBitsForShortTermRPSInSlice;
+   if (pp->tiles_enabled_flag) {
+      pps->num_tile_columns_minus1 = pp->num_tile_columns_minus1;
+      pps->num_tile_rows_minus1 = pp->num_tile_rows_minus1;
+      for (unsigned i = 0; i < MIN2(ARRAY_SIZE(pp->column_width_minus1), ARRAY_SIZE(pps->column_width_minus1)); i++) {
+         pps->column_width_minus1[i] = pp->column_width_minus1[i];
+      }
+      for (unsigned i = 0; i < MIN2(ARRAY_SIZE(pp->row_height_minus1), ARRAY_SIZE(pps->row_height_minus1)); i++) {
+         pps->row_height_minus1[i] = pp->row_height_minus1[i];
+      }
+   }
+
+   /* the scaling lists: DXVA's in up-right diagonal order, gallium's (VA-API's) in raster order; flat without them */
+   memset(sps->ScalingList4x4, 16, sizeof sps->ScalingList4x4);
+   memset(sps->ScalingList8x8, 16, sizeof sps->ScalingList8x8);
+   memset(sps->ScalingList16x16, 16, sizeof sps->ScalingList16x16);
+   memset(sps->ScalingList32x32, 16, sizeof sps->ScalingList32x32);
+   memset(sps->ScalingListDCCoeff16x16, 16, sizeof sps->ScalingListDCCoeff16x16);
+   memset(sps->ScalingListDCCoeff32x32, 16, sizeof sps->ScalingListDCCoeff32x32);
+   if (pp->scaling_list_enabled_flag && dec->qmatrix.size() >= sizeof(DxvaQmatrix_HEVC)) {
+      const DxvaQmatrix_HEVC *qm = (const DxvaQmatrix_HEVC *)dec->qmatrix.data();
+      for (unsigned i = 0; i < 6; i++) {
+         for (unsigned j = 0; j < 16; j++) {
+            sps->ScalingList4x4[i][vl_zscan_h265_up_right_diagonal_16[j]] = qm->ucScalingLists0[i][j];
+         }
+         for (unsigned j = 0; j < 64; j++) {
+            sps->ScalingList8x8[i][vl_zscan_h265_up_right_diagonal[j]] = qm->ucScalingLists1[i][j];
+            sps->ScalingList16x16[i][vl_zscan_h265_up_right_diagonal[j]] = qm->ucScalingLists2[i][j];
+            if (i < 2) {
+               sps->ScalingList32x32[i][vl_zscan_h265_up_right_diagonal[j]] = qm->ucScalingLists3[i][j];
+            }
+         }
+      }
+      memcpy(sps->ScalingListDCCoeff16x16, qm->ucScalingListDCCoefSizeID2, sizeof qm->ucScalingListDCCoefSizeID2);
+      memcpy(sps->ScalingListDCCoeff32x32, qm->ucScalingListDCCoefSizeID3, sizeof qm->ucScalingListDCCoefSizeID3);
+   }
+
+   d->IDRPicFlag = pp->IdrPicFlag;
+   d->RAPPicFlag = pp->IrapPicFlag;
+   d->IntraPicFlag = pp->IntraPicFlag;
+   d->NumDeltaPocsOfRefRpsIdx = pp->ucNumDeltaPocsOfRefRpsIdx;
+   d->NumShortTermPictureSliceHeaderBits = pp->wNumBitsForShortTermRPSInSlice;
+   d->UseStRpsBits = true;
+   d->CurrPicOrderCntVal = pp->CurrPicOrderCntVal;
+   for (unsigned i = 0; i < 15; i++) {
+      DxvaPicEntry e = pp->RefPicList[i];
+      d->ref[i] = e.bPicEntry == DxvaInvalidEntry ? NULL : Surface(dec, e.Index7Bits);
+      d->IsLongTerm[i] = e.AssociatedFlag;
+      d->PicOrderCntVal[i] = pp->PicOrderCntValList[i];
+   }
+   for (unsigned i = 0; i < 8; i++) {
+      if (pp->RefPicSetStCurrBefore[i] != DxvaInvalidEntry) {
+         d->RefPicSetStCurrBefore[d->NumPocStCurrBefore++] = pp->RefPicSetStCurrBefore[i];
+      }
+      if (pp->RefPicSetStCurrAfter[i] != DxvaInvalidEntry) {
+         d->RefPicSetStCurrAfter[d->NumPocStCurrAfter++] = pp->RefPicSetStCurrAfter[i];
+      }
+      if (pp->RefPicSetLtCurr[i] != DxvaInvalidEntry) {
+         d->RefPicSetLtCurr[d->NumPocLtCurr++] = pp->RefPicSetLtCurr[i];
+      }
+   }
+   d->NumPocTotalCurr = d->NumPocStCurrBefore + d->NumPocStCurrAfter + d->NumPocLtCurr;
+   /* ponytail: no per-slice reference lists (the short slice format has none): NVIDIA's VA-API driver builds them
+    * from the reference sets, Mesa's (AMD) read RefPicList - those need the slice headers parsed */
+   return true;
+}
+
+static bool
+VP9Picture(DxvaDecoder *dec)
+{
+   if (dec->pic_params.size() < sizeof(DxvaPicParams_VP9)) {
+      return false;
+   }
+   const DxvaPicParams_VP9 *pp = (const DxvaPicParams_VP9 *)dec->pic_params.data();
+   struct pipe_vp9_picture_desc *d = &dec->desc.vp9;
+   memset(d, 0, sizeof *d);
+
+   for (unsigned i = 0; i < 8; i++) {
+      DxvaPicEntry e = pp->ref_frame_map[i];
+      d->ref[i] = e.bPicEntry == DxvaInvalidEntry || e.Index7Bits == 0x7f ? NULL : Surface(dec, e.Index7Bits);
+   }
+   /* DXVA's active references are surfaces, VA-API's (gallium's) slots of ref_frame_map: the slot of each */
+   unsigned slots[3] = {};
+   for (unsigned r = 0; r < 3; r++) {
+      for (unsigned i = 0; i < 8; i++) {
+         if (pp->ref_frame_map[i].bPicEntry != DxvaInvalidEntry &&
+             pp->ref_frame_map[i].Index7Bits == pp->frame_refs[r].Index7Bits) {
+            slots[r] = i;
+            break;
+         }
+      }
+   }
+
+   auto &pic = d->picture_parameter;
+   pic.frame_width = pp->width;
+   pic.frame_height = pp->height;
+   pic.pic_fields.subsampling_x = pp->subsampling_x;
+   pic.pic_fields.subsampling_y = pp->subsampling_y;
+   pic.pic_fields.frame_type = pp->frame_type;
+   pic.pic_fields.show_frame = pp->show_frame;
+   pic.pic_fields.error_resilient_mode = pp->error_resilient_mode;
+   pic.pic_fields.intra_only = pp->intra_only;
+   pic.pic_fields.allow_high_precision_mv = pp->allow_high_precision_mv;
+   /* DXVA's interpolation filters start with smooth, regular; VA-API's (the VP9 spec's) with regular, smooth */
+   pic.pic_fields.mcomp_filter_type = pp->interp_filter ^ (pp->interp_filter <= 1);
+   pic.pic_fields.frame_parallel_decoding_mode = pp->frame_parallel_decoding_mode;
+   pic.pic_fields.reset_frame_context = pp->reset_frame_context;
+   pic.pic_fields.refresh_frame_context = pp->refresh_frame_context;
+   pic.pic_fields.frame_context_idx = pp->frame_context_idx;
+   pic.pic_fields.segmentation_enabled = pp->stVP9Segments.enabled;
+   pic.pic_fields.segmentation_temporal_update = pp->stVP9Segments.temporal_update;
+   pic.pic_fields.segmentation_update_map = pp->stVP9Segments.update_map;
+   pic.pic_fields.last_ref_frame = slots[0];
+   pic.pic_fields.last_ref_frame_sign_bias = pp->ref_frame_sign_bias[1];
+   pic.pic_fields.golden_ref_frame = slots[1];
+   pic.pic_fields.golden_ref_frame_sign_bias = pp->ref_frame_sign_bias[2];
+   pic.pic_fields.alt_ref_frame = slots[2];
+   pic.pic_fields.alt_ref_frame_sign_bias = pp->ref_frame_sign_bias[3];
+   pic.pic_fields.lossless_flag = pp->base_qindex == 0 && pp->y_dc_delta_q == 0 && pp->uv_dc_delta_q == 0 &&
+                                  pp->uv_ac_delta_q == 0;
+   pic.filter_level = pp->filter_level;
+   pic.sharpness_level = pp->sharpness_level;
+   pic.log2_tile_rows = pp->log2_tile_rows;
+   pic.log2_tile_columns = pp->log2_tile_cols;
+   pic.frame_header_length_in_bytes = pp->uncompressed_header_size_byte_aligned;
+   pic.first_partition_size = pp->first_partition_size;
+   memcpy(pic.mb_segment_tree_probs, pp->stVP9Segments.tree_probs, sizeof pic.mb_segment_tree_probs);
+   memcpy(pic.segment_pred_probs, pp->stVP9Segments.pred_probs, sizeof pic.segment_pred_probs);
+   pic.profile = pp->profile;
+   pic.bit_depth = pp->BitDepthMinus8Luma + 8;
+   pic.mode_ref_delta_enabled = pp->mode_ref_delta_enabled;
+   pic.mode_ref_delta_update = pp->mode_ref_delta_update;
+   pic.base_qindex = pp->base_qindex;
+   pic.y_dc_delta_q = pp->y_dc_delta_q;
+   pic.uv_ac_delta_q = pp->uv_ac_delta_q;
+   pic.uv_dc_delta_q = pp->uv_dc_delta_q;
+   pic.abs_delta = pp->stVP9Segments.abs_delta;
+   for (unsigned i = 0; i < 4; i++) {
+      pic.ref_deltas[i] = pp->ref_deltas[i];
+   }
+   for (unsigned i = 0; i < 2; i++) {
+      pic.mode_deltas[i] = pp->mode_deltas[i];
+   }
+
+   auto &slice = d->slice_parameter;
+   slice.slice_count = 1;
+   slice.slice_data_size[0] = dec->stream.size();
+   slice.slice_data_offset[0] = 0;
+   slice.slice_data_flag[0] = PIPE_SLICE_BUFFER_PLACEMENT_TYPE_WHOLE;
+   for (unsigned i = 0; i < 8; i++) {
+      uint8_t mask = pp->stVP9Segments.feature_mask[i];
+      auto &seg = slice.seg_param[i];
+      seg.alt_quant_enabled = mask & 1;
+      seg.alt_quant = pp->stVP9Segments.feature_data[i][0];
+      seg.alt_lf_enabled = (mask >> 1) & 1;
+      seg.alt_lf = pp->stVP9Segments.feature_data[i][1];
+      seg.segment_flags.segment_reference_enabled = (mask >> 2) & 1;
+      seg.segment_flags.segment_reference = pp->stVP9Segments.feature_data[i][2];
+      seg.segment_flags.segment_reference_skipped = (mask >> 3) & 1;
+   }
+   /* ponytail: no per-segment quantizer scales and loop filter levels (VA-API wants them derived): NVIDIA's VA-API
+    * driver reads those from the frame header, Mesa's (AMD) need the derivation (VP9 spec 8.6.1, 8.8.1) */
+   return true;
+}
+
+static bool
+AV1Picture(DxvaDecoder *dec)
+{
+   if (dec->pic_params.size() < sizeof(DxvaPicParams_AV1) || dec->tiles.empty()) {
+      return false;
+   }
+   const DxvaPicParams_AV1 *pp = (const DxvaPicParams_AV1 *)dec->pic_params.data();
+   struct pipe_av1_picture_desc *d = &dec->desc.av1;
+   memset(d, 0, sizeof *d);
+   auto &pic = d->picture_parameter;
+
+   /* the 8 reference slots, and which of them the 7 references are (DXVA's frame_refs[].Index is the slot) */
+   for (unsigned i = 0; i < 8; i++) {
+      d->ref[i] = pp->RefFrameMapTextureIndex[i] == DxvaInvalidEntry ? NULL : Surface(dec, pp->RefFrameMapTextureIndex[i]);
+   }
+   for (unsigned i = 0; i < 7; i++) {
+      const DxvaPicEntry_AV1 &e = pp->frame_refs[i];
+      pic.ref_frame_idx[i] = e.Index == DxvaInvalidEntry ? 0 : e.Index;
+      pic.wm[i].invalid = e.wminvalid;
+      pic.wm[i].wmtype = e.wmtype;
+      for (unsigned j = 0; j < 6; j++) {
+         pic.wm[i].wmmat[j] = e.wmmat[j];
+      }
+   }
+
+   pic.profile = pp->seq_profile;
+   pic.order_hint_bits_minus_1 = pp->order_hint_bits ? pp->order_hint_bits - 1 : 0;
+   pic.bit_depth_idx = pp->bitdepth == 12 ? 2 : pp->bitdepth == 10 ? 1 : 0;
+   pic.matrix_coefficients = pp->film_grain.matrix_coeff_is_identity ? 0 : 1;
+   pic.seq_info_fields.use_128x128_superblock = pp->coding.use_128x128_superblock;
+   pic.seq_info_fields.enable_filter_intra = pp->coding.filter_intra;
+   pic.seq_info_fields.enable_intra_edge_filter = pp->coding.intra_edge_filter;
+   pic.seq_info_fields.enable_interintra_compound = pp->coding.interintra_compound;
+   pic.seq_info_fields.enable_masked_compound = pp->coding.masked_compound;
+   pic.seq_info_fields.enable_dual_filter = pp->coding.dual_filter;
+   pic.seq_info_fields.enable_order_hint = pp->order_hint_bits != 0;
+   pic.seq_info_fields.enable_jnt_comp = pp->coding.jnt_comp;
+   pic.seq_info_fields.enable_cdef = pp->coding.cdef;
+   pic.seq_info_fields.mono_chrome = pp->format.mono_chrome;
+   pic.seq_info_fields.ref_frame_mvs = pp->coding.enable_ref_frame_mvs;
+   pic.seq_info_fields.film_grain_params_present = pp->coding.film_grain;
+
+   pic.frame_width = pp->width;
+   pic.frame_height = pp->height;
+   pic.max_width = pp->max_width;
+   pic.max_height = pp->max_height;
+   pic.primary_ref_frame = pp->primary_ref_frame;
+   pic.order_hint = pp->order_hint;
+   pic.superres_scale_denominator = pp->superres_denom;
+   pic.interp_filter = pp->interp_filter;
+
+   pic.pic_info_fields.frame_type = pp->format.frame_type;
+   pic.pic_info_fields.show_frame = pp->format.show_frame;
+   pic.pic_info_fields.showable_frame = pp->format.showable_frame;
+   pic.pic_info_fields.disable_cdf_update = pp->coding.disable_cdf_update;
+   pic.pic_info_fields.allow_screen_content_tools = pp->coding.screen_content_tools;
+   pic.pic_info_fields.force_integer_mv = pp->coding.integer_mv;
+   pic.pic_info_fields.allow_intrabc = pp->coding.intrabc;
+   pic.pic_info_fields.use_superres = pp->coding.superres;
+   pic.pic_info_fields.allow_high_precision_mv = pp->coding.high_precision_mv;
+   pic.pic_info_fields.is_motion_mode_switchable = pp->coding.switchable_motion_mode;
+   pic.pic_info_fields.use_ref_frame_mvs = pp->coding.use_ref_frame_mvs;
+   pic.pic_info_fields.disable_frame_end_update_cdf = pp->coding.disable_frame_end_update_cdf;
+   pic.pic_info_fields.allow_warped_motion = pp->coding.warped_motion;
+
+   /* the tiles: their sizes in superblocks (DXVA has them for uniform spacing too) */
+   pic.tile_cols = pp->tiles.cols;
+   pic.tile_rows = pp->tiles.rows;
+   pic.context_update_tile_id = pp->tiles.context_update_id;
+   for (unsigned i = 0, start = 0; i < MIN2(pp->tiles.cols, 64u); start += pp->tiles.widths[i], i++) {
+      pic.width_in_sbs[i] = pp->tiles.widths[i];
+      pic.tile_col_start_sb[i] = start;
+   }
+   for (unsigned i = 0, start = 0; i < MIN2(pp->tiles.rows, 64u); start += pp->tiles.heights[i], i++) {
+      pic.height_in_sbs[i] = pp->tiles.heights[i];
+      pic.tile_row_start_sb[i] = start;
+   }
+
+   pic.filter_level[0] = pp->loop_filter.filter_level[0];
+   pic.filter_level[1] = pp->loop_filter.filter_level[1];
+   pic.filter_level_u = pp->loop_filter.filter_level_u;
+   pic.filter_level_v = pp->loop_filter.filter_level_v;
+   pic.loop_filter_info_fields.sharpness_level = pp->loop_filter.sharpness_level;
+   pic.loop_filter_info_fields.mode_ref_delta_enabled = pp->loop_filter.mode_ref_delta_enabled;
+   pic.loop_filter_info_fields.mode_ref_delta_update = pp->loop_filter.mode_ref_delta_update;
+   for (unsigned i = 0; i < 8; i++) {
+      pic.ref_deltas[i] = pp->loop_filter.ref_deltas[i];
+   }
+   pic.mode_deltas[0] = pp->loop_filter.mode_deltas[0];
+   pic.mode_deltas[1] = pp->loop_filter.mode_deltas[1];
+   pic.mode_control_fields.delta_lf_present_flag = pp->loop_filter.delta_lf_present;
+   pic.mode_control_fields.log2_delta_lf_res = pp->loop_filter.delta_lf_res;
+   pic.mode_control_fields.delta_lf_multi = pp->loop_filter.delta_lf_multi;
+
+   /* loop restoration: DXVA has the unit sizes, VA-API (gallium) the shifts */
+   pic.loop_restoration_fields.yframe_restoration_type = pp->loop_filter.frame_restoration_type[0];
+   pic.loop_restoration_fields.cbframe_restoration_type = pp->loop_filter.frame_restoration_type[1];
+   pic.loop_restoration_fields.crframe_restoration_type = pp->loop_filter.frame_restoration_type[2];
+   if (pp->loop_filter.frame_restoration_type[0] || pp->loop_filter.frame_restoration_type[1] ||
+       pp->loop_filter.frame_restoration_type[2]) {
+      pic.loop_restoration_fields.lr_unit_shift = pp->loop_filter.log2_restoration_unit_size[0] - 6;
+      pic.loop_restoration_fields.lr_uv_shift = pp->loop_filter.log2_restoration_unit_size[0] -
+                                                pp->loop_filter.log2_restoration_unit_size[1];
+   }
+
+   pic.base_qindex = pp->quantization.base_qindex;
+   pic.y_dc_delta_q = pp->quantization.y_dc_delta_q;
+   pic.u_dc_delta_q = pp->quantization.u_dc_delta_q;
+   pic.u_ac_delta_q = pp->quantization.u_ac_delta_q;
+   pic.v_dc_delta_q = pp->quantization.v_dc_delta_q;
+   pic.v_ac_delta_q = pp->quantization.v_ac_delta_q;
+   pic.qmatrix_fields.using_qmatrix = pp->quantization.qm_y != 0xff;
+   if (pic.qmatrix_fields.using_qmatrix) {
+      pic.qmatrix_fields.qm_y = pp->quantization.qm_y;
+      pic.qmatrix_fields.qm_u = pp->quantization.qm_u;
+      pic.qmatrix_fields.qm_v = pp->quantization.qm_v;
+   }
+   pic.mode_control_fields.delta_q_present_flag = pp->quantization.delta_q_present;
+   pic.mode_control_fields.log2_delta_q_res = pp->quantization.delta_q_res;
+   pic.mode_control_fields.tx_mode = pp->coding.tx_mode;
+   pic.mode_control_fields.reference_select = pp->coding.reference_mode;
+   pic.mode_control_fields.reduced_tx_set_used = pp->coding.reduced_tx_set;
+   pic.mode_control_fields.skip_mode_present = pp->coding.skip_mode;
+
+   /* CDEF strengths: DXVA's split, VA-API's (gallium's) primary << 2 | secondary */
+   pic.cdef_damping_minus_3 = pp->cdef.damping;
+   pic.cdef_bits = pp->cdef.bits;
+   for (unsigned i = 0; i < 8; i++) {
+      pic.cdef_y_strengths[i] = pp->cdef.y_strengths[i].primary << 2 | pp->cdef.y_strengths[i].secondary;
+      pic.cdef_uv_strengths[i] = pp->cdef.uv_strengths[i].primary << 2 | pp->cdef.uv_strengths[i].secondary;
+   }
+
+   pic.seg_info.segment_info_fields.enabled = pp->segmentation.enabled;
+   pic.seg_info.segment_info_fields.update_map = pp->segmentation.update_map;
+   pic.seg_info.segment_info_fields.update_data = pp->segmentation.update_data;
+   pic.seg_info.segment_info_fields.temporal_update = pp->segmentation.temporal_update;
+   for (unsigned i = 0; i < 8; i++) {
+      pic.seg_info.feature_mask[i] = pp->segmentation.feature_mask[i];
+      for (unsigned j = 0; j < 8; j++) {
+         pic.seg_info.feature_data[i][j] = pp->segmentation.feature_data[i][j];
+      }
+   }
+
+   /* film grain (applied on the target: no separate film grain picture) */
+   auto &fg = pic.film_grain_info;
+   auto &dfg = pp->film_grain;
+   fg.film_grain_info_fields.apply_grain = dfg.apply_grain;
+   if (dfg.apply_grain) {
+      fg.film_grain_info_fields.chroma_scaling_from_luma = dfg.chroma_scaling_from_luma;
+      fg.film_grain_info_fields.grain_scaling_minus_8 = dfg.scaling_shift_minus8;
+      fg.film_grain_info_fields.ar_coeff_lag = dfg.ar_coeff_lag;
+      fg.film_grain_info_fields.ar_coeff_shift_minus_6 = dfg.ar_coeff_shift_minus6;
+      fg.film_grain_info_fields.grain_scale_shift = dfg.grain_scale_shift;
+      fg.film_grain_info_fields.overlap_flag = dfg.overlap_flag;
+      fg.film_grain_info_fields.clip_to_restricted_range = dfg.clip_to_restricted_range;
+      fg.grain_seed = dfg.grain_seed;
+      fg.num_y_points = dfg.num_y_points;
+      for (unsigned i = 0; i < MIN2(dfg.num_y_points, 14u); i++) {
+         fg.point_y_value[i] = dfg.scaling_points_y[i][0];
+         fg.point_y_scaling[i] = dfg.scaling_points_y[i][1];
+      }
+      fg.num_cb_points = dfg.num_cb_points;
+      for (unsigned i = 0; i < MIN2(dfg.num_cb_points, 10u); i++) {
+         fg.point_cb_value[i] = dfg.scaling_points_cb[i][0];
+         fg.point_cb_scaling[i] = dfg.scaling_points_cb[i][1];
+      }
+      fg.num_cr_points = dfg.num_cr_points;
+      for (unsigned i = 0; i < MIN2(dfg.num_cr_points, 10u); i++) {
+         fg.point_cr_value[i] = dfg.scaling_points_cr[i][0];
+         fg.point_cr_scaling[i] = dfg.scaling_points_cr[i][1];
+      }
+      /* DXVA's coefficients are the bitstream's ar_coeffs_*_plus_128, VA's the values */
+      for (unsigned i = 0; i < 24; i++) {
+         fg.ar_coeffs_y[i] = (int8_t)(dfg.ar_coeffs_y[i] - 128);
+      }
+      for (unsigned i = 0; i < 25; i++) {
+         fg.ar_coeffs_cb[i] = (int8_t)(dfg.ar_coeffs_cb[i] - 128);
+         fg.ar_coeffs_cr[i] = (int8_t)(dfg.ar_coeffs_cr[i] - 128);
+      }
+      fg.cb_mult = dfg.cb_mult;
+      fg.cb_luma_mult = dfg.cb_luma_mult;
+      fg.cb_offset = dfg.cb_offset;
+      fg.cr_mult = dfg.cr_mult;
+      fg.cr_luma_mult = dfg.cr_luma_mult;
+      fg.cr_offset = dfg.cr_offset;
+   }
+
+   auto &slice = d->slice_parameter;
+   slice.slice_count = MIN2((unsigned)dec->tiles.size(), (unsigned)ARRAY_SIZE(slice.slice_data_size));
+   for (unsigned i = 0; i < slice.slice_count; i++) {
+      slice.slice_data_size[i] = dec->tiles[i].DataSize;
+      slice.slice_data_offset[i] = dec->tiles[i].DataOffset;
+      slice.slice_data_row[i] = dec->tiles[i].row;
+      slice.slice_data_col[i] = dec->tiles[i].column;
+      slice.slice_data_anchor_frame_idx[i] = dec->tiles[i].anchor_frame;
+   }
+   return true;
+}
+
+/* MPEG-2's default intra quantizer matrix (zig-zag order), for programs that send none */
+static const uint8_t MPEG2_DEFAULT_INTRA[64] = {
+   8,  16, 16, 19, 16, 19, 22, 22, 22, 22, 22, 22, 26, 24, 26, 27, 27, 27, 26, 26, 26, 26, 27, 27, 27, 29, 29, 29, 34, 34, 34, 29,
+   29, 29, 27, 27, 29, 29, 32, 32, 34, 34, 37, 38, 37, 35, 35, 34, 35, 38, 38, 40, 40, 40, 48, 48, 46, 46, 56, 56, 58, 69, 69, 83,
+};
+
+static bool
+MPEG2Picture(DxvaDecoder *dec)
+{
+   if (dec->pic_params.size() < sizeof(DxvaPictureParameters)) {
+      return false;
+   }
+   const DxvaPictureParameters *pp = (const DxvaPictureParameters *)dec->pic_params.data();
+   struct pipe_mpeg12_picture_desc *d = &dec->desc.mpeg2;
+   memset(d, 0, sizeof *d);
+
+   d->picture_coding_type = pp->bPicIntra ? 1 : pp->bPicBackwardPrediction ? 3 : 2;   /* I, B, P */
+   /* f_codes: DXVA's as coded, gallium's (VA-API's) minus one */
+   d->f_code[0][0] = ((pp->wBitstreamFcodes >> 12) & 0xf) - 1;
+   d->f_code[0][1] = ((pp->wBitstreamFcodes >> 8) & 0xf) - 1;
+   d->f_code[1][0] = ((pp->wBitstreamFcodes >> 4) & 0xf) - 1;
+   d->f_code[1][1] = (pp->wBitstreamFcodes & 0xf) - 1;
+   uint16_t pce = pp->wBitstreamPCEelements;
+   d->intra_dc_precision = (pce >> 14) & 3;
+   d->picture_structure = (pce >> 12) & 3;
+   d->top_field_first = (pce >> 11) & 1;
+   d->frame_pred_frame_dct = (pce >> 10) & 1;
+   d->concealment_motion_vectors = (pce >> 9) & 1;
+   d->q_scale_type = (pce >> 8) & 1;
+   d->intra_vlc_format = (pce >> 7) & 1;
+   d->alternate_scan = (pce >> 6) & 1;
+   d->num_slices = dec->slices;
+
+   memcpy(dec->intra_matrix, MPEG2_DEFAULT_INTRA, 64);
+   memset(dec->non_intra_matrix, 16, 64);
+   if (dec->qmatrix.size() >= sizeof(DxvaQmatrixData)) {
+      const DxvaQmatrixData *qm = (const DxvaQmatrixData *)dec->qmatrix.data();
+      for (unsigned i = 0; i < 64; i++) {
+         if (qm->bNewQmatrix[0]) {
+            dec->intra_matrix[i] = (uint8_t)qm->Qmatrix[0][i];
+         }
+         if (qm->bNewQmatrix[1]) {
+            dec->non_intra_matrix[i] = (uint8_t)qm->Qmatrix[1][i];
+         }
+      }
+   }
+   d->intra_matrix = dec->intra_matrix;
+   d->non_intra_matrix = dec->non_intra_matrix;
+
+   d->ref[0] = pp->wForwardRefPictureIndex == 0xffff ? NULL : Surface(dec, pp->wForwardRefPictureIndex);
+   d->ref[1] = pp->wBackwardRefPictureIndex == 0xffff ? NULL : Surface(dec, pp->wBackwardRefPictureIndex);
+   return true;
+}
+
+bool
+DxvaPicture(DxvaDecoder *dec)
+{
+   return dec->profile->codec == CODEC_H264 ? H264Picture(dec)
+        : dec->profile->codec == CODEC_HEVC ? HEVCPicture(dec)
+        : dec->profile->codec == CODEC_VP9  ? VP9Picture(dec)
+        : dec->profile->codec == CODEC_AV1  ? AV1Picture(dec)
+                                            : MPEG2Picture(dec);
+}
+
+int
+DxvaCurrentIndex(const DxvaDecoder *dec)
+{
+   const uint8_t *p = dec->pic_params.data();
+   size_t n = dec->pic_params.size();
+   switch (dec->profile->codec) {
+   case CODEC_H264:
+      return n >= sizeof(DxvaPicParams_H264) ? ((const DxvaPicParams_H264 *)p)->CurrPic.Index7Bits : -1;
+   case CODEC_HEVC:
+      return n >= sizeof(DxvaPicParams_HEVC) ? ((const DxvaPicParams_HEVC *)p)->CurrPic.Index7Bits : -1;
+   case CODEC_VP9:
+      return n >= sizeof(DxvaPicParams_VP9) ? ((const DxvaPicParams_VP9 *)p)->CurrPic.Index7Bits : -1;
+   case CODEC_AV1:
+      return n >= sizeof(DxvaPicParams_AV1) ? ((const DxvaPicParams_AV1 *)p)->CurrPicTextureIndex : -1;
+   default:
+      return n >= sizeof(DxvaPictureParameters) ? ((const DxvaPictureParameters *)p)->wDecodedPictureIndex : -1;
+   }
+}
+
+void
+DxvaDecode(DxvaDecoder *dec, struct pipe_video_buffer *target)
+{
+   struct pipe_picture_desc *picture = &dec->desc.h264.base;
+   picture->profile = dec->profile->profile;
+   picture->entry_point = PIPE_VIDEO_ENTRYPOINT_BITSTREAM;
+   const void *buffers[1] = {dec->stream.data()};
+   unsigned sizes[1] = {(unsigned)dec->stream.size()};
+   dec->codec->begin_frame(dec->codec, target, picture);
+   dec->codec->decode_bitstream(dec->codec, target, picture, 1, buffers, sizes);
+   dec->codec->end_frame(dec->codec, target, picture);
+}
