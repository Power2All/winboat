diff --git a/src/gallium/frontends/d3d9umd/decode.cpp b/src/gallium/frontends/d3d9umd/decode.cpp
new file mode 100644
index 0000000..c0cb0e7
--- /dev/null
+++ b/src/gallium/frontends/d3d9umd/decode.cpp
@@ -0,0 +1,577 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * DXVA2 decoding (what players with DXVA2 hardware decoding, ffmpeg's dxva2 and Kodi use): the decoder caps, the
+ * compressed buffers, and the Decode* entry points. The DXVA buffers become gallium picture descriptions through the
+ * Direct3D 11 driver's DXVA decoding (d3d10umd/DxvaDecode.cpp), on virgl's video codec (the host's VA-API decoder).
+ *
+ * The pictures: each NV12 surface the decoder writes gets the codec's video buffer (separate R8 and R8G8 planes,
+ * which the host keeps as the reference too). After each frame a pass on the video context copies them into the
+ * surface's own texture (L8: the luma rows, then the chroma rows; what locks, StretchRect and the video processor
+ * read). DXVA's surface indices (references, the current picture) name the surface last decoded with that index.
+ *
+ * Decoding and that pass run on a pipe context of their own (as Direct3D 11's video does); each context's work is
+ * finished before the other uses what it wrote. ponytail: NV12 only (no P010: HEVC Main 10, VP9 profile 2), a
+ * synchronous wait per frame (as in Direct3D 11).
+ */
+
+#include "d3d9umd.h"
+#include "../d3d10umd/DxvaDecode.h"
+
+#include "pipe/p_context.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include "util/os_time.h"
+#include "util/u_draw.h"
+#include "util/u_inlines.h"
+extern "C" {
+#include "tgsi/tgsi_text.h"
+}
+
+#include <new>
+#include <string.h>
+
+#define NV12_FOURCC ((D3DDDIFORMAT)MAKEFOURCC('N', 'V', '1', '2'))
+
+/* The profiles DXVA2 offers: the 8-bit ones (the surfaces are NV12) */
+static bool
+Offered(struct pipe_screen *screen, const VideoProfileInfo &p)
+{
+   return p.Outputs(DXGI_FORMAT_NV12) && ProfileSupported(screen, p);
+}
+
+static const VideoProfileInfo *
+OfferedProfile(struct pipe_screen *screen, const GUID *guid)
+{
+   const VideoProfileInfo *p = guid ? FindProfile(screen, guid) : NULL;
+   return p && p->Outputs(DXGI_FORMAT_NV12) ? p : NULL;
+}
+
+/* the compressed buffers a decoder takes, and their sizes */
+static const D3DDDIFORMAT BUFFER_TYPES[] = {D3DDDIFMT_PICTUREPARAMSDATA, D3DDDIFMT_INVERSEQUANTIZATIONDATA,
+                                            D3DDDIFMT_SLICECONTROLDATA, D3DDDIFMT_BITSTREAMDATA};
+
+static UINT
+BufferSize(D3DDDIFORMAT type, const DXVADDI_VIDEODESC *desc)
+{
+   switch (type) {
+   case D3DDDIFMT_PICTUREPARAMSDATA:
+      return MAX2(sizeof(DxvaPicParams_H264), sizeof(DxvaPicParams_AV1));
+   case D3DDDIFMT_INVERSEQUANTIZATIONDATA:
+      return sizeof(DxvaQmatrix_HEVC);
+   case D3DDDIFMT_SLICECONTROLDATA:
+      return 4096 * sizeof(DxvaTile_AV1);
+   default:
+      /* a compressed picture: at most about its raw size */
+      return MAX2(desc ? desc->SampleWidth * desc->SampleHeight * 3 / 2 : 0, 1u << 20);
+   }
+}
+
+template <typename T>
+static HRESULT
+PutArray(const D3DDDIARG_GETCAPS *p, const T *values, UINT count)
+{
+   if (!p->pData || p->DataSize < count * sizeof(T))
+      return E_INVALIDARG;
+   memcpy(p->pData, values, count * sizeof(T));
+   return S_OK;
+}
+
+static HRESULT
+PutCount(const D3DDDIARG_GETCAPS *p, UINT count)
+{
+   return PutArray(p, &count, 1);
+}
+
+bool
+D3D9UmdDecodeGetCaps(struct pipe_screen *screen, const D3DDDIARG_GETCAPS *p, HRESULT *hr)
+{
+   switch (p->Type) {
+   case D3DDDICAPS_GETDECODEGUIDCOUNT: {
+      UINT n = 0;
+      for (auto &profile : PROFILES)
+         n += Offered(screen, profile);
+      *hr = PutCount(p, n);
+      return true;
+   }
+   case D3DDDICAPS_GETDECODEGUIDS: {
+      GUID guids[ARRAY_SIZE(PROFILES)];
+      UINT n = 0;
+      for (auto &profile : PROFILES) {
+         if (Offered(screen, profile))
+            guids[n++] = profile.guid;
+      }
+      *hr = PutArray(p, guids, n);
+      return true;
+   }
+   case D3DDDICAPS_GETDECODERTFORMATCOUNT:
+      *hr = PutCount(p, OfferedProfile(screen, (const GUID *)p->pInfo) ? 1 : 0);
+      return true;
+   case D3DDDICAPS_GETDECODERTFORMATS: {
+      D3DDDIFORMAT f = NV12_FOURCC;
+      *hr = OfferedProfile(screen, (const GUID *)p->pInfo) ? PutArray(p, &f, 1) : E_INVALIDARG;
+      return true;
+   }
+   case D3DDDICAPS_GETDECODECOMPRESSEDBUFFERINFOCOUNT:
+   case D3DDDICAPS_GETDECODECONFIGURATIONCOUNT: {
+      const DXVADDI_DECODEINPUT *in = (const DXVADDI_DECODEINPUT *)p->pInfo;
+      bool ok = in && OfferedProfile(screen, in->pGuid);
+      *hr = PutCount(p, !ok ? 0 : p->Type == D3DDDICAPS_GETDECODECONFIGURATIONCOUNT ? 1 : ARRAY_SIZE(BUFFER_TYPES));
+      return true;
+   }
+   case D3DDDICAPS_GETDECODECOMPRESSEDBUFFERINFO: {
+      const DXVADDI_DECODEINPUT *in = (const DXVADDI_DECODEINPUT *)p->pInfo;
+      DXVADDI_DECODEBUFFERINFO info[ARRAY_SIZE(BUFFER_TYPES)];
+      memset(info, 0, sizeof(info));
+      for (unsigned i = 0; i < ARRAY_SIZE(BUFFER_TYPES); i++) {
+         info[i].CompressedBufferType = BUFFER_TYPES[i];
+         info[i].CreationWidth = BufferSize(BUFFER_TYPES[i], in ? &in->VideoDesc : NULL);
+         info[i].CreationHeight = 1;
+         info[i].CreationPool = D3DDDIPOOL_VIDEOMEMORY;
+      }
+      *hr = PutArray(p, info, ARRAY_SIZE(BUFFER_TYPES));
+      return true;
+   }
+   case D3DDDICAPS_GETDECODECONFIGURATIONS: {
+      const DXVADDI_DECODEINPUT *in = (const DXVADDI_DECODEINPUT *)p->pInfo;
+      const VideoProfileInfo *profile = in ? OfferedProfile(screen, in->pGuid) : NULL;
+      DXVADDI_CONFIGPICTUREDECODE c;
+      memset(&c, 0, sizeof(c));
+      c.guidConfigBitstreamEncryption = c.guidConfigMBcontrolEncryption = c.guidConfigResidDiffEncryption = NO_ENCRYPT;
+      /* the short slice format: for H.264 that's 2 (1 is the long one, with slice headers parsed) */
+      c.ConfigBitstreamRaw = profile && profile->codec == CODEC_H264 ? 2 : 1;
+      *hr = profile ? PutArray(p, &c, 1) : E_INVALIDARG;
+      return true;
+   }
+   default:
+      return false;
+   }
+}
+
+
+/*
+ * The compressed buffers: plain memory the application fills through locks
+ */
+
+bool
+D3D9UmdIsDecodeBuffer(D3DDDIFORMAT f)
+{
+   return f >= D3DDDIFMT_DXVACOMPBUFFER_BASE && f <= D3DDDIFMT_DXVA_RESERVED14;
+}
+
+
+/*
+ * The video context, and the copy of a decoded picture into its surface's texture
+ */
+
+struct D3D9UmdDecodeState {
+   struct pipe_context *pipe;
+   void *vs, *fs, *blend, *dsa, *rasterizer, *sampler, *velems;
+};
+
+static void
+Finish(struct pipe_context *pipe)
+{
+   struct pipe_fence_handle *fence = NULL;
+   pipe->flush(pipe, &fence, 0);
+   if (fence) {
+      pipe->screen->fence_finish(pipe->screen, NULL, fence, OS_TIMEOUT_INFINITE);
+      pipe->screen->fence_reference(pipe->screen, &fence, NULL);
+   }
+}
+
+/* A triangle over the whole target, from the vertex index alone */
+static const char COPY_VS[] = "VERT\n"
+                              "DCL SV[0], VERTEXID\n"
+                              "DCL OUT[0], POSITION\n"
+                              "DCL TEMP[0]\n"
+                              "IMM[0] FLT32 {-1.0, 3.0, 0.0, 1.0}\n"
+                              "IMM[1] INT32 {1, 2, 0, 0}\n"
+                              "USEQ TEMP[0].x, SV[0].xxxx, IMM[1].xxxx\n"
+                              "USEQ TEMP[0].y, SV[0].xxxx, IMM[1].yyyy\n"
+                              "UCMP TEMP[0].xy, TEMP[0].xyyy, IMM[0].yyyy, IMM[0].xxxx\n"
+                              "MOV TEMP[0].zw, IMM[0].zzzw\n"
+                              "MOV OUT[0], TEMP[0]\n"
+                              "END\n";
+
+/* Each texel of the L8 surface texture: below the picture's height (CONST[0].x) the luma texel, then the chroma
+ * rows, the even bytes Cb and the odd ones Cr of the R8G8 plane's row */
+static const char COPY_FS[] = "FRAG\n"
+                              "PROPERTY FS_COORD_ORIGIN UPPER_LEFT\n"
+                              "PROPERTY FS_COORD_PIXEL_CENTER HALF_INTEGER\n"
+                              "DCL IN[0], POSITION, LINEAR\n"
+                              "DCL OUT[0], COLOR\n"
+                              "DCL CONST[0]\n"
+                              "DCL SAMP[0]\n"
+                              "DCL SAMP[1]\n"
+                              "DCL SVIEW[0], 2D, FLOAT\n"
+                              "DCL SVIEW[1], 2D, FLOAT\n"
+                              "DCL TEMP[0..3]\n"
+                              "IMM[0] INT32 {0, 1, 0, 0}\n"
+                              "F2I TEMP[0].xy, IN[0].xyyy\n"
+                              "ISLT TEMP[2].x, TEMP[0].yyyy, CONST[0].xxxx\n"
+                              "UIF TEMP[2].xxxx\n"
+                              "  MOV TEMP[3], IMM[0].xxxx\n"
+                              "  MOV TEMP[3].xy, TEMP[0].xyyy\n"
+                              "  TXF TEMP[3], TEMP[3], SAMP[0], 2D\n"
+                              "  MOV OUT[0], TEMP[3].xxxx\n"
+                              "ELSE\n"
+                              "  MOV TEMP[3], IMM[0].xxxx\n"
+                              "  ISHR TEMP[3].x, TEMP[0].xxxx, IMM[0].yyyy\n"
+                              "  INEG TEMP[1].x, CONST[0].xxxx\n"
+                              "  UADD TEMP[3].y, TEMP[0].yyyy, TEMP[1].xxxx\n"
+                              "  TXF TEMP[3], TEMP[3], SAMP[1], 2D\n"
+                              "  AND TEMP[2].y, TEMP[0].xxxx, IMM[0].yyyy\n"
+                              "  UCMP OUT[0], TEMP[2].yyyy, TEMP[3].yyyy, TEMP[3].xxxx\n"
+                              "ENDIF\n"
+                              "END\n";
+
+static void *
+MakeShader(struct pipe_context *pipe, const char *text, bool vertex)
+{
+   struct tgsi_token tokens[1024];
+   if (!tgsi_text_translate(text, tokens, ARRAY_SIZE(tokens))) {
+      D3D9UmdLog("decode: the %s shader doesn't translate", vertex ? "vertex" : "fragment");
+      return NULL;
+   }
+   struct pipe_shader_state state = {};
+   pipe_shader_state_from_tgsi(&state, tokens);
+   return vertex ? pipe->create_vs_state(pipe, &state) : pipe->create_fs_state(pipe, &state);
+}
+
+static D3D9UmdDecodeState *
+DecodeState(D3D9UmdDevice *dev)
+{
+   if (dev->decode)
+      return dev->decode->pipe ? dev->decode : NULL;
+   D3D9UmdDecodeState *s = new (std::nothrow) D3D9UmdDecodeState();
+   if (!s)
+      return NULL;
+   dev->decode = s;
+   struct pipe_context *pipe = dev->screen->context_create(dev->screen, NULL, 0);
+   if (!pipe)
+      return NULL;
+   s->vs = MakeShader(pipe, COPY_VS, true);
+   s->fs = MakeShader(pipe, COPY_FS, false);
+   struct pipe_blend_state blend = {};
+   blend.rt[0].colormask = PIPE_MASK_RGBA;
+   s->blend = pipe->create_blend_state(pipe, &blend);
+   struct pipe_depth_stencil_alpha_state dsa = {};
+   s->dsa = pipe->create_depth_stencil_alpha_state(pipe, &dsa);
+   struct pipe_rasterizer_state rast = {};
+   rast.half_pixel_center = 1;
+   rast.bottom_edge_rule = 1;
+   rast.depth_clip_near = rast.depth_clip_far = 1;
+   s->rasterizer = pipe->create_rasterizer_state(pipe, &rast);
+   struct pipe_sampler_state samp = {};
+   samp.wrap_s = samp.wrap_t = samp.wrap_r = PIPE_TEX_WRAP_CLAMP_TO_EDGE;
+   samp.min_img_filter = samp.mag_img_filter = PIPE_TEX_FILTER_NEAREST;
+   samp.min_mip_filter = PIPE_TEX_MIPFILTER_NONE;
+   s->sampler = pipe->create_sampler_state(pipe, &samp);
+   s->velems = pipe->create_vertex_elements_state(pipe, 0, NULL);
+   if (!s->vs || !s->fs || !s->blend || !s->dsa || !s->rasterizer || !s->sampler) {
+      pipe->destroy(pipe);
+      return NULL;
+   }
+   s->pipe = pipe;
+   return s;
+}
+
+void
+D3D9UmdDecodeDestroyDevice(D3D9UmdDevice *dev)
+{
+   D3D9UmdDecodeState *s = dev->decode;
+   if (!s)
+      return;
+   if (s->pipe) {
+      struct pipe_context *pipe = s->pipe;
+      pipe->delete_vs_state(pipe, s->vs);
+      pipe->delete_fs_state(pipe, s->fs);
+      pipe->delete_blend_state(pipe, s->blend);
+      pipe->delete_depth_stencil_alpha_state(pipe, s->dsa);
+      pipe->delete_rasterizer_state(pipe, s->rasterizer);
+      pipe->delete_sampler_state(pipe, s->sampler);
+      if (s->velems)
+         pipe->delete_vertex_elements_state(pipe, s->velems);
+      pipe->destroy(pipe);
+   }
+   delete s;
+   dev->decode = NULL;
+}
+
+/* The decoded picture (its planes) into the surface's L8 texture, on the video context */
+static bool
+CopyToSurface(D3D9UmdDecodeState *s, struct pipe_video_buffer *picture, struct pipe_resource *texture,
+              unsigned height)
+{
+   struct pipe_context *pipe = s->pipe;
+   struct pipe_sampler_view **planes = picture->get_sampler_view_planes(picture);
+   if (!planes || !planes[0] || !planes[1])
+      return false;
+   struct pipe_surface tmpl = {};
+   tmpl.format = texture->format;
+   struct pipe_surface *target = pipe->create_surface(pipe, texture, &tmpl);
+   if (!target)
+      return false;
+
+   struct pipe_framebuffer_state fb = {};
+   fb.width = texture->width0;
+   fb.height = texture->height0;
+   fb.nr_cbufs = 1;
+   fb.cbufs[0] = target;
+   pipe->set_framebuffer_state(pipe, &fb);
+   struct pipe_viewport_state vp = {};
+   vp.scale[0] = fb.width / 2.0f;
+   vp.scale[1] = fb.height / 2.0f;
+   vp.scale[2] = 1.0f;
+   vp.translate[0] = fb.width / 2.0f;
+   vp.translate[1] = fb.height / 2.0f;
+   vp.swizzle_x = PIPE_VIEWPORT_SWIZZLE_POSITIVE_X;
+   vp.swizzle_y = PIPE_VIEWPORT_SWIZZLE_POSITIVE_Y;
+   vp.swizzle_z = PIPE_VIEWPORT_SWIZZLE_POSITIVE_Z;
+   vp.swizzle_w = PIPE_VIEWPORT_SWIZZLE_POSITIVE_W;
+   pipe->set_viewport_states(pipe, 0, 1, &vp);
+   pipe->bind_blend_state(pipe, s->blend);
+   pipe->bind_depth_stencil_alpha_state(pipe, s->dsa);
+   pipe->bind_rasterizer_state(pipe, s->rasterizer);
+   pipe->bind_vertex_elements_state(pipe, s->velems);
+   pipe->bind_vs_state(pipe, s->vs);
+   pipe->bind_fs_state(pipe, s->fs);
+   void *samplers[2] = {s->sampler, s->sampler};
+   pipe->bind_sampler_states(pipe, PIPE_SHADER_FRAGMENT, 0, 2, samplers);
+   pipe->set_sampler_views(pipe, PIPE_SHADER_FRAGMENT, 0, 2, 0, false, planes);
+   uint32_t consts[4] = {height, 0, 0, 0};
+   struct pipe_constant_buffer cb = {};
+   cb.user_buffer = consts;
+   cb.buffer_size = sizeof(consts);
+   pipe->set_constant_buffer(pipe, PIPE_SHADER_FRAGMENT, 0, false, &cb);
+   util_draw_arrays(pipe, MESA_PRIM_TRIANGLES, 0, 3);
+
+   /* nothing of the surface's kept bound */
+   pipe->set_sampler_views(pipe, PIPE_SHADER_FRAGMENT, 0, 0, 2, false, NULL);
+   fb.nr_cbufs = 0;
+   fb.cbufs[0] = NULL;
+   pipe->set_framebuffer_state(pipe, &fb);
+   pipe_surface_reference(&target, NULL);
+   return true;
+}
+
+
+/*
+ * The decoder
+ */
+
+struct D3D9UmdDecoder : DxvaDecoder {
+   D3D9UmdDevice *dev;
+   /* the frame's surface */
+   D3D9UmdResource *target = NULL;
+   unsigned sub = 0;
+   /* the surface each DXVA index was last decoded into */
+   struct {
+      D3D9UmdResource *res;
+      unsigned sub;
+   } byIndex[128] = {};
+};
+
+/* A surface's decoder pictures (made at its first frame), on the video context */
+static struct pipe_video_buffer *
+Picture(D3D9UmdDecoder *dec, D3D9UmdResource *res, unsigned sub)
+{
+   if (!res || sub >= res->surfCount)
+      return NULL;
+   if (!res->decodePictures) {
+      res->decodePictures = (struct pipe_video_buffer **)calloc(res->surfCount, sizeof(*res->decodePictures));
+      if (!res->decodePictures)
+         return NULL;
+   }
+   if (!res->decodePictures[sub]) {
+      struct pipe_context *pipe = dec->dev->decode->pipe;
+      struct pipe_video_buffer tmpl = {};
+      tmpl.buffer_format = PIPE_FORMAT_NV12;
+      tmpl.width = res->width;
+      tmpl.height = res->height;
+      tmpl.interlaced = false;
+      res->decodePictures[sub] = pipe->create_video_buffer(pipe, &tmpl);
+   }
+   return res->decodePictures[sub];
+}
+
+static struct pipe_video_buffer *
+SurfaceOfIndex(DxvaDecoder *d, unsigned index)
+{
+   D3D9UmdDecoder *dec = static_cast<D3D9UmdDecoder *>(d);
+   if (index < ARRAY_SIZE(dec->byIndex) && dec->byIndex[index].res)
+      return Picture(dec, dec->byIndex[index].res, dec->byIndex[index].sub);
+   /* a reference this decoder never wrote (decoding started past it): the frame's own picture, never a crash */
+   return Picture(dec, dec->target, dec->sub);
+}
+
+void
+D3D9UmdDecodeReleaseResource(D3D9UmdDevice *dev, D3D9UmdResource *res)
+{
+   free(res->decodeBuffer);
+   res->decodeBuffer = NULL;
+   if (res->decodePictures) {
+      for (UINT i = 0; i < res->surfCount; i++) {
+         if (res->decodePictures[i])
+            res->decodePictures[i]->destroy(res->decodePictures[i]);
+      }
+      free(res->decodePictures);
+      res->decodePictures = NULL;
+   }
+}
+
+static HRESULT APIENTRY
+CreateDecodeDevice(HANDLE hDevice, D3DDDIARG_CREATEDECODEDEVICE *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   const VideoProfileInfo *profile = OfferedProfile(dev->screen, p->pGuid);
+   D3D9UmdDecodeState *s = profile ? DecodeState(dev) : NULL;
+   if (!s || !s->pipe->create_video_codec) {
+      D3D9UmdLog("CreateDecodeDevice: %s", profile ? "no video context" : "a profile not offered");
+      return E_INVALIDARG;
+   }
+   struct pipe_video_codec templat = {};
+   templat.profile = profile->profile;
+   templat.entrypoint = PIPE_VIDEO_ENTRYPOINT_BITSTREAM;
+   templat.chroma_format = PIPE_VIDEO_CHROMA_FORMAT_420;
+   templat.width = p->VideoDesc.SampleWidth;
+   templat.height = p->VideoDesc.SampleHeight;
+   templat.max_references = 16;
+   templat.expect_chunked_decode = true;
+   struct pipe_video_codec *codec = s->pipe->create_video_codec(s->pipe, &templat);
+   if (!codec) {
+      D3D9UmdLog("CreateDecodeDevice: no codec for profile %d %ux%u", profile->profile, templat.width,
+                 templat.height);
+      return E_FAIL;
+   }
+   D3D9UmdDecoder *dec = new (std::nothrow) D3D9UmdDecoder();
+   if (!dec) {
+      codec->destroy(codec);
+      return E_OUTOFMEMORY;
+   }
+   dec->dev = dev;
+   dec->profile = profile;
+   dec->codec = codec;
+   dec->width = templat.width;
+   dec->height = templat.height;
+   dec->surface = SurfaceOfIndex;
+   p->hDecode = dec;
+   D3D9UMD_TRACE("CreateDecodeDevice profile %d %ux%u -> %p", profile->profile, templat.width, templat.height, dec);
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+DestroyDecodeDevice(HANDLE hDevice, HANDLE hDecode)
+{
+   D3D9UmdDecoder *dec = (D3D9UmdDecoder *)hDecode;
+   dec->codec->destroy(dec->codec);
+   delete dec;
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+SetDecodeRenderTarget(HANDLE hDevice, const D3DDDIARG_SETDECODERENDERTARGET *p)
+{
+   D3D9UmdDecoder *dec = (D3D9UmdDecoder *)p->hDecode;
+   D3D9UmdResource *res = D3D9UmdCastResource(p->hRenderTarget);
+   if (res->format != NV12_FOURCC || p->SubResourceIndex >= res->surfCount)
+      return E_INVALIDARG;
+   dec->target = res;
+   dec->sub = p->SubResourceIndex;
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+DecodeBeginFrame(HANDLE hDevice, D3DDDIARG_DECODEBEGINFRAME *p)
+{
+   D3D9UmdDecoder *dec = (D3D9UmdDecoder *)p->hDecode;
+   DxvaBeginFrame(dec);
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+DecodeExecute(HANDLE hDevice, const D3DDDIARG_DECODEEXECUTE *p)
+{
+   D3D9UmdDecoder *dec = (D3D9UmdDecoder *)p->hDecode;
+   const uint8_t *slice_control = NULL, *bitstream = NULL;
+   unsigned slice_control_size = 0, bitstream_size = 0;
+   for (UINT i = 0; i < p->NumCompBuffers; i++) {
+      const DXVADDI_DECODEBUFFERDESC &b = p->pCompressedBuffers[i];
+      D3D9UmdResource *res = D3D9UmdCastResource(b.hBuffer);
+      if (!res || !res->decodeBuffer || b.DataOffset > res->decodeBufferSize ||
+          b.DataSize > res->decodeBufferSize - b.DataOffset) {
+         D3D9UmdLog("DecodeExecute: buffer %u (type %u, %u bytes at %u) isn't a decoder buffer of ours", i,
+                    (unsigned)b.CompressedBufferType, b.DataSize, b.DataOffset);
+         return E_INVALIDARG;
+      }
+      const uint8_t *data = res->decodeBuffer + b.DataOffset;
+      switch (b.CompressedBufferType) {
+      case D3DDDIFMT_PICTUREPARAMSDATA:
+         dec->pic_params.assign(data, data + b.DataSize);
+         break;
+      case D3DDDIFMT_INVERSEQUANTIZATIONDATA:
+         dec->qmatrix.assign(data, data + b.DataSize);
+         break;
+      case D3DDDIFMT_SLICECONTROLDATA:
+         slice_control = data;
+         slice_control_size = b.DataSize;
+         break;
+      case D3DDDIFMT_BITSTREAMDATA:
+         bitstream = data;
+         bitstream_size = b.DataSize;
+         break;
+      default:
+         break;
+      }
+   }
+   if (slice_control && bitstream &&
+       !DxvaAddSlices(dec, slice_control, slice_control_size, bitstream, bitstream_size))
+      return E_INVALIDARG;
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+DecodeEndFrame(HANDLE hDevice, D3DDDIARG_DECODEENDFRAME *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   D3D9UmdDecoder *dec = (D3D9UmdDecoder *)p->hDecode;
+   if (!dec->target || dec->stream.empty())
+      return S_OK;
+   int index = DxvaCurrentIndex(dec);
+   if (index >= 0 && index < (int)ARRAY_SIZE(dec->byIndex)) {
+      dec->byIndex[index].res = dec->target;
+      dec->byIndex[index].sub = dec->sub;
+   }
+   struct pipe_resource *texture = nddi_video_texture(dec->target->nine, dec->sub);
+   struct pipe_video_buffer *picture = Picture(dec, dec->target, dec->sub);
+   if (!DxvaPicture(dec) || !picture || !texture) {
+      D3D9UmdLog("DecodeEndFrame: %s (picture parameters %zu bytes)", !picture || !texture ? "no target" :
+                 "no picture parameters", dec->pic_params.size());
+      dec->target = NULL;
+      return S_OK;
+   }
+   /* what the device did with the surface first; the picture, its copy into the surface, done before the device
+    * reads it */
+   Finish(nddi_flush(dev->nine));
+   DxvaDecode(dec, picture);
+   if (!CopyToSurface(dev->decode, picture, texture, dec->target->height))
+      D3D9UmdLog("DecodeEndFrame: the picture's planes aren't readable");
+   Finish(dev->decode->pipe);
+   dec->target = NULL;
+   return S_OK;
+}
+
+void
+D3D9UmdFillDecodeFuncs(D3DDDI_DEVICEFUNCS *f)
+{
+   f->pfnCreateDecodeDevice = CreateDecodeDevice;
+   f->pfnDestroyDecodeDevice = DestroyDecodeDevice;
+   f->pfnSetDecodeRenderTarget = SetDecodeRenderTarget;
+   f->pfnDecodeBeginFrame = DecodeBeginFrame;
+   f->pfnDecodeExecute = DecodeExecute;
+   f->pfnDecodeEndFrame = DecodeEndFrame;
+}
