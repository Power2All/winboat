+
+struct gdikmt_device *
+gdikmt_create_from_hdc(HDC hDC)
+{
+   struct gdikmt_device_d3dkmt *device = CALLOC_STRUCT(gdikmt_device_d3dkmt);
+   if (!device)
+      return NULL;
+
+   device->gdi32lib = LoadLibraryA("GDI32.dll");
+   gdikmt_load_callbacks(device->gdi32lib, &device->cb);
+
+   D3DKMT_OPENADAPTERFROMHDC openFromHdc;
+   NTSTATUS Status;
+   openFromHdc.hDc = hDC;
+   Status = device->cb.openAdapterFromHdc(&openFromHdc);
+   if (!NT_SUCCESS(Status)) {
+      _debug_printf(
+         "Failed to open device(D3DKMTOpenAdapterFromHdc) with status code: %lx\n",
+         Status);
+      FreeLibrary(device->gdi32lib);
+      FREE(device);
+      return NULL;
+   }
+   return gdikmt_create_on_adapter(device, openFromHdc.hAdapter);
+};
+
+struct gdikmt_device *
+gdikmt_create_from_luid(LUID luid)
+{
+   struct gdikmt_device_d3dkmt *device = CALLOC_STRUCT(gdikmt_device_d3dkmt);
+   if (!device)
+      return NULL;
+
+   device->gdi32lib = LoadLibraryA("GDI32.dll");
+   gdikmt_load_callbacks(device->gdi32lib, &device->cb);
+
+   D3DKMT_OPENADAPTERFROMLUID openFromLuid;
+   memset(&openFromLuid, 0, sizeof(openFromLuid));
+   openFromLuid.AdapterLuid = luid;
+   NTSTATUS Status = device->cb.openAdapterFromLuid ? device->cb.openAdapterFromLuid(&openFromLuid)
+                                                     : (NTSTATUS)0xC00000BBL /* STATUS_NOT_SUPPORTED */;
+   if (!NT_SUCCESS(Status)) {
+      _debug_printf(
+         "Failed to open device(D3DKMTOpenAdapterFromLuid) with status code: %lx\n",
+         Status);
+      FreeLibrary(device->gdi32lib);
+      FREE(device);
+      return NULL;
+   }
+   return gdikmt_create_on_adapter(device, openFromLuid.hAdapter);
+}
diff --git a/src/gallium/frontends/d3d9umd/adapter.cpp b/src/gallium/frontends/d3d9umd/adapter.cpp
new file mode 100644
index 0000000..186b2ff
--- /dev/null
+++ b/src/gallium/frontends/d3d9umd/adapter.cpp
@@ -0,0 +1,274 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* OpenAdapter, GetCaps, CreateDevice and CloseAdapter */
+
+#include "d3d9umd.h"
+
+#include <new>
+#include <string.h>
+#include <vector>
+
+#include "pipe/p_screen.h"
+#include "util/u_memory.h"
+#include "virgl/gdi/virgl_gdi_public.h"
+#include "virtio/wddm/viogpu_wddm_driver.h"
+
+/* ---- Probing the GPU ---- */
+
+/* The runtime asks for caps before creating any device, and a gallium screen needs a kernel device. The adapter's
+ * callbacks can't create one, so open the virtio-gpu adapter through D3DKMT ourselves: find it by asking every
+ * adapter for its driver's private data (in an RDP session the desktop belongs to a different, remote adapter). */
+static bool
+FindVioGpuAdapter(LUID *luid)
+{
+   HMODULE gdi32 = GetModuleHandleA("gdi32.dll");
+   auto enumAdapters2 = (PFND3DKMT_ENUMADAPTERS2)GetProcAddress(gdi32, "D3DKMTEnumAdapters2");
+   auto queryAdapterInfo = (PFND3DKMT_QUERYADAPTERINFO)GetProcAddress(gdi32, "D3DKMTQueryAdapterInfo");
+   auto closeAdapter = (PFND3DKMT_CLOSEADAPTER)GetProcAddress(gdi32, "D3DKMTCloseAdapter");
+   if (!enumAdapters2 || !queryAdapterInfo || !closeAdapter)
+      return false;
+
+   D3DKMT_ENUMADAPTERS2 enumerate;
+   memset(&enumerate, 0, sizeof(enumerate));
+   if (!NT_SUCCESS(enumAdapters2(&enumerate)) || !enumerate.NumAdapters)
+      return false;
+   std::vector<D3DKMT_ADAPTERINFO> adapters(enumerate.NumAdapters);
+   enumerate.pAdapters = adapters.data();
+   if (!NT_SUCCESS(enumAdapters2(&enumerate)))
+      return false;
+
+   bool found = false;
+   for (UINT i = 0; i < enumerate.NumAdapters; i++) {
+      VIOGPU_ADAPTERINFO info;
+      memset(&info, 0, sizeof(info));
+      D3DKMT_QUERYADAPTERINFO query;
+      memset(&query, 0, sizeof(query));
+      query.hAdapter = adapters[i].hAdapter;
+      query.Type = KMTQAITYPE_UMDRIVERPRIVATE;
+      query.pPrivateDriverData = &info;
+      query.PrivateDriverDataSize = sizeof(info);
+      if (!found && NT_SUCCESS(queryAdapterInfo(&query)) && info.IamVioGPU == VIOGPU_IAM) {
+         *luid = adapters[i].AdapterLuid;
+         found = true;
+      }
+      D3DKMT_CLOSEADAPTER close;
+      close.hAdapter = adapters[i].hAdapter;
+      closeAdapter(&close);
+   }
+   return found;
+}
+
+/* Formats the runtime may ask about; the operations are worked out with nine's CheckDeviceFormat */
+static const D3DDDIFORMAT candidateFormats[] = {
+   D3DDDIFMT_X8R8G8B8, D3DDDIFMT_A8R8G8B8, D3DDDIFMT_R5G6B5, D3DDDIFMT_X1R5G5B5, D3DDDIFMT_A1R5G5B5,
+   D3DDDIFMT_A4R4G4B4, D3DDDIFMT_X4R4G4B4, D3DDDIFMT_A2R10G10B10, D3DDDIFMT_A2B10G10R10, D3DDDIFMT_A8B8G8R8,
+   D3DDDIFMT_X8B8G8R8, D3DDDIFMT_R8G8B8, D3DDDIFMT_R3G3B2, D3DDDIFMT_A8R3G3B2, D3DDDIFMT_A8, D3DDDIFMT_L8,
+   D3DDDIFMT_A8L8, D3DDDIFMT_A4L4, D3DDDIFMT_L16, D3DDDIFMT_V8U8, D3DDDIFMT_L6V5U5, D3DDDIFMT_X8L8V8U8,
+   D3DDDIFMT_Q8W8V8U8, D3DDDIFMT_V16U16, D3DDDIFMT_A2W10V10U10, D3DDDIFMT_Q16W16V16U16, D3DDDIFMT_G16R16,
+   D3DDDIFMT_A16B16G16R16, D3DDDIFMT_R16F, D3DDDIFMT_G16R16F, D3DDDIFMT_A16B16G16R16F, D3DDDIFMT_R32F,
+   D3DDDIFMT_G32R32F, D3DDDIFMT_A32B32G32R32F, D3DDDIFMT_DXT1, D3DDDIFMT_DXT2, D3DDDIFMT_DXT3, D3DDDIFMT_DXT4,
+   D3DDDIFMT_DXT5, D3DDDIFMT_UYVY, D3DDDIFMT_YUY2, D3DDDIFMT_R8G8_B8G8, D3DDDIFMT_G8R8_G8B8,
+   (D3DDDIFORMAT)MAKEFOURCC('A', 'T', 'I', '1'), (D3DDDIFORMAT)MAKEFOURCC('A', 'T', 'I', '2'),
+   (D3DDDIFORMAT)MAKEFOURCC('I', 'N', 'T', 'Z'), (D3DDDIFORMAT)MAKEFOURCC('N', 'U', 'L', 'L'),
+   (D3DDDIFORMAT)MAKEFOURCC('D', 'F', '1', '6'), (D3DDDIFORMAT)MAKEFOURCC('D', 'F', '2', '4'),
+   D3DDDIFMT_D16, D3DDDIFMT_D16_LOCKABLE, D3DDDIFMT_D24S8, D3DDDIFMT_D24X8, D3DDDIFMT_D24X4S4,
+   D3DDDIFMT_D15S1, D3DDDIFMT_D32, D3DDDIFMT_D32F_LOCKABLE, D3DDDIFMT_D24FS8, D3DDDIFMT_S8_LOCKABLE,
+   D3DDDIFMT_D32_LOCKABLE,
+};
+
+static bool
+IsArgbGroup(D3DDDIFORMAT f)
+{
+   return f == D3DDDIFMT_X8R8G8B8 || f == D3DDDIFMT_A8R8G8B8 || f == D3DDDIFMT_A2R10G10B10 ||
+          f == D3DDDIFMT_X1R5G5B5 || f == D3DDDIFMT_A1R5G5B5 || f == D3DDDIFMT_R5G6B5;
+}
+
+static void
+BuildFormatList(D3D9UmdAdapter *adapter)
+{
+   const UINT display = D3DDDIFMT_X8R8G8B8;
+   std::vector<FORMATOP> list;
+   for (D3DDDIFORMAT f : candidateFormats) {
+      FORMATOP op;
+      memset(&op, 0, sizeof(op));
+      op.Format = f;
+      auto check = [&](DWORD usage, D3DRESOURCETYPE rtype) {
+         return nddi_adapter_check_format(adapter->nine, display, usage, rtype, f);
+      };
+      if (check(0, D3DRTYPE_TEXTURE))
+         op.Operations |= FORMATOP_TEXTURE;
+      if (check(0, D3DRTYPE_VOLUMETEXTURE))
+         op.Operations |= FORMATOP_VOLUMETEXTURE;
+      if (check(0, D3DRTYPE_CUBETEXTURE))
+         op.Operations |= FORMATOP_CUBETEXTURE;
+      if (check(0, D3DRTYPE_SURFACE))
+         op.Operations |= FORMATOP_OFFSCREENPLAIN;
+      bool rt = check(D3DUSAGE_RENDERTARGET, D3DRTYPE_SURFACE);
+      if (rt) {
+         op.Operations |= FORMATOP_OFFSCREEN_RENDERTARGET;
+         if (IsArgbGroup(f))
+            op.Operations |= FORMATOP_SAME_FORMAT_RENDERTARGET | FORMATOP_SAME_FORMAT_UP_TO_ALPHA_RENDERTARGET |
+                             FORMATOP_CONVERT_TO_ARGB;
+         if (!check(D3DUSAGE_QUERY_POSTPIXELSHADER_BLENDING, D3DRTYPE_SURFACE))
+            op.Operations |= FORMATOP_NOALPHABLEND;
+      }
+      if (check(D3DUSAGE_DEPTHSTENCIL, D3DRTYPE_SURFACE))
+         op.Operations |= FORMATOP_ZSTENCIL | FORMATOP_ZSTENCIL_WITH_ARBITRARY_COLOR_DEPTH;
+      if (IsArgbGroup(f) && (op.Operations & FORMATOP_TEXTURE))
+         op.Operations |= FORMATOP_MEMBEROFGROUP_ARGB;
+      if (f == D3DDDIFMT_X8R8G8B8 && rt)
+         op.Operations |= FORMATOP_DISPLAYMODE | FORMATOP_3DACCELERATION;
+      if (op.Operations & FORMATOP_TEXTURE) {
+         if (check(D3DUSAGE_QUERY_SRGBREAD, D3DRTYPE_TEXTURE))
+            op.Operations |= FORMATOP_SRGBREAD;
+         if (check(D3DUSAGE_AUTOGENMIPMAP, D3DRTYPE_TEXTURE))
+            op.Operations |= FORMATOP_AUTOGENMIPMAP;
+         if (check(D3DUSAGE_QUERY_VERTEXTEXTURE, D3DRTYPE_TEXTURE))
+            op.Operations |= FORMATOP_VERTEXTEXTURE;
+         if (check(D3DUSAGE_QUERY_LEGACYBUMPMAP, D3DRTYPE_TEXTURE))
+            op.Operations |= FORMATOP_BUMPMAP;
+         if (!check(D3DUSAGE_QUERY_FILTER, D3DRTYPE_TEXTURE))
+            op.Operations |= FORMATOP_NOFILTER;
+      }
+      if (rt && check(D3DUSAGE_QUERY_SRGBWRITE, D3DRTYPE_TEXTURE))
+         op.Operations |= FORMATOP_SRGBWRITE;
+      if (op.Operations & (FORMATOP_OFFSCREEN_RENDERTARGET | FORMATOP_ZSTENCIL)) {
+         for (UINT samples = 2; samples <= 16; samples++) {
+            uint32_t levels = 0;
+            if (nddi_adapter_check_multisample(adapter->nine, f, samples, &levels))
+               op.BltMsTypes |= 1u << (samples - 1);
+         }
+         /* Multisampling includes D3DMULTISAMPLE_NONMASKABLE (bit 0): the runtime's HAL check requires it */
+         if (op.BltMsTypes)
+            op.BltMsTypes |= 1u << (D3DDDIMULTISAMPLE_NONMASKABLE - 1);
+      }
+      if (op.Operations) {
+         list.push_back(op);
+         D3D9UMD_TRACE("  format %u: operations 0x%08x, multisample 0x%x", f, op.Operations, op.BltMsTypes);
+      }
+   }
+   adapter->formatCount = (UINT)list.size();
+   adapter->formats = (FORMATOP *)MALLOC(sizeof(FORMATOP) * list.size());
+   if (adapter->formats)
+      memcpy(adapter->formats, list.data(), sizeof(FORMATOP) * list.size());
+   else
+      adapter->formatCount = 0;
+}
+
+static bool
+ProbeAdapter(D3D9UmdAdapter *adapter)
+{
+   LUID luid;
+   if (!FindVioGpuAdapter(&luid)) {
+      D3D9UmdLog("no virtio-gpu adapter found");
+      return false;
+   }
+   adapter->probeKmt = gdikmt_create_from_luid(luid);
+   if (!adapter->probeKmt)
+      return false;
+   /* The screen's winsys owns the gdikmt device from here on */
+   adapter->probeScreen = virgl_gdi_screen_create(adapter->probeKmt);
+   if (!adapter->probeScreen) {
+      D3D9UmdLog("creating the virgl screen failed");
+      return false;
+   }
+   adapter->nine = nddi_adapter_create(adapter->probeScreen);
+   if (!adapter->nine || !nddi_adapter_get_caps(adapter->nine, &adapter->caps, sizeof(adapter->caps)))
+      return false;
+   /* A DDI-only cap that nine (an API implementation) doesn't know: vertices may carry a separate fog value (nine
+    * takes D3DDECLUSAGE_FOG). The runtime requires it of shader model 2+ drivers, or it reports no HAL where the
+    * adapter drives the display. */
+   adapter->caps.PrimitiveMiscCaps |= D3DPMISCCAPS_FOGINFVF;
+   BuildFormatList(adapter);
+   D3D9UMD_TRACE("probed %s: VS %lx PS %lx, %u formats", adapter->probeScreen->get_name(adapter->probeScreen),
+                 adapter->caps.VertexShaderVersion, adapter->caps.PixelShaderVersion, adapter->formatCount);
+   return true;
+}
+
+static void
+FreeAdapter(D3D9UmdAdapter *adapter)
+{
+   nddi_adapter_destroy(adapter->nine);
+   if (adapter->probeScreen)
+      adapter->probeScreen->destroy(adapter->probeScreen);
+   FREE(adapter->formats);
+   delete adapter;
+}
+
+/* ---- Adapter functions ---- */
+
+static HRESULT APIENTRY
+CreateDevice(HANDLE hAdapter, D3DDDIARG_CREATEDEVICE *pCreateData)
+{
+   D3D9UmdAdapter *adapter = (D3D9UmdAdapter *)hAdapter;
+   D3D9UMD_TRACE("CreateDevice interface %u version %u", pCreateData->Interface, pCreateData->Version);
+
+   D3D9UmdDevice *device = new (std::nothrow) D3D9UmdDevice();
+   if (!device)
+      return E_OUTOFMEMORY;
+   device->hRTDevice = pCreateData->hDevice;
+   device->adapter = adapter;
+
+   device->kmt.hRTAdapter = adapter->hRTAdapter;
+   device->kmt.hRTDevice = pCreateData->hDevice;
+   device->kmt.callbacks = *pCreateData->pCallbacks;
+   device->kmt.adapterCallbacks = &adapter->callbacks;
+   gdikmt_d3d9_init(&device->kmt);
+
+   D3D9UMD_TRACE("CreateDevice: creating the virgl screen");
+   device->screen = virgl_gdi_screen_create(&device->kmt.base);
+   if (!device->screen) {
+      D3D9UmdLog("CreateDevice: creating the virgl screen failed");
+      delete device;
+      return E_FAIL;
+   }
+   D3D9UMD_TRACE("CreateDevice: creating the nine device");
+   device->nine = nddi_device_create(adapter->nine, device->screen);
+   if (!device->nine) {
+      device->screen->destroy(device->screen);
+      delete device;
+      return E_FAIL;
+   }
+   device->viewport.max_z = 1.0f;
+
+   D3D9UmdFillStubs(pCreateData->pDeviceFuncs);
+   D3D9UmdFillDeviceFuncs(pCreateData->pDeviceFuncs);
+   pCreateData->hDevice = device;
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+CloseAdapter(HANDLE hAdapter)
+{
+   FreeAdapter((D3D9UmdAdapter *)hAdapter);
+   return S_OK;
+}
+
+/* Exported through d3d9.def (undecorated on x86 as well) */
+extern "C" HRESULT APIENTRY
+OpenAdapter(D3DDDIARG_OPENADAPTER *pOpenData)
+{
+   D3D9UmdInstallCrashHandler();
+   D3D9UMD_TRACE("OpenAdapter interface %u version %u", pOpenData->Interface, pOpenData->Version);
+
+   D3D9UmdAdapter *adapter = new (std::nothrow) D3D9UmdAdapter();
+   if (!adapter)
+      return E_OUTOFMEMORY;
+   adapter->hRTAdapter = pOpenData->hAdapter;
+   adapter->callbacks = *pOpenData->pAdapterCallbacks;
+   if (!ProbeAdapter(adapter)) {
+      D3D9UmdLog("OpenAdapter: the GPU can't run Direct3D 9");
+      FreeAdapter(adapter);
+      return E_FAIL;
+   }
+
+   pOpenData->hAdapter = adapter;
+   pOpenData->pAdapterFuncs->pfnGetCaps = D3D9UmdGetCaps;
+   pOpenData->pAdapterFuncs->pfnCreateDevice = CreateDevice;
+   pOpenData->pAdapterFuncs->pfnCloseAdapter = CloseAdapter;
+   pOpenData->DriverVersion = D3D_UMD_INTERFACE_VERSION_WIN7;
+   return S_OK;
+}
diff --git a/src/gallium/frontends/d3d9umd/caps.cpp b/src/gallium/frontends/d3d9umd/caps.cpp
new file mode 100644
index 0000000..7b79d92
--- /dev/null
+++ b/src/gallium/frontends/d3d9umd/caps.cpp
@@ -0,0 +1,197 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* GetCaps: what the D3D9 runtime asks the driver about the GPU. D3DCAPS9 and the format list come from gallium nine
+ * (probed in adapter.cpp); the older DirectDraw/D3D3/D3D7/D3D8 caps structures are derived from D3DCAPS9. */
+
+#include "d3d9umd.h"
+
+#include <string.h>
+
+static const char *
+CapsTypeName(D3DDDICAPS_TYPE type)
+{
+   switch (type) {
+   case D3DDDICAPS_DDRAW: return "DDRAW";
+   case D3DDDICAPS_DDRAW_MODE_SPECIFIC: return "DDRAW_MODE_SPECIFIC";
+   case D3DDDICAPS_GETFORMATCOUNT: return "GETFORMATCOUNT";
+   case D3DDDICAPS_GETFORMATDATA: return "GETFORMATDATA";
+   case D3DDDICAPS_GETMULTISAMPLEQUALITYLEVELS: return "GETMULTISAMPLEQUALITYLEVELS";
+   case D3DDDICAPS_GETD3DQUERYCOUNT: return "GETD3DQUERYCOUNT";
+   case D3DDDICAPS_GETD3DQUERYDATA: return "GETD3DQUERYDATA";
+   case D3DDDICAPS_GETD3D3CAPS: return "GETD3D3CAPS";
+   case D3DDDICAPS_GETD3D5CAPS: return "GETD3D5CAPS";
+   case D3DDDICAPS_GETD3D6CAPS: return "GETD3D6CAPS";
+   case D3DDDICAPS_GETD3D7CAPS: return "GETD3D7CAPS";
+   case D3DDDICAPS_GETD3D8CAPS: return "GETD3D8CAPS";
+   case D3DDDICAPS_GETD3D9CAPS: return "GETD3D9CAPS";
+   default: return "other";
+   }
+}
+
+static void
+FillPrimCaps(D3DPRIMCAPS *p, const D3DCAPS9 &c)
+{
+   memset(p, 0, sizeof(*p));
+   p->dwSize = sizeof(*p);
+   p->dwMiscCaps = c.PrimitiveMiscCaps;
+   p->dwRasterCaps = c.RasterCaps;
+   p->dwZCmpCaps = c.ZCmpCaps;
+   p->dwSrcBlendCaps = c.SrcBlendCaps;
+   p->dwDestBlendCaps = c.DestBlendCaps;
+   p->dwAlphaCmpCaps = c.AlphaCmpCaps;
+   p->dwShadeCaps = c.ShadeCaps;
+   p->dwTextureCaps = c.TextureCaps;
+   p->dwTextureFilterCaps = c.TextureFilterCaps;
+   p->dwTextureBlendCaps = D3DPTBLENDCAPS_ADD | D3DPTBLENDCAPS_MODULATE | D3DPTBLENDCAPS_MODULATEALPHA |
+                           D3DPTBLENDCAPS_DECAL | D3DPTBLENDCAPS_DECALALPHA | D3DPTBLENDCAPS_COPY;
+   p->dwTextureAddressCaps = c.TextureAddressCaps;
+}
+
+static void
+FillD3D3Caps(D3DHAL_GLOBALDRIVERDATA *g, const D3DCAPS9 &c)
+{
+   memset(g, 0, sizeof(*g));
+   g->dwSize = sizeof(*g);
+   D3DDEVICEDESC_V1 *d = &g->hwCaps;
+   d->dwSize = sizeof(*d);
+   d->dwFlags = D3DDD_COLORMODEL | D3DDD_DEVCAPS | D3DDD_TRANSFORMCAPS | D3DDD_LIGHTINGCAPS | D3DDD_BCLIPPING |
+                D3DDD_LINECAPS | D3DDD_TRICAPS | D3DDD_DEVICERENDERBITDEPTH | D3DDD_DEVICEZBUFFERBITDEPTH;
+   d->dcmColorModel = D3DCOLOR_RGB;
+   d->dwDevCaps = c.DevCaps;
+   d->dtcTransformCaps.dwSize = sizeof(d->dtcTransformCaps);
+   d->dtcTransformCaps.dwCaps = D3DTRANSFORMCAPS_CLIP;
+   d->bClipping = TRUE;
+   d->dlcLightingCaps.dwSize = sizeof(d->dlcLightingCaps);
+   d->dlcLightingCaps.dwCaps = D3DLIGHTCAPS_POINT | D3DLIGHTCAPS_SPOT | D3DLIGHTCAPS_DIRECTIONAL;
+   d->dlcLightingCaps.dwLightingModel = D3DLIGHTINGMODEL_RGB;
+   d->dlcLightingCaps.dwNumLights = c.MaxActiveLights;
+   FillPrimCaps(&d->dpcLineCaps, c);
+   FillPrimCaps(&d->dpcTriCaps, c);
+   d->dwDeviceRenderBitDepth = DDBD_16 | DDBD_24 | DDBD_32;
+   d->dwDeviceZBufferBitDepth = DDBD_16 | DDBD_24 | DDBD_32;
+}
+
+static void
+FillD3D7Caps(D3DHAL_D3DEXTENDEDCAPS *e, const D3DCAPS9 &c)
+{
+   memset(e, 0, sizeof(*e));
+   e->dwSize = sizeof(*e);
+   e->dwMinTextureWidth = 1;
+   e->dwMaxTextureWidth = c.MaxTextureWidth;
+   e->dwMinTextureHeight = 1;
+   e->dwMaxTextureHeight = c.MaxTextureHeight;
+   e->dwMaxTextureRepeat = c.MaxTextureRepeat;
+   e->dwMaxTextureAspectRatio = c.MaxTextureAspectRatio;
+   e->dwMaxAnisotropy = c.MaxAnisotropy;
+   e->dvGuardBandLeft = c.GuardBandLeft;
+   e->dvGuardBandTop = c.GuardBandTop;
+   e->dvGuardBandRight = c.GuardBandRight;
+   e->dvGuardBandBottom = c.GuardBandBottom;
+   e->dvExtentsAdjust = c.ExtentsAdjust;
+   e->dwStencilCaps = c.StencilCaps;
+   e->dwFVFCaps = c.FVFCaps;
+   e->dwTextureOpCaps = c.TextureOpCaps;
+   e->wMaxTextureBlendStages = (WORD)c.MaxTextureBlendStages;
+   e->wMaxSimultaneousTextures = (WORD)c.MaxSimultaneousTextures;
+   e->dwMaxActiveLights = c.MaxActiveLights;
+   e->dvMaxVertexW = c.MaxVertexW;
+   e->wMaxUserClipPlanes = (WORD)c.MaxUserClipPlanes;
+   e->wMaxVertexBlendMatrices = (WORD)c.MaxVertexBlendMatrices;
+   e->dwVertexProcessingCaps = c.VertexProcessingCaps;
+}
+
+/* Writes a value of type T into the caller's buffer if it's big enough */
+template <typename T>
+static HRESULT
+Put(const D3DDDIARG_GETCAPS *p, const T &value)
+{
+   if (!p->pData || p->DataSize < sizeof(T))
+      return E_INVALIDARG;
+   memcpy(p->pData, &value, sizeof(T));
+   return S_OK;
+}
+
+HRESULT APIENTRY
+D3D9UmdGetCaps(HANDLE hAdapter, const D3DDDIARG_GETCAPS *p)
+{
+   D3D9UmdAdapter *adapter = (D3D9UmdAdapter *)hAdapter;
+   const D3DCAPS9 &c = adapter->caps;
+   D3D9UMD_TRACE("GetCaps %s (%d), %u bytes", CapsTypeName(p->Type), (int)p->Type, p->DataSize);
+
+   switch (p->Type) {
+   case D3DDDICAPS_DDRAW: {
+      DDRAW_CAPS caps;
+      memset(&caps, 0, sizeof(caps));
+      caps.Caps = DDRAW_CAPS_BLTDEPTHFILL;
+      caps.Caps2 = DDRAW_CAPS2_FLIPNOVSYNC | DDRAW_CAPS2_DYNAMICTEXTURES;
+      return Put(p, caps);
+   }
+   case D3DDDICAPS_DDRAW_MODE_SPECIFIC: {
+      DDRAW_MODE_SPECIFIC_CAPS caps;
+      memset(&caps, 0, sizeof(caps));
+      if (p->pInfo)
+         caps.Head = *(const UINT *)p->pInfo;
+      return Put(p, caps);
+   }
+   case D3DDDICAPS_GETFORMATCOUNT:
+      return Put(p, adapter->formatCount);
+   case D3DDDICAPS_GETFORMATDATA: {
+      UINT bytes = adapter->formatCount * sizeof(FORMATOP);
+      if (!p->pData || p->DataSize < bytes)
+         return E_INVALIDARG;
+      memcpy(p->pData, adapter->formats, bytes);
+      return S_OK;
+   }
+   case D3DDDICAPS_GETMULTISAMPLEQUALITYLEVELS: {
+      DDIMULTISAMPLEQUALITYLEVELSDATA *ms = (DDIMULTISAMPLEQUALITYLEVELSDATA *)p->pData;
+      if (!ms || p->DataSize < sizeof(*ms))
+         return E_INVALIDARG;
+      uint32_t levels = 0;
+      if (ms->MsType == D3DDDIMULTISAMPLE_NONE)
+         levels = 1;
+      else if (!nddi_adapter_check_multisample(adapter->nine, ms->Format, ms->MsType, &levels))
+         levels = 0;
+      ms->QualityLevels = levels;
+      return S_OK;
+   }
+   case D3DDDICAPS_GETD3DQUERYCOUNT:
+      return Put(p, (UINT)2);
+   case D3DDDICAPS_GETD3DQUERYDATA: {
+      const D3DDDIQUERYTYPE queries[] = {D3DDDIQUERYTYPE_EVENT, D3DDDIQUERYTYPE_OCCLUSION};
+      if (!p->pData || p->DataSize < sizeof(queries))
+         return E_INVALIDARG;
+      memcpy(p->pData, queries, sizeof(queries));
+      return S_OK;
+   }
+   case D3DDDICAPS_GETD3D3CAPS: {
+      D3DHAL_GLOBALDRIVERDATA data;
+      FillD3D3Caps(&data, c);
+      return Put(p, data);
+   }
+   case D3DDDICAPS_GETD3D7CAPS: {
+      D3DHAL_D3DEXTENDEDCAPS data;
+      FillD3D7Caps(&data, c);
+      return Put(p, data);
+   }
+   case D3DDDICAPS_GETD3D8CAPS: {
+      /* D3DCAPS8 is the start of D3DCAPS9 */
+      if (!p->pData || p->DataSize < sizeof(D3DCAPS8))
+         return E_INVALIDARG;
+      memcpy(p->pData, &c, sizeof(D3DCAPS8));
+      return S_OK;
+   }
+   case D3DDDICAPS_GETD3D9CAPS:
+      return Put(p, c);
+   case D3DDDICAPS_GETD3D5CAPS:
+   case D3DDDICAPS_GETD3D6CAPS:
+   default:
+      /* Video decode/processing, overlays, content protection, ...: nothing to report. Counts are zero. */
+      if (p->pData && p->DataSize)
+         memset(p->pData, 0, p->DataSize);
+      D3D9UMD_TRACE("GetCaps: nothing for type %d", (int)p->Type);
+      return S_OK;
+   }
+}
diff --git a/src/gallium/frontends/d3d9umd/d3d9umd.h b/src/gallium/frontends/d3d9umd/d3d9umd.h
new file mode 100644
index 0000000..5dfc146
--- /dev/null
+++ b/src/gallium/frontends/d3d9umd/d3d9umd.h
@@ -0,0 +1,90 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * d3d9umd: a Direct3D 9 WDDM user-mode driver (the D3D9 DDI: OpenAdapter + D3DDDI_DEVICEFUNCS) on top of gallium.
+ * This is the DDI side; the D3D9 work is done by the gallium nine state tracker behind d3d9umd_bridge.h.
+ */
+
+#ifndef D3D9UMD_H
+#define D3D9UMD_H
+
+#include <windows.h>
+#include "winddk_compat.h"
+
+#include <d3d9.h>
+#include <d3dumddi.h>
+#include <d3dhal.h>
+
+#include "d3d9umd_bridge.h"
+#include "gdikmt_d3d9.h"
+
+struct pipe_screen;
+
+struct D3D9UmdAdapter {
+   HANDLE hRTAdapter;
+   D3DDDI_ADAPTERCALLBACKS callbacks;
+
+   /* What the GPU supports, from a gallium screen on a D3DKMT device of our own (the runtime asks before any
+    * device exists) */
+   struct gdikmt_device *probeKmt;
+   struct pipe_screen *probeScreen;
+   struct nddi_adapter *nine;
+   D3DCAPS9 caps;
+   FORMATOP *formats;
+   UINT formatCount;
+};
+
+struct D3D9UmdResource {
+   HANDLE hRTResource;
+   D3DDDIFORMAT format;
+   D3DDDI_POOL pool;
+   D3DDDI_RESOURCEFLAGS flags;
+   UINT surfCount;
+   UINT width, height;      /* of subresource 0 */
+   struct nddi_resource *nine;
+};
+
+
+struct D3D9UmdDevice {
+   HANDLE hRTDevice;
+   D3D9UmdAdapter *adapter;
+   struct gdikmt_device_d3d9 kmt;
+   struct pipe_screen *screen;
+   struct nddi_device *nine;
+
+   bool inScene;
+   struct nddi_viewport viewport;   /* the DDI sets position/size and the z range separately */
+   D3D9UmdResource *renderTarget0;
+
+   /* For the DrawPrimitive2/DrawIndexedPrimitive2 variants, which give byte offsets into stream 0 and indices */
+   UINT streamStride[16];
+   D3D9UmdResource *indexBuffer;    /* or user memory indices: */
+   const void *memoryIndices;
+   UINT memoryIndexSize;
+};
+
+static inline D3D9UmdDevice *D3D9UmdCastDevice(HANDLE h) { return (D3D9UmdDevice *)h; }
+static inline D3D9UmdResource *D3D9UmdCastResource(HANDLE h) { return (D3D9UmdResource *)h; }
+
+/* Logging through OutputDebugString (also to a file when C:\viogpu_d3d9_trace.txt exists, see debug.cpp) */
+void D3D9UmdLog(const char *format, ...);
+bool D3D9UmdTracing(void);
+void D3D9UmdTraceLog(const char *format, ...);
+#define D3D9UMD_TRACE(...) do { if (D3D9UmdTracing()) D3D9UmdTraceLog(__VA_ARGS__); } while (0)
+
+/* For DDI entry points that aren't implemented yet: logs the first call of each and returns S_OK */
+HRESULT D3D9UmdUnimplemented(const char *name);
+
+/* When tracing: logs crashes (exception, module+offset, stack) before the process dies */
+void D3D9UmdInstallCrashHandler(void);
+
+void D3D9UmdFillStubs(D3DDDI_DEVICEFUNCS *funcs);
+void D3D9UmdFillDeviceFuncs(D3DDDI_DEVICEFUNCS *funcs);
+void D3D9UmdFillPipelineFuncs(D3DDDI_DEVICEFUNCS *funcs);
+
+HRESULT APIENTRY D3D9UmdGetCaps(HANDLE hAdapter, const D3DDDIARG_GETCAPS *pData);
+
+#endif /* D3D9UMD_H */
diff --git a/src/gallium/frontends/d3d9umd/d3d9umd_bridge.h b/src/gallium/frontends/d3d9umd/d3d9umd_bridge.h
new file mode 100644
index 0000000..3800349
--- /dev/null
+++ b/src/gallium/frontends/d3d9umd/d3d9umd_bridge.h
@@ -0,0 +1,199 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The boundary between the two halves of d3d9umd:
+ *
+ * - the DDI side (adapter.cpp, device.cpp, ...) implements the D3D9 user-mode driver interface with the Windows
+ *   WDK headers (d3dumddi.h, which pulls in the SDK's d3d9types.h);
+ * - the nine side (nine_bridge.c) drives the gallium nine state tracker, which has its own D3D9 headers
+ *   (include/D3D9).
+ *
+ * The two sets of headers can't be included together, so only plain C types cross this boundary. D3D9 enums
+ * (formats, render states, primitive types, D3DUSAGE, D3DLOCK, D3DCLEAR, ...) have the same values in the DDI and
+ * the API, and travel as uint32_t; HRESULTs as int32_t.
+ */
+
+#ifndef D3D9UMD_BRIDGE_H
+#define D3D9UMD_BRIDGE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct pipe_screen;
+struct pipe_resource;
+
+struct nddi_adapter;
+struct nddi_device;
+struct nddi_resource;
+
+struct nddi_rect {
+   int32_t left, top, right, bottom;
+};
+
+struct nddi_box {
+   uint32_t left, top, right, bottom, front, back;
+};
+
+struct nddi_viewport {
+   uint32_t x, y, width, height;
+   float min_z, max_z;
+};
+
+/* ---- Adapter: what a pipe_screen supports ---- */
+
+struct nddi_adapter *nddi_adapter_create(struct pipe_screen *screen);
+void nddi_adapter_destroy(struct nddi_adapter *adapter);
+
+/* Fills a D3DCAPS9 (both header sets have the same layout; size is checked) */
+bool nddi_adapter_get_caps(struct nddi_adapter *adapter, void *d3dcaps9, unsigned size);
+
+/* IDirect3D9::CheckDeviceFormat for a HAL device; usage is D3DUSAGE_*, rtype D3DRTYPE_* */
+bool nddi_adapter_check_format(struct nddi_adapter *adapter, uint32_t adapter_format, uint32_t usage,
+                               uint32_t rtype, uint32_t format);
+
+/* IDirect3D9::CheckDeviceMultiSampleType; returns false if unsupported */
+bool nddi_adapter_check_multisample(struct nddi_adapter *adapter, uint32_t format, uint32_t samples,
+                                    uint32_t *quality_levels);
+
+/* ---- Device ---- */
+
+struct nddi_device *nddi_device_create(struct nddi_adapter *adapter, struct pipe_screen *screen);
+void nddi_device_destroy(struct nddi_device *dev);
+
+enum nddi_resource_kind {
+   NDDI_SURFACE,           /* offscreen plain surface */
+   NDDI_RENDER_TARGET,
+   NDDI_DEPTH_STENCIL,
+   NDDI_TEXTURE,
+   NDDI_CUBE_TEXTURE,
+   NDDI_VOLUME_TEXTURE,
+   NDDI_VERTEX_BUFFER,
+   NDDI_INDEX_BUFFER,
+};
+
+struct nddi_resource_desc {
+   enum nddi_resource_kind kind;
+   uint32_t format;         /* D3DFORMAT */
+   uint32_t width;          /* bytes for buffers */
+   uint32_t height;
+   uint32_t depth;
+   uint32_t levels;
+   uint32_t usage;          /* D3DUSAGE_* */
+   uint32_t multisample;    /* D3DMULTISAMPLE_TYPE */
+   uint32_t multisample_quality;
+   bool lockable;
+   uint32_t fvf;
+   /* System memory resources: one runtime-owned buffer per subresource (levels, or levels * 6 for cubes) */
+   bool system_memory;
+   void *const *sysmem;
+   const uint32_t *sysmem_pitch;
+};
+
+int32_t nddi_resource_create(struct nddi_device *dev, const struct nddi_resource_desc *desc,
+                             struct nddi_resource **out);
+void nddi_resource_destroy(struct nddi_resource *res);
+
+/* The pipe_resource behind a subresource (for presentation), and its mip level / array layer */
+struct pipe_resource *nddi_resource_get_pipe(struct nddi_resource *res, unsigned subresource, unsigned *level,
+                                             unsigned *layer);
+
+/* CPU access; box is NULL for the whole subresource. flags are D3DLOCK_* */
+int32_t nddi_resource_lock(struct nddi_resource *res, unsigned subresource, const struct nddi_box *box,
+                           uint32_t flags, void **data, uint32_t *pitch, uint32_t *slice_pitch);
+int32_t nddi_resource_unlock(struct nddi_resource *res, unsigned subresource);
+/* The runtime wrote a system memory resource itself (it only notifies the driver of such locks) */
+void nddi_resource_written(struct nddi_resource *res);
+
+/* Copies between surfaces (any pool): UpdateSurface, GetRenderTargetData or StretchRect depending on the pools.
+ * filter is D3DTEXTUREFILTERTYPE. */
+int32_t nddi_blt(struct nddi_device *dev, struct nddi_resource *src, unsigned src_sub, const struct nddi_rect *src_rect,
+                 struct nddi_resource *dst, unsigned dst_sub, const struct nddi_rect *dst_rect, uint32_t filter);
+int32_t nddi_color_fill(struct nddi_device *dev, struct nddi_resource *res, unsigned subresource,
+                        const struct nddi_rect *rect, uint32_t color);
+
+/* ---- State ---- */
+
+int32_t nddi_set_render_state(struct nddi_device *dev, uint32_t state, uint32_t value);
+int32_t nddi_set_render_target(struct nddi_device *dev, uint32_t index, struct nddi_resource *res,
+                               unsigned subresource);
+int32_t nddi_set_depth_stencil(struct nddi_device *dev, struct nddi_resource *res);
+int32_t nddi_set_viewport(struct nddi_device *dev, const struct nddi_viewport *viewport);
+int32_t nddi_set_scissor(struct nddi_device *dev, const struct nddi_rect *rect);
+
+/* Vertex and index data: from a buffer resource, or from user memory (the DDI's "Um" calls), which is uploaded
+ * per draw */
+int32_t nddi_set_stream_source(struct nddi_device *dev, uint32_t stream, struct nddi_resource *vb, uint32_t offset,
+                               uint32_t stride);
+int32_t nddi_set_stream_source_memory(struct nddi_device *dev, uint32_t stream, const void *data, uint32_t stride);
+int32_t nddi_set_stream_source_freq(struct nddi_device *dev, uint32_t stream, uint32_t setting);
+int32_t nddi_set_indices(struct nddi_device *dev, struct nddi_resource *ib);
+int32_t nddi_set_indices_memory(struct nddi_device *dev, const void *data, uint32_t index_size);
+
+/* Shaders and vertex declarations (opaque objects owned by the DDI side) */
+struct nddi_object;
+struct nddi_vertex_element {   /* D3DVERTEXELEMENT9 / D3DDDIVERTEXELEMENT */
+   uint16_t stream, offset;
+   uint8_t type, method, usage, usage_index;
+};
+int32_t nddi_create_vertex_declaration(struct nddi_device *dev, const struct nddi_vertex_element *elements,
+                                       uint32_t count, struct nddi_object **out);
+int32_t nddi_set_vertex_declaration(struct nddi_device *dev, struct nddi_object *decl);
+int32_t nddi_create_vertex_shader(struct nddi_device *dev, const uint32_t *code, struct nddi_object **out);
+int32_t nddi_set_vertex_shader(struct nddi_device *dev, struct nddi_object *shader);
+int32_t nddi_create_pixel_shader(struct nddi_device *dev, const uint32_t *code, struct nddi_object **out);
+int32_t nddi_set_pixel_shader(struct nddi_device *dev, struct nddi_object *shader);
+void nddi_object_destroy(struct nddi_object *obj);
+
+int32_t nddi_set_shader_constants_f(struct nddi_device *dev, bool pixel, uint32_t start, const float *data,
+                                    uint32_t vec4_count);
+int32_t nddi_set_shader_constants_i(struct nddi_device *dev, bool pixel, uint32_t start, const int32_t *data,
+                                    uint32_t vec4_count);
+int32_t nddi_set_shader_constants_b(struct nddi_device *dev, bool pixel, uint32_t start, const int32_t *data,
+                                    uint32_t count);
+
