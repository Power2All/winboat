+int32_t nddi_set_clip_plane(struct nddi_device *dev, uint32_t index, const float *plane);
+
+/* Queries (D3DQUERYTYPE); get_data returns S_FALSE until the result is ready */
+int32_t nddi_create_query(struct nddi_device *dev, uint32_t type, struct nddi_object **out);
+int32_t nddi_issue_query(struct nddi_object *query, uint32_t flags);
+int32_t nddi_get_query_data(struct nddi_object *query, void *data, uint32_t size);
+uint32_t nddi_get_query_data_size(struct nddi_object *query);
