+DestroyDevice(HANDLE hDevice)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   D3D9UMD_TRACE("DestroyDevice");
+   nddi_device_destroy(dev->nine);
+   dev->screen->destroy(dev->screen);
+   delete dev;
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+Flush(HANDLE hDevice)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   struct pipe_context *pipe = nddi_flush(dev->nine);
+   pipe->flush(pipe, NULL, 0);
+   return S_OK;
+}
+
+/* ---- Resources ---- */
+
+static DWORD
+UsageFromFlags(D3DDDI_RESOURCEFLAGS f)
+{
+   DWORD usage = 0;
+   if (f.RenderTarget)
+      usage |= D3DUSAGE_RENDERTARGET;
+   if (f.ZBuffer)
+      usage |= D3DUSAGE_DEPTHSTENCIL;
+   if (f.Dynamic)
+      usage |= D3DUSAGE_DYNAMIC;
+   if (f.AutogenMipmap)
+      usage |= D3DUSAGE_AUTOGENMIPMAP;
+   if (f.WriteOnly)
+      usage |= D3DUSAGE_WRITEONLY;
+   if (f.Points)
+      usage |= D3DUSAGE_POINTS;
+   if (f.RtPatches)
+      usage |= D3DUSAGE_RTPATCHES;
+   if (f.NPatches)
+      usage |= D3DUSAGE_NPATCHES;
+   if (f.DMap)
+      usage |= D3DUSAGE_DMAP;
+   return usage;
+}
+
+static HRESULT APIENTRY
+CreateResource(HANDLE hDevice, D3DDDIARG_CREATERESOURCE *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   const D3DDDI_SURFACEINFO &s0 = p->pSurfList[0];
+   D3D9UMD_TRACE("CreateResource format %u pool %u flags 0x%x surfaces %u mips %u %ux%ux%u ms %u fvf 0x%x",
+                 p->Format, p->Pool, p->Flags.Value, p->SurfCount, p->MipLevels, s0.Width, s0.Height, s0.Depth,
+                 p->MultisampleType, p->Fvf);
+
+   nddi_resource_desc desc;
+   memset(&desc, 0, sizeof(desc));
+   const D3DDDI_RESOURCEFLAGS f = p->Flags;
+   if (f.VertexBuffer)
+      desc.kind = NDDI_VERTEX_BUFFER;
+   else if (f.IndexBuffer)
+      desc.kind = NDDI_INDEX_BUFFER;
+   else if (f.Texture && f.CubeMap)
+      desc.kind = NDDI_CUBE_TEXTURE;
+   else if (f.Texture && f.Volume)
+      desc.kind = NDDI_VOLUME_TEXTURE;
+   else if (f.Texture)
+      desc.kind = NDDI_TEXTURE;
+   else if (f.ZBuffer)
+      desc.kind = NDDI_DEPTH_STENCIL;
+   else if (f.RenderTarget || f.Primary)
+      desc.kind = NDDI_RENDER_TARGET;
+   else
+      desc.kind = NDDI_SURFACE;
+
+   desc.format = p->Format;
+   desc.width = s0.Width;
+   desc.height = s0.Height;
+   desc.depth = s0.Depth;
+   desc.levels = desc.kind == NDDI_CUBE_TEXTURE ? p->SurfCount / 6
+                 : (desc.kind == NDDI_TEXTURE || desc.kind == NDDI_VOLUME_TEXTURE) ? p->SurfCount : 1;
+   desc.usage = UsageFromFlags(f);
+   desc.multisample = p->MultisampleType;
+   desc.multisample_quality = p->MultisampleQuality;
+   desc.lockable = !f.NotLockable;
+   desc.fvf = p->Fvf;
+
+   std::vector<void *> sysmem;
+   std::vector<uint32_t> pitches;
+   if (p->Pool == D3DDDIPOOL_SYSTEMMEM) {
+      desc.system_memory = true;
+      for (UINT i = 0; i < p->SurfCount; i++) {
+         sysmem.push_back((void *)p->pSurfList[i].pSysMem);
+         D3D9UMD_TRACE("  surface %u: system memory %p pitch %u", i, p->pSurfList[i].pSysMem,
+                       p->pSurfList[i].SysMemPitch);
+         pitches.push_back(p->pSurfList[i].SysMemPitch);
+      }
+      desc.sysmem = sysmem.data();
+      desc.sysmem_pitch = pitches.data();
+   }
+
+   D3D9UmdResource *res = new (std::nothrow) D3D9UmdResource();
+   if (!res)
+      return E_OUTOFMEMORY;
+   res->hRTResource = p->hResource;
+   res->format = p->Format;
+   res->pool = p->Pool;
+   res->flags = f;
+   res->surfCount = p->SurfCount;
+   res->width = s0.Width;
+   res->height = s0.Height;
+
+   /* The kernel allocations made while creating it belong to the runtime's resource */
+   dev->kmt.hRTResource = p->hResource;
+   HRESULT hr = nddi_resource_create(dev->nine, &desc, &res->nine);
+   dev->kmt.hRTResource = NULL;
+   if (FAILED(hr)) {
+      D3D9UmdLog("CreateResource failed (0x%08lx): format %u pool %u flags 0x%x %ux%u", hr, p->Format, p->Pool,
+                 f.Value, s0.Width, s0.Height);
+      delete res;
+      return hr;
+   }
+   p->hResource = res;
+   D3D9UMD_TRACE("  -> %p", res);
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+DestroyResource(HANDLE hDevice, HANDLE hResource)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   D3D9UmdResource *res = D3D9UmdCastResource(hResource);
+   D3D9UMD_TRACE("DestroyResource %p", res);
+   if (dev->renderTarget0 == res)
+      dev->renderTarget0 = NULL;
+   nddi_resource_destroy(res->nine);
+   delete res;
+   return S_OK;
+}
+
+static DWORD
+LockFlags(D3DDDI_LOCKFLAGS f)
+{
+   DWORD flags = 0;
+   if (f.ReadOnly)
+      flags |= D3DLOCK_READONLY;
+   if (f.NoOverwrite)
+      flags |= D3DLOCK_NOOVERWRITE;
+   if (f.Discard)
+      flags |= D3DLOCK_DISCARD;
+   if (f.DoNotWait)
+      flags |= D3DLOCK_DONOTWAIT;
+   return flags;
+}
+
+/* The part of a subresource a lock names (Range, Area or Box valid), NULL for all of it */
+template <typename Flags, typename Arg>
+static const nddi_box *
+LockBox(const Flags &f, const Arg *p, nddi_box *box)
+{
+   if (f.RangeValid)
+      *box = {p->Range.Offset, 0, p->Range.Offset + p->Range.Size, 1, 0, 1};
+   else if (f.AreaValid)
+      *box = {(uint32_t)p->Area.left, (uint32_t)p->Area.top, (uint32_t)p->Area.right, (uint32_t)p->Area.bottom, 0, 1};
+   else if (f.BoxValid)
+      *box = {p->Box.Left, p->Box.Top, p->Box.Right, p->Box.Bottom, p->Box.Front, p->Box.Back};
+   else
+      return NULL;
+   return box;
+}
+
+/* NotifyOnly locks are of system memory resources: the runtime writes its own memory and only tells the driver */
+static HRESULT APIENTRY
+Lock(HANDLE hDevice, D3DDDIARG_LOCK *p)
+{
+   D3D9UmdResource *res = D3D9UmdCastResource(p->hResource);
+   if (p->Flags.NotifyOnly) {
+      D3D9UMD_TRACE("Lock (notify) resource %p sub %u flags 0x%x", res, p->SubResourceIndex, p->Flags.Value);
+      nddi_resource_written(res->nine);
+      return S_OK;
+   }
+
+   nddi_box box;
+   void *data = NULL;
+   uint32_t pitch = 0, slicePitch = 0;
+   HRESULT hr = nddi_resource_lock(res->nine, p->SubResourceIndex, LockBox(p->Flags, p, &box), LockFlags(p->Flags),
+                                   &data, &pitch, &slicePitch);
+   D3D9UMD_TRACE("Lock resource %p sub %u flags 0x%x -> 0x%08lx", res, p->SubResourceIndex, p->Flags.Value, hr);
+   if (FAILED(hr))
+      return hr;
+   p->pSurfData = data;
+   p->Pitch = pitch;
+   p->SlicePitch = slicePitch;
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+Unlock(HANDLE hDevice, const D3DDDIARG_UNLOCK *p)
+{
+   D3D9UmdResource *res = D3D9UmdCastResource(p->hResource);
+   D3D9UMD_TRACE("Unlock resource %p sub %u flags 0x%x", res, p->SubResourceIndex, p->Flags.Value);
+   if (p->Flags.NotifyOnly) {
+      nddi_resource_written(res->nine);
+      return S_OK;
+   }
+   return nddi_resource_unlock(res->nine, p->SubResourceIndex);
+}
+
+/* Locks from the application's thread while the runtime's own thread renders. Nine serializes the two. */
+static HRESULT APIENTRY
+LockAsync(HANDLE hDevice, D3DDDIARG_LOCKASYNC *p)
+{
+   D3D9UmdResource *res = D3D9UmdCastResource(p->hResource);
+   p->hCookie = NULL;
+   if (p->Flags.NotifyOnly) {
+      D3D9UMD_TRACE("LockAsync (notify) resource %p sub %u flags 0x%x", res, p->SubResourceIndex, p->Flags.Value);
+      nddi_resource_written(res->nine);
+      return S_OK;
+   }
+
+   DWORD flags = 0;
+   if (p->Flags.NoOverwrite)
+      flags |= D3DLOCK_NOOVERWRITE;
+   if (p->Flags.Discard)
+      flags |= D3DLOCK_DISCARD;
+   nddi_box box;
+   void *data = NULL;
+   uint32_t pitch = 0, slicePitch = 0;
+   HRESULT hr = nddi_resource_lock(res->nine, p->SubResourceIndex, LockBox(p->Flags, p, &box), flags, &data, &pitch,
+                                   &slicePitch);
+   D3D9UMD_TRACE("LockAsync resource %p sub %u flags 0x%x -> 0x%08lx", res, p->SubResourceIndex, p->Flags.Value, hr);
+   if (FAILED(hr))
+      return hr;
+   p->pSurfData = data;
+   p->Pitch = pitch;
+   p->SlicePitch = slicePitch;
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+UnlockAsync(HANDLE hDevice, const D3DDDIARG_UNLOCKASYNC *p)
+{
+   D3D9UmdResource *res = D3D9UmdCastResource(p->hResource);
+   D3D9UMD_TRACE("UnlockAsync resource %p sub %u flags 0x%x", res, p->SubResourceIndex, p->Flags.Value);
+   if (p->Flags.NotifyOnly) {
+      nddi_resource_written(res->nine);
+      return S_OK;
+   }
+   return nddi_resource_unlock(res->nine, p->SubResourceIndex);
+}
+
+static HRESULT APIENTRY
+Blt(HANDLE hDevice, const D3DDDIARG_BLT *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   D3D9UmdResource *src = D3D9UmdCastResource(p->hSrcResource), *dst = D3D9UmdCastResource(p->hDstResource);
+   nddi_rect sr = {p->SrcRect.left, p->SrcRect.top, p->SrcRect.right, p->SrcRect.bottom};
+   nddi_rect dr = {p->DstRect.left, p->DstRect.top, p->DstRect.right, p->DstRect.bottom};
+   HRESULT hr = nddi_blt(dev->nine, src->nine, p->SrcSubResourceIndex, &sr, dst->nine, p->DstSubResourceIndex, &dr,
+                         p->Flags.Linear ? D3DTEXF_LINEAR : D3DTEXF_POINT);
+   D3D9UMD_TRACE("Blt %p[%u] -> %p[%u] flags 0x%x -> 0x%08lx", src, p->SrcSubResourceIndex, dst,
+                 p->DstSubResourceIndex, p->Flags.Value, hr);
+   return hr;
+}
+
+static HRESULT APIENTRY
+ColorFill(HANDLE hDevice, const D3DDDIARG_COLORFILL *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   nddi_rect r = {p->DstRect.left, p->DstRect.top, p->DstRect.right, p->DstRect.bottom};
+   return nddi_color_fill(dev->nine, D3D9UmdCastResource(p->hResource)->nine, p->SubResourceIndex, &r, p->Color);
+}
+
+/* ---- State ---- */
+
+static HRESULT APIENTRY
+SetRenderState(HANDLE hDevice, const D3DDDIARG_RENDERSTATE *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   D3D9UMD_TRACE("SetRenderState %u = 0x%x", (UINT)p->State, p->Value);
+   switch ((UINT)p->State) {
+   case D3DDDIRS_SCENECAPTURE:
+      /* The DDI's BeginScene/EndScene */
+      if (p->Value && !dev->inScene) {
+         dev->inScene = true;
+         return nddi_begin_scene(dev->nine);
+      }
+      if (!p->Value && dev->inScene) {
+         dev->inScene = false;
+         return nddi_end_scene(dev->nine);
+      }
+      return S_OK;
+   case D3DDDIRS_LINEPATTERN:
+   case D3DDDIRS_ZVISIBLE:
+   case D3DDDIRS_COLORKEYENABLE:
+   case D3DDDIRS_TRANSLUCENTSORTINDEPENDENT:
+      return S_OK;
+   default:
+      if (p->State >= D3DDDIRS_STIPPLEPATTERN00 && p->State <= D3DDDIRS_STIPPLEPATTERN31)
+         return S_OK;
+      /* Legacy and DDI-only states nine doesn't know are refused by it; ignore them */
+      if (FAILED(nddi_set_render_state(dev->nine, p->State, p->Value)))
+         D3D9UMD_TRACE("render state %u = %u not accepted", p->State, p->Value);
+      return S_OK;
+   }
+}
+
+static HRESULT APIENTRY
+SetRenderTarget(HANDLE hDevice, const D3DDDIARG_SETRENDERTARGET *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   D3D9UmdResource *res = D3D9UmdCastResource(p->hRenderTarget);
+   if (p->RenderTargetIndex == 0)
+      dev->renderTarget0 = res;
+   HRESULT hr = nddi_set_render_target(dev->nine, p->RenderTargetIndex, res ? res->nine : NULL, p->SubResourceIndex);
+   D3D9UMD_TRACE("SetRenderTarget %u = %p[%u] -> 0x%08lx", p->RenderTargetIndex, res, p->SubResourceIndex, hr);
+   return hr;
+}
+
+static HRESULT APIENTRY
+SetDepthStencil(HANDLE hDevice, const D3DDDIARG_SETDEPTHSTENCIL *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   D3D9UmdResource *res = D3D9UmdCastResource(p->hZBuffer);
+   return nddi_set_depth_stencil(dev->nine, res ? res->nine : NULL);
+}
+
+static HRESULT APIENTRY
+SetViewport(HANDLE hDevice, const D3DDDIARG_VIEWPORTINFO *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   dev->viewport.x = p->X;
+   dev->viewport.y = p->Y;
+   dev->viewport.width = p->Width;
+   dev->viewport.height = p->Height;
+   nddi_set_viewport(dev->nine, &dev->viewport);
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+SetZRange(HANDLE hDevice, const D3DDDIARG_ZRANGE *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   dev->viewport.min_z = p->MinZ;
+   dev->viewport.max_z = p->MaxZ;
+   nddi_set_viewport(dev->nine, &dev->viewport);
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+SetScissorRect(HANDLE hDevice, const RECT *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   nddi_rect r = {p->left, p->top, p->right, p->bottom};
+   return nddi_set_scissor(dev->nine, &r);
+}
+
+/* ---- Commands ---- */
+
+static HRESULT APIENTRY
+Clear(HANDLE hDevice, const D3DDDIARG_CLEAR *p, UINT NumRect, const RECT *pRect)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   static_assert(sizeof(RECT) == sizeof(nddi_rect), "RECT layout");
+   HRESULT hr = nddi_clear(dev->nine, NumRect, (const nddi_rect *)pRect,
+                           p->Flags & (D3DCLEAR_TARGET | D3DCLEAR_ZBUFFER | D3DCLEAR_STENCIL), p->FillColor,
+                           p->FillDepth, p->FillStencil);
+   D3D9UMD_TRACE("Clear flags 0x%x color 0x%08x rects %u -> 0x%08lx", p->Flags, p->FillColor, NumRect, hr);
+   return hr;
+}
+
+static HRESULT APIENTRY
+Present(HANDLE hDevice, const D3DDDIARG_PRESENT *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   D3D9UmdResource *src = D3D9UmdCastResource(p->hSrcResource);
+   unsigned level = 0, layer = 0;
+   struct pipe_resource *resource = nddi_resource_get_pipe(src->nine, p->SrcSubResourceIndex, &level, &layer);
+   if (!resource)
+      return E_INVALIDARG;
+   if (p->hDstResource)
+      D3D9UMD_TRACE("Present to a destination resource isn't supported yet (flags 0x%x)", p->Flags.Value);
+
+   /* flush_frontbuffer flushes the context and hands the source allocation to the runtime's present callback */
+   struct pipe_context *pipe = nddi_flush(dev->nine);
+   gdikmt_d3d9_present info;
+   memset(&info, 0, sizeof(info));
+   dev->screen->flush_frontbuffer(dev->screen, pipe, resource, level, layer, &info, 0, NULL);
+   D3D9UMD_TRACE("Present %p[%u] flags 0x%x", src, p->SrcSubResourceIndex, p->Flags.Value);
+   return S_OK;
+}
+
+void
+D3D9UmdFillDeviceFuncs(D3DDDI_DEVICEFUNCS *f)
+{
+   f->pfnDestroyDevice = DestroyDevice;
+   f->pfnFlush = Flush;
+   f->pfnCreateResource = CreateResource;
+   f->pfnDestroyResource = DestroyResource;
+   f->pfnLock = Lock;
+   f->pfnUnlock = Unlock;
+   f->pfnLockAsync = LockAsync;
+   f->pfnUnlockAsync = UnlockAsync;
+   f->pfnBlt = Blt;
+   f->pfnColorFill = ColorFill;
+   f->pfnSetRenderState = SetRenderState;
+   f->pfnSetRenderTarget = SetRenderTarget;
+   f->pfnSetDepthStencil = SetDepthStencil;
+   f->pfnSetViewport = SetViewport;
+   f->pfnSetZRange = SetZRange;
+   f->pfnSetScissorRect = SetScissorRect;
+   f->pfnClear = Clear;
+   f->pfnPresent = Present;
+   D3D9UmdFillPipelineFuncs(f);
+}
diff --git a/src/gallium/frontends/d3d9umd/gdikmt_d3d9.cpp b/src/gallium/frontends/d3d9umd/gdikmt_d3d9.cpp
new file mode 100644
index 0000000..23956a0
--- /dev/null
+++ b/src/gallium/frontends/d3d9umd/gdikmt_d3d9.cpp
@@ -0,0 +1,235 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include <windows.h>
+#include "winddk_compat.h"
+#include <string.h>
+
+#include "gdikmt_d3d9.h"
+#include "util/u_memory.h"
+
+struct gdikmt_context_d3d9 {
+   struct gdikmt_context base;
+   HANDLE hContext;
+};
+
+static inline struct gdikmt_context_d3d9 *
+context_d3d9(struct gdikmt_context *ctx)
+{
+   return (struct gdikmt_context_d3d9 *)ctx;
+}
+
+static inline struct gdikmt_device_d3d9 *
+device_d3d9(struct gdikmt_device *dev)
+{
+   return (struct gdikmt_device_d3d9 *)dev;
+}
+
+static NTSTATUS
+queryadapterinfo(struct gdikmt_device *_device, KMTQUERYADAPTERINFOTYPE Type, VOID *pPrivateDriverData,
+                 UINT PrivateDriverDataSize)
+{
+   struct gdikmt_device_d3d9 *device = device_d3d9(_device);
+   D3DDDICB_QUERYADAPTERINFO query;
+   memset(&query, 0, sizeof(query));
+   query.pPrivateDriverData = pPrivateDriverData;
+   query.PrivateDriverDataSize = PrivateDriverDataSize;
+   return device->adapterCallbacks->pfnQueryAdapterInfoCb(device->hRTAdapter, &query);
+}
+
+static NTSTATUS
+escape(struct gdikmt_device *_device, VOID *pPrivateDriverData, UINT PrivateDriverDataSize)
+{
+   struct gdikmt_device_d3d9 *device = device_d3d9(_device);
+   D3DDDICB_ESCAPE esc;
+   memset(&esc, 0, sizeof(esc));
+   esc.hDevice = device->hRTDevice;
+   esc.pPrivateDriverData = pPrivateDriverData;
+   esc.PrivateDriverDataSize = PrivateDriverDataSize;
+   return device->callbacks.pfnEscapeCb(device->hRTAdapter, &esc);
+}
+
+static NTSTATUS
+render(struct gdikmt_context *_ctx, struct gdikmt_render *options)
+{
+   struct gdikmt_context_d3d9 *ctx = context_d3d9(_ctx);
+   struct gdikmt_device_d3d9 *dev = device_d3d9(ctx->base.device);
+
+   D3DDDICB_RENDER r;
+   memset(&r, 0, sizeof(r));
+   r.hContext = ctx->hContext;
+   r.CommandOffset = options->CommandOffset;
+   r.CommandLength = options->CommandLength;
+   r.NumAllocations = options->AllocationCount;
+   r.NumPatchLocations = options->PatchLocationCount;
+   r.NewCommandBufferSize = options->NewCommandBufferSize;
+   r.NewAllocationListSize = options->NewAllocationListSize;
+   r.NewPatchLocationListSize = options->NewPatchLocationListSize;
+   r.Flags.ResizeCommandBuffer = options->ResizeCommandBuffer;
+   r.Flags.ResizeAllocationList = options->ResizeAllocationList;
+   r.Flags.ResizePatchLocationList = options->ResizePatchLocationList;
+
+   NTSTATUS status = dev->callbacks.pfnRenderCb(dev->hRTDevice, &r);
+
+   if (options->CompletionEvent) {
+      D3DDDICB_SIGNALSYNCHRONIZATIONOBJECT2 signal;
+      memset(&signal, 0, sizeof(signal));
+      signal.hContext = ctx->hContext;
+      signal.Flags.EnqueueCpuEvent = TRUE;
+      signal.CpuEventHandle = options->CompletionEvent;
+      dev->callbacks.pfnSignalSynchronizationObject2Cb(dev->hRTDevice, &signal);
+   }
+
+   ctx->base.pCommandBuffer = r.pNewCommandBuffer;
+   ctx->base.pAllocationList = r.pNewAllocationList;
+   ctx->base.pPatchLocationList = r.pNewPatchLocationList;
+   ctx->base.CommandBufferSize = r.NewCommandBufferSize;
+   ctx->base.AllocationListSize = r.NewAllocationListSize;
+   ctx->base.PatchLocationListSize = r.NewPatchLocationListSize;
+   return status;
+}
+
+static void
+destroycontext(struct gdikmt_context *_ctx)
+{
+   struct gdikmt_context_d3d9 *ctx = context_d3d9(_ctx);
+   struct gdikmt_device_d3d9 *dev = device_d3d9(ctx->base.device);
+   D3DDDICB_DESTROYCONTEXT destroy;
+   memset(&destroy, 0, sizeof(destroy));
+   destroy.hContext = ctx->hContext;
+   dev->callbacks.pfnDestroyContextCb(dev->hRTDevice, &destroy);
+   FREE(ctx);
+}
+
+static NTSTATUS
+createcontext(struct gdikmt_device *_device, struct gdikmt_context **out)
+{
+   struct gdikmt_device_d3d9 *device = device_d3d9(_device);
+   struct gdikmt_context_d3d9 *ctx = CALLOC_STRUCT(gdikmt_context_d3d9);
+   if (!ctx)
+      return STATUS_NO_MEMORY;
+   ctx->base.device = _device;
+
+   D3DDDICB_CREATECONTEXT create;
+   memset(&create, 0, sizeof(create));
+   NTSTATUS status = device->callbacks.pfnCreateContextCb(device->hRTDevice, &create);
+   if (!NT_SUCCESS(status)) {
+      FREE(ctx);
+      return status;
+   }
+   ctx->hContext = create.hContext;
+   ctx->base.pCommandBuffer = create.pCommandBuffer;
+   ctx->base.pAllocationList = create.pAllocationList;
+   ctx->base.pPatchLocationList = create.pPatchLocationList;
+   ctx->base.CommandBufferSize = create.CommandBufferSize;
+   ctx->base.AllocationListSize = create.AllocationListSize;
+   ctx->base.PatchLocationListSize = create.PatchLocationListSize;
+   ctx->base.destroy = destroycontext;
+   ctx->base.render = render;
+   *out = &ctx->base;
+   return status;
+}
+
+static NTSTATUS
+createallocation(struct gdikmt_device *_device, struct gdikmt_createallocation *options)
+{
+   struct gdikmt_device_d3d9 *device = device_d3d9(_device);
+   D3DDDICB_ALLOCATE allocate;
+   memset(&allocate, 0, sizeof(allocate));
+   allocate.NumAllocations = options->NumAllocations;
+   allocate.pAllocationInfo = options->pAllocationInfo;
+   allocate.pPrivateDriverData = options->pPrivateDriverData;
+   allocate.PrivateDriverDataSize = options->PrivateDriverDataSize;
+   allocate.hResource = device->hRTResource;
+   NTSTATUS status = device->callbacks.pfnAllocateCb(device->hRTDevice, &allocate);
+   options->hResource = (HANDLE)(uintptr_t)allocate.hKMResource;
+   return status;
+}
+
+static NTSTATUS
+destroyallocation(struct gdikmt_device *_device, HANDLE hResource, D3DKMT_HANDLE hAllocation)
+{
+   struct gdikmt_device_d3d9 *device = device_d3d9(_device);
+   D3DDDICB_DEALLOCATE deallocate;
+   memset(&deallocate, 0, sizeof(deallocate));
+   deallocate.NumAllocations = 1;
+   deallocate.HandleList = &hAllocation;
+   return device->callbacks.pfnDeallocateCb(device->hRTDevice, &deallocate);
+}
+
+static NTSTATUS
+lockallocation(struct gdikmt_device *_device, D3DKMT_HANDLE hAllocation, D3DDDICB_LOCKFLAGS flags, void **out)
+{
+   struct gdikmt_device_d3d9 *device = device_d3d9(_device);
+   D3DDDICB_LOCK lock;
+   memset(&lock, 0, sizeof(lock));
+   lock.Flags = flags;
+   lock.Flags.LockEntire = TRUE;
+   lock.hAllocation = hAllocation;
+   NTSTATUS status = device->callbacks.pfnLockCb(device->hRTDevice, &lock);
+   *out = lock.pData;
+   return status;
+}
+
+/* Shared resources (OpenResource) aren't supported yet */
+static NTSTATUS
+queryallocation(struct gdikmt_device *, struct gdikmt_openallocation *)
+{
+   return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS
+openallocation(struct gdikmt_device *, struct gdikmt_openallocation *)
+{
+   return STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS
+present(struct gdikmt_context *_ctx, D3DKMT_HANDLE hSrcAllocation, void *winsys_drawable_handle,
+        struct pipe_box *sub_box)
+{
+   struct gdikmt_context_d3d9 *ctx = context_d3d9(_ctx);
+   struct gdikmt_device_d3d9 *dev = device_d3d9(_ctx->device);
+   const struct gdikmt_d3d9_present *info = (const struct gdikmt_d3d9_present *)winsys_drawable_handle;
+
+   D3DDDICB_PRESENT p;
+   memset(&p, 0, sizeof(p));
+   p.hSrcAllocation = hSrcAllocation;
+   p.hDstAllocation = info ? info->hDstAllocation : 0;
+   p.hContext = ctx->hContext;
+   return dev->callbacks.pfnPresentCb(dev->hRTDevice, &p);
+}
+
+static NTSTATUS
+setdisplaymode(struct gdikmt_device *_device, D3DKMT_HANDLE hSrcAllocation)
+{
+   struct gdikmt_device_d3d9 *device = device_d3d9(_device);
+   D3DDDICB_SETDISPLAYMODE mode;
+   memset(&mode, 0, sizeof(mode));
+   mode.hPrimaryAllocation = hSrcAllocation;
+   return device->callbacks.pfnSetDisplayModeCb(device->hRTDevice, &mode);
+}
+
+static void
+destroy(struct gdikmt_device *)
+{
+   /* Embedded in the driver's device; nothing to free */
+}
+
+void
+gdikmt_d3d9_init(struct gdikmt_device_d3d9 *device)
+{
+   device->base.destroy = destroy;
+   device->base.queryAdapterInfo = queryadapterinfo;
+   device->base.escape = escape;
+   device->base.createContext = createcontext;
+   device->base.createAllocation = createallocation;
+   device->base.destroyAllocation = destroyallocation;
+   device->base.lockAllocation = lockallocation;
+   device->base.queryAllocation = queryallocation;
+   device->base.openAllocation = openallocation;
+   device->base.present = present;
+   device->base.setDisplayMode = setdisplaymode;
+}
diff --git a/src/gallium/frontends/d3d9umd/gdikmt_d3d9.h b/src/gallium/frontends/d3d9umd/gdikmt_d3d9.h
new file mode 100644
index 0000000..744cb14
