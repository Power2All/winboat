+++ b/src/gallium/frontends/d3d9umd/gdikmt_d3d9.h
@@ -0,0 +1,35 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* gdikmt (the kernel interface the virgl winsys uses) on top of the D3D9 runtime's callbacks, like
+ * d3d10umd/gdikmt_d3dddi for the D3D10 runtime */
+
+#ifndef GDIKMT_D3D9_H
+#define GDIKMT_D3D9_H
+
+#include "gdikmt/gdikmt.h"
+#include <d3d9.h> /* d3dumddi.h uses the D3D9 types without including them */
+#include <d3dumddi.h>
+
+struct gdikmt_device_d3d9 {
+   struct gdikmt_device base;
+
+   HANDLE hRTAdapter;
+   HANDLE hRTDevice;
+   D3DDDI_DEVICECALLBACKS callbacks;
+   const D3DDDI_ADAPTERCALLBACKS *adapterCallbacks;
+
+   /* Set while the driver creates a resource, so its allocations belong to the runtime's resource */
+   HANDLE hRTResource;
+};
+
+/* What flush_frontbuffer passes as its drawable handle when presenting */
+struct gdikmt_d3d9_present {
+   D3DKMT_HANDLE hDstAllocation;
+};
+
+void gdikmt_d3d9_init(struct gdikmt_device_d3d9 *device);
+
+#endif
diff --git a/src/gallium/frontends/d3d9umd/gen_stubs.py b/src/gallium/frontends/d3d9umd/gen_stubs.py
new file mode 100644
index 0000000..2fa1c12
--- /dev/null
+++ b/src/gallium/frontends/d3d9umd/gen_stubs.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Generates ddi_stubs.cpp: a typed stub for every D3DDDI_DEVICEFUNCS entry (from d3dumddi.h).
+
+    gen_stubs.py <WDK>/Include/<version>/um/d3dumddi.h ddi_stubs.cpp
+
+Typed stubs matter on 32-bit x86, where the __stdcall callee pops its own arguments: a generic stub with the wrong
+parameter list would corrupt the stack.
+"""
+import re
+import sys
+
+header = open(sys.argv[1]).read().replace('\r', '')
+
+# Members of D3DDDI_DEVICEFUNCS, in order, with their #if guards dropped (we build against the latest header)
+body = re.search(r'typedef struct _D3DDDI_DEVICEFUNCS\s*\{(.*?)\}\s*D3DDDI_DEVICEFUNCS;', header, re.S).group(1)
+members = re.findall(r'^\s*(PFND3DDDI_\w+)\s+(pfn\w+);', body, re.M)
+
+def typedef(pfn_type):
+    m = re.search(r'typedef\s+(?:_Check_return_\s+)?(\w+)\s*\(\s*APIENTRY\s*\*\s*' + pfn_type + r'\s*\)\s*\((.*?)\)\s*;',
+                  header, re.S)
+    if not m:
+        raise SystemExit('no typedef for ' + pfn_type)
+    ret, params = m.group(1), ' '.join(m.group(2).split())
+    return ret, params
+
+out = ['/*',
+       ' * Copyright 2026 WinBoat contributors',
+       ' * SPDX-License-Identifier: MIT',
+       ' *',
+       ' * Generated from d3dumddi.h: a typed stub for every D3DDDI_DEVICEFUNCS entry, so the runtime never calls a NULL',
+       ' * pointer. device.cpp overrides the implemented ones. Regenerate with gen_stubs.py when the DDI grows.',
+       ' */',
+       '',
+       '#include "d3d9umd.h"',
+       '']
+for pfn_type, member in members:
+    ret, params = typedef(pfn_type)
+    name = member[3:]
+    if ret.upper() in ('VOID', 'VOID_'):
+        out.append(f'static VOID APIENTRY\nStub{name}({params})\n{{\n   D3D9UmdUnimplemented("{name}");\n}}\n')
+    else:
+        out.append(f'static {ret} APIENTRY\nStub{name}({params})\n{{\n   return D3D9UmdUnimplemented("{name}");\n}}\n')
+
+out.append('void\nD3D9UmdFillStubs(D3DDDI_DEVICEFUNCS *funcs)\n{')
+for pfn_type, member in members:
+    out.append(f'   funcs->{member} = Stub{member[3:]};')
+out.append('}')
+open(sys.argv[2], 'w').write('\n'.join(out) + '\n')
+print(f'{len(members)} stubs')
