diff --git a/src/gallium/targets/d3d9umd/meson.build b/src/gallium/targets/d3d9umd/meson.build
new file mode 100644
index 0000000..f7b00c9
--- /dev/null
+++ b/src/gallium/targets/d3d9umd/meson.build
@@ -0,0 +1,27 @@
+# Copyright 2026 WinBoat contributors
+# SPDX-License-Identifier: MIT
+
+# The Direct3D 9 WDDM user-mode driver: the D3D9 DDI (d3d9umd) on top of gallium nine and virgl
+libgallium_d3d9_def = custom_target(
+  'd3d9.def',
+  input : 'd3d9.def.in',
+  output : 'd3d9.def',
+  command : gen_vs_module_defs_normal_command,
+)
+
+# A linker map, to turn the crash addresses d3d9umd logs (when tracing) into function names
+_d3d9umd_link_args = []
+if cc.get_argument_syntax() == 'msvc'
+  _d3d9umd_link_args += ['/MAP']
+endif
+
+libgallium_d3d9 = shared_library(
+  get_option('gallium-d3d9-dll-name'),
+  vs_module_defs : libgallium_d3d9_def,
+  link_args : _d3d9umd_link_args,
+  link_whole : [libd3d9umd, libd3d9umd_nine],
+  link_with : [libnine_st, libgallium, libgalliumvl, libwsgdi],
+  dependencies : [dep_ws2_32, idep_nir, driver_virgl, idep_mesautil],
+  name_prefix : '',
+  install : true,
+)
