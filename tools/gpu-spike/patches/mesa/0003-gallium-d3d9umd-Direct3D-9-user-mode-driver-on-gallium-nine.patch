+   f->pfnDeleteVertexShaderDecl = DeleteVertexShaderDecl;
+   f->pfnCreateVertexShaderFunc = CreateVertexShaderFunc;
+   f->pfnSetVertexShaderFunc = SetVertexShaderFunc;
+   f->pfnDeleteVertexShaderFunc = DeleteVertexShaderFunc;
+   f->pfnCreatePixelShader = CreatePixelShader;
+   f->pfnSetPixelShader = SetPixelShader;
+   f->pfnDeletePixelShader = DeletePixelShader;
+   f->pfnSetVertexShaderConst = SetVertexShaderConst;
+   f->pfnSetVertexShaderConstI = SetVertexShaderConstI;
+   f->pfnSetVertexShaderConstB = SetVertexShaderConstB;
+   f->pfnSetPixelShaderConst = SetPixelShaderConst;
+   f->pfnSetPixelShaderConstI = SetPixelShaderConstI;
+   f->pfnSetPixelShaderConstB = SetPixelShaderConstB;
+   f->pfnSetTexture = SetTexture;
+   f->pfnSetTextureStageState = SetTextureStageState;
+   f->pfnGenerateMipSubLevels = GenerateMipSubLevels;
+   f->pfnTexBlt = TexBlt;
+   f->pfnSetTransform = SetTransform;
+   f->pfnMultiplyTransform = MultiplyTransform;
+   f->pfnSetMaterial = SetMaterial;
+   f->pfnSetLight = SetLight;
+   f->pfnCreateLight = CreateLight;
+   f->pfnDestroyLight = DestroyLight;
+   f->pfnSetClipPlane = SetClipPlane;
+   f->pfnValidateDevice = ValidateDevice;
+   f->pfnCreateQuery = CreateQuery;
+   f->pfnDestroyQuery = DestroyQuery;
+   f->pfnIssueQuery = IssueQuery;
+   f->pfnGetQueryData = GetQueryData;
+}
