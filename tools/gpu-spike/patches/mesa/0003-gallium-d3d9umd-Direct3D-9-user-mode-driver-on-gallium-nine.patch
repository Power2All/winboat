+/* ---- Commands ---- */
+
+int32_t nddi_begin_scene(struct nddi_device *dev);
+int32_t nddi_end_scene(struct nddi_device *dev);
+int32_t nddi_clear(struct nddi_device *dev, uint32_t rect_count, const struct nddi_rect *rects, uint32_t flags,
+                   uint32_t color, float z, uint32_t stencil);
+int32_t nddi_draw_primitive(struct nddi_device *dev, uint32_t type, uint32_t start_vertex, uint32_t count);
+int32_t nddi_draw_indexed_primitive(struct nddi_device *dev, uint32_t type, int32_t base_vertex, uint32_t min_index,
+                                    uint32_t num_vertices, uint32_t start_index, uint32_t count);
