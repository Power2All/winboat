diff --git a/src/gallium/frontends/d3d9umd/nine_bridge.c b/src/gallium/frontends/d3d9umd/nine_bridge.c
new file mode 100644
index 0000000..624c041
--- /dev/null
+++ b/src/gallium/frontends/d3d9umd/nine_bridge.c
@@ -0,0 +1,966 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * The nine side of d3d9umd: a headless NineDevice9 per DDI device, and a nine object per DDI resource.
+ * Only gallium nine's D3D9 headers are visible here, never the WDK's (see d3d9umd_bridge.h).
+ */
+
+#include "d3d9umd_bridge.h"
+
+#include "adapter9.h"
+#include "cubetexture9.h"
+#include "device9.h"
+#include "buffer9.h"
+#include "indexbuffer9.h"
+#include "pixelshader9.h"
+#include "query9.h"
+#include "vertexdeclaration9.h"
+#include "vertexshader9.h"
+#include "nine_memory_helper.h"
+#include "nine_pipe.h"
+#include "nine_state.h"
+#include "surface9.h"
+#include "texture9.h"
+#include "vertexbuffer9.h"
+#include "volumetexture9.h"
+
+#include "pipe/p_screen.h"
+#include "util/format/u_format.h"
+#include "util/u_debug.h"
+#include "util/u_memory.h"
+#include "util/u_upload_mgr.h"
+#include "util/u_inlines.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+/* Both header sets describe the same binary structures */
+static_assert(sizeof(D3DCAPS9) == 304, "D3DCAPS9 layout");
+static_assert(sizeof(D3DRECT) == sizeof(struct nddi_rect), "D3DRECT layout");
+
+struct nddi_adapter {
+   struct d3dadapter9_context ctx;
+   struct NineAdapter9 *adapter;
+};
+
+#define NDDI_MAX_STREAMS 16
+
+struct nddi_device {
+   struct nddi_adapter *adapter;
+   struct d3dadapter9_context ctx;
+   struct NineDevice9 *device;
+
+   /* User memory vertex streams and indices (SetStreamSourceUm / SetIndicesUm), uploaded per draw */
+   struct {
+      const void *data;
+      uint32_t stride;
+   } memory_stream[NDDI_MAX_STREAMS];
+   const void *memory_indices;
+   uint32_t memory_index_size;
+};
+
+struct nddi_object {
+   struct NineUnknown *obj;
+};
+
+struct nddi_resource {
+   struct nddi_device *dev;
+   enum nddi_resource_kind kind;
+   struct NineUnknown *obj;          /* the nine object, NULL for system memory resources */
+   unsigned levels;
+   unsigned subresource_count;
+   struct NineSurface9 **sysmem;     /* system memory: one surface wrapping runtime memory per subresource */
+};
+
+static void
+nddi_init_context(struct d3dadapter9_context *ctx, struct pipe_screen *screen)
+{
+   memset(ctx, 0, sizeof(*ctx));
+   ctx->hal = screen;
+   /* nine's software vertex processing context; the D3D9 runtime processes vertices itself for SWVP devices */
+   ctx->ref = screen;
+   snprintf(ctx->identifier.Driver, sizeof(ctx->identifier.Driver), "viogpu_d3d9.dll");
+   snprintf(ctx->identifier.Description, sizeof(ctx->identifier.Description), "%s", screen->get_name(screen));
+   ctx->identifier.VendorId = 0x1af4;
+   ctx->identifier.DeviceId = 0x1050;
+   ctx->identifier.WHQLLevel = 0;
+   /* The DDI calls arrive serialized from the runtime; no worker thread */
+   ctx->csmt_force = 0;
+   ctx->memfd_virtualsizelimit = -1;
+   ctx->override_vram_size = -1;
+}
+
+/* ---- Adapter ---- */
+
+struct nddi_adapter *
+nddi_adapter_create(struct pipe_screen *screen)
+{
+   struct nddi_adapter *adapter = CALLOC_STRUCT(nddi_adapter);
+   if (!adapter)
+      return NULL;
+   nddi_init_context(&adapter->ctx, screen);
+   if (FAILED(NineAdapter9_new(&adapter->ctx, &adapter->adapter))) {
+      _debug_printf("d3d9umd: gallium nine doesn't support %s\n", screen->get_name(screen));
+      FREE(adapter);
+      return NULL;
+   }
+   return adapter;
+}
+
+void
+nddi_adapter_destroy(struct nddi_adapter *adapter)
+{
+   if (!adapter)
+      return;
+   NineUnknown_Release(NineUnknown(adapter->adapter));
+   FREE(adapter);
+}
+
+bool
+nddi_adapter_get_caps(struct nddi_adapter *adapter, void *d3dcaps9, unsigned size)
+{
+   if (size < sizeof(D3DCAPS9))
+      return false;
+   return SUCCEEDED(NineAdapter9_GetDeviceCaps(adapter->adapter, D3DDEVTYPE_HAL, (D3DCAPS9 *)d3dcaps9));
+}
+
+bool
+nddi_adapter_check_format(struct nddi_adapter *adapter, uint32_t adapter_format, uint32_t usage, uint32_t rtype,
+                          uint32_t format)
+{
+   return NineAdapter9_CheckDeviceFormat(adapter->adapter, D3DDEVTYPE_HAL, (D3DFORMAT)adapter_format, usage,
+                                         (D3DRESOURCETYPE)rtype, (D3DFORMAT)format) == D3D_OK;
+}
+
+bool
+nddi_adapter_check_multisample(struct nddi_adapter *adapter, uint32_t format, uint32_t samples,
+                               uint32_t *quality_levels)
+{
+   DWORD levels = 0;
+   HRESULT hr = NineAdapter9_CheckDeviceMultiSampleType(adapter->adapter, D3DDEVTYPE_HAL, (D3DFORMAT)format, TRUE,
+                                                        (D3DMULTISAMPLE_TYPE)samples, &levels);
+   if (quality_levels)
+      *quality_levels = levels;
+   return SUCCEEDED(hr);
+}
+
+/* ---- Device ---- */
+
+struct nddi_device *
+nddi_device_create(struct nddi_adapter *adapter, struct pipe_screen *screen)
+{
+   struct nddi_device *dev = CALLOC_STRUCT(nddi_device);
+   if (!dev)
+      return NULL;
+   dev->adapter = adapter;
+   nddi_init_context(&dev->ctx, screen);
+
+   D3DCAPS9 caps;
+   if (FAILED(NineAdapter9_GetDeviceCaps(adapter->adapter, D3DDEVTYPE_HAL, &caps))) {
+      FREE(dev);
+      return NULL;
+   }
+   D3DDEVICE_CREATION_PARAMETERS params;
+   memset(&params, 0, sizeof(params));
+   params.AdapterOrdinal = 0;
+   params.DeviceType = D3DDEVTYPE_HAL;
+   /* The runtime transforms vertices itself for software vertex processing devices, so nine always gets HWVP.
+    * FPU_PRESERVE: the runtime manages the FPU state. */
+   params.BehaviorFlags = D3DCREATE_HARDWARE_VERTEXPROCESSING | D3DCREATE_FPU_PRESERVE;
+
+   /* No presentation group: a headless device, the runtime owns swapchains */
+   HRESULT hr = NineDevice9_new(screen, &params, &caps, NULL, NULL, NULL, &dev->ctx, false, NULL, &dev->device, 3);
+   if (FAILED(hr)) {
+      _debug_printf("d3d9umd: creating the nine device failed: 0x%08lx\n", (unsigned long)hr);
+      FREE(dev);
+      return NULL;
+   }
+   /* virgl turns an uploaded buffer in constant buffer slot 0 into a UBO, which the host's shaders don't read */
+   dev->device->driver_caps.user_constbufs = true;
+   return dev;
+}
+
+void
+nddi_device_destroy(struct nddi_device *dev)
+{
+   if (!dev)
+      return;
+   NineUnknown_Release(NineUnknown(dev->device));
+   FREE(dev);
+}
+
+/* ---- Resources ---- */
+
+static struct NineSurface9 *
+nddi_surface(struct nddi_resource *res, unsigned subresource)
+{
+   if (res->sysmem)
+      return subresource < res->subresource_count ? res->sysmem[subresource] : NULL;
+   switch (res->kind) {
+   case NDDI_SURFACE:
+   case NDDI_RENDER_TARGET:
+   case NDDI_DEPTH_STENCIL:
+      return subresource == 0 ? NineSurface9(res->obj) : NULL;
+   case NDDI_TEXTURE:
+      return subresource < res->levels ? NineTexture9(res->obj)->surfaces[subresource] : NULL;
+   case NDDI_CUBE_TEXTURE: {
+      /* DDI subresources are face-major (all levels of +X, then -X, ...); nine stores level-major */
+      unsigned face = subresource / res->levels, level = subresource % res->levels;
+      return face < 6 ? NineCubeTexture9(res->obj)->surfaces[face + 6 * level] : NULL;
+   }
+   default:
+      return NULL;
+   }
+}
+
+static int32_t
+nddi_create_sysmem(struct nddi_device *dev, const struct nddi_resource_desc *desc, struct nddi_resource *res)
+{
+   if (desc->kind == NDDI_VERTEX_BUFFER || desc->kind == NDDI_INDEX_BUFFER) {
+      /* A system memory buffer on the runtime's memory. DYNAMIC makes nine upload the range each draw uses: the
+       * runtime writes this memory directly (its DrawPrimitiveUP buffer, for one) */
+      void *obj = NULL;
+      HRESULT hr;
+      if (desc->kind == NDDI_VERTEX_BUFFER)
+         hr = NineDevice9_CreateVertexBuffer(dev->device, desc->width, desc->usage | D3DUSAGE_DYNAMIC, desc->fvf,
+                                             D3DPOOL_SYSTEMMEM, (IDirect3DVertexBuffer9 **)&obj, NULL);
+      else
+         hr = NineDevice9_CreateIndexBuffer(dev->device, desc->width, desc->usage | D3DUSAGE_DYNAMIC,
+                                            (D3DFORMAT)desc->format, D3DPOOL_SYSTEMMEM,
+                                            (IDirect3DIndexBuffer9 **)&obj, NULL);
+      if (FAILED(hr))
+         return hr;
+      NineBuffer9_SetExternalMemory(NineBuffer9(obj), desc->sysmem[0]);
+      res->obj = obj;
+      return D3D_OK;
+   }
+   if (desc->kind == NDDI_VOLUME_TEXTURE) {
+      _debug_printf("d3d9umd: system memory volume textures aren't supported yet\n");
+      return D3DERR_INVALIDCALL;
+   }
+   unsigned faces = desc->kind == NDDI_CUBE_TEXTURE ? 6 : 1;
+   unsigned levels = desc->kind == NDDI_TEXTURE || desc->kind == NDDI_CUBE_TEXTURE ? desc->levels : 1;
+   res->subresource_count = faces * levels;
+   res->sysmem = CALLOC(res->subresource_count, sizeof(*res->sysmem));
+   if (!res->sysmem)
+      return E_OUTOFMEMORY;
+
+   for (unsigned i = 0; i < res->subresource_count; i++) {
+      unsigned level = i % levels;
+      D3DSURFACE_DESC sd;
+      memset(&sd, 0, sizeof(sd));
+      sd.Format = (D3DFORMAT)desc->format;
+      sd.Type = D3DRTYPE_SURFACE;
+      sd.Pool = D3DPOOL_SYSTEMMEM;
+      sd.MultiSampleType = D3DMULTISAMPLE_NONE;
+      sd.Width = MAX2(desc->width >> level, 1);
+      sd.Height = MAX2(desc->height >> level, 1);
+      struct nine_allocation *memory = nine_wrap_external_pointer(dev->device->allocator, desc->sysmem[i]);
+      HRESULT hr = NineSurface9_new(dev->device, NULL, NULL, memory, D3DRTYPE_SURFACE, 0, 0, &sd, &res->sysmem[i]);
+      if (FAILED(hr))
+         return hr;
+      if (res->sysmem[i]->stride != desc->sysmem_pitch[i])
+         _debug_printf("d3d9umd: system memory pitch %u differs from nine's %u (format %u, width %u)\n",
+                       desc->sysmem_pitch[i], res->sysmem[i]->stride, desc->format, sd.Width);
+   }
+   return D3D_OK;
+}
+
+int32_t
+nddi_resource_create(struct nddi_device *dev, const struct nddi_resource_desc *desc, struct nddi_resource **out)
+{
+   struct nddi_resource *res = CALLOC_STRUCT(nddi_resource);
+   if (!res)
+      return E_OUTOFMEMORY;
+   res->dev = dev;
+   res->kind = desc->kind;
+   res->levels = MAX2(desc->levels, 1);
+   res->subresource_count = 1;
+
+   struct NineDevice9 *d = dev->device;
+   D3DFORMAT format = (D3DFORMAT)desc->format;
+   void *obj = NULL;
+   HRESULT hr;
+   if (desc->system_memory) {
+      hr = nddi_create_sysmem(dev, desc, res);
+   } else {
+      switch (desc->kind) {
+      case NDDI_SURFACE:
+         hr = NineDevice9_CreateOffscreenPlainSurface(d, desc->width, desc->height, format, D3DPOOL_DEFAULT,
+                                                      (IDirect3DSurface9 **)&obj, NULL);
+         break;
+      case NDDI_RENDER_TARGET:
+         hr = NineDevice9_CreateRenderTarget(d, desc->width, desc->height, format,
+                                             (D3DMULTISAMPLE_TYPE)desc->multisample, desc->multisample_quality,
+                                             desc->lockable, (IDirect3DSurface9 **)&obj, NULL);
+         break;
+      case NDDI_DEPTH_STENCIL:
+         hr = NineDevice9_CreateDepthStencilSurface(d, desc->width, desc->height, format,
+                                                    (D3DMULTISAMPLE_TYPE)desc->multisample,
+                                                    desc->multisample_quality, FALSE, (IDirect3DSurface9 **)&obj,
+                                                    NULL);
+         break;
+      case NDDI_TEXTURE:
+         hr = NineDevice9_CreateTexture(d, desc->width, desc->height, res->levels, desc->usage, format,
+                                        D3DPOOL_DEFAULT, (IDirect3DTexture9 **)&obj, NULL);
+         res->subresource_count = res->levels;
+         break;
+      case NDDI_CUBE_TEXTURE:
+         hr = NineDevice9_CreateCubeTexture(d, desc->width, res->levels, desc->usage, format, D3DPOOL_DEFAULT,
+                                            (IDirect3DCubeTexture9 **)&obj, NULL);
+         res->subresource_count = res->levels * 6;
+         break;
+      case NDDI_VOLUME_TEXTURE:
+         hr = NineDevice9_CreateVolumeTexture(d, desc->width, desc->height, desc->depth, res->levels, desc->usage,
+                                              format, D3DPOOL_DEFAULT, (IDirect3DVolumeTexture9 **)&obj, NULL);
+         res->subresource_count = res->levels;
+         break;
+      case NDDI_VERTEX_BUFFER:
+         hr = NineDevice9_CreateVertexBuffer(d, desc->width, desc->usage, desc->fvf, D3DPOOL_DEFAULT,
+                                             (IDirect3DVertexBuffer9 **)&obj, NULL);
+         break;
+      case NDDI_INDEX_BUFFER:
+         hr = NineDevice9_CreateIndexBuffer(d, desc->width, desc->usage, format, D3DPOOL_DEFAULT,
+                                            (IDirect3DIndexBuffer9 **)&obj, NULL);
+         break;
+      default:
+         hr = D3DERR_INVALIDCALL;
+      }
+      res->obj = obj;
+   }
+   if (FAILED(hr)) {
+      nddi_resource_destroy(res);
+      return hr;
+   }
+   *out = res;
+   return D3D_OK;
+}
+
+void
+nddi_resource_destroy(struct nddi_resource *res)
+{
+   if (!res)
+      return;
+   if (res->sysmem) {
+      for (unsigned i = 0; i < res->subresource_count; i++) {
+         if (res->sysmem[i])
+            NineUnknown_Release(NineUnknown(res->sysmem[i]));
+      }
+      FREE(res->sysmem);
+   }
+   if (res->obj)
+      NineUnknown_Release(res->obj);
+   FREE(res);
+}
+
+struct pipe_resource *
+nddi_resource_get_pipe(struct nddi_resource *res, unsigned subresource, unsigned *level, unsigned *layer)
+{
+   struct NineSurface9 *surf = nddi_surface(res, subresource);
+   if (!surf)
+      return NULL;
+   *level = surf->level;
+   *layer = surf->layer;
+   return surf->base.resource;
+}
+
+int32_t
+nddi_resource_lock(struct nddi_resource *res, unsigned subresource, const struct nddi_box *box, uint32_t flags,
+                   void **data, uint32_t *pitch, uint32_t *slice_pitch)
+{
+   *slice_pitch = 0;
+   switch (res->kind) {
+   case NDDI_VERTEX_BUFFER:
+   case NDDI_INDEX_BUFFER: {
+      /* For buffers the box's left/right are a byte range */
+      UINT offset = box ? box->left : 0, size = box ? box->right - box->left : 0;
+      *pitch = 0;
+      if (res->kind == NDDI_VERTEX_BUFFER)
+         return NineVertexBuffer9_Lock((struct NineVertexBuffer9 *)res->obj, offset, size, data, flags);
+      return NineIndexBuffer9_Lock((struct NineIndexBuffer9 *)res->obj, offset, size, data, flags);
+   }
+   case NDDI_VOLUME_TEXTURE: {
+      D3DLOCKED_BOX locked;
+      D3DBOX b;
+      if (box) {
+         b.Left = box->left; b.Top = box->top; b.Right = box->right;
+         b.Bottom = box->bottom; b.Front = box->front; b.Back = box->back;
+      }
+      HRESULT hr = NineVolumeTexture9_LockBox(NineVolumeTexture9(res->obj), subresource, &locked, box ? &b : NULL,
+                                              flags);
+      if (SUCCEEDED(hr)) {
+         *data = locked.pBits;
+         *pitch = locked.RowPitch;
+         *slice_pitch = locked.SlicePitch;
+      }
+      return hr;
+   }
+   default: {
+      struct NineSurface9 *surf = nddi_surface(res, subresource);
+      if (!surf)
+         return D3DERR_INVALIDCALL;
+      D3DLOCKED_RECT locked;
+      RECT r;
+      if (box) {
+         r.left = box->left; r.top = box->top; r.right = box->right; r.bottom = box->bottom;
+      }
+      HRESULT hr = NineSurface9_LockRect(surf, &locked, box ? &r : NULL, flags);
+      if (SUCCEEDED(hr)) {
+         *data = locked.pBits;
+         *pitch = locked.Pitch;
+      }
+      return hr;
+   }
+   }
+}
+
+int32_t
+nddi_resource_unlock(struct nddi_resource *res, unsigned subresource)
+{
+   switch (res->kind) {
+   case NDDI_VERTEX_BUFFER:
+      return NineVertexBuffer9_Unlock((struct NineVertexBuffer9 *)res->obj);
+   case NDDI_INDEX_BUFFER:
+      return NineIndexBuffer9_Unlock((struct NineIndexBuffer9 *)res->obj);
+   case NDDI_VOLUME_TEXTURE:
+      return NineVolumeTexture9_UnlockBox(NineVolumeTexture9(res->obj), subresource);
+   default: {
+      struct NineSurface9 *surf = nddi_surface(res, subresource);
+      return surf ? NineSurface9_UnlockRect(surf) : D3DERR_INVALIDCALL;
+   }
+   }
+}
+
+void
+nddi_resource_written(struct nddi_resource *res)
+{
+   /* System memory surfaces are read straight from the runtime's memory when used. System memory buffers are
+    * uploaded at draw time, for the range the draw needs, when nine's lock has invalidated them: lock them the same
+    * way. */
+   if ((res->kind != NDDI_VERTEX_BUFFER && res->kind != NDDI_INDEX_BUFFER) || !res->obj)
+      return;
+   struct NineBuffer9 *buf = NineBuffer9(res->obj);
+   if (buf->base.pool != D3DPOOL_SYSTEMMEM)
+      return;
+   void *data;
+   if (SUCCEEDED(NineBuffer9_Lock(buf, 0, 0, &data, 0)))
+      NineBuffer9_Unlock(buf);
+}
+
+static bool
+nddi_rect_is_whole(const struct nddi_rect *r, const struct NineSurface9 *surf)
+{
+   return r->left == 0 && r->top == 0 && (UINT)r->right == surf->desc.Width && (UINT)r->bottom == surf->desc.Height;
+}
+
+/* CPU copy of a rectangle between two lockable surfaces of the same format */
+static HRESULT
+nddi_copy_locked(struct NineSurface9 *src, const RECT *src_rect, struct NineSurface9 *dst, const RECT *dst_rect)
+{
+   D3DLOCKED_RECT s, d;
+   HRESULT hr = NineSurface9_LockRect(src, &s, src_rect, D3DLOCK_READONLY);
+   if (FAILED(hr))
+      return hr;
+   hr = NineSurface9_LockRect(dst, &d, dst_rect, 0);
+   if (FAILED(hr)) {
+      NineSurface9_UnlockRect(src);
+      return hr;
+   }
+   unsigned rows = util_format_get_nblocksy(src->base.info.format, src_rect->bottom - src_rect->top);
+   unsigned row_bytes = util_format_get_stride(src->base.info.format, src_rect->right - src_rect->left);
+   for (unsigned y = 0; y < rows; y++)
+      memcpy((uint8_t *)d.pBits + y * d.Pitch, (const uint8_t *)s.pBits + y * s.Pitch, row_bytes);
+   NineSurface9_UnlockRect(dst);
+   NineSurface9_UnlockRect(src);
+   return D3D_OK;
+}
+
+int32_t
+nddi_blt(struct nddi_device *dev, struct nddi_resource *src, unsigned src_sub, const struct nddi_rect *src_rect,
+         struct nddi_resource *dst, unsigned dst_sub, const struct nddi_rect *dst_rect, uint32_t filter)
+{
+   struct NineSurface9 *s = nddi_surface(src, src_sub), *d = nddi_surface(dst, dst_sub);
+   if (!s || !d)
+      return D3DERR_INVALIDCALL;
+   RECT sr = {src_rect->left, src_rect->top, src_rect->right, src_rect->bottom};
+   RECT dr = {dst_rect->left, dst_rect->top, dst_rect->right, dst_rect->bottom};
+   bool src_sys = s->desc.Pool == D3DPOOL_SYSTEMMEM, dst_sys = d->desc.Pool == D3DPOOL_SYSTEMMEM;
+   bool same_size = sr.right - sr.left == dr.right - dr.left && sr.bottom - sr.top == dr.bottom - dr.top;
+
+   if (src_sys && dst_sys)
+      return nddi_copy_locked(s, &sr, d, &dr);
+   if (src_sys) {
+      if (!same_size)
+         return D3DERR_INVALIDCALL;
+      POINT p = {dr.left, dr.top};
+      return NineDevice9_UpdateSurface(dev->device, (IDirect3DSurface9 *)s, &sr, (IDirect3DSurface9 *)d, &p);
+   }
+   if (dst_sys) {
+      if (!same_size)
+         return D3DERR_INVALIDCALL;
+      if ((s->desc.Usage & D3DUSAGE_RENDERTARGET) && nddi_rect_is_whole(src_rect, s) &&
+          nddi_rect_is_whole(dst_rect, d))
+         return NineDevice9_GetRenderTargetData(dev->device, (IDirect3DSurface9 *)s, (IDirect3DSurface9 *)d);
+      return nddi_copy_locked(s, &sr, d, &dr);
+   }
+   return NineDevice9_StretchRect(dev->device, (IDirect3DSurface9 *)s, &sr, (IDirect3DSurface9 *)d, &dr,
+                                  (D3DTEXTUREFILTERTYPE)filter);
+}
+
+int32_t
