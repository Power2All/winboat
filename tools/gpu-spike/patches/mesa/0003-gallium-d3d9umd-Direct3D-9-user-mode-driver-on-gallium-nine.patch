diff --git a/src/gallium/frontends/d3d9umd/debug.cpp b/src/gallium/frontends/d3d9umd/debug.cpp
new file mode 100644
index 0000000..3de5586
--- /dev/null
+++ b/src/gallium/frontends/d3d9umd/debug.cpp
@@ -0,0 +1,127 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "d3d9umd.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+/* Full call tracing is for development: create C:\viogpu_d3d9_trace.txt and every process using the driver appends
+ * its calls to C:\viogpu_d3d9_trace.log. Warnings always go to OutputDebugString. */
+static int tracing = -1;
+
+bool
+D3D9UmdTracing(void)
+{
+   if (tracing < 0)
+      tracing = GetFileAttributesA("C:\\viogpu_d3d9_trace.txt") != INVALID_FILE_ATTRIBUTES;
+   return tracing > 0;
+}
+
+static void
+LogV(bool debugger, const char *format, va_list args)
+{
+   char message[1024];
+   int prefix = snprintf(message, sizeof(message), "d3d9umd[%lu]: ", GetCurrentProcessId());
+   vsnprintf(message + prefix, sizeof(message) - prefix - 1, format, args);
+   size_t len = strlen(message);
+   if (len == 0 || message[len - 1] != '\n') {
+      message[len] = '\n';
+      message[len + 1] = '\0';
+   }
+   if (debugger)
+      OutputDebugStringA(message);
+   if (D3D9UmdTracing()) {
+      FILE *f = fopen("C:\\viogpu_d3d9_trace.log", "a");
+      if (f) {
+         fputs(message, f);
+         fclose(f);
+      }
+   }
+}
+
+/* Warnings: the debugger (and the trace) */
+void
+D3D9UmdLog(const char *format, ...)
+{
+   va_list args;
+   va_start(args, format);
+   LogV(true, format, args);
+   va_end(args);
+}
+
+/* Call tracing: only the trace file, so that the debugger output keeps what matters (the messages of gallium nine
+ * and virgl among them) */
+void
+D3D9UmdTraceLog(const char *format, ...)
+{
+   va_list args;
+   va_start(args, format);
+   LogV(false, format, args);
+   va_end(args);
+}
+
+/* "module+offset" for an address, to look up in the linker map */
+static void
+DescribeAddress(const void *address, char *out, size_t size)
+{
+   HMODULE module = NULL;
+   char path[MAX_PATH] = "?";
+   if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                          (LPCSTR)address, &module)) {
+      GetModuleFileNameA(module, path, sizeof(path));
+   }
+   const char *name = strrchr(path, '\\');
+   snprintf(out, size, "%s+0x%llx", name ? name + 1 : path,
+            (unsigned long long)((const char *)address - (const char *)module));
+}
+
+static LONG CALLBACK
+CrashHandler(EXCEPTION_POINTERS *info)
+{
+   DWORD code = info->ExceptionRecord->ExceptionCode;
+   if (code != EXCEPTION_ACCESS_VIOLATION && code != EXCEPTION_ILLEGAL_INSTRUCTION &&
+       code != EXCEPTION_INT_DIVIDE_BY_ZERO && code != EXCEPTION_STACK_OVERFLOW && code != EXCEPTION_PRIV_INSTRUCTION)
+      return EXCEPTION_CONTINUE_SEARCH;
+   char where[MAX_PATH + 32];
+   DescribeAddress(info->ExceptionRecord->ExceptionAddress, where, sizeof(where));
+   D3D9UmdLog("exception 0x%08lx at %s (address 0x%llx)", code, where,
+              code == EXCEPTION_ACCESS_VIOLATION
+                 ? (unsigned long long)info->ExceptionRecord->ExceptionInformation[1] : 0ull);
+   void *frames[32];
+   USHORT count = RtlCaptureStackBackTrace(0, ARRAYSIZE(frames), frames, NULL);
+   for (USHORT i = 0; i < count; i++) {
+      DescribeAddress(frames[i], where, sizeof(where));
+      D3D9UmdLog("  #%u %s", i, where);
+   }
+   return EXCEPTION_CONTINUE_SEARCH;
+}
+
+void
+D3D9UmdInstallCrashHandler(void)
+{
+   static bool installed;
+   if (!installed && D3D9UmdTracing()) {
+      installed = true;
+      AddVectoredExceptionHandler(1, CrashHandler);
+   }
+}
+
+HRESULT
+D3D9UmdUnimplemented(const char *name)
+{
+   /* Log each entry point once (a small fixed set; the names are string literals) */
+   static const char *seen[160];
+   static unsigned seenCount;
+   for (unsigned i = 0; i < seenCount; i++) {
+      if (seen[i] == name)
+         return S_OK;
+   }
+   if (seenCount < ARRAYSIZE(seen))
+      seen[seenCount++] = name;
+   D3D9UmdLog("unimplemented: %s", name);
+   return S_OK;
+}
