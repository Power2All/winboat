+/* ---- Shaders and vertex declarations ---- */
+
+static int32_t
+wrap_object(HRESULT hr, void *obj, struct nddi_object **out)
+{
+   if (FAILED(hr))
+      return hr;
+   struct nddi_object *o = CALLOC_STRUCT(nddi_object);
+   if (!o) {
+      NineUnknown_Release(NineUnknown(obj));
+      return E_OUTOFMEMORY;
+   }
+   o->obj = NineUnknown(obj);
+   *out = o;
+   return D3D_OK;
+}
+
+void
+nddi_object_destroy(struct nddi_object *obj)
+{
+   if (!obj)
+      return;
+   NineUnknown_Release(obj->obj);
+   FREE(obj);
+}
+
+int32_t
+nddi_create_vertex_declaration(struct nddi_device *dev, const struct nddi_vertex_element *elements, uint32_t count,
+                               struct nddi_object **out)
+{
+   static_assert(sizeof(struct nddi_vertex_element) == sizeof(D3DVERTEXELEMENT9), "vertex element layout");
+   D3DVERTEXELEMENT9 *e = MALLOC((count + 1) * sizeof(*e));
+   if (!e)
+      return E_OUTOFMEMORY;
+   memcpy(e, elements, count * sizeof(*e));
+   /* The DDI passes a count, the API an end marker */
+   const D3DVERTEXELEMENT9 end = D3DDECL_END();
+   e[count] = end;
+   void *decl = NULL;
+   HRESULT hr = NineDevice9_CreateVertexDeclaration(dev->device, e, (IDirect3DVertexDeclaration9 **)&decl);
+   FREE(e);
+   return wrap_object(hr, decl, out);
+}
