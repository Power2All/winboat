+
+static unsigned
+vertex_count(uint32_t type, uint32_t count)
+{
+   switch (type) {
+   case D3DPT_POINTLIST: return count;
+   case D3DPT_LINELIST: return count * 2;
+   case D3DPT_LINESTRIP: return count + 1;
+   case D3DPT_TRIANGLELIST: return count * 3;
+   case D3DPT_TRIANGLESTRIP:
+   case D3DPT_TRIANGLEFAN: return count + 2;
+   default: return 0;
+   }
+}
+
+/* Uploads the user memory streams for vertices [first, first + count) and binds them. If every bound stream is in
+ * memory, only that range is uploaded and *rebase says by how many vertices the draw must shift (the uploaded data
+ * starts at vertex first). Otherwise the memory streams are uploaded from vertex 0 and *rebase is 0. Returns false if
+ * no stream is in memory. */
+static bool
+bind_memory_streams(struct nddi_device *dev, unsigned first, unsigned count, unsigned *rebase)
+{
+   struct NineDevice9 *d = dev->device;
+   bool any = false, all = true;
+   for (unsigned i = 0; i < NDDI_MAX_STREAMS && i < d->caps.MaxStreams; i++) {
+      if (dev->memory_stream[i].data)
+         any = true;
+      else if (d->state.stream[i])
+         all = false;
+   }
+   *rebase = 0;
+   if (!any)
+      return false;
+   unsigned start = all ? first : 0, num = all ? count : first + count;
+   for (unsigned i = 0; i < NDDI_MAX_STREAMS && i < d->caps.MaxStreams; i++) {
+      if (!dev->memory_stream[i].data)
+         continue;
+      unsigned stride = dev->memory_stream[i].stride;
+      /* stride 0: the same vertex for everything (instancing data); upload one */
+      unsigned size = stride ? num * stride : 256;
+      const uint8_t *data = (const uint8_t *)dev->memory_stream[i].data + (size_t)start * stride;
+      struct pipe_resource *res = NULL;
+      unsigned offset = 0;
+      u_upload_data(d->vertex_uploader, 0, size, 4, data, &offset, &res);
+      u_upload_unmap(d->vertex_uploader);
+      nine_context_set_stream_source_apply(d, i, res, offset, stride);
+      pipe_resource_reference(&res, NULL);
+   }
+   *rebase = start;
+   return true;
+}
+
+int32_t
+nddi_draw_primitive(struct nddi_device *dev, uint32_t type, uint32_t start_vertex, uint32_t count)
+{
+   unsigned rebase;
+   if (!count)
+      return D3D_OK;
+   bind_memory_streams(dev, start_vertex, vertex_count(type, count), &rebase);
+   return NineDevice9_DrawPrimitive(dev->device, (D3DPRIMITIVETYPE)type, start_vertex - rebase, count);
+}
+
+int32_t
+nddi_draw_indexed_primitive(struct nddi_device *dev, uint32_t type, int32_t base_vertex, uint32_t min_index,
+                            uint32_t num_vertices, uint32_t start_index, uint32_t count)
+{
+   struct NineDevice9 *d = dev->device;
+   unsigned rebase;
+   if (!count)
+      return D3D_OK;
+   /* The vertices an index i refers to are base_vertex + i; uploading from vertex base_vertex + min_index means
+    * the draw's base moves down by as much */
+   if (bind_memory_streams(dev, (unsigned)(base_vertex + (int32_t)min_index), num_vertices, &rebase))
+      base_vertex -= (int32_t)rebase;
+
+   if (!dev->memory_indices)
+      return NineDevice9_DrawIndexedPrimitive(d, (D3DPRIMITIVETYPE)type, base_vertex, min_index, num_vertices,
+                                              start_index, count);
+
+   /* User memory indices: upload the ones this draw uses and draw from them directly */
+   unsigned size = vertex_count(type, count) * dev->memory_index_size;
+   const uint8_t *indices = (const uint8_t *)dev->memory_indices + (size_t)start_index * dev->memory_index_size;
+   struct pipe_resource *res = NULL;
+   unsigned offset = 0;
+   u_upload_data(d->pipe_secondary->stream_uploader, 0, size, 4, indices, &offset, &res);
+   u_upload_unmap(d->pipe_secondary->stream_uploader);
+   nine_context_set_indices_apply(d, res, dev->memory_index_size, offset);
+   pipe_resource_reference(&res, NULL);
+   NineBeforeDraw(d);
+   nine_context_draw_indexed_primitive(d, (D3DPRIMITIVETYPE)type, base_vertex, min_index, num_vertices, 0, count);
+   NineAfterDraw(d);
+   /* Put back the index buffer the API state has */
+   NineDevice9_SetIndices(d, (IDirect3DIndexBuffer9 *)d->state.idxbuf);
+   return D3D_OK;
+}
