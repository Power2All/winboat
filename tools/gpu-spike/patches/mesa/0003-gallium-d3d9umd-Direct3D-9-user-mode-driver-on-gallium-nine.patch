+/* ---- Fixed function ---- */
+
+int32_t
+nddi_set_transform(struct nddi_device *dev, uint32_t type, const float *matrix, bool multiply)
+{
+   return multiply ? NineDevice9_MultiplyTransform(dev->device, (D3DTRANSFORMSTATETYPE)type, (const D3DMATRIX *)matrix)
+                   : NineDevice9_SetTransform(dev->device, (D3DTRANSFORMSTATETYPE)type, (const D3DMATRIX *)matrix);
+}
+
+int32_t
+nddi_set_material(struct nddi_device *dev, const void *material)
+{
+   return NineDevice9_SetMaterial(dev->device, (const D3DMATERIAL9 *)material);
+}
+
+int32_t
+nddi_set_light(struct nddi_device *dev, uint32_t index, const void *light)
+{
+   return NineDevice9_SetLight(dev->device, index, (const D3DLIGHT9 *)light);
+}
+
+int32_t
+nddi_light_enable(struct nddi_device *dev, uint32_t index, bool enable)
+{
+   return NineDevice9_LightEnable(dev->device, index, enable);
+}
+
+int32_t
+nddi_set_clip_plane(struct nddi_device *dev, uint32_t index, const float *plane)
+{
+   return NineDevice9_SetClipPlane(dev->device, index, plane);
+}
+
+/* ---- Queries ---- */
+
+int32_t
+nddi_create_query(struct nddi_device *dev, uint32_t type, struct nddi_object **out)
+{
+   void *query = NULL;
+   HRESULT hr = NineDevice9_CreateQuery(dev->device, (D3DQUERYTYPE)type, (IDirect3DQuery9 **)&query);
+   return wrap_object(hr, query, out);
+}
+
+int32_t
+nddi_issue_query(struct nddi_object *query, uint32_t flags)
+{
+   return NineQuery9_Issue((struct NineQuery9 *)query->obj, flags);
+}
+
+int32_t
+nddi_get_query_data(struct nddi_object *query, void *data, uint32_t size)
+{
+   return NineQuery9_GetData((struct NineQuery9 *)query->obj, data, size, D3DGETDATA_FLUSH);
+}
+
+uint32_t
+nddi_get_query_data_size(struct nddi_object *query)
+{
+   return NineQuery9_GetDataSize((struct NineQuery9 *)query->obj);
+}
+
+/* ---- Development tracing ---- */
+
+/* The draw state nine has: shaders, declaration, vertex constants and the first vertex of the first streams */
+void
+nddi_debug_draw_state(struct nddi_device *dev, void (*log)(const char *format, ...))
+{
+   struct NineDevice9 *d = dev->device;
+   struct NineVertexDeclaration9 *vdecl = d->state.vdecl;
+   log("  draw state: vs %p ps %p vdecl %p (%u elements)", d->state.vs, d->state.ps, vdecl,
+       vdecl ? vdecl->nelems : 0);
+   for (unsigned i = 0; vdecl && i < vdecl->nelems; i++) {
+      const D3DVERTEXELEMENT9 *e = &vdecl->decls[i];
+      log("    element %u: stream %u offset %u type %u usage %u/%u", i, e->Stream, e->Offset, e->Type, e->Usage,
+          e->UsageIndex);
+   }
+   const struct nine_context *c = &d->context;
+   log("    vs constants: used size %u, ranges %p, swvp %d, programmable %d, c3 %g %g %g %g, c6 %g %g %g %g "
+       "(state c3 %g, c6.w %g)", c->cso_shader.vs_const_used_size, (void *)c->cso_shader.vs_const_ranges, c->swvp,
+       c->programmable_vs, c->vs_const_f[12], c->vs_const_f[13], c->vs_const_f[14], c->vs_const_f[15],
+       c->vs_const_f[24], c->vs_const_f[25], c->vs_const_f[26], c->vs_const_f[27], d->state.vs_const_f[12],
+       d->state.vs_const_f[27]);
+   if (d->state.vs) {
+      struct NineVertexShader9 *vs = d->state.vs;
+      log("    vs object: context vs %p, last key 0x%llx next 0x%llx, last used size %u, variant used size %u, "
+          "position_t %d swvp_only %d, cso %p (context cso %p)", c->vs, (unsigned long long)vs->last_key,
+          (unsigned long long)vs->next_key, vs->last_const_used_size, vs->variant.const_used_size, vs->position_t,
+          vs->swvp_only, vs->last_cso, c->cso_shader.vs);
+   }
+   for (unsigned i = 0; i < 2; i++) {
+      struct NineVertexBuffer9 *vb = d->state.stream[i];
+      if (!vb)
+         continue;
+      struct NineBuffer9 *b = &vb->base;
+      const float *f = b->managed.data ? (const float *)((const uint8_t *)b->managed.data +
+                                                         d->state.vtxbuf[i].buffer_offset) : NULL;
+      log("    stream %u: %p pool %u usage 0x%x size %u offset %u stride %u: %g %g %g %08x", i, vb, b->base.pool,
+          b->base.usage, b->size, d->state.vtxbuf[i].buffer_offset, d->state.vtxstride[i], f ? f[0] : 0.f,
+          f ? f[1] : 0.f, f ? f[2] : 0.f, f ? ((const uint32_t *)f)[3] : 0);
+   }
+}
diff --git a/src/gallium/frontends/d3d9umd/pipeline.cpp b/src/gallium/frontends/d3d9umd/pipeline.cpp
new file mode 100644
index 0000000..3c5a150
--- /dev/null
+++ b/src/gallium/frontends/d3d9umd/pipeline.cpp
@@ -0,0 +1,497 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Drawing: vertex/index sources, draws, shaders and declarations, constants, textures, samplers, fixed-function
+ * state and queries. Shaders, declarations and queries are nddi_objects, used directly as the DDI handles. */
+
+#include "d3d9umd.h"
+
+#include <stdio.h>
+#include <string.h>
+
+static inline nddi_object *
+Obj(HANDLE h)
+{
+   return (nddi_object *)h;
+}
+
+/* ---- Vertex and index data ---- */
+
+static HRESULT APIENTRY
+SetStreamSource(HANDLE hDevice, const D3DDDIARG_SETSTREAMSOURCE *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   D3D9UmdResource *vb = D3D9UmdCastResource(p->hVertexBuffer);
+   if (p->Stream < ARRAYSIZE(dev->streamStride))
+      dev->streamStride[p->Stream] = p->Stride;
+   D3D9UMD_TRACE("SetStreamSource %u = %p offset %u stride %u", p->Stream, vb, p->Offset, p->Stride);
+   return nddi_set_stream_source(dev->nine, p->Stream, vb ? vb->nine : NULL, p->Offset, p->Stride);
+}
+
+static HRESULT APIENTRY
+SetStreamSourceUm(HANDLE hDevice, const D3DDDIARG_SETSTREAMSOURCEUM *p, const VOID *pUMBuffer)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   if (p->Stream < ARRAYSIZE(dev->streamStride))
+      dev->streamStride[p->Stream] = p->Stride;
+   D3D9UMD_TRACE("SetStreamSourceUm %u = %p stride %u", p->Stream, pUMBuffer, p->Stride);
+   return nddi_set_stream_source_memory(dev->nine, p->Stream, pUMBuffer, p->Stride);
+}
+
+static HRESULT APIENTRY
+SetStreamSourceFreq(HANDLE hDevice, const D3DDDIARG_SETSTREAMSOURCEFREQ *p)
+{
+   return nddi_set_stream_source_freq(D3D9UmdCastDevice(hDevice)->nine, p->Stream, p->Divider);
+}
+
+static HRESULT APIENTRY
+SetIndices(HANDLE hDevice, const D3DDDIARG_SETINDICES *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   dev->indexBuffer = D3D9UmdCastResource(p->hIndexBuffer);
+   dev->memoryIndices = NULL;
+   return nddi_set_indices(dev->nine, dev->indexBuffer ? dev->indexBuffer->nine : NULL);
+}
+
+static HRESULT APIENTRY
+SetIndicesUm(HANDLE hDevice, UINT IndexSize, const VOID *pIndexBuffer)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   dev->memoryIndices = pIndexBuffer;
+   dev->memoryIndexSize = IndexSize;
+   return nddi_set_indices_memory(dev->nine, pIndexBuffer, IndexSize);
+}
+
+/* ---- Draws ---- */
+
+static HRESULT APIENTRY
+DrawPrimitive(HANDLE hDevice, const D3DDDIARG_DRAWPRIMITIVE *p, const UINT *pFlagBuffer)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   HRESULT hr = nddi_draw_primitive(dev->nine, p->PrimitiveType, p->VStart, p->PrimitiveCount);
+   D3D9UMD_TRACE("DrawPrimitive type %u start %u count %u -> 0x%08lx", p->PrimitiveType, p->VStart,
+                 p->PrimitiveCount, hr);
+   if (D3D9UmdTracing())
+      nddi_debug_draw_state(dev->nine, D3D9UmdTraceLog);
+   return hr;
+}
+
+static HRESULT APIENTRY
+DrawIndexedPrimitive(HANDLE hDevice, const D3DDDIARG_DRAWINDEXEDPRIMITIVE *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   HRESULT hr = nddi_draw_indexed_primitive(dev->nine, p->PrimitiveType, p->BaseVertexIndex, p->MinIndex,
+                                            p->NumVertices, p->StartIndex, p->PrimitiveCount);
+   D3D9UMD_TRACE("DrawIndexedPrimitive type %u base %d min %u num %u start %u count %u -> 0x%08lx",
+                 p->PrimitiveType, p->BaseVertexIndex, p->MinIndex, p->NumVertices, p->StartIndex,
+                 p->PrimitiveCount, hr);
+   return hr;
+}
+
+/* Stream 0 is user memory; the first vertex is a byte offset into it */
+static HRESULT APIENTRY
+DrawPrimitive2(HANDLE hDevice, const D3DDDIARG_DRAWPRIMITIVE2 *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   UINT stride = dev->streamStride[0];
+   UINT start = stride ? p->FirstVertexOffset / stride : 0;
+   HRESULT hr = nddi_draw_primitive(dev->nine, p->PrimitiveType, start, p->PrimitiveCount);
+   D3D9UMD_TRACE("DrawPrimitive2 type %u offset %u count %u -> 0x%08lx", p->PrimitiveType, p->FirstVertexOffset,
+                 p->PrimitiveCount, hr);
+   if (D3D9UmdTracing())
+      nddi_debug_draw_state(dev->nine, D3D9UmdTraceLog);
+   return hr;
+}
+
+/* Indices come with the call; the base vertex and first index are byte offsets */
+static HRESULT APIENTRY
+DrawIndexedPrimitive2(HANDLE hDevice, const D3DDDIARG_DRAWINDEXEDPRIMITIVE2 *p, UINT dwIndicesSize,
+                      const VOID *pIndexBuffer, const UINT *pFlagBuffer)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   UINT stride = dev->streamStride[0];
+   INT base = stride ? p->BaseVertexOffset / (INT)stride : 0;
+   nddi_set_indices_memory(dev->nine, (const BYTE *)pIndexBuffer + p->StartIndexOffset, dwIndicesSize);
+   HRESULT hr = nddi_draw_indexed_primitive(dev->nine, p->PrimitiveType, base, p->MinIndex, p->NumVertices, 0,
+                                            p->PrimitiveCount);
+   /* Back to the device's own index source */
+   if (dev->memoryIndices)
+      nddi_set_indices_memory(dev->nine, dev->memoryIndices, dev->memoryIndexSize);
+   else
+      nddi_set_indices(dev->nine, dev->indexBuffer ? dev->indexBuffer->nine : NULL);
+   D3D9UMD_TRACE("DrawIndexedPrimitive2 type %u base %d min %u num %u count %u -> 0x%08lx", p->PrimitiveType,
+                 p->BaseVertexOffset, p->MinIndex, p->NumVertices, p->PrimitiveCount, hr);
+   return hr;
+}
+
+/* ---- Vertex declarations and shaders ---- */
+
+static HRESULT APIENTRY
+CreateVertexShaderDecl(HANDLE hDevice, D3DDDIARG_CREATEVERTEXSHADERDECL *p, const D3DDDIVERTEXELEMENT *pElements)
+{
+   static_assert(sizeof(D3DDDIVERTEXELEMENT) == sizeof(nddi_vertex_element), "vertex element layout");
+   nddi_object *decl = NULL;
+   HRESULT hr = nddi_create_vertex_declaration(D3D9UmdCastDevice(hDevice)->nine,
+                                               (const nddi_vertex_element *)pElements, p->NumVertexElements, &decl);
+   D3D9UMD_TRACE("CreateVertexShaderDecl %u elements -> 0x%08lx", p->NumVertexElements, hr);
+   p->ShaderHandle = decl;
+   return hr;
+}
+
+static HRESULT APIENTRY
+SetVertexShaderDecl(HANDLE hDevice, HANDLE hShader)
+{
+   D3D9UMD_TRACE("SetVertexShaderDecl %p", hShader);
+   return nddi_set_vertex_declaration(D3D9UmdCastDevice(hDevice)->nine, Obj(hShader));
+}
+
+static HRESULT APIENTRY
+DeleteVertexShaderDecl(HANDLE hDevice, HANDLE hShader)
+{
+   nddi_object_destroy(Obj(hShader));
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+CreateVertexShaderFunc(HANDLE hDevice, D3DDDIARG_CREATEVERTEXSHADERFUNC *p, const UINT *pCode)
+{
+   nddi_object *shader = NULL;
+   HRESULT hr = nddi_create_vertex_shader(D3D9UmdCastDevice(hDevice)->nine, (const uint32_t *)pCode, &shader);
+   D3D9UMD_TRACE("CreateVertexShaderFunc %u bytes -> 0x%08lx", p->Size, hr);
+   if (D3D9UmdTracing()) {
+      for (UINT i = 0; i < p->Size / 4; i += 8) {
+         char line[128];
+         int n = 0;
+         for (UINT j = i; j < i + 8 && j < p->Size / 4; j++)
+            n += snprintf(line + n, sizeof(line) - n, " %08x", pCode[j]);
+         D3D9UmdTraceLog("  %s", line);
+      }
+   }
+   p->ShaderHandle = shader;
+   return hr;
+}
+
+static HRESULT APIENTRY
+SetVertexShaderFunc(HANDLE hDevice, HANDLE hShader)
+{
+   D3D9UMD_TRACE("SetVertexShaderFunc %p", hShader);
+   return nddi_set_vertex_shader(D3D9UmdCastDevice(hDevice)->nine, Obj(hShader));
+}
+
+static HRESULT APIENTRY
+DeleteVertexShaderFunc(HANDLE hDevice, HANDLE hShader)
+{
+   nddi_object_destroy(Obj(hShader));
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+CreatePixelShader(HANDLE hDevice, D3DDDIARG_CREATEPIXELSHADER *p, const UINT *pCode)
+{
+   nddi_object *shader = NULL;
+   HRESULT hr = nddi_create_pixel_shader(D3D9UmdCastDevice(hDevice)->nine, (const uint32_t *)pCode, &shader);
+   D3D9UMD_TRACE("CreatePixelShader %u bytes -> 0x%08lx", p->CodeSize, hr);
+   p->ShaderHandle = shader;
+   return hr;
+}
+
+static HRESULT APIENTRY
+SetPixelShader(HANDLE hDevice, HANDLE hShader)
+{
+   D3D9UMD_TRACE("SetPixelShader %p", hShader);
+   return nddi_set_pixel_shader(D3D9UmdCastDevice(hDevice)->nine, Obj(hShader));
+}
+
+static HRESULT APIENTRY
+DeletePixelShader(HANDLE hDevice, HANDLE hShader)
+{
+   nddi_object_destroy(Obj(hShader));
+   return S_OK;
+}
+
+/* ---- Shader constants ---- */
+
+static HRESULT APIENTRY
+SetVertexShaderConst(HANDLE hDevice, const D3DDDIARG_SETVERTEXSHADERCONST *p, const VOID *pData)
+{
+   const float *f = (const float *)pData;
+   D3D9UMD_TRACE("SetVertexShaderConst c%u x%u", p->Register, p->Count);
+   if (D3D9UmdTracing()) {
+      for (UINT i = 0; i < p->Count && i < 12; i++)
+         D3D9UmdTraceLog("  c%u = %g %g %g %g", p->Register + i, f[4 * i], f[4 * i + 1], f[4 * i + 2], f[4 * i + 3]);
+   }
+   return nddi_set_shader_constants_f(D3D9UmdCastDevice(hDevice)->nine, false, p->Register, (const float *)pData,
+                                      p->Count);
+}
+
+static HRESULT APIENTRY
+SetVertexShaderConstI(HANDLE hDevice, const D3DDDIARG_SETVERTEXSHADERCONSTI *p, const INT *pData)
+{
+   return nddi_set_shader_constants_i(D3D9UmdCastDevice(hDevice)->nine, false, p->Register,
+                                      (const int32_t *)pData, p->Count);
+}
+
+static HRESULT APIENTRY
+SetVertexShaderConstB(HANDLE hDevice, const D3DDDIARG_SETVERTEXSHADERCONSTB *p, const BOOL *pData)
+{
+   return nddi_set_shader_constants_b(D3D9UmdCastDevice(hDevice)->nine, false, p->Register,
+                                      (const int32_t *)pData, p->Count);
+}
+
+static HRESULT APIENTRY
+SetPixelShaderConst(HANDLE hDevice, const D3DDDIARG_SETPIXELSHADERCONST *p, const FLOAT *pData)
+{
+   D3D9UMD_TRACE("SetPixelShaderConst c%u x%u: %g %g %g %g", p->Register, p->Count, pData[0], pData[1], pData[2],
+                 pData[3]);
+   return nddi_set_shader_constants_f(D3D9UmdCastDevice(hDevice)->nine, true, p->Register, pData, p->Count);
+}
+
+static HRESULT APIENTRY
+SetPixelShaderConstI(HANDLE hDevice, const D3DDDIARG_SETPIXELSHADERCONSTI *p, const INT *pData)
+{
+   return nddi_set_shader_constants_i(D3D9UmdCastDevice(hDevice)->nine, true, p->Register, (const int32_t *)pData,
+                                      p->Count);
+}
+
+static HRESULT APIENTRY
+SetPixelShaderConstB(HANDLE hDevice, const D3DDDIARG_SETPIXELSHADERCONSTB *p, const BOOL *pData)
+{
+   return nddi_set_shader_constants_b(D3D9UmdCastDevice(hDevice)->nine, true, p->Register, (const int32_t *)pData,
+                                      p->Count);
+}
+
+/* ---- Textures and samplers ---- */
+
+static HRESULT APIENTRY
+SetTexture(HANDLE hDevice, UINT Stage, HANDLE hTexture)
+{
+   D3D9UmdResource *tex = D3D9UmdCastResource(hTexture);
+   D3D9UMD_TRACE("SetTexture %u = %p", Stage, tex);
+   return nddi_set_texture(D3D9UmdCastDevice(hDevice)->nine, Stage, tex ? tex->nine : NULL);
+}
+
+/* The DDI sends sampler states as texture stage states with their pre-D3D9 numbers */
+static int
+SamplerStateFor(D3DDDITEXTURESTAGESTATETYPE state)
+{
+   switch (state) {
+   case D3DDDITSS_ADDRESSU: return D3DSAMP_ADDRESSU;
+   case D3DDDITSS_ADDRESSV: return D3DSAMP_ADDRESSV;
+   case D3DDDITSS_ADDRESSW: return D3DSAMP_ADDRESSW;
+   case D3DDDITSS_BORDERCOLOR: return D3DSAMP_BORDERCOLOR;
+   case D3DDDITSS_MAGFILTER: return D3DSAMP_MAGFILTER;
+   case D3DDDITSS_MINFILTER: return D3DSAMP_MINFILTER;
+   case D3DDDITSS_MIPFILTER: return D3DSAMP_MIPFILTER;
+   case D3DDDITSS_MIPMAPLODBIAS: return D3DSAMP_MIPMAPLODBIAS;
+   case D3DDDITSS_MAXMIPLEVEL: return D3DSAMP_MAXMIPLEVEL;
+   case D3DDDITSS_MAXANISOTROPY: return D3DSAMP_MAXANISOTROPY;
+   case D3DDDITSS_SRGBTEXTURE: return D3DSAMP_SRGBTEXTURE;
+   case D3DDDITSS_ELEMENTINDEX: return D3DSAMP_ELEMENTINDEX;
+   case D3DDDITSS_DMAPOFFSET: return D3DSAMP_DMAPOFFSET;
+   default: return -1;
+   }
+}
+
+static HRESULT APIENTRY
+SetTextureStageState(HANDLE hDevice, const D3DDDIARG_TEXTURESTAGESTATE *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   int sampler = SamplerStateFor(p->State);
+   D3D9UMD_TRACE("SetTextureStageState %u %u = 0x%x", p->Stage, (UINT)p->State, p->Value);
+   if (sampler >= 0)
+      nddi_set_sampler_state(dev->nine, p->Stage, sampler, p->Value);
+   else if (p->State != D3DDDITSS_TEXTUREMAP && p->State != D3DDDITSS_DISABLETEXTURECOLORKEY &&
+            p->State != D3DDDITSS_TEXTURECOLORKEYVAL)
+      nddi_set_texture_stage_state(dev->nine, p->Stage, p->State, p->Value);
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+GenerateMipSubLevels(HANDLE hDevice, const D3DDDIARG_GENERATEMIPSUBLEVELS *p)
+{
+   return nddi_generate_mip_sublevels(D3D9UmdCastResource(p->hResource)->nine);
+}
+
+/* UpdateTexture: the source's levels (system memory) to the destination's, from the destination's matching level */
+static HRESULT APIENTRY
+TexBlt(HANDLE hDevice, const D3DDDIARG_TEXBLT *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   D3D9UmdResource *src = D3D9UmdCastResource(p->hSrcResource), *dst = D3D9UmdCastResource(p->hDstResource);
+   bool cube = src->flags.CubeMap;
+   UINT srcLevels = cube ? src->surfCount / 6 : src->surfCount;
+   UINT dstLevels = cube ? dst->surfCount / 6 : dst->surfCount;
+   /* The destination may have fewer levels: they match the source's smallest ones */
+   UINT skip = srcLevels > dstLevels ? srcLevels - dstLevels : 0;
+   UINT face = cube ? p->CubeMapFace : 0;
+   HRESULT hr = S_OK;
+   for (UINT level = 0; level < dstLevels && SUCCEEDED(hr); level++) {
+      UINT sl = level + skip, shift = sl;
+      nddi_rect sr = {p->SrcRect.left >> shift, p->SrcRect.top >> shift, MAX2(p->SrcRect.right >> shift, 1),
+                      MAX2(p->SrcRect.bottom >> shift, 1)};
+      nddi_rect dr = {p->DstPoint.x >> level, p->DstPoint.y >> level, 0, 0};
+      dr.right = dr.left + (sr.right - sr.left);
+      dr.bottom = dr.top + (sr.bottom - sr.top);
+      hr = nddi_blt(dev->nine, src->nine, face * srcLevels + sl, &sr, dst->nine, face * dstLevels + level, &dr,
+                    D3DTEXF_NONE);
+   }
+   D3D9UMD_TRACE("TexBlt %p -> %p face %u levels %u -> 0x%08lx", src, dst, face, dstLevels, hr);
+   return hr;
+}
+
+/* ---- Fixed function ---- */
+
+/* The DDI may name the world matrices with their pre-D3D9 numbers */
+static UINT
+TransformFor(D3DTRANSFORMSTATETYPE type)
+{
+   switch ((UINT)type) {
+   case 1: return D3DTS_WORLDMATRIX(0);
+   case 4: return D3DTS_WORLDMATRIX(1);
+   case 5: return D3DTS_WORLDMATRIX(2);
+   case 6: return D3DTS_WORLDMATRIX(3);
+   default: return type;
+   }
+}
+
+static HRESULT APIENTRY
+SetTransform(HANDLE hDevice, const D3DDDIARG_SETTRANSFORM *p)
+{
+   D3D9UMD_TRACE("SetTransform %u", (UINT)p->TransformType);
+   return nddi_set_transform(D3D9UmdCastDevice(hDevice)->nine, TransformFor(p->TransformType),
+                             (const float *)&p->Matrix, false);
+}
+
+static HRESULT APIENTRY
+MultiplyTransform(HANDLE hDevice, const D3DDDIARG_MULTIPLYTRANSFORM *p)
+{
+   return nddi_set_transform(D3D9UmdCastDevice(hDevice)->nine, TransformFor(p->TransformType),
+                             (const float *)&p->Matrix, true);
+}
+
+static HRESULT APIENTRY
+SetMaterial(HANDLE hDevice, const D3DDDIARG_SETMATERIAL *p)
+{
+   static_assert(sizeof(D3DDDIARG_SETMATERIAL) == sizeof(D3DMATERIAL9), "material layout");
+   return nddi_set_material(D3D9UmdCastDevice(hDevice)->nine, p);
+}
+
+static HRESULT APIENTRY
+SetLight(HANDLE hDevice, const D3DDDIARG_SETLIGHT *p, const D3DDDI_LIGHT *pLight)
+{
+   static_assert(sizeof(D3DDDI_LIGHT) == sizeof(D3DLIGHT9), "light layout");
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   switch (p->DataType) {
+   case D3DDDI_SETLIGHT_ENABLE: return nddi_light_enable(dev->nine, p->Index, true);
+   case D3DDDI_SETLIGHT_DISABLE: return nddi_light_enable(dev->nine, p->Index, false);
+   case D3DDDI_SETLIGHT_DATA: return pLight ? nddi_set_light(dev->nine, p->Index, pLight) : E_INVALIDARG;
+   default: return S_OK;
+   }
+}
+
+static HRESULT APIENTRY
+CreateLight(HANDLE hDevice, const D3DDDIARG_CREATELIGHT *p)
+{
+   return S_OK; /* nine creates lights when they're first set */
+}
+
+static HRESULT APIENTRY
+DestroyLight(HANDLE hDevice, const D3DDDIARG_DESTROYLIGHT *p)
+{
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+SetClipPlane(HANDLE hDevice, const D3DDDIARG_SETCLIPPLANE *p)
+{
+   return nddi_set_clip_plane(D3D9UmdCastDevice(hDevice)->nine, p->Index, p->Plane);
+}
+
+static HRESULT APIENTRY
+ValidateDevice(HANDLE hDevice, D3DDDIARG_VALIDATETEXTURESTAGESTATE *p)
+{
+   p->NumPasses = 1;
+   return S_OK;
+}
+
+/* ---- Queries ---- */
+
+static HRESULT APIENTRY
+CreateQuery(HANDLE hDevice, D3DDDIARG_CREATEQUERY *p)
+{
+   nddi_object *query = NULL;
+   HRESULT hr = nddi_create_query(D3D9UmdCastDevice(hDevice)->nine, p->QueryType, &query);
+   D3D9UMD_TRACE("CreateQuery type %u -> 0x%08lx", p->QueryType, hr);
+   p->hQuery = query;
+   return hr;
+}
+
+static HRESULT APIENTRY
+DestroyQuery(HANDLE hDevice, const HANDLE hQuery)
+{
+   nddi_object_destroy(Obj(hQuery));
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+IssueQuery(HANDLE hDevice, const D3DDDIARG_ISSUEQUERY *p)
+{
+   DWORD flags = (p->Flags.Begin ? D3DISSUE_BEGIN : 0) | (p->Flags.End ? D3DISSUE_END : 0);
+   return nddi_issue_query(Obj(p->hQuery), flags);
+}
+
+static HRESULT APIENTRY
+GetQueryData(HANDLE hDevice, const D3DDDIARG_GETQUERYDATA *p)
+{
+   nddi_object *query = Obj(p->hQuery);
+   HRESULT hr = nddi_get_query_data(query, p->pData, p->pData ? nddi_get_query_data_size(query) : 0);
+   /* Not ready yet: the DDI says so with WASSTILLDRAWING */
+   return hr == S_FALSE ? D3DERR_WASSTILLDRAWING : hr;
+}
