 CalcPrivateShaderSize(D3D10DDI_HDEVICE hDevice,
                       __in_ecount (pShaderCode[1]) const UINT *pShaderCode,
                       __in const D3D10DDIARG_STAGE_IO_SIGNATURES *pSignatures);
