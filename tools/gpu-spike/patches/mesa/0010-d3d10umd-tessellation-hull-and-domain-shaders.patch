+         }
+      }
+      return true;
+   case D3D11_SB_OPCODE_DCL_TESS_PARTITIONING:
+      sx->bindings.tess_partitioning = opcode->specific.dcl_tess_partitioning;
+      return true;
+   case D3D11_SB_OPCODE_DCL_TESS_OUTPUT_PRIMITIVE:
+      sx->bindings.tess_output_primitive = opcode->specific.dcl_tess_output_primitive;
+      return true;
+   default:
+      return false;
+   }
+}
