+/* D3D's tess factor names: GL's outer (1..4) or inner (5..6) level, plus one; 0 for other names */
+static signed char
+tess_level(D3D10_SB_NAME name)
+{
+   switch (name) {
+   case D3D11_SB_NAME_FINAL_QUAD_U_EQ_0_EDGE_TESSFACTOR: return 1;
+   case D3D11_SB_NAME_FINAL_QUAD_V_EQ_0_EDGE_TESSFACTOR: return 2;
+   case D3D11_SB_NAME_FINAL_QUAD_U_EQ_1_EDGE_TESSFACTOR: return 3;
+   case D3D11_SB_NAME_FINAL_QUAD_V_EQ_1_EDGE_TESSFACTOR: return 4;
+   case D3D11_SB_NAME_FINAL_QUAD_U_INSIDE_TESSFACTOR: return 5;
+   case D3D11_SB_NAME_FINAL_QUAD_V_INSIDE_TESSFACTOR: return 6;
+   case D3D11_SB_NAME_FINAL_TRI_U_EQ_0_EDGE_TESSFACTOR: return 1;
+   case D3D11_SB_NAME_FINAL_TRI_V_EQ_0_EDGE_TESSFACTOR: return 2;
+   case D3D11_SB_NAME_FINAL_TRI_W_EQ_0_EDGE_TESSFACTOR: return 3;
+   case D3D11_SB_NAME_FINAL_TRI_INSIDE_TESSFACTOR: return 5;
+   /* isolines: GL's outer[0] is the number of lines, outer[1] the segments per line */
+   case D3D11_SB_NAME_FINAL_LINE_DETAIL_TESSFACTOR: return 2;
+   case D3D11_SB_NAME_FINAL_LINE_DENSITY_TESSFACTOR: return 1;
+   default: return 0;
+   }
+}
+
+/* dcl_output (fork/join phases) or dcl_input (domain shaders) of a patch constant register */
+static void
+dcl_patch_constant(struct Shader_xlate *sx, const struct Shader_dst_operand *dst, D3D10_SB_NAME name)
+{
+   unsigned r = dst->base.index[dst->base.index_dim ? dst->base.index_dim - 1 : 0].imm;
+   unsigned mask = dst->mask >> D3D10_SB_OPERAND_4_COMPONENT_MASK_SHIFT;
+   signed char level = tess_level(name);
+
+   if (r >= ARRAY_SIZE(sx->pc_regs)) {
+      LOG_UNSUPPORTED(true);
+      return;
+   }
+   pc_element(sx, r);
+   for (unsigned c = 0; c < 4; c++) {
+      if (!(mask & (1 << c))) {
+         continue;
+      }
+      if (level) {
+         sx->pc_regs[r].tess[c] = level;
+      } else {
+         sx->pc_regs[r].generic_mask |= 1 << c;
+      }
+   }
+   if (sx->hs_phase == HS_NONE) {
+      /* domain shader: fill the array from the patch inputs and tess levels */
+      struct ureg_program *ureg = sx->ureg;
+      if (level) {
+         struct ureg_src sv = ureg_DECL_system_value(ureg, level >= 5 ? TGSI_SEMANTIC_TESSINNER :
+                                                     TGSI_SEMANTIC_TESSOUTER, 0);
+         for (unsigned c = 0; c < 4; c++) {
+            if (mask & (1 << c)) {
+               ureg_MOV(ureg, ureg_writemask(pc_element(sx, r), 1 << c),
+                        ureg_scalar(sv, level >= 5 ? level - 5 : level - 1));
+            }
+         }
+      } else {
+         ureg_MOV(ureg, ureg_writemask(pc_element(sx, r), mask),
+                  ureg_DECL_input(ureg, TGSI_SEMANTIC_PATCH, r, 0, 1));
+      }
+   }
+}
+
+/* Hull shader end: invocation 0 writes the tess levels and per-patch outputs */
+static void
+hs_write_patch_constants(struct Shader_xlate *sx)
+{
+   struct ureg_program *ureg = sx->ureg;
+   struct ureg_dst outer = ureg_dst_undef(), inner = ureg_dst_undef();
+
+   for (unsigned r = 0; r < ARRAY_SIZE(sx->pc_regs); r++) {
+      if (sx->pc_regs[r].generic_mask) {
+         ureg_MOV(ureg, ureg_writemask(ureg_DECL_output(ureg, TGSI_SEMANTIC_PATCH, r), sx->pc_regs[r].generic_mask),
+                  ureg_src(pc_element(sx, r)));
+      }
+      for (unsigned c = 0; c < 4; c++) {
+         signed char level = sx->pc_regs[r].tess[c];
+         if (!level) {
+            continue;
+         }
+         if (level >= 5 && ureg_dst_is_undef(inner)) {
+            inner = ureg_DECL_output(ureg, TGSI_SEMANTIC_TESSINNER, 0);
+         } else if (level < 5 && ureg_dst_is_undef(outer)) {
+            outer = ureg_DECL_output(ureg, TGSI_SEMANTIC_TESSOUTER, 0);
+         }
+         ureg_MOV(ureg, ureg_writemask(level >= 5 ? inner : outer, 1 << (level >= 5 ? level - 5 : level - 1)),
+                  ureg_scalar(ureg_src(pc_element(sx, r)), c));
+      }
+   }
+}
