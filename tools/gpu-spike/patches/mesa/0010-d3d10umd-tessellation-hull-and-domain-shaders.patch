+/* Code in a run-once loop, where ret leaves the loop: hull shader phases, and the domain shader (virglrenderer
+ * turns RET into a plain return there, skipping its epilogue: the y flip, clip distances) */
+static bool
+ret_is_break(const struct Shader_xlate *sx)
+{
+   return sx->hs_phase == HS_CONTROL_POINT || sx->hs_phase == HS_FORK || sx->hs_phase == HS_JOIN || sx->ds_body;
+}
+
+/* ret: out of the run-once loop, through D3D loops inside it */
+static void
+emit_ret(struct Shader_xlate *sx)
+{
+   struct ureg_program *ureg = sx->ureg;
+
+   if (!ret_is_break(sx)) {
+      ureg_RET(ureg);
+      return;
+   }
+   if (sx->cf_depth) {
+      ureg_MOV(ureg, ureg_writemask(sx->hs_counter, TGSI_WRITEMASK_Y), ureg_imm1u(ureg, ~0u));
+      for (unsigned i = 0; i < sx->cf_depth; i++) {
+         if (!sx->cf[i].is_switch && sx->cf[i].lowered) {
+            ureg_MOV(ureg, ureg_writemask(sx->cf[i].flags, TGSI_WRITEMASK_X), ureg_imm1u(ureg, ~0u));
+         }
+      }
+   }
+   ureg_BRK(ureg);
+}
+
+/* The end of the domain shader's run-once loop */
+static void
+ds_close_body(struct Shader_xlate *sx)
+{
+   unsigned label;
+
+   if (sx->ds_body) {
+      ureg_BRK(sx->ureg);
+      ureg_ENDLOOP(sx->ureg, &label);
+      sx->ds_body = false;
+   }
+}
+
+static void
+hs_close_phase(struct Shader_xlate *sx)
+{
+   struct ureg_program *ureg = sx->ureg;
+   unsigned label;
+
+   if (sx->hs_phase == HS_CONTROL_POINT || sx->hs_phase == HS_FORK || sx->hs_phase == HS_JOIN) {
+      ureg_BRK(ureg);
+      ureg_ENDLOOP(ureg, &label);
+   }
+   if (sx->hs_phase == HS_FORK || sx->hs_phase == HS_JOIN) {
+      ureg_UADD(ureg, ureg_writemask(sx->hs_counter, TGSI_WRITEMASK_X),
+                ureg_scalar(ureg_src(sx->hs_counter), TGSI_SWIZZLE_X), ureg_imm1u(ureg, 1));
+      ureg_ENDLOOP(ureg, &label);
+   }
+}
+
+/* A control point phase that isn't there: each output control point is the input one (registers from the
+ * signature the driver gets) */
+static void
+hs_pass_through(struct Shader_xlate *sx)
+{
+   struct ureg_program *ureg = sx->ureg;
+   const struct Shader_translate_options *o = sx->options;
+   /* virglrenderer indexes arrays with address registers only */
+   struct ureg_dst addr = sx->addrs[1];
+
+   if (o && o->num_passthrough) {
+      ureg_UARL(ureg, ureg_writemask(addr, TGSI_WRITEMASK_X), ureg_scalar(sx->invocation_id, TGSI_SWIZZLE_X));
+   }
+   for (unsigned i = 0; o && i < o->num_passthrough; i++) {
+      unsigned r = o->passthrough[i].reg, mask = o->passthrough[i].mask;
+      unsigned semantic = o->passthrough[i].position ? TGSI_SEMANTIC_POSITION : TGSI_SEMANTIC_GENERIC;
+      struct ureg_src in = ureg_DECL_input(ureg, semantic, o->passthrough[i].position ? 0 : r, 0, 1);
+      struct ureg_dst out = ureg_DECL_output(ureg, semantic, o->passthrough[i].position ? 0 : r);
+      ureg_MOV(ureg, ureg_writemask(out, mask),
+               ureg_src_dimension_indirect(in, ureg_scalar(ureg_src(addr), TGSI_SWIZZLE_X), 0));
+   }
+}
