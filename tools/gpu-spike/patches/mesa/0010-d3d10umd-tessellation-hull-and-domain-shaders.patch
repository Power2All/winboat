+/* Hull shader phase markers; false: not one */
+static bool
+translate_hs_phase(struct Shader_xlate *sx, const struct Shader_opcode *opcode)
+{
+   struct ureg_program *ureg = sx->ureg;
+   unsigned label;
+
+   switch (opcode->type) {
+   case D3D11_SB_OPCODE_HS_DECLS:
+      sx->hs_phase = HS_DECLS;
+      return true;
+   case D3D11_SB_OPCODE_HS_CONTROL_POINT_PHASE:
+      hs_close_phase(sx);
+      sx->hs_phase = HS_CONTROL_POINT;
+      sx->hs_had_control_point_phase = true;
+      ureg_MOV(ureg, ureg_writemask(sx->hs_counter, TGSI_WRITEMASK_Y), ureg_imm1u(ureg, 0));
+      ureg_BGNLOOP(ureg, &label);
+      return true;
+   case D3D11_SB_OPCODE_HS_FORK_PHASE:
+   case D3D11_SB_OPCODE_HS_JOIN_PHASE: {
+      unsigned count = sx->hs_phase_index < sx->hs_num_counted ? sx->hs_instance_counts[sx->hs_phase_index] : 1;
+      struct ureg_dst t;
+      sx->hs_phase_index++;
+      hs_close_phase(sx);
+      if (!sx->hs_patch_started) {
+         if (!sx->hs_had_control_point_phase) {
+            hs_pass_through(sx);
+         }
+         /* the output control points are written: the patch constant phases once, by invocation 0 */
+         ureg_BARRIER(ureg);
+         t = ureg_DECL_temporary(ureg);
+         ureg_USEQ(ureg, ureg_writemask(t, TGSI_WRITEMASK_X), ureg_scalar(sx->invocation_id, TGSI_SWIZZLE_X),
+                   ureg_imm1u(ureg, 0));
+         ureg_UIF(ureg, ureg_scalar(ureg_src(t), TGSI_SWIZZLE_X), &label);
+         ureg_release_temporary(ureg, t);
+         sx->hs_patch_started = true;
+      }
+      sx->hs_phase = opcode->type == D3D11_SB_OPCODE_HS_FORK_PHASE ? HS_FORK : HS_JOIN;
+      /* for (instance = 0; instance < count; instance++) { do { phase } while (0); } */
+      ureg_MOV(ureg, ureg_writemask(sx->hs_counter, TGSI_WRITEMASK_X), ureg_imm1u(ureg, 0));
+      ureg_BGNLOOP(ureg, &label);
+      t = ureg_DECL_temporary(ureg);
+      ureg_USGE(ureg, ureg_writemask(t, TGSI_WRITEMASK_X), ureg_scalar(ureg_src(sx->hs_counter), TGSI_SWIZZLE_X),
+                ureg_imm1u(ureg, count));
+      ureg_UIF(ureg, ureg_scalar(ureg_src(t), TGSI_SWIZZLE_X), &label);
+      ureg_BRK(ureg);
+      ureg_ENDIF(ureg);
+      ureg_release_temporary(ureg, t);
+      ureg_MOV(ureg, ureg_writemask(sx->hs_counter, TGSI_WRITEMASK_Y), ureg_imm1u(ureg, 0));
+      ureg_BGNLOOP(ureg, &label);
+      return true;
+   }
+   case D3D10_SB_OPCODE_RET:
+      if (!ret_is_break(sx)) {
+         return false;
+      }
+      emit_ret(sx);
+      return true;
+   case D3D11_SB_OPCODE_DCL_INPUT_CONTROL_POINT_COUNT:
+   case D3D11_SB_OPCODE_DCL_HS_MAX_TESSFACTOR:
+   case D3D11_SB_OPCODE_DCL_HS_FORK_PHASE_INSTANCE_COUNT:
+   case D3D11_SB_OPCODE_DCL_HS_JOIN_PHASE_INSTANCE_COUNT:
+      return true;
+   case D3D11_SB_OPCODE_DCL_OUTPUT_CONTROL_POINT_COUNT:
+      ureg_property(ureg, TGSI_PROPERTY_TCS_VERTICES_OUT, opcode->specific.dcl_control_point_count);
+      return true;
+   case D3D11_SB_OPCODE_DCL_TESS_DOMAIN:
+      if (sx->hs_phase == HS_NONE) {
+         /* domain shader */
+         const struct Shader_translate_options *o = sx->options;
+         unsigned domain = opcode->specific.dcl_tess_domain;
+         ureg_property(ureg, TGSI_PROPERTY_TES_PRIM_MODE,
+                       domain == D3D11_SB_TESSELLATOR_DOMAIN_QUAD ? MESA_PRIM_QUADS :
+                       domain == D3D11_SB_TESSELLATOR_DOMAIN_ISOLINE ? MESA_PRIM_LINES : MESA_PRIM_TRIANGLES);
+         if (o && o->have_tess) {
+            /* the bound hull shader's partitioning and output primitive (GL has them here) */
+            unsigned p = o->tess_partitioning, prim = o->tess_output_primitive;
+            ureg_property(ureg, TGSI_PROPERTY_TES_SPACING,
+                          p == D3D11_SB_TESSELLATOR_PARTITIONING_FRACTIONAL_ODD ? PIPE_TESS_SPACING_FRACTIONAL_ODD :
+                          p == D3D11_SB_TESSELLATOR_PARTITIONING_FRACTIONAL_EVEN ? PIPE_TESS_SPACING_FRACTIONAL_EVEN :
