+/*
+ * Tessellation: hull shaders (TGSI tessellation control) and domain shaders (TGSI tessellation evaluation).
+ */
+static struct ureg_dst
+pc_element(struct Shader_xlate *sx, unsigned index)
+{
+   if (!sx->pc_declared) {
+      sx->pc = ureg_DECL_array_temporary(sx->ureg, ARRAY_SIZE(sx->pc_regs), true);
+      sx->pc_declared = true;
+   }
+   return ureg_dst_array_offset(sx->pc, MIN2(index, ARRAY_SIZE(sx->pc_regs) - 1));
+}
+
+/* A patch constant register operand (o# in fork/join phases, vpc#), with relative addressing */
+static struct ureg_dst
+pc_operand(struct Shader_xlate *sx, const struct Shader_index *index)
+{
+   struct ureg_dst reg = pc_element(sx, index->imm);
+   if (index->index_rep != D3D10_SB_OPERAND_INDEX_IMMEDIATE32) {
+      reg = ureg_dst_indirect(reg, translate_relative_operand(sx, &index->rel));
+   }
+   return reg;
+}
