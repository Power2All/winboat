+/*
+ * ----------------------------------------------------------------------
+ *
+ * Hull and domain shaders (feature level 11) --
+ *
+ * ----------------------------------------------------------------------
+ */
+
+SIZE_T APIENTRY
+CalcPrivateTessellationShaderSize(D3D10DDI_HDEVICE hDevice, const UINT *pShaderCode,
+                                  const D3D11_1DDIARG_TESSELLATION_IO_SIGNATURES *pSignatures)
+{
+   return sizeof(Shader);
+}
+
+static void
+CreateTessellationShader(D3D10DDI_HDEVICE hDevice, const UINT *pShaderCode, D3D10DDI_HSHADER hShader,
+                         const D3D11_1DDIARG_TESSELLATION_IO_SIGNATURES *pSignatures, enum pipe_shader_type type)
+{
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   Shader *pShader = CastShader(hShader);
+   struct Shader_translate_options options;
+
+   pShader->type = type;
+   pShader->output_resolved = true;
+   memset(&pShader->state, 0, sizeof pShader->state);
+   memset(&pShader->bindings, 0, sizeof pShader->bindings);
+   memset(&options, 0, sizeof options);
+   if (type == PIPE_SHADER_TESS_CTRL && pSignatures && pSignatures->pOutputSignatureDeprecated) {
+      /* hull shaders without a control point phase pass the control points through: these registers */
+      for (UINT i = 0; i < pSignatures->NumOutputSignatureEntries &&
+                       options.num_passthrough < ARRAY_SIZE(options.passthrough); i++) {
+         const D3D11_1DDIARG_SIGNATURE_ENTRY *e = &pSignatures->pOutputSignatureDeprecated[i];
+         options.passthrough[options.num_passthrough].reg = e->Register;
+         options.passthrough[options.num_passthrough].mask = e->Mask;
+         options.passthrough[options.num_passthrough].position = e->SystemValue == D3D10_SB_NAME_POSITION;
+         options.num_passthrough++;
+      }
+   }
+   pShader->state.tokens = Shader_tgsi_translate_ex(pShaderCode, pShader->output_mapping, &pShader->bindings,
+                                                    &options);
+   pShader->handle = !pShader->state.tokens ? NULL :
+                     type == PIPE_SHADER_TESS_CTRL ? pipe->create_tcs_state(pipe, &pShader->state) :
+                                                     pipe->create_tes_state(pipe, &pShader->state);
+   ShaderKeepCode(pShader, pShaderCode);
+}
+
+void APIENTRY
+CreateHullShader(D3D10DDI_HDEVICE hDevice, const UINT *pShaderCode, D3D10DDI_HSHADER hShader,
+                 D3D10DDI_HRTSHADER hRTShader, const D3D11_1DDIARG_TESSELLATION_IO_SIGNATURES *pSignatures)
+{
+   LOG_ENTRYPOINT();
+   CreateTessellationShader(hDevice, pShaderCode, hShader, pSignatures, PIPE_SHADER_TESS_CTRL);
+}
+
+void APIENTRY
+CreateDomainShader(D3D10DDI_HDEVICE hDevice, const UINT *pShaderCode, D3D10DDI_HSHADER hShader,
+                   D3D10DDI_HRTSHADER hRTShader, const D3D11_1DDIARG_TESSELLATION_IO_SIGNATURES *pSignatures)
+{
+   LOG_ENTRYPOINT();
+   CreateTessellationShader(hDevice, pShaderCode, hShader, pSignatures, PIPE_SHADER_TESS_EVAL);
+}
+
+void APIENTRY
+HsSetShader(D3D10DDI_HDEVICE hDevice, D3D10DDI_HSHADER hShader)
+{
+   LOG_ENTRYPOINT();
+
+   Device *pDevice = CastDevice(hDevice);
+   pDevice->bound_shader[PIPE_SHADER_TESS_CTRL] = CastShader(hShader);
+   pDevice->bindings_dirty[PIPE_SHADER_TESS_CTRL] = true;
+   /* the domain shader's translation may depend on it */
+   pDevice->bindings_dirty[PIPE_SHADER_TESS_EVAL] = true;
+   pDevice->pipe->bind_tcs_state(pDevice->pipe, CastPipeShader(hShader));
+}
+
+void APIENTRY
+DsSetShader(D3D10DDI_HDEVICE hDevice, D3D10DDI_HSHADER hShader)
+{
+   LOG_ENTRYPOINT();
+
+   Device *pDevice = CastDevice(hDevice);
+   Shader *pShader = CastShader(hShader);
+   pDevice->bound_shader[PIPE_SHADER_TESS_EVAL] = pShader;
+   pDevice->bindings_dirty[PIPE_SHADER_TESS_EVAL] = true;
+   if (pShader) {
+      memset(pShader->bound_formats, 0, sizeof pShader->bound_formats);
+      pShader->bound_tess_key = 0;
+   }
+   pDevice->pipe->bind_tes_state(pDevice->pipe, CastPipeShader(hShader));
+}
+
+void APIENTRY
+HsSetShaderResources(D3D10DDI_HDEVICE hDevice, UINT Offset, UINT NumViews,
+                     const D3D10DDI_HSHADERRESOURCEVIEW *phShaderResourceViews)
+{
+   SetShaderResources(PIPE_SHADER_TESS_CTRL, hDevice, Offset, NumViews, phShaderResourceViews);
+}
+
+void APIENTRY
+DsSetShaderResources(D3D10DDI_HDEVICE hDevice, UINT Offset, UINT NumViews,
+                     const D3D10DDI_HSHADERRESOURCEVIEW *phShaderResourceViews)
+{
+   SetShaderResources(PIPE_SHADER_TESS_EVAL, hDevice, Offset, NumViews, phShaderResourceViews);
+}
+
+void APIENTRY
+HsSetSamplers(D3D10DDI_HDEVICE hDevice, UINT Offset, UINT NumSamplers, const D3D10DDI_HSAMPLER *phSamplers)
+{
+   SetSamplers(PIPE_SHADER_TESS_CTRL, hDevice, Offset, NumSamplers, phSamplers);
+}
+
+void APIENTRY
+DsSetSamplers(D3D10DDI_HDEVICE hDevice, UINT Offset, UINT NumSamplers, const D3D10DDI_HSAMPLER *phSamplers)
+{
+   SetSamplers(PIPE_SHADER_TESS_EVAL, hDevice, Offset, NumSamplers, phSamplers);
+}
