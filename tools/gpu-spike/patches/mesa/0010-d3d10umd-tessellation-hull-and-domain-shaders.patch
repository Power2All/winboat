+void APIENTRY DsSetShader(D3D10DDI_HDEVICE hDevice, D3D10DDI_HSHADER hShader);
+void APIENTRY HsSetShaderResources(D3D10DDI_HDEVICE hDevice, UINT Offset, UINT NumViews,
+                                   const D3D10DDI_HSHADERRESOURCEVIEW *phShaderResourceViews);
+void APIENTRY DsSetShaderResources(D3D10DDI_HDEVICE hDevice, UINT Offset, UINT NumViews,
