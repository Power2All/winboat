                                struct gdikmt_createallocation *options)
@@ -187,6 +194,14 @@
 
    options->hResource = (HANDLE)createAllocation.hKMResource;
 
+   if (NT_SUCCESS(Status)) {
+      D3DKMT_HANDLE handles[16];
+      UINT count = MIN2(options->NumAllocations, ARRAY_SIZE(handles));
+      for (UINT i = 0; i < count; i++)
+         handles[i] = options->pAllocationInfo[i].hAllocation;
+      gdikmt_d3dddi_makeresident(device, handles, count);
+   }
+
    return Status;
 }
 
@@ -251,6 +266,13 @@
       options->pOpenAllocation[i] =
          device->pOpenResource->pOpenAllocationInfo[i];
    }
+   {
+      D3DKMT_HANDLE handles[16];
+      UINT count = MIN2(options->NumAllocations, ARRAY_SIZE(handles));
+      for (UINT i = 0; i < count; i++)
+         handles[i] = options->pOpenAllocation[i].hAllocation;
+      gdikmt_d3dddi_makeresident(device, handles, count);
+   }
 
    memcpy(options->pPrivateDriverData,
           device->pOpenResource->pPrivateDriverData,
