 }
 
 struct gdikmt_context_d3dkmt {
@@ -81,6 +95,11 @@
    D3DKMT_HANDLE hAdapter;
    D3DKMT_HANDLE hDevice;
 
+   /* WDDM 2.0 kernel drivers (GPU virtual addresses) leave residency to the user-mode driver: allocations are made
+    * resident through this paging queue when they are created. 0 on WDDM 1.x, where the allocation lists do it */
+   D3DKMT_HANDLE hPagingQueue;
+   D3DKMT_HANDLE hPagingFence;
+
    HINSTANCE gdi32lib;
    struct d3dkmt_callbacks cb;
 };
@@ -225,6 +244,35 @@
    return Status;
 }
 
+/* WDDM 2.0: resident from now on, before any command uses them (a command buffer naming an allocation that isn't
+ * puts the whole device in error). Nothing to do on WDDM 1.x, which has no paging queue */
+static void
+d3dkmt_make_resident(struct gdikmt_device_d3dkmt *device, const D3DKMT_HANDLE *handles, UINT count)
+{
+   if (!device->hPagingQueue || !count)
+      return;
+
+   D3DDDI_MAKERESIDENT resident;
+   memset(&resident, 0, sizeof(resident));
+   resident.hPagingQueue = device->hPagingQueue;
+   resident.NumAllocations = count;
+   resident.AllocationList = handles;
+   resident.Flags.MustSucceed = 1;
+   NTSTATUS residentStatus = device->cb.makeResident(&resident);
+   /* pending paging work signals the paging fence with this value; a value already reached returns at once */
+   if ((residentStatus == STATUS_PENDING || NT_SUCCESS(residentStatus)) && resident.PagingFenceValue) {
+      D3DKMT_WAITFORSYNCHRONIZATIONOBJECTFROMCPU wait;
+      memset(&wait, 0, sizeof(wait));
+      wait.hDevice = device->hDevice;
+      wait.ObjectCount = 1;
+      wait.ObjectHandleArray = &device->hPagingFence;
+      wait.FenceValueArray = &resident.PagingFenceValue;
+      residentStatus = device->cb.waitForSynchronizationObjectFromCpu(&wait);
+   }
+   if (!NT_SUCCESS(residentStatus))
+      _debug_printf("Failed to make allocations resident: %lx\n", residentStatus);
+}
+
 NTSTATUS
 gdikmt_d3dkmt_createallocation(struct gdikmt_device *_device,
                                struct gdikmt_createallocation *options)
@@ -245,6 +293,14 @@
 
    options->hResource = (HANDLE)createAllocation.hResource;
 
+   if (NT_SUCCESS(Status)) {
+      D3DKMT_HANDLE handles[16];
+      UINT count = MIN2(options->NumAllocations, ARRAY_SIZE(handles));
+      for (UINT i = 0; i < count; i++)
+         handles[i] = options->pAllocationInfo[i].hAllocation;
+      d3dkmt_make_resident(device, handles, count);
+   }
+
    return Status;
 }
 
@@ -339,6 +395,15 @@
 
    free(privateRuntimeData);
 
+   /* a shared resource (another device's, such as the window's back buffer) is resident for that device only */
+   if (NT_SUCCESS(Status)) {
+      D3DKMT_HANDLE handles[16];
+      UINT count = MIN2(openAllocation->NumAllocations, ARRAY_SIZE(handles));
+      for (UINT i = 0; i < count; i++)
+         handles[i] = openAllocation->pOpenAllocation[i].hAllocation;
+      d3dkmt_make_resident(device, handles, count);
+   }
+
    return Status;
 }
 
@@ -400,6 +465,19 @@
    }
    device->hDevice = createDevice.hDevice;
 
+   /* a paging queue only exists with WDDM 2.0 kernel drivers */
+   if (device->cb.createPagingQueue && device->cb.makeResident &&
+       device->cb.waitForSynchronizationObjectFromCpu) {
+      D3DKMT_CREATEPAGINGQUEUE pagingQueue;
+      memset(&pagingQueue, 0, sizeof(pagingQueue));
+      pagingQueue.hDevice = device->hDevice;
+      pagingQueue.Priority = D3DDDI_PAGINGQUEUE_PRIORITY_NORMAL;
+      if (NT_SUCCESS(device->cb.createPagingQueue(&pagingQueue))) {
+         device->hPagingQueue = pagingQueue.hPagingQueue;
+         device->hPagingFence = pagingQueue.hSyncObject;
+      }
+   }
+
    device->base.destroy = gdikmt_d3dkmt_destroy;
    device->base.queryAdapterInfo = gdikmt_d3dkmt_queryadapterinfo;
    device->base.escape = gdikmt_d3dkmt_escape;
diff --git a/src/gallium/auxiliary/gdikmt/gdikmt_wddm2.c b/src/gallium/auxiliary/gdikmt/gdikmt_wddm2.c
new file mode 100644
--- /dev/null
+++ b/src/gallium/auxiliary/gdikmt/gdikmt_wddm2.c
@@ -0,0 +1,63 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Residency with WDDM 2.0 kernel drivers (GPU virtual addresses). Windows makes nothing resident for the user-mode
+ * driver any more: an allocation a command buffer names must have been made resident (MakeResident), else the
+ * kernel drops the command buffer ("Allocation is not requested to be resident"). The D3D runtimes hand our
+ * drivers the WDDM 2.0 callbacks for it even on their WDDM 1.x interfaces; on WDDM 1.x kernel drivers there is no
+ * paging queue and this does nothing.
+ */
+
+#include <string.h>
+#include "gdikmt/gdikmt.h"
+
+/* d3dumddi.h needs the D3D9 types first */
+#include <d3d9types.h>
+#include <d3dumddi.h>
+
+#include "util/macros.h"
+#include "util/u_debug.h"
+
+void
+gdikmt_wddm2_make_resident(struct gdikmt_wddm2_residency *residency, const D3DDDI_DEVICECALLBACKS *cb,
+                           HANDLE hRTDevice, const D3DKMT_HANDLE *handles, UINT count)
+{
+   if (!residency->tried) {
+      residency->tried = true;
+      if (cb->pfnCreatePagingQueueCb && cb->pfnMakeResidentCb && cb->pfnWaitForSynchronizationObjectFromCpuCb) {
+         D3DDDICB_CREATEPAGINGQUEUE queue;
+         memset(&queue, 0, sizeof(queue));
+         queue.Priority = D3DDDI_PAGINGQUEUE_PRIORITY_NORMAL;
+         if (SUCCEEDED(cb->pfnCreatePagingQueueCb(hRTDevice, &queue))) {
+            residency->hPagingQueue = queue.hPagingQueue;
+            residency->hPagingFence = queue.hSyncObject;
+         }
+      }
+   }
+   if (!residency->hPagingQueue || !count)
+      return;
+
+   /* resident for good: these drivers never evict (the memory manager still may, under pressure) */
+   D3DDDI_MAKERESIDENT resident;
+   memset(&resident, 0, sizeof(resident));
+   resident.hPagingQueue = residency->hPagingQueue;
+   resident.NumAllocations = count;
+   resident.AllocationList = handles;
+   resident.Flags.MustSucceed = 1;
+   HRESULT hr = cb->pfnMakeResidentCb(hRTDevice, &resident);
+   /* pending paging work: the runtimes report it as E_PENDING (the kernel's STATUS_PENDING), with the paging fence
+    * value it signals. A command buffer naming the allocations before that is dropped ("allocation has not been
+    * fully committed"), so wait for it; a value already reached returns at once */
+   if ((SUCCEEDED(hr) || hr == E_PENDING || hr == (HRESULT)STATUS_PENDING) && resident.PagingFenceValue) {
+      D3DDDICB_WAITFORSYNCHRONIZATIONOBJECTFROMCPU wait;
+      memset(&wait, 0, sizeof(wait));
+      wait.ObjectCount = 1;
+      wait.ObjectHandleArray = &residency->hPagingFence;
+      wait.FenceValueArray = &resident.PagingFenceValue;
+      hr = cb->pfnWaitForSynchronizationObjectFromCpuCb(hRTDevice, &wait);
+   }
+   if (FAILED(hr))
+      debug_printf("gdikmt: MakeResident failed: 0x%lx\n", (unsigned long)hr);
+}
