--- a/src/gallium/auxiliary/gdikmt/gdikmt_d3dkmt.c
+++ b/src/gallium/auxiliary/gdikmt/gdikmt_d3dkmt.c
@@ -26,6 +26,11 @@
    PFND3DKMT_OPENADAPTERFROMHDC openAdapterFromHdc;
    PFND3DKMT_OPENADAPTERFROMLUID openAdapterFromLuid;
    PFND3DKMT_CLOSEADAPTER closeAdapter;
+   /* WDDM 2.0 residency */
+   PFND3DKMT_CREATEPAGINGQUEUE createPagingQueue;
+   PFND3DKMT_DESTROYPAGINGQUEUE destroyPagingQueue;
+   PFND3DKMT_MAKERESIDENT makeResident;
+   PFND3DKMT_WAITFORSYNCHRONIZATIONOBJECTFROMCPU waitForSynchronizationObjectFromCpu;
 };
 
 void
@@ -61,6 +66,15 @@
       gdi32lib, "D3DKMTOpenAdapterFromLuid");
    cb->closeAdapter =
       (PFND3DKMT_CLOSEADAPTER)GetProcAddress(gdi32lib, "D3DKMTCloseAdapter");
+   cb->createPagingQueue = (PFND3DKMT_CREATEPAGINGQUEUE)GetProcAddress(
+      gdi32lib, "D3DKMTCreatePagingQueue");
+   cb->destroyPagingQueue = (PFND3DKMT_DESTROYPAGINGQUEUE)GetProcAddress(
+      gdi32lib, "D3DKMTDestroyPagingQueue");
+   cb->makeResident =
+      (PFND3DKMT_MAKERESIDENT)GetProcAddress(gdi32lib, "D3DKMTMakeResident");
+   cb->waitForSynchronizationObjectFromCpu =
+      (PFND3DKMT_WAITFORSYNCHRONIZATIONOBJECTFROMCPU)GetProcAddress(
