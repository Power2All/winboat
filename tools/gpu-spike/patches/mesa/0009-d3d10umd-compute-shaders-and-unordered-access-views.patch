diff --git a/src/gallium/frontends/d3d10umd/Compute.cpp b/src/gallium/frontends/d3d10umd/Compute.cpp
new file mode 100644
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/Compute.cpp
@@ -0,0 +1,336 @@
+/*
+ * Compute.cpp --
+ *    Feature level 11: unordered access views, compute dispatches, UAV clears and counters.
+ *
+ *    Typed UAVs are images, raw and structured ones shader buffers (byte ranges); append/consume and counter
+ *    UAVs get a 4-byte counter buffer. The shaders bind them through Shader_bindings (ShaderBindStage). D3D
+ *    orders UAV writes before later work implicitly, GL needs barriers: after every dispatch, and after draws
+ *    whose pixel shader writes UAVs.
+ */
+
+#include "Compute.h"
+#include "Shader.h"
+#include "State.h"
+#include "Format.h"
+
+#include "Debug.h"
+
+#include "util/format/u_format.h"
+#include "util/u_inlines.h"
+#include "util/u_memory.h"
+
+#include <cstdlib>
+
+
+SIZE_T APIENTRY
+CalcPrivateUnorderedAccessViewSize(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATEUNORDEREDACCESSVIEW *pView)
+{
+   return sizeof(UnorderedAccessView);
+}
+
+
+void APIENTRY
+CreateUnorderedAccessView(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATEUNORDEREDACCESSVIEW *pView,
+                          D3D11DDI_HUNORDEREDACCESSVIEW hView, D3D11DDI_HRTUNORDEREDACCESSVIEW hRTView)
+{
+   LOG_ENTRYPOINT();
+
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   UnorderedAccessView *uav = CastUnorderedAccessView(hView);
+   Resource *res = CastResource(pView->hDrvResource);
+
+   memset(uav, 0, sizeof *uav);
+   uav->resource = res;
+
+   if (pView->ResourceDimension == D3D10DDIRESOURCE_BUFFER) {
+      bool raw = pView->Buffer.Flags & D3D11_DDI_BUFFER_UAV_FLAG_RAW;
+      if (raw || pView->Format == DXGI_FORMAT_UNKNOWN) {
+         /* raw: 4-byte elements; structured: the buffer's stride */
+         unsigned elem = raw ? 4 : res->ByteStride;
+         uav->buffer.buffer_offset = pView->Buffer.FirstElement * elem;
+         uav->buffer.buffer_size = pView->Buffer.NumElements * elem;
+      } else {
+         uav->typed = true;
+         uav->image.format = FormatTranslate(pView->Format, false);
+         unsigned elem = util_format_get_blocksize(uav->image.format);
+         uav->image.u.buf.offset = pView->Buffer.FirstElement * elem;
+         uav->image.u.buf.size = pView->Buffer.NumElements * elem;
+      }
+      if (pView->Buffer.Flags & (D3D11_DDI_BUFFER_UAV_FLAG_APPEND | D3D11_DDI_BUFFER_UAV_FLAG_COUNTER)) {
+         static const uint32_t zero = 0;
+         uav->counter = pipe_buffer_create(pipe->screen, PIPE_BIND_SHADER_BUFFER, PIPE_USAGE_DEFAULT, 4);
+         if (uav->counter) {
+            pipe->buffer_subdata(pipe, uav->counter, PIPE_MAP_WRITE, 0, 4, &zero);
+         }
+      }
+   } else {
+      uav->typed = true;
+      uav->image.format = FormatTranslate(pView->Format, false);
+      switch (pView->ResourceDimension) {
+      case D3D10DDIRESOURCE_TEXTURE1D:
+         uav->image.u.tex.level = pView->Tex1D.MipSlice;
+         uav->image.u.tex.first_layer = pView->Tex1D.FirstArraySlice;
+         uav->image.u.tex.last_layer = pView->Tex1D.FirstArraySlice + pView->Tex1D.ArraySize - 1;
+         break;
+      case D3D10DDIRESOURCE_TEXTURE2D:
+         uav->image.u.tex.level = pView->Tex2D.MipSlice;
+         uav->image.u.tex.first_layer = pView->Tex2D.FirstArraySlice;
+         uav->image.u.tex.last_layer = pView->Tex2D.FirstArraySlice + pView->Tex2D.ArraySize - 1;
+         break;
+      case D3D10DDIRESOURCE_TEXTURE3D:
+         uav->image.u.tex.level = pView->Tex3D.MipSlice;
+         uav->image.u.tex.first_layer = pView->Tex3D.FirstW;
+         uav->image.u.tex.last_layer = pView->Tex3D.FirstW + pView->Tex3D.WSize - 1;
+         break;
+      default:
+         LOG_UNSUPPORTED(true);
+         break;
+      }
+   }
+   if (uav->typed && res->resource->target != PIPE_BUFFER) {
+      /* sizes of ~0 mean all layers or slices (and the bitfields are 16 bits): clamp to the resource's */
+      const struct pipe_resource *pr = res->resource;
+      unsigned layers = pr->target == PIPE_TEXTURE_3D ? u_minify(pr->depth0, uav->image.u.tex.level) :
+                        pr->array_size;
+      unsigned first = MIN2(uav->image.u.tex.first_layer, layers - 1);
+      uint64_t last = pView->ResourceDimension == D3D10DDIRESOURCE_TEXTURE3D ?
+                      (uint64_t)pView->Tex3D.FirstW + pView->Tex3D.WSize - 1 :
+                      pView->ResourceDimension == D3D10DDIRESOURCE_TEXTURE2D ?
+                      (uint64_t)pView->Tex2D.FirstArraySlice + pView->Tex2D.ArraySize - 1 :
+                      (uint64_t)pView->Tex1D.FirstArraySlice + pView->Tex1D.ArraySize - 1;
+      uav->image.u.tex.first_layer = first;
+      uav->image.u.tex.last_layer = (unsigned)MIN2(last, (uint64_t)layers - 1);
+   }
+   uav->image.resource = res->resource;
+   uav->image.access = PIPE_IMAGE_ACCESS_READ_WRITE;
+   uav->image.shader_access = PIPE_IMAGE_ACCESS_READ_WRITE;
+   uav->buffer.buffer = res->resource;
+}
+
+
+void APIENTRY
+DestroyUnorderedAccessView(D3D10DDI_HDEVICE hDevice, D3D11DDI_HUNORDEREDACCESSVIEW hView)
+{
+   LOG_ENTRYPOINT();
+
+   Device *pDevice = CastDevice(hDevice);
+   UnorderedAccessView *uav = CastUnorderedAccessView(hView);
+
+   for (unsigned s = 0; s < PIPE_SHADER_TYPES; s++) {
+      for (unsigned i = 0; i < D3D11_1_UAV_SLOT_COUNT; i++) {
+         if (pDevice->uavs[s][i] == uav) {
+            pDevice->uavs[s][i] = NULL;
+            pDevice->bindings_dirty[s] = true;
+         }
+      }
+   }
+   pipe_resource_reference(&uav->counter, NULL);
+}
+
+
+/* Binds UAVs of a stage: slots Start.. (the rest of [RangeStart, RangeStart + RangeSize) unbound), counters set
+ * to the initial counts unless ~0 */
+void
+SetUnorderedAccessViews(Device *pDevice, enum pipe_shader_type type, UINT RangeStart, UINT RangeSize, UINT Start,
+                        UINT NumViews, const D3D11DDI_HUNORDEREDACCESSVIEW *phViews, const UINT *pInitialCounts)
+{
+   struct pipe_context *pipe = pDevice->pipe;
+
+   for (UINT i = RangeStart; i < RangeStart + RangeSize && i < D3D11_1_UAV_SLOT_COUNT; i++) {
+      pDevice->uavs[type][i] = NULL;
+   }
+   for (UINT i = 0; i < NumViews && Start + i < D3D11_1_UAV_SLOT_COUNT; i++) {
+      UnorderedAccessView *uav = CastUnorderedAccessView(phViews[i]);
+      pDevice->uavs[type][Start + i] = uav;
+      if (uav && uav->counter && pInitialCounts && pInitialCounts[i] != ~0u) {
+         pipe->buffer_subdata(pipe, uav->counter, PIPE_MAP_WRITE, 0, 4, &pInitialCounts[i]);
+      }
+   }
+   pDevice->bindings_dirty[type] = true;
+}
+
+
+void APIENTRY
+CsSetUnorderedAccessViews(D3D10DDI_HDEVICE hDevice, UINT StartSlot, UINT NumViews,
+                          const D3D11DDI_HUNORDEREDACCESSVIEW *phViews, const UINT *pInitialCounts)
+{
+   LOG_ENTRYPOINT();
+
+   SetUnorderedAccessViews(CastDevice(hDevice), PIPE_SHADER_COMPUTE, StartSlot, NumViews, StartSlot, NumViews,
+                           phViews, pInitialCounts);
+}
+
+
+static void
+LaunchGrid(Device *pDevice, const UINT grid[3], struct pipe_resource *indirect, UINT indirect_offset)
+{
+   struct pipe_context *pipe = pDevice->pipe;
+   const Shader *shader = pDevice->bound_shader[PIPE_SHADER_COMPUTE];
+   struct pipe_grid_info info;
+
+   if (!shader || !shader->handle) {
+      return;
+   }
+   ShaderBindStage(pDevice, PIPE_SHADER_COMPUTE);
+
+   memset(&info, 0, sizeof info);
+   for (unsigned i = 0; i < 3; i++) {
+      info.block[i] = MAX2(shader->bindings.block[i], 1);
+      info.grid[i] = grid ? grid[i] : 1;
+      info.last_block[i] = 0;
+   }
+   info.indirect = indirect;
+   info.indirect_offset = indirect_offset;
+   if (!indirect && (!info.grid[0] || !info.grid[1] || !info.grid[2])) {
+      return;
+   }
+   pipe->launch_grid(pipe, &info);
+   pipe->memory_barrier(pipe, PIPE_BARRIER_ALL);
+}
+
+
+void APIENTRY
+Dispatch(D3D10DDI_HDEVICE hDevice, UINT X, UINT Y, UINT Z)
+{
+   LOG_ENTRYPOINT();
+
+   const UINT grid[3] = {X, Y, Z};
+   LaunchGrid(CastDevice(hDevice), grid, NULL, 0);
+}
+
+
+void APIENTRY
+DispatchIndirect(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hBuffer, UINT AlignedByteOffset)
+{
+   LOG_ENTRYPOINT();
+
+   LaunchGrid(CastDevice(hDevice), NULL, CastPipeResource(hBuffer), AlignedByteOffset);
+}
+
+
+/* Fills a buffer range with a repeated pattern (virgl has no buffer clears) */
+static void
+FillBuffer(struct pipe_context *pipe, struct pipe_resource *res, unsigned offset, unsigned size,
+           const void *pattern, unsigned pattern_size)
+{
+   if (!size || !pattern_size) {
+      return;
+   }
+   char *data = (char *)malloc(size);
+   if (!data) {
+      return;
+   }
+   for (unsigned i = 0; i < size; i += pattern_size) {
+      memcpy(data + i, pattern, MIN2(pattern_size, size - i));
+   }
+   pipe->buffer_subdata(pipe, res, PIPE_MAP_WRITE, offset, size, data);
+  free(data);
+}
+
+
+/* A typed UAV's clear value in its format: Uint clears put each value's low bits into the channels as they are,
+ * Float clears convert */
+static void
+PackClearValue(enum pipe_format format, const void *values, bool is_float, uint8_t packed[16])
+{
+   const struct util_format_description *desc = util_format_description(format);
+
+   memset(packed, 0, 16);
+   if (is_float || util_format_is_pure_integer(format)) {
+      util_format_pack_rgba(format, packed, values, 1);
+      return;
+   }
+   /* bits into the channels */
+   const uint32_t *v = (const uint32_t *)values;
+   uint64_t bits = 0;
+   for (unsigned c = 0; c < desc->nr_channels; c++) {
+      unsigned size = desc->channel[c].size;
+      for (unsigned j = 0; j < 4; j++) {
+         if (desc->swizzle[j] == c && size && size <= 32) {
+            uint64_t mask = size == 32 ? 0xffffffffull : ((1ull << size) - 1);
+            bits |= ((uint64_t)v[j] & mask) << desc->channel[c].shift;
+            break;
+         }
+      }
+   }
+   if (desc->block.bits <= 64) {
+      memcpy(packed, &bits, desc->block.bits / 8);
+   } else {
+      memcpy(packed, v, MIN2(desc->block.bits / 8, 16));
+   }
+}
+
+
+static void
+ClearUnorderedAccessView(D3D10DDI_HDEVICE hDevice, D3D11DDI_HUNORDEREDACCESSVIEW hView, const void *values,
+                         bool is_float)
+{
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   UnorderedAccessView *uav = CastUnorderedAccessView(hView);
+   struct pipe_resource *res = uav->resource->resource;
+
+   if (!uav->typed) {
+      /* raw and structured: every dword gets the first value (as bits for float clears) */
+      uint32_t v;
+      memcpy(&v, values, 4);
+      FillBuffer(pipe, res, uav->buffer.buffer_offset, uav->buffer.buffer_size, &v, 4);
+      return;
+   }
+
+   uint8_t packed[16];
+   PackClearValue(uav->image.format, values, is_float, packed);
+   if (res->target == PIPE_BUFFER) {
+      FillBuffer(pipe, res, uav->image.u.buf.offset, uav->image.u.buf.size, packed,
+                 util_format_get_blocksize(uav->image.format));
+      return;
+   }
+   struct pipe_box box;
+   unsigned level = uav->image.u.tex.level;
+   u_box_3d(0, 0, uav->image.u.tex.first_layer, u_minify(res->width0, level),
+            res->target == PIPE_TEXTURE_1D || res->target == PIPE_TEXTURE_1D_ARRAY ? 1 : u_minify(res->height0, level),
+            uav->image.u.tex.last_layer - uav->image.u.tex.first_layer + 1, &box);
+   if (res->target == PIPE_TEXTURE_1D_ARRAY) {
+      box.y = uav->image.u.tex.first_layer;
+      box.height = box.depth;
+      box.z = 0;
+      box.depth = 1;
+   }
+   pipe->clear_texture(pipe, res, level, &box, packed);
+}
+
+
+void APIENTRY
+ClearUnorderedAccessViewUint(D3D10DDI_HDEVICE hDevice, D3D11DDI_HUNORDEREDACCESSVIEW hView, const UINT values[4])
+{
+   LOG_ENTRYPOINT();
+
+   ClearUnorderedAccessView(hDevice, hView, values, false);
+}
+
+
+void APIENTRY
+ClearUnorderedAccessViewFloat(D3D10DDI_HDEVICE hDevice, D3D11DDI_HUNORDEREDACCESSVIEW hView, const FLOAT values[4])
+{
+   LOG_ENTRYPOINT();
+
+   ClearUnorderedAccessView(hDevice, hView, values, true);
+}
+
+
+void APIENTRY
+CopyStructureCount(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hDstBuffer, UINT DstAlignedByteOffset,
+                   D3D11DDI_HUNORDEREDACCESSVIEW hSrcView)
+{
+   LOG_ENTRYPOINT();
+
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   UnorderedAccessView *uav = CastUnorderedAccessView(hSrcView);
+   struct pipe_box box;
+
+   if (!uav || !uav->counter) {
+      return;
+   }
+   u_box_1d(0, 4, &box);
+   pipe->resource_copy_region(pipe, CastPipeResource(hDstBuffer), 0, DstAlignedByteOffset, 0, 0, uav->counter, 0,
+                              &box);
+}
