+      }
+      ureg_memory_insn(ureg, TGSI_OPCODE_RESQ, &out, 1, &m.reg, 1, 0, m.kind == MEM_TYPED ? m.target : 0, m.format);
+      if (m.kind == MEM_BUFFER && m.stride) {
+         ureg_UDIV(ureg, ureg_writemask(t, TGSI_WRITEMASK_X), ureg_scalar(ureg_src(t), TGSI_SWIZZLE_X),
+                   ureg_imm1u(ureg, m.stride));
+      }
+      if (m.kind == MEM_BUFFER) {
+         ureg_MOV(ureg, ureg_writemask(t, TGSI_WRITEMASK_YZW), ureg_imm1u(ureg, 0));
+      }
+      if (opcode->type == D3D10_SB_OPCODE_RESINFO) {
+         unsigned dims = tex_size_dims(m.target);
+         ureg_MOV(ureg, ureg_writemask(t, TGSI_WRITEMASK_W), ureg_imm1u(ureg, 1));
+         if (opcode->specific.resinfo_ret_type != D3D10_SB_RESINFO_INSTRUCTION_RETURN_UINT) {
+            ureg_U2F(ureg, t, ureg_src(t));
+         }
+         if (opcode->specific.resinfo_ret_type == D3D10_SB_RESINFO_INSTRUCTION_RETURN_RCPFLOAT) {
+            for (unsigned i = 0; i < dims; i++) {
+               ureg_RCP(ureg, ureg_writemask(t, 1 << i), ureg_scalar(ureg_src(t), i));
+            }
+         }
+      }
+      ureg_MOV(ureg, translate_dst_operand(sx, &opcode->dst[0], opcode->saturate),
+               ureg_swizzle(ureg_src(t), res->swizzle[0], res->swizzle[1], res->swizzle[2], res->swizzle[3]));
+      ureg_release_temporary(ureg, t);
+      return true;
+   }
+
+   case D3D11_SB_OPCODE_DCL_UNORDERED_ACCESS_VIEW_TYPED:
+   case D3D11_SB_OPCODE_DCL_UNORDERED_ACCESS_VIEW_RAW:
+   case D3D11_SB_OPCODE_DCL_UNORDERED_ACCESS_VIEW_STRUCTURED:
+      dcl_uav(sx, opcode);
+      return true;
+   case D3D11_SB_OPCODE_DCL_RESOURCE_RAW:
+   case D3D11_SB_OPCODE_DCL_RESOURCE_STRUCTURED:
+      dcl_srv_buffer(sx, opcode);
+      return true;
+   case D3D11_SB_OPCODE_DCL_THREAD_GROUP_SHARED_MEMORY_RAW:
+   case D3D11_SB_OPCODE_DCL_THREAD_GROUP_SHARED_MEMORY_STRUCTURED:
+      dcl_tgsm(sx, opcode);
+      return true;
+   case D3D11_SB_OPCODE_DCL_THREAD_GROUP:
+      for (unsigned i = 0; i < 3; i++) {
+         sx->bindings.block[i] = MAX2(opcode->specific.dcl_thread_group[i], 1);
+      }
+      ureg_property(ureg, TGSI_PROPERTY_CS_FIXED_BLOCK_WIDTH, sx->bindings.block[0]);
+      ureg_property(ureg, TGSI_PROPERTY_CS_FIXED_BLOCK_HEIGHT, sx->bindings.block[1]);
+      ureg_property(ureg, TGSI_PROPERTY_CS_FIXED_BLOCK_DEPTH, sx->bindings.block[2]);
+      cs_inputs(sx);
+      return true;
+   default:
+      return false;
+   }
+}
