+
+void APIENTRY
+CreateComputeShader(D3D10DDI_HDEVICE hDevice, const UINT *pShaderCode, D3D10DDI_HSHADER hShader,
+                    D3D10DDI_HRTSHADER hRTShader)
+{
+   LOG_ENTRYPOINT();
+
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   Shader *pShader = CastShader(hShader);
+   struct pipe_compute_state cs;
+
+   pShader->type = PIPE_SHADER_COMPUTE;
+   pShader->output_resolved = true;
+   memset(&pShader->state, 0, sizeof pShader->state);
+   memset(&pShader->bindings, 0, sizeof pShader->bindings);
+   pShader->code = NULL;
+   pShader->num_variants = 0;
+   pShader->state.tokens = Shader_tgsi_translate(pShaderCode, pShader->output_mapping, &pShader->bindings);
+
+   memset(&cs, 0, sizeof cs);
+   cs.ir_type = PIPE_SHADER_IR_TGSI;
+   cs.prog = pShader->state.tokens;
+   cs.static_shared_mem = pShader->bindings.shared_mem;
+   pShader->handle = pShader->state.tokens ? pipe->create_compute_state(pipe, &cs) : NULL;
+   ShaderKeepCode(pShader, pShaderCode);
+}
+
+void APIENTRY
+CsSetShader(D3D10DDI_HDEVICE hDevice, D3D10DDI_HSHADER hShader)
+{
+   LOG_ENTRYPOINT();
+
+   Device *pDevice = CastDevice(hDevice);
+   struct pipe_context *pipe = pDevice->pipe;
+
+   pDevice->bound_shader[PIPE_SHADER_COMPUTE] = CastShader(hShader);
+   pDevice->bindings_dirty[PIPE_SHADER_COMPUTE] = true;
+   if (CastShader(hShader)) {
+      memset(CastShader(hShader)->bound_formats, 0, sizeof CastShader(hShader)->bound_formats);
+   }
+   pipe->bind_compute_state(pipe, CastPipeShader(hShader));
+}
+
+void APIENTRY
+CsSetShaderResources(D3D10DDI_HDEVICE hDevice, UINT Offset, UINT NumViews,
+                     const D3D10DDI_HSHADERRESOURCEVIEW *phShaderResourceViews)
+{
+   SetShaderResources(PIPE_SHADER_COMPUTE, hDevice, Offset, NumViews, phShaderResourceViews);
+}
+
+void APIENTRY
+CsSetSamplers(D3D10DDI_HDEVICE hDevice, UINT Offset, UINT NumSamplers, const D3D10DDI_HSAMPLER *phSamplers)
+{
+   SetSamplers(PIPE_SHADER_COMPUTE, hDevice, Offset, NumSamplers, phSamplers);
+}
