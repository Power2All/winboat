+/* addr.x = the byte address: raw: the address; structured: index * stride + byte offset (offset NULL: the
+ * address operand's .y); plus the shared memory region's start. Typed: the coordinates as they are. */
+static struct ureg_src
+mem_address(struct Shader_xlate *sx, const struct mem_ref *m, struct ureg_dst addr,
+            const struct Shader_src_operand *a, const struct Shader_src_operand *offset)
+{
+   struct ureg_program *ureg = sx->ureg;
+   struct ureg_src index = translate_src_operand(sx, a, OF_UINT);
+
+   if (m->kind == MEM_TYPED) {
+      return index;
+   }
+   addr = ureg_writemask(addr, TGSI_WRITEMASK_X);
+   if (offset || m->structured) {
+      struct ureg_src off = offset ? ureg_scalar(translate_src_operand(sx, offset, OF_UINT), TGSI_SWIZZLE_X) :
+                                     ureg_scalar(index, TGSI_SWIZZLE_Y);
+      ureg_UMAD(ureg, addr, ureg_scalar(index, TGSI_SWIZZLE_X), ureg_imm1u(ureg, m->stride), off);
+   } else {
+      ureg_MOV(ureg, addr, ureg_scalar(index, TGSI_SWIZZLE_X));
+   }
+   if (m->base) {
+      ureg_UADD(ureg, addr, ureg_scalar(ureg_src(addr), TGSI_SWIZZLE_X), ureg_imm1u(ureg, m->base));
+   }
+   return ureg_scalar(ureg_src(addr), TGSI_SWIZZLE_X);
+}
+
+static enum tgsi_opcode
+atomic_opcode(D3D10_SB_OPCODE_TYPE type)
+{
+   switch (type) {
+   case D3D11_SB_OPCODE_ATOMIC_AND:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_AND:
+      return TGSI_OPCODE_ATOMAND;
+   case D3D11_SB_OPCODE_ATOMIC_OR:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_OR:
+      return TGSI_OPCODE_ATOMOR;
+   case D3D11_SB_OPCODE_ATOMIC_XOR:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_XOR:
+      return TGSI_OPCODE_ATOMXOR;
+   case D3D11_SB_OPCODE_ATOMIC_CMP_STORE:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_CMP_EXCH:
+      return TGSI_OPCODE_ATOMCAS;
+   case D3D11_SB_OPCODE_ATOMIC_IADD:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_IADD:
+      return TGSI_OPCODE_ATOMUADD;
+   case D3D11_SB_OPCODE_ATOMIC_IMAX:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_IMAX:
+      return TGSI_OPCODE_ATOMIMAX;
+   case D3D11_SB_OPCODE_ATOMIC_IMIN:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_IMIN:
+      return TGSI_OPCODE_ATOMIMIN;
+   case D3D11_SB_OPCODE_ATOMIC_UMAX:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_UMAX:
+      return TGSI_OPCODE_ATOMUMAX;
+   case D3D11_SB_OPCODE_ATOMIC_UMIN:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_UMIN:
+      return TGSI_OPCODE_ATOMUMIN;
+   case D3D11_SB_OPCODE_IMM_ATOMIC_EXCH:
+      return TGSI_OPCODE_ATOMXCHG;
+   default:
+      return TGSI_OPCODE_LAST;
+   }
+}
+
+/* Translates the shader model 5 memory instructions; false: not one of them */
+static bool
+translate_sm5_memory(struct Shader_xlate *sx, struct Shader_opcode *opcode)
+{
+   struct ureg_program *ureg = sx->ureg;
+   struct ureg_dst t, addr;
+   struct ureg_src src[4];
+   struct mem_ref m;
+   enum tgsi_opcode atom;
+
+   switch (opcode->type) {
+   case D3D11_SB_OPCODE_LD_UAV_TYPED:
+   case D3D11_SB_OPCODE_LD_RAW:
+   case D3D11_SB_OPCODE_LD_STRUCTURED: {
+      /* loads 4 consecutive dwords (or a texel); the resource operand's swizzle picks the components */
+      const struct Shader_src_operand *res = &opcode->src[opcode->num_src - 1];
+      unsigned need = 0, mask = opcode->dst[0].mask >> D3D10_SB_OPERAND_4_COMPONENT_MASK_SHIFT;
+      m = mem_ref(sx, &res->base);
+      if (m.kind == MEM_NONE) {
+         LOG_UNSUPPORTED(true);
+         return true;
+      }
+      for (unsigned i = 0; i < 4; i++) {
+         if (mask & (1 << i)) {
+            need = MAX2(need, res->swizzle[i] + 1);
+         }
+      }
+      t = ureg_DECL_temporary(ureg);
+      addr = ureg_DECL_temporary(ureg);
+      src[0] = m.reg;
+      src[1] = mem_address(sx, &m, addr, &opcode->src[0],
+                           opcode->type == D3D11_SB_OPCODE_LD_STRUCTURED ? &opcode->src[1] : NULL);
+      if (m.kind == MEM_TYPED) {
+         need = 4;
+      }
+      ureg_MOV(ureg, t, ureg_imm1u(ureg, 0));
+      {
+         struct ureg_dst loaded = ureg_writemask(t, (1 << MAX2(need, 1)) - 1);
+         ureg_memory_insn(ureg, TGSI_OPCODE_LOAD, &loaded, 1, src, 2, m.qualifier,
+                          m.kind == MEM_TYPED ? m.target : 0, m.format);
+      }
+      ureg_MOV(ureg, translate_dst_operand(sx, &opcode->dst[0], opcode->saturate),
+               ureg_swizzle(ureg_src(t), res->swizzle[0], res->swizzle[1], res->swizzle[2], res->swizzle[3]));
+      ureg_release_temporary(ureg, t);
+      ureg_release_temporary(ureg, addr);
+      return true;
+   }
+
+   case D3D11_SB_OPCODE_STORE_UAV_TYPED:
+   case D3D11_SB_OPCODE_STORE_RAW:
+   case D3D11_SB_OPCODE_STORE_STRUCTURED: {
+      /* the written components go to consecutive dwords from the address (raw/structured), the texel (typed) */
+      struct ureg_dst dst;
+      unsigned mask = opcode->dst[0].mask >> D3D10_SB_OPERAND_4_COMPONENT_MASK_SHIFT;
+      bool structured = opcode->type == D3D11_SB_OPCODE_STORE_STRUCTURED;
+      m = mem_ref(sx, &opcode->dst[0].base);
+      if (m.kind == MEM_NONE) {
+         LOG_UNSUPPORTED(true);
+         return true;
+      }
+      addr = ureg_DECL_temporary(ureg);
+      src[0] = mem_address(sx, &m, addr, &opcode->src[0], structured ? &opcode->src[1] : NULL);
+      src[1] = translate_src_operand(sx, &opcode->src[structured ? 2 : 1], OF_UINT);
+      dst = ureg_writemask(ureg_dst(m.reg), m.kind == MEM_TYPED || !mask ? TGSI_WRITEMASK_XYZW : mask);
+      ureg_memory_insn(ureg, TGSI_OPCODE_STORE, &dst, 1, src, 2, m.qualifier,
+                       m.kind == MEM_TYPED ? m.target : 0, m.format);
+      ureg_release_temporary(ureg, addr);
+      return true;
+   }
+
+   case D3D11_SB_OPCODE_ATOMIC_AND:
+   case D3D11_SB_OPCODE_ATOMIC_OR:
+   case D3D11_SB_OPCODE_ATOMIC_XOR:
+   case D3D11_SB_OPCODE_ATOMIC_CMP_STORE:
+   case D3D11_SB_OPCODE_ATOMIC_IADD:
+   case D3D11_SB_OPCODE_ATOMIC_IMAX:
+   case D3D11_SB_OPCODE_ATOMIC_IMIN:
+   case D3D11_SB_OPCODE_ATOMIC_UMAX:
+   case D3D11_SB_OPCODE_ATOMIC_UMIN:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_IADD:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_AND:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_OR:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_XOR:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_EXCH:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_CMP_EXCH:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_IMAX:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_IMIN:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_UMAX:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_UMIN: {
+      /* atomic_*: dst0 the resource; imm_atomic_*: dst0 the old value, dst1 the resource; then the address and
+       * the value (compare and value for the compare-exchanges) */
+      bool imm = opcode->num_dst == 2;
+      const struct Shader_dst_operand *res = &opcode->dst[imm ? 1 : 0];
+      unsigned nsrc = opcode->num_src;
+      struct ureg_dst out;
+      m = mem_ref(sx, &res->base);
+      atom = atomic_opcode(opcode->type);
+      if (m.kind == MEM_NONE || atom == TGSI_OPCODE_LAST) {
+         LOG_UNSUPPORTED(true);
+         return true;
+      }
+      t = ureg_DECL_temporary(ureg);
+      addr = ureg_DECL_temporary(ureg);
+      src[0] = m.reg;
+      src[1] = mem_address(sx, &m, addr, &opcode->src[0], NULL);
+      src[2] = ureg_scalar(translate_src_operand(sx, &opcode->src[1], OF_UINT), TGSI_SWIZZLE_X);
+      if (nsrc > 2) {
+         src[3] = ureg_scalar(translate_src_operand(sx, &opcode->src[2], OF_UINT), TGSI_SWIZZLE_X);
+      }
+      out = ureg_writemask(t, TGSI_WRITEMASK_X);
+      ureg_memory_insn(ureg, atom, &out, 1, src, nsrc > 2 ? 4 : 3, m.qualifier,
+                       m.kind == MEM_TYPED ? m.target : 0, m.format);
+      if (imm && opcode->dst[0].base.type != D3D10_SB_OPERAND_TYPE_NULL) {
+         ureg_MOV(ureg, translate_dst_operand(sx, &opcode->dst[0], false), ureg_scalar(ureg_src(t), TGSI_SWIZZLE_X));
+      }
+      ureg_release_temporary(ureg, t);
+      ureg_release_temporary(ureg, addr);
+      return true;
+   }
+
+   case D3D11_SB_OPCODE_IMM_ATOMIC_ALLOC:
+   case D3D11_SB_OPCODE_IMM_ATOMIC_CONSUME: {
+      /* append/consume: the UAV's hidden counter; alloc returns the count before, consume the count after */
+      unsigned u = opcode->src[0].base.index[0].imm;   /* imm_atomic_alloc dst, u# */
+      struct Shader_uav *uav = u < SHADER_MAX_UAVS ? &sx->uavs[u] : NULL;
+      struct ureg_dst out;
+      if (!uav || !uav->declared) {
+         LOG_UNSUPPORTED(true);
+         return true;
+      }
+      if (!uav->has_counter) {
+         uav->has_counter = true;
+         uav->counter = buffer_slot(sx, SHADER_BUFFER_UAV_COUNTER, u);
+      }
+      t = ureg_DECL_temporary(ureg);
+      out = ureg_writemask(t, TGSI_WRITEMASK_X);
+      src[0] = uav->counter;
+      src[1] = ureg_imm1u(ureg, 0);
+      src[2] = opcode->type == D3D11_SB_OPCODE_IMM_ATOMIC_ALLOC ? ureg_imm1u(ureg, 1) : ureg_imm1u(ureg, ~0u);
+      ureg_memory_insn(ureg, TGSI_OPCODE_ATOMUADD, &out, 1, src, 3, 0, 0, PIPE_FORMAT_NONE);
+      if (opcode->type == D3D11_SB_OPCODE_IMM_ATOMIC_CONSUME) {
+         ureg_UADD(ureg, out, ureg_scalar(ureg_src(t), TGSI_SWIZZLE_X), ureg_imm1u(ureg, ~0u));
+      }
+      ureg_MOV(ureg, translate_dst_operand(sx, &opcode->dst[0], false), ureg_scalar(ureg_src(t), TGSI_SWIZZLE_X));
+      ureg_release_temporary(ureg, t);
+      return true;
+   }
+
+   case D3D11_SB_OPCODE_SYNC: {
+      unsigned f = opcode->specific.sync_flags, membar = 0;
+      if (f & D3D11_SB_SYNC_THREAD_GROUP_SHARED_MEMORY) {
+         membar |= TGSI_MEMBAR_SHARED;
+      }
+      if (f & D3D11_SB_SYNC_UNORDERED_ACCESS_VIEW_MEMORY_GROUP) {
+         membar |= TGSI_MEMBAR_SHADER_BUFFER | TGSI_MEMBAR_SHADER_IMAGE | TGSI_MEMBAR_THREAD_GROUP;
+      }
+      if (f & D3D11_SB_SYNC_UNORDERED_ACCESS_VIEW_MEMORY_GLOBAL) {
+         membar |= TGSI_MEMBAR_SHADER_BUFFER | TGSI_MEMBAR_SHADER_IMAGE;
+      }
+      if (membar) {
+         ureg_MEMBAR(ureg, ureg_imm1u(ureg, membar));
+      }
+      if (f & D3D11_SB_SYNC_THREADS_IN_GROUP) {
+         ureg_BARRIER(ureg);
+      }
+      return true;
+   }
+
+   case D3D11_SB_OPCODE_BUFINFO:
+   case D3D10_SB_OPCODE_RESINFO: {
+      /* raw: bytes, structured: elements, typed UAVs: their size (resinfo: and one mip level) */
+      const struct Shader_src_operand *res = &opcode->src[opcode->type == D3D11_SB_OPCODE_BUFINFO ? 0 : 1];
+      struct ureg_dst out;
+      if (res->base.type != D3D11_SB_OPERAND_TYPE_UNORDERED_ACCESS_VIEW &&
+          !(res->base.type == D3D10_SB_OPERAND_TYPE_RESOURCE && res->base.index[0].imm < SHADER_MAX_RESOURCES &&
+            sx->srv_buffers[res->base.index[0].imm].declared)) {
+         return false;  /* textures and typed buffer views */
+      }
+      m = mem_ref(sx, &res->base);
+      if (m.kind == MEM_NONE) {
+         LOG_UNSUPPORTED(true);
+         return true;
+      }
+      t = ureg_DECL_temporary(ureg);
+      ureg_MOV(ureg, t, ureg_imm1u(ureg, 0));
+      /* as many components as the GLSL size has (a buffer's length is a scalar) */
+      if (m.kind != MEM_TYPED || m.target == TGSI_TEXTURE_BUFFER || m.target == TGSI_TEXTURE_1D) {
