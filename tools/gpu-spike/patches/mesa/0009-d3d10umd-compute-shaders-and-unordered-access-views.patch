+enum mem_kind {
+   MEM_NONE,
+   MEM_TYPED,
+   MEM_BUFFER,
+   MEM_SHARED,
+};
+
+struct mem_ref {
+   enum mem_kind kind;
+   struct ureg_src reg;
+   bool structured;
+   unsigned stride;            /* structured */
+   unsigned base;              /* shared memory region */
+   uint target;                /* typed */
+   enum pipe_format format;
+   unsigned qualifier;
+   const struct Shader_uav *uav;
+};
+
+static struct mem_ref
+mem_ref(struct Shader_xlate *sx, const struct Shader_operand *op)
+{
+   struct mem_ref m;
+   unsigned i = op->index[0].imm;
+
+   memset(&m, 0, sizeof m);
+   switch (op->type) {
+   case D3D11_SB_OPERAND_TYPE_UNORDERED_ACCESS_VIEW:
+      if (i < SHADER_MAX_UAVS && sx->uavs[i].declared) {
+         const struct Shader_uav *uav = &sx->uavs[i];
+         m.kind = uav->typed ? MEM_TYPED : MEM_BUFFER;
+         m.reg = uav->reg;
+         m.stride = uav->stride;
+         m.structured = uav->stride != 0;
+         m.target = uav->target;
+         m.format = uav->format;
+         m.qualifier = uav->qualifier;
+         m.uav = uav;
+      }
+      break;
+   case D3D10_SB_OPERAND_TYPE_RESOURCE:
+      if (i < SHADER_MAX_RESOURCES && sx->srv_buffers[i].declared) {
+         m.kind = MEM_BUFFER;
+         m.reg = sx->srv_buffers[i].reg;
+         m.stride = sx->srv_buffers[i].stride;
+         m.structured = m.stride != 0;
+      }
+      break;
+   case D3D11_SB_OPERAND_TYPE_THREAD_GROUP_SHARED_MEMORY:
+      if (i < SHADER_MAX_TGSM) {
+         m.kind = MEM_SHARED;
+         m.reg = sx->memory;
+         m.stride = sx->tgsm[i].stride;
+         m.structured = sx->tgsm[i].structured;
+         m.base = sx->tgsm[i].base;
+      }
+      break;
+   default:
+      break;
+   }
+   return m;
+}
