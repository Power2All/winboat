+/*
+ * Shader model 5 memory: typed UAVs are TGSI images, raw and structured UAVs and views TGSI buffers (byte
+ * addresses: raw ones as given, structured ones index * stride + offset), group shared memory one TGSI shared
+ * memory block holding every g# region. The driver binds them by Shader_bindings.
+ */
+static struct ureg_src
+buffer_slot(struct Shader_xlate *sx, enum Shader_buffer_kind kind, unsigned index)
+{
+   struct Shader_bindings *b = &sx->bindings;
+   unsigned k;
+
+   if (b->num_buffers == SHADER_MAX_BUFFER_SLOTS) {
+      LOG_UNSUPPORTED(true);
+      k = 0;
+   } else {
+      k = b->num_buffers++;
+      b->buffer[k].kind = kind;
+      b->buffer[k].index = index;
+   }
+   return ureg_DECL_buffer(sx->ureg, k, false);
+}
+
+static void
+dcl_uav(struct Shader_xlate *sx, const struct Shader_opcode *opcode)
+{
+   unsigned u = opcode->dst[0].base.index[0].imm;
+   struct Shader_uav *uav;
+
+   if (u >= SHADER_MAX_UAVS) {
+      LOG_UNSUPPORTED(true);
+      return;
+   }
+   uav = &sx->uavs[u];
+   memset(uav, 0, sizeof *uav);
+   uav->declared = true;
+   /* GLSL makes other invocations' writes visible to coherent accesses only, D3D's UAV barriers do it for all */
+   uav->qualifier = (opcode->specific.dcl_uav.flags & D3D11_SB_GLOBALLY_COHERENT_ACCESS) || sx->uav_sync ?
+                    TGSI_MEMORY_COHERENT : 0;
+   if (opcode->type == D3D11_SB_OPCODE_DCL_UNORDERED_ACCESS_VIEW_TYPED) {
+      struct Shader_bindings *b = &sx->bindings;
+      enum tgsi_return_type ret = trans_dcl_ret_type(opcode->dcl_resource_ret_type[0]);
+      unsigned k;
+      /* Loads and atomics need the format in GLSL; D3D allows them on single 32-bit channels only. Stores alone
+       * don't, but the GLSL image type comes from it: integer images get the 32-bit integer formats. */
+      uav->typed = true;
+      uav->target = translate_resource_dimension(opcode->specific.dcl_uav.dimension);
+      uav->format = ret == TGSI_RETURN_TYPE_SINT ? PIPE_FORMAT_R32_SINT :
+                    ret == TGSI_RETURN_TYPE_UINT ? PIPE_FORMAT_R32_UINT :
+                    sx->uav_read[u] ? PIPE_FORMAT_R32_FLOAT : PIPE_FORMAT_NONE;
+      if (b->num_images == SHADER_MAX_IMAGE_SLOTS) {
+         LOG_UNSUPPORTED(true);
+         return;
+      }
+      k = b->num_images++;
+      if (sx->image_formats && sx->image_formats[k] != PIPE_FORMAT_NONE) {
+         /* a variant for the bound view's format (virglrenderer declares format-less images rgba32f, which
+          * mismatches other formats): when its kind (float, signed, unsigned) is the declared one */
+         enum pipe_format f = sx->image_formats[k];
+         bool f_sint = util_format_is_pure_sint(f), f_uint = util_format_is_pure_uint(f);
+         if ((ret == TGSI_RETURN_TYPE_SINT && f_sint) || (ret == TGSI_RETURN_TYPE_UINT && f_uint) ||
+             (ret != TGSI_RETURN_TYPE_SINT && ret != TGSI_RETURN_TYPE_UINT && !f_sint && !f_uint)) {
+            uav->format = f;
+         }
+      }
+      b->image_uav[k] = u;
+      uav->reg = ureg_DECL_image(sx->ureg, k, uav->target, uav->format, true, false);
+   } else {
+      uav->stride = opcode->type == D3D11_SB_OPCODE_DCL_UNORDERED_ACCESS_VIEW_STRUCTURED ?
+                    opcode->specific.dcl_uav.stride : 0;
+      uav->reg = buffer_slot(sx, SHADER_BUFFER_UAV, u);
+   }
+}
+
+static void
+dcl_srv_buffer(struct Shader_xlate *sx, const struct Shader_opcode *opcode)
+{
+   unsigned t = opcode->dst[0].base.index[0].imm;
+
+   if (t >= SHADER_MAX_RESOURCES) {
+      LOG_UNSUPPORTED(true);
+      return;
+   }
+   sx->resources[t].target = TGSI_TEXTURE_BUFFER;
+   sx->srv_buffers[t].declared = true;
+   sx->srv_buffers[t].stride = opcode->type == D3D11_SB_OPCODE_DCL_RESOURCE_STRUCTURED ?
+                               opcode->specific.dcl_structure_stride : 0;
+   sx->srv_buffers[t].reg = buffer_slot(sx, SHADER_BUFFER_SRV, t);
+}
+
+static void
+dcl_tgsm(struct Shader_xlate *sx, const struct Shader_opcode *opcode)
+{
+   unsigned g = opcode->dst[0].base.index[0].imm;
+
+   if (g >= SHADER_MAX_TGSM) {
+      LOG_UNSUPPORTED(true);
+      return;
+   }
+   if (!sx->bindings.shared_mem) {
+      sx->memory = ureg_DECL_memory(sx->ureg, TGSI_MEMORY_TYPE_SHARED);
+   }
+   sx->tgsm[g].base = sx->bindings.shared_mem;
+   sx->tgsm[g].stride = opcode->specific.dcl_tgsm.stride;
+   sx->tgsm[g].structured = opcode->type == D3D11_SB_OPCODE_DCL_THREAD_GROUP_SHARED_MEMORY_STRUCTURED;
+   sx->bindings.shared_mem += align(opcode->specific.dcl_tgsm.stride * opcode->specific.dcl_tgsm.count, 4);
+}
+
+/* The thread IDs a compute shader declared, once the thread group size is known too: in group and group IDs are
+ * TGSI's, the ID in the dispatch is group * size + in group, the flattened one z * w * h + y * w + x. */
+static void
+cs_inputs(struct Shader_xlate *sx)
+{
+   struct ureg_program *ureg = sx->ureg;
+   const unsigned *bs = sx->bindings.block;
+   struct ureg_src tid, gid;
+
+   if (!bs[0]) {
+      return;
+   }
+   /* GLSL's IDs are 3-component: never read .w */
+   tid = ureg_swizzle(ureg_DECL_system_value(ureg, TGSI_SEMANTIC_THREAD_ID, 0),
+                      TGSI_SWIZZLE_X, TGSI_SWIZZLE_Y, TGSI_SWIZZLE_Z, TGSI_SWIZZLE_Z);
+   gid = ureg_swizzle(ureg_DECL_system_value(ureg, TGSI_SEMANTIC_BLOCK_ID, 0),
+                      TGSI_SWIZZLE_X, TGSI_SWIZZLE_Y, TGSI_SWIZZLE_Z, TGSI_SWIZZLE_Z);
+   for (unsigned i = 0; i < 5; i++) {
+      struct ureg_dst t;
+      if (!sx->cs_input_wanted[i] || sx->cs_input_done[i]) {
+         continue;
+      }
+      sx->cs_input_done[i] = true;
+      switch (i + D3D11_SB_OPERAND_TYPE_INPUT_THREAD_ID) {
+      case D3D11_SB_OPERAND_TYPE_INPUT_THREAD_ID:
+         t = ureg_DECL_temporary(ureg);
+         ureg_UMAD(ureg, ureg_writemask(t, TGSI_WRITEMASK_XYZ), gid, ureg_imm4u(ureg, bs[0], bs[1], bs[2], 0), tid);
+         sx->cs_input[i] = ureg_src(t);
+         break;
+      case D3D11_SB_OPERAND_TYPE_INPUT_THREAD_GROUP_ID:
+         sx->cs_input[i] = gid;
+         break;
+      case D3D11_SB_OPERAND_TYPE_INPUT_THREAD_ID_IN_GROUP:
+         sx->cs_input[i] = tid;
+         break;
+      case D3D11_SB_OPERAND_TYPE_INPUT_THREAD_ID_IN_GROUP_FLATTENED:
+         t = ureg_DECL_temporary(ureg);
+         ureg_UMAD(ureg, ureg_writemask(t, TGSI_WRITEMASK_X), ureg_scalar(tid, TGSI_SWIZZLE_Y),
+                   ureg_imm1u(ureg, bs[0]), ureg_scalar(tid, TGSI_SWIZZLE_X));
+         ureg_UMAD(ureg, ureg_writemask(t, TGSI_WRITEMASK_X), ureg_scalar(tid, TGSI_SWIZZLE_Z),
+                   ureg_imm1u(ureg, bs[0] * bs[1]), ureg_scalar(ureg_src(t), TGSI_SWIZZLE_X));
+         sx->cs_input[i] = ureg_scalar(ureg_src(t), TGSI_SWIZZLE_X);
+         break;
+      default:
+         break;
+      }
+   }
+}
