+++ b/src/gallium/frontends/d3d10umd/Shader.cpp
@@ -40,6 +40,63 @@
 #include "Format.h"
 
 #include "tgsi/tgsi_ureg.h"
+
+extern "C" bool use_old_tex_ops;
+
+/* virgl: shaders sample through slots of their own (Shader_tex_slots), bound at draw time */
+static bool
+UseTexSlots(void)
+{
+   return use_old_tex_ops || (st_debug & ST_DEBUG_OLD_TEX_OPS);
+}
+
+
+/*
+ * ----------------------------------------------------------------------
+ *
+ * ShaderBindTexSlots --
+ *
+ *    virgl: binds each slot of the bound shaders to its view and sampler state, where a shader, view or sampler
+ *    changed since the last draw.
+ *
+ * ----------------------------------------------------------------------
+ */
+
+void
+ShaderBindTexSlots(Device *pDevice)
+{
+   static const enum pipe_shader_type stages[] = {
+      PIPE_SHADER_VERTEX, PIPE_SHADER_GEOMETRY, PIPE_SHADER_FRAGMENT
+   };
+   struct pipe_context *pipe = pDevice->pipe;
+
+   if (!UseTexSlots()) {
+      return;
+   }
+   for (unsigned s = 0; s < ARRAY_SIZE(stages); s++) {
+      enum pipe_shader_type type = stages[s];
+      const Shader *shader = pDevice->bound_shader[type];
+      struct pipe_sampler_view *views[PIPE_MAX_SAMPLERS];
+      void *samplers[PIPE_MAX_SAMPLERS];
+
+      if (!pDevice->tex_slots_dirty[type]) {
+         continue;
+      }
+      pDevice->tex_slots_dirty[type] = false;
+
+      memset(views, 0, sizeof views);
+      memset(samplers, 0, sizeof samplers);
+      for (unsigned i = 0; shader && i < shader->tex_slots.count; i++) {
+         const struct Shader_tex_slot *slot = &shader->tex_slots.slot[i];
+         views[i] = pDevice->sampler_views[type][slot->view];
+         if (slot->sampler != SHADER_TEX_SLOT_NO_SAMPLER) {
+            samplers[i] = pDevice->samplers[type][slot->sampler];
+         }
+      }
+      pipe->set_sampler_views(pipe, type, 0, PIPE_MAX_SAMPLERS, 0, false, views);
+      pipe->bind_sampler_states(pipe, type, 0, PIPE_MAX_SAMPLERS, samplers);
+   }
+}
