+   case D3D10_SB_OPCODE_SAMPLE_B:
+   case D3D10_SB_OPCODE_SAMPLE_L: {
+      /* the bias or LOD goes in .w, or (cube arrays, whose coordinate has 4 components) in a second operand */
+      bool bias = opcode->type == D3D10_SB_OPCODE_SAMPLE_B;
+      struct ureg_src value = ureg_scalar(translate_src_operand(sx, &opcode->src[3], OF_FLOAT), TGSI_SWIZZLE_X);
+      if (target == TGSI_TEXTURE_CUBE_ARRAY) {
+         src[0] = translate_src_operand(sx, &opcode->src[0], OF_FLOAT);
+         src[1] = value;
+         src[2] = tex_slot(sx, view, sampler, false);
+         tex_insn(sx, bias ? TGSI_OPCODE_TXB2 : TGSI_OPCODE_TXL2, target, texel, &off, num_off, src, 3);
+      } else {
+         ureg_MOV(ureg, c, translate_src_operand(sx, &opcode->src[0], OF_FLOAT));
+         ureg_MOV(ureg, ureg_writemask(c, TGSI_WRITEMASK_W), value);
+         src[0] = ureg_src(c);
+         src[1] = tex_slot(sx, view, sampler, false);
+         tex_insn(sx, bias ? TGSI_OPCODE_TXB : TGSI_OPCODE_TXL, target, texel, &off, num_off, src, 2);
+      }
+      break;
+   }
+
+   case D3D10_SB_OPCODE_SAMPLE_D:
+      src[0] = translate_src_operand(sx, &opcode->src[0], OF_FLOAT);
+      src[1] = translate_src_operand(sx, &opcode->src[3], OF_FLOAT);
+      src[2] = translate_src_operand(sx, &opcode->src[4], OF_FLOAT);
+      src[3] = tex_slot(sx, view, sampler, false);
+      tex_insn(sx, TGSI_OPCODE_TXD, target, texel, &off, num_off, src, 4);
+      break;
+
+   case D3D10_SB_OPCODE_SAMPLE_C:
+   case D3D10_SB_OPCODE_SAMPLE_C_LZ: {
+      /* the reference value goes in .z (1D, 2D, 1D arrays), .w (2D arrays, cubes) or a second operand (cube
+       * arrays); level 0 explicitly: textureLod has no 2D array and cube shadow forms in core GLSL, textureGrad
+       * with zero derivatives does the same */
+      bool lz = opcode->type == D3D10_SB_OPCODE_SAMPLE_C_LZ;
+      struct ureg_src ref = ureg_scalar(translate_src_operand(sx, &opcode->src[3], OF_FLOAT), TGSI_SWIZZLE_X);
+      struct ureg_src samp = tex_slot(sx, view, sampler, true);
+      if (st == TGSI_TEXTURE_SHADOWCUBE_ARRAY) {
+         src[0] = translate_src_operand(sx, &opcode->src[0], OF_FLOAT);
+         if (lz) {
+            ureg_MOV(ureg, ureg_writemask(c, TGSI_WRITEMASK_X), ref);
+            ureg_MOV(ureg, ureg_writemask(c, TGSI_WRITEMASK_Y), ureg_imm1f(ureg, 0.0f));
+            src[1] = ureg_src(c);
+         } else {
+            src[1] = ref;
+         }
+         src[2] = samp;
+         tex_insn(sx, lz ? TGSI_OPCODE_TXL2 : TGSI_OPCODE_TEX2, st, texel, &off, num_off, src, 3);
+         break;
+      }
+      ureg_MOV(ureg, c, translate_src_operand(sx, &opcode->src[0], OF_FLOAT));
+      if (st == TGSI_TEXTURE_SHADOW2D_ARRAY || st == TGSI_TEXTURE_SHADOWCUBE) {
+         ureg_MOV(ureg, ureg_writemask(c, TGSI_WRITEMASK_W), ref);
+      } else {
+         ureg_MOV(ureg, ureg_writemask(c, TGSI_WRITEMASK_Z), ref);
+      }
+      src[0] = ureg_src(c);
+      if (!lz) {
+         src[1] = samp;
+         tex_insn(sx, TGSI_OPCODE_TEX, st, texel, &off, num_off, src, 2);
+      } else if (st == TGSI_TEXTURE_SHADOW2D_ARRAY || st == TGSI_TEXTURE_SHADOWCUBE) {
+         src[1] = ureg_imm1f(ureg, 0.0f);
+         src[2] = ureg_imm1f(ureg, 0.0f);
+         src[3] = samp;
+         tex_insn(sx, TGSI_OPCODE_TXD, st, texel, &off, num_off, src, 4);
+      } else {
+         ureg_MOV(ureg, ureg_writemask(c, TGSI_WRITEMASK_W), ureg_imm1f(ureg, 0.0f));
+         src[1] = samp;
+         tex_insn(sx, TGSI_OPCODE_TXL, st, texel, &off, num_off, src, 2);
+      }
+      break;
+   }
+
+   case D3D10_1_SB_OPCODE_GATHER4:
+   case D3D11_SB_OPCODE_GATHER4_C:
+   case D3D11_SB_OPCODE_GATHER4_PO:
+   case D3D11_SB_OPCODE_GATHER4_PO_C: {
+      /* the component to gather is the sampler operand's swizzle (red before shader model 5); the programmable
+       * offset (_po) is a register */
+      bool po = opcode->type == D3D11_SB_OPCODE_GATHER4_PO || opcode->type == D3D11_SB_OPCODE_GATHER4_PO_C;
+      struct ureg_dst offset_reg = ureg_dst_undef();
+      unsigned component = opcode->src[res_op + 1].swizzle[0];
+      struct ureg_src samp = tex_slot(sx, view, sampler, shadow);
+
+      if (po) {
+         offset_reg = ureg_DECL_temporary(ureg);
+         ureg_MOV(ureg, offset_reg, translate_src_operand(sx, &opcode->src[1], OF_INT));
+         memset(&off, 0, sizeof off);
+         off.File = TGSI_FILE_TEMPORARY;
+         off.Index = offset_reg.Index;
+         off.SwizzleX = TGSI_SWIZZLE_X;
+         off.SwizzleY = TGSI_SWIZZLE_Y;
+         off.SwizzleZ = TGSI_SWIZZLE_Z;
+         num_off = 1;
+      }
+      if (shadow) {
+         struct ureg_src ref = ureg_scalar(translate_src_operand(sx, &opcode->src[res_op + 2], OF_FLOAT),
+                                           TGSI_SWIZZLE_X);
+         ureg_MOV(ureg, c, translate_src_operand(sx, &opcode->src[0], OF_FLOAT));
+         src[1] = ureg_imm1u(ureg, 0);
+         if (st == TGSI_TEXTURE_SHADOWCUBE_ARRAY) {
+            src[1] = ref;
+         } else if (st == TGSI_TEXTURE_SHADOW2D_ARRAY || st == TGSI_TEXTURE_SHADOWCUBE) {
+            ureg_MOV(ureg, ureg_writemask(c, TGSI_WRITEMASK_W), ref);
+         } else {
+            ureg_MOV(ureg, ureg_writemask(c, TGSI_WRITEMASK_Z), ref);
+         }
+         src[0] = ureg_src(c);
+      } else {
+         src[0] = translate_src_operand(sx, &opcode->src[0], OF_FLOAT);
+         src[1] = ureg_imm1u(ureg, component);
+      }
+      src[2] = samp;
+      tex_insn(sx, TGSI_OPCODE_TG4, st, texel, &off, num_off, src, 3);
+      if (po) {
+         ureg_release_temporary(ureg, offset_reg);
+      }
+      break;
+   }
+
+   case D3D10_1_SB_OPCODE_LOD:
+      /* .x clamped, .y unclamped LOD */
+      ureg_MOV(ureg, texel, ureg_imm1f(ureg, 0.0f));
+      src[0] = translate_src_operand(sx, &opcode->src[0], OF_FLOAT);
+      src[1] = tex_slot(sx, view, sampler, false);
+      tex_insn(sx, TGSI_OPCODE_LODQ, target, ureg_writemask(texel, TGSI_WRITEMASK_XY), NULL, 0, src, 2);
+      break;
+
+   case D3D10_SB_OPCODE_LD:
+      /* the mip level is in .w already, like TXF's */
+      src[0] = translate_src_operand(sx, &opcode->src[0], OF_INT);
+      src[1] = tex_slot(sx, view, SHADER_TEX_SLOT_NO_SAMPLER, false);
+      tex_insn(sx, TGSI_OPCODE_TXF, target, texel, &off, num_off, src, 2);
+      break;
+
+   case D3D10_SB_OPCODE_LD_MS:
+      /* the sample index goes in .w */
+      ureg_MOV(ureg, c, translate_src_operand(sx, &opcode->src[0], OF_INT));
+      ureg_MOV(ureg, ureg_writemask(c, TGSI_WRITEMASK_W),
+               ureg_scalar(translate_src_operand(sx, &opcode->src[2], OF_INT), TGSI_SWIZZLE_X));
+      src[0] = ureg_src(c);
+      src[1] = tex_slot(sx, view, SHADER_TEX_SLOT_NO_SAMPLER, false);
+      tex_insn(sx, TGSI_OPCODE_TXF, target, texel, &off, num_off, src, 2);
+      break;
+
+   case D3D10_SB_OPCODE_RESINFO: {
+      /* width, height, depth or array size, mip count; integers, floats, or (rcpfloat) the sizes inverted */
+      unsigned dims = tex_size_dims(target);
+      ureg_MOV(ureg, texel, ureg_imm1u(ureg, 0));
+      src[0] = ureg_scalar(translate_src_operand(sx, &opcode->src[0], OF_UINT), TGSI_SWIZZLE_X);
+      src[1] = tex_slot(sx, view, SHADER_TEX_SLOT_NO_SAMPLER, false);
+      tex_insn(sx, TGSI_OPCODE_TXQ, target, texel, NULL, 0, src, 2);
+      if (opcode->specific.resinfo_ret_type != D3D10_SB_RESINFO_INSTRUCTION_RETURN_UINT) {
+         ureg_U2F(ureg, texel, ureg_src(texel));
+      }
+      if (opcode->specific.resinfo_ret_type == D3D10_SB_RESINFO_INSTRUCTION_RETURN_RCPFLOAT) {
+         for (unsigned i = 0; i < dims; i++) {
+            ureg_RCP(ureg, ureg_writemask(texel, 1 << i), ureg_scalar(ureg_src(texel), i));
+         }
+      }
+      break;
+   }
+
+   case D3D10_1_SB_OPCODE_SAMPLE_INFO:
+      /* the sample count in .x */
+      if (target == TGSI_TEXTURE_2D_MSAA || target == TGSI_TEXTURE_2D_ARRAY_MSAA) {
+         ureg_MOV(ureg, texel, ureg_imm1u(ureg, 0));
+         src[0] = tex_slot(sx, view, SHADER_TEX_SLOT_NO_SAMPLER, false);
+         tex_insn(sx, TGSI_OPCODE_TXQS, target, ureg_writemask(texel, TGSI_WRITEMASK_X), NULL, 0, src, 1);
+      } else {
+         ureg_MOV(ureg, texel, ureg_imm4u(ureg, 1, 0, 0, 0));
+      }
+      if (opcode->specific.instruction_return_type != D3D10_SB_INSTRUCTION_RETURN_UINT) {
+         ureg_U2F(ureg, texel, ureg_src(texel));
+      }
+      break;
+
+   case D3D10_1_SB_OPCODE_SAMPLE_POS: {
+      /* the standard pattern's position of sample src1 of the texture's count, (0, 0) out of range */
+      unsigned table[32 * 4];
+      struct ureg_src positions;
+      struct ureg_dst addr = ureg_DECL_address(ureg);
+      struct ureg_src index = ureg_scalar(translate_src_operand(sx, &opcode->src[1], OF_UINT), TGSI_SWIZZLE_X);
+
+      memset(table, 0, sizeof table);
+      for (unsigned i = 0; i < 31; i++) {
+         float x = standard_sample_positions[i][0] / 16.0f, y = standard_sample_positions[i][1] / 16.0f;
+         memcpy(&table[i * 4 + 0], &x, 4);
+         memcpy(&table[i * 4 + 1], &y, 4);
+      }
+      positions = ureg_DECL_immediate_block_uint(ureg, table, 32 * 4);
+
+      /* c.x = count, c.y = count - 1 + index, c.z = index < count && count <= 16 */
+      ureg_MOV(ureg, ureg_writemask(c, TGSI_WRITEMASK_X), ureg_imm1u(ureg, 1));
+      if (target == TGSI_TEXTURE_2D_MSAA || target == TGSI_TEXTURE_2D_ARRAY_MSAA) {
+         src[0] = tex_slot(sx, view, SHADER_TEX_SLOT_NO_SAMPLER, false);
+         tex_insn(sx, TGSI_OPCODE_TXQS, target, ureg_writemask(c, TGSI_WRITEMASK_X), NULL, 0, src, 1);
+      }
+      ureg_UADD(ureg, ureg_writemask(c, TGSI_WRITEMASK_Y), ureg_scalar(ureg_src(c), TGSI_SWIZZLE_X), index);
+      ureg_UADD(ureg, ureg_writemask(c, TGSI_WRITEMASK_Y), ureg_scalar(ureg_src(c), TGSI_SWIZZLE_Y),
+                ureg_imm1i(ureg, -1));
+      ureg_USLT(ureg, ureg_writemask(c, TGSI_WRITEMASK_Z), index, ureg_scalar(ureg_src(c), TGSI_SWIZZLE_X));
+      ureg_USGE(ureg, ureg_writemask(c, TGSI_WRITEMASK_W), ureg_imm1u(ureg, 16),
+                ureg_scalar(ureg_src(c), TGSI_SWIZZLE_X));
+      ureg_AND(ureg, ureg_writemask(c, TGSI_WRITEMASK_Z), ureg_scalar(ureg_src(c), TGSI_SWIZZLE_Z),
+               ureg_scalar(ureg_src(c), TGSI_SWIZZLE_W));
+      ureg_UMIN(ureg, ureg_writemask(c, TGSI_WRITEMASK_Y), ureg_scalar(ureg_src(c), TGSI_SWIZZLE_Y),
+                ureg_imm1u(ureg, 31));
+      ureg_UARL(ureg, ureg_writemask(addr, TGSI_WRITEMASK_X), ureg_scalar(ureg_src(c), TGSI_SWIZZLE_Y));
+      ureg_UCMP(ureg, texel, ureg_scalar(ureg_src(c), TGSI_SWIZZLE_Z),
+                ureg_src_indirect(positions, ureg_scalar(ureg_src(addr), TGSI_SWIZZLE_X)), ureg_imm1u(ureg, 0));
+      break;
+   }
+
+   case D3D11_SB_OPCODE_BUFINFO:
+      /* typed buffer views: the element count in .x */
+      ureg_MOV(ureg, texel, ureg_imm1u(ureg, 0));
+      src[0] = ureg_imm1u(ureg, 0);
+      src[1] = tex_slot(sx, view, SHADER_TEX_SLOT_NO_SAMPLER, false);
+      tex_insn(sx, TGSI_OPCODE_TXQ, target, ureg_writemask(texel, TGSI_WRITEMASK_X), NULL, 0, src, 2);
+      break;
+
+   default:
+      assert(0);
+   }
+
+   tex_result(sx, opcode, texel, &opcode->src[res_op]);
+   ureg_release_temporary(ureg, c);
+   ureg_release_temporary(ureg, texel);
+   return true;
+}
+
+/*
+ * Shader model 5 instructions that take more than one TGSI instruction. D3D defines results where GLSL doesn't
+ * (bit fields reaching past bit 31), counts bits from the other end (firstbit_hi), or has no TGSI/virgl
+ * counterpart (half floats: integer arithmetic).
+ */
+static bool
+translate_sm5_alu(struct Shader_xlate *sx, struct Shader_opcode *opcode)
+{
+   struct ureg_program *ureg = sx->ureg;
+   struct ureg_dst t[4];
+   struct ureg_src a, b, c;
+   unsigned i;
+
+   switch (opcode->type) {
+   case D3D11_SB_OPCODE_RCP:
+      expand_unary_to_scalarf(ureg, ureg_RCP, sx, opcode);
+      return true;
+
+   case D3D11_SB_OPCODE_FIRSTBIT_HI:
+   case D3D11_SB_OPCODE_FIRSTBIT_SHI:
+      /* the bit's position counted from bit 31; ~0 when there is none */
+      t[0] = ureg_DECL_temporary(ureg);
+      t[1] = ureg_DECL_temporary(ureg);
+      if (opcode->type == D3D11_SB_OPCODE_FIRSTBIT_HI) {
+         ureg_UMSB(ureg, t[0], translate_src_operand(sx, &opcode->src[0], OF_UINT));
+      } else {
+         ureg_IMSB(ureg, t[0], translate_src_operand(sx, &opcode->src[0], OF_INT));
+      }
+      ureg_INEG(ureg, t[1], ureg_src(t[0]));
+      ureg_UADD(ureg, t[1], ureg_src(t[1]), ureg_imm1u(ureg, 31));
+      ureg_USEQ(ureg, t[0], ureg_src(t[0]), ureg_imm1u(ureg, ~0u));
+      ureg_UCMP(ureg, translate_dst_operand(sx, &opcode->dst[0], opcode->saturate), ureg_src(t[0]),
+                ureg_imm1u(ureg, ~0u), ureg_src(t[1]));
+      ureg_release_temporary(ureg, t[0]);
+      ureg_release_temporary(ureg, t[1]);
+      return true;
+
+   case D3D11_SB_OPCODE_UBFE:
+   case D3D11_SB_OPCODE_IBFE: {
+      /* width and offset are 5 bits; a field reaching past bit 31 is the value shifted down */
+      bool is_signed = opcode->type == D3D11_SB_OPCODE_IBFE;
+      for (i = 0; i < 4; i++) {
+         t[i] = ureg_DECL_temporary(ureg);
+      }
+      c = translate_src_operand(sx, &opcode->src[2], is_signed ? OF_INT : OF_UINT);
+      ureg_AND(ureg, t[0], translate_src_operand(sx, &opcode->src[0], OF_UINT), ureg_imm1u(ureg, 31));
+      ureg_AND(ureg, t[1], translate_src_operand(sx, &opcode->src[1], OF_UINT), ureg_imm1u(ureg, 31));
+      if (is_signed) {
+         ureg_IBFE(ureg, t[2], c, ureg_src(t[1]), ureg_src(t[0]));
+         ureg_ISHR(ureg, t[3], c, ureg_src(t[1]));
+      } else {
+         ureg_UBFE(ureg, t[2], c, ureg_src(t[1]), ureg_src(t[0]));
+         ureg_USHR(ureg, t[3], c, ureg_src(t[1]));
+      }
+      ureg_UADD(ureg, t[0], ureg_src(t[0]), ureg_src(t[1]));
+      ureg_USLT(ureg, t[0], ureg_imm1u(ureg, 32), ureg_src(t[0]));
+      ureg_UCMP(ureg, translate_dst_operand(sx, &opcode->dst[0], opcode->saturate), ureg_src(t[0]),
+                ureg_src(t[3]), ureg_src(t[2]));
+      for (i = 0; i < 4; i++) {
+         ureg_release_temporary(ureg, t[i]);
+      }
+      return true;
+   }
+
+   case D3D11_SB_OPCODE_BFI:
+      /* bfi width, offset, insert, base: the inserted field is cut at bit 31 */
+      t[0] = ureg_DECL_temporary(ureg);
+      t[1] = ureg_DECL_temporary(ureg);
+      t[2] = ureg_DECL_temporary(ureg);
+      ureg_AND(ureg, t[0], translate_src_operand(sx, &opcode->src[0], OF_UINT), ureg_imm1u(ureg, 31));
+      ureg_AND(ureg, t[1], translate_src_operand(sx, &opcode->src[1], OF_UINT), ureg_imm1u(ureg, 31));
+      ureg_INEG(ureg, t[2], ureg_src(t[1]));
+      ureg_UADD(ureg, t[2], ureg_src(t[2]), ureg_imm1u(ureg, 32));
+      ureg_UMIN(ureg, t[0], ureg_src(t[0]), ureg_src(t[2]));
+      ureg_BFI(ureg, translate_dst_operand(sx, &opcode->dst[0], opcode->saturate),
+               translate_src_operand(sx, &opcode->src[3], OF_UINT), translate_src_operand(sx, &opcode->src[2], OF_UINT),
+               ureg_src(t[1]), ureg_src(t[0]));
+      for (i = 0; i < 3; i++) {
+         ureg_release_temporary(ureg, t[i]);
+      }
+      return true;
+
+   case D3D11_SB_OPCODE_F32TOF16: {
+      /* to half float bits (low 16), rounding toward zero (what WARP, the reference, does): too large finite
+       * values give the largest half, infinity infinity, NaN 0x7e00 */
+      struct ureg_dst f, sign, r, x, e;
+      f = ureg_DECL_temporary(ureg);
+      sign = ureg_DECL_temporary(ureg);
+      r = ureg_DECL_temporary(ureg);
+      x = ureg_DECL_temporary(ureg);
+      e = ureg_DECL_temporary(ureg);
+      ureg_MOV(ureg, f, translate_src_operand(sx, &opcode->src[0], OF_FLOAT));
+      ureg_AND(ureg, sign, ureg_src(f), ureg_imm1u(ureg, 0x80000000));
+      ureg_XOR(ureg, f, ureg_src(f), ureg_src(sign));
+      ureg_USHR(ureg, sign, ureg_src(sign), ureg_imm1u(ureg, 16));
+      /* normal: rebias the exponent, drop 13 bits */
+      ureg_UADD(ureg, r, ureg_src(f), ureg_imm1u(ureg, 0xc8000000));
+      ureg_USHR(ureg, r, ureg_src(r), ureg_imm1u(ureg, 13));
+      /* below 2^-14: the mantissa with its implicit bit, shifted down by 126 - exponent (all of it for zero and
+       * float denormals) */
+      ureg_AND(ureg, x, ureg_src(f), ureg_imm1u(ureg, 0x7fffff));
+      ureg_OR(ureg, x, ureg_src(x), ureg_imm1u(ureg, 0x800000));
+      ureg_USHR(ureg, e, ureg_src(f), ureg_imm1u(ureg, 23));
+      ureg_INEG(ureg, e, ureg_src(e));
+      ureg_UADD(ureg, e, ureg_src(e), ureg_imm1u(ureg, 126));
+      ureg_UMIN(ureg, e, ureg_src(e), ureg_imm1u(ureg, 31));
+      ureg_USHR(ureg, x, ureg_src(x), ureg_src(e));
+      ureg_USLT(ureg, e, ureg_src(f), ureg_imm1u(ureg, 0x38800000));
+      ureg_UCMP(ureg, r, ureg_src(e), ureg_src(x), ureg_src(r));
+      /* 65536 and above: the largest half; infinity; NaN */
+      ureg_USEQ(ureg, x, ureg_src(f), ureg_imm1u(ureg, 0x7f800000));
+      ureg_UCMP(ureg, x, ureg_src(x), ureg_imm1u(ureg, 0x7c00), ureg_imm1u(ureg, 0x7bff));
+      ureg_USLT(ureg, e, ureg_imm1u(ureg, 0x7f800000), ureg_src(f));
+      ureg_UCMP(ureg, x, ureg_src(e), ureg_imm1u(ureg, 0x7e00), ureg_src(x));
+      ureg_USGE(ureg, e, ureg_src(f), ureg_imm1u(ureg, 0x47800000));
+      ureg_UCMP(ureg, r, ureg_src(e), ureg_src(x), ureg_src(r));
+      ureg_OR(ureg, translate_dst_operand(sx, &opcode->dst[0], false), ureg_src(r), ureg_src(sign));
+      ureg_release_temporary(ureg, f);
+      ureg_release_temporary(ureg, sign);
+      ureg_release_temporary(ureg, r);
+      ureg_release_temporary(ureg, x);
+      ureg_release_temporary(ureg, e);
+      return true;
+   }
+
+   case D3D11_SB_OPCODE_F16TOF32: {
+      /* from the low 16 bits */
+      struct ureg_dst h, o, e, x;
+      h = ureg_DECL_temporary(ureg);
+      o = ureg_DECL_temporary(ureg);
+      e = ureg_DECL_temporary(ureg);
+      x = ureg_DECL_temporary(ureg);
+      ureg_MOV(ureg, h, translate_src_operand(sx, &opcode->src[0], OF_UINT));
+      ureg_AND(ureg, o, ureg_src(h), ureg_imm1u(ureg, 0x7fff));
+      ureg_SHL(ureg, o, ureg_src(o), ureg_imm1u(ureg, 13));
+      ureg_AND(ureg, e, ureg_src(o), ureg_imm1u(ureg, 0x0f800000));
+      ureg_UADD(ureg, o, ureg_src(o), ureg_imm1u(ureg, 0x38000000));
+      /* infinity and NaN */
+      ureg_USEQ(ureg, x, ureg_src(e), ureg_imm1u(ureg, 0x0f800000));
+      ureg_AND(ureg, x, ureg_src(x), ureg_imm1u(ureg, 0x38000000));
+      ureg_UADD(ureg, o, ureg_src(o), ureg_src(x));
+      /* denormals: renormalized by the float adder */
+      ureg_UADD(ureg, x, ureg_src(o), ureg_imm1u(ureg, 0x00800000));
+      ureg_ADD(ureg, x, ureg_src(x), ureg_imm1f(ureg, -6.103515625e-05f));
+      ureg_USEQ(ureg, e, ureg_src(e), ureg_imm1u(ureg, 0));
+      ureg_UCMP(ureg, o, ureg_src(e), ureg_src(x), ureg_src(o));
+      ureg_AND(ureg, h, ureg_src(h), ureg_imm1u(ureg, 0x8000));
+      ureg_SHL(ureg, h, ureg_src(h), ureg_imm1u(ureg, 16));
+      ureg_OR(ureg, translate_dst_operand(sx, &opcode->dst[0], opcode->saturate), ureg_src(o), ureg_src(h));
+      ureg_release_temporary(ureg, h);
+      ureg_release_temporary(ureg, o);
+      ureg_release_temporary(ureg, e);
+      ureg_release_temporary(ureg, x);
+      return true;
+   }
+
+   case D3D11_SB_OPCODE_UADDC:
+   case D3D11_SB_OPCODE_USUBB:
+      /* dst0 = sum or difference, dst1 = carry or borrow (1 or 0) */
+      t[0] = ureg_DECL_temporary(ureg);
+      t[1] = ureg_DECL_temporary(ureg);
+      a = translate_src_operand(sx, &opcode->src[0], OF_UINT);
+      b = translate_src_operand(sx, &opcode->src[1], OF_UINT);
+      if (opcode->type == D3D11_SB_OPCODE_UADDC) {
+         ureg_UADD(ureg, t[0], a, b);
+         ureg_USLT(ureg, t[1], ureg_src(t[0]), a);
+      } else {
+         ureg_INEG(ureg, t[0], b);
+         ureg_UADD(ureg, t[0], a, ureg_src(t[0]));
+         ureg_USLT(ureg, t[1], a, b);
+      }
+      ureg_AND(ureg, t[1], ureg_src(t[1]), ureg_imm1u(ureg, 1));
+      for (i = 0; i < 2; i++) {
+         if (opcode->dst[i].base.type != D3D10_SB_OPERAND_TYPE_NULL) {
+            ureg_MOV(ureg, translate_dst_operand(sx, &opcode->dst[i], false), ureg_src(t[i]));
+         }
+      }
+      ureg_release_temporary(ureg, t[0]);
+      ureg_release_temporary(ureg, t[1]);
+      return true;
+
+   case D3D11_SB_OPCODE_SWAPC:
+      /* dst0 = cond ? src2 : src1, dst1 = cond ? src1 : src2 */
+      t[0] = ureg_DECL_temporary(ureg);
+      t[1] = ureg_DECL_temporary(ureg);
+      a = translate_src_operand(sx, &opcode->src[0], OF_UINT);
+      b = translate_src_operand(sx, &opcode->src[1], OF_UINT);
+      c = translate_src_operand(sx, &opcode->src[2], OF_UINT);
+      ureg_UCMP(ureg, t[0], a, c, b);
+      ureg_UCMP(ureg, t[1], a, b, c);
+      for (i = 0; i < 2; i++) {
+         if (opcode->dst[i].base.type != D3D10_SB_OPERAND_TYPE_NULL) {
+            ureg_MOV(ureg, translate_dst_operand(sx, &opcode->dst[i], false), ureg_src(t[i]));
+         }
+      }
+      ureg_release_temporary(ureg, t[0]);
+      ureg_release_temporary(ureg, t[1]);
+      return true;
+
+   case D3D11_SB_OPCODE_EMIT_STREAM:
+   case D3D11_SB_OPCODE_CUT_STREAM:
+   case D3D11_SB_OPCODE_EMITTHENCUT_STREAM: {
+      unsigned stream = opcode->dst[0].base.index[0].imm;
+      if (opcode->type != D3D11_SB_OPCODE_CUT_STREAM) {
+         ureg_EMIT(ureg, ureg_imm1u(ureg, stream));
+      }
+      if (opcode->type != D3D11_SB_OPCODE_EMIT_STREAM) {
+         ureg_ENDPRIM(ureg, ureg_imm1u(ureg, stream));
+      }
+      return true;
+   }
+
+   case D3D11_SB_OPCODE_DCL_STREAM:
+      /* outputs of more than one stream need stream output support per stream */
+      LOG_UNSUPPORTED(opcode->dst[0].base.index[0].imm != 0);
+      return true;
+
+   case D3D11_SB_OPCODE_DCL_GS_INSTANCE_COUNT:
+      ureg_property(ureg, TGSI_PROPERTY_GS_INVOCATIONS, opcode->specific.dcl_gs_instance_count);
+      return true;
+
+   case D3D11_SB_OPCODE_EVAL_CENTROID:
+   case D3D11_SB_OPCODE_EVAL_SAMPLE_INDEX:
+   case D3D11_SB_OPCODE_EVAL_SNAPPED: {
+      /* an input attribute interpolated elsewhere in the pixel; virgl needs the input itself (not one packed
+       * into a temporary with another, see dcl_base_input) */
+      struct ureg_dst dst = translate_dst_operand(sx, &opcode->dst[0], opcode->saturate);
+      a = translate_src_operand(sx, &opcode->src[0], OF_FLOAT);
+      if (a.File != TGSI_FILE_INPUT) {
+         LOG_UNSUPPORTED(true);
+         ureg_MOV(ureg, dst, a);
+      } else if (opcode->type == D3D11_SB_OPCODE_EVAL_CENTROID) {
+         ureg_INTERP_CENTROID(ureg, dst, a);
+      } else if (opcode->type == D3D11_SB_OPCODE_EVAL_SAMPLE_INDEX) {
+         ureg_INTERP_SAMPLE(ureg, dst, a,
+                            ureg_scalar(translate_src_operand(sx, &opcode->src[1], OF_INT), TGSI_SWIZZLE_X));
+      } else {
+         /* offsets in 1/16 pixel */
+         t[0] = ureg_DECL_temporary(ureg);
+         ureg_I2F(ureg, t[0], translate_src_operand(sx, &opcode->src[1], OF_INT));
+         ureg_MUL(ureg, t[0], ureg_src(t[0]), ureg_imm1f(ureg, 1.0f / 16.0f));
+         ureg_INTERP_OFFSET(ureg, dst, a, ureg_src(t[0]));
+         ureg_release_temporary(ureg, t[0]);
+      }
+      return true;
+   }
+
+   default:
+      return false;
+   }
+}
+
+/* Finds the loops that have a continue and each switch's case values, ahead of the translation. */
+static void
+Shader_scan_control_flow(struct Shader_xlate *sx, const unsigned *code)
+{
+   struct Shader_parser parser;
+   struct Shader_opcode opcode;
+   struct {
+      bool is_switch;
+      uint index;
+   } stack[SHADER_MAX_CF_DEPTH];
+   uint depth = 0;
+
+   Shader_parse_init(&parser, code);
+   while (Shader_parse_opcode(&parser, &opcode)) {
+      switch (opcode.type) {
+      case D3D10_SB_OPCODE_LOOP:
+         sx->loop_has_continue = REALLOC(sx->loop_has_continue, sx->num_loops * sizeof(bool),
+                                         (sx->num_loops + 1) * sizeof(bool));
+         sx->loop_has_continue[sx->num_loops] = false;
+         if (depth < SHADER_MAX_CF_DEPTH) {
+            stack[depth].is_switch = false;
+            stack[depth].index = sx->num_loops;
+         }
+         depth++;
+         sx->num_loops++;
+         break;
+      case D3D10_SB_OPCODE_SWITCH:
+         sx->switches = REALLOC(sx->switches, sx->num_switches * sizeof(*sx->switches),
+                                (sx->num_switches + 1) * sizeof(*sx->switches));
+         memset(&sx->switches[sx->num_switches], 0, sizeof(*sx->switches));
+         if (depth < SHADER_MAX_CF_DEPTH) {
+            stack[depth].is_switch = true;
+            stack[depth].index = sx->num_switches;
+         }
+         depth++;
+         sx->num_switches++;
+         break;
+      case D3D10_SB_OPCODE_ENDLOOP:
+      case D3D10_SB_OPCODE_ENDSWITCH:
+         if (depth) {
+            depth--;
+         }
+         break;
+      case D3D10_SB_OPCODE_CONTINUE:
+      case D3D10_SB_OPCODE_CONTINUEC:
+         for (uint i = MIN2(depth, SHADER_MAX_CF_DEPTH); i-- > 0;) {
+            if (!stack[i].is_switch) {
+               sx->loop_has_continue[stack[i].index] = true;
+               break;
+            }
+         }
+         break;
+      case D3D10_SB_OPCODE_CASE:
+      case D3D10_SB_OPCODE_DEFAULT:
+         if (depth && depth <= SHADER_MAX_CF_DEPTH && stack[depth - 1].is_switch) {
+            struct Shader_switch_cases *cases = &sx->switches[stack[depth - 1].index];
+            if (opcode.type == D3D10_SB_OPCODE_DEFAULT) {
+               cases->has_default = true;
+            } else {
+               cases->values = REALLOC(cases->values, cases->count * sizeof(unsigned),
+                                       (cases->count + 1) * sizeof(unsigned));
+               cases->values[cases->count++] = opcode.src[0].imm[0].u32;
+            }
+         }
+         break;
+      default:
+         break;
+      }
+      Shader_opcode_free(&opcode);
+   }
+}
+
+static struct Shader_cf *
+cf_innermost_loop(struct Shader_xlate *sx)
+{
+   for (uint i = sx->cf_depth; i-- > 0;) {
+      if (!sx->cf[i].is_switch) {
+         return &sx->cf[i];
+      }
+   }
+   return NULL;
+}
+
+static void
+cf_loop(struct Shader_xlate *sx)
+{
+   struct ureg_program *ureg = sx->ureg;
+   struct Shader_cf *cf;
+   unsigned label;
+
+   assert(sx->cf_depth < SHADER_MAX_CF_DEPTH);
+   cf = &sx->cf[sx->cf_depth++];
+   memset(cf, 0, sizeof *cf);
+   cf->lowered = sx->loops_seen < sx->num_loops && sx->loop_has_continue[sx->loops_seen];
+   sx->loops_seen++;
+
+   if (cf->lowered) {
+      cf->flags = ureg_DECL_temporary(ureg);
+      ureg_MOV(ureg, ureg_writemask(cf->flags, TGSI_WRITEMASK_X), ureg_imm1u(ureg, 0));
+   }
+   ureg_BGNLOOP(ureg, &label);
+   if (cf->lowered) {
+      ureg_MOV(ureg, ureg_writemask(cf->flags, TGSI_WRITEMASK_Y), ureg_imm1u(ureg, 0));
+      ureg_BGNLOOP(ureg, &label);
+   }
+}
+
+static void
+cf_endloop(struct Shader_xlate *sx)
+{
+   struct ureg_program *ureg = sx->ureg;
+   struct Shader_cf *cf;
+   unsigned label;
+
+   assert(sx->cf_depth && !sx->cf[sx->cf_depth - 1].is_switch);
+   cf = &sx->cf[--sx->cf_depth];
+   if (cf->lowered) {
+      ureg_BRK(ureg);
+      ureg_ENDLOOP(ureg, &label);
+      ureg_UIF(ureg, ureg_scalar(ureg_src(cf->flags), TGSI_SWIZZLE_X), &label);
+      ureg_BRK(ureg);
+      ureg_ENDIF(ureg);
+   }
+   ureg_ENDLOOP(ureg, &label);
+   if (cf->lowered) {
+      ureg_release_temporary(ureg, cf->flags);
+   }
+}
+
+static void
+cf_break(struct Shader_xlate *sx)
+{
+   struct ureg_program *ureg = sx->ureg;
+   struct Shader_cf *cf = sx->cf_depth ? &sx->cf[sx->cf_depth - 1] : NULL;
+
+   if (cf && !cf->is_switch && cf->lowered) {
+      ureg_MOV(ureg, ureg_writemask(cf->flags, TGSI_WRITEMASK_X), ureg_imm1u(ureg, ~0u));
+   }
+   ureg_BRK(ureg);
+}
+
+static void
+cf_continue(struct Shader_xlate *sx)
+{
+   struct ureg_program *ureg = sx->ureg;
+   struct Shader_cf *loop = cf_innermost_loop(sx);
+
+   if (!loop || !loop->lowered) {
+      /* the scan found every continue's loop */
+      assert(0);
+      return;
+   }
+   if (loop != &sx->cf[sx->cf_depth - 1]) {
+      /* inside a switch: leave it, the code after it continues */
+      ureg_MOV(ureg, ureg_writemask(loop->flags, TGSI_WRITEMASK_Y), ureg_imm1u(ureg, ~0u));
+   }
+   ureg_BRK(ureg);
+}
+
+static void
+cf_switch(struct Shader_xlate *sx, struct ureg_src selector)
+{
+   struct ureg_program *ureg = sx->ureg;
+   const struct Shader_switch_cases *cases =
+      sx->switches_seen < sx->num_switches ? &sx->switches[sx->switches_seen] : NULL;
+   struct Shader_cf *cf;
+   unsigned label;
+
+   sx->switches_seen++;
+   assert(sx->cf_depth < SHADER_MAX_CF_DEPTH);
+   cf = &sx->cf[sx->cf_depth++];
+   memset(cf, 0, sizeof *cf);
+   cf->is_switch = true;
+   cf->flags = ureg_DECL_temporary(ureg);
+
+   ureg_MOV(ureg, ureg_writemask(cf->flags, TGSI_WRITEMASK_X), ureg_scalar(selector, TGSI_SWIZZLE_X));
+   ureg_MOV(ureg, ureg_writemask(cf->flags, TGSI_WRITEMASK_Y), ureg_imm1u(ureg, 0));
+   if (cases && cases->has_default) {
+      struct ureg_dst tmp = ureg_DECL_temporary(ureg);
+      ureg_MOV(ureg, ureg_writemask(cf->flags, TGSI_WRITEMASK_Z), ureg_imm1u(ureg, ~0u));
+      for (uint i = 0; i < cases->count; i++) {
+         ureg_USNE(ureg, ureg_writemask(tmp, TGSI_WRITEMASK_X),
+                   ureg_scalar(ureg_src(cf->flags), TGSI_SWIZZLE_X), ureg_imm1u(ureg, cases->values[i]));
+         ureg_AND(ureg, ureg_writemask(cf->flags, TGSI_WRITEMASK_Z),
+                  ureg_scalar(ureg_src(cf->flags), TGSI_SWIZZLE_Z), ureg_scalar(ureg_src(tmp), TGSI_SWIZZLE_X));
+      }
+      ureg_release_temporary(ureg, tmp);
+   }
+   ureg_BGNLOOP(ureg, &label);
+}
+
+/* A case label (or default, is_default): the region after it runs if this or an earlier label matched */
+static void
+cf_case(struct Shader_xlate *sx, bool is_default, unsigned value)
+{
+   struct ureg_program *ureg = sx->ureg;
+   struct Shader_cf *cf;
+   unsigned label;
+
+   assert(sx->cf_depth && sx->cf[sx->cf_depth - 1].is_switch);
+   cf = &sx->cf[sx->cf_depth - 1];
+   if (cf->case_open) {
+      ureg_ENDIF(ureg);
+   }
+   if (is_default) {
+      ureg_OR(ureg, ureg_writemask(cf->flags, TGSI_WRITEMASK_Y),
+              ureg_scalar(ureg_src(cf->flags), TGSI_SWIZZLE_Y), ureg_scalar(ureg_src(cf->flags), TGSI_SWIZZLE_Z));
+   } else {
+      struct ureg_dst tmp = ureg_DECL_temporary(ureg);
+      ureg_USEQ(ureg, ureg_writemask(tmp, TGSI_WRITEMASK_X),
+                ureg_scalar(ureg_src(cf->flags), TGSI_SWIZZLE_X), ureg_imm1u(ureg, value));
+      ureg_OR(ureg, ureg_writemask(cf->flags, TGSI_WRITEMASK_Y),
+              ureg_scalar(ureg_src(cf->flags), TGSI_SWIZZLE_Y), ureg_scalar(ureg_src(tmp), TGSI_SWIZZLE_X));
+      ureg_release_temporary(ureg, tmp);
+   }
+   ureg_UIF(ureg, ureg_scalar(ureg_src(cf->flags), TGSI_SWIZZLE_Y), &label);
+   cf->case_open = true;
+}
+
+static void
+cf_endswitch(struct Shader_xlate *sx)
+{
+   struct ureg_program *ureg = sx->ureg;
+   struct Shader_cf *cf, *loop;
+   unsigned label;
+
+   assert(sx->cf_depth && sx->cf[sx->cf_depth - 1].is_switch);
+   cf = &sx->cf[--sx->cf_depth];
+   if (cf->case_open) {
+      ureg_ENDIF(ureg);
+   }
+   ureg_BRK(ureg);
+   ureg_ENDLOOP(ureg, &label);
+   ureg_release_temporary(ureg, cf->flags);
+
+   /* a continue inside the switch */
+   loop = cf_innermost_loop(sx);
+   if (loop && loop->lowered) {
+      ureg_UIF(ureg, ureg_scalar(ureg_src(loop->flags), TGSI_SWIZZLE_Y), &label);
+      ureg_BRK(ureg);
+      ureg_ENDIF(ureg);
+   }
+}
