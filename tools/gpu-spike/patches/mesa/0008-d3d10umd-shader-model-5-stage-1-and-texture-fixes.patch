+/*
+ * Textures on virgl.
+ *
+ * virglrenderer turns TGSI's TEX-style instructions into GLSL texture calls on a sampler uniform per TGSI sampler,
+ * which the host binds to the view and sampler state of the same index. D3D samples texture t# with sampler s#, any
+ * pair, so each (t#, s#, comparison) combination a shader uses gets a TGSI sampler of its own (tex_slot), declared
+ * with the texture's target and return type (an integer texture needs an integer sampler in GLSL), and the driver
+ * binds view t# and sampler state s# to it (Shader_tex_slots). A comparison needs a shadow sampler in GLSL.
+ * D3D selects the result's components with the texture operand's swizzle, so the instructions write a temporary
+ * that is then moved to the destination swizzled.
+ */
+static bool
+virgl_tex_ops(void)
+{
+   return use_old_tex_ops || (st_debug & ST_DEBUG_OLD_TEX_OPS);
+}
+
+static uint
+shadow_target(uint target)
+{
+   switch (target) {
+   case TGSI_TEXTURE_1D:
+      return TGSI_TEXTURE_SHADOW1D;
+   case TGSI_TEXTURE_2D:
+      return TGSI_TEXTURE_SHADOW2D;
+   case TGSI_TEXTURE_1D_ARRAY:
+      return TGSI_TEXTURE_SHADOW1D_ARRAY;
+   case TGSI_TEXTURE_2D_ARRAY:
+      return TGSI_TEXTURE_SHADOW2D_ARRAY;
+   case TGSI_TEXTURE_CUBE:
+      return TGSI_TEXTURE_SHADOWCUBE;
+   case TGSI_TEXTURE_CUBE_ARRAY:
+      return TGSI_TEXTURE_SHADOWCUBE_ARRAY;
+   default:
+      LOG_UNSUPPORTED(true);
+      return target;
+   }
+}
+
+/* Components of a texture's size that resinfo's rcpfloat inverts (not the array size) */
+static unsigned
+tex_size_dims(uint target)
+{
+   switch (target) {
+   case TGSI_TEXTURE_BUFFER:
+   case TGSI_TEXTURE_1D:
+   case TGSI_TEXTURE_1D_ARRAY:
+      return 1;
+   case TGSI_TEXTURE_3D:
+      return 3;
+   default:
+      return 2;
+   }
+}
+
+static struct ureg_src
+tex_slot(struct Shader_xlate *sx, unsigned view, unsigned sampler, bool shadow)
+{
+   struct Shader_tex_slots *slots = &sx->tex_slots;
+   const struct Shader_resource *res;
+   unsigned i;
+
+   for (i = 0; i < slots->count; i++) {
+      if (slots->slot[i].view == view && slots->slot[i].sampler == sampler && slots->slot[i].shadow == shadow) {
+         return ureg_src_register(TGSI_FILE_SAMPLER, i);
+      }
+   }
+   if (slots->count == SHADER_MAX_TEX_SLOTS || view >= SHADER_MAX_RESOURCES) {
+      LOG_UNSUPPORTED(true);
+      return ureg_src_register(TGSI_FILE_SAMPLER, 0);
+   }
+   i = slots->count++;
+   slots->slot[i].view = view;
+   slots->slot[i].sampler = sampler;
+   slots->slot[i].shadow = shadow;
+   res = &sx->resources[view];
+   ureg_DECL_sampler_view(sx->ureg, i, res->target, res->ret[0], res->ret[1], res->ret[2], res->ret[3]);
+   return ureg_DECL_sampler(sx->ureg, i);
