       v->buffers[s] = decoder ? vpipe->create_video_buffer(vpipe, &tmpl)
-                              : CreatePlaneBuffer(pDevice, &tmpl, PipeUsage((D3D10_DDI_RESOURCE_USAGE)pCreateResource->Usage));
+                              : CreatePlaneBuffer(pDevice, &tmpl, PipeUsage((D3D10_DDI_RESOURCE_USAGE)pCreateResource->Usage),
+                                                  shared);
       if (!v->buffers[s]) {
          SetError(hDevice, E_OUTOFMEMORY);
          return true;
@@ -268,6 +303,49 @@ VideoCreateResource(D3D10DDI_HDEVICE hDevice, const D3D10DDIARG_CREATERESOURCE *
    return true;
 }
 
+/* A shared NV12/P010 texture another device made (OpenResource opened its luma plane): its video surface, with the
+ * chroma plane the allocation has */
+void
+VideoOpenResource(D3D10DDI_HDEVICE hDevice, Resource *pResource)
+{
+   Device *pDevice = CastDevice(hDevice);
+   struct pipe_resource *luma = pResource->resource;
+   VideoSurface *v = (VideoSurface *)calloc(1, sizeof *v);
+   if (v) {
+      v->buffers = (struct pipe_video_buffer **)calloc(1, sizeof *v->buffers);
+   }
+   struct pipe_resource *resources[VL_NUM_COMPONENTS] = {};
+   resources[1] = VideoPipe(pDevice) ? ChromaPlane(pDevice, luma) : NULL;
+   if (!v || !v->buffers || !resources[1]) {
+      pipe_resource_reference(&resources[1], NULL);
+      free(v ? v->buffers : NULL);
+      free(v);
+      SetError(hDevice, E_OUTOFMEMORY);
+      return;
+   }
+   v->format = luma->format == PIPE_FORMAT_R16_UNORM ? PIPE_FORMAT_P010 : PIPE_FORMAT_NV12;
+   v->bpp = v->format == PIPE_FORMAT_NV12 ? 1 : 2;
+   v->width = luma->width0;
+   v->height = luma->height0;
+   v->slices = 1;
+   struct pipe_video_buffer tmpl = {};
+   tmpl.buffer_format = v->format;
+   tmpl.width = v->width;
+   tmpl.height = v->height;
+   pipe_resource_reference(&resources[0], luma);   /* the buffer's, as pResource->resource keeps its own */
+   v->buffers[0] = vl_video_buffer_create_ex2(VideoPipe(pDevice), &tmpl, resources);
+   if (!v->buffers[0]) {
+      pipe_resource_reference(&resources[0], NULL);
+      pipe_resource_reference(&resources[1], NULL);
+      free(v->buffers);
+      free(v);
+      SetError(hDevice, E_OUTOFMEMORY);
+      return;
+   }
+   pResource->video = v;
+   pResource->Format = v->format == PIPE_FORMAT_NV12 ? DXGI_FORMAT_NV12 : DXGI_FORMAT_P010;
+}
+
 void
 VideoDestroyResource(Resource *pResource)
 {
@@ -1695,7 +1773,7 @@ VideoProcessorGetBehaviorHints(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCES
 }
 
