+/* WDDM 2.1: keyed-mutex-less sync tokens on shared resources (nothing to do: shared resources live on the host, and
+ * the runtime flushes before releasing one) */
+static void APIENTRY
+SyncTokenWDDM2_1(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hResource, HANDLE hSyncToken)
+{
+}
+
+/* The WDDM 2.1 table: 2.0's and the sync tokens. The D3D11 runtime offers NV12 shared with other APIs
+ * (ExtendedNV12SharedTextureSupported) from this DDI on */
+void
+FillDeviceFuncsWDDM2_1(D3DWDDM2_1DDI_DEVICEFUNCS *pFuncs, const D3D10DDI_DEVICEFUNCS *pFuncs10)
+{
+   static_assert(offsetof(D3DWDDM2_1DDI_DEVICEFUNCS, pfnAcquireResource) == sizeof(D3DWDDM2_0DDI_DEVICEFUNCS),
+                 "the WDDM 2.1 table begins with the 2.0 one");
+   FillDeviceFuncsWDDM2_0(reinterpret_cast<D3DWDDM2_0DDI_DEVICEFUNCS *>(pFuncs), pFuncs10);
+   pFuncs->pfnAcquireResource = SyncTokenWDDM2_1;
+   pFuncs->pfnReleaseResource = SyncTokenWDDM2_1;
+}
+
 
 /* DXGI 1.2: blits with rectangles (DxgiFns.cpp), offering memory back (nothing to give) */
 static HRESULT APIENTRY
@@ -1243,3 +1264,29 @@ FillDXGIFuncs1_4(DXGI1_4_DDI_BASE_FUNCTIONS *pFuncs)
    pFuncs->pfnTrimResidencySet = TrimResidencySet;
    pFuncs->pfnCheckMultiplaneOverlayColorSpaceSupport = CheckMultiplaneOverlayColorSpaceSupport;
 }
+
+/* DXGI 1.5 (with WDDM 2.1): offering and reclaiming with flags and results, nothing given back as before */
+static HRESULT APIENTRY
+OfferResources1(DXGI_DDI_ARG_OFFERRESOURCES1 *pOffer)
+{
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+ReclaimResources1(DXGI_DDI_ARG_RECLAIMRESOURCES1 *pReclaim)
+{
+   for (UINT i = 0; pReclaim->pResults && i < pReclaim->Resources; i++) {
+      pReclaim->pResults[i] = D3DDDI_RECLAIM_RESULT_OK;
+   }
+   return S_OK;
+}
+
+void
+FillDXGIFuncs1_5(DXGI1_5_DDI_BASE_FUNCTIONS *pFuncs)
+{
+   static_assert(offsetof(DXGI1_5_DDI_BASE_FUNCTIONS, pfnReclaimResources1) == sizeof(DXGI1_4_DDI_BASE_FUNCTIONS),
+                 "the DXGI 1.5 table begins with 1.4's layout");
+   FillDXGIFuncs1_4(reinterpret_cast<DXGI1_4_DDI_BASE_FUNCTIONS *>(pFuncs));
+   pFuncs->pfnOfferResources1 = OfferResources1;
+   pFuncs->pfnReclaimResources1 = ReclaimResources1;
+}
