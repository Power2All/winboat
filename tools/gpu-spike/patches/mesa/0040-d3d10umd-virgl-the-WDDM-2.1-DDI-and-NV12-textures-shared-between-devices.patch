+VideoRetrieveFunctions(D3D10DDI_HDEVICE hDevice, void *pParams, SIZE_T ParamSize, bool wddm2_0, bool wddm2_1)
 {
    if (!pParams || ParamSize < sizeof(D3D11_1DDI_VIDEO_INPUT)) {
       return E_INVALIDARG;
@@ -1812,6 +1890,12 @@ VideoRetrieveFunctions(D3D10DDI_HDEVICE hDevice, void *pParams, SIZE_T ParamSize
       f2->pfnVideoProcessorSetStreamColorSpace1 = VideoProcessorSetStreamColorSpace1;
       f2->pfnVideoProcessorGetBehaviorHints = VideoProcessorGetBehaviorHints;
    }
+   if (wddm2_1) {
+      /* the 2.1 table: 2.0's and HDR metadata, which the processor doesn't use (no HDR output) */
+      D3DWDDM2_1DDI_VIDEODEVICEFUNCS *f21 = reinterpret_cast<D3DWDDM2_1DDI_VIDEODEVICEFUNCS *>(f);
+      f21->pfnVideoProcessorSetOutputHDRMetaData = VideoStub<decltype(f21->pfnVideoProcessorSetOutputHDRMetaData)>::Call;
+      f21->pfnVideoProcessorSetStreamHDRMetaData = VideoStub<decltype(f21->pfnVideoProcessorSetStreamHDRMetaData)>::Call;
+   }
    return S_OK;
 }
 
