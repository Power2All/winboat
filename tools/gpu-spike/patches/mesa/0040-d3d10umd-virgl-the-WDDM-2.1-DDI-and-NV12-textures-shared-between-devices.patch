-/* A slice for the video processor and copies: planes of the texture's size */
+/* A shared texture's chroma plane: the one its luma plane's allocation made (PIPE_RESOURCE_FLAG_CHROMA_PLANE), here
+ * or in the device that shared it */
+static struct pipe_resource *
+ChromaPlane(Device *pDevice, struct pipe_resource *luma)
+{
+   struct winsys_handle handle = {};
+   handle.type = WINSYS_HANDLE_TYPE_D3DKMT_ALLOC;
+   if (!pDevice->screen->resource_get_handle(pDevice->screen, NULL, luma, &handle, 0)) {
+      return NULL;
+   }
+   handle.plane = 1;
+   struct pipe_resource templat = {};
+   templat.target = PIPE_TEXTURE_2D;
+   templat.format = luma->format == PIPE_FORMAT_R16_UNORM ? PIPE_FORMAT_R16G16_UNORM : PIPE_FORMAT_R8G8_UNORM;
+   templat.width0 = (luma->width0 + 1) / 2;
+   templat.height0 = (luma->height0 + 1) / 2;
+   templat.depth0 = 1;
+   templat.array_size = 1;
+   templat.bind = luma->bind;
+   return pDevice->screen->resource_from_handle(pDevice->screen, &templat, &handle, 0);
+}
+
+/* A slice for the video processor and copies: planes of the texture's size. Shared: the luma plane's allocation
+ * (the runtime resource's) brings the chroma plane along, so that whoever opens it finds both */
 static struct pipe_video_buffer *
-CreatePlaneBuffer(Device *pDevice, const struct pipe_video_buffer *tmpl, enum pipe_resource_usage usage)
+CreatePlaneBuffer(Device *pDevice, const struct pipe_video_buffer *tmpl, enum pipe_resource_usage usage,
+                  bool shared = false)
 {
    bool ten = tmpl->buffer_format != PIPE_FORMAT_NV12;   /* P010, P016 */
    const enum pipe_format formats[2] = {ten ? PIPE_FORMAT_R16_UNORM : PIPE_FORMAT_R8_UNORM,
@@ -161,9 +186,11 @@ CreatePlaneBuffer(Device *pDevice, const struct pipe_video_buffer *tmpl, enum pi
       templat.height0 = p ? tmpl->height / 2 : tmpl->height;
       templat.depth0 = 1;
       templat.array_size = 1;
-      templat.bind = PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_RENDER_TARGET;
+      templat.bind = PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_RENDER_TARGET | (shared ? PIPE_BIND_SHARED : 0);
       templat.usage = usage;
-      resources[p] = pDevice->screen->resource_create(pDevice->screen, &templat);
+      templat.flags = shared ? PIPE_RESOURCE_FLAG_CHROMA_PLANE : 0;
+      resources[p] = p && shared ? ChromaPlane(pDevice, resources[0])
+                                 : pDevice->screen->resource_create(pDevice->screen, &templat);
       if (!resources[p]) {
          pipe_resource_reference(&resources[0], NULL);
          return NULL;
@@ -250,10 +277,18 @@ VideoCreateResource(D3D10DDI_HDEVICE hDevice, const D3D10DDIARG_CREATERESOURCE *
    tmpl.interlaced = false;
    struct pipe_context *vpipe = VideoPipe(pDevice);
    bool decoder = (pCreateResource->BindFlags & D3D11_DDI_BIND_DECODER) && vpipe->create_video_buffer;
+   /* shared (11.4's ExtendedNV12SharedTextureSupported): one slice, whose planes the one allocation has.
+    * ponytail: decoder output keeps the codec's buffers and isn't shared that way; their planes if programs share them */
+   bool shared = (pCreateResource->MiscFlags & D3D10_DDI_RESOURCE_MISC_SHARED) && !decoder;
