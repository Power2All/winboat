diff --git a/src/gallium/frontends/d3d9umd/video.cpp b/src/gallium/frontends/d3d9umd/video.cpp
new file mode 100644
--- /dev/null
+++ b/src/gallium/frontends/d3d9umd/video.cpp
@@ -0,0 +1,242 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * DXVA2 video processing (what Windows' video renderer EVR, and players through DXVA2, use): the video processor
+ * caps and the VideoProcess* entry points. The work (YUV to RGB, scaling) is nddi_video_blt's.
+ *
+ * Two processors: progressive (frames as they are) and bob (one field of interlaced video, line-doubled). Input
+ * formats YUY2, UYVY, NV12 and RGB; output X8R8G8B8/A8R8G8B8; no substreams, no ProcAmp or filters.
+ */
+
+#include "d3d9umd.h"
+
+#include <new>
+#include <string.h>
+
+/* DXVADDI_VideoProcProgressiveDevice and DXVADDI_VideoProcBobDevice (d3dumddi.h only declares them) */
+static const GUID progressiveDevice = {0x5a54a0c9, 0xc7ec, 0x4bd9, {0x8e, 0xde, 0xf3, 0xc7, 0x5d, 0xc4, 0x39, 0x3b}};
+static const GUID bobDevice = {0x335aa36e, 0x7884, 0x43a4, {0x9c, 0x91, 0x7f, 0x87, 0xfa, 0xf3, 0xe3, 0x7e}};
+static const GUID *const videoProcessors[] = {&progressiveDevice, &bobDevice};
+static const D3DDDIFORMAT videoTargetFormats[] = {D3DDDIFMT_X8R8G8B8, D3DDDIFMT_A8R8G8B8};
+
+struct D3D9UmdVideoProcess {
+   bool bob;
+   D3D9UmdResource *target;
+   UINT targetSub;
+};
+
+static bool
+IsVideoInput(D3DDDIFORMAT f)
+{
+   return nddi_format_is_video((uint32_t)f) || f == D3DDDIFMT_X8R8G8B8 || f == D3DDDIFMT_A8R8G8B8;
+}
+
+static bool
+IsVideoProcessor(const GUID *g)
+{
+   return g && (*g == progressiveDevice || *g == bobDevice);
+}
+
+template <typename T>
+static HRESULT
+PutValue(const D3DDDIARG_GETCAPS *p, const T &value)
+{
+   if (!p->pData || p->DataSize < sizeof(T))
+      return E_INVALIDARG;
+   memcpy(p->pData, &value, sizeof(T));
+   return S_OK;
+}
+
+static DXVADDI_FIXED32
+Fixed(int value, unsigned fraction = 0)
+{
+   DXVADDI_FIXED32 f;
+   f.Value = (SHORT)value;
+   f.Fraction = (USHORT)fraction;
+   return f;
+}
+
+bool
+D3D9UmdVideoGetCaps(const D3DDDIARG_GETCAPS *p, HRESULT *hr)
+{
+   switch (p->Type) {
+   case D3DDDICAPS_GETVIDEOPROCESSORDEVICEGUIDCOUNT: {
+      const DXVADDI_VIDEODESC *desc = (const DXVADDI_VIDEODESC *)p->pInfo;
+      *hr = PutValue(p, (UINT)(desc && IsVideoInput(desc->Format) ? ARRAY_SIZE(videoProcessors) : 0));
+      return true;
+   }
+   case D3DDDICAPS_GETVIDEOPROCESSORDEVICEGUIDS: {
+      const DXVADDI_VIDEODESC *desc = (const DXVADDI_VIDEODESC *)p->pInfo;
+      if (!desc || !IsVideoInput(desc->Format) || !p->pData ||
+          p->DataSize < ARRAY_SIZE(videoProcessors) * sizeof(GUID)) {
+         *hr = E_INVALIDARG;
+         return true;
+      }
+      for (unsigned i = 0; i < ARRAY_SIZE(videoProcessors); i++)
+         ((GUID *)p->pData)[i] = *videoProcessors[i];
+      *hr = S_OK;
+      return true;
+   }
+   case D3DDDICAPS_GETVIDEOPROCESSORRTFORMATCOUNT: {
+      const DXVADDI_VIDEOPROCESSORINPUT *in = (const DXVADDI_VIDEOPROCESSORINPUT *)p->pInfo;
+      bool ok = in && IsVideoProcessor(in->pVideoProcGuid) && IsVideoInput(in->VideoDesc.Format);
+      *hr = PutValue(p, (UINT)(ok ? ARRAY_SIZE(videoTargetFormats) : 0));
+      return true;
+   }
+   case D3DDDICAPS_GETVIDEOPROCESSORRTFORMATS:
+      if (!p->pData || p->DataSize < sizeof(videoTargetFormats)) {
+         *hr = E_INVALIDARG;
+         return true;
+      }
+      memcpy(p->pData, videoTargetFormats, sizeof(videoTargetFormats));
+      *hr = S_OK;
+      return true;
+   case D3DDDICAPS_GETVIDEOPROCESSORRTSUBSTREAMFORMATCOUNT:
+      *hr = PutValue(p, (UINT)0);
+      return true;
+   case D3DDDICAPS_GETVIDEOPROCESSORRTSUBSTREAMFORMATS:
+      *hr = S_OK;
+      return true;
+   case D3DDDICAPS_GETVIDEOPROCESSORCAPS: {
+      const DXVADDI_VIDEOPROCESSORINPUT *in = (const DXVADDI_VIDEOPROCESSORINPUT *)p->pInfo;
+      if (!in || !IsVideoProcessor(in->pVideoProcGuid)) {
+         *hr = E_INVALIDARG;
+         return true;
+      }
+      DXVADDI_VIDEOPROCESSORCAPS caps;
+      memset(&caps, 0, sizeof(caps));
+      caps.InputPool = D3DDDIPOOL_VIDEOMEMORY;
+      caps.OutputFormat = D3DDDIFMT_X8R8G8B8;
+      caps.DeinterlaceTechnology =
+         *in->pVideoProcGuid == bobDevice ? DXVADDI_DEINTERLACETECH_BOBLINEREPLICATE : 0;
+      caps.VideoProcessorOperations = DXVADDI_VIDEOPROCESS_YUV2RGB | DXVADDI_VIDEOPROCESS_YUV2RGBEXTENDED |
+                                      DXVADDI_VIDEOPROCESS_STRETCHX | DXVADDI_VIDEOPROCESS_STRETCHY |
+                                      DXVADDI_VIDEOPROCESS_SUBRECTS;
+      *hr = PutValue(p, caps);
+      return true;
+   }
+   case D3DDDICAPS_GETPROCAMPRANGE: {
+      /* No ProcAmp controls are offered (ProcAmpControlCaps 0); the usual ranges for callers that ask anyway */
+      const DXVADDI_QUERYPROCAMPINPUT *in = (const DXVADDI_QUERYPROCAMPINPUT *)p->pInfo;
+      DXVADDI_VALUERANGE range;
+      memset(&range, 0, sizeof(range));
+      UINT cap = in ? in->ProcAmpCap : 0;
+      if (cap == DXVADDI_PROCAMP_BRIGHTNESS) {
+         range.MinValue = Fixed(-100);
+         range.MaxValue = Fixed(100);
+         range.DefaultValue = Fixed(0);
+         range.StepSize = Fixed(1);
+      } else if (cap == DXVADDI_PROCAMP_HUE) {
+         range.MinValue = Fixed(-180);
+         range.MaxValue = Fixed(180);
+         range.DefaultValue = Fixed(0);
+         range.StepSize = Fixed(1);
+      } else {
+         range.MinValue = Fixed(0);
+         range.MaxValue = Fixed(10);
+         range.DefaultValue = Fixed(1);
+         range.StepSize = Fixed(0, 0x028f); /* 0.01 */
+      }
+      *hr = PutValue(p, range);
+      return true;
+   }
+   case D3DDDICAPS_FILTERPROPERTYRANGE:
+      *hr = E_INVALIDARG;
+      return true;
+   default:
+      return false;
+   }
+}
+
+static HRESULT APIENTRY
+CreateVideoProcessDevice(HANDLE hDevice, D3DDDIARG_CREATEVIDEOPROCESSDEVICE *p)
+{
+   D3D9UMD_TRACE("CreateVideoProcessDevice format 0x%x %ux%u -> RT format %u", p->VideoDesc.Format,
+                 p->VideoDesc.SampleWidth, p->VideoDesc.SampleHeight, p->RenderTargetFormat);
+   if (!IsVideoProcessor(p->pVideoProcGuid) || !IsVideoInput(p->VideoDesc.Format))
+      return E_INVALIDARG;
+   D3D9UmdVideoProcess *vp = new (std::nothrow) D3D9UmdVideoProcess();
+   if (!vp)
+      return E_OUTOFMEMORY;
+   vp->bob = *p->pVideoProcGuid == bobDevice;
+   p->hVideoProcess = vp;
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+DestroyVideoProcessDevice(HANDLE hDevice, HANDLE hVideoProcess)
+{
+   delete (D3D9UmdVideoProcess *)hVideoProcess;
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+VideoProcessBeginFrame(HANDLE hDevice, HANDLE hVideoProcess)
+{
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+VideoProcessEndFrame(HANDLE hDevice, D3DDDIARG_VIDEOPROCESSENDFRAME *p)
+{
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+SetVideoProcessRenderTarget(HANDLE hDevice, const D3DDDIARG_SETVIDEOPROCESSRENDERTARGET *p)
+{
+   D3D9UmdVideoProcess *vp = (D3D9UmdVideoProcess *)p->hVideoProcess;
+   vp->target = D3D9UmdCastResource(p->hRenderTarget);
+   vp->targetSub = p->SubResourceIndex;
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+VideoProcessBlt(HANDLE hDevice, const D3DDDIARG_VIDEOPROCESSBLT *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   D3D9UmdVideoProcess *vp = (D3D9UmdVideoProcess *)p->hVideoProcess;
+   if (!vp || !vp->target)
+      return E_INVALIDARG;
+   nddi_video_sample samples[8];
+   UINT count = MIN2(p->NumSrcSurfaces, (UINT)ARRAY_SIZE(samples));
+   for (UINT i = 0; i < count; i++) {
+      const DXVADDI_VIDEOSAMPLE &s = p->pSrcSurfaces[i];
+      nddi_video_sample &v = samples[i];
+      v.src = D3D9UmdCastResource(s.SrcResource)->nine;
+      v.src_sub = s.SrcSubResourceIndex;
+      v.src_rect = {s.SrcRect.left, s.SrcRect.top, s.SrcRect.right, s.SrcRect.bottom};
+      v.dst_rect = {s.DstRect.left, s.DstRect.top, s.DstRect.right, s.DstRect.bottom};
+      v.matrix = s.SampleFormat.VideoTransferMatrix;
+      v.range = s.SampleFormat.NominalRange;
+      /* Bob: the first field in the first half of the frame's time, the second after */
+      v.field = -1;
+      UINT sf = s.SampleFormat.SampleFormat;
+      if (vp->bob && (sf == DXVADDI_SampleFieldInterleavedEvenFirst || sf == DXVADDI_SampleFieldInterleavedOddFirst)) {
+         bool second = p->TargetFrame >= s.Start + (s.End - s.Start) / 2;
+         int first = sf == DXVADDI_SampleFieldInterleavedEvenFirst ? 0 : 1;
+         v.field = second ? 1 - first : first;
+      }
+   }
+   const uint16_t background[3] = {p->BackgroundColor.Y, p->BackgroundColor.Cb, p->BackgroundColor.Cr};
+   nddi_rect target = {p->TargetRect.left, p->TargetRect.top, p->TargetRect.right, p->TargetRect.bottom};
+   HRESULT hr = nddi_video_blt(dev->nine, vp->target->nine, vp->targetSub, &target, background,
+                               p->DestFormat.NominalRange, samples, count);
+   D3D9UMD_TRACE("VideoProcessBlt %u sample(s) -> %p[%u] -> 0x%08lx", p->NumSrcSurfaces, vp->target, vp->targetSub,
+                 hr);
+   return hr;
+}
+
+void
+D3D9UmdFillVideoFuncs(D3DDDI_DEVICEFUNCS *f)
+{
+   f->pfnCreateVideoProcessDevice = CreateVideoProcessDevice;
+   f->pfnDestroyVideoProcessDevice = DestroyVideoProcessDevice;
+   f->pfnVideoProcessBeginFrame = VideoProcessBeginFrame;
+   f->pfnVideoProcessEndFrame = VideoProcessEndFrame;
+   f->pfnSetVideoProcessRenderTarget = SetVideoProcessRenderTarget;
+   f->pfnVideoProcessBlt = VideoProcessBlt;
+}
