+/* The rasterizer state's handle with the first num_clip clip distances applied (ResolveState) */
+void *
+RasterizerStateForClipDistances(struct pipe_context *pipe, RasterizerState *pRasterizerState, unsigned num_clip)
+{
+   if (!num_clip) {
+      return pRasterizerState->handle;
+   }
+   num_clip = MIN2(num_clip, 8);
+   if (!pRasterizerState->clip_handles[num_clip - 1]) {
+      struct pipe_rasterizer_state state = pRasterizerState->state;
+      state.clip_plane_enable = (1u << num_clip) - 1;
+      pRasterizerState->clip_handles[num_clip - 1] = pipe->create_rasterizer_state(pipe, &state);
+   }
+   return pRasterizerState->clip_handles[num_clip - 1];
+}
