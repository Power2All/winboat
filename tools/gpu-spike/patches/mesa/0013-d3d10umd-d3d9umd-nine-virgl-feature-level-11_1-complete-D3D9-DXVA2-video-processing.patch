+/*
+ * Doubles (D3D11_FEATURE_DOUBLES and 11.1's extended doubles). A double takes two 32-bit components: the first
+ * is .xy, the second .zw, positionally in double results and their sources. 32-bit results (comparisons, dtof,
+ * dtoi, dtou) go to the destination's enabled components in order (the first gets double .xy's, the second .zw's:
+ * "deq r2.z, ..." compares one double); 32-bit sources of double results (ftod, itod, utod, dmovc's condition)
+ * are .x for the .xy result and .y for the .zw one.
+ * virglrenderer translates one double per instruction (from a source's first two components; comparisons write
+ * .x), and its negate would apply to the 32-bit halves: each double goes through a temporary of its own, and
+ * negation and absolute values are DNEG/DABS.
+ */
+enum double_kind {
+   DOUBLE_TO_DOUBLE,   /* double sources, double result */
+   DOUBLE_TO_32,       /* double sources, 32-bit result */
+   DOUBLE_FROM_32,     /* 32-bit source, double result */
+   DOUBLE_MOVC,        /* 32-bit condition, double sources, double result */
+};
+
+static struct ureg_src
+double_src(struct Shader_xlate *sx, const struct Shader_src_operand *operand, unsigned k, struct ureg_dst *scratch,
+           unsigned *num_scratch)
+{
+   struct ureg_program *ureg = sx->ureg;
+   struct ureg_src src = translate_src_operand(sx, operand, OF_UINT);
+   bool neg = src.Negate, abs = src.Absolute;
+   src.Negate = 0;
+   src.Absolute = 0;
+   src = ureg_swizzle(src, 2 * k, 2 * k + 1, 2 * k, 2 * k + 1);
+   /* virglrenderer applies an immediate's swizzle twice for doubles (uvec4(x,z,x,z).xzxz), and the immediate pool
+    * puts a double's halves wherever its values already are: through a temporary, moved as 32-bit values */
+   if (src.File == TGSI_FILE_IMMEDIATE) {
+      struct ureg_dst tmp = scratch[(*num_scratch)++] = ureg_DECL_temporary(ureg);
+      ureg_MOV(ureg, ureg_writemask(tmp, TGSI_WRITEMASK_XY), src);
+      src = ureg_swizzle(ureg_src(tmp), 0, 1, 0, 1);
+   }
+   if (abs || neg) {
+      struct ureg_dst tmp = scratch[(*num_scratch)++] = ureg_DECL_temporary(ureg);
+      struct ureg_dst xy = ureg_writemask(tmp, TGSI_WRITEMASK_XY);
+      if (abs) {
+         ureg_insn(ureg, TGSI_OPCODE_DABS, &xy, 1, &src, 1, 0);
+         src = ureg_swizzle(ureg_src(tmp), 0, 1, 0, 1);
+      }
+      if (neg) {
+         ureg_insn(ureg, TGSI_OPCODE_DNEG, &xy, 1, &src, 1, 0);
+         src = ureg_swizzle(ureg_src(tmp), 0, 1, 0, 1);
+      }
+   }
+   return src;
+}
+
+static void
+translate_double(struct Shader_xlate *sx, const struct Shader_opcode *opcode)
+{
+   struct ureg_program *ureg = sx->ureg;
+   enum double_kind kind = DOUBLE_TO_DOUBLE;
+   enum dx10_opcode_format src_format = OF_FLOAT;
+   unsigned op = TGSI_OPCODE_MOV;
+
+   switch (opcode->type) {
+   case D3D11_SB_OPCODE_DADD: op = TGSI_OPCODE_DADD; break;
+   case D3D11_SB_OPCODE_DMAX: op = TGSI_OPCODE_DMAX; break;
+   case D3D11_SB_OPCODE_DMIN: op = TGSI_OPCODE_DMIN; break;
+   case D3D11_SB_OPCODE_DMUL: op = TGSI_OPCODE_DMUL; break;
+   case D3D11_1_SB_OPCODE_DDIV: op = TGSI_OPCODE_DDIV; break;
+   /* virglrenderer has no DFMA; DMAD is a*b+c in GLSL, which the GLSL compiler may fuse */
+   case D3D11_1_SB_OPCODE_DFMA: op = TGSI_OPCODE_DMAD; break;
+   case D3D11_1_SB_OPCODE_DRCP: op = TGSI_OPCODE_DRCP; break;
+   case D3D11_SB_OPCODE_DMOV: op = TGSI_OPCODE_MOV; break;
+   case D3D11_SB_OPCODE_DEQ: op = TGSI_OPCODE_DSEQ; kind = DOUBLE_TO_32; break;
+   case D3D11_SB_OPCODE_DGE: op = TGSI_OPCODE_DSGE; kind = DOUBLE_TO_32; break;
+   case D3D11_SB_OPCODE_DLT: op = TGSI_OPCODE_DSLT; kind = DOUBLE_TO_32; break;
+   case D3D11_SB_OPCODE_DNE: op = TGSI_OPCODE_DSNE; kind = DOUBLE_TO_32; break;
+   case D3D11_SB_OPCODE_DTOF: op = TGSI_OPCODE_D2F; kind = DOUBLE_TO_32; break;
+   case D3D11_1_SB_OPCODE_DTOI: op = TGSI_OPCODE_D2I; kind = DOUBLE_TO_32; break;
+   case D3D11_1_SB_OPCODE_DTOU: op = TGSI_OPCODE_D2U; kind = DOUBLE_TO_32; break;
+   case D3D11_SB_OPCODE_FTOD: op = TGSI_OPCODE_F2D; kind = DOUBLE_FROM_32; break;
+   case D3D11_1_SB_OPCODE_ITOD: op = TGSI_OPCODE_I2D; kind = DOUBLE_FROM_32; src_format = OF_INT; break;
+   case D3D11_1_SB_OPCODE_UTOD: op = TGSI_OPCODE_U2D; kind = DOUBLE_FROM_32; src_format = OF_UINT; break;
+   case D3D11_SB_OPCODE_DMOVC: op = TGSI_OPCODE_UCMP; kind = DOUBLE_MOVC; break;
+   default:
+      LOG_UNSUPPORTED(true);
+      return;
+   }
+
+   unsigned mask = opcode->dst[0].mask >> D3D10_SB_OPERAND_4_COMPONENT_MASK_SHIFT;
+   bool double_result = kind != DOUBLE_TO_32;
+   /* Every double is computed before the destination is written: it may be a source ("ftod r1.xyzw, r1.xyxx") */
+   struct ureg_dst result_tmp[2];
+   unsigned result_part[2], num_results = 0;
+   struct ureg_dst scratch[12];
+   unsigned num_scratch = 0;
+   for (unsigned k = 0; k < 2; k++) {
+      unsigned part;
+      if (double_result) {
+         part = k ? TGSI_WRITEMASK_ZW : TGSI_WRITEMASK_XY;
+         if (!(mask & part))
+            continue;
+      } else {
+         /* the k-th enabled component */
+         unsigned m = mask;
+         for (unsigned skip = 0; skip < k && m; skip++)
+            m &= m - 1;
+         if (!m)
+            break;
+         part = m & -m;
+      }
+
+      struct ureg_src src[3];
+      unsigned num_src = opcode->num_src;
+      for (unsigned i = 0; i < num_src; i++) {
+         if (kind == DOUBLE_FROM_32 || (kind == DOUBLE_MOVC && i == 0)) {
+            src[i] = ureg_swizzle(translate_src_operand(sx, &opcode->src[i], kind == DOUBLE_MOVC ? OF_UINT : src_format),
+                                  k, k, k, k);
+         } else {
+            src[i] = double_src(sx, &opcode->src[i], k, scratch, &num_scratch);
+         }
+      }
+
+      struct ureg_dst tmp = ureg_DECL_temporary(ureg);
+      struct ureg_dst result = ureg_writemask(tmp, double_result ? TGSI_WRITEMASK_XY : TGSI_WRITEMASK_X);
+      ureg_insn(ureg, op, &result, 1, src, num_src, 0);
+
+      if (opcode->saturate && double_result) {
+         /* _sat: clamped to [0, 1] */
+         struct ureg_src v[2] = {ureg_src(tmp), ureg_imm4u(ureg, 0, 0, 0, 0)};
+         ureg_insn(ureg, TGSI_OPCODE_DMAX, &result, 1, v, 2, 0);
+         v[1] = ureg_imm4u(ureg, 0, 0x3ff00000, 0, 0x3ff00000);
+         ureg_insn(ureg, TGSI_OPCODE_DMIN, &result, 1, v, 2, 0);
+      }
+      result_tmp[num_results] = tmp;
+      result_part[num_results++] = part;
+   }
+
+   for (unsigned r = 0; r < num_results; r++) {
+      struct ureg_dst dst = ureg_writemask(translate_dst_operand(sx, &opcode->dst[0], false), result_part[r]);
+      struct ureg_src value = ureg_src(result_tmp[r]);
+      ureg_MOV(ureg, dst, double_result ? ureg_swizzle(value, 0, 1, 0, 1) : ureg_scalar(value, 0));
+      ureg_release_temporary(ureg, result_tmp[r]);
+   }
+   for (unsigned i = 0; i < num_scratch; i++)
+      ureg_release_temporary(ureg, scratch[i]);
+}
