+   unsigned count = MAX2(desc->surfaces, 1);
+   bool planar = desc->format == NDDI_NV12;
+   unsigned tw = planar ? desc->width : (desc->width + 1) / 2;
+   unsigned th = planar ? desc->height + (desc->height + 1) / 2 : desc->height;
+   D3DFORMAT tf = planar ? D3DFMT_L8 : D3DFMT_A8R8G8B8;
+
+   res->kind = NDDI_SURFACE;
+   res->video_fourcc = desc->format;
+   res->video_width = desc->width;
+   res->video_height = desc->height;
+   res->subresource_count = count;
+   res->video_textures = CALLOC(count, sizeof(*res->video_textures));
+   res->surfaces = CALLOC(count, sizeof(*res->surfaces));
+   if (!res->video_textures || !res->surfaces)
+      return E_OUTOFMEMORY;
+   for (unsigned i = 0; i < count; i++) {
+      IDirect3DTexture9 *tex = NULL;
+      HRESULT hr = NineDevice9_CreateTexture(dev->device, tw, th, 1, D3DUSAGE_DYNAMIC, tf, D3DPOOL_DEFAULT, &tex, NULL);
+      if (FAILED(hr))
+         return hr;
+      res->video_textures[i] = NineTexture9(tex);
+      res->surfaces[i] = res->video_textures[i]->surfaces[0];
+      NineUnknown_AddRef(NineUnknown(res->surfaces[i]));
