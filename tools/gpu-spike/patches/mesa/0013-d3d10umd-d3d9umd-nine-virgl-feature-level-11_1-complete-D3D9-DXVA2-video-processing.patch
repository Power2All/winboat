+/* Clip distances (not cull distances) a shader writes */
+static unsigned
+ShaderClipDistances(Shader *shader)
+{
+   if (!shader || !shader->state.tokens) {
+      return 0;
+   }
+   if (shader->clip_scanned != shader->state.tokens) {
+      struct tgsi_shader_info info;
+      tgsi_scan_shader(shader->state.tokens, &info);
+      shader->num_clip_distances = info.properties[TGSI_PROPERTY_NUM_CLIPDIST_ENABLED];
+      shader->clip_scanned = shader->state.tokens;
+   }
+   return shader->num_clip_distances;
+}
+
 static void
 ResolveState(Device *pDevice)
 {
    struct pipe_context *pipe = pDevice->pipe;
+
+   /* The last vertex stage's clip distances, applied (RasterizerState) */
+   if (pDevice->bound_rasterizer) {
+      Shader *last = pDevice->bound_shader[PIPE_SHADER_GEOMETRY];
+      if (!last || !last->state.tokens) {
+         last = pDevice->bound_shader[PIPE_SHADER_TESS_EVAL];
+      }
+      if (!last || !last->state.tokens) {
+         last = pDevice->bound_vs;
+      }
+      void *handle = RasterizerStateForClipDistances(pipe, pDevice->bound_rasterizer, ShaderClipDistances(last));
+      if (handle != pDevice->bound_rasterizer_handle) {
+         pipe->bind_rasterizer_state(pipe, handle);
+         pDevice->bound_rasterizer_handle = handle;
+      }
+   }
    Shader *vs = pDevice->bound_vs;
    if (pDevice->bound_empty_gs && vs && vs->state.tokens) {
       Shader *gs = pDevice->bound_empty_gs;
