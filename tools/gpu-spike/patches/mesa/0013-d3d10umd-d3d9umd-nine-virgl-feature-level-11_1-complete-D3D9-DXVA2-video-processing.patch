+ *
+ *   // d3d9umd video processing: YUV (packed YUY2/UYVY in an A8R8G8B8 texture of half width, NV12 in an L8 texture of
+ *   // 1.5x height) to RGB, one output pixel per video pixel (the scaling is a StretchRect after it)
+ *   sampler2D tex : register(s0);
+ *   float4 info : register(c0);   // x: video width, y: video height, z: 1 / texture width, w: 1 / texture height
+ *   float4 mrow0 : register(c1);  // RGB = M * (Y, U, V) + offset, all 0..1
+ *   float4 mrow1 : register(c2);
+ *   float4 mrow2 : register(c3);
+ *   float4 kind : register(c4);   // x: 0 YUY2, 1 UYVY, 2 NV12, 3 RGB; y, z: source rectangle origin; w: field (bob) or -1
+ *
+ *   float4 vs_main(float4 p : POSITION) : POSITION { return p; }
+ *
+ *   float4 ps_main(float2 vpos : VPOS) : COLOR
+ *   {
+ *      float2 px = floor(vpos) + kind.yz;
+ *      if (kind.w >= 0)
+ *         px.y = min(floor(px.y * 0.5) * 2 + kind.w, info.y - 1);
+ *      float3 yuv;
+ *      if (kind.x < 1.5) {
+ *         float4 c = tex2Dlod(tex, float4((floor(px.x * 0.5) + 0.5) * info.z, (px.y + 0.5) * info.w, 0, 0));
+ *         bool odd = frac(px.x * 0.5) > 0.25;
+ *         if (kind.x < 0.5)
+ *            yuv = float3(odd ? c.r : c.b, c.g, c.a);
+ *         else
+ *            yuv = float3(odd ? c.a : c.g, c.b, c.r);
+ *      } else if (kind.x < 2.5) {
+ *         float y = tex2Dlod(tex, float4((px.x + 0.5) * info.z, (px.y + 0.5) * info.w, 0, 0)).r;
+ *         float ux = floor(px.x * 0.5) * 2;
+ *         float uy = info.y + floor(px.y * 0.5);
+ *         float u = tex2Dlod(tex, float4((ux + 0.5) * info.z, (uy + 0.5) * info.w, 0, 0)).r;
+ *         float v = tex2Dlod(tex, float4((ux + 1.5) * info.z, (uy + 0.5) * info.w, 0, 0)).r;
+ *         yuv = float3(y, u, v);
+ *      } else {
+ *         return float4(tex2Dlod(tex, float4((px.x + 0.5) * info.z, (px.y + 0.5) * info.w, 0, 0)).rgb, 1);
+ *      }
+ *      return float4(saturate(float3(dot(mrow0.xyz, yuv) + mrow0.w, dot(mrow1.xyz, yuv) + mrow1.w,
+ *                                    dot(mrow2.xyz, yuv) + mrow2.w)), 1);
+ *   }
