+                                                    (D3DMULTISAMPLE_TYPE)desc->multisample,
+                                                    desc->multisample_quality, FALSE, &surf, NULL);
+      if (FAILED(hr))
+         return hr;
+      res->surfaces[i] = NineSurface9(surf);
+   }
+   return D3D_OK;
+}
