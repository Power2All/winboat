+   res->hRTResource = p->hResource;
+   res->format = (D3DDDIFORMAT)info.format;
+   res->pool = D3DDDIPOOL_VIDEOMEMORY;
+   res->flags.Value = 0;
+   res->flags.SharedResource = 1;
+   res->flags.Texture = info.kind == NDDI_TEXTURE;
+   res->flags.RenderTarget = info.kind == NDDI_RENDER_TARGET;
+   res->flags.ZBuffer = info.kind == NDDI_DEPTH_STENCIL;
+   res->surfCount = info.kind == NDDI_TEXTURE ? info.levels : 1;
+   res->width = info.width;
