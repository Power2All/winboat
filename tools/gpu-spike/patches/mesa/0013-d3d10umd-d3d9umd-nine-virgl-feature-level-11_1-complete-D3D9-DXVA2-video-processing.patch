+{
+   struct NineDevice9 *d = dev->device;
+   D3DFORMAT format = (D3DFORMAT)desc->format;
+   res->surfaces = CALLOC(desc->surfaces, sizeof(*res->surfaces));
+   if (!res->surfaces)
+      return E_OUTOFMEMORY;
+   res->subresource_count = desc->surfaces;
+   res->surfaces[0] = NineSurface9(res->obj);
+   NineUnknown_AddRef(res->obj);
+   for (unsigned i = 1; i < desc->surfaces; i++) {
+      HRESULT hr;
+      IDirect3DSurface9 *surf = NULL;
+      if (desc->kind == NDDI_SURFACE)
+         hr = NineDevice9_CreateOffscreenPlainSurface(d, desc->width, desc->height, format, D3DPOOL_DEFAULT, &surf,
+                                                      NULL);
+      else if (desc->kind == NDDI_RENDER_TARGET)
+         hr = NineDevice9_CreateRenderTarget(d, desc->width, desc->height, format,
+                                             (D3DMULTISAMPLE_TYPE)desc->multisample, desc->multisample_quality,
+                                             desc->lockable, &surf, NULL);
+      else
