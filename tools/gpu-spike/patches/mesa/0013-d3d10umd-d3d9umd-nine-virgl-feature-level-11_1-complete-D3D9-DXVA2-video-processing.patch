+/* A shared resource another device (D3D9Ex, D3D10/11) made: the runtime opened its allocations */
+static HRESULT APIENTRY
+OpenResource(HANDLE hDevice, D3DDDIARG_OPENRESOURCE *p)
+{
+   D3D9UmdDevice *dev = D3D9UmdCastDevice(hDevice);
+   D3D9UmdResource *res = new (std::nothrow) D3D9UmdResource();
+   if (!res)
+      return E_OUTOFMEMORY;
+   nddi_opened_resource info;
+   memset(&info, 0, sizeof(info));
+   dev->kmt.pOpenResource = p;
+   HRESULT hr = nddi_resource_open(dev->nine, p->hKMResource, &res->nine, &info);
+   dev->kmt.pOpenResource = NULL;
+   D3D9UMD_TRACE("OpenResource kernel 0x%x, %u allocations -> 0x%08lx (format %u, %ux%u, %u levels, kind %u)",
+                 p->hKMResource, p->NumAllocations, hr, info.format, info.width, info.height, info.levels,
+                 (UINT)info.kind);
+   if (FAILED(hr)) {
