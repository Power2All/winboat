+static void APIENTRY
+RelocateDeviceFuncs1(D3D10DDI_HDEVICE hDevice, struct D3D11_1DDI_DEVICEFUNCS *pDeviceFunctions)
+{
+   /* Nothing to do: no pointer to the table is kept */
+}
+
+
+/* Resources: the 11 arguments extend the 10 ones (ByteStride and later come after the 10 fields) */
+static SIZE_T APIENTRY
+CalcPrivateResourceSize11(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATERESOURCE *pCreateResource)
+{
+   return funcs10.pfnCalcPrivateResourceSize(hDevice,
+                                             reinterpret_cast<const D3D10DDIARG_CREATERESOURCE *>(pCreateResource));
+}
+
+static void APIENTRY
+CreateResource11(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATERESOURCE *pCreateResource,
+                 D3D10DDI_HRESOURCE hResource, D3D10DDI_HRTRESOURCE hRTResource)
+{
+   funcs10.pfnCreateResource(hDevice, reinterpret_cast<const D3D10DDIARG_CREATERESOURCE *>(pCreateResource),
+                             hResource, hRTResource);
+}
+
+
+/* Views: shader resource views as in 10.1 (11 adds BufferEx, raw buffers of feature level 11); depth stencil
+ * views have read-only Flags (feature level 11) before the view's union */
+static SIZE_T APIENTRY
+CalcPrivateShaderResourceViewSize11(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATESHADERRESOURCEVIEW *pView)
+{
+   return CalcPrivateShaderResourceViewSize1(
+      hDevice, reinterpret_cast<const D3D10_1DDIARG_CREATESHADERRESOURCEVIEW *>(pView));
+}
+
+static void APIENTRY
+CreateShaderResourceView11(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATESHADERRESOURCEVIEW *pView,
+                           D3D10DDI_HSHADERRESOURCEVIEW hView, D3D10DDI_HRTSHADERRESOURCEVIEW hRTView)
+{
+   CreateShaderResourceView1(hDevice, reinterpret_cast<const D3D10_1DDIARG_CREATESHADERRESOURCEVIEW *>(pView), hView,
+                             hRTView);
+}
+
+static D3D10DDIARG_CREATEDEPTHSTENCILVIEW
+DepthStencilView10(const D3D11DDIARG_CREATEDEPTHSTENCILVIEW *pView)
+{
+   D3D10DDIARG_CREATEDEPTHSTENCILVIEW view = {};
+   view.hDrvResource = pView->hDrvResource;
+   view.Format = pView->Format;
+   view.ResourceDimension = pView->ResourceDimension;
+   memcpy(&view.Tex1D, &pView->Tex1D, sizeof view - offsetof(D3D10DDIARG_CREATEDEPTHSTENCILVIEW, Tex1D));
+   return view;
+}
+
+static SIZE_T APIENTRY
+CalcPrivateDepthStencilViewSize11(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATEDEPTHSTENCILVIEW *pView)
+{
+   D3D10DDIARG_CREATEDEPTHSTENCILVIEW view = DepthStencilView10(pView);
+   return funcs10.pfnCalcPrivateDepthStencilViewSize(hDevice, &view);
+}
+
+static void APIENTRY
+CreateDepthStencilView11(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATEDEPTHSTENCILVIEW *pView,
+                         D3D10DDI_HDEPTHSTENCILVIEW hView, D3D10DDI_HRTDEPTHSTENCILVIEW hRTView)
+{
+   D3D10DDIARG_CREATEDEPTHSTENCILVIEW view = DepthStencilView10(pView);
+   funcs10.pfnCreateDepthStencilView(hDevice, &view, hView, hRTView);
+}
+
+/* Render targets: unordered access views come with them in 11 (feature level 11) */
+static void APIENTRY
+SetRenderTargets11(D3D10DDI_HDEVICE hDevice, const D3D10DDI_HRENDERTARGETVIEW *phRenderTargetView, UINT NumRTVs,
+                   UINT ClearSlots, D3D10DDI_HDEPTHSTENCILVIEW hDepthStencilView,
+                   const D3D11DDI_HUNORDEREDACCESSVIEW *phUnorderedAccessView, const UINT *pUAVInitialCounts,
+                   UINT UAVStartSlot, UINT NumUAVs, UINT UAVRangeStart, UINT UAVRangeSize)
+{
+   funcs10.pfnSetRenderTargets(hDevice, phRenderTargetView, NumRTVs, ClearSlots, hDepthStencilView);
+}
+
+
+/* Blend states: 11.1 adds logic ops (not offered: OutputMergerLogicOp is FALSE) */
+static D3D10_1_DDI_BLEND_DESC
+BlendDesc10_1(const D3D11_1_DDI_BLEND_DESC *pDesc)
+{
+   D3D10_1_DDI_BLEND_DESC desc = {};
+   desc.AlphaToCoverageEnable = pDesc->AlphaToCoverageEnable;
+   desc.IndependentBlendEnable = pDesc->IndependentBlendEnable;
+   for (UINT i = 0; i < D3D10_DDI_SIMULTANEOUS_RENDER_TARGET_COUNT; i++) {
+      const D3D11_1_DDI_RENDER_TARGET_BLEND_DESC &from = pDesc->RenderTarget[i];
+      D3D10_DDI_RENDER_TARGET_BLEND_DESC1 &to = desc.RenderTarget[i];
+      to.BlendEnable = from.BlendEnable;
+      to.SrcBlend = from.SrcBlend;
+      to.DestBlend = from.DestBlend;
+      to.BlendOp = from.BlendOp;
+      to.SrcBlendAlpha = from.SrcBlendAlpha;
+      to.DestBlendAlpha = from.DestBlendAlpha;
+      to.BlendOpAlpha = from.BlendOpAlpha;
+      to.RenderTargetWriteMask = from.RenderTargetWriteMask;
+   }
+   return desc;
+}
+
+static SIZE_T APIENTRY
+CalcPrivateBlendStateSize11_1(D3D10DDI_HDEVICE hDevice, const D3D11_1_DDI_BLEND_DESC *pDesc)
+{
+   D3D10_1_DDI_BLEND_DESC desc = BlendDesc10_1(pDesc);
+   return CalcPrivateBlendStateSize1(hDevice, &desc);
+}
+
+static void APIENTRY
+CreateBlendState11_1(D3D10DDI_HDEVICE hDevice, const D3D11_1_DDI_BLEND_DESC *pDesc, D3D10DDI_HBLENDSTATE hState,
+                     D3D10DDI_HRTBLENDSTATE hRTState)
+{
+   D3D10_1_DDI_BLEND_DESC desc = BlendDesc10_1(pDesc);
+   CreateBlendState1(hDevice, &desc, hState, hRTState);
+}
+
+/* Rasterizer states: 11.1 adds ForcedSampleCount after the 10 fields (0 unless target independent rasterization) */
+static SIZE_T APIENTRY
+CalcPrivateRasterizerStateSize11_1(D3D10DDI_HDEVICE hDevice, const D3D11_1_DDI_RASTERIZER_DESC *pDesc)
+{
+   return funcs10.pfnCalcPrivateRasterizerStateSize(hDevice,
+                                                    reinterpret_cast<const D3D10_DDI_RASTERIZER_DESC *>(pDesc));
+}
+
+static void APIENTRY
+CreateRasterizerState11_1(D3D10DDI_HDEVICE hDevice, const D3D11_1_DDI_RASTERIZER_DESC *pDesc,
+                          D3D10DDI_HRASTERIZERSTATE hState, D3D10DDI_HRTRASTERIZERSTATE hRTState)
+{
+   funcs10.pfnCreateRasterizerState(hDevice, reinterpret_cast<const D3D10_DDI_RASTERIZER_DESC *>(pDesc), hState,
+                                    hRTState);
+}
+
+
+/* Shaders: 11.1's signatures have precision information (unused) */
+static SIZE_T APIENTRY
+CalcPrivateShaderSize11_1(D3D10DDI_HDEVICE hDevice, const UINT *pShaderCode,
+                          const D3D11_1DDIARG_STAGE_IO_SIGNATURES *pSignatures)
+{
+   return funcs10.pfnCalcPrivateShaderSize(hDevice, pShaderCode, &noSignatures);
+}
+
+static void APIENTRY
+CreateVertexShader11_1(D3D10DDI_HDEVICE hDevice, const UINT *pShaderCode, D3D10DDI_HSHADER hShader,
+                       D3D10DDI_HRTSHADER hRTShader, const D3D11_1DDIARG_STAGE_IO_SIGNATURES *pSignatures)
