+}
+
+static void APIENTRY
+CreatePixelShader11_1(D3D10DDI_HDEVICE hDevice, const UINT *pShaderCode, D3D10DDI_HSHADER hShader,
+                      D3D10DDI_HRTSHADER hRTShader, const D3D11_1DDIARG_STAGE_IO_SIGNATURES *pSignatures)
+{
+   funcs10.pfnCreatePixelShader(hDevice, pShaderCode, hShader, hRTShader, &noSignatures);
+}
+
+/* Geometry shaders with stream output: 11 has a stream per entry and a stride per buffer (feature level 10: one
+ * stream, the first buffer's stride) */
+struct StreamOutput10 {
+   std::vector<D3D10DDIARG_STREAM_OUTPUT_DECLARATION_ENTRY> entries;
+   D3D10DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT args;
+
+   StreamOutput10(const D3D11DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT *p) : entries(p->NumEntries), args()
+   {
+      for (UINT i = 0; i < p->NumEntries; i++) {
+         entries[i].OutputSlot = p->pOutputStreamDecl[i].OutputSlot;
+         entries[i].RegisterIndex = p->pOutputStreamDecl[i].RegisterIndex;
+         entries[i].RegisterMask = p->pOutputStreamDecl[i].RegisterMask;
+      }
+      args.pShaderCode = p->pShaderCode;
+      args.pOutputStreamDecl = entries.data();
+      args.NumEntries = p->NumEntries;
+      args.StreamOutputStrideInBytes = p->NumStrides ? p->BufferStridesInBytes[0] : 0;
+   }
+};
+
+static SIZE_T APIENTRY
+CalcPrivateGeometryShaderWithStreamOutput11_1(D3D10DDI_HDEVICE hDevice,
+                                              const D3D11DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT *pCreate,
+                                              const D3D11_1DDIARG_STAGE_IO_SIGNATURES *pSignatures)
+{
+   StreamOutput10 so(pCreate);
+   return funcs10.pfnCalcPrivateGeometryShaderWithStreamOutput(hDevice, &so.args, &noSignatures);
+}
+
+static void APIENTRY
+CreateGeometryShaderWithStreamOutput11_1(D3D10DDI_HDEVICE hDevice,
+                                         const D3D11DDIARG_CREATEGEOMETRYSHADERWITHSTREAMOUTPUT *pCreate,
+                                         D3D10DDI_HSHADER hShader, D3D10DDI_HRTSHADER hRTShader,
+                                         const D3D11_1DDIARG_STAGE_IO_SIGNATURES *pSignatures)
+{
+   StreamOutput10 so(pCreate);
+   funcs10.pfnCreateGeometryShaderWithStreamOutput(hDevice, &so.args, hShader, hRTShader, &noSignatures);
+}
