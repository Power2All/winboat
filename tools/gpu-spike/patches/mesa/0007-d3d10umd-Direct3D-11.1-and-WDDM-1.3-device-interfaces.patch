+
+void
+FillDeviceFuncs11_1(D3D11_1DDI_DEVICEFUNCS *pFuncs, const D3D10DDI_DEVICEFUNCS *pFuncs10)
+{
+   funcs10 = *pFuncs10;
+
+   /* The same as in 10.0 */
+   pFuncs->pfnPsSetShaderResources = funcs10.pfnPsSetShaderResources;
+   pFuncs->pfnPsSetShader = funcs10.pfnPsSetShader;
