+
+/* DXGI 1.3: Present1 presents a list of surfaces with dirty rectangles. DirectComposition presents its composition
+ * buffers together (a call with two, say): each one is presented as Present presents one, whole (the kernel's
+ * present takes one allocation). */
+static HRESULT APIENTRY
+Present1(DXGI_DDI_ARG_PRESENT1 *pPresent)
+{
+   HRESULT result = S_OK;
+   for (UINT i = 0; pPresent->phSurfacesToPresent && i < pPresent->SurfacesToPresent; i++) {
+      DXGI_DDI_ARG_PRESENT present = {};
+      present.hDevice = pPresent->hDevice;
+      present.hSurfaceToPresent = pPresent->phSurfacesToPresent[i].hSurface;
+      present.SrcSubResourceIndex = pPresent->phSurfacesToPresent[i].SubResourceIndex;
+      present.hDstResource = pPresent->hDstResource;
+      present.DstSubResourceIndex = pPresent->DstSubResourceIndex;
+      present.pDXGIContext = pPresent->pDXGIContext;
+      present.Flags = pPresent->Flags;
+      present.FlipInterval = pPresent->FlipInterval;
+      HRESULT hr = _Present(&present);
+      if (FAILED(hr)) {
+         result = hr;
+      }
+   }
+   return result;
+}
+
+/* Custom present durations (for video): none */
+static HRESULT APIENTRY
+CheckPresentDurationSupport(DXGI_DDI_ARG_CHECKPRESENTDURATIONSUPPORT *pCheck)
+{
+   pCheck->ClosestSmallerDuration = 0;
+   pCheck->ClosestLargerDuration = 0;
+   return S_OK;
+}
+
+void
+FillDXGIFuncs1_3(DXGI1_3_DDI_BASE_FUNCTIONS *pFuncs)
+{
+   pFuncs->pfnResolveSharedResource = ResolveSharedResource;
+   pFuncs->pfnBlt1 = Blt1;
+   pFuncs->pfnOfferResources = OfferResources;
+   pFuncs->pfnReclaimResources = ReclaimResources;
+   /* No multiplane overlays (the kernel driver has no overlay planes) */
+   pFuncs->pfnPresent1 = Present1;
+   pFuncs->pfnCheckPresentDurationSupport = CheckPresentDurationSupport;
+}
