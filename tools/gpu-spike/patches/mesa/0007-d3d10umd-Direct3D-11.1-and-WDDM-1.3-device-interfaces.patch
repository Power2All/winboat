+
+/* ClearView: a render target view, all of it or some rectangles (other views: feature level 11 or video) */
+static void APIENTRY
+ClearView(D3D10DDI_HDEVICE hDevice, D3D11DDI_HANDLETYPE viewType, VOID *hView, const FLOAT Color[4],
+          const D3D10_DDI_RECT *pRect, UINT NumRects)
+{
+   if (viewType != D3D10DDI_HT_RENDERTARGETVIEW || !hView) {
+      return;
+   }
+   D3D10DDI_HRENDERTARGETVIEW hRenderTargetView;
+   hRenderTargetView.pDrvPrivate = hView;
+   FLOAT color[4] = {Color[0], Color[1], Color[2], Color[3]};
+   if (!pRect || !NumRects) {
+      funcs10.pfnClearRenderTargetView(hDevice, hRenderTargetView, color);
+      return;
+   }
+
+   struct pipe_context *pipe = CastDevice(hDevice)->pipe;
+   struct pipe_surface *surface = RenderTargetViewSurface(hRenderTargetView);
+   if (!surface) {
+      return;
+   }
+   union pipe_color_union clear = {};
+   for (unsigned i = 0; i < 4; i++) {
+      if (util_format_is_pure_sint(surface->format)) {
+         clear.i[i] = (int)color[i];
+      } else if (util_format_is_pure_uint(surface->format)) {
+         clear.ui[i] = color[i] > 0.0f ? (unsigned)color[i] : 0;
+      } else {
+         clear.f[i] = color[i];
+      }
+   }
+   for (UINT r = 0; r < NumRects; r++) {
+      LONG left = MAX2(pRect[r].left, 0), top = MAX2(pRect[r].top, 0);
+      LONG right = MIN2(pRect[r].right, (LONG)surface->width), bottom = MIN2(pRect[r].bottom, (LONG)surface->height);
+      if (right > left && bottom > top) {
+         pipe->clear_render_target(pipe, surface, &clear, left, top, right - left, bottom - top, true);
+      }
+   }
+}
+
