From: WinBoat
Subject: [PATCH] d3d10umd: Direct3D 11.1 and WDDM 1.3 device interfaces

The driver offered only the D3D10.0 DDI, so the D3D11 runtime ran it as a 10.x driver: no extended resource sharing
(NT handles, the A8 and BC formats DirectComposition uses for composition surfaces), so packaged apps' caption
buttons, drawn through DirectComposition, were white or missing. Offer the D3D11.1 and WDDM 1.3 DDIs as well,
still at feature level 10_0 (D3D11DDICAPS_3DPIPELINESUPPORT):

- D3D11_1.cpp builds the 11.1 device table from the 10.0 one: wrappers for the 11.x argument structures (resources,
  views, blend/rasterizer state, shaders without signatures, stream output), constant buffer ranges
  (SetConstantBuffers1), ClearView, the *1 copy/update functions, and stubs (E_NOTIMPL or no-ops) for what feature
  level 10_0 doesn't reach (UAVs, tessellation, compute, deferred contexts). The WDDM 1.3 table extends it (tiled
  resources refused, markers ignored).
- DXGI 1.2/1.3: Present1 presents every surface of a batch (DirectComposition presents several at once), plus
  Blt1, Offer/ReclaimResources, ResolveSharedResource and CheckPresentDurationSupport.
- OutputMerger exports RenderTargetViewSurface for ClearView.
---
diff --git a/src/gallium/frontends/d3d10umd/D3D11_1.h b/src/gallium/frontends/d3d10umd/D3D11_1.h
new file mode 100644
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/D3D11_1.h
@@ -0,0 +1,21 @@
+/*
+ * D3D11_1.h --
+ *    The Direct3D 11.1 DDI on top of the D3D10 entry points (see D3D11_1.cpp).
+ */
+
+#pragma once
+
+#include "DriverIncludes.h"
+
+/* Fills the 11.1 device function table from a filled 10.0 one (kept for the wrappers to call) */
+void FillDeviceFuncs11_1(D3D11_1DDI_DEVICEFUNCS *pFuncs, const D3D10DDI_DEVICEFUNCS *pFuncs10);
+
+/* The WDDM 1.3 table: the 11.1 one and tiled resources (refused) and markers */
+void FillDeviceFuncsWDDM1_3(D3DWDDM1_3DDI_DEVICEFUNCS *pFuncs, const D3D10DDI_DEVICEFUNCS *pFuncs10);
+
+/* The DXGI 1.2 and 1.3 entry points the 1.0 table doesn't have */
+void FillDXGIFuncs1_2(DXGI1_2_DDI_BASE_FUNCTIONS *pFuncs);
+void FillDXGIFuncs1_3(DXGI1_3_DDI_BASE_FUNCTIONS *pFuncs);
+
+HRESULT APIENTRY RetrieveSubObject11_1(D3D10DDI_HDEVICE hDevice, UINT32 SubDeviceID, SIZE_T ParamSize,
+                                       void *pParams, SIZE_T OutputParamSize, void *pOutputParamsBuffer);
diff --git a/src/gallium/frontends/d3d10umd/D3D11_1.cpp b/src/gallium/frontends/d3d10umd/D3D11_1.cpp
new file mode 100644
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/D3D11_1.cpp
@@ -0,0 +1,712 @@
+/*
+ * D3D11_1.cpp --
+ *    The Direct3D 11.1 and WDDM 1.3 DDIs, at feature level 10_0, on top of the D3D10 entry points.
+ *
+ *    The D3D11 runtime talks to a 10.x driver through the 10.x DDI, and then keeps some Direct3D 11.1 features
+ *    from it: ExtendedResourceSharing above all, which lets formats beyond the basic ones be shared with NT
+ *    handles. Windows' composition needs that (alpha-only surfaces of the frame of packaged apps: their caption
+ *    buttons came out as white blocks or not at all). With this interface the runtime grants it.
+ *
+ *    Most entry points keep their 10.x form: they are the 10.0 functions. The changed ones are wrappers that
+ *    convert their arguments. Constant buffer offsets, ClearView and the 11.1 Flush are implemented; the stages
+ *    and features of feature level 11 (tessellation, compute, unordered access views, command lists) are refused
+ *    or ignored: the runtime doesn't use them at feature level 10_0 (GetCaps says so), and emulates deferred
+ *    contexts itself (no threading caps).
+ *
+ *    The WDDM 1.3 DDI adds tiled resources (not offered: refused) and markers to the 11.1 one, and DXGI 1.3's
+ *    Present1. The runtime lets drivers with it (and no others) have composition buffers in more formats than
+ *    BGRA/RGBA: alpha-only (A8) ones, which DirectComposition makes masks of (the caption buttons again).
+ */
+
+#include "D3D11_1.h"
+
+#include "DxgiFns.h"
+#include "OutputMerger.h"
+#include "Shader.h"
+#include "State.h"
+
+#include "util/format/u_format.h"
+
+#include <type_traits>
+#include <vector>
+
+/* The 10.0 functions (the same for every device) */
+static D3D10DDI_DEVICEFUNCS funcs10;
+
+/* Stubs for the entry points of feature level 11: nothing to do, sizes of a minimal private object, or E_NOTIMPL */
+template <typename F> struct Stub;
+template <typename R, typename... A> struct Stub<R(APIENTRY *)(A...)> {
+   static R APIENTRY Call(A...)
+   {
+      if constexpr (std::is_void_v<R>) {
+         return;
+      } else if constexpr (std::is_same_v<R, HRESULT>) {
+         return E_NOTIMPL;
+      } else {
+         return R(16);
+      }
+   }
+};
+#define STUB(member) (pFuncs->member = Stub<decltype(pFuncs->member)>::Call)
+
+/* The shader stages' IO signatures: the 10.x shader functions don't read them */
+static const D3D10DDIARG_STAGE_IO_SIGNATURES noSignatures = {};
+
+
+/* Constant buffers, with 11.1's offsets: pFirstConstant/pNumConstants in 16-byte constants (a multiple of 16
+ * constants, 256 bytes); without them the whole buffer. Slot 0 is the driver's own, as in SetConstantBuffers. */
+static void
+SetConstantBuffers1(enum pipe_shader_type shader, D3D10DDI_HDEVICE hDevice, UINT StartSlot, UINT NumBuffers,
+                    const D3D10DDI_HRESOURCE *phBuffers, const UINT *pFirstConstant, const UINT *pNumConstants)
+{
+   struct pipe_context *pipe = CastDevice(hDevice)->pipe;
+
+   for (UINT i = 0; i < NumBuffers; i++) {
+      struct pipe_constant_buffer cb = {};
+      cb.buffer = CastPipeResource(phBuffers[i]);
+      if (cb.buffer) {
+         unsigned size = cb.buffer->width0;
+         if (pFirstConstant && pNumConstants) {
+            cb.buffer_offset = MIN2(pFirstConstant[i] * 16, size);
+            cb.buffer_size = MIN2(pNumConstants[i] * 16, size - cb.buffer_offset);
+         } else {
+            cb.buffer_size = size;
+         }
+      }
+      pipe->set_constant_buffer(pipe, shader, StartSlot + i + 1, false, &cb);
+   }
+}
+
+static void APIENTRY
+VsSetConstantBuffers1(D3D10DDI_HDEVICE hDevice, UINT StartSlot, UINT NumBuffers, const D3D10DDI_HRESOURCE *phBuffers,
+                      const UINT *pFirstConstant, const UINT *pNumConstants)
+{
+   SetConstantBuffers1(PIPE_SHADER_VERTEX, hDevice, StartSlot, NumBuffers, phBuffers, pFirstConstant, pNumConstants);
+}
+
+static void APIENTRY
+GsSetConstantBuffers1(D3D10DDI_HDEVICE hDevice, UINT StartSlot, UINT NumBuffers, const D3D10DDI_HRESOURCE *phBuffers,
+                      const UINT *pFirstConstant, const UINT *pNumConstants)
+{
+   SetConstantBuffers1(PIPE_SHADER_GEOMETRY, hDevice, StartSlot, NumBuffers, phBuffers, pFirstConstant,
+                       pNumConstants);
+}
+
+static void APIENTRY
+PsSetConstantBuffers1(D3D10DDI_HDEVICE hDevice, UINT StartSlot, UINT NumBuffers, const D3D10DDI_HRESOURCE *phBuffers,
+                      const UINT *pFirstConstant, const UINT *pNumConstants)
+{
+   SetConstantBuffers1(PIPE_SHADER_FRAGMENT, hDevice, StartSlot, NumBuffers, phBuffers, pFirstConstant,
+                       pNumConstants);
+}
+
+
+/* Copies and updates: 11.1's CopyFlags (discard, no overwrite) are hints */
+static void APIENTRY
+ResourceUpdateSubresourceUP1(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hDstResource, UINT DstSubresource,
+                             const D3D10_DDI_BOX *pDstBox, const VOID *pSysMemUP, UINT RowPitch, UINT DepthPitch,
+                             UINT CopyFlags)
+{
+   funcs10.pfnResourceUpdateSubresourceUP(hDevice, hDstResource, DstSubresource, pDstBox, pSysMemUP, RowPitch,
+                                          DepthPitch);
+}
+
+static void APIENTRY
+DefaultConstantBufferUpdateSubresourceUP1(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hDstResource,
+                                          UINT DstSubresource, const D3D10_DDI_BOX *pDstBox, const VOID *pSysMemUP,
+                                          UINT RowPitch, UINT DepthPitch, UINT CopyFlags)
+{
+   funcs10.pfnDefaultConstantBufferUpdateSubresourceUP(hDevice, hDstResource, DstSubresource, pDstBox, pSysMemUP,
+                                                       RowPitch, DepthPitch);
+}
+
+static void APIENTRY
+ResourceCopyRegion1(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hDstResource, UINT DstSubresource, UINT DstX,
+                    UINT DstY, UINT DstZ, D3D10DDI_HRESOURCE hSrcResource, UINT SrcSubresource,
+                    const D3D10_DDI_BOX *pSrcBox, UINT CopyFlags)
+{
+   funcs10.pfnResourceCopyRegion(hDevice, hDstResource, DstSubresource, DstX, DstY, DstZ, hSrcResource,
+                                 SrcSubresource, pSrcBox);
+}
+
+
+static BOOL APIENTRY
+Flush1(D3D10DDI_HDEVICE hDevice, UINT FlushFlags)
+{
+   funcs10.pfnFlush(hDevice);
+   return TRUE;
+}
