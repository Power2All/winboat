From: WinBoat
Subject: [PATCH] d3d9umd, d3d10umd: devices on Windows 8.1 (WDDM 1.3 runtimes)

Windows 8.1's runtimes are WDDM 1.3 ones, and both drivers assumed Windows 10's:
- Their device callbacks end before WDDM 2.0's residency ones (MakeResident and the rest), so what gdikmt took for those
  was garbage and calling it crashed creating the device. With a WDDM 1.3 kernel driver (the adapter probe's Wddm2
  flag) the residency path counts as tried, and is never called.
- Direct3D 9's device function table ends before WDDM 2.0's entries (TrimResidencySet on): writing ours whole corrupted
  the runtime's heap (0xC0000374). Only the runtime version's part is written (from what the runtime put there).
  SetMarker and SetMarkerMode are WDDM 1.3 entries and stay in: without all seven of its new entries 8.1's runtime
  doesn't take Flush1 and Present1 but calls the old Flush, which the driver leaves null (the runtime refuses both).
- The crash handler also logs the stack's module addresses, the caller of a call to a null pointer among them.
Windows 8.1 on a stock host: Direct3D 9 3 -> 75 of 75 passed (9Ex and device reset included).
---
diff --git a/src/gallium/frontends/d3d10umd/Adapter.cpp b/src/gallium/frontends/d3d10umd/Adapter.cpp
index e597888..5004ef2 100644
--- a/src/gallium/frontends/d3d10umd/Adapter.cpp
+++ b/src/gallium/frontends/d3d10umd/Adapter.cpp
@@ -209,6 +209,7 @@ GetSupportedVersions(D3D10DDI_HADAPTER hAdapter,
  */
 static union virgl_caps host_caps;   /* read by HostSupportsFL11 */
 static bool host_caps_valid;
+static int host_wddm2 = -1;          /* the kernel driver's model, from the same probe: 1 WDDM 2.0, 0 WDDM 1.3, -1 unknown */
 
 static bool
 HostSupportsFL11(void)
@@ -253,6 +254,7 @@ HostSupportsFL11(void)
       query.PrivateDriverDataSize = sizeof info;
       if (!found && NT_SUCCESS(queryAdapterInfo(&query)) && info.IamVioGPU == VIOGPU_IAM &&
           info.Flags.Supports3d && (info.SupportedCapsetIDs & (1ull << 2))) {
+         host_wddm2 = info.Flags.Wddm2;
          union virgl_caps caps = {};
          VIOGPU_ESCAPE args = {};
          args.Type = VIOGPU_GET_CAPS;
@@ -285,6 +287,15 @@ HostSupportsFL11(void)
    return fl11;
 }
 
+/* Whether the kernel driver is definitely WDDM 1.3 (Windows 8.1): there the runtime's callbacks end before WDDM 2.0's
+ * residency ones, which gdikmt_wddm2_make_resident must then not touch */
+bool
+HostKernelIsWddm1(void)
+{
+   HostSupportsFL11();
+   return host_wddm2 == 0;
+}
+
 
 /*
  * Feature level 10_1 for hosts short of 11_0 (older GPUs): cube map arrays, independent blending, Gather and 4x MSAA
diff --git a/src/gallium/frontends/d3d10umd/Device.cpp b/src/gallium/frontends/d3d10umd/Device.cpp
index a60a285..be31819 100644
--- a/src/gallium/frontends/d3d10umd/Device.cpp
+++ b/src/gallium/frontends/d3d10umd/Device.cpp
@@ -44,6 +44,9 @@
 #include "Video.h"
 #include "Format.h"
 
+/* Adapter.cpp: the kernel driver is WDDM 1.3 (Windows 8.1), as the adapter probe found */
+bool HostKernelIsWddm1(void);
+
 #include "Debug.h"
 
 #include "util/format/u_format.h"
@@ -145,6 +148,8 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
    pDevice->device.hRTDevice = (HANDLE)pCreateData->hRTDevice.handle;
 
    pDevice->device.KTCallbacks = *pCreateData->pKTCallbacks;
+   /* Windows 8.1's callbacks have no WDDM 2.0 residency ones: what follows them isn't ours to call */
+   pDevice->device.residency.tried = HostKernelIsWddm1();
    pDevice->device.pAdapterCallbacks = &pAdapter->AdapterCallbacks;
    pDevice->device.pDXGIBaseCallbacks = pCreateData->DXGIBaseDDI.pDXGIBaseCallbacks;
 
diff --git a/src/gallium/frontends/d3d9umd/adapter.cpp b/src/gallium/frontends/d3d9umd/adapter.cpp
index e5695d7..7427ef8 100644
--- a/src/gallium/frontends/d3d9umd/adapter.cpp
+++ b/src/gallium/frontends/d3d9umd/adapter.cpp
@@ -8,6 +8,7 @@
 #include "d3d9umd.h"
 
 #include <new>
+#include <stddef.h>
 #include <string.h>
 #include <vector>
 
@@ -226,6 +227,9 @@ CreateDevice(HANDLE hAdapter, D3DDDIARG_CREATEDEVICE *pCreateData)
    device->kmt.callbacks = *pCreateData->pCallbacks;
    device->kmt.adapterCallbacks = &adapter->callbacks;
    gdikmt_d3d9_init(&device->kmt);
+   /* A WDDM 1.3 kernel driver (Windows 8.1): its runtime's callbacks end before WDDM 2.0's residency ones, whatever
+    * follows them in the copy is garbage (it was called: an access violation creating the device) */
+   device->kmt.residency.tried = !adapter->wddm2;
 
    D3D9UMD_TRACE("CreateDevice: creating the virgl screen");
    device->screen = virgl_gdi_screen_create(&device->kmt.base);
@@ -243,8 +247,21 @@ CreateDevice(HANDLE hAdapter, D3DDDIARG_CREATEDEVICE *pCreateData)
    }
    device->viewport.max_z = 1.0f;
 
-   D3D9UmdFillStubs(pCreateData->pDeviceFuncs);
-   D3D9UmdFillDeviceFuncs(pCreateData->pDeviceFuncs);
+   /* The runtime's table ends where its interface version does: Windows 8.1's (WDDM 1.3) before the WDDM 2.0 entries
+    * (TrimResidencySet on). Writing ours whole there corrupted its heap (0xC0000374). SetMarker and SetMarkerMode are
+    * 8.1's though: without them its runtime doesn't take Flush1 and Present1 but calls the (null) Flush */
+   const size_t size = pCreateData->Version >= D3D_UMD_INTERFACE_VERSION_WDDM2_0 ? sizeof(D3DDDI_DEVICEFUNCS)
+                                                                               : offsetof(D3DDDI_DEVICEFUNCS, pfnTrimResidencySet);
+   /* (starting from what the runtime put in its table: entries we don't fill stay its own) */
+   D3DDDI_DEVICEFUNCS funcs = {};
+   memcpy(&funcs, pCreateData->pDeviceFuncs, size);
+   D3D9UmdFillStubs(&funcs);
+   D3D9UmdFillDeviceFuncs(&funcs);
+   memcpy(pCreateData->pDeviceFuncs, &funcs, size);
+   for (size_t i = 0; i < size / sizeof(void *); i++) {
+      if (!((void *const *)&funcs)[i])
+         D3D9UMD_TRACE("CreateDevice: device function %zu (offset 0x%zx) null", i, i * sizeof(void *));
+   }
    pCreateData->hDevice = device;
    return S_OK;
 }
diff --git a/src/gallium/frontends/d3d9umd/debug.cpp b/src/gallium/frontends/d3d9umd/debug.cpp
index 3de5586..ae79a9d 100644
--- a/src/gallium/frontends/d3d9umd/debug.cpp
+++ b/src/gallium/frontends/d3d9umd/debug.cpp
@@ -91,6 +91,22 @@ CrashHandler(EXCEPTION_POINTERS *info)
    D3D9UmdLog("exception 0x%08lx at %s (address 0x%llx)", code, where,
               code == EXCEPTION_ACCESS_VIOLATION
                  ? (unsigned long long)info->ExceptionRecord->ExceptionInformation[1] : 0ull);
+   /* The faulting code's stack: its top slots that point into a module (a call to a null pointer leaves its caller
+    * as the first) */
+#ifdef _WIN64
+   const ULONG_PTR *sp = (const ULONG_PTR *)info->ContextRecord->Rsp;
+#else
+   const ULONG_PTR *sp = (const ULONG_PTR *)info->ContextRecord->Esp;
+#endif
+   for (int i = 0, shown = 0; i < 64 && shown < 8 && !IsBadReadPtr(sp + i, sizeof(*sp)); i++) {
+      HMODULE module;
+      if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                             (LPCSTR)sp[i], &module)) {
+         DescribeAddress((const void *)sp[i], where, sizeof(where));
+         D3D9UmdLog("  stack[%d] %s", i, where);
+         shown++;
+      }
+   }
    void *frames[32];
    USHORT count = RtlCaptureStackBackTrace(0, ARRAYSIZE(frames), frames, NULL);
    for (USHORT i = 0; i < count; i++) {
