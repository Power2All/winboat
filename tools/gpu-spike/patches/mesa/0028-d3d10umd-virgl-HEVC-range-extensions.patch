+/* DXVA_PicParams_HEVC_RangeExt (the range extension profiles: Main12, Main_444, Main10_444, Main12_444): the base
+ * parameters, then these. The flags' bit order isn't VA's: persistent_rice (6) and high_precision_offsets (7) swap */
+struct DxvaPicParams_HEVC_RangeExt {
+   DxvaPicParams_HEVC params;
+   uint16_t transform_skip_rotation_enabled_flag : 1;
+   uint16_t transform_skip_context_enabled_flag : 1;
+   uint16_t implicit_rdpcm_enabled_flag : 1;
+   uint16_t explicit_rdpcm_enabled_flag : 1;
+   uint16_t extended_precision_processing_flag : 1;
+   uint16_t intra_smoothing_disabled_flag : 1;
+   uint16_t persistent_rice_adaptation_enabled_flag : 1;
+   uint16_t high_precision_offsets_enabled_flag : 1;
+   uint16_t cabac_bypass_alignment_enabled_flag : 1;
+   uint16_t cross_component_prediction_enabled_flag : 1;
+   uint16_t chroma_qp_offset_list_enabled_flag : 1;
+   uint16_t ReservedBits8 : 5;
+   uint8_t diff_cu_chroma_qp_offset_depth;
+   uint8_t log2_sao_offset_scale_luma;
+   uint8_t log2_sao_offset_scale_chroma;
+   uint8_t log2_max_transform_skip_block_size_minus2;
+   int8_t cb_qp_offset_list[6];
+   int8_t cr_qp_offset_list[6];
+   uint8_t chroma_qp_offset_list_len_minus1;
+   uint16_t ReservedBits9;
+};
+
 struct DxvaQmatrix_HEVC {
    uint8_t ucScalingLists0[6][16];
    uint8_t ucScalingLists1[6][64];
@@ -584,6 +610,16 @@ static const VideoProfileInfo PROFILES[] = {
     PIPE_VIDEO_PROFILE_HEVC_MAIN, DXGI_FORMAT_NV12, CODEC_HEVC},
    {{0x107af0e0, 0xef1a, 0x4d19, {0xab, 0xa8, 0x67, 0xa1, 0x63, 0x07, 0x3d, 0x13}}, /* HEVC_VLD_MAIN10 */
     PIPE_VIDEO_PROFILE_HEVC_MAIN_10, DXGI_FORMAT_P010, CODEC_HEVC},
+   /* the range extensions (DXVA_ModeHEVC_VLD_*, as d3d12video.h's D3D12_VIDEO_DECODE_PROFILE_HEVC_*): 12-bit 4:2:0
+    * and 4:4:4 at 8, 10 and 12 bits (one gallium profile, the output format names the depth) */
+   {{0x1a72925f, 0x0c2c, 0x4f15, {0x96, 0xfb, 0xb1, 0x7d, 0x14, 0x73, 0x60, 0x3f}}, /* HEVC_VLD_MAIN12 */
+    PIPE_VIDEO_PROFILE_HEVC_MAIN_12, DXGI_FORMAT_P016, CODEC_HEVC},
+   {{0x4008018f, 0xf537, 0x4b36, {0x98, 0xcf, 0x61, 0xaf, 0x8a, 0x2c, 0x1a, 0x33}}, /* HEVC_VLD_MAIN_444 */
+    PIPE_VIDEO_PROFILE_HEVC_MAIN_444, DXGI_FORMAT_AYUV, CODEC_HEVC},
+   {{0x0dabeffa, 0x4458, 0x4602, {0xbc, 0x03, 0x07, 0x95, 0x65, 0x9d, 0x61, 0x7c}}, /* HEVC_VLD_MAIN10_444 */
+    PIPE_VIDEO_PROFILE_HEVC_MAIN_444, DXGI_FORMAT_Y410, CODEC_HEVC},
+   {{0x9798634d, 0xfe9d, 0x48e5, {0xb4, 0xda, 0xdb, 0xec, 0x45, 0xb3, 0xdf, 0x01}}, /* HEVC_VLD_MAIN12_444 */
+    PIPE_VIDEO_PROFILE_HEVC_MAIN_444, DXGI_FORMAT_Y416, CODEC_HEVC},
    {{0x463707f8, 0xa1d0, 0x4585, {0x87, 0x6d, 0x83, 0xaa, 0x6d, 0x60, 0xb8, 0x9e}}, /* VP9_VLD_PROFILE0 */
     PIPE_VIDEO_PROFILE_VP9_PROFILE0, DXGI_FORMAT_NV12, CODEC_VP9},
    {{0xa4c749ef, 0x6ecf, 0x48aa, {0x84, 0x48, 0x50, 0xa7, 0xa1, 0x16, 0x5f, 0xf7}}, /* VP9_VLD_10BIT_PROFILE2 */
