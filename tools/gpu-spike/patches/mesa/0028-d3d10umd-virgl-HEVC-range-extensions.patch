From: WinBoat
Subject: [PATCH] d3d10umd, virgl: HEVC range extensions (12-bit, 4:4:4)

Microsoft's DXVA HEVC range extension profiles in the Direct3D 11 driver: HEVC_VLD_Main12 (P016),
HEVC_VLD_Main_444 (AYUV), Main10_444 (Y410) and Main12_444 (Y416), as Chromium's D3D11 decoder (Chrome, Edge) picks
them. Through virgl to the host's VA-API (virglrenderer 0015, nvidia-vaapi-driver 0006 on NVDEC):
- DxvaDecode: DXVA_PicParams_HEVC_RangeExt (the SDK's layout: 16-bit flags, persistent_rice and
  high_precision_offsets in the other order than VA's) into fields appended to pipe_h265_picture_desc and
  virgl_h265_picture_desc (VA's flag order; the union's size stays AV1's). One gallium profile for 4:4:4
  (HEVC_MAIN_444): the output format names the depth
- P016 textures as NV12/P010 ones (two planes, 16-bit)
- AYUV/Y410/Y416 textures are RGBA textures (R8G8B8A8, R10G10B10A2, R16G16B16A16; the D3D layouts: AYUV V, U, Y, A,
  Y410/Y416 U, Y, V, A), so views, maps and copies are the ordinary ones. The decoder gives each array slice a video
  buffer of that RGBA format (the host packs the picture into it), copied into the slice after each frame; the codec
  is created 4:4:4. The video processor takes them as YUV: the slice wrapped as a video buffer whose Y, U and V
  component views are swizzles of it
Tested in the spike with an ffmpeg patched for these GUIDs (upstream's DXVA code has only HEVC Main/Main10): the
FATE suite's 4:4:4 RExt clips (QMATRIX_A, IPCM_B, PERSIST_RPARAM_A, SAO_A) and x265 encodes (4:4:4 8/10/12-bit,
4:2:0 12-bit) bit-exact against libavcodec through d3d11va.
ponytail: D3D11 only (the D3D9/DXVA2 path offers NV12 profiles); 4:4:4 progressive only in the video processor.

diff --git a/src/gallium/drivers/virgl/virgl_video.c b/src/gallium/drivers/virgl/virgl_video.c
index db61809..1915918 100644
--- a/src/gallium/drivers/virgl/virgl_video.c
+++ b/src/gallium/drivers/virgl/virgl_video.c
@@ -407,6 +407,16 @@ static int fill_h265_picture_desc(const struct pipe_picture_desc *desc,
     ITEM_SET(vh265, h265, UseRefPicList);
     ITEM_SET(vh265, h265, UseStRpsBits);
 
+    /* range extensions (WinBoat) */
+    ITEM_SET(vh265, h265, rext_flags);
+    ITEM_SET(vh265, h265, diff_cu_chroma_qp_offset_depth);
+    ITEM_SET(vh265, h265, chroma_qp_offset_list_len_minus1);
+    ITEM_SET(vh265, h265, log2_sao_offset_scale_luma);
+    ITEM_SET(vh265, h265, log2_sao_offset_scale_chroma);
+    ITEM_SET(vh265, h265, log2_max_transform_skip_block_size_minus2);
+    ITEM_CPY(vh265, h265, cb_qp_offset_list);
+    ITEM_CPY(vh265, h265, cr_qp_offset_list);
+
     return 0;
 }
 
diff --git a/src/gallium/frontends/d3d10umd/DxvaDecode.cpp b/src/gallium/frontends/d3d10umd/DxvaDecode.cpp
index 5da429d..19388d7 100644
--- a/src/gallium/frontends/d3d10umd/DxvaDecode.cpp
+++ b/src/gallium/frontends/d3d10umd/DxvaDecode.cpp
@@ -381,6 +381,25 @@ HEVCPicture(DxvaDecoder *dec)
    d->NumPocTotalCurr = d->NumPocStCurrBefore + d->NumPocStCurrAfter + d->NumPocLtCurr;
    /* ponytail: no per-slice reference lists (the short slice format has none): NVIDIA's VA-API driver builds them
     * from the reference sets, Mesa's (AMD) read RefPicList - those need the slice headers parsed */
+
+   /* The range extension profiles' parameters after the base ones, the flags into VA's order */
+   static_assert(sizeof(DxvaPicParams_HEVC_RangeExt) == sizeof(DxvaPicParams_HEVC) + 21, "DXVA_PicParams_HEVC_RangeExt");
+   if (dec->pic_params.size() >= sizeof(DxvaPicParams_HEVC_RangeExt)) {
+      const DxvaPicParams_HEVC_RangeExt *r = (const DxvaPicParams_HEVC_RangeExt *)dec->pic_params.data();
+      d->rext_flags = r->transform_skip_rotation_enabled_flag << 0 | r->transform_skip_context_enabled_flag << 1 |
+                      r->implicit_rdpcm_enabled_flag << 2 | r->explicit_rdpcm_enabled_flag << 3 |
+                      r->extended_precision_processing_flag << 4 | r->intra_smoothing_disabled_flag << 5 |
+                      r->high_precision_offsets_enabled_flag << 6 | r->persistent_rice_adaptation_enabled_flag << 7 |
+                      r->cabac_bypass_alignment_enabled_flag << 8 | r->cross_component_prediction_enabled_flag << 9 |
+                      r->chroma_qp_offset_list_enabled_flag << 10;
+      d->diff_cu_chroma_qp_offset_depth = r->diff_cu_chroma_qp_offset_depth;
+      d->chroma_qp_offset_list_len_minus1 = r->chroma_qp_offset_list_len_minus1;
+      d->log2_sao_offset_scale_luma = r->log2_sao_offset_scale_luma;
+      d->log2_sao_offset_scale_chroma = r->log2_sao_offset_scale_chroma;
+      d->log2_max_transform_skip_block_size_minus2 = r->log2_max_transform_skip_block_size_minus2;
+      memcpy(d->cb_qp_offset_list, r->cb_qp_offset_list, sizeof d->cb_qp_offset_list);
+      memcpy(d->cr_qp_offset_list, r->cr_qp_offset_list, sizeof d->cr_qp_offset_list);
+   }
    return true;
 }
 
