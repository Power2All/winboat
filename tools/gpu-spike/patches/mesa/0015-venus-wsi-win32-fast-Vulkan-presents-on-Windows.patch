+/* GDI draws straight from the mapped image: a top-down 32-bit DIB as wide as a row of it (its pitch is a multiple of
+ * 4 bytes), clipped to the swapchain's width. Copying it into the DIB section first cost a pass over every pixel.
+ */
+static bool
+wsi_win32_draw_image(struct wsi_win32_swapchain *chain, struct wsi_win32_image *image, HDC dc)
+{
+   BITMAPINFO info = {};
+   info.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+   info.bmiHeader.biWidth = image->base.row_pitches[0] / 4;
+   info.bmiHeader.biHeight = -(LONG)chain->extent.height;
+   info.bmiHeader.biPlanes = 1;
+   info.bmiHeader.biBitCount = 32;
+   info.bmiHeader.biCompression = BI_RGB;
+   return StretchDIBits(dc, 0, 0, chain->extent.width, chain->extent.height, 0, 0, chain->extent.width,
+                        chain->extent.height, image->base.cpu_map, &info, DIB_RGB_COLORS, SRCCOPY) != 0;
+}
+
+static DWORD WINAPI
+wsi_win32_present_thread(void *data)
+{
+   struct wsi_win32_swapchain *chain = (struct wsi_win32_swapchain *)data;
+   const struct wsi_device *wsi = chain->base.wsi;
+   HDC dc = GetDC(chain->wnd);
+   /* FIFO and MAILBOX: one frame per composition of the desktop (DwmFlush waits for the next one) */
+   typedef HRESULT(WINAPI * PFN_DwmFlush)(void);
+   HMODULE dwmapi = chain->base.present_mode != VK_PRESENT_MODE_IMMEDIATE_KHR ? LoadLibraryA("dwmapi.dll") : NULL;
+   PFN_DwmFlush dwm_flush = dwmapi ? (PFN_DwmFlush)GetProcAddress(dwmapi, "DwmFlush") : NULL;
+
+   EnterCriticalSection(&chain->sw.lock);
+   while (!chain->sw.stop) {
+      /* the oldest queued image: presents keep their order (FIFO) */
+      struct wsi_win32_image *image = NULL;
+      for (uint32_t i = 0; i < chain->base.image_count; i++) {
+         struct wsi_win32_image *candidate = &chain->images[i];
+         if (candidate->state == WSI_IMAGE_QUEUED && (!image || candidate->sw.serial < image->sw.serial))
+            image = candidate;
+      }
+      if (!image) {
+         SleepConditionVariableCS(&chain->sw.cond, &chain->sw.lock, INFINITE);
+         continue;
+      }
+      chain->sw.current = image;
+      LeaveCriticalSection(&chain->sw.lock);
+
+      const uint32_t index = image - chain->images;
+      VkResult result = wsi->WaitForFences(chain->base.device, 1, &chain->base.fences[index], true, UINT64_MAX);
+      if (result == VK_SUCCESS && !wsi_win32_draw_image(chain, image, dc))
+         result = VK_ERROR_SURFACE_LOST_KHR;
+
+      /* GDI has copied the pixels: the image goes back before the wait for the compositor */
+      EnterCriticalSection(&chain->sw.lock);
+      if (result != VK_SUCCESS && chain->status == VK_SUCCESS)
+         chain->status = result;
+      image->state = WSI_IMAGE_IDLE;
+      chain->sw.current = NULL;
+      WakeAllConditionVariable(&chain->sw.cond);
+
+      if (result == VK_SUCCESS && dwm_flush) {
+         LeaveCriticalSection(&chain->sw.lock);
+         if (FAILED(dwm_flush()))
+            Sleep(1); /* no composition (a minimized or hidden desktop): don't spin */
+         EnterCriticalSection(&chain->sw.lock);
+      }
+   }
+   LeaveCriticalSection(&chain->sw.lock);
+
+   ReleaseDC(chain->wnd, dc);
+   if (dwmapi)
+      FreeLibrary(dwmapi);
+   return 0;
+}
