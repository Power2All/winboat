diff --git a/src/util/os_time.c b/src/util/os_time.c
--- a/src/util/os_time.c
+++ b/src/util/os_time.c
@@ -75,6 +75,26 @@
    usleep(usecs);
 
 #elif DETECT_OS_WINDOWS
+   if (usecs <= 0)
+      return;
+   /* Sleep() lasts at least one tick of the system timer, 15.6 ms unless some process raised its resolution: a
+    * wait that polls with short sleeps (Venus' vn_relax starts at 160 us) then waits a whole tick each time. A
+    * high-resolution waitable timer (Windows 10 1803 and later) sleeps for the time asked.
+    */
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+   HANDLE timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                         TIMER_ALL_ACCESS);
+   if (timer) {
+      LARGE_INTEGER due;
+      due.QuadPart = -usecs * 10; /* relative, in 100 ns units */
+      if (SetWaitableTimer(timer, &due, 0, NULL, NULL, FALSE))
+         WaitForSingleObject(timer, INFINITE);
+      CloseHandle(timer);
+      return;
+   }
+
    DWORD dwMilliseconds = (DWORD) ((usecs + 999) / 1000);
    /* Avoid Sleep(O) as that would cause to sleep for an undetermined duration */
    if (dwMilliseconds) {
