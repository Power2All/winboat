 /*
+ * MSAA. Creating a device, the runtime checks the answers against each other and refuses the device (for every
+ * application) when they disagree: a typeless format and each format it casts to that has
+ * MULTISAMPLE_RENDERTARGET report the same quality levels for every sample count, the others none. So sample counts
+ * are offered per format family: when every member that renders (a render target or depth format) renders with
+ * that count on the host. Members that render get MULTISAMPLE_RENDERTARGET when 4x is offered. One quality level
+ * (the sample positions are the host's).
+ */
+#define F(x) DXGI_FORMAT_##x
+static const DXGI_FORMAT FormatFamilies[][7] = {
+   {F(R32G32B32A32_TYPELESS), F(R32G32B32A32_FLOAT), F(R32G32B32A32_UINT), F(R32G32B32A32_SINT)},
+   {F(R32G32B32_TYPELESS), F(R32G32B32_FLOAT), F(R32G32B32_UINT), F(R32G32B32_SINT)},
+   {F(R16G16B16A16_TYPELESS), F(R16G16B16A16_FLOAT), F(R16G16B16A16_UNORM), F(R16G16B16A16_UINT),
+    F(R16G16B16A16_SNORM), F(R16G16B16A16_SINT)},
+   {F(R32G32_TYPELESS), F(R32G32_FLOAT), F(R32G32_UINT), F(R32G32_SINT)},
+   {F(R32G8X24_TYPELESS), F(D32_FLOAT_S8X24_UINT), F(R32_FLOAT_X8X24_TYPELESS), F(X32_TYPELESS_G8X24_UINT)},
+   {F(R10G10B10A2_TYPELESS), F(R10G10B10A2_UNORM), F(R10G10B10A2_UINT)},
+   {F(R8G8B8A8_TYPELESS), F(R8G8B8A8_UNORM), F(R8G8B8A8_UNORM_SRGB), F(R8G8B8A8_UINT), F(R8G8B8A8_SNORM),
+    F(R8G8B8A8_SINT)},
+   {F(R16G16_TYPELESS), F(R16G16_FLOAT), F(R16G16_UNORM), F(R16G16_UINT), F(R16G16_SNORM), F(R16G16_SINT)},
+   {F(R32_TYPELESS), F(D32_FLOAT), F(R32_FLOAT), F(R32_UINT), F(R32_SINT)},
+   {F(R24G8_TYPELESS), F(D24_UNORM_S8_UINT), F(R24_UNORM_X8_TYPELESS), F(X24_TYPELESS_G8_UINT)},
+   {F(R8G8_TYPELESS), F(R8G8_UNORM), F(R8G8_UINT), F(R8G8_SNORM), F(R8G8_SINT)},
+   {F(R16_TYPELESS), F(R16_FLOAT), F(D16_UNORM), F(R16_UNORM), F(R16_UINT), F(R16_SNORM), F(R16_SINT)},
+   {F(R8_TYPELESS), F(R8_UNORM), F(R8_UINT), F(R8_SNORM), F(R8_SINT)},
+   {F(B8G8R8A8_TYPELESS), F(B8G8R8A8_UNORM), F(B8G8R8A8_UNORM_SRGB)},
+   {F(B8G8R8X8_TYPELESS), F(B8G8R8X8_UNORM), F(B8G8R8X8_UNORM_SRGB)},
+};
+#undef F
+
+/* The family of a format (the typeless parent first), or just the format */
+static unsigned
+FormatFamily(DXGI_FORMAT Format, DXGI_FORMAT members[7])
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(FormatFamilies); i++) {
+      for (unsigned j = 0; j < 7 && FormatFamilies[i][j]; j++) {
+         if (FormatFamilies[i][j] == Format) {
+            unsigned n = 0;
+            while (n < 7 && FormatFamilies[i][n]) {
+               members[n] = FormatFamilies[i][n];
+               n++;
+            }
+            return n;
+         }
+      }
+   }
+   members[0] = Format;
+   return 1;
+}
+
+static bool
+IsDepthFormat(DXGI_FORMAT Format)
+{
+   return Format == DXGI_FORMAT_D16_UNORM || Format == DXGI_FORMAT_D24_UNORM_S8_UINT ||
+          Format == DXGI_FORMAT_D32_FLOAT || Format == DXGI_FORMAT_D32_FLOAT_S8X24_UINT;
+}
+
+/* Whether a format renders (as a render target or depth buffer), with SampleCount samples (0: single-sampled) */
+static bool
+FormatRenders(struct pipe_screen *screen, DXGI_FORMAT Format, UINT SampleCount)
+{
+   bool depth = IsDepthFormat(Format);
+   enum pipe_format format = FormatTranslate(Format, depth);
+   if (format == PIPE_FORMAT_NONE || Format == DXGI_FORMAT_R10G10B10_XR_BIAS_A2_UNORM) {
+      return false;
+   }
+   return screen->is_format_supported(screen, format, PIPE_TEXTURE_2D, SampleCount, SampleCount,
+                                      depth ? PIPE_BIND_DEPTH_STENCIL : PIPE_BIND_RENDER_TARGET);
+}
+
+/* Whether a format's family offers a sample count (2 and up) */
+static bool
+FamilyMultisample(struct pipe_screen *screen, DXGI_FORMAT Format, UINT SampleCount)
+{
+   DXGI_FORMAT members[7];
+   unsigned count = FormatFamily(Format, members);
+   bool renders = false;
+
+   if (SampleCount < 2 || SampleCount > 32 || !util_is_power_of_two_nonzero(SampleCount)) {
+      return false;
+   }
+   for (unsigned i = 0; i < count; i++) {
+      if (FormatRenders(screen, members[i], 0)) {
+         if (!FormatRenders(screen, members[i], SampleCount)) {
+            return false;
+         }
+         renders = true;
+      }
+   }
+   return renders;
+}
+
+static bool
+IsFamilyParent(DXGI_FORMAT Format)
+{
+   DXGI_FORMAT members[7];
+   return FormatFamily(Format, members) > 1 && members[0] == Format;
+}
+
+/* MULTISAMPLE_RENDERTARGET */
+static bool
+MultisampleRenderTarget(struct pipe_screen *screen, DXGI_FORMAT Format)
+{
+   return !IsFamilyParent(Format) && FormatRenders(screen, Format, 0) && FamilyMultisample(screen, Format, 4);
+}
+
