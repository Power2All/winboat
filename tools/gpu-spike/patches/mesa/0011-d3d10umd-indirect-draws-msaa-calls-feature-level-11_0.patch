+      return;
+   }
+   /* as the family: a typeless format when it offers 4x, the others with MULTISAMPLE_RENDERTARGET */
+   bool offered = IsFamilyParent(Format) ? FamilyMultisample(screen, Format, 4) :
+                                           MultisampleRenderTarget(screen, Format);
+   *pNumQualityLevels = offered && FamilyMultisample(screen, Format, SampleCount) ? 1 : 0;
 }
 
 
diff --git a/src/gallium/frontends/d3d10umd/Draw.cpp b/src/gallium/frontends/d3d10umd/Draw.cpp
--- a/src/gallium/frontends/d3d10umd/Draw.cpp
+++ b/src/gallium/frontends/d3d10umd/Draw.cpp
@@ -342,6 +342,103 @@
 
 
 /*
+ * Indirect draws: the argument layouts of D3D and GL are the same (count, instances, first vertex or index, [base
+ * vertex,] first instance). The host ignores the index buffer's offset in indirect draws, so with an offset the
+ * indices from it on are copied to a temporary buffer first (on the GPU). Without host indirect draws, or for an
+ * indexed draw without an index buffer, the arguments are read back.
+ */
+static void
+DrawIndirect(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hBufferForArgs, UINT AlignedByteOffsetForArgs,
+             bool indexed)
+{
+   Device *pDevice = CastDevice(hDevice);
+   struct pipe_context *pipe = pDevice->pipe;
+   struct pipe_resource *args = CastPipeResource(hBufferForArgs);
+   const unsigned args_size = indexed ? 20 : 16;
+
+   if (!args || AlignedByteOffsetForArgs + args_size > args->width0) {
+      return;
+   }
+
+   if (!pipe->screen->get_param(pipe->screen, PIPE_CAP_DRAW_INDIRECT) || (indexed && !pDevice->index_buffer)) {
+      UINT a[5];
+      pipe_buffer_read(pipe, args, AlignedByteOffsetForArgs, args_size, a);
+      if (indexed) {
+         DrawIndexedInstanced(hDevice, a[0], a[1], a[2], (INT)a[3], a[4]);
+      } else {
+         DrawInstanced(hDevice, a[0], a[1], a[2], a[3]);
+      }
+      return;
+   }
+
+   struct pipe_draw_info info;
+   struct pipe_draw_indirect_info indirect;
+   struct pipe_draw_start_count_bias draw;
+   struct pipe_resource *ib = NULL;
+
+   assert(pDevice->primitive < MESA_PRIM_COUNT);
+
+   if (indexed) {
+      ib = pDevice->index_buffer;
+      if (pDevice->ib_offset) {
+         unsigned size = pDevice->ib_offset < ib->width0 ? ib->width0 - pDevice->ib_offset : 0;
+         ib = pipe_buffer_create(pipe->screen, PIPE_BIND_INDEX_BUFFER, PIPE_USAGE_STREAM, MAX2(size, 4));
+         if (!ib) {
+            return;
+         }
+         if (size) {
+            struct pipe_box box;
+            u_box_1d(pDevice->ib_offset, size, &box);
+            pipe->resource_copy_region(pipe, ib, 0, 0, 0, 0, pDevice->index_buffer, 0, &box);
+         }
+      }
+   }
+
+   ResolveState(pDevice);
+
+   util_draw_init_info(&info);
+   info.mode = pDevice->primitive;
+   memset(&draw, 0, sizeof draw);
+   if (indexed) {
+      info.index_size = pDevice->index_size;
+      info.index.resource = ib;
+      info.primitive_restart = true;
+      info.restart_index = pDevice->restart_index;
+   }
+   memset(&indirect, 0, sizeof indirect);
+   indirect.buffer = args;
+   indirect.offset = AlignedByteOffsetForArgs;
+   indirect.draw_count = 1;
+
+   pipe->draw_vbo(pipe, &info, 0, &indirect, &draw, 1);
+   PostDraw(pDevice);
+
+   if (ib && ib != pDevice->index_buffer) {
+      pipe_resource_reference(&ib, NULL);
+   }
+}
+
+
+void APIENTRY
+DrawInstancedIndirect(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hBufferForArgs, UINT AlignedByteOffsetForArgs)
+{
+   LOG_ENTRYPOINT();
+
+   DrawIndirect(hDevice, hBufferForArgs, AlignedByteOffsetForArgs, false);
+}
+
+
+void APIENTRY
+DrawIndexedInstancedIndirect(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hBufferForArgs,
+                             UINT AlignedByteOffsetForArgs)
+{
+   LOG_ENTRYPOINT();
+
+   DrawIndirect(hDevice, hBufferForArgs, AlignedByteOffsetForArgs, true);
+}
+
+
