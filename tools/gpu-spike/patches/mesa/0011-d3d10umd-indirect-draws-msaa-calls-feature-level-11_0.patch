+   BltSurface(src, SrcSubresource, SrcLeft, SrcTop, SrcRight, SrcBottom, &info.src.level, &info.src.box);
+   info.dst.resource = dst;
+   info.dst.format = dst->format;
+   info.src.resource = src;
+   info.src.format = src->format;
+   info.mask = util_format_get_mask(dst->format);
+   info.filter = info.dst.box.width == info.src.box.width && info.dst.box.height == info.src.box.height ?
+                 PIPE_TEX_FILTER_NEAREST : PIPE_TEX_FILTER_LINEAR;
+   pipe->blit(pipe, &info);
