 /*
+ * Whether the host renders what feature level 11_0 needs: compute and tessellation shaders, 4x MSAA and 8 UAVs
+ * (images and shader buffers) in compute and pixel shaders. The runtime asks before any device exists, so the
+ * virgl caps are read here, through the first VioGPU adapter with 3D. WINBOAT_D3D_FL11=0 reports 10_0 anyway,
+ * =1 reports 11_0 anyway.
+ */
+static bool
+HostSupportsFL11(void)
+{
+   static int supported = -1;
+   if (supported >= 0) {
+      return supported;
+   }
+
+   char env[4] = "";
+   if (GetEnvironmentVariableA("WINBOAT_D3D_FL11", env, sizeof env) && (env[0] == '0' || env[0] == '1')) {
+      supported = env[0] == '1';
+      return supported;
+   }
+
+   HMODULE gdi32 = GetModuleHandleA("gdi32.dll");
+   if (!gdi32) {
+      gdi32 = LoadLibraryA("gdi32.dll");
+   }
+   PFND3DKMT_ENUMADAPTERS2 enumAdapters =
+      gdi32 ? (PFND3DKMT_ENUMADAPTERS2)GetProcAddress(gdi32, "D3DKMTEnumAdapters2") : NULL;
+   PFND3DKMT_QUERYADAPTERINFO queryAdapterInfo =
+      gdi32 ? (PFND3DKMT_QUERYADAPTERINFO)GetProcAddress(gdi32, "D3DKMTQueryAdapterInfo") : NULL;
+   PFND3DKMT_ESCAPE escape = gdi32 ? (PFND3DKMT_ESCAPE)GetProcAddress(gdi32, "D3DKMTEscape") : NULL;
+   PFND3DKMT_CLOSEADAPTER closeAdapter =
+      gdi32 ? (PFND3DKMT_CLOSEADAPTER)GetProcAddress(gdi32, "D3DKMTCloseAdapter") : NULL;
+   if (!enumAdapters || !queryAdapterInfo || !escape || !closeAdapter) {
+      supported = 0;
+      return false;
+   }
+
+   D3DKMT_ENUMADAPTERS2 adapters = {};
+   if (!NT_SUCCESS(enumAdapters(&adapters)) || !adapters.NumAdapters) {
+      supported = 0;
+      return false;
+   }
+   adapters.pAdapters = (D3DKMT_ADAPTERINFO *)CALLOC(adapters.NumAdapters, sizeof(D3DKMT_ADAPTERINFO));
+   if (!adapters.pAdapters || !NT_SUCCESS(enumAdapters(&adapters))) {
+      FREE(adapters.pAdapters);
+      supported = 0;
+      return false;
+   }
+
+   bool found = false, fl11 = false;
+   for (ULONG i = 0; i < adapters.NumAdapters; i++) {
+      D3DKMT_HANDLE hAdapter = adapters.pAdapters[i].hAdapter;
+      VIOGPU_ADAPTERINFO info = {};
+      D3DKMT_QUERYADAPTERINFO query = {};
+      query.hAdapter = hAdapter;
+      query.Type = KMTQAITYPE_UMDRIVERPRIVATE;
+      query.pPrivateDriverData = &info;
+      query.PrivateDriverDataSize = sizeof info;
+      if (!found && NT_SUCCESS(queryAdapterInfo(&query)) && info.IamVioGPU == VIOGPU_IAM &&
+          info.Flags.Supports3d && (info.SupportedCapsetIDs & (1ull << 2))) {
+         union virgl_caps caps = {};
+         VIOGPU_ESCAPE args = {};
+         args.Type = VIOGPU_GET_CAPS;
+         args.DataLength = sizeof(VIOGPU_CAPSET_REQ);
+         args.Capset.CapsetId = 2;
+         args.Capset.Size = sizeof caps;
+         args.Capset.Capset = (UINT64)(uintptr_t)&caps;
+         D3DKMT_ESCAPE esc = {};
+         esc.hAdapter = hAdapter;
+         esc.Type = D3DKMT_ESCAPE_DRIVERPRIVATE;
+         esc.pPrivateDriverData = &args;
+         esc.PrivateDriverDataSize = sizeof args;
+         found = true;
+         if (NT_SUCCESS(escape(&esc))) {
+            fl11 = caps.v1.bset.has_tessellation_shaders &&
+                   (caps.v2.capability_bits & VIRGL_CAP_COMPUTE_SHADER) &&
+                   caps.v1.bset.texture_multisample && caps.v1.max_samples >= 4 &&
+                   caps.v2.max_shader_image_frag_compute >= 8 &&
+                   caps.v2.max_shader_buffer_frag_compute >= 8;
+         }
+      }
+      D3DKMT_CLOSEADAPTER close = {};
+      close.hAdapter = hAdapter;
+      closeAdapter(&close);
+   }
+   FREE(adapters.pAdapters);
+
+   supported = fl11;
+   return fl11;
+}
+
