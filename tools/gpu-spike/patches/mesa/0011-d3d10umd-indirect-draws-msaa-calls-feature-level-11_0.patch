       }
-#endif
    }
 
 }
@@ -557,8 +661,17 @@
 {
    //LOG_ENTRYPOINT();
 
-   /* XXX: Disable MSAA */
-   *pNumQualityLevels = 0;
+   struct pipe_screen *screen = CastPipeContext(hDevice)->screen;
+
+   if (SampleCount == 1) {
+      *pNumQualityLevels = FormatTranslate(Format, false) != PIPE_FORMAT_NONE ||
