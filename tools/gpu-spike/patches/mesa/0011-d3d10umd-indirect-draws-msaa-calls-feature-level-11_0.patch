+/* A subresource's level, layer and rectangle (whole when the rectangle is empty) */
+static void
+BltSurface(struct pipe_resource *res, UINT Subresource, UINT Left, UINT Top, UINT Right, UINT Bottom,
+           unsigned *level, struct pipe_box *box)
+{
+   unsigned levels = res->last_level + 1;
+   *level = Subresource % levels;
+   unsigned layer = Subresource / levels;
+   if (Right <= Left || Bottom <= Top) {
+      Left = Top = 0;
+      Right = u_minify(res->width0, *level);
+      Bottom = u_minify(res->height0, *level);
+   }
+   u_box_3d(Left, Top, layer, Right - Left, Bottom - Top, 1, box);
+}
+
+/* Blits for presents: MSAA resolves (multisampled swap chains), format conversions and stretches. Rotations are
+ * not done (no rotated modes are offered). */
+static HRESULT
+BltCommon(DXGI_DDI_HDEVICE hDevice, DXGI_DDI_HRESOURCE hDst, UINT DstSubresource, UINT DstLeft, UINT DstTop,
+          UINT DstRight, UINT DstBottom, DXGI_DDI_HRESOURCE hSrc, UINT SrcSubresource, UINT SrcLeft, UINT SrcTop,
+          UINT SrcRight, UINT SrcBottom)
+{
+   Device *device = CastDevice(hDevice);
+   struct pipe_context *pipe = device->pipe;
+   struct pipe_resource *dst = CastPipeResource(hDst);
+   struct pipe_resource *src = CastPipeResource(hSrc);
