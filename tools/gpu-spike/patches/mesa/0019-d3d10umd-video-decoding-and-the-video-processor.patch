+/*
+ * The video context, and the order of its work and the device's
+ */
+
+static struct pipe_context *
+VideoPipe(Device *pDevice)
+{
+   if (!pDevice->video_pipe) {
+      pDevice->video_pipe = pDevice->screen->context_create(pDevice->screen, NULL, 0);
+   }
+   return pDevice->video_pipe;
+}
+
+/*
+ * The two contexts' work in order: flushed and done before the other uses what it wrote. Flushing alone isn't enough:
+ * Windows schedules each context's submissions on its own, and the host could run the device's copy of a decoded
+ * picture before the decoding (now and then a frame came out as the slice's previous picture).
+ */
+static void
+Finish(struct pipe_context *pipe)
+{
+   struct pipe_fence_handle *fence = NULL;
+   pipe->flush(pipe, &fence, 0);
+   if (fence) {
+      pipe->screen->fence_finish(pipe->screen, NULL, fence, OS_TIMEOUT_INFINITE);
+      pipe->screen->fence_reference(pipe->screen, &fence, NULL);
+   }
+}
+
+/* What the device did before the video context reads or writes it */
+static void
+FlushDevice(Device *pDevice)
+{
+   Finish(pDevice->pipe);
+}
+
+/* What the video context did before the device reads it */
+static void
+FlushVideo(Device *pDevice)
+{
+   Finish(pDevice->video_pipe);
+}
