+static HRESULT APIENTRY
+CreateVideoProcessorInputView(D3D10DDI_HDEVICE hDevice, const D3D11_1DDIARG_CREATEVIDEOPROCESSORINPUTVIEW *pCreate,
+                              D3D11_1DDI_HVIDEOPROCESSORINPUTVIEW hView,
+                              D3D11_1DDI_HRTVIDEOPROCESSORINPUTVIEW hRTView)
+{
+   Device *pDevice = CastDevice(hDevice);
+   Resource *pResource = CastResource(pCreate->hDrvResource);
+   VideoProcessorInputView *view = static_cast<VideoProcessorInputView *>(hView.pDrvPrivate);
+   VideoLog("CreateVideoProcessorInputView: format %u slice %u\n", pResource->Format, pCreate->FirstArraySlice);
+   memset(view, 0, sizeof *view);
+   view->resource = pResource;
+   view->slice = pCreate->FirstArraySlice;
+   if (pResource->video) {
+      return view->slice < pResource->video->slices ? S_OK : E_INVALIDARG;
+   }
+   struct pipe_context *vpipe = VideoPipe(pDevice);
+   if (!vpipe || !ProcessorFormat(pResource->Format) || !pResource->resource) {
+      VideoLog("CreateVideoProcessorInputView: format %u isn't one of ours\n", pResource->Format);
+      return E_INVALIDARG;
+   }
+   struct pipe_sampler_view templat;
+   u_sampler_view_default_template(&templat, pResource->resource, pResource->resource->format);
+   templat.u.tex.first_level = templat.u.tex.last_level = pCreate->MipSlice;
+   templat.u.tex.first_layer = templat.u.tex.last_layer = pCreate->FirstArraySlice;
+   templat.target = PIPE_TEXTURE_2D;
+   view->rgb = vpipe->create_sampler_view(vpipe, pResource->resource, &templat);
+   return view->rgb ? S_OK : E_OUTOFMEMORY;
+}
