+/*
+ * NV12 and P010 textures
+ */
+
+struct VideoSurface {
+   enum pipe_format format;          /* PIPE_FORMAT_NV12 or P010 */
+   unsigned width, height;           /* the texture's (decoder output planes are macroblock-aligned: larger) */
+   unsigned slices;
+   unsigned bpp;                     /* bytes per luma sample */
+   struct pipe_video_buffer **buffers;
+};
+
+static struct pipe_resource *
+Plane(const VideoSurface *v, unsigned slice, unsigned plane)
+{
+   struct pipe_resource *resources[VL_NUM_COMPONENTS] = {};
+   v->buffers[slice]->get_resources(v->buffers[slice], resources);
+   return resources[plane];
+}
+
+static bool
+IsVideoFormat(DXGI_FORMAT Format)
+{
+   return Format == DXGI_FORMAT_NV12 || Format == DXGI_FORMAT_P010;
+}
+
+static enum pipe_resource_usage
+PipeUsage(D3D10_DDI_RESOURCE_USAGE usage)
+{
+   switch (usage) {
+   case D3D10_DDI_USAGE_DYNAMIC:
+      return PIPE_USAGE_DYNAMIC;
+   case D3D10_DDI_USAGE_STAGING:
+      return PIPE_USAGE_STAGING;
+   default:
+      return PIPE_USAGE_DEFAULT;
+   }
+}
+
+/* A slice for the video processor and copies: planes of the texture's size */
+static struct pipe_video_buffer *
+CreatePlaneBuffer(Device *pDevice, const struct pipe_video_buffer *tmpl, enum pipe_resource_usage usage)
+{
+   bool ten = tmpl->buffer_format == PIPE_FORMAT_P010;
+   const enum pipe_format formats[2] = {ten ? PIPE_FORMAT_R16_UNORM : PIPE_FORMAT_R8_UNORM,
+                                        ten ? PIPE_FORMAT_R16G16_UNORM : PIPE_FORMAT_R8G8_UNORM};
+   struct pipe_resource *resources[VL_NUM_COMPONENTS] = {};
+   for (unsigned p = 0; p < 2; p++) {
+      struct pipe_resource templat = {};
+      templat.target = PIPE_TEXTURE_2D;
+      templat.format = formats[p];
+      templat.width0 = p ? tmpl->width / 2 : tmpl->width;
+      templat.height0 = p ? tmpl->height / 2 : tmpl->height;
+      templat.depth0 = 1;
+      templat.array_size = 1;
+      templat.bind = PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_RENDER_TARGET;
+      templat.usage = usage;
+      resources[p] = pDevice->screen->resource_create(pDevice->screen, &templat);
+      if (!resources[p]) {
+         pipe_resource_reference(&resources[0], NULL);
+         return NULL;
+      }
+   }
+   struct pipe_video_buffer *buffer = vl_video_buffer_create_ex2(VideoPipe(pDevice), tmpl, resources);
+   if (!buffer) {
+      pipe_resource_reference(&resources[0], NULL);
+      pipe_resource_reference(&resources[1], NULL);
+   }
+   return buffer;
+}
+
+static void WritePlanes(struct pipe_context *pipe, const VideoSurface *v, unsigned slice, unsigned x, unsigned y,
+                        unsigned w, unsigned h, const uint8_t *data, unsigned stride);
+
+bool
+VideoCreateResource(D3D10DDI_HDEVICE hDevice, const D3D10DDIARG_CREATERESOURCE *pCreateResource, Resource *pResource)
+{
+   Device *pDevice = CastDevice(hDevice);
+
+   /* Decoder buffers (picture parameters, bitstream, ...): memory the program fills and SubmitBuffers reads */
+   if (pCreateResource->BindFlags & D3D11_DDI_BIND_DECODER) {
+      VideoLog("CreateResource: decoder %s %ux%u format %u usage %u slices %u\n",
+               pCreateResource->ResourceDimension == D3D10DDIRESOURCE_BUFFER ? "buffer" : "texture",
+               pCreateResource->pMipInfoList[0].TexelWidth, pCreateResource->pMipInfoList[0].TexelHeight,
+               pCreateResource->Format, pCreateResource->Usage, pCreateResource->ArraySize);
+   }
+   if (pCreateResource->ResourceDimension == D3D10DDIRESOURCE_BUFFER &&
+       (pCreateResource->BindFlags & D3D11_DDI_BIND_DECODER)) {
+      pResource->buffer = true;
+      pResource->MipLevels = 1;
+      pResource->NumSubResources = 1;
+      pResource->sysmem_size = pCreateResource->pMipInfoList[0].TexelWidth;
+      pResource->sysmem = calloc(1, pCreateResource->pMipInfoList[0].TexelWidth);
+      pResource->transfers = (struct pipe_transfer **)calloc(1, sizeof *pResource->transfers);
+      if (!pResource->sysmem || !pResource->transfers) {
+         SetError(hDevice, E_OUTOFMEMORY);
+      }
+      return true;
+   }
+
+   if (!IsVideoFormat(pCreateResource->Format)) {
+      return false;
+   }
+   if (pCreateResource->ResourceDimension != D3D10DDIRESOURCE_TEXTURE2D || pCreateResource->MipLevels != 1 ||
+       pCreateResource->SampleDesc.Count > 1 || !VideoPipe(pDevice)) {
+      SetError(hDevice, E_INVALIDARG);
+      return true;
+   }
+
+   VideoSurface *v = (VideoSurface *)calloc(1, sizeof *v);
+   unsigned slices = pCreateResource->ArraySize;
+   if (v) {
+      v->buffers = (struct pipe_video_buffer **)calloc(slices, sizeof *v->buffers);
+   }
+   pResource->transfers = (struct pipe_transfer **)calloc(slices, sizeof *pResource->transfers);
+   if (!v || !v->buffers || !pResource->transfers) {
+      free(v ? v->buffers : NULL);
+      free(v);
+      SetError(hDevice, E_OUTOFMEMORY);
+      return true;
+   }
+   VideoLog("CreateResource: %s %ux%u, %u slices, bind 0x%x usage %u, initial data %p\n",
+            pCreateResource->Format == DXGI_FORMAT_P010 ? "P010" : "NV12", pCreateResource->pMipInfoList[0].TexelWidth,
+            pCreateResource->pMipInfoList[0].TexelHeight, pCreateResource->ArraySize, pCreateResource->BindFlags,
+            pCreateResource->Usage, pCreateResource->pInitialDataUP);
+   v->format = pCreateResource->Format == DXGI_FORMAT_P010 ? PIPE_FORMAT_P010 : PIPE_FORMAT_NV12;
+   v->bpp = v->format == PIPE_FORMAT_P010 ? 2 : 1;
+   v->width = pCreateResource->pMipInfoList[0].TexelWidth;
+   v->height = pCreateResource->pMipInfoList[0].TexelHeight;
+   v->slices = slices;
+   pResource->video = v;
+   pResource->Format = pCreateResource->Format;
+   pResource->MipLevels = 1;
+   pResource->NumSubResources = slices;
+
+   struct pipe_video_buffer tmpl = {};
+   tmpl.buffer_format = v->format;
+   tmpl.width = v->width;
+   tmpl.height = v->height;
+   tmpl.interlaced = false;
+   struct pipe_context *vpipe = VideoPipe(pDevice);
+   bool decoder = (pCreateResource->BindFlags & D3D11_DDI_BIND_DECODER) && vpipe->create_video_buffer;
+   for (unsigned s = 0; s < slices; s++) {
+      /* decoder output: the video codec's buffers (the host's surfaces with them); the others the texture's size */
+      v->buffers[s] = decoder ? vpipe->create_video_buffer(vpipe, &tmpl)
+                              : CreatePlaneBuffer(pDevice, &tmpl, PipeUsage((D3D10_DDI_RESOURCE_USAGE)pCreateResource->Usage));
+      if (!v->buffers[s]) {
+         SetError(hDevice, E_OUTOFMEMORY);
+         return true;
+      }
+   }
+   for (unsigned s = 0; pCreateResource->pInitialDataUP && s < slices; s++) {
+      WritePlanes(CastPipeContext(hDevice), v, s, 0, 0, v->width, v->height,
+                  (const uint8_t *)pCreateResource->pInitialDataUP[s].pSysMem, pCreateResource->pInitialDataUP[s].SysMemPitch);
+   }
+   /* the luma plane of the first slice for the rest of the driver, which never asks more of an NV12 texture */
+   pipe_resource_reference(&pResource->resource, Plane(v, 0, 0));
+   return true;
+}
+
+void
+VideoDestroyResource(Resource *pResource)
+{
+   free(pResource->sysmem);
+   pResource->sysmem = NULL;
+   VideoSurface *v = pResource->video;
+   if (!v) {
+      return;
+   }
+   for (unsigned s = 0; s < v->slices; s++) {
+      if (v->buffers[s]) {
+         v->buffers[s]->destroy(v->buffers[s]);
+      }
+   }
+   free(v->buffers);
+   free(v);
+   pResource->video = NULL;
+}
+
+/* A plane's box of a slice: the chroma plane at half the size */
+static struct pipe_box
+PlaneBox(const VideoSurface *v, unsigned plane, unsigned x, unsigned y, unsigned w, unsigned h)
+{
+   struct pipe_box box;
+   unsigned d = plane ? 2 : 1;
+   u_box_2d(x / d, y / d, w / d, h / d, &box);
+   (void)v;
+   return box;
+}
+
+bool
+VideoResourceMap(D3D10DDI_HDEVICE hDevice, Resource *pResource, UINT SubResource, D3D10_DDI_MAP DDIMap,
+                 D3D10DDI_MAPPED_SUBRESOURCE *pMapped)
+{
+   if (pResource->sysmem) {
+      pMapped->pData = pResource->sysmem;
+      pMapped->RowPitch = pMapped->DepthPitch = pResource->sysmem_size;
+      return true;
+   }
+   VideoSurface *v = pResource->video;
+   if (!v) {
+      return false;
+   }
+
+   /* the D3D layout in memory: the luma rows, then the chroma rows at the same pitch */
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   if (!pResource->shadows) {
+      pResource->shadows = (struct ResourceShadow *)calloc(pResource->NumSubResources, sizeof *pResource->shadows);
+   }
+   struct ResourceShadow *shadow = pResource->shadows ? &pResource->shadows[SubResource] : NULL;
+   unsigned row = v->width * v->bpp;
+   unsigned stride = align(row, 64);
+   if (shadow && !shadow->data) {
+      shadow->stride = stride;
+      shadow->layer_stride = stride * (v->height + v->height / 2);
+      shadow->data = malloc(shadow->layer_stride);
+   }
+   if (!shadow || !shadow->data) {
+      SetError(hDevice, E_OUTOFMEMORY);
+      return true;
+   }
+   shadow->usage = DDIMap == D3D10_DDI_MAP_READ ? PIPE_MAP_READ
+                 : DDIMap == D3D10_DDI_MAP_READWRITE ? PIPE_MAP_READ | PIPE_MAP_WRITE : PIPE_MAP_WRITE;
+   if (shadow->usage & PIPE_MAP_READ) {
+      for (unsigned p = 0; p < 2; p++) {
+         struct pipe_box box = PlaneBox(v, p, 0, 0, v->width, v->height);
+         struct pipe_transfer *transfer;
+         const uint8_t *map = (const uint8_t *)pipe->texture_map(pipe, Plane(v, SubResource, p), 0, PIPE_MAP_READ,
+                                                                 &box, &transfer);
+         if (!map) {
+            continue;
+         }
+         uint8_t *dst = (uint8_t *)shadow->data + (p ? stride * v->height : 0);
+         for (int y = 0; y < box.height; y++) {
+            memcpy(dst + y * stride, map + y * transfer->stride, row);
+         }
+         pipe_texture_unmap(pipe, transfer);
+      }
+   }
+   pMapped->pData = shadow->data;
+   pMapped->RowPitch = shadow->stride;
+   pMapped->DepthPitch = shadow->layer_stride;
+   return true;
+}
+
+static void
+WritePlanes(struct pipe_context *pipe, const VideoSurface *v, unsigned slice, unsigned x, unsigned y, unsigned w,
+            unsigned h, const uint8_t *data, unsigned stride)
+{
+   for (unsigned p = 0; p < 2; p++) {
+      struct pipe_box box = PlaneBox(v, p, x, y, w, h);
+      struct pipe_transfer *transfer;
+      uint8_t *map = (uint8_t *)pipe->texture_map(pipe, Plane(v, slice, p), 0, PIPE_MAP_WRITE | PIPE_MAP_DISCARD_RANGE,
+                                                  &box, &transfer);
+      if (!map) {
+         continue;
+      }
+      const uint8_t *src = data + (p ? stride * h : 0);
+      for (int row = 0; row < box.height; row++) {
+         memcpy(map + row * transfer->stride, src + row * stride, w * v->bpp);
+      }
+      pipe_texture_unmap(pipe, transfer);
+   }
+}
+
+bool
+VideoResourceUnmap(D3D10DDI_HDEVICE hDevice, Resource *pResource, UINT SubResource)
+{
+   if (pResource->sysmem) {
+      return true;
+   }
+   VideoSurface *v = pResource->video;
+   if (!v) {
+      return false;
+   }
+   struct ResourceShadow *shadow = pResource->shadows ? &pResource->shadows[SubResource] : NULL;
+   if (shadow && shadow->data) {
+      if (shadow->usage & PIPE_MAP_WRITE) {
+         WritePlanes(CastPipeContext(hDevice), v, SubResource, 0, 0, v->width, v->height, (const uint8_t *)shadow->data,
+                     shadow->stride);
+      }
+      free(shadow->data);
+      memset(shadow, 0, sizeof *shadow);
+   }
+   return true;
+}
+
+static void
+CopyPlanes(struct pipe_context *pipe, const VideoSurface *dst, unsigned dst_slice, unsigned dst_x, unsigned dst_y,
+           const VideoSurface *src, unsigned src_slice, unsigned x, unsigned y, unsigned w, unsigned h)
+{
+   for (unsigned p = 0; p < 2; p++) {
+      struct pipe_box box = PlaneBox(src, p, x, y, w, h);
+      unsigned d = p ? 2 : 1;
+      pipe->resource_copy_region(pipe, Plane(dst, dst_slice, p), 0, dst_x / d, dst_y / d, 0, Plane(src, src_slice, p),
+                                 0, &box);
+   }
+}
+
+bool
+VideoResourceCopy(D3D10DDI_HDEVICE hDevice, Resource *pDst, Resource *pSrc)
+{
+   if (!pDst->video && !pSrc->video) {
+      return false;
+   }
+   /* (NV12 to and from other formats: not offered) */
+   if (pDst->video && pSrc->video) {
+      for (unsigned s = 0; s < MIN2(pDst->video->slices, pSrc->video->slices); s++) {
+         CopyPlanes(CastPipeContext(hDevice), pDst->video, s, 0, 0, pSrc->video, s, 0, 0,
+                    MIN2(pDst->video->width, pSrc->video->width), MIN2(pDst->video->height, pSrc->video->height));
+      }
+   }
+   return true;
+}
+
+bool
+VideoResourceCopyRegion(D3D10DDI_HDEVICE hDevice, Resource *pDst, UINT DstSubResource, UINT DstX, UINT DstY,
+                        Resource *pSrc, UINT SrcSubResource, const D3D10_DDI_BOX *pSrcBox)
+{
+   if (!pDst->video && !pSrc->video) {
+      return false;
+   }
+   if (pDst->video && pSrc->video) {
+      const VideoSurface *src = pSrc->video;
+      unsigned x = pSrcBox ? pSrcBox->left : 0, y = pSrcBox ? pSrcBox->top : 0;
+      unsigned w = pSrcBox ? pSrcBox->right - pSrcBox->left : src->width;
+      unsigned h = pSrcBox ? pSrcBox->bottom - pSrcBox->top : src->height;
+      CopyPlanes(CastPipeContext(hDevice), pDst->video, DstSubResource, DstX, DstY, src, SrcSubResource, x, y, w, h);
+   }
+   return true;
+}
+
+bool
+VideoUpdateSubresourceUP(D3D10DDI_HDEVICE hDevice, Resource *pDst, UINT DstSubResource, const D3D10_DDI_BOX *pDstBox,
+                         const void *pSysMem, UINT RowPitch)
+{
+   VideoSurface *v = pDst->video;
+   if (!v) {
+      return false;
+   }
+   unsigned x = pDstBox ? pDstBox->left : 0, y = pDstBox ? pDstBox->top : 0;
+   unsigned w = pDstBox ? pDstBox->right - pDstBox->left : v->width;
+   unsigned h = pDstBox ? pDstBox->bottom - pDstBox->top : v->height;
+   VideoLog("UpdateSubresourceUP: slice %u %ux%u at %u,%u pitch %u\n", DstSubResource, w, h, x, y, RowPitch);
+   WritePlanes(CastPipeContext(hDevice), v, DstSubResource, x, y, w, h, (const uint8_t *)pSysMem, RowPitch);
+   return true;
+}
+
+bool
+VideoCreateShaderResourceView(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATESHADERRESOURCEVIEW *pView,
+                              ShaderResourceView *pSRView)
+{
+   Resource *pResource = CastResource(pView->hDrvResource);
+   VideoSurface *v = pResource->video;
+   if (!v) {
+      return false;
+   }
+   /* the format picks the plane: R8/R16 luma, R8G8/R16G16 chroma */
+   unsigned plane = 0;
+   switch (pView->Format) {
+   case DXGI_FORMAT_R8G8_UNORM:
+   case DXGI_FORMAT_R8G8_UINT:
+   case DXGI_FORMAT_R16G16_UNORM:
+   case DXGI_FORMAT_R16G16_UINT:
+      plane = 1;
+      break;
+   default:
+      break;
+   }
+   unsigned slice = pView->ResourceDimension == D3D10DDIRESOURCE_TEXTURE2D ? pView->Tex2D.FirstArraySlice : 0;
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   struct pipe_resource *resource = Plane(v, MIN2(slice, v->slices - 1), plane);
+   struct pipe_sampler_view templat;
+   /* the plane's own format (its UINT variants as they are) */
+   enum pipe_format format = FormatTranslate(pView->Format, false);
+   if (util_format_is_pure_uint(format) != util_format_is_pure_uint(resource->format)) {
+      VideoLog("CreateShaderResourceView: format %s on a %s plane\n", util_format_name(format), util_format_name(resource->format));
+   } else {
+      format = resource->format;
+   }
+   u_sampler_view_default_template(&templat, resource, format);
+   memset(pSRView, 0, sizeof *pSRView);
+   pSRView->resource = pResource;
+   pSRView->handle = pipe->create_sampler_view(pipe, resource, &templat);
+   VideoLog("CreateShaderResourceView: format %u dimension %u plane %u slice %u: %p\n", pView->Format,
+            pView->ResourceDimension, plane, slice, pSRView->handle);
+   return true;
+}
+
+
+/*
+ * Format caps
+ */
+
+static bool
+ProcessorFormat(DXGI_FORMAT Format)
+{
+   switch (Format) {
+   case DXGI_FORMAT_B8G8R8A8_UNORM:
+   case DXGI_FORMAT_B8G8R8X8_UNORM:
+   case DXGI_FORMAT_R8G8B8A8_UNORM:
+   case DXGI_FORMAT_R10G10B10A2_UNORM:
+   case DXGI_FORMAT_R16G16B16A16_FLOAT:
+      return true;
+   default:
+      return false;
+   }
+}
+
+bool
+VideoFormatSupport(D3D10DDI_HDEVICE hDevice, DXGI_FORMAT Format, UINT *pFormatCaps)
+{
+   if (!IsVideoFormat(Format)) {
+      return false;
+   }
+   /* shader views of the planes, the video processor's input, and decoder output for the profiles in this format */
+   *pFormatCaps = D3D10_DDI_FORMAT_SUPPORT_SHADER_SAMPLE | D3D11_1DDI_FORMAT_SUPPORT_VIDEO_PROCESSOR_INPUT;
+   struct pipe_screen *screen = CastPipeContext(hDevice)->screen;
+   for (auto &p : PROFILES) {
+      if (p.Outputs(Format) && ProfileSupported(screen, p)) {
+         *pFormatCaps |= D3D11_1DDI_FORMAT_SUPPORT_DECODER_OUTPUT;
+      }
+   }
+   return true;
+}
+
+void
+VideoAddFormatSupport(D3D10DDI_HDEVICE hDevice, DXGI_FORMAT Format, UINT *pFormatCaps)
+{
+   if (!ProcessorFormat(Format)) {
+      return;
+   }
+   if (*pFormatCaps & D3D10_DDI_FORMAT_SUPPORT_SHADER_SAMPLE) {
+      *pFormatCaps |= D3D11_1DDI_FORMAT_SUPPORT_VIDEO_PROCESSOR_INPUT;
+   }
+   if (*pFormatCaps & D3D10_DDI_FORMAT_SUPPORT_RENDERTARGET) {
+      *pFormatCaps |= D3D11_1DDI_FORMAT_SUPPORT_VIDEO_PROCESSOR_OUTPUT;
+   }
+}
+
+
+/*
+ * The decoder
+ */
+
+struct VideoDecoder {
+   const VideoProfileInfo *profile;
+   struct pipe_video_codec *codec;
+   unsigned width, height;
+
+   /* the frame between BeginFrame and EndFrame */
+   Resource *target;
+   unsigned slice;
+   std::vector<uint8_t> pic_params, qmatrix;
+   std::vector<uint8_t> stream;     /* the slices' data, each H.264/HEVC slice after a start code */
+   unsigned slices;
+   std::vector<DXVA_Tile_AV1> tiles; /* AV1: where each tile is in stream */
+   uint8_t intra_matrix[64], non_intra_matrix[64];   /* MPEG-2's, for its picture description */
+
+   union {
+      struct pipe_h264_picture_desc h264;
+      struct pipe_h265_picture_desc h265;
+      struct pipe_vp9_picture_desc vp9;
+      struct pipe_av1_picture_desc av1;
+      struct pipe_mpeg12_picture_desc mpeg2;
+   } desc;
+   struct pipe_h264_pps h264_pps;
+   struct pipe_h264_sps h264_sps;
+   struct pipe_h265_pps h265_pps;
+   struct pipe_h265_sps h265_sps;
+};
+
+struct VideoDecoderOutputView {
+   Resource *resource;
+   unsigned slice;
+};
+
+static VideoDecoder *
+CastDecoder(D3D11_1DDI_HDECODE hDecoder)
+{
+   return static_cast<VideoDecoder *>(hDecoder.pDrvPrivate);
+}
+
+static void APIENTRY
+GetVideoDecoderProfileCount(D3D10DDI_HDEVICE hDevice, UINT *pCount)
+{
+   struct pipe_screen *screen = CastPipeContext(hDevice)->screen;
+   *pCount = 0;
+   for (auto &p : PROFILES) {
+      *pCount += ProfileSupported(screen, p);
+   }
+}
+
+static void APIENTRY
+GetVideoDecoderProfile(D3D10DDI_HDEVICE hDevice, UINT Index, GUID *pGuid)
+{
+   struct pipe_screen *screen = CastPipeContext(hDevice)->screen;
+   for (auto &p : PROFILES) {
+      if (ProfileSupported(screen, p) && Index-- == 0) {
+         *pGuid = p.guid;
+         return;
+      }
+   }
+}
+
+static void APIENTRY
+CheckVideoDecoderFormat(D3D10DDI_HDEVICE hDevice, const GUID *pGuid, DXGI_FORMAT Format, BOOL *pSupported)
+{
+   const VideoProfileInfo *p = FindProfile(hDevice, pGuid);
+   *pSupported = p && p->Outputs(Format);
+}
+
+static bool
+DecoderSizeSupported(D3D10DDI_HDEVICE hDevice, const D3D11_1DDI_VIDEO_DECODER_DESC *pDesc,
+                     const VideoProfileInfo **pProfile)
+{
+   const VideoProfileInfo *p = FindProfile(hDevice, &pDesc->Guid);
+   if (!p || !p->Outputs(pDesc->OutputFormat)) {
+      return false;
+   }
+   struct pipe_screen *screen = CastPipeContext(hDevice)->screen;
+   unsigned max_width = screen->get_video_param(screen, p->profile, PIPE_VIDEO_ENTRYPOINT_BITSTREAM,
+                                                PIPE_VIDEO_CAP_MAX_WIDTH);
+   unsigned max_height = screen->get_video_param(screen, p->profile, PIPE_VIDEO_ENTRYPOINT_BITSTREAM,
+                                                 PIPE_VIDEO_CAP_MAX_HEIGHT);
+   if (pProfile) {
+      *pProfile = p;
+   }
+   return (!max_width || pDesc->SampleWidth <= max_width) && (!max_height || pDesc->SampleHeight <= max_height);
+}
+
+static void APIENTRY
+GetVideoDecoderConfigCount(D3D10DDI_HDEVICE hDevice, const D3D11_1DDI_VIDEO_DECODER_DESC *pDesc, UINT *pCount)
+{
+   *pCount = DecoderSizeSupported(hDevice, pDesc, NULL) ? 1 : 0;
+}
+
+static void APIENTRY
+GetVideoDecoderConfig(D3D10DDI_HDEVICE hDevice, const D3D11_1DDI_VIDEO_DECODER_DESC *pDesc, UINT Index,
+                      D3D11_1DDI_VIDEO_DECODER_CONFIG *pConfig)
+{
+   const VideoProfileInfo *p = FindProfile(hDevice, &pDesc->Guid);
+   memset(pConfig, 0, sizeof *pConfig);
+   pConfig->guidConfigBitstreamEncryption = NO_ENCRYPT;
+   pConfig->guidConfigMBcontrolEncryption = NO_ENCRYPT;
+   pConfig->guidConfigResidDiffEncryption = NO_ENCRYPT;
+   /* the short slice format: for H.264 that's 2 (1 is the long one, with slice headers parsed); HEVC and VP9 only
+    * have this one */
+   pConfig->ConfigBitstreamRaw = p && p->codec == CODEC_H264 ? 2 : 1;
+}
+
+static const D3D11_1DDI_VIDEO_DECODER_BUFFER_TYPE BUFFER_TYPES[] = {
+   D3D11_1DDI_VIDEO_DECODER_BUFFER_PICTURE_PARAMETERS,
+   D3D11_1DDI_VIDEO_DECODER_BUFFER_INVERSE_QUANTIZATION_MATRIX,
+   D3D11_1DDI_VIDEO_DECODER_BUFFER_SLICE_CONTROL,
+   D3D11_1DDI_VIDEO_DECODER_BUFFER_BITSTREAM,
+};
+
+static void APIENTRY
+GetVideoDecoderBufferTypeCount(D3D10DDI_HDEVICE hDevice, const D3D11_1DDI_VIDEO_DECODER_DESC *pDesc, UINT *pCount)
+{
+   *pCount = ARRAY_SIZE(BUFFER_TYPES);
+}
+
+static void APIENTRY
+GetVideoDecoderBufferInfo(D3D10DDI_HDEVICE hDevice, const D3D11_1DDI_VIDEO_DECODER_DESC *pDesc, UINT Index,
+                          D3D11_1DDI_VIDEO_DECODER_BUFFER_INFO *pInfo)
+{
+   unsigned pixels = pDesc->SampleWidth * pDesc->SampleHeight;
+   pInfo->Type = BUFFER_TYPES[MIN2(Index, ARRAY_SIZE(BUFFER_TYPES) - 1)];
+   switch (pInfo->Type) {
+   case D3D11_1DDI_VIDEO_DECODER_BUFFER_PICTURE_PARAMETERS:
+      pInfo->Size = MAX2(sizeof(DXVA_PicParams_H264), sizeof(DXVA_PicParams_AV1));
+      break;
+   case D3D11_1DDI_VIDEO_DECODER_BUFFER_INVERSE_QUANTIZATION_MATRIX:
+      pInfo->Size = sizeof(DXVA_Qmatrix_HEVC);
+      break;
+   case D3D11_1DDI_VIDEO_DECODER_BUFFER_SLICE_CONTROL:
+      pInfo->Size = 4096 * sizeof(DXVA_Tile_AV1);
+      break;
+   default:
+      /* a compressed picture: at most about its raw size */
+      pInfo->Size = MAX2(pixels * 3 / 2, 1u << 20);
+      break;
+   }
+   pInfo->Usage = D3D10_DDI_USAGE_DYNAMIC;
+}
+
+static SIZE_T APIENTRY
+CalcPrivateVideoDecoderSize(D3D10DDI_HDEVICE hDevice, const D3D11_1DDIARG_CREATEVIDEODECODER *pCreate)
+{
+   return sizeof(VideoDecoder);
+}
+
+static HRESULT APIENTRY
+CreateVideoDecoder(D3D10DDI_HDEVICE hDevice, const D3D11_1DDIARG_CREATEVIDEODECODER *pCreate,
+                   D3D11_1DDI_HDECODE hDecoder, D3D11_1DDI_HRTDECODE hRTDecoder)
+{
+   Device *pDevice = CastDevice(hDevice);
+   const VideoProfileInfo *p = NULL;
+   if (!DecoderSizeSupported(hDevice, &pCreate->Desc, &p)) {
+      return E_INVALIDARG;
+   }
+   struct pipe_context *vpipe = VideoPipe(pDevice);
+   if (!vpipe || !vpipe->create_video_codec) {
+      return E_FAIL;
+   }
+
+   struct pipe_video_codec templat = {};
+   templat.profile = p->profile;
+   templat.entrypoint = PIPE_VIDEO_ENTRYPOINT_BITSTREAM;
+   templat.chroma_format = PIPE_VIDEO_CHROMA_FORMAT_420;
+   templat.width = pCreate->Desc.SampleWidth;
+   templat.height = pCreate->Desc.SampleHeight;
+   templat.max_references = 16;
+   templat.expect_chunked_decode = true;
+   struct pipe_video_codec *codec = vpipe->create_video_codec(vpipe, &templat);
+   if (!codec) {
+      VideoLog("CreateVideoDecoder: no codec for profile %d %ux%u\n", p->profile, templat.width, templat.height);
+      return E_FAIL;
+   }
+
+   VideoDecoder *dec = new (hDecoder.pDrvPrivate) VideoDecoder();
+   dec->profile = p;
+   dec->codec = codec;
+   dec->width = pCreate->Desc.SampleWidth;
+   dec->height = pCreate->Desc.SampleHeight;
+   return S_OK;
+}
+
+static void APIENTRY
+DestroyVideoDecoder(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HDECODE hDecoder)
+{
+   VideoDecoder *dec = CastDecoder(hDecoder);
+   dec->codec->destroy(dec->codec);
+   dec->~VideoDecoder();
+}
