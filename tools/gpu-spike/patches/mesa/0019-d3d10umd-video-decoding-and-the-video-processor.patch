+
+void
+VideoDestroyDevice(D3D10DDI_HDEVICE hDevice)
+{
+   Device *pDevice = CastDevice(hDevice);
+   if (pDevice->compositor) {
+      vl_compositor_cleanup_state(&pDevice->compositor->state);
+      vl_compositor_cleanup(&pDevice->compositor->compositor);
+      delete pDevice->compositor;
+      pDevice->compositor = NULL;
+   }
+   if (pDevice->video_pipe) {
+      pDevice->video_pipe->destroy(pDevice->video_pipe);
+      pDevice->video_pipe = NULL;
+   }
+}
