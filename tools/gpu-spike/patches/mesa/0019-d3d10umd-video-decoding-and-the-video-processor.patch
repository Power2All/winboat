+static SIZE_T APIENTRY
+CalcPrivateVideoDecoderOutputViewSize(D3D10DDI_HDEVICE hDevice,
+                                      const D3D11_1DDIARG_CREATEVIDEODECODEROUTPUTVIEW *pCreate)
+{
+   return sizeof(VideoDecoderOutputView);
+}
+
+static HRESULT APIENTRY
+CreateVideoDecoderOutputView(D3D10DDI_HDEVICE hDevice, const D3D11_1DDIARG_CREATEVIDEODECODEROUTPUTVIEW *pCreate,
+                             D3D11_1DDI_HVIDEODECODEROUTPUTVIEW hView, D3D11_1DDI_HRTVIDEODECODEROUTPUTVIEW hRTView)
+{
+   Resource *pResource = CastResource(pCreate->hDrvResource);
+   if (!pResource->video || pCreate->FirstArraySlice >= pResource->video->slices) {
+      return E_INVALIDARG;
+   }
+   VideoDecoderOutputView *view = static_cast<VideoDecoderOutputView *>(hView.pDrvPrivate);
+   view->resource = pResource;
+   view->slice = pCreate->FirstArraySlice;
+   return S_OK;
+}
