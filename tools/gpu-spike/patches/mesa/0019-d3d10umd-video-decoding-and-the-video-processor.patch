+static void APIENTRY
+CheckVideoProcessorFormat(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSORENUM hEnum, DXGI_FORMAT Format,
+                          UINT *pSupport)
+{
