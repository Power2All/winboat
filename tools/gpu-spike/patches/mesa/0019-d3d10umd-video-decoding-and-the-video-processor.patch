+/*
+ * Video.h --
+ *    Video decoding (DXVA through gallium's video codecs: VA-API on the host) and the video processor (color
+ *    conversion and scaling), with the NV12/P010 textures and decoder buffers they work on. See Video.cpp.
+ */
+
+#pragma once
+
+#include "DriverIncludes.h"
+
+struct Resource;
+struct ShaderResourceView;
+
+/* NV12/P010 textures and decoder buffers: true when it's one of them (created, or the error set) */
+bool VideoCreateResource(D3D10DDI_HDEVICE hDevice, const D3D10DDIARG_CREATERESOURCE *pCreateResource,
+                         Resource *pResource);
+void VideoDestroyResource(Resource *pResource);
+
+/* The rest: true when the resource is one of them and it was handled */
+bool VideoResourceMap(D3D10DDI_HDEVICE hDevice, Resource *pResource, UINT SubResource, D3D10_DDI_MAP DDIMap,
+                      D3D10DDI_MAPPED_SUBRESOURCE *pMapped);
+bool VideoResourceUnmap(D3D10DDI_HDEVICE hDevice, Resource *pResource, UINT SubResource);
+bool VideoResourceCopy(D3D10DDI_HDEVICE hDevice, Resource *pDst, Resource *pSrc);
+bool VideoResourceCopyRegion(D3D10DDI_HDEVICE hDevice, Resource *pDst, UINT DstSubResource, UINT DstX, UINT DstY,
+                             Resource *pSrc, UINT SrcSubResource, const D3D10_DDI_BOX *pSrcBox);
+bool VideoUpdateSubresourceUP(D3D10DDI_HDEVICE hDevice, Resource *pDst, UINT DstSubResource,
+                              const D3D10_DDI_BOX *pDstBox, const void *pSysMem, UINT RowPitch);
+bool VideoCreateShaderResourceView(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATESHADERRESOURCEVIEW *pView,
+                                   ShaderResourceView *pSRView);
+
+/* Format caps: NV12/P010 (true: all of them set), and the video processor's for the others */
+bool VideoFormatSupport(D3D10DDI_HDEVICE hDevice, DXGI_FORMAT Format, UINT *pFormatCaps);
+void VideoAddFormatSupport(D3D10DDI_HDEVICE hDevice, DXGI_FORMAT Format, UINT *pFormatCaps);
+
+/* RetrieveSubObject's video function table (D3D11_1DDI_VIDEO_INPUT) */
+HRESULT VideoRetrieveFunctions(D3D10DDI_HDEVICE hDevice, void *pParams, SIZE_T ParamSize);
+
+void VideoDestroyDevice(D3D10DDI_HDEVICE hDevice);
