+static bool
+VP9Picture(VideoDecoder *dec)
+{
+   if (dec->pic_params.size() < sizeof(DXVA_PicParams_VP9)) {
+      return false;
+   }
+   const DXVA_PicParams_VP9 *pp = (const DXVA_PicParams_VP9 *)dec->pic_params.data();
+   struct pipe_vp9_picture_desc *d = &dec->desc.vp9;
+   memset(d, 0, sizeof *d);
+
+   for (unsigned i = 0; i < 8; i++) {
+      DXVA_PicEntry e = pp->ref_frame_map[i];
+      d->ref[i] = e.bPicEntry == DXVA_INVALID_ENTRY || e.Index7Bits == 0x7f ? NULL : Surface(dec, e.Index7Bits);
+   }
+   /* DXVA's active references are surfaces, VA-API's (gallium's) slots of ref_frame_map: the slot of each */
+   unsigned slots[3] = {};
+   for (unsigned r = 0; r < 3; r++) {
+      for (unsigned i = 0; i < 8; i++) {
+         if (pp->ref_frame_map[i].bPicEntry != DXVA_INVALID_ENTRY &&
+             pp->ref_frame_map[i].Index7Bits == pp->frame_refs[r].Index7Bits) {
+            slots[r] = i;
+            break;
+         }
+      }
+   }
+
+   auto &pic = d->picture_parameter;
+   pic.frame_width = pp->width;
+   pic.frame_height = pp->height;
+   pic.pic_fields.subsampling_x = pp->subsampling_x;
+   pic.pic_fields.subsampling_y = pp->subsampling_y;
+   pic.pic_fields.frame_type = pp->frame_type;
+   pic.pic_fields.show_frame = pp->show_frame;
+   pic.pic_fields.error_resilient_mode = pp->error_resilient_mode;
+   pic.pic_fields.intra_only = pp->intra_only;
+   pic.pic_fields.allow_high_precision_mv = pp->allow_high_precision_mv;
+   /* DXVA's interpolation filters start with smooth, regular; VA-API's (the VP9 spec's) with regular, smooth */
+   pic.pic_fields.mcomp_filter_type = pp->interp_filter ^ (pp->interp_filter <= 1);
+   pic.pic_fields.frame_parallel_decoding_mode = pp->frame_parallel_decoding_mode;
+   pic.pic_fields.reset_frame_context = pp->reset_frame_context;
+   pic.pic_fields.refresh_frame_context = pp->refresh_frame_context;
+   pic.pic_fields.frame_context_idx = pp->frame_context_idx;
+   pic.pic_fields.segmentation_enabled = pp->stVP9Segments.enabled;
+   pic.pic_fields.segmentation_temporal_update = pp->stVP9Segments.temporal_update;
+   pic.pic_fields.segmentation_update_map = pp->stVP9Segments.update_map;
+   pic.pic_fields.last_ref_frame = slots[0];
+   pic.pic_fields.last_ref_frame_sign_bias = pp->ref_frame_sign_bias[1];
+   pic.pic_fields.golden_ref_frame = slots[1];
+   pic.pic_fields.golden_ref_frame_sign_bias = pp->ref_frame_sign_bias[2];
+   pic.pic_fields.alt_ref_frame = slots[2];
+   pic.pic_fields.alt_ref_frame_sign_bias = pp->ref_frame_sign_bias[3];
+   pic.pic_fields.lossless_flag = pp->base_qindex == 0 && pp->y_dc_delta_q == 0 && pp->uv_dc_delta_q == 0 &&
+                                  pp->uv_ac_delta_q == 0;
+   pic.filter_level = pp->filter_level;
+   pic.sharpness_level = pp->sharpness_level;
+   pic.log2_tile_rows = pp->log2_tile_rows;
+   pic.log2_tile_columns = pp->log2_tile_cols;
+   pic.frame_header_length_in_bytes = pp->uncompressed_header_size_byte_aligned;
+   pic.first_partition_size = pp->first_partition_size;
+   memcpy(pic.mb_segment_tree_probs, pp->stVP9Segments.tree_probs, sizeof pic.mb_segment_tree_probs);
+   memcpy(pic.segment_pred_probs, pp->stVP9Segments.pred_probs, sizeof pic.segment_pred_probs);
+   pic.profile = pp->profile;
+   pic.bit_depth = pp->BitDepthMinus8Luma + 8;
+   pic.mode_ref_delta_enabled = pp->mode_ref_delta_enabled;
+   pic.mode_ref_delta_update = pp->mode_ref_delta_update;
+   pic.base_qindex = pp->base_qindex;
+   pic.y_dc_delta_q = pp->y_dc_delta_q;
+   pic.uv_ac_delta_q = pp->uv_ac_delta_q;
+   pic.uv_dc_delta_q = pp->uv_dc_delta_q;
+   pic.abs_delta = pp->stVP9Segments.abs_delta;
+   for (unsigned i = 0; i < 4; i++) {
+      pic.ref_deltas[i] = pp->ref_deltas[i];
+   }
+   for (unsigned i = 0; i < 2; i++) {
+      pic.mode_deltas[i] = pp->mode_deltas[i];
+   }
+
+   auto &slice = d->slice_parameter;
+   slice.slice_count = 1;
+   slice.slice_data_size[0] = dec->stream.size();
+   slice.slice_data_offset[0] = 0;
+   slice.slice_data_flag[0] = PIPE_SLICE_BUFFER_PLACEMENT_TYPE_WHOLE;
+   for (unsigned i = 0; i < 8; i++) {
+      uint8_t mask = pp->stVP9Segments.feature_mask[i];
+      auto &seg = slice.seg_param[i];
+      seg.alt_quant_enabled = mask & 1;
+      seg.alt_quant = pp->stVP9Segments.feature_data[i][0];
+      seg.alt_lf_enabled = (mask >> 1) & 1;
+      seg.alt_lf = pp->stVP9Segments.feature_data[i][1];
+      seg.segment_flags.segment_reference_enabled = (mask >> 2) & 1;
+      seg.segment_flags.segment_reference = pp->stVP9Segments.feature_data[i][2];
+      seg.segment_flags.segment_reference_skipped = (mask >> 3) & 1;
+   }
+   /* ponytail: no per-segment quantizer scales and loop filter levels (VA-API wants them derived): NVIDIA's VA-API
+    * driver reads those from the frame header, Mesa's (AMD) need the derivation (VP9 spec 8.6.1, 8.8.1) */
+   return true;
+}
+
+static bool
+AV1Picture(VideoDecoder *dec)
+{
+   if (dec->pic_params.size() < sizeof(DXVA_PicParams_AV1) || dec->tiles.empty()) {
+      return false;
+   }
+   const DXVA_PicParams_AV1 *pp = (const DXVA_PicParams_AV1 *)dec->pic_params.data();
+   struct pipe_av1_picture_desc *d = &dec->desc.av1;
+   memset(d, 0, sizeof *d);
+   auto &pic = d->picture_parameter;
+
+   /* the 8 reference slots, and which of them the 7 references are (DXVA's frame_refs[].Index is the slot) */
+   for (unsigned i = 0; i < 8; i++) {
+      d->ref[i] = pp->RefFrameMapTextureIndex[i] == DXVA_INVALID_ENTRY ? NULL : Surface(dec, pp->RefFrameMapTextureIndex[i]);
+   }
+   for (unsigned i = 0; i < 7; i++) {
+      const DXVA_PicEntry_AV1 &e = pp->frame_refs[i];
+      pic.ref_frame_idx[i] = e.Index == DXVA_INVALID_ENTRY ? 0 : e.Index;
+      pic.wm[i].invalid = e.wminvalid;
+      pic.wm[i].wmtype = e.wmtype;
+      for (unsigned j = 0; j < 6; j++) {
+         pic.wm[i].wmmat[j] = e.wmmat[j];
+      }
+   }
+
+   pic.profile = pp->seq_profile;
+   pic.order_hint_bits_minus_1 = pp->order_hint_bits ? pp->order_hint_bits - 1 : 0;
+   pic.bit_depth_idx = pp->bitdepth == 12 ? 2 : pp->bitdepth == 10 ? 1 : 0;
+   pic.matrix_coefficients = pp->film_grain.matrix_coeff_is_identity ? 0 : 1;
+   pic.seq_info_fields.use_128x128_superblock = pp->coding.use_128x128_superblock;
+   pic.seq_info_fields.enable_filter_intra = pp->coding.filter_intra;
+   pic.seq_info_fields.enable_intra_edge_filter = pp->coding.intra_edge_filter;
+   pic.seq_info_fields.enable_interintra_compound = pp->coding.interintra_compound;
+   pic.seq_info_fields.enable_masked_compound = pp->coding.masked_compound;
+   pic.seq_info_fields.enable_dual_filter = pp->coding.dual_filter;
+   pic.seq_info_fields.enable_order_hint = pp->order_hint_bits != 0;
+   pic.seq_info_fields.enable_jnt_comp = pp->coding.jnt_comp;
+   pic.seq_info_fields.enable_cdef = pp->coding.cdef;
+   pic.seq_info_fields.mono_chrome = pp->format.mono_chrome;
+   pic.seq_info_fields.ref_frame_mvs = pp->coding.enable_ref_frame_mvs;
+   pic.seq_info_fields.film_grain_params_present = pp->coding.film_grain;
+
+   pic.frame_width = pp->width;
+   pic.frame_height = pp->height;
+   pic.max_width = pp->max_width;
+   pic.max_height = pp->max_height;
+   pic.primary_ref_frame = pp->primary_ref_frame;
+   pic.order_hint = pp->order_hint;
+   pic.superres_scale_denominator = pp->superres_denom;
+   pic.interp_filter = pp->interp_filter;
+
+   pic.pic_info_fields.frame_type = pp->format.frame_type;
+   pic.pic_info_fields.show_frame = pp->format.show_frame;
+   pic.pic_info_fields.showable_frame = pp->format.showable_frame;
+   pic.pic_info_fields.disable_cdf_update = pp->coding.disable_cdf_update;
+   pic.pic_info_fields.allow_screen_content_tools = pp->coding.screen_content_tools;
+   pic.pic_info_fields.force_integer_mv = pp->coding.integer_mv;
+   pic.pic_info_fields.allow_intrabc = pp->coding.intrabc;
+   pic.pic_info_fields.use_superres = pp->coding.superres;
+   pic.pic_info_fields.allow_high_precision_mv = pp->coding.high_precision_mv;
+   pic.pic_info_fields.is_motion_mode_switchable = pp->coding.switchable_motion_mode;
+   pic.pic_info_fields.use_ref_frame_mvs = pp->coding.use_ref_frame_mvs;
+   pic.pic_info_fields.disable_frame_end_update_cdf = pp->coding.disable_frame_end_update_cdf;
+   pic.pic_info_fields.allow_warped_motion = pp->coding.warped_motion;
+
+   /* the tiles: their sizes in superblocks (DXVA has them for uniform spacing too) */
+   pic.tile_cols = pp->tiles.cols;
+   pic.tile_rows = pp->tiles.rows;
+   pic.context_update_tile_id = pp->tiles.context_update_id;
+   for (unsigned i = 0, start = 0; i < MIN2(pp->tiles.cols, 64u); start += pp->tiles.widths[i], i++) {
+      pic.width_in_sbs[i] = pp->tiles.widths[i];
+      pic.tile_col_start_sb[i] = start;
+   }
+   for (unsigned i = 0, start = 0; i < MIN2(pp->tiles.rows, 64u); start += pp->tiles.heights[i], i++) {
+      pic.height_in_sbs[i] = pp->tiles.heights[i];
+      pic.tile_row_start_sb[i] = start;
+   }
+
+   pic.filter_level[0] = pp->loop_filter.filter_level[0];
+   pic.filter_level[1] = pp->loop_filter.filter_level[1];
+   pic.filter_level_u = pp->loop_filter.filter_level_u;
+   pic.filter_level_v = pp->loop_filter.filter_level_v;
+   pic.loop_filter_info_fields.sharpness_level = pp->loop_filter.sharpness_level;
+   pic.loop_filter_info_fields.mode_ref_delta_enabled = pp->loop_filter.mode_ref_delta_enabled;
+   pic.loop_filter_info_fields.mode_ref_delta_update = pp->loop_filter.mode_ref_delta_update;
+   for (unsigned i = 0; i < 8; i++) {
+      pic.ref_deltas[i] = pp->loop_filter.ref_deltas[i];
+   }
+   pic.mode_deltas[0] = pp->loop_filter.mode_deltas[0];
+   pic.mode_deltas[1] = pp->loop_filter.mode_deltas[1];
+   pic.mode_control_fields.delta_lf_present_flag = pp->loop_filter.delta_lf_present;
+   pic.mode_control_fields.log2_delta_lf_res = pp->loop_filter.delta_lf_res;
+   pic.mode_control_fields.delta_lf_multi = pp->loop_filter.delta_lf_multi;
+
+   /* loop restoration: DXVA has the unit sizes, VA-API (gallium) the shifts */
+   pic.loop_restoration_fields.yframe_restoration_type = pp->loop_filter.frame_restoration_type[0];
+   pic.loop_restoration_fields.cbframe_restoration_type = pp->loop_filter.frame_restoration_type[1];
+   pic.loop_restoration_fields.crframe_restoration_type = pp->loop_filter.frame_restoration_type[2];
+   if (pp->loop_filter.frame_restoration_type[0] || pp->loop_filter.frame_restoration_type[1] ||
+       pp->loop_filter.frame_restoration_type[2]) {
+      pic.loop_restoration_fields.lr_unit_shift = pp->loop_filter.log2_restoration_unit_size[0] - 6;
+      pic.loop_restoration_fields.lr_uv_shift = pp->loop_filter.log2_restoration_unit_size[0] -
+                                                pp->loop_filter.log2_restoration_unit_size[1];
+   }
+
+   pic.base_qindex = pp->quantization.base_qindex;
+   pic.y_dc_delta_q = pp->quantization.y_dc_delta_q;
+   pic.u_dc_delta_q = pp->quantization.u_dc_delta_q;
+   pic.u_ac_delta_q = pp->quantization.u_ac_delta_q;
+   pic.v_dc_delta_q = pp->quantization.v_dc_delta_q;
+   pic.v_ac_delta_q = pp->quantization.v_ac_delta_q;
+   pic.qmatrix_fields.using_qmatrix = pp->quantization.qm_y != 0xff;
+   if (pic.qmatrix_fields.using_qmatrix) {
+      pic.qmatrix_fields.qm_y = pp->quantization.qm_y;
+      pic.qmatrix_fields.qm_u = pp->quantization.qm_u;
+      pic.qmatrix_fields.qm_v = pp->quantization.qm_v;
+   }
+   pic.mode_control_fields.delta_q_present_flag = pp->quantization.delta_q_present;
+   pic.mode_control_fields.log2_delta_q_res = pp->quantization.delta_q_res;
+   pic.mode_control_fields.tx_mode = pp->coding.tx_mode;
+   pic.mode_control_fields.reference_select = pp->coding.reference_mode;
+   pic.mode_control_fields.reduced_tx_set_used = pp->coding.reduced_tx_set;
+   pic.mode_control_fields.skip_mode_present = pp->coding.skip_mode;
+
+   /* CDEF strengths: DXVA's split, VA-API's (gallium's) primary << 2 | secondary */
+   pic.cdef_damping_minus_3 = pp->cdef.damping;
+   pic.cdef_bits = pp->cdef.bits;
+   for (unsigned i = 0; i < 8; i++) {
+      pic.cdef_y_strengths[i] = pp->cdef.y_strengths[i].primary << 2 | pp->cdef.y_strengths[i].secondary;
+      pic.cdef_uv_strengths[i] = pp->cdef.uv_strengths[i].primary << 2 | pp->cdef.uv_strengths[i].secondary;
+   }
+
+   pic.seg_info.segment_info_fields.enabled = pp->segmentation.enabled;
+   pic.seg_info.segment_info_fields.update_map = pp->segmentation.update_map;
+   pic.seg_info.segment_info_fields.update_data = pp->segmentation.update_data;
+   pic.seg_info.segment_info_fields.temporal_update = pp->segmentation.temporal_update;
+   for (unsigned i = 0; i < 8; i++) {
+      pic.seg_info.feature_mask[i] = pp->segmentation.feature_mask[i];
+      for (unsigned j = 0; j < 8; j++) {
+         pic.seg_info.feature_data[i][j] = pp->segmentation.feature_data[i][j];
+      }
+   }
+
+   /* film grain (applied on the target: no separate film grain picture) */
+   auto &fg = pic.film_grain_info;
+   auto &dfg = pp->film_grain;
+   fg.film_grain_info_fields.apply_grain = dfg.apply_grain;
+   if (dfg.apply_grain) {
+      fg.film_grain_info_fields.chroma_scaling_from_luma = dfg.chroma_scaling_from_luma;
+      fg.film_grain_info_fields.grain_scaling_minus_8 = dfg.scaling_shift_minus8;
+      fg.film_grain_info_fields.ar_coeff_lag = dfg.ar_coeff_lag;
+      fg.film_grain_info_fields.ar_coeff_shift_minus_6 = dfg.ar_coeff_shift_minus6;
+      fg.film_grain_info_fields.grain_scale_shift = dfg.grain_scale_shift;
+      fg.film_grain_info_fields.overlap_flag = dfg.overlap_flag;
+      fg.film_grain_info_fields.clip_to_restricted_range = dfg.clip_to_restricted_range;
+      fg.grain_seed = dfg.grain_seed;
+      fg.num_y_points = dfg.num_y_points;
+      for (unsigned i = 0; i < MIN2(dfg.num_y_points, 14u); i++) {
+         fg.point_y_value[i] = dfg.scaling_points_y[i][0];
+         fg.point_y_scaling[i] = dfg.scaling_points_y[i][1];
+      }
+      fg.num_cb_points = dfg.num_cb_points;
+      for (unsigned i = 0; i < MIN2(dfg.num_cb_points, 10u); i++) {
+         fg.point_cb_value[i] = dfg.scaling_points_cb[i][0];
+         fg.point_cb_scaling[i] = dfg.scaling_points_cb[i][1];
+      }
+      fg.num_cr_points = dfg.num_cr_points;
+      for (unsigned i = 0; i < MIN2(dfg.num_cr_points, 10u); i++) {
+         fg.point_cr_value[i] = dfg.scaling_points_cr[i][0];
+         fg.point_cr_scaling[i] = dfg.scaling_points_cr[i][1];
+      }
+      for (unsigned i = 0; i < 24; i++) {
+         fg.ar_coeffs_y[i] = (int8_t)dfg.ar_coeffs_y[i];
+      }
+      for (unsigned i = 0; i < 25; i++) {
+         fg.ar_coeffs_cb[i] = (int8_t)dfg.ar_coeffs_cb[i];
+         fg.ar_coeffs_cr[i] = (int8_t)dfg.ar_coeffs_cr[i];
+      }
+      fg.cb_mult = dfg.cb_mult;
+      fg.cb_luma_mult = dfg.cb_luma_mult;
+      fg.cb_offset = dfg.cb_offset;
+      fg.cr_mult = dfg.cr_mult;
+      fg.cr_luma_mult = dfg.cr_luma_mult;
+      fg.cr_offset = dfg.cr_offset;
+   }
+
+   auto &slice = d->slice_parameter;
+   slice.slice_count = MIN2((unsigned)dec->tiles.size(), (unsigned)ARRAY_SIZE(slice.slice_data_size));
+   for (unsigned i = 0; i < slice.slice_count; i++) {
+      slice.slice_data_size[i] = dec->tiles[i].DataSize;
+      slice.slice_data_offset[i] = dec->tiles[i].DataOffset;
+      slice.slice_data_row[i] = dec->tiles[i].row;
+      slice.slice_data_col[i] = dec->tiles[i].column;
+      slice.slice_data_anchor_frame_idx[i] = dec->tiles[i].anchor_frame;
+   }
+   return true;
+}
+
+/* MPEG-2's default intra quantizer matrix (zig-zag order), for programs that send none */
+static const uint8_t MPEG2_DEFAULT_INTRA[64] = {
+   8,  16, 16, 19, 16, 19, 22, 22, 22, 22, 22, 22, 26, 24, 26, 27, 27, 27, 26, 26, 26, 26, 27, 27, 27, 29, 29, 29, 34, 34, 34, 29,
+   29, 29, 27, 27, 29, 29, 32, 32, 34, 34, 37, 38, 37, 35, 35, 34, 35, 38, 38, 40, 40, 40, 48, 48, 46, 46, 56, 56, 58, 69, 69, 83,
+};
+
+static bool
+MPEG2Picture(VideoDecoder *dec)
+{
+   if (dec->pic_params.size() < sizeof(DXVA_PictureParameters)) {
+      return false;
+   }
+   const DXVA_PictureParameters *pp = (const DXVA_PictureParameters *)dec->pic_params.data();
+   struct pipe_mpeg12_picture_desc *d = &dec->desc.mpeg2;
+   memset(d, 0, sizeof *d);
+
+   d->picture_coding_type = pp->bPicIntra ? 1 : pp->bPicBackwardPrediction ? 3 : 2;   /* I, B, P */
+   /* f_codes: DXVA's as coded, gallium's (VA-API's) minus one */
+   d->f_code[0][0] = ((pp->wBitstreamFcodes >> 12) & 0xf) - 1;
+   d->f_code[0][1] = ((pp->wBitstreamFcodes >> 8) & 0xf) - 1;
+   d->f_code[1][0] = ((pp->wBitstreamFcodes >> 4) & 0xf) - 1;
+   d->f_code[1][1] = (pp->wBitstreamFcodes & 0xf) - 1;
+   uint16_t pce = pp->wBitstreamPCEelements;
+   d->intra_dc_precision = (pce >> 14) & 3;
+   d->picture_structure = (pce >> 12) & 3;
+   d->top_field_first = (pce >> 11) & 1;
+   d->frame_pred_frame_dct = (pce >> 10) & 1;
+   d->concealment_motion_vectors = (pce >> 9) & 1;
+   d->q_scale_type = (pce >> 8) & 1;
+   d->intra_vlc_format = (pce >> 7) & 1;
+   d->alternate_scan = (pce >> 6) & 1;
+   d->num_slices = dec->slices;
+
+   memcpy(dec->intra_matrix, MPEG2_DEFAULT_INTRA, 64);
+   memset(dec->non_intra_matrix, 16, 64);
+   if (dec->qmatrix.size() >= sizeof(DXVA_QmatrixData)) {
+      const DXVA_QmatrixData *qm = (const DXVA_QmatrixData *)dec->qmatrix.data();
+      for (unsigned i = 0; i < 64; i++) {
+         if (qm->bNewQmatrix[0]) {
+            dec->intra_matrix[i] = (uint8_t)qm->Qmatrix[0][i];
+         }
+         if (qm->bNewQmatrix[1]) {
+            dec->non_intra_matrix[i] = (uint8_t)qm->Qmatrix[1][i];
+         }
+      }
+   }
+   d->intra_matrix = dec->intra_matrix;
+   d->non_intra_matrix = dec->non_intra_matrix;
+
+   d->ref[0] = pp->wForwardRefPictureIndex == 0xffff ? NULL : Surface(dec, pp->wForwardRefPictureIndex);
+   d->ref[1] = pp->wBackwardRefPictureIndex == 0xffff ? NULL : Surface(dec, pp->wBackwardRefPictureIndex);
+   return true;
+}
+
+static void APIENTRY
+VideoDecoderEndFrame(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HDECODE hDecoder)
+{
+   Device *pDevice = CastDevice(hDevice);
+   VideoDecoder *dec = CastDecoder(hDecoder);
+   if (!dec->target || dec->stream.empty()) {
+      return;
+   }
+   bool ok = dec->profile->codec == CODEC_H264 ? H264Picture(dec)
+           : dec->profile->codec == CODEC_HEVC ? HEVCPicture(dec)
+           : dec->profile->codec == CODEC_VP9  ? VP9Picture(dec)
+           : dec->profile->codec == CODEC_AV1  ? AV1Picture(dec)
+                                               : MPEG2Picture(dec);
+   struct pipe_video_buffer *target = Surface(dec, dec->slice);
+   if (!ok || !target) {
+      VideoLog("EndFrame: %s (picture parameters %zu bytes)\n", ok ? "no target" : "no picture parameters",
+               dec->pic_params.size());
+      return;
+   }
+   struct pipe_picture_desc *picture = &dec->desc.h264.base;
+   picture->profile = dec->profile->profile;
+   picture->entry_point = PIPE_VIDEO_ENTRYPOINT_BITSTREAM;
+
+   FlushDevice(pDevice);
+   const void *buffers[1] = {dec->stream.data()};
+   unsigned sizes[1] = {(unsigned)dec->stream.size()};
+   dec->codec->begin_frame(dec->codec, target, picture);
+   dec->codec->decode_bitstream(dec->codec, target, picture, 1, buffers, sizes);
+   dec->codec->end_frame(dec->codec, target, picture);
+   FlushVideo(pDevice);
+   dec->target = NULL;
+}
