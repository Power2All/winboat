index 59f5766..8a3cd3c 100644
--- a/src/gallium/frontends/d3d10umd/D3D11_1.cpp
+++ b/src/gallium/frontends/d3d10umd/D3D11_1.cpp
@@ -28,6 +28,7 @@
 #include "Rasterizer.h"
 #include "Shader.h"
 #include "State.h"
+#include "Video.h"
 
 #include "util/format/u_format.h"
 #include "util/u_inlines.h"
@@ -204,6 +205,10 @@ static void APIENTRY
 CreateShaderResourceView11(D3D10DDI_HDEVICE hDevice, const D3D11DDIARG_CREATESHADERRESOURCEVIEW *pView,
                            D3D10DDI_HSHADERRESOURCEVIEW hView, D3D10DDI_HRTSHADERRESOURCEVIEW hRTView)
 {
+   /* NV12/P010: a view of one plane */
+   if (VideoCreateShaderResourceView(hDevice, pView, CastShaderResourceView(hView))) {
+      return;
+   }
    bool bufferex = pView->ResourceDimension == D3D11DDIRESOURCE_BUFFEREX;
    bool raw = bufferex && (pView->BufferEx.Flags & D3D11_DDI_BUFFEREX_SRV_FLAG_RAW);
    bool structured = (bufferex || pView->ResourceDimension == D3D10DDIRESOURCE_BUFFER) &&
@@ -572,7 +577,10 @@ HRESULT APIENTRY
 RetrieveSubObject11_1(D3D10DDI_HDEVICE hDevice, UINT32 SubDeviceID, SIZE_T ParamSize, void *pParams,
                       SIZE_T OutputParamSize, void *pOutputParamsBuffer)
 {
-   /* Video decoding and processing: none */
+   /* Video decoding and processing (Video.cpp) */
+   if (SubDeviceID == D3D11_1DDI_VIDEO_FUNCTIONS) {
+      return VideoRetrieveFunctions(hDevice, pParams, ParamSize);
+   }
    return E_NOTIMPL;
 }
 
@@ -581,6 +589,9 @@ RetrieveSubObject11_1(D3D10DDI_HDEVICE hDevice, UINT32 SubDeviceID, SIZE_T Param
 static void APIENTRY
 CheckFormatSupport11_1(D3D10DDI_HDEVICE hDevice, DXGI_FORMAT Format, UINT *pFormatCaps)
 {
+   if (VideoFormatSupport(hDevice, Format, pFormatCaps)) {
+      return;
+   }
    funcs10.pfnCheckFormatSupport(hDevice, Format, pFormatCaps);
 
    struct pipe_screen *screen = CastPipeContext(hDevice)->screen;
@@ -601,6 +612,7 @@ CheckFormatSupport11_1(D3D10DDI_HDEVICE hDevice, DXGI_FORMAT Format, UINT *pForm
        screen->get_param(screen, PIPE_CAP_MAX_TEXTURE_GATHER_COMPONENTS)) {
       *pFormatCaps |= D3D11_1DDI_FORMAT_SUPPORT_SHADER_GATHER;
    }
+   VideoAddFormatSupport(hDevice, Format, pFormatCaps);
 }
 
 
