+   memset(pps, 0, sizeof *pps);
+   memset(sps, 0, sizeof *sps);
+   d->pps = pps;
+   pps->sps = sps;
+
+   unsigned log2_min_cb = pp->log2_min_luma_coding_block_size_minus3 + 3;
+   sps->chroma_format_idc = pp->chroma_format_idc;
+   sps->separate_colour_plane_flag = pp->separate_colour_plane_flag;
+   sps->pic_width_in_luma_samples = pp->PicWidthInMinCbsY << log2_min_cb;
+   sps->pic_height_in_luma_samples = pp->PicHeightInMinCbsY << log2_min_cb;
+   sps->bit_depth_luma_minus8 = pp->bit_depth_luma_minus8;
+   sps->bit_depth_chroma_minus8 = pp->bit_depth_chroma_minus8;
+   sps->log2_max_pic_order_cnt_lsb_minus4 = pp->log2_max_pic_order_cnt_lsb_minus4;
+   sps->sps_max_dec_pic_buffering_minus1 = pp->sps_max_dec_pic_buffering_minus1;
+   sps->log2_min_luma_coding_block_size_minus3 = pp->log2_min_luma_coding_block_size_minus3;
+   sps->log2_diff_max_min_luma_coding_block_size = pp->log2_diff_max_min_luma_coding_block_size;
+   sps->log2_min_transform_block_size_minus2 = pp->log2_min_transform_block_size_minus2;
+   sps->log2_diff_max_min_transform_block_size = pp->log2_diff_max_min_transform_block_size;
+   sps->max_transform_hierarchy_depth_inter = pp->max_transform_hierarchy_depth_inter;
+   sps->max_transform_hierarchy_depth_intra = pp->max_transform_hierarchy_depth_intra;
+   sps->num_short_term_ref_pic_sets = pp->num_short_term_ref_pic_sets;
+   sps->num_long_term_ref_pics_sps = pp->num_long_term_ref_pics_sps;
+   sps->scaling_list_enabled_flag = pp->scaling_list_enabled_flag;
+   sps->amp_enabled_flag = pp->amp_enabled_flag;
+   sps->sample_adaptive_offset_enabled_flag = pp->sample_adaptive_offset_enabled_flag;
+   sps->pcm_enabled_flag = pp->pcm_enabled_flag;
+   sps->pcm_sample_bit_depth_luma_minus1 = pp->pcm_sample_bit_depth_luma_minus1;
+   sps->pcm_sample_bit_depth_chroma_minus1 = pp->pcm_sample_bit_depth_chroma_minus1;
+   sps->log2_min_pcm_luma_coding_block_size_minus3 = pp->log2_min_pcm_luma_coding_block_size_minus3;
+   sps->log2_diff_max_min_pcm_luma_coding_block_size = pp->log2_diff_max_min_pcm_luma_coding_block_size;
+   sps->pcm_loop_filter_disabled_flag = pp->pcm_loop_filter_disabled_flag;
+   sps->long_term_ref_pics_present_flag = pp->long_term_ref_pics_present_flag;
+   sps->sps_temporal_mvp_enabled_flag = pp->sps_temporal_mvp_enabled_flag;
+   sps->strong_intra_smoothing_enabled_flag = pp->strong_intra_smoothing_enabled_flag;
+
+   pps->dependent_slice_segments_enabled_flag = pp->dependent_slice_segments_enabled_flag;
+   pps->output_flag_present_flag = pp->output_flag_present_flag;
+   pps->num_extra_slice_header_bits = pp->num_extra_slice_header_bits;
+   pps->sign_data_hiding_enabled_flag = pp->sign_data_hiding_enabled_flag;
+   pps->cabac_init_present_flag = pp->cabac_init_present_flag;
+   pps->num_ref_idx_l0_default_active_minus1 = pp->num_ref_idx_l0_default_active_minus1;
+   pps->num_ref_idx_l1_default_active_minus1 = pp->num_ref_idx_l1_default_active_minus1;
+   pps->init_qp_minus26 = pp->init_qp_minus26;
+   pps->constrained_intra_pred_flag = pp->constrained_intra_pred_flag;
+   pps->transform_skip_enabled_flag = pp->transform_skip_enabled_flag;
+   pps->cu_qp_delta_enabled_flag = pp->cu_qp_delta_enabled_flag;
+   pps->diff_cu_qp_delta_depth = pp->diff_cu_qp_delta_depth;
+   pps->pps_cb_qp_offset = pp->pps_cb_qp_offset;
+   pps->pps_cr_qp_offset = pp->pps_cr_qp_offset;
+   pps->pps_slice_chroma_qp_offsets_present_flag = pp->pps_slice_chroma_qp_offsets_present_flag;
+   pps->weighted_pred_flag = pp->weighted_pred_flag;
+   pps->weighted_bipred_flag = pp->weighted_bipred_flag;
+   pps->transquant_bypass_enabled_flag = pp->transquant_bypass_enabled_flag;
+   pps->tiles_enabled_flag = pp->tiles_enabled_flag;
+   pps->entropy_coding_sync_enabled_flag = pp->entropy_coding_sync_enabled_flag;
+   pps->uniform_spacing_flag = pp->uniform_spacing_flag;
+   pps->loop_filter_across_tiles_enabled_flag = pp->loop_filter_across_tiles_enabled_flag;
+   pps->pps_loop_filter_across_slices_enabled_flag = pp->pps_loop_filter_across_slices_enabled_flag;
+   pps->deblocking_filter_override_enabled_flag = pp->deblocking_filter_override_enabled_flag;
+   pps->pps_deblocking_filter_disabled_flag = pp->pps_deblocking_filter_disabled_flag;
+   pps->lists_modification_present_flag = pp->lists_modification_present_flag;
+   pps->slice_segment_header_extension_present_flag = pp->slice_segment_header_extension_present_flag;
+   pps->pps_beta_offset_div2 = pp->pps_beta_offset_div2;
+   pps->pps_tc_offset_div2 = pp->pps_tc_offset_div2;
+   pps->log2_parallel_merge_level_minus2 = pp->log2_parallel_merge_level_minus2;
+   pps->st_rps_bits = pp->wNumBitsForShortTermRPSInSlice;
+   if (pp->tiles_enabled_flag) {
+      pps->num_tile_columns_minus1 = pp->num_tile_columns_minus1;
+      pps->num_tile_rows_minus1 = pp->num_tile_rows_minus1;
+      for (unsigned i = 0; i < MIN2(ARRAY_SIZE(pp->column_width_minus1), ARRAY_SIZE(pps->column_width_minus1)); i++) {
+         pps->column_width_minus1[i] = pp->column_width_minus1[i];
+      }
+      for (unsigned i = 0; i < MIN2(ARRAY_SIZE(pp->row_height_minus1), ARRAY_SIZE(pps->row_height_minus1)); i++) {
+         pps->row_height_minus1[i] = pp->row_height_minus1[i];
+      }
+   }
+
+   /* the scaling lists: DXVA's in up-right diagonal order, gallium's (VA-API's) in raster order; flat without them */
+   memset(sps->ScalingList4x4, 16, sizeof sps->ScalingList4x4);
+   memset(sps->ScalingList8x8, 16, sizeof sps->ScalingList8x8);
+   memset(sps->ScalingList16x16, 16, sizeof sps->ScalingList16x16);
+   memset(sps->ScalingList32x32, 16, sizeof sps->ScalingList32x32);
+   memset(sps->ScalingListDCCoeff16x16, 16, sizeof sps->ScalingListDCCoeff16x16);
+   memset(sps->ScalingListDCCoeff32x32, 16, sizeof sps->ScalingListDCCoeff32x32);
+   if (pp->scaling_list_enabled_flag && dec->qmatrix.size() >= sizeof(DXVA_Qmatrix_HEVC)) {
+      const DXVA_Qmatrix_HEVC *qm = (const DXVA_Qmatrix_HEVC *)dec->qmatrix.data();
+      for (unsigned i = 0; i < 6; i++) {
+         for (unsigned j = 0; j < 16; j++) {
+            sps->ScalingList4x4[i][vl_zscan_h265_up_right_diagonal_16[j]] = qm->ucScalingLists0[i][j];
+         }
+         for (unsigned j = 0; j < 64; j++) {
+            sps->ScalingList8x8[i][vl_zscan_h265_up_right_diagonal[j]] = qm->ucScalingLists1[i][j];
+            sps->ScalingList16x16[i][vl_zscan_h265_up_right_diagonal[j]] = qm->ucScalingLists2[i][j];
+            if (i < 2) {
+               sps->ScalingList32x32[i][vl_zscan_h265_up_right_diagonal[j]] = qm->ucScalingLists3[i][j];
+            }
+         }
+      }
+      memcpy(sps->ScalingListDCCoeff16x16, qm->ucScalingListDCCoefSizeID2, sizeof qm->ucScalingListDCCoefSizeID2);
+      memcpy(sps->ScalingListDCCoeff32x32, qm->ucScalingListDCCoefSizeID3, sizeof qm->ucScalingListDCCoefSizeID3);
+   }
+
+   d->IDRPicFlag = pp->IdrPicFlag;
+   d->RAPPicFlag = pp->IrapPicFlag;
+   d->IntraPicFlag = pp->IntraPicFlag;
+   d->NumDeltaPocsOfRefRpsIdx = pp->ucNumDeltaPocsOfRefRpsIdx;
+   d->NumShortTermPictureSliceHeaderBits = pp->wNumBitsForShortTermRPSInSlice;
+   d->UseStRpsBits = true;
+   d->CurrPicOrderCntVal = pp->CurrPicOrderCntVal;
+   for (unsigned i = 0; i < 15; i++) {
+      DXVA_PicEntry e = pp->RefPicList[i];
+      d->ref[i] = e.bPicEntry == DXVA_INVALID_ENTRY ? NULL : Surface(dec, e.Index7Bits);
+      d->IsLongTerm[i] = e.AssociatedFlag;
+      d->PicOrderCntVal[i] = pp->PicOrderCntValList[i];
+   }
+   for (unsigned i = 0; i < 8; i++) {
+      if (pp->RefPicSetStCurrBefore[i] != DXVA_INVALID_ENTRY) {
+         d->RefPicSetStCurrBefore[d->NumPocStCurrBefore++] = pp->RefPicSetStCurrBefore[i];
+      }
+      if (pp->RefPicSetStCurrAfter[i] != DXVA_INVALID_ENTRY) {
+         d->RefPicSetStCurrAfter[d->NumPocStCurrAfter++] = pp->RefPicSetStCurrAfter[i];
+      }
+      if (pp->RefPicSetLtCurr[i] != DXVA_INVALID_ENTRY) {
+         d->RefPicSetLtCurr[d->NumPocLtCurr++] = pp->RefPicSetLtCurr[i];
+      }
+   }
+   d->NumPocTotalCurr = d->NumPocStCurrBefore + d->NumPocStCurrAfter + d->NumPocLtCurr;
+   /* ponytail: no per-slice reference lists (the short slice format has none): NVIDIA's VA-API driver builds them
+    * from the reference sets, Mesa's (AMD) read RefPicList - those need the slice headers parsed */
+   return true;
+}
