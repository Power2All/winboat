+static struct u_rect
+Rect(const RECT &r)
+{
+   struct u_rect u = {(int)r.left, (int)r.right, (int)r.top, (int)r.bottom};
+   return u;
+}
+
+/*
+ * The compositor's views of a slice's Y, Cb and Cr: as 2D arrays, which its shader samples (vl's video buffers can be
+ * interlaced arrays), where vl's own views of these 2D planes are 2D - a GL host samples a 2D texture through an array
+ * sampler as zeros. Each a view of its own (a texture view on the host), so Cb and Cr keep their swizzles.
+ */
+static void
+ComponentViews(struct pipe_context *vpipe, struct pipe_video_buffer *buffer)
+{
+   struct vl_video_buffer *buf = (struct vl_video_buffer *)buffer;
+   const unsigned planes[3] = {0, 1, 1};
+   for (unsigned c = 0; c < 3; c++) {
+      if (buf->sampler_view_components[c]) {
+         continue;
+      }
+      struct pipe_resource *res = buf->resources[planes[c]];
+      struct pipe_sampler_view templat;
+      u_sampler_view_default_template(&templat, res, res->format);
+      templat.target = PIPE_TEXTURE_2D_ARRAY;
+      templat.swizzle_r = templat.swizzle_g = templat.swizzle_b = c == 2 ? PIPE_SWIZZLE_Y : PIPE_SWIZZLE_X;
+      templat.swizzle_a = PIPE_SWIZZLE_1;
+      buf->sampler_view_components[c] = vpipe->create_sampler_view(vpipe, res, &templat);
+   }
+}
+
+static VideoCompositor *
+Compositor(Device *pDevice)
+{
+   if (!pDevice->compositor) {
+      VideoCompositor *c = new VideoCompositor();
+      if (!vl_compositor_init(&c->compositor, VideoPipe(pDevice))) {
+         delete c;
+         return NULL;
+      }
+      if (!vl_compositor_init_state(&c->state, VideoPipe(pDevice))) {
+         vl_compositor_cleanup(&c->compositor);
+         delete c;
+         return NULL;
+      }
+      pDevice->compositor = c;
+   }
+   return pDevice->compositor;
+}
+
+static HRESULT APIENTRY
+VideoProcessorBlt(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSOR hProcessor,
+                  D3D11_1DDI_HVIDEOPROCESSOROUTPUTVIEW hOutputView, UINT OutputFrame, UINT StreamCount,
+                  const D3D11_1DDI_VIDEO_PROCESSOR_STREAM *pStreams)
+{
+   Device *pDevice = CastDevice(hDevice);
+   VideoProcessor *vp = CastProcessor(hProcessor);
+   VideoProcessorOutputView *out = static_cast<VideoProcessorOutputView *>(hOutputView.pDrvPrivate);
+   VideoCompositor *c = Compositor(pDevice);
+   if (!c) {
+      return E_OUTOFMEMORY;
+   }
+   struct pipe_context *vpipe = pDevice->video_pipe;
+   struct pipe_resource *dst = out->resource->resource;
+   struct pipe_surface templat;
+   u_surface_default_template(&templat, dst);
+   templat.u.tex.level = out->level;
+   templat.u.tex.first_layer = templat.u.tex.last_layer = out->slice;
+   struct pipe_surface *surface = vpipe->create_surface(vpipe, dst, &templat);
+   if (!surface) {
+      return E_OUTOFMEMORY;
+   }
+   struct u_rect target = {0, (int)u_minify(dst->width0, out->level), 0, (int)u_minify(dst->height0, out->level)};
+   if (vp->target_rect_enabled) {
+      target = Rect(vp->target_rect);
+   }
+
+   FlushDevice(pDevice);
+   vl_compositor_clear_layers(&c->state);
+   unsigned layers = 0;
+   for (UINT i = 0; i < MIN2(StreamCount, 1u); i++) {
+      if (!pStreams[i].Enable || !pStreams[i].hInputSurface.pDrvPrivate) {
+         continue;
+      }
+      VideoProcessorInputView *in = static_cast<VideoProcessorInputView *>(pStreams[i].hInputSurface.pDrvPrivate);
+      VideoSurface *v = in->resource->video;
+      struct u_rect src = {0, (int)(v ? v->width : in->resource->resource->width0), 0,
+                           (int)(v ? v->height : in->resource->resource->height0)};
+      if (vp->stream.src_enabled) {
+         src = Rect(vp->stream.src);
+      }
+      struct u_rect dst_area = vp->stream.dst_enabled ? Rect(vp->stream.dst) : target;
+      if (v) {
+         /* YCbCr_Matrix: 0 BT.601, 1 BT.709; Nominal_Range 2: full range (0-255) input */
+         vl_csc_matrix csc;
+         enum VL_CSC_COLOR_STANDARD standard = vp->stream.color_space.YCbCr_Matrix ? VL_CSC_COLOR_STANDARD_BT_709
+                                                                                  : VL_CSC_COLOR_STANDARD_BT_601;
+         vl_csc_get_matrix(standard, NULL, vp->stream.color_space.Nominal_Range != 2, &csc);
+         vl_compositor_set_csc_matrix(&c->state, (const vl_csc_matrix *)&csc, 1.0f, 0.0f);
+         ComponentViews(vpipe, v->buffers[in->slice]);
+         vl_compositor_set_buffer_layer(&c->state, &c->compositor, layers, v->buffers[in->slice], &src, NULL,
+                                        VL_COMPOSITOR_NONE);
+      } else {
+         vl_compositor_set_rgba_layer(&c->state, &c->compositor, layers, in->rgb, &src, NULL, NULL);
+      }
+      vl_compositor_set_layer_dst_area(&c->state, layers, &dst_area);
+      /* the background around the picture */
+      if (dst_area.x0 > target.x0 || dst_area.y0 > target.y0 || dst_area.x1 < target.x1 || dst_area.y1 < target.y1) {
+         union pipe_color_union color = {};
+         if (!vp->background_ycbcr) {
+            color.f[0] = vp->background.RGBA.R;
+            color.f[1] = vp->background.RGBA.G;
+            color.f[2] = vp->background.RGBA.B;
+            color.f[3] = vp->background.RGBA.A;
+         }
+         vpipe->clear_render_target(vpipe, surface, &color, target.x0, target.y0, target.x1 - target.x0,
+                                    target.y1 - target.y0, false);
+      }
+      layers++;
+   }
+   if (layers) {
+      vl_compositor_render(&c->state, &c->compositor, surface, NULL, false);
+   }
+   FlushVideo(pDevice);
+   pipe_surface_reference(&surface, NULL);
+   return S_OK;
+}
+
+
+/*
+ * The function table
+ */
+
+/* Entry points of features not offered: nothing to do, or E_NOTIMPL (sizes: of a minimal private object) */
+template <typename F> struct VideoStub;
+template <typename R, typename... A> struct VideoStub<R(APIENTRY *)(A...)> {
+   static R APIENTRY Call(A...)
+   {
+      if constexpr (std::is_void_v<R>) {
+         return;
+      } else if constexpr (std::is_same_v<R, HRESULT>) {
+         return E_NOTIMPL;
+      } else {
+         return R(16);
+      }
+   }
+};
