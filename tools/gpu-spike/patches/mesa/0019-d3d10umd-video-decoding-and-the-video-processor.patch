+static bool
+HEVCPicture(VideoDecoder *dec)
+{
+   if (dec->pic_params.size() < sizeof(DXVA_PicParams_HEVC)) {
+      return false;
+   }
+   const DXVA_PicParams_HEVC *pp = (const DXVA_PicParams_HEVC *)dec->pic_params.data();
+   struct pipe_h265_picture_desc *d = &dec->desc.h265;
+   struct pipe_h265_pps *pps = &dec->h265_pps;
+   struct pipe_h265_sps *sps = &dec->h265_sps;
