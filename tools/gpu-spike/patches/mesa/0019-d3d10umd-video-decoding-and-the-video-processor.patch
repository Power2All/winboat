+static void APIENTRY
+GetVideoProcessorCaps(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSORENUM hEnum,
+                      D3D11_1DDI_VIDEO_PROCESSOR_CAPS *pCaps)
+{
+   /* one stream, color conversion (BT.601/709, both ranges) and scaling: no filters, deinterlacing or rate
+    * conversion */
+   memset(pCaps, 0, sizeof *pCaps);
+   pCaps->DeviceCaps = D3D11_1DDI_VIDEO_PROCESSOR_DEVICE_CAPS_YCbCr_MATRIX_CONVERSION |
+                       D3D11_1DDI_VIDEO_PROCESSOR_DEVICE_CAPS_NOMINAL_RANGE;
+   pCaps->RateConversionCapsCount = 1;
+   pCaps->MaxInputStreams = 1;
+   pCaps->MaxStreamStates = 1;
+}
