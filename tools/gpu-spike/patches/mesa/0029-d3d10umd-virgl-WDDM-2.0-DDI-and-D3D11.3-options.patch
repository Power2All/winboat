+   const bool isWDDM2_0 = pCreateData->Interface == D3DWDDM2_0_DDI_INTERFACE_VERSION;
    const bool isWDDM1_3 = pCreateData->Interface == D3DWDDM1_3_DDI_INTERFACE_VERSION;
-   const bool is11_1 = pCreateData->Interface == D3D11_1_DDI_INTERFACE_VERSION || isWDDM1_3;
+   const bool is11_1 = pCreateData->Interface == D3D11_1_DDI_INTERFACE_VERSION || isWDDM1_3 || isWDDM2_0;
    D3D10DDI_DEVICEFUNCS funcs10 = {};
    D3D10DDI_DEVICEFUNCS *pDeviceFuncs = is11_1 ? &funcs10 : pCreateData->pDeviceFuncs;
    pDeviceFuncs->pfnDefaultConstantBufferUpdateSubresourceUP = ResourceUpdateSubResourceUP;
@@ -302,7 +304,9 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
       p10_1DeviceFuncs->pfnResourceConvert = ResourceCopy;
       p10_1DeviceFuncs->pfnResourceConvertRegion = ResourceCopyRegion;
    }
-   if (isWDDM1_3) {
+   if (isWDDM2_0) {
+      FillDeviceFuncsWDDM2_0(pCreateData->pWDDM2_0DeviceFuncs, &funcs10);
+   } else if (isWDDM1_3) {
       FillDeviceFuncsWDDM1_3(pCreateData->pWDDM1_3DeviceFuncs, &funcs10);
    } else if (is11_1) {
       FillDeviceFuncs11_1(pCreateData->p11_1DeviceFuncs, &funcs10);
@@ -330,7 +334,9 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
       _RotateResourceIdentities;
    pCreateData->DXGIBaseDDI.pDXGIDDIBaseFunctions->pfnBlt =
       _Blt;
-   if (isWDDM1_3) {
+   if (isWDDM2_0) {
+      FillDXGIFuncs1_4(pCreateData->DXGIBaseDDI.pDXGIDDIBaseFunctions5);
+   } else if (isWDDM1_3) {
       /* The WDDM 1.3 DDI comes with DXGI 1.3's table, the 11.1 one with DXGI 1.2's (the 1.0 entries above are
        * their first ones) */
       FillDXGIFuncs1_3(pCreateData->DXGIBaseDDI.pDXGIDDIBaseFunctions4);
diff --git a/src/gallium/frontends/d3d10umd/ShaderParse.h b/src/gallium/frontends/d3d10umd/ShaderParse.h
index 123f09f..36639d7 100644
--- a/src/gallium/frontends/d3d10umd/ShaderParse.h
+++ b/src/gallium/frontends/d3d10umd/ShaderParse.h
@@ -36,6 +36,9 @@
 #include "DriverIncludes.h"
