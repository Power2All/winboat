+/* SetStreamColorSpace1: the DXGI color space as the 11.1 one (matrix and range); BT.2020 is converted as BT.709
+ * (ponytail: the compositor has no BT.2020 matrix; HDR isn't offered) */
+static void APIENTRY
+VideoProcessorSetStreamColorSpace1(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSOR hProcessor, UINT Stream,
+                                   D3DDDI_COLOR_SPACE_TYPE ColorSpace)
+{
+   D3D11_1DDI_VIDEO_PROCESSOR_COLOR_SPACE cs = {};
+   cs.YCbCr_Matrix = !(ColorSpace == D3DDDI_COLOR_SPACE_YCBCR_FULL_G22_NONE_P709_X601 ||
+                       ColorSpace == D3DDDI_COLOR_SPACE_YCBCR_STUDIO_G22_LEFT_P601 ||
+                       ColorSpace == D3DDDI_COLOR_SPACE_YCBCR_FULL_G22_LEFT_P601);
+   bool full = ColorSpace == D3DDDI_COLOR_SPACE_YCBCR_FULL_G22_NONE_P709_X601 ||
+               ColorSpace == D3DDDI_COLOR_SPACE_YCBCR_FULL_G22_LEFT_P601 ||
+               ColorSpace == D3DDDI_COLOR_SPACE_YCBCR_FULL_G22_LEFT_P709 ||
+               ColorSpace == D3DDDI_COLOR_SPACE_YCBCR_FULL_G22_LEFT_P2020 ||
+               ColorSpace == D3DDDI_COLOR_SPACE_YCBCR_FULL_GHLG_TOPLEFT_P2020;
+   cs.Nominal_Range = full ? 2 : 1;
+   VideoProcessorSetStreamColorSpace(hDevice, hProcessor, Stream, &cs);
+}
