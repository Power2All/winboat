+/* WDDM 2.0 (the DDI the 11.3 features come with): SubmitDecoderBuffers1 (no encryption: the same buffers) */
+static HRESULT APIENTRY
+VideoDecoderSubmitBuffers1(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HDECODE hDecoder, UINT BufferCount,
+                           const D3DWDDM2_0DDI_VIDEO_DECODER_BUFFER_DESC1 *pBufferDesc)
+{
+   std::vector<D3D11_1DDI_VIDEO_DECODER_BUFFER_DESC> desc(BufferCount);
+   for (UINT i = 0; i < BufferCount; i++) {
+      desc[i].hResource = pBufferDesc[i].hResource;
+      desc[i].BufferType = pBufferDesc[i].BufferType;
+      desc[i].DataOffset = pBufferDesc[i].DataOffset;
+      desc[i].DataSize = pBufferDesc[i].DataSize;
+   }
+   return VideoDecoderSubmitBuffers(hDevice, hDecoder, BufferCount, desc.data());
+}
+
+/* No decoder downsampling */
+static void APIENTRY
+QueryVideoCapabilities(D3D10DDI_HDEVICE hDevice, D3DWDDM2_0DDI_VIDEO_CAPABILITY_QUERY QueryType, UINT DataSize,
+                       void *pData)
+{
+   if (QueryType == D3DWDDM2_0DDI_VIDEO_CAPABILITY_QUERY_DECODER_DOWNSAMPLING &&
+       DataSize >= sizeof(D3DWDDM2_0DDI_VIDEO_CAPABILITY_DECODER_DOWNSAMPLING)) {
+      static_cast<D3DWDDM2_0DDI_VIDEO_CAPABILITY_DECODER_DOWNSAMPLING *>(pData)->Supported = FALSE;
+   } else if (QueryType == D3DWDDM2_0DDI_VIDEO_CAPABILITY_QUERY_DECODER_DOWNSAMPLE_OUTPUT_FORMAT &&
+              DataSize >= sizeof(D3DWDDM2_0DDI_VIDEO_CAPABILITY_DECODER_DOWNSAMPLE_OUTPUT_FORMAT)) {
+      static_cast<D3DWDDM2_0DDI_VIDEO_CAPABILITY_DECODER_DOWNSAMPLE_OUTPUT_FORMAT *>(pData)->Supported = FALSE;
+   }
+}
+
+/* DXGI color spaces (DXGI_COLOR_SPACE_TYPE): HDR ones (PQ, HLG) aren't converted */
+static bool
+HdrColorSpace(D3DDDI_COLOR_SPACE_TYPE c)
+{
+   return c == D3DDDI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020 || c == D3DDDI_COLOR_SPACE_YCBCR_STUDIO_G2084_LEFT_P2020 ||
+          c == D3DDDI_COLOR_SPACE_RGB_STUDIO_G2084_NONE_P2020 || c == D3DDDI_COLOR_SPACE_YCBCR_STUDIO_G2084_TOPLEFT_P2020 ||
+          c == D3DDDI_COLOR_SPACE_YCBCR_STUDIO_GHLG_TOPLEFT_P2020 || c == D3DDDI_COLOR_SPACE_YCBCR_FULL_GHLG_TOPLEFT_P2020;
+}
+
+static void APIENTRY
+CheckVideoProcessorFormatConversion(D3D10DDI_HDEVICE hDevice, D3D11_1DDI_HVIDEOPROCESSORENUM hEnum,
+                                    D3DWDDM2_0DDI_CHECK_VIDEO_PROCESSOR_FORMAT_CONVERSION *pConversion)
+{
+   UINT in = 0, out = 0;
+   CheckVideoProcessorFormat(hDevice, hEnum, pConversion->InputFormat, &in);
+   CheckVideoProcessorFormat(hDevice, hEnum, pConversion->OutputFormat, &out);
+   pConversion->Supported = (in & D3D11_1DDI_VIDEO_PROCESSOR_FORMAT_SUPPORT_INPUT) &&
+                            (out & D3D11_1DDI_VIDEO_PROCESSOR_FORMAT_SUPPORT_OUTPUT) &&
+                            !HdrColorSpace(pConversion->InputColorSpace) && !HdrColorSpace(pConversion->OutputColorSpace);
+}
