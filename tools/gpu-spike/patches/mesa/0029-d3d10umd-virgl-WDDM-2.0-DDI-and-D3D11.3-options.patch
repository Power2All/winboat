+/*
+ * WDDM 2.0, the DDI the 11.3 options come with (the runtime reads them from no earlier one): its table is the WDDM 1.3
+ * one with longer arguments in seven places, each the 1.3 argument with fields after it (plane slices of views,
+ * conservative rasterization, a query's context type), and four more entries
+ */
+static BOOL APIENTRY
+FlushWDDM2_0(D3D10DDI_HDEVICE hDevice, UINT ContextType, UINT FlushFlags)
+{
+   return Flush1(hDevice, FlushFlags);
+}
+
+static void APIENTRY
+RelocateDeviceFuncsWDDM2_0(D3D10DDI_HDEVICE hDevice, struct D3DWDDM2_0DDI_DEVICEFUNCS *pDeviceFunctions)
+{
+}
+
+/* Views: the plane slice of a 2D view follows from its format (the video formats' planes: Video.cpp), as before */
+static SIZE_T APIENTRY
+CalcPrivateShaderResourceViewSizeWDDM2_0(D3D10DDI_HDEVICE hDevice, const D3DWDDM2_0DDIARG_CREATESHADERRESOURCEVIEW *pView)
+{
+   return CalcPrivateShaderResourceViewSize11(hDevice, reinterpret_cast<const D3D11DDIARG_CREATESHADERRESOURCEVIEW *>(pView));
+}
+
+static void APIENTRY
+CreateShaderResourceViewWDDM2_0(D3D10DDI_HDEVICE hDevice, const D3DWDDM2_0DDIARG_CREATESHADERRESOURCEVIEW *pView,
+                                D3D10DDI_HSHADERRESOURCEVIEW hView, D3D10DDI_HRTSHADERRESOURCEVIEW hRTView)
+{
+   CreateShaderResourceView11(hDevice, reinterpret_cast<const D3D11DDIARG_CREATESHADERRESOURCEVIEW *>(pView), hView,
+                              hRTView);
+}
+
+static SIZE_T APIENTRY
+CalcPrivateRenderTargetViewSizeWDDM2_0(D3D10DDI_HDEVICE hDevice, const D3DWDDM2_0DDIARG_CREATERENDERTARGETVIEW *pView)
+{
+   return funcs10.pfnCalcPrivateRenderTargetViewSize(hDevice, reinterpret_cast<const D3D10DDIARG_CREATERENDERTARGETVIEW *>(pView));
+}
+
+static void APIENTRY
+CreateRenderTargetViewWDDM2_0(D3D10DDI_HDEVICE hDevice, const D3DWDDM2_0DDIARG_CREATERENDERTARGETVIEW *pView,
+                              D3D10DDI_HRENDERTARGETVIEW hView, D3D10DDI_HRTRENDERTARGETVIEW hRTView)
+{
+   funcs10.pfnCreateRenderTargetView(hDevice, reinterpret_cast<const D3D10DDIARG_CREATERENDERTARGETVIEW *>(pView), hView,
+                                     hRTView);
+}
+
+static SIZE_T APIENTRY
+CalcPrivateUnorderedAccessViewSizeWDDM2_0(D3D10DDI_HDEVICE hDevice, const D3DWDDM2_0DDIARG_CREATEUNORDEREDACCESSVIEW *pView)
+{
+   return CalcPrivateUnorderedAccessViewSize(hDevice, reinterpret_cast<const D3D11DDIARG_CREATEUNORDEREDACCESSVIEW *>(pView));
+}
+
+static void APIENTRY
+CreateUnorderedAccessViewWDDM2_0(D3D10DDI_HDEVICE hDevice, const D3DWDDM2_0DDIARG_CREATEUNORDEREDACCESSVIEW *pView,
+                                 D3D11DDI_HUNORDEREDACCESSVIEW hView, D3D11DDI_HRTUNORDEREDACCESSVIEW hRTView)
+{
+   CreateUnorderedAccessView(hDevice, reinterpret_cast<const D3D11DDIARG_CREATEUNORDEREDACCESSVIEW *>(pView), hView,
+                             hRTView);
+}
+
+/* Rasterizer states: no conservative rasterization (tier 0) */
+static SIZE_T APIENTRY
+CalcPrivateRasterizerStateSizeWDDM2_0(D3D10DDI_HDEVICE hDevice, const D3DWDDM2_0DDI_RASTERIZER_DESC *pDesc)
+{
+   return CalcPrivateRasterizerStateSize11_1(hDevice, reinterpret_cast<const D3D11_1_DDI_RASTERIZER_DESC *>(pDesc));
+}
+
+static void APIENTRY
+CreateRasterizerStateWDDM2_0(D3D10DDI_HDEVICE hDevice, const D3DWDDM2_0DDI_RASTERIZER_DESC *pDesc,
+                             D3D10DDI_HRASTERIZERSTATE hState, D3D10DDI_HRTRASTERIZERSTATE hRTState)
+{
+   CreateRasterizerState11_1(hDevice, reinterpret_cast<const D3D11_1_DDI_RASTERIZER_DESC *>(pDesc), hState, hRTState);
+}
+
+/* Queries: the context type (3D, compute, copy, video) changes nothing here */
+static SIZE_T APIENTRY
+CalcPrivateQuerySizeWDDM2_0(D3D10DDI_HDEVICE hDevice, const D3DWDDM2_0DDIARG_CREATEQUERY *pCreateQuery)
+{
+   return funcs10.pfnCalcPrivateQuerySize(hDevice, reinterpret_cast<const D3D10DDIARG_CREATEQUERY *>(pCreateQuery));
+}
+
+static void APIENTRY
+CreateQueryWDDM2_0(D3D10DDI_HDEVICE hDevice, const D3DWDDM2_0DDIARG_CREATEQUERY *pCreateQuery, D3D10DDI_HQUERY hQuery,
+                   D3D10DDI_HRTQUERY hRTQuery)
+{
+   funcs10.pfnCreateQuery(hDevice, reinterpret_cast<const D3D10DDIARG_CREATEQUERY *>(pCreateQuery), hQuery, hRTQuery);
+}
+
+/* Map on default textures (11.3: the runtime offers it on this DDI): the runtime writes and reads the texture's
+ * allocation itself (WriteToSubresource, ReadFromSubresource), at the offsets and pitches of the guest storage
+ * virgl transfers to and from the host, row by row */
+static void APIENTRY
+GetResourceLayoutWDDM2_0(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hResource, UINT SubresourceCount,
+                         D3DKMT_HANDLE *phAllocation, D3DWDDM2_0DDI_TEXTURE_LAYOUT *pLayout,
+                         UINT *pMipLevelSwizzleTransition, D3DWDDM2_0DDI_SUBRESOURCE_LAYOUT *pSubresourceLayouts)
+{
+   struct pipe_screen *screen = CastDevice(hDevice)->screen;
+   struct pipe_resource *res = CastResource(hResource)->resource;
+   struct winsys_handle handle = {};
+   handle.type = WINSYS_HANDLE_TYPE_D3DKMT_ALLOC;
+   *phAllocation = screen->resource_get_handle(screen, NULL, res, &handle, 0) ? (D3DKMT_HANDLE)(uintptr_t)handle.handle : 0;
+   *pLayout = D3DWDDM2_0DDI_TL_ROW_MAJOR;
+   *pMipLevelSwizzleTransition = 0;
+   unsigned mips = res->last_level + 1;
+   for (UINT i = 0; pSubresourceLayouts && i < SubresourceCount; i++) {
+      D3DWDDM2_0DDI_SUBRESOURCE_LAYOUT &l = pSubresourceLayouts[i];
+      uint64_t offset = 0, stride = 0, layer_stride = 0;
+      screen->resource_get_param(screen, NULL, res, 0, i / mips, i % mips, PIPE_RESOURCE_PARAM_OFFSET, 0, &offset);
+      screen->resource_get_param(screen, NULL, res, 0, i / mips, i % mips, PIPE_RESOURCE_PARAM_STRIDE, 0, &stride);
+      screen->resource_get_param(screen, NULL, res, 0, i / mips, i % mips, PIPE_RESOURCE_PARAM_LAYER_STRIDE, 0,
+                                 &layer_stride);
+      memset(&l, 0, sizeof l);
+      l.BaseOffset = offset;
+      l.RowPitch = stride;
+      l.DepthPitch = layer_stride;
+   }
+}
+
+void
+FillDeviceFuncsWDDM2_0(D3DWDDM2_0DDI_DEVICEFUNCS *pFuncs, const D3D10DDI_DEVICEFUNCS *pFuncs10)
+{
+   static_assert(offsetof(D3DWDDM2_0DDI_DEVICEFUNCS, pfnSetHardwareProtection) == sizeof(D3DWDDM1_3DDI_DEVICEFUNCS),
+                 "the WDDM 2.0 table begins with the 1.3 one");
+   FillDeviceFuncsWDDM1_3(reinterpret_cast<D3DWDDM1_3DDI_DEVICEFUNCS *>(pFuncs), pFuncs10);
+   pFuncs->pfnFlush = FlushWDDM2_0;
+   pFuncs->pfnRelocateDeviceFuncs = RelocateDeviceFuncsWDDM2_0;
+   pFuncs->pfnCalcPrivateShaderResourceViewSize = CalcPrivateShaderResourceViewSizeWDDM2_0;
+   pFuncs->pfnCreateShaderResourceView = CreateShaderResourceViewWDDM2_0;
+   pFuncs->pfnCalcPrivateRenderTargetViewSize = CalcPrivateRenderTargetViewSizeWDDM2_0;
+   pFuncs->pfnCreateRenderTargetView = CreateRenderTargetViewWDDM2_0;
+   pFuncs->pfnCalcPrivateRasterizerStateSize = CalcPrivateRasterizerStateSizeWDDM2_0;
+   pFuncs->pfnCreateRasterizerState = CreateRasterizerStateWDDM2_0;
+   pFuncs->pfnCalcPrivateQuerySize = CalcPrivateQuerySizeWDDM2_0;
+   pFuncs->pfnCreateQuery = CreateQueryWDDM2_0;
+   pFuncs->pfnCalcPrivateUnorderedAccessViewSize = CalcPrivateUnorderedAccessViewSizeWDDM2_0;
+   pFuncs->pfnCreateUnorderedAccessView = CreateUnorderedAccessViewWDDM2_0;
+   /* no hardware content protection, standard swizzle or shader comments */
+   STUB(pfnSetHardwareProtection);
+   pFuncs->pfnGetResourceLayout = GetResourceLayoutWDDM2_0;
+   STUB(pfnRetrieveShaderComment);
+   STUB(pfnSetHardwareProtectionState);
+}
+
+
 /* DXGI 1.2: blits with rectangles (DxgiFns.cpp), offering memory back (nothing to give) */
 static HRESULT APIENTRY
 OfferResources(DXGI_DDI_ARG_OFFERRESOURCES *pOffer)
@@ -909,3 +1054,25 @@ FillDXGIFuncs1_3(DXGI1_3_DDI_BASE_FUNCTIONS *pFuncs)
    pFuncs->pfnPresent1 = Present1;
    pFuncs->pfnCheckPresentDurationSupport = CheckPresentDurationSupport;
 }
+
+/* DXGI 1.4 (with WDDM 2.0): residency trimming (these drivers keep what they made resident), no overlay planes */
+static HRESULT APIENTRY
+TrimResidencySet(DXGI_DDI_ARG_TRIMRESIDENCYSET *pTrim)
+{
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+CheckMultiplaneOverlayColorSpaceSupport(DXGI_DDI_ARG_CHECKMULTIPLANEOVERLAYCOLORSPACESUPPORT *pCheck)
+{
+   pCheck->Supported = FALSE;
+   return S_OK;
+}
+
+void
+FillDXGIFuncs1_4(DXGI1_4_DDI_BASE_FUNCTIONS *pFuncs)
+{
+   FillDXGIFuncs1_3(reinterpret_cast<DXGI1_3_DDI_BASE_FUNCTIONS *>(pFuncs));
+   pFuncs->pfnTrimResidencySet = TrimResidencySet;
+   pFuncs->pfnCheckMultiplaneOverlayColorSpaceSupport = CheckMultiplaneOverlayColorSpaceSupport;
+}
