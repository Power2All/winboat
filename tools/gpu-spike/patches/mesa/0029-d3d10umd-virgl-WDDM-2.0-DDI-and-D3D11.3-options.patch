    case D3D11_1_DDI_INTERFACE_VERSION:
    case D3DWDDM1_3_DDI_INTERFACE_VERSION:
+   case D3DWDDM2_0_DDI_INTERFACE_VERSION:
       break;
    default:
       DebugPrintf("%s: unsupported interface version 0x%08x\n",
@@ -185,8 +186,9 @@ CreateDevice(D3D10DDI_HADAPTER hAdapter,                 // IN
    /*
     * Fill in the D3D10 DDI functions (for the 11.1 DDI a copy, which D3D11_1.cpp builds its table from)
