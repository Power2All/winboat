@@ -358,7 +363,11 @@ GetCaps(D3D10DDI_HADAPTER hAdapter,
       if (pData->DataSize >= sizeof(D3D11DDI_SHADER_CAPS) && HostSupportsFL11()) {
          static_cast<D3D11DDI_SHADER_CAPS *>(pData->pData)->Caps =
             D3D11DDICAPS_SHADER_COMPUTE_PLUS_RAW_AND_STRUCTURED_BUFFERS_IN_SHADER_4_X |
-            (HostSupportsDoubles() ? D3D11DDICAPS_SHADER_DOUBLES : 0);
+            (HostSupportsDoubles() ? D3D11DDICAPS_SHADER_DOUBLES : 0) |
+            /* 11.3: oStencilRef (GL_ARB_shader_stencil_export); typed UAV loads beyond R32 (GLSL image loads take
+             * any image format: shader variants declare the bound view's) */
+            (host_caps.v1.bset.shader_stencil_export ? D3D11DDICAPS_SHADER_SPECIFIED_STENCIL_REF : 0) |
+            D3D11DDICAPS_SHADER_TYPED_UAV_LOAD_ADDITIONAL_FORMATS;
       }
       break;
    case D3D11DDICAPS_3DPIPELINESUPPORT:
@@ -378,6 +387,24 @@ GetCaps(D3D10DDI_HADAPTER hAdapter,
          static_cast<D3D11_1DDI_D3D11_OPTIONS_DATA *>(pData->pData)->OutputMergerLogicOp = TRUE;
       }
       break;
+   case D3DWDDM2_0DDICAPS_GPUVA_CAPS:
+      /* WDDM 2.0's runtime refuses 0 (D3D11_FEATURE_GPU_VIRTUAL_ADDRESS_SUPPORT reports it); D3D12 on vkd3d-proton
+       * reports 40 */
+      if (pData->DataSize >= sizeof(D3DWDDM2_0DDI_GPUVA_CAPS_DATA)) {
+         static_cast<D3DWDDM2_0DDI_GPUVA_CAPS_DATA *>(pData->pData)->MaxGPUVirtualAddressBitsPerResource = 40;
+      }
+      break;
+   case D3DWDDM2_0DDICAPS_D3D11_OPTIONS3: {
+      /* 11.3: SV_RenderTargetArrayIndex/SV_ViewportArrayIndex from vertex and domain shaders too (GL_AMD_vertex_shader_layer
+       * and _viewport_index; the domain shader's through WinBoat's virglrenderer patch, GL_ARB_shader_viewport_layer_array) */
+      const unsigned layer_bits = VIRGL_CAP_V2_VS_VERTEX_LAYER | VIRGL_CAP_V2_VS_VIEWPORT_INDEX |
+                                  VIRGL_CAP_V2_TES_LAYER_VIEWPORT;
+      if (pData->DataSize >= sizeof(D3DWDDM2_0DDI_D3D11_OPTIONS3_DATA) && HostSupportsFL11() &&
+          (host_caps.v2.capability_bits_v2 & layer_bits) == layer_bits) {
+         static_cast<D3DWDDM2_0DDI_D3D11_OPTIONS3_DATA *>(pData->pData)->VPAndRTArrayIndexFromAnyShaderFeedingRasterizer = TRUE;
+      }
+      break;
+   }
    default:
       /* No threading caps (the runtime emulates deferred contexts), no debug binaries */
       break;
