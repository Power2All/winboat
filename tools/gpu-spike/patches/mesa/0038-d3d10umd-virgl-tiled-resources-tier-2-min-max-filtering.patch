+/*
+ * Tiled resources' tier 2 instructions: the feedback variants of sample, gather and load (a status after the
+ * result, sample_*_cl a minimum LOD) and check_access_fully_mapped. Each becomes its base instruction, with a SPARSE
+ * before its texture instruction: the host (WinBoat's virglrenderer 0023) clamps that lookup's LOD and writes its
+ * residency, 1 or 0, into a temporary, which the status gets. Loads from UAVs and buffers have no residency in GL:
+ * resident (ponytail: tiled buffers' unmapped tiles read 0 anyway). The status is only ever read through
+ * check_access_fully_mapped, which compares it with 0. False: not one of them
+ */
+static bool
+translate_feedback(struct Shader_xlate *sx, struct Shader_opcode *opcode)
+{
+   struct ureg_program *ureg = sx->ureg;
+   unsigned base;
+   int clamp = -1;
+   bool texture = true;
+
+   switch (opcode->type) {
+   case D3DWDDM1_3_SB_OPCODE_CHECK_ACCESS_FULLY_MAPPED:
+      if (opcode->dst[0].base.type != D3D10_SB_OPERAND_TYPE_NULL) {
+         ureg_USNE(ureg, translate_dst_operand(sx, &opcode->dst[0], false),
+                   translate_src_operand(sx, &opcode->src[0], OF_UINT), ureg_imm1u(ureg, 0));
+      }
+      return true;
+   case D3DWDDM1_3_SB_OPCODE_SAMPLE_CLAMP_FEEDBACK: base = D3D10_SB_OPCODE_SAMPLE; clamp = 3; break;
+   case D3DWDDM1_3_SB_OPCODE_SAMPLE_B_CLAMP_FEEDBACK: base = D3D10_SB_OPCODE_SAMPLE_B; clamp = 4; break;
+   case D3DWDDM1_3_SB_OPCODE_SAMPLE_C_CLAMP_FEEDBACK: base = D3D10_SB_OPCODE_SAMPLE_C; clamp = 4; break;
+   case D3DWDDM1_3_SB_OPCODE_SAMPLE_D_CLAMP_FEEDBACK: base = D3D10_SB_OPCODE_SAMPLE_D; clamp = 5; break;
+   case D3DWDDM1_3_SB_OPCODE_SAMPLE_L_FEEDBACK: base = D3D10_SB_OPCODE_SAMPLE_L; break;
+   case D3DWDDM1_3_SB_OPCODE_SAMPLE_C_LZ_FEEDBACK: base = D3D10_SB_OPCODE_SAMPLE_C_LZ; break;
+   case D3DWDDM1_3_SB_OPCODE_LD_FEEDBACK: base = D3D10_SB_OPCODE_LD; break;
+   case D3DWDDM1_3_SB_OPCODE_LD_MS_FEEDBACK: base = D3D10_SB_OPCODE_LD_MS; break;
+   case D3DWDDM1_3_SB_OPCODE_GATHER4_FEEDBACK: base = D3D10_1_SB_OPCODE_GATHER4; break;
+   case D3DWDDM1_3_SB_OPCODE_GATHER4_C_FEEDBACK: base = D3D11_SB_OPCODE_GATHER4_C; break;
+   case D3DWDDM1_3_SB_OPCODE_GATHER4_PO_FEEDBACK: base = D3D11_SB_OPCODE_GATHER4_PO; break;
+   case D3DWDDM1_3_SB_OPCODE_GATHER4_PO_C_FEEDBACK: base = D3D11_SB_OPCODE_GATHER4_PO_C; break;
+   case D3DWDDM1_3_SB_OPCODE_LD_UAV_TYPED_FEEDBACK: base = D3D11_SB_OPCODE_LD_UAV_TYPED; texture = false; break;
+   case D3DWDDM1_3_SB_OPCODE_LD_RAW_FEEDBACK: base = D3D11_SB_OPCODE_LD_RAW; texture = false; break;
+   case D3DWDDM1_3_SB_OPCODE_LD_STRUCTURED_FEEDBACK: base = D3D11_SB_OPCODE_LD_STRUCTURED; texture = false; break;
+   default:
+      return false;
+   }
+
+   struct ureg_dst status = ureg_writemask(ureg_DECL_temporary(ureg), TGSI_WRITEMASK_X);
+   if (texture) {
+      struct ureg_src value = clamp >= 0 ? ureg_scalar(translate_src_operand(sx, &opcode->src[clamp], OF_FLOAT), TGSI_SWIZZLE_X)
+                                         : ureg_imm1f(ureg, -1000.0f);
+      ureg_insn(ureg, TGSI_OPCODE_SPARSE, &status, 1, &value, 1, 0);
+   } else {
+      ureg_MOV(ureg, status, ureg_imm1u(ureg, 1));
+   }
+
+   struct Shader_opcode b = *opcode;
+   b.type = (D3D10_SB_OPCODE_TYPE)base;
+   b.num_dst = 1;
+   if (clamp >= 0) {
+      b.num_src = clamp;
+   }
