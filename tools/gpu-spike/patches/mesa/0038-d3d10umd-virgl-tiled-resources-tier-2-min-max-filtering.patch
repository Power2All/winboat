+   if (viewType == D3D10DDI_HT_DEPTHSTENCILVIEW && hView) {
+      /* depth-only formats (11.2, with tiled resources' tier 1): the depth Color[0], in the rectangles */
+      struct pipe_context *pipe = CastDevice(hDevice)->pipe;
