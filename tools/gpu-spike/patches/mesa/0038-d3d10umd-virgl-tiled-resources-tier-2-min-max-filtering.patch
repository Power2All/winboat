+      if (pData->DataSize >= sizeof(D3DWDDM1_3DDI_D3D11_OPTIONS_DATA1) && HostSupportsFL11() &&
+          (host_caps.v2.capability_bits_v2 & VIRGL_CAP_V2_TILED)) {
+         static_cast<D3DWDDM1_3DDI_D3D11_OPTIONS_DATA1 *>(pData->pData)->TiledResourcesSupportFlags =
+            D3DWDDM1_3DDI_TILED_RESOURCES_TIER_1_SUPPORTED |
+            ((host_caps.v2.capability_bits_v2 & tier2) == tier2 ? D3DWDDM1_3DDI_TILED_RESOURCES_TIER_2_SUPPORTED : 0);
+      }
+      break;
+   }
    case D3DWDDM2_0DDICAPS_D3D11_OPTIONS2:
       /* 11.3: conservative rasterization, tier 1 (GL_NV_conservative_raster: WinBoat's virglrenderer patch,
        * VIRGL_CAP_V2_CONSERVATIVE_RASTER; tier 2's 1/256 pixel uncertainty and tier 3's inner coverage aren't
