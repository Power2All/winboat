+   }
+
+   if (opcode->dst[1].base.type != D3D10_SB_OPERAND_TYPE_NULL) {
+      ureg_MOV(ureg, translate_dst_operand(sx, &opcode->dst[1], false), ureg_scalar(ureg_src(status), TGSI_SWIZZLE_X));
+   }
+   ureg_release_temporary(ureg, ureg_writemask(status, TGSI_WRITEMASK_XYZW));
+   return true;
+}
