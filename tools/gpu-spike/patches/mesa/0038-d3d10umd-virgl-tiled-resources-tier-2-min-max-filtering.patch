diff --git a/src/gallium/frontends/d3d10umd/Tiled.cpp b/src/gallium/frontends/d3d10umd/Tiled.cpp
new file mode 100644
index 0000000..20546e7
--- /dev/null
+++ b/src/gallium/frontends/d3d10umd/Tiled.cpp
@@ -0,0 +1,587 @@
+/*
+ * Tiled.cpp --
+ *    Direct3D 11.2's tiled resources (tier 1) on virgl's sparse resources (WinBoat's virglrenderer 0021,
+ *    VIRGL_CAP_V2_TILED). A tiled resource is sparse storage on the host whose 64 KB tiles are bound to tile pool
+ *    memory there (pipe_context::tile_map); the same pool tile under several resources is D3D's aliasing, as it is on
+ *    the host. A tile pool is memory only, in chunks: ResizeTilePool adds one (the tiles it had stay where they are)
+ *    or drops whole chunks past the new size.
+ *
+ *    Tiles have D3D's standard shapes (the host's sparse pages have them, which it checks). Mips smaller than a tile
+ *    in either dimension are packed: the host binds them (its mip tail) as one, so a slice's packed mips take one
+ *    tile when they fit in 64 KB (ponytail: a tail of more than a tile, from very narrow textures, gets the count
+ *    but binds at its first tile's offset only). Tiles are numbered as D3D's GetResourceTiling numbers them: by array
+ *    slice, its standard mips row by row, then its packed tiles. Every tile's mapping is kept (CopyTileMappings
+ *    copies them; each holds a reference to its pool chunk).
+ *
+ *    Tiled textures have no guest storage: they transfer through staging buffers (UpdateTiles, CopyTiles). Tiled
+ *    buffers and pools take GPU copies only.
+ */
+
+#include "Tiled.h"
+#include "State.h"
+
+#include "util/format/u_format.h"
+#include "util/u_inlines.h"
+#include "util/u_math.h"
+
+#include <vector>
+
+static const UINT TILE_BYTES = 65536;
+
+struct TileMapping {
+   struct pipe_resource *chunk; /* referenced; NULL: unmapped */
+   UINT64 offset;
+};
+
+struct TiledInfo {
+   /* a pool: its chunks and how many tiles each has */
+   bool pool;
+   std::vector<struct pipe_resource *> chunks;
+   std::vector<UINT> chunkTiles;
+   UINT64 poolSize;
+
+   /* a tiled resource: tile shape in texels (buffers: 64 KB of bytes), mips that have whole tiles and the packed
+    * ones, each slice's tiles, every tile's mapping */
+   UINT tileWidth, tileHeight;
+   UINT standardMips, packedMips, packedTiles;
+   UINT slices, mips;
+   std::vector<UINT> start;   /* first tile of each slice's mips (slice * mips + mip), then the packed tiles */
+   UINT sliceTiles;
+   std::vector<TileMapping> map;
+};
+
+bool
+TiledSupported(struct pipe_context *pipe)
+{
+   return pipe->tile_map != NULL;
+}
+
+/* D3D's standard 2D tile shapes, by the size of a format's element (a block for compressed ones) */
+static bool
+TileShape(enum pipe_format format, UINT *width, UINT *height)
+{
+   const struct util_format_description *desc = util_format_description(format);
+   if (!desc || desc->layout == UTIL_FORMAT_LAYOUT_PLANAR2 || desc->layout == UTIL_FORMAT_LAYOUT_PLANAR3 ||
+       util_format_is_yuv(format)) {
+      return false;
+   }
+   UINT w, h;
+   switch (desc->block.bits) {
+   case 8: w = 256; h = 256; break;
+   case 16: w = 256; h = 128; break;
+   case 32: w = 128; h = 128; break;
+   case 64: w = 128; h = 64; break;
+   case 128: w = 64; h = 64; break;
+   default: return false;
+   }
+   *width = w * desc->block.width;
+   *height = h * desc->block.height;
+   return true;
+}
+
+bool
+TiledFormat(enum pipe_format format)
+{
+   UINT w, h;
+   return TileShape(format, &w, &h);
+}
+
+bool
+TiledTemplate(struct pipe_context *pipe, const D3D10DDIARG_CREATERESOURCE *pCreateResource,
+              struct pipe_resource *templat)
+{
+   const UINT misc = pCreateResource->MiscFlags;
+   if (!(misc & (D3DWDDM1_3DDI_RESOURCE_MISC_TILED | D3DWDDM1_3DDI_RESOURCE_MISC_TILE_POOL))) {
+      return true;
+   }
+   if (!TiledSupported(pipe)) {
+      return false;
+   }
+   if (misc & D3DWDDM1_3DDI_RESOURCE_MISC_TILE_POOL) {
+      templat->flags |= PIPE_RESOURCE_FLAG_TILE_POOL;
+      return templat->target == PIPE_BUFFER;
+   }
+   templat->flags |= PIPE_RESOURCE_FLAG_SPARSE;
+   /* tier 1/2: buffers and 2D textures (arrays too), not multisampled */
+   return templat->target == PIPE_BUFFER ||
+          ((templat->target == PIPE_TEXTURE_2D || templat->target == PIPE_TEXTURE_2D_ARRAY) &&
+           templat->nr_samples <= 1 && TiledFormat(templat->format));
+}
+
+static UINT
+DivRoundUp(UINT a, UINT b)
+{
+   return (a + b - 1) / b;
+}
+
+void
+TiledCreateResource(const D3D10DDIARG_CREATERESOURCE *pCreateResource, Resource *pResource)
+{
+   struct pipe_resource *res = pResource->resource;
+   if (!(res->flags & (PIPE_RESOURCE_FLAG_SPARSE | PIPE_RESOURCE_FLAG_TILE_POOL))) {
+      return;
+   }
+   TiledInfo *t = new TiledInfo();
+   pResource->tiled = t;
+   if (res->flags & PIPE_RESOURCE_FLAG_TILE_POOL) {
+      t->pool = true;
+      pipe_resource *chunk = NULL;
+      pipe_resource_reference(&chunk, res);
+      t->chunks.push_back(chunk);
+      t->chunkTiles.push_back(res->width0 / TILE_BYTES);
+      t->poolSize = res->width0;
+      return;
+   }
+   t->mips = res->target == PIPE_BUFFER ? 1 : res->last_level + 1;
+   t->slices = res->target == PIPE_BUFFER ? 1 : res->array_size;
+   if (res->target == PIPE_BUFFER) {
+      t->tileWidth = TILE_BYTES;
+      t->tileHeight = 1;
+      t->standardMips = 1;
+      t->start.push_back(0);
+      t->sliceTiles = DivRoundUp(res->width0, TILE_BYTES);
+   } else {
+      TileShape(res->format, &t->tileWidth, &t->tileHeight);
+      UINT tail = 0;
+      for (UINT m = 0; m < t->mips; m++) {
+         UINT w = u_minify(res->width0, m), h = u_minify(res->height0, m);
+         if (t->standardMips == m && w >= t->tileWidth && h >= t->tileHeight) {
+            t->standardMips++;
+         } else {
+            tail += util_format_get_2d_size(res->format, util_format_get_stride(res->format, w), h);
+         }
+      }
+      t->packedMips = t->mips - t->standardMips;
+      t->packedTiles = t->packedMips ? DivRoundUp(tail, TILE_BYTES) : 0;
+      UINT n = 0;
+      for (UINT m = 0; m < t->standardMips; m++) {
+         t->start.push_back(n);
+         n += DivRoundUp(u_minify(res->width0, m), t->tileWidth) * DivRoundUp(u_minify(res->height0, m), t->tileHeight);
+      }
+      t->start.push_back(n);   /* the packed tiles */
+      t->sliceTiles = n + t->packedTiles;
+   }
+   t->map.assign((size_t)t->sliceTiles * t->slices, TileMapping{NULL, 0});
+}
+
+void
+TiledDestroyResource(Resource *pResource)
+{
+   TiledInfo *t = pResource->tiled;
+   if (!t) {
+      return;
+   }
+   for (auto &chunk : t->chunks) {
+      pipe_resource_reference(&chunk, NULL);
+   }
+   for (auto &m : t->map) {
+      pipe_resource_reference(&m.chunk, NULL);
+   }
+   delete t;
+   pResource->tiled = NULL;
+}
+
+/* The tiles a region covers, in order: a box of them (slices by Depth for arrays) or NumTiles from its start on */
+static void
+RegionTiles(const TiledInfo *t, struct pipe_resource *res, UINT mipLevels,
+            const D3DWDDM1_3DDI_TILED_RESOURCE_COORDINATE &start, const D3DWDDM1_3DDI_TILE_REGION_SIZE *size,
+            std::vector<long> &tiles)
+{
+   auto across = [&](UINT mip) {
+      return res->target == PIPE_BUFFER ? t->sliceTiles : DivRoundUp(u_minify(res->width0, mip), t->tileWidth);
+   };
+   auto index = [&](const D3DWDDM1_3DDI_TILED_RESOURCE_COORDINATE &c) -> long {
+      UINT mip = c.Subresource % MAX2(mipLevels, 1), slice = c.Subresource / MAX2(mipLevels, 1);
+      if (slice >= t->slices) {
+         return -1;
+      }
+      long base = (long)slice * t->sliceTiles;
+      if (mip >= t->standardMips) {
+         return c.X < t->packedTiles ? base + t->start[t->standardMips] + c.X : -1;
+      }
+      return base + t->start[mip] + (long)c.Y * across(mip) + c.X;
+   };
+   if (!size) {
+      tiles.push_back(index(start));
+      return;
+   }
+   if (!size->bUseBox) {
+      long first = index(start);
+      for (UINT i = 0; i < size->NumTiles; i++) {
+         tiles.push_back(first < 0 || first + i >= (long)t->map.size() ? -1 : first + i);
+      }
+      return;
+   }
+   for (UINT z = 0; z < MAX2(size->Depth, 1); z++) {
+      for (UINT y = 0; y < MAX2(size->Height, 1); y++) {
+         for (UINT x = 0; x < size->Width; x++) {
+            D3DWDDM1_3DDI_TILED_RESOURCE_COORDINATE c = start;
+            c.X += x;
+            c.Y += y;
+            c.Subresource += z * MAX2(mipLevels, 1);   /* (arrays: the next slice's same mip) */
+            tiles.push_back(index(c));
+         }
+      }
+   }
+}
+
+/* A tile's mapping on the host: its region of the resource bound to the chunk at offset (unbound without one).
+ * Packed tiles: the first binds the slice's mip tail, the others have nothing of their own on the host */
+static void
+TileBind(struct pipe_context *pipe, Resource *pResource, long tile, const TileMapping &m)
+{
+   TiledInfo *t = pResource->tiled;
+   struct pipe_resource *res = pResource->resource;
+   UINT slice = (UINT)(tile / t->sliceTiles), local = (UINT)(tile % t->sliceTiles);
+   struct pipe_box box = {};
+   unsigned level = 0;
+   if (res->target == PIPE_BUFFER) {
+      box.x = (int)(local * TILE_BYTES);
+      box.width = TILE_BYTES;
+      box.height = box.depth = 1;
+   } else if (local >= t->start[t->standardMips]) {
+      if (local != t->start[t->standardMips]) {
+         return;
+      }
+      level = t->standardMips;
+      box.z = (int)slice;
+      box.width = (int)u_minify(res->width0, level);
+      box.height = (int)u_minify(res->height0, level);
+      box.depth = 1;
+   } else {
+      while (level + 1 < t->standardMips && local >= t->start[level + 1]) {
+         level++;
+      }
+      UINT across = DivRoundUp(u_minify(res->width0, level), t->tileWidth);
+      UINT i = local - t->start[level];
+      box.x = (int)((i % across) * t->tileWidth);
+      box.y = (int)((i / across) * t->tileHeight);
+      box.z = (int)slice;
+      box.width = (int)t->tileWidth;
+      box.height = (int)t->tileHeight;
+      box.depth = 1;
+   }
+   pipe->tile_map(pipe, res, level, &box, m.chunk, m.offset);
+}
+
+static void
+TileSet(struct pipe_context *pipe, Resource *pResource, long tile, struct pipe_resource *chunk, UINT64 offset)
+{
+   TileMapping &m = pResource->tiled->map[tile];
+   pipe_resource_reference(&m.chunk, chunk);
+   m.offset = offset;
+   TileBind(pipe, pResource, tile, m);
+}
+
+/* A pool's tile: its chunk and the offset in it, or false past the pool's end */
+static bool
+PoolTile(const TiledInfo *pool, UINT tile, struct pipe_resource **chunk, UINT64 *offset)
+{
+   for (size_t c = 0; c < pool->chunks.size(); c++) {
+      if (tile < pool->chunkTiles[c]) {
+         *chunk = pool->chunks[c];
+         *offset = (UINT64)tile * TILE_BYTES;
+         return true;
+      }
+      tile -= pool->chunkTiles[c];
+   }
+   return false;
+}
+
+static VOID APIENTRY
+UpdateTileMappings(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hTiledResource, UINT NumTiledResourceRegions,
+                   const D3DWDDM1_3DDI_TILED_RESOURCE_COORDINATE *pTiledResourceRegionStartCoords,
+                   const D3DWDDM1_3DDI_TILE_REGION_SIZE *pTiledResourceRegionSizes, D3D10DDI_HRESOURCE hTilePool,
+                   UINT NumRanges, const UINT *pRangeFlags, const UINT *pTilePoolStartOffsets,
+                   const UINT *pRangeTileCounts, UINT Flags)
+{
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   Resource *pResource = CastResource(hTiledResource);
+   Resource *pPool = hTilePool.pDrvPrivate ? CastResource(hTilePool) : NULL;
+   TiledInfo *t = pResource->tiled;
+   if (!t || t->pool || (pPool && (!pPool->tiled || !pPool->tiled->pool))) {
+      return;
+   }
+   std::vector<long> tiles;
+   for (UINT r = 0; r < NumTiledResourceRegions; r++) {
+      RegionTiles(t, pResource->resource, pResource->MipLevels, pTiledResourceRegionStartCoords[r],
+                  pTiledResourceRegionSizes ? &pTiledResourceRegionSizes[r] : NULL, tiles);
+   }
+   /* the ranges take the tiles in order; one range without a count takes them all */
+   size_t next = 0;
+   for (UINT r = 0; r < NumRanges && next < tiles.size(); r++) {
+      UINT flags = pRangeFlags ? pRangeFlags[r] : 0;
+      UINT count = pRangeTileCounts ? pRangeTileCounts[r] : (UINT)(tiles.size() - next);
+      UINT first = pTilePoolStartOffsets ? pTilePoolStartOffsets[r] : 0;
+      for (UINT i = 0; i < count && next < tiles.size(); i++, next++) {
+         long tile = tiles[next];
+         if (tile < 0 || (flags & D3DWDDM_1_3DDI_TILE_RANGE_SKIP)) {
+            continue;
+         }
+         struct pipe_resource *chunk = NULL;
+         UINT64 offset = 0;
+         if (!(flags & D3DWDDM_1_3DDI_TILE_RANGE_NULL) && pPool) {
+            UINT poolTile = flags & D3DWDDM_1_3DDI_TILE_RANGE_REUSE_SINGLE_TILE ? first : first + i;
+            if (!PoolTile(pPool->tiled, poolTile, &chunk, &offset)) {
+               chunk = NULL;
+            }
+         }
+         TileSet(pipe, pResource, tile, chunk, offset);
+      }
+   }
+}
+
+static VOID APIENTRY
+CopyTileMappings(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hDestTiledResource,
+                 const D3DWDDM1_3DDI_TILED_RESOURCE_COORDINATE *pDestRegionStartCoord,
+                 D3D10DDI_HRESOURCE hSourceTiledResource,
+                 const D3DWDDM1_3DDI_TILED_RESOURCE_COORDINATE *pSourceRegionStartCoord,
+                 const D3DWDDM1_3DDI_TILE_REGION_SIZE *pTileRegionSize, UINT Flags)
+{
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   Resource *pDst = CastResource(hDestTiledResource), *pSrc = CastResource(hSourceTiledResource);
+   if (!pDst->tiled || !pSrc->tiled || pDst->tiled->pool || pSrc->tiled->pool) {
+      return;
+   }
+   std::vector<long> dst, src;
+   RegionTiles(pDst->tiled, pDst->resource, pDst->MipLevels, *pDestRegionStartCoord, pTileRegionSize, dst);
+   RegionTiles(pSrc->tiled, pSrc->resource, pSrc->MipLevels, *pSourceRegionStartCoord, pTileRegionSize, src);
+   /* (source and destination may overlap: the source's mappings first) */
+   std::vector<TileMapping> from;
+   for (long s : src) {
+      from.push_back(s >= 0 ? pSrc->tiled->map[s] : TileMapping{NULL, 0});
+   }
+   for (size_t i = 0; i < dst.size() && i < from.size(); i++) {
+      if (dst[i] >= 0) {
+         TileSet(pipe, pDst, dst[i], from[i].chunk, from[i].offset);
+      }
+   }
+}
+
+/* A tile's texels: its box at its mip level (clipped to the level), or false for packed tiles */
+static bool
+TileBox(const TiledInfo *t, struct pipe_resource *res, long tile, unsigned *level, struct pipe_box *box)
+{
+   UINT slice = (UINT)(tile / t->sliceTiles), local = (UINT)(tile % t->sliceTiles);
+   if (res->target == PIPE_BUFFER || local >= t->start[t->standardMips]) {
+      return false;
+   }
+   unsigned l = 0;
+   while (l + 1 < t->standardMips && local >= t->start[l + 1]) {
+      l++;
+   }
+   UINT w = u_minify(res->width0, l), h = u_minify(res->height0, l);
+   UINT across = DivRoundUp(w, t->tileWidth), i = local - t->start[l];
+   UINT x = (i % across) * t->tileWidth, y = (i / across) * t->tileHeight;
+   u_box_3d((int)x, (int)y, (int)slice, (int)MIN2(t->tileWidth, w - x), (int)MIN2(t->tileHeight, h - y), 1, box);
+   *level = l;
+   return true;
+}
+
+/* Tile data in the linear layout UpdateTiles and CopyTiles use: each tile 64 KB, its rows of blocks one after the
+ * other (a row: the tile's width in blocks); a slice's packed tiles hold its packed mips one after the other */
+static UINT
+TileRowPitch(const TiledInfo *t, enum pipe_format format)
+{
+   return util_format_get_stride(format, t->tileWidth);
+}
+
+/* Moves one tile between a tiled texture and linear memory (toTiles: memory into the tile) */
+static void
+TileTransfer(struct pipe_context *pipe, Resource *pResource, long tile, uint8_t *data, bool toTiles)
+{
+   TiledInfo *t = pResource->tiled;
+   struct pipe_resource *res = pResource->resource;
+   enum pipe_format format = res->format;
+   UINT slice = (UINT)(tile / t->sliceTiles), local = (UINT)(tile % t->sliceTiles);
+   std::vector<std::pair<unsigned, struct pipe_box>> parts;
+   std::vector<UINT> pitches;
+   unsigned level;
+   struct pipe_box box;
+   if (TileBox(t, res, tile, &level, &box)) {
+      parts.push_back({level, box});
+      pitches.push_back(TileRowPitch(t, format));
+   } else if (local == t->start[t->standardMips]) {
+      /* the packed mips, one after the other (only the first packed tile has them) */
+      for (unsigned m = t->standardMips; m < t->mips; m++) {
+         u_box_3d(0, 0, (int)slice, (int)u_minify(res->width0, m), (int)u_minify(res->height0, m), 1, &box);
+         parts.push_back({m, box});
+         pitches.push_back(util_format_get_stride(format, box.width));
+      }
+   }
+   size_t offset = 0;
+   for (size_t p = 0; p < parts.size(); p++) {
+      const struct pipe_box &b = parts[p].second;
+      UINT rows = util_format_get_nblocksy(format, b.height);
+      if (offset + (size_t)pitches[p] * rows > TILE_BYTES) {
+         break;
+      }
+      if (toTiles) {
+         pipe->texture_subdata(pipe, res, parts[p].first, PIPE_MAP_WRITE, &b, data + offset, pitches[p], 0);
+      } else {
+         struct pipe_transfer *transfer = NULL;
+         const uint8_t *map = (const uint8_t *)pipe->texture_map(pipe, res, parts[p].first, PIPE_MAP_READ, &b, &transfer);
+         if (map) {
+            UINT rowBytes = util_format_get_stride(format, b.width);
+            for (UINT y = 0; y < rows; y++) {
+               memcpy(data + offset + (size_t)y * pitches[p], map + (size_t)y * transfer->stride, rowBytes);
+            }
+            pipe->texture_unmap(pipe, transfer);
+         }
+      }
+      offset += (size_t)pitches[p] * rows;
+   }
+}
+
+/* A tiled buffer's tiles from or into another buffer: GPU copies (neither side has guest storage to map) */
+static void
+BufferTilesCopy(struct pipe_context *pipe, struct pipe_resource *dst, UINT64 dstOffset, struct pipe_resource *src,
+                UINT64 srcOffset, UINT64 size)
+{
+   struct pipe_box box;
+   u_box_1d((int)srcOffset, (int)size, &box);
+   pipe->resource_copy_region(pipe, dst, 0, (unsigned)dstOffset, 0, 0, src, 0, &box);
+}
+
+static VOID APIENTRY
+CopyTiles(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hTiledResource,
+          const D3DWDDM1_3DDI_TILED_RESOURCE_COORDINATE *pTileRegionStartCoord,
+          const D3DWDDM1_3DDI_TILE_REGION_SIZE *pTileRegionSize, D3D10DDI_HRESOURCE hBuffer,
+          UINT64 BufferStartOffsetInBytes, UINT Flags)
+{
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   Resource *pResource = CastResource(hTiledResource), *pBuffer = CastResource(hBuffer);
+   TiledInfo *t = pResource->tiled;
+   if (!t || t->pool || !pBuffer->resource) {
+      return;
+   }
+   bool toTiles = Flags & D3DWDDM1_3DDI_TILE_COPY_LINEAR_BUFFER_TO_SWIZZLED_TILED_RESOURCE;
+   std::vector<long> tiles;
+   RegionTiles(t, pResource->resource, pResource->MipLevels, *pTileRegionStartCoord, pTileRegionSize, tiles);
+   std::vector<uint8_t> data(TILE_BYTES);
+   for (size_t i = 0; i < tiles.size(); i++) {
+      if (tiles[i] < 0) {
+         continue;
+      }
+      UINT64 linear = BufferStartOffsetInBytes + (UINT64)i * TILE_BYTES;
+      if (pResource->resource->target == PIPE_BUFFER) {
+         UINT64 at = (UINT64)(tiles[i] % t->sliceTiles) * TILE_BYTES;
+         UINT64 size = MIN2((UINT64)TILE_BYTES, pResource->resource->width0 - at);
+         if (toTiles) {
+            BufferTilesCopy(pipe, pResource->resource, at, pBuffer->resource, linear, size);
+         } else {
+            BufferTilesCopy(pipe, pBuffer->resource, linear, pResource->resource, at, size);
+         }
+         continue;
+      }
+      if (toTiles) {
+         pipe_buffer_read(pipe, pBuffer->resource, (unsigned)linear, TILE_BYTES, data.data());
+         TileTransfer(pipe, pResource, tiles[i], data.data(), true);
+      } else {
+         memset(data.data(), 0, TILE_BYTES);
+         TileTransfer(pipe, pResource, tiles[i], data.data(), false);
+         pipe->buffer_subdata(pipe, pBuffer->resource, PIPE_MAP_WRITE, (unsigned)linear, TILE_BYTES, data.data());
+      }
+   }
+}
+
+static VOID APIENTRY
+UpdateTiles(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hDestTiledResource,
+            const D3DWDDM1_3DDI_TILED_RESOURCE_COORDINATE *pDestTileRegionStartCoord,
+            const D3DWDDM1_3DDI_TILE_REGION_SIZE *pDestTileRegionSize, const VOID *pSourceTileData, UINT Flags)
+{
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   Resource *pResource = CastResource(hDestTiledResource);
+   TiledInfo *t = pResource->tiled;
+   if (!t || t->pool) {
+      return;
+   }
+   std::vector<long> tiles;
+   RegionTiles(t, pResource->resource, pResource->MipLevels, *pDestTileRegionStartCoord, pDestTileRegionSize, tiles);
+   const uint8_t *src = (const uint8_t *)pSourceTileData;
+   for (size_t i = 0; i < tiles.size(); i++) {
+      if (tiles[i] < 0) {
+         continue;
+      }
+      const uint8_t *tileData = src + i * TILE_BYTES;
+      if (pResource->resource->target == PIPE_BUFFER) {
+         UINT64 at = (UINT64)(tiles[i] % t->sliceTiles) * TILE_BYTES;
+         UINT size = (UINT)MIN2((UINT64)TILE_BYTES, pResource->resource->width0 - at);
+         struct pipe_resource *staging = pipe_buffer_create_with_data(pipe, 0, PIPE_USAGE_STAGING, size, tileData);
+         if (staging) {
+            BufferTilesCopy(pipe, pResource->resource, at, staging, 0, size);
+            pipe_resource_reference(&staging, NULL);
+         }
+      } else {
+         TileTransfer(pipe, pResource, tiles[i], const_cast<uint8_t *>(tileData), true);
+      }
+   }
+}
+
+static VOID APIENTRY
+TiledResourceBarrier(D3D10DDI_HDEVICE hDevice, D3D11DDI_HANDLETYPE BeforeType, VOID *hBefore,
+                     D3D11DDI_HANDLETYPE AfterType, VOID *hAfter)
+{
+   /* one GL context on the host runs everything in order; aliased memory's writes are visible to what follows */
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   if (pipe->memory_barrier) {
+      pipe->memory_barrier(pipe, PIPE_BARRIER_ALL);
+   }
+}
+
+static VOID APIENTRY
+GetMipPacking(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hTiledResource, UINT *pNumPackedMips,
+              UINT *pNumTilesForPackedMips)
+{
+   TiledInfo *t = CastResource(hTiledResource)->tiled;
+   *pNumPackedMips = t && !t->pool ? t->packedMips : 0;
+   *pNumTilesForPackedMips = t && !t->pool ? t->packedTiles : 0;
+}
+
+static VOID APIENTRY
+ResizeTilePool(D3D10DDI_HDEVICE hDevice, D3D10DDI_HRESOURCE hTilePool, UINT64 NewSizeInBytes)
+{
+   struct pipe_context *pipe = CastPipeContext(hDevice);
+   TiledInfo *t = CastResource(hTilePool)->tiled;
+   if (!t || !t->pool) {
+      return;
+   }
+   UINT64 have = 0;
+   for (UINT n : t->chunkTiles) {
+      have += (UINT64)n * TILE_BYTES;
+   }
+   if (NewSizeInBytes > have) {
+      /* a chunk more: the tiles the pool had stay where they are */
+      struct pipe_resource templat = *t->chunks[0];
+      templat.width0 = (unsigned)(NewSizeInBytes - have);
+      templat.next = NULL;
+      struct pipe_resource *chunk = pipe->screen->resource_create(pipe->screen, &templat);
+      if (!chunk) {
+         SetError(hDevice, E_OUTOFMEMORY);
+         return;
+      }
+      t->chunks.push_back(chunk);
+      t->chunkTiles.push_back(templat.width0 / TILE_BYTES);
+   } else {
+      /* chunks entirely past the new size go (mappings into them keep them until they change) */
+      while (t->chunks.size() > 1 && have - (UINT64)t->chunkTiles.back() * TILE_BYTES >= NewSizeInBytes) {
+         have -= (UINT64)t->chunkTiles.back() * TILE_BYTES;
+         pipe_resource_reference(&t->chunks.back(), NULL);
+         t->chunks.pop_back();
+         t->chunkTiles.pop_back();
+      }
+   }
+   t->poolSize = NewSizeInBytes;
+}
+
+void
+FillTiledFuncs(D3DWDDM1_3DDI_DEVICEFUNCS *pFuncs)
+{
+   pFuncs->pfnUpdateTileMappings = UpdateTileMappings;
+   pFuncs->pfnCopyTileMappings = CopyTileMappings;
+   pFuncs->pfnCopyTiles = CopyTiles;
+   pFuncs->pfnUpdateTiles = UpdateTiles;
+   pFuncs->pfnTiledResourceBarrier = TiledResourceBarrier;
+   pFuncs->pfnGetMipPacking = GetMipPacking;
+   pFuncs->pfnResizeTilePool = ResizeTilePool;
+}
