-   if (res->clean_mask & (1 << level))
+   /* (a sparse resource's tiles can change through another resource on the same tile pool memory: D3D's aliasing) */
+   if ((res->clean_mask & (1 << level)) && !(res->b.flags & PIPE_RESOURCE_FLAG_SPARSE))
       return false;
 
    return true;
@@ -686,12 +687,19 @@ static struct pipe_resource *virgl_resource_create_front(struct pipe_screen *scr
       vbind |= VIRGL_BIND_PREFER_EMULATED_BGRA;
    }
 
+   /* D3D tiled resources (VIRGL_CAP_V2_TILED): sparse storage, or a tile pool (memory only). Neither has guest
+    * storage: textures transfer through staging buffers, buffers and pools only take GPU copies and tile_map */
+   bool tiled = (vs->caps.caps.v2.capability_bits_v2 & VIRGL_CAP_V2_TILED) &&
+                (templ->flags & (PIPE_RESOURCE_FLAG_SPARSE | PIPE_RESOURCE_FLAG_TILE_POOL));
+   if (tiled)
+      vbind |= templ->flags & PIPE_RESOURCE_FLAG_TILE_POOL ? VIRGL_BIND_TILE_POOL : VIRGL_BIND_SPARSE;
+
    // If renderer supports copy transfer from host, and we either have support
    // for then for textures alloc minimum size of bo
    // This size is not passed to the host
-   res->use_staging = virgl_can_copy_transfer_from_host(vs, res, vbind);
+   res->use_staging = virgl_can_copy_transfer_from_host(vs, res, vbind) || (tiled && templ->target != PIPE_BUFFER);
 
-   if (res->use_staging)
+   if (res->use_staging || tiled)
       alloc_size = 1;
    else
       alloc_size = res->metadata.total_size;
