 int virgl_encode_set_raster_samples(struct virgl_context *ctx, uint32_t samples);
 int virgl_encode_set_conservative_raster(struct virgl_context *ctx, bool enable);
+int virgl_encode_tile_map(struct virgl_context *ctx, struct virgl_resource *res, unsigned level,
