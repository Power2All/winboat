diff --git a/src/gallium/drivers/virgl/virgl_context.c b/src/gallium/drivers/virgl/virgl_context.c
index 59bceac..31fae0c 100644
--- a/src/gallium/drivers/virgl/virgl_context.c
+++ b/src/gallium/drivers/virgl/virgl_context.c
@@ -471,6 +471,14 @@ static void *virgl_create_rasterizer_state(struct pipe_context *ctx,
    return (void *)vrs;
 }
 
+/* WinBoat: D3D tiled resources' tile mappings (VIRGL_CCMD_TILE_MAP), in the command stream's order */
+static void virgl_tile_map(struct pipe_context *ctx, struct pipe_resource *res, unsigned level,
+                           const struct pipe_box *box, struct pipe_resource *pool, uint64_t offset)
+{
+   struct virgl_context *vctx = virgl_context(ctx);
+   virgl_encode_tile_map(vctx, virgl_resource(res), level, box, pool ? virgl_resource(pool) : NULL, offset);
+}
+
 static void virgl_bind_rasterizer_state(struct pipe_context *ctx,
                                                 void *rs_state)
 {
@@ -1830,6 +1838,9 @@ struct pipe_context *virgl_context_create(struct pipe_screen *pscreen,
    if (rs->caps.caps.v2.host_feature_check_version >= 7)
       vctx->base.link_shader = virgl_link_shader;
 
+   if (rs->caps.caps.v2.capability_bits_v2 & VIRGL_CAP_V2_TILED)
+      vctx->base.tile_map = virgl_tile_map;
+
    virgl_init_context_resource_functions(&vctx->base);
    virgl_init_query_functions(vctx);
    virgl_init_so_functions(vctx);
diff --git a/src/gallium/drivers/virgl/virgl_encode.c b/src/gallium/drivers/virgl/virgl_encode.c
index 760b873..8a5af65 100644
--- a/src/gallium/drivers/virgl/virgl_encode.c
+++ b/src/gallium/drivers/virgl/virgl_encode.c
@@ -551,6 +551,25 @@ int virgl_encode_set_conservative_raster(struct virgl_context *ctx, bool enable)
    return 0;
 }
 
+/* WinBoat: a sparse resource's region bound to a tile pool's memory, or unbound (VIRGL_CAP_V2_TILED) */
+int virgl_encode_tile_map(struct virgl_context *ctx, struct virgl_resource *res, unsigned level,
+                          const struct pipe_box *box, struct virgl_resource *pool, uint64_t offset)
+{
+   virgl_encoder_write_cmd_dword(ctx, VIRGL_CMD0(VIRGL_CCMD_TILE_MAP, 0, VIRGL_TILE_MAP_SIZE));
+   virgl_encoder_write_res(ctx, res);
+   virgl_encoder_write_dword(ctx->cbuf, level);
+   virgl_encoder_write_dword(ctx->cbuf, box->x);
+   virgl_encoder_write_dword(ctx->cbuf, box->y);
+   virgl_encoder_write_dword(ctx->cbuf, box->z);
+   virgl_encoder_write_dword(ctx->cbuf, box->width);
+   virgl_encoder_write_dword(ctx->cbuf, box->height);
+   virgl_encoder_write_dword(ctx->cbuf, box->depth);
+   virgl_encoder_write_res(ctx, pool);
+   virgl_encoder_write_dword(ctx->cbuf, (uint32_t)offset);
+   virgl_encoder_write_dword(ctx->cbuf, (uint32_t)(offset >> 32));
+   return 0;
+}
+
 int virgl_encode_delete_object(struct virgl_context *ctx,
                               uint32_t handle, uint32_t object)
 {
@@ -1125,6 +1144,9 @@ int virgl_encode_sampler_state(struct virgl_context *ctx,
       VIRGL_OBJ_SAMPLE_STATE_S0_COMPARE_FUNC(state->compare_func) |
       VIRGL_OBJ_SAMPLE_STATE_S0_SEAMLESS_CUBE_MAP(state->seamless_cube_map) |
       VIRGL_OBJ_SAMPLE_STATE_S0_MAX_ANISOTROPY(state->max_anisotropy);
+   /* WinBoat: min/max filtering, where the host takes it */
+   if (virgl_screen(ctx->base.screen)->caps.caps.v2.capability_bits_v2 & VIRGL_CAP_V2_SAMPLER_REDUCTION)
+      tmp |= VIRGL_OBJ_SAMPLE_STATE_S0_REDUCTION_MODE(state->reduction_mode);
 
    virgl_encoder_write_dword(ctx->cbuf, tmp);
    virgl_encoder_write_dword(ctx->cbuf, fui(state->lod_bias));
