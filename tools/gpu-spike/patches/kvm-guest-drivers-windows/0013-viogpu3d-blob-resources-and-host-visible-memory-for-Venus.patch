 }
 
+bool CPciResources::FindSharedMemory(UCHAR id, _Out_ PHYSICAL_ADDRESS *pa, _Out_ ULONGLONG *length)
+{
+    PAGED_CODE();
+
+    UCHAR config[256];
+    ULONG read = 0;
+    pa->QuadPart = 0;
+    *length = 0;
+    if (!NT_SUCCESS(m_pDxgkInterface->DxgkCbReadDeviceSpace(m_pDxgkInterface->DeviceHandle,
+                                                            DXGK_WHICHSPACE_CONFIG,
+                                                            config,
+                                                            0,
+                                                            sizeof(config),
+                                                            &read)) ||
+        read != sizeof(config))
+    {
+        return false;
+    }
+    PPCI_COMMON_HEADER header = (PPCI_COMMON_HEADER)config;
+    if (!(header->Status & PCI_STATUS_CAPABILITIES_LIST))
+    {
+        return false;
+    }
+
+    // struct virtio_pci_cap64: cap_vndr, cap_next, cap_len, cfg_type, bar, id, padding[2], offset, length,
+    // offset_hi, length_hi
+    UCHAR pos = header->u.type0.CapabilitiesPtr & ~3;
+    for (int guard = 0; pos && pos <= sizeof(config) - 24 && guard < 48; guard++)
+    {
+        const UCHAR *cap = &config[pos];
+        if (cap[0] == PCI_CAPABILITY_ID_VENDOR_SPECIFIC && cap[3] == 8 /* VIRTIO_PCI_CAP_SHARED_MEMORY_CFG */ &&
+            cap[5] == id && cap[4] < PCI_TYPE0_ADDRESSES)
+        {
+            ULONGLONG offset = *(const ULONG *)&cap[8] | ((ULONGLONG) * (const ULONG *)&cap[16] << 32);
+            ULONGLONG len = *(const ULONG *)&cap[12] | ((ULONGLONG) * (const ULONG *)&cap[20] << 32);
+            UCHAR bar = cap[4];
+            ULONG low = header->u.type0.BaseAddresses[bar];
+            if (low & PCI_ADDRESS_IO_SPACE)
+            {
+                return false;
+            }
+            PHYSICAL_ADDRESS base;
+            base.QuadPart = low & PCI_ADDRESS_MEMORY_ADDRESS_MASK;
+            if ((low & PCI_ADDRESS_MEMORY_TYPE_MASK) == PCI_TYPE_64BIT && bar + 1 < PCI_TYPE0_ADDRESSES)
+            {
+                base.HighPart = header->u.type0.BaseAddresses[bar + 1];
+            }
+            if (base.QuadPart == 0 || len == 0)
+            {
+                return false;
+            }
+            pa->QuadPart = base.QuadPart + offset;
+            *length = len;
+            return true;
+        }
+        pos = cap[1] & ~3;
+    }
+    return false;
+}
