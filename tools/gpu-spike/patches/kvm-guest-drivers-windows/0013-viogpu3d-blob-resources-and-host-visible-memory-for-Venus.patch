+    InitializeListHead(&m_HostmemRanges);
+}
+
+// A range of the host-visible memory window in use
+struct HOSTMEM_RANGE
+{
+    LIST_ENTRY entry;
+    ULONGLONG offset;
+    ULONGLONG size;
+};
+
+bool VioGpuAdapter::HostmemAlloc(ULONGLONG size, _Out_ ULONGLONG *offset)
+{
+    PAGED_CODE();
+
+    *offset = 0;
+    size = (size + PAGE_SIZE - 1) & ~(ULONGLONG)(PAGE_SIZE - 1);
+    if (!size || size > m_HostmemSize)
+    {
+        return false;
+    }
+    HOSTMEM_RANGE *range = new (PagedPool) HOSTMEM_RANGE;
+    if (!range)
+    {
+        return false;
+    }
+
+    // First fit: the gap before each range in use, then the one after the last
+    ExAcquireFastMutex(&m_HostmemLock);
+    ULONGLONG start = 0;
+    LIST_ENTRY *next = m_HostmemRanges.Flink;
+    for (; next != &m_HostmemRanges; next = next->Flink)
+    {
+        HOSTMEM_RANGE *used = CONTAINING_RECORD(next, HOSTMEM_RANGE, entry);
+        if (used->offset - start >= size)
+        {
+            break;
+        }
+        start = used->offset + used->size;
+    }
+    bool found = next != &m_HostmemRanges || m_HostmemSize - start >= size;
+    if (found)
+    {
+        range->offset = start;
+        range->size = size;
+        InsertTailList(next, &range->entry); // before next: the list stays sorted
+        *offset = start;
+    }
+    ExReleaseFastMutex(&m_HostmemLock);
+
+    if (!found)
+    {
+        delete range;
+    }
+    return found;
+}
+
+void VioGpuAdapter::HostmemFree(ULONGLONG offset)
+{
+    PAGED_CODE();
+
+    HOSTMEM_RANGE *found = NULL;
+    ExAcquireFastMutex(&m_HostmemLock);
+    for (LIST_ENTRY *e = m_HostmemRanges.Flink; e != &m_HostmemRanges; e = e->Flink)
+    {
+        HOSTMEM_RANGE *range = CONTAINING_RECORD(e, HOSTMEM_RANGE, entry);
+        if (range->offset == offset)
+        {
+            RemoveEntryList(&range->entry);
+            found = range;
+            break;
+        }
+    }
+    ExReleaseFastMutex(&m_HostmemLock);
+    delete found;
 }
 
