+VioGpuDevice::Blob *VioGpuDevice::FindBlob(ULONG resId)
+{
+    PAGED_CODE();
+
+    for (LIST_ENTRY *e = m_Blobs.Flink; e != &m_Blobs; e = e->Flink)
+    {
+        Blob *blob = CONTAINING_RECORD(e, Blob, entry);
+        if (blob->resId == resId)
+        {
+            return blob;
+        }
+    }
+    return NULL;
+}
+
+NTSTATUS VioGpuDevice::BlobCreate(_Inout_ VIOGPU_BLOB_CREATE_REQ *req)
+{
+    PAGED_CODE();
+
+    // Host memory only: Venus' memory and shared memory. The size must fit an MDL when it is mapped
+    if (req->BlobMem != VIOGPU_BLOB_MEM_HOST3D || !req->Size || req->Size > MAXULONG - PAGE_SIZE)
+    {
+        return STATUS_INVALID_PARAMETER;
+    }
+    Blob *blob = new (NonPagedPoolNx) Blob;
+    if (!blob)
+    {
+        return STATUS_NO_MEMORY;
+    }
+    RtlZeroMemory(blob, sizeof(*blob));
+    blob->resId = m_pAdapter->resourceIdr.GetId();
+    blob->size = (req->Size + PAGE_SIZE - 1) & ~(ULONGLONG)(PAGE_SIZE - 1);
+
+    ULONG type = m_pAdapter->ctrlQueue.CreateBlob(blob->resId,
+                                                  m_id,
+                                                  req->BlobMem,
+                                                  req->BlobFlags,
+                                                  req->BlobId,
+                                                  blob->size);
+    if (type != VIRTIO_GPU_RESP_OK_NODATA)
+    {
+        DbgPrint(TRACE_LEVEL_ERROR, ("%s host refused blob %I64u: %x\n", __FUNCTION__, req->BlobId, type));
+        m_pAdapter->resourceIdr.PutId(blob->resId);
+        delete blob;
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    // The context's commands name the blob (Venus' rings, its memory), and the host looks it up in the context.
+    // Destroying the resource later detaches it from every context
+    m_pAdapter->ctrlQueue.AttachResource(m_id, blob->resId);
+
+    ExAcquireFastMutex(&m_BlobLock);
+    InsertTailList(&m_Blobs, &blob->entry);
+    ExReleaseFastMutex(&m_BlobLock);
+    req->ResId = blob->resId;
+    return STATUS_SUCCESS;
+}
+
+NTSTATUS VioGpuDevice::BlobMap(_Inout_ VIOGPU_BLOB_MAP_REQ *req)
+{
+    PAGED_CODE();
+
+    NTSTATUS status = STATUS_SUCCESS;
+    ExAcquireFastMutex(&m_BlobLock);
+    Blob *blob = FindBlob(req->ResId);
+    if (!blob)
+    {
+        ExReleaseFastMutex(&m_BlobLock);
+        return STATUS_INVALID_PARAMETER;
+    }
+    if (blob->mapped)
+    {
+        req->Address = (UINT64)(ULONG_PTR)blob->userVa;
+        ExReleaseFastMutex(&m_BlobLock);
+        return STATUS_SUCCESS;
+    }
+
+    ULONG mapInfo = 0;
+    if (!m_pAdapter->HostmemAlloc(blob->size, &blob->offset))
+    {
+        DbgPrint(TRACE_LEVEL_ERROR, ("%s host-visible memory is full (%I64u bytes)\n", __FUNCTION__, blob->size));
+        ExReleaseFastMutex(&m_BlobLock);
+        return STATUS_NO_MEMORY;
+    }
+    ULONG type = m_pAdapter->ctrlQueue.MapBlob(blob->resId, blob->offset, &mapInfo);
+    if (type != VIRTIO_GPU_RESP_OK_MAP_INFO)
+    {
+        DbgPrint(TRACE_LEVEL_ERROR, ("%s host didn't map resource %u: %x\n", __FUNCTION__, blob->resId, type));
+        m_pAdapter->HostmemFree(blob->offset);
+        ExReleaseFastMutex(&m_BlobLock);
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    // The window's pages, mapped like the host asked: a kernel mapping describes them in an MDL, and the MDL maps
+    // them into the process
+    MEMORY_CACHING_TYPE caching;
+    ULONG protect;
+    switch (mapInfo & VIRTIO_GPU_MAP_CACHE_MASK)
+    {
+        case VIRTIO_GPU_MAP_CACHE_CACHED:
+            caching = MmCached;
+            protect = PAGE_READWRITE;
+            break;
+        case VIRTIO_GPU_MAP_CACHE_WC:
+            caching = MmWriteCombined;
+            protect = PAGE_READWRITE | PAGE_WRITECOMBINE;
+            break;
+        default:
+            caching = MmNonCached;
+            protect = PAGE_READWRITE | PAGE_NOCACHE;
+            break;
+    }
+    blob->kernelVa = MmMapIoSpaceEx(m_pAdapter->HostmemAddress(blob->offset), (SIZE_T)blob->size, protect);
+    if (blob->kernelVa)
+    {
+        blob->mdl = IoAllocateMdl(blob->kernelVa, (ULONG)blob->size, FALSE, FALSE, NULL);
+    }
+    if (blob->mdl)
+    {
+        MmBuildMdlForNonPagedPool(blob->mdl);
+        __try
+        {
+            blob->userVa = MmMapLockedPagesSpecifyCache(blob->mdl,
+                                                        UserMode,
+                                                        caching,
+                                                        NULL,
+                                                        FALSE,
+                                                        NormalPagePriority | MdlMappingNoExecute);
+        }
+        __except (EXCEPTION_EXECUTE_HANDLER)
+        {
+            blob->userVa = NULL;
+        }
+    }
+    if (!blob->userVa)
+    {
+        DbgPrint(TRACE_LEVEL_ERROR, ("%s mapping resource %u into the process failed\n", __FUNCTION__, blob->resId));
+        if (blob->mdl)
+        {
+            IoFreeMdl(blob->mdl);
+            blob->mdl = NULL;
+        }
+        if (blob->kernelVa)
+        {
+            MmUnmapIoSpace(blob->kernelVa, (SIZE_T)blob->size);
+            blob->kernelVa = NULL;
+        }
+        m_pAdapter->ctrlQueue.UnmapBlob(blob->resId);
+        m_pAdapter->HostmemFree(blob->offset);
+        status = STATUS_NO_MEMORY;
+    }
+    else
+    {
+        blob->process = PsGetCurrentProcess();
+        ObReferenceObject(blob->process);
+        blob->mapped = true;
+        req->Address = (UINT64)(ULONG_PTR)blob->userVa;
+        req->MapInfo = mapInfo;
+    }
+    ExReleaseFastMutex(&m_BlobLock);
+    return status;
+}
+
+void VioGpuDevice::UnmapBlob(Blob *blob)
+{
+    PAGED_CODE();
+
+    if (!blob->mapped)
+    {
+        return;
+    }
+    // The process's mapping goes in its own context (the device can go away while another process runs, e.g. when
+    // the process exits)
+    if (PsGetCurrentProcess() == blob->process)
+    {
+        MmUnmapLockedPages(blob->userVa, blob->mdl);
+    }
+    else
+    {
+        VIOGPU_APC_STATE apc;
+        KeStackAttachProcess(blob->process, &apc);
+        MmUnmapLockedPages(blob->userVa, blob->mdl);
+        KeUnstackDetachProcess(&apc);
+    }
+    ObDereferenceObject(blob->process);
+    IoFreeMdl(blob->mdl);
+    MmUnmapIoSpace(blob->kernelVa, (SIZE_T)blob->size);
+    m_pAdapter->ctrlQueue.UnmapBlob(blob->resId);
+    m_pAdapter->HostmemFree(blob->offset);
+    blob->mapped = false;
+    blob->process = NULL;
+    blob->mdl = NULL;
+    blob->kernelVa = NULL;
+    blob->userVa = NULL;
+}
+
+void VioGpuDevice::DestroyBlob(Blob *blob)
+{
+    PAGED_CODE();
+
+    UnmapBlob(blob);
+    m_pAdapter->ctrlQueue.DestroyResource(blob->resId);
+    m_pAdapter->resourceIdr.PutId(blob->resId);
+    delete blob;
+}
+
+NTSTATUS VioGpuDevice::BlobDestroy(ULONG resId)
+{
+    PAGED_CODE();
+
+    ExAcquireFastMutex(&m_BlobLock);
+    Blob *blob = FindBlob(resId);
+    if (blob)
+    {
+        RemoveEntryList(&blob->entry);
+    }
+    ExReleaseFastMutex(&m_BlobLock);
+    if (!blob)
+    {
+        return STATUS_INVALID_PARAMETER;
+    }
+    DestroyBlob(blob);
+    return STATUS_SUCCESS;
+}
+
+// A command stream the host is processing, and the event to set when it is done. The control queue owns the
+// commands once they are queued (they are the command's data buffer, which it frees with the command)
+struct EXECBUFFER_DONE
+{
+    PVOID commands;
+    PKEVENT event;
+};
+
+#pragma code_seg(push)
+#pragma code_seg()
+// From the DPC: not paged
+static void ExecBufferDone(void *context)
+{
+    EXECBUFFER_DONE *done = (EXECBUFFER_DONE *)context;
+    if (done->event)
+    {
+        KeSetEvent(done->event, IO_NO_INCREMENT, FALSE);
+        ObDereferenceObject(done->event);
+    }
+    delete done;
+}
+#pragma code_seg(pop)
+
+NTSTATUS VioGpuDevice::ExecBuffer(_In_ VIOGPU_EXECBUFFER_REQ *req)
+{
+    PAGED_CODE();
+
+    // An empty stream is allowed: Venus submits one just to have a ring's fence signal
+    if (req->Size > VIOGPU_EXECBUFFER_MAX_SIZE || (req->Size & 3) || req->RingIdx > 63)
+    {
+        return STATUS_INVALID_PARAMETER;
+    }
+    EXECBUFFER_DONE *done = new (NonPagedPoolNx) EXECBUFFER_DONE;
+    if (!done)
+    {
+        return STATUS_NO_MEMORY;
+    }
+    done->event = NULL;
+    done->commands = req->Size ? new (NonPagedPoolNx) BYTE[req->Size] : NULL;
+    if (req->Size && !done->commands)
+    {
+        delete done;
+        return STATUS_NO_MEMORY;
+    }
+    __try
+    {
+        PVOID src = (PVOID)(ULONG_PTR)req->Command;
+        ProbeForRead(src, req->Size, 1);
+        memcpy(done->commands, src, req->Size);
+    }
+    __except (EXCEPTION_EXECUTE_HANDLER)
+    {
+        delete[] reinterpret_cast<BYTE *>(done->commands);
+        delete done;
+        return STATUS_INVALID_PARAMETER;
+    }
+    if (req->Event)
+    {
+        NTSTATUS status = ObReferenceObjectByHandle((HANDLE)(ULONG_PTR)req->Event,
+                                                    EVENT_MODIFY_STATE,
+                                                    *ExEventObjectType,
+                                                    UserMode,
+                                                    (PVOID *)&done->event,
+                                                    NULL);
+        if (!NT_SUCCESS(status))
+        {
+            delete[] reinterpret_cast<BYTE *>(done->commands);
+            delete done;
+            return status;
+        }
+    }
+
+    m_pAdapter->ctrlQueue.SubmitCommandRing(done->commands,
+                                            req->Size,
+                                            m_id,
+                                            done->event != NULL,
+                                            req->RingIdx,
+                                            ExecBufferDone,
+                                            done);
+    return STATUS_SUCCESS;
+}
