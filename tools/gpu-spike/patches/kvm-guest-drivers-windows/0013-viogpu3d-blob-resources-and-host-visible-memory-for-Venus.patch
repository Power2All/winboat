+// Blob resources (VIRTIO_GPU_F_RESOURCE_BLOB): memory the host allocates (Venus' Vulkan memory and command ring),
+// mapped into the device's host-visible memory window (the shared memory region below)
+#define VIRTIO_GPU_SHM_ID_HOST_VISIBLE 1
+
+#pragma pack(1)
