+void CtrlQueue::AttachResource(UINT ctx_id, UINT res_id)
+{
+    PAGED_CODE();
+
+    PGPU_CMD_CTX_RESOURCE cmd;
+    PGPU_VBUFFER vbuf;
+    cmd = (PGPU_CMD_CTX_RESOURCE)AllocCmd(&vbuf, sizeof(*cmd));
+    RtlZeroMemory(cmd, sizeof(*cmd));
+
+    cmd->hdr.type = VIRTIO_GPU_CMD_CTX_ATTACH_RESOURCE;
+    cmd->hdr.ctx_id = ctx_id;
+    cmd->resource_id = res_id;
+
+    QueueBuffer(vbuf);
+}
+
 void CtrlQueue::ResFlush(UINT res_id, UINT width, UINT height, UINT x, UINT y)
 {
     PAGED_CODE();
@@ -654,6 +670,138 @@
     DbgPrint(TRACE_LEVEL_VERBOSE, ("<--- %s\n", __FUNCTION__));
 }
 
+void CtrlQueue::SubmitCommandRing(void *cmdbuf,
+                                  ULONG size,
+                                  ULONG ctx_id,
+                                  bool fence,
+                                  ULONG ring_idx,
+                                  void (*complete_cb)(void *),
+                                  void *complete_ctx)
+{
+    PAGED_CODE();
+
+    PGPU_CMD_SUBMIT cmd;
+    PGPU_VBUFFER vbuf;
+    cmd = (PGPU_CMD_SUBMIT)AllocCmd(&vbuf, sizeof(*cmd));
+    RtlZeroMemory(cmd, sizeof(*cmd));
+
+    cmd->hdr.type = VIRTIO_GPU_CMD_SUBMIT_3D;
+    cmd->hdr.ctx_id = ctx_id;
+    cmd->size = size;
+    if (fence)
+    {
+        // Fences on a context's rings only need to grow per ring: the device-wide counter does
+        cmd->hdr.flags |= VIRTIO_GPU_FLAG_FENCE | VIRTIO_GPU_FLAG_INFO_RING_IDX;
+        cmd->hdr.fence_id = InterlockedIncrement(&m_FenceIdr);
+        cmd->hdr.ring_idx = (UCHAR)ring_idx;
+    }
+
+    vbuf->data_buf = cmdbuf;
+    vbuf->data_size = size;
+    vbuf->complete_cb = complete_cb;
+    vbuf->complete_ctx = complete_ctx;
+
+    QueueBuffer(vbuf);
+}
+
+// Sends a command and waits for the host's answer. No timeout: the response buffer and the event must stay valid
+// until the host answered, and a guest can't take a command back
+ULONG CtrlQueue::QueueAndWait(PGPU_VBUFFER vbuf)
+{
+    PAGED_CODE();
+
+    KEVENT event;
+    KeInitializeEvent(&event, NotificationEvent, FALSE);
+    vbuf->complete_cb = NotifyEventCompleteCB;
+    vbuf->complete_ctx = &event;
+    vbuf->auto_release = false;
+
+    if (QueueBuffer(vbuf) != 0)
+    {
+        ReleaseBuffer(vbuf);
+        return VIRTIO_GPU_RESP_ERR_UNSPEC;
+    }
+    KeWaitForSingleObject(&event, Executive, KernelMode, FALSE, NULL);
+
+    ULONG type = ((PGPU_CTRL_HDR)vbuf->resp_buf)->type;
+    return type;
+}
+
+ULONG CtrlQueue::CreateBlob(UINT res_id,
+                            UINT ctx_id,
+                            ULONG blob_mem,
+                            ULONG blob_flags,
+                            ULONGLONG blob_id,
+                            ULONGLONG size)
+{
+    PAGED_CODE();
+
+    PGPU_RES_CREATE_BLOB cmd;
+    PGPU_VBUFFER vbuf;
+    cmd = (PGPU_RES_CREATE_BLOB)AllocCmd(&vbuf, sizeof(*cmd));
+    RtlZeroMemory(cmd, sizeof(*cmd));
+
+    cmd->hdr.type = VIRTIO_GPU_CMD_RESOURCE_CREATE_BLOB;
+    cmd->hdr.ctx_id = ctx_id;
+    cmd->resource_id = res_id;
+    cmd->blob_mem = blob_mem;
+    cmd->blob_flags = blob_flags;
+    cmd->blob_id = blob_id;
+    cmd->size = size;
+    cmd->nr_entries = 0; // host memory only (VIRTIO_GPU_BLOB_MEM_HOST3D)
+
+    ULONG type = QueueAndWait(vbuf);
+    ReleaseBuffer(vbuf);
+    return type;
+}
+
+ULONG CtrlQueue::MapBlob(UINT res_id, ULONGLONG offset, _Out_ ULONG *map_info)
+{
+    PAGED_CODE();
+
+    PGPU_RES_MAP_BLOB cmd;
+    PGPU_VBUFFER vbuf;
+    // Freed by ReleaseBuffer like any response bigger than the inline space (delete[] of a BYTE array)
+    PGPU_RESP_MAP_INFO resp = reinterpret_cast<PGPU_RESP_MAP_INFO>(new (NonPagedPoolNx) BYTE[sizeof(GPU_RESP_MAP_INFO)]);
+    *map_info = 0;
+    if (!resp)
+    {
+        return VIRTIO_GPU_RESP_ERR_OUT_OF_MEMORY;
+    }
+    RtlZeroMemory(resp, sizeof(*resp));
+    cmd = (PGPU_RES_MAP_BLOB)AllocCmdResp(&vbuf, sizeof(*cmd), resp, sizeof(*resp));
+    RtlZeroMemory(cmd, sizeof(*cmd));
+
+    cmd->hdr.type = VIRTIO_GPU_CMD_RESOURCE_MAP_BLOB;
+    cmd->resource_id = res_id;
+    cmd->offset = offset;
+
+    ULONG type = QueueAndWait(vbuf);
+    if (type == VIRTIO_GPU_RESP_OK_MAP_INFO)
+    {
+        *map_info = resp->map_info;
+    }
+    ReleaseBuffer(vbuf); // frees resp too
+    return type;
+}
+
+ULONG CtrlQueue::UnmapBlob(UINT res_id)
+{
+    PAGED_CODE();
+
+    PGPU_RES_UNMAP_BLOB cmd;
+    PGPU_VBUFFER vbuf;
+    cmd = (PGPU_RES_UNMAP_BLOB)AllocCmd(&vbuf, sizeof(*cmd));
+    RtlZeroMemory(cmd, sizeof(*cmd));
+
+    cmd->hdr.type = VIRTIO_GPU_CMD_RESOURCE_UNMAP_BLOB;
+    cmd->resource_id = res_id;
+
+    ULONG type = QueueAndWait(vbuf);
+    ReleaseBuffer(vbuf);
+    return type;
+}
+
 void CtrlQueue::TransferHostCmd(bool to_host,
                                 ULONG ctx_id,
                                 VIOGPU_TRANSFER_CMD *options,
