+BOOLEAN VioGpuAdapter::CreateCursor(void)
+{
+    PAGED_CODE();
+
+    UINT size = POINTER_SIZE * POINTER_SIZE * 4;
+    UINT resid = (UINT)resourceIdr.GetId();
+    ctrlQueue.CreateResource(resid, ColorFormat(D3DDDIFMT_A8R8G8B8), POINTER_SIZE, POINTER_SIZE);
+    VioGpuObj *obj = new (NonPagedPoolNx) VioGpuObj();
+    if (!obj->Init(size, &m_CursorSegment) || !vidpn.GpuObjectAttach(resid, obj))
+    {
+        DbgPrint(TRACE_LEVEL_ERROR, ("<--- %s failed to create the cursor resource\n", __FUNCTION__));
+        ctrlQueue.DestroyResource(resid);
+        resourceIdr.PutId(resid);
+        delete obj;
+        return FALSE;
+    }
+    m_pCursorBuf = obj;
+    return TRUE;
+}
+
+// Copies the shape into the cursor resource and sends it to the host
+BOOLEAN VioGpuAdapter::UpdateCursor(_In_ CONST DXGKARG_SETPOINTERSHAPE *pSetPointerShape)
+{
+    PAGED_CODE();
+
+    if (!pSetPointerShape->Flags.Color || pSetPointerShape->Width > POINTER_SIZE ||
+        pSetPointerShape->Height > POINTER_SIZE)
+    {
+        return FALSE;
+    }
+    if (m_pCursorBuf == NULL && !CreateCursor())
+    {
+        return FALSE;
+    }
+
+    RECT Rect;
+    Rect.left = 0;
+    Rect.top = 0;
+    Rect.right = pSetPointerShape->Width;
+    Rect.bottom = pSetPointerShape->Height;
+
+    // A smaller shape leaves the rest of the 64x64 cursor transparent
+    RtlZeroMemory(m_pCursorBuf->GetVirtualAddress(), POINTER_SIZE * POINTER_SIZE * 4);
+
+    BLT_INFO DstBltInfo;
+    DstBltInfo.pBits = m_pCursorBuf->GetVirtualAddress();
+    DstBltInfo.Pitch = POINTER_SIZE * 4;
+    DstBltInfo.BitsPerPel = BPPFromPixelFormat(D3DDDIFMT_A8R8G8B8);
+    DstBltInfo.Offset.x = 0;
+    DstBltInfo.Offset.y = 0;
+    DstBltInfo.Rotation = D3DKMDT_VPPR_IDENTITY;
+    DstBltInfo.Width = POINTER_SIZE;
+    DstBltInfo.Height = POINTER_SIZE;
+
+    BLT_INFO SrcBltInfo;
+    SrcBltInfo.pBits = (PVOID)pSetPointerShape->pPixels;
+    SrcBltInfo.Pitch = pSetPointerShape->Pitch;
+    SrcBltInfo.BitsPerPel = BPPFromPixelFormat(D3DDDIFMT_A8R8G8B8);
+    SrcBltInfo.Offset.x = 0;
+    SrcBltInfo.Offset.y = 0;
+    SrcBltInfo.Rotation = D3DKMDT_VPPR_IDENTITY;
+    SrcBltInfo.Width = pSetPointerShape->Width;
+    SrcBltInfo.Height = pSetPointerShape->Height;
+
+    BltBits(&DstBltInfo, &SrcBltInfo, &Rect);
+
+    ctrlQueue.TransferToHost2D(m_pCursorBuf->GetId(), 0, POINTER_SIZE, POINTER_SIZE, 0, 0);
+    return TRUE;
+}
+
+NTSTATUS VioGpuAdapter::SetPointerShape(_In_ CONST DXGKARG_SETPOINTERSHAPE *pSetPointerShape)
+{
+    PAGED_CODE();
+
+    DbgPrint(TRACE_LEVEL_VERBOSE,
+             ("%s flags 0x%x %ux%u hot %u,%u pitch %u enabled %d\n",
+              __FUNCTION__,
+              pSetPointerShape->Flags.Value,
+              pSetPointerShape->Width,
+              pSetPointerShape->Height,
+              pSetPointerShape->XHot,
+              pSetPointerShape->YHot,
+              pSetPointerShape->Pitch,
+              IsPointerEnabled()));
+    // Windows draws the shapes this can't take (monochrome, masked color) itself
+    if (!IsPointerEnabled() || pSetPointerShape->VidPnSourceId != 0 || !UpdateCursor(pSetPointerShape))
+    {
+        DbgPrint(TRACE_LEVEL_VERBOSE, ("%s not taken, software cursor\n", __FUNCTION__));
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    PGPU_VBUFFER vbuf;
+    PGPU_UPDATE_CURSOR crsr = (PGPU_UPDATE_CURSOR)m_CursorQueue.AllocCursor(&vbuf);
+    RtlZeroMemory(crsr, sizeof(*crsr));
+    crsr->hdr.type = VIRTIO_GPU_CMD_UPDATE_CURSOR;
+    crsr->resource_id = m_pCursorBuf->GetId();
+    // An update moves the cursor too: keep it where SetPointerPosition put it
+    crsr->pos.x = m_CursorX;
+    crsr->pos.y = m_CursorY;
+    crsr->hot_x = pSetPointerShape->XHot;
+    crsr->hot_y = pSetPointerShape->YHot;
+    return m_CursorQueue.QueueCursor(vbuf) == 0 ? STATUS_SUCCESS : STATUS_UNSUCCESSFUL;
+}
+
+NTSTATUS VioGpuAdapter::SetPointerPosition(_In_ CONST DXGKARG_SETPOINTERPOSITION *pSetPointerPosition)
+{
+    PAGED_CODE();
+
+    if (!IsPointerEnabled() || m_pCursorBuf == NULL || pSetPointerPosition->VidPnSourceId != 0)
+    {
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    PGPU_VBUFFER vbuf;
+    PGPU_UPDATE_CURSOR crsr = (PGPU_UPDATE_CURSOR)m_CursorQueue.AllocCursor(&vbuf);
+    RtlZeroMemory(crsr, sizeof(*crsr));
+    crsr->hdr.type = VIRTIO_GPU_CMD_MOVE_CURSOR;
+    // A hidden cursor is resource 0
+    if (pSetPointerPosition->Flags.Visible)
+    {
+        crsr->resource_id = m_pCursorBuf->GetId();
+        m_CursorX = max(pSetPointerPosition->X, 0);
+        m_CursorY = max(pSetPointerPosition->Y, 0);
+        crsr->pos.x = m_CursorX;
+        crsr->pos.y = m_CursorY;
+    }
+    return m_CursorQueue.QueueCursor(vbuf) == 0 ? STATUS_SUCCESS : STATUS_UNSUCCESSFUL;
+}
+
 VioGpuAllocation *VioGpuAdapter::AllocationFromHandle(D3DKMT_HANDLE handle)
 {
     DXGKARGCB_GETHANDLEDATA getHandleData;
