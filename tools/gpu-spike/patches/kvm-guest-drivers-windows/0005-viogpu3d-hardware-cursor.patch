From: WinBoat
Subject: [PATCH] viogpu3d: hardware cursor

The pointer DDIs were stubs and the capability commented out, so Windows drew the cursor into every frame: over
SPICE the pointer then only moves when a frame has made the round trip to the client. Port viogpudo's cursor (a
64x64 ARGB resource on the cursor queue) and report color pointer support; HWCursor defaults to 1. Masked and
monochrome shapes stay software cursors. The host draws the cursor itself (a SPICE client in client mouse mode).
---
diff --git a/viogpu/viogpu3d/driver.cpp b/viogpu/viogpu3d/driver.cpp
index 68f9e63..713738b 100644
--- a/viogpu/viogpu3d/driver.cpp
+++ b/viogpu/viogpu3d/driver.cpp
@@ -363,7 +363,6 @@ VioGpu3DSetPointerPosition(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_SETPOI
 {
     PAGED_CODE();
     VIOGPU_ASSERT_CHK(hAdapter != NULL);
-    UNREFERENCED_PARAMETER(pSetPointerPosition);
     DbgPrint(TRACE_LEVEL_VERBOSE, ("<---> %s\n", __FUNCTION__));
 
     VioGpuAdapter *pAdapter = reinterpret_cast<VioGpuAdapter *>(hAdapter);
@@ -373,7 +372,7 @@ VioGpu3DSetPointerPosition(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_SETPOI
         VioGpuDbgBreak();
         return STATUS_UNSUCCESSFUL;
     }
-    return STATUS_NOT_IMPLEMENTED;
+    return pAdapter->SetPointerPosition(pSetPointerPosition);
 }
 
 NTSTATUS
@@ -382,7 +381,6 @@ VioGpu3DSetPointerShape(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_SETPOINTE
 {
     PAGED_CODE();
     VIOGPU_ASSERT_CHK(hAdapter != NULL);
-    UNREFERENCED_PARAMETER(pSetPointerShape);
     DbgPrint(TRACE_LEVEL_VERBOSE, ("<---> %s\n", __FUNCTION__));
 
     VioGpuAdapter *pAdapter = reinterpret_cast<VioGpuAdapter *>(hAdapter);
@@ -392,7 +390,7 @@ VioGpu3DSetPointerShape(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_SETPOINTE
                  ("<---> %s VioGpu (%p) is being called when not active!\n", __FUNCTION__, pAdapter));
         return STATUS_UNSUCCESSFUL;
     }
-    return STATUS_NOT_IMPLEMENTED;
+    return pAdapter->SetPointerShape(pSetPointerShape);
 }
 
