From: WinBoat
Subject: [PATCH] viogpu3d: Windows 7 (the WDDM 1.1 build)

The Windows 7 build (VIOGPU_WIN7 with VIOGPU_WDDM1_3, build-driver.ps1 -Win7): Windows 7's display driver interface,
DXGKDDI_INTERFACE_VERSION 0x2005 (vcxproj, VIOGPU_WIN7=1), so any later field or callback is a compile error; the
Windows 8 DDIs and callbacks gated with VIOGPU_WIN8_DDI. Found with the driver's trace on COM1, Windows 7's dxgkrnl
and dxgmms1 through QEMU's gdbstub (hardware breakpoints on their return points, their public symbols):
- Windows 7's loader doesn't set the /GS cookie and the current WDK's GsDriverEntry fast-fails (bugcheck 0x7E):
  VioGpuWin7Entry sets it first
- the driver caps say WDDM 1.0 (DXGKDDI_WDDMv1) and end where Windows 7's do; the segments come from
  DXGKQAITYPE_QUERYSEGMENT (type 2). Windows 7's VidMm puts primaries only in CPU-visible segments
  (VerifySegmentSet: CDD's primary failed with 0xC000000D and no mode was ever committed) and maps their CPU views at
  the segment's CpuTranslatedAddress: a second, CPU-visible aperture segment for primaries (CDD's shared primary,
  VIOGPU_RESOURCE_FLAG_PRIMARY) over device memory: the top 64 MB of the host-visible window (hostmem=), taken from
  the blob resources, else virtio-vga's VGA memory BAR (8 MB). Views of RAM get locked (CDD's), and moving a locked
  view off a primary at a mode change (MmRotatePhysicalView in SuspendPrimaryCpuAccess) fails with
  STATUS_WAS_LOCKED, retried forever with the adapter's core lock held: the first boot after an install hung (the
  new monitor's PnP restart waited for that lock, and logon for the restart). That was so with the aperture itself
  CPU-visible at address 0 (the views were whatever RAM was there, which CDD wrote to) and with memory of the
  driver's own alike
- DXGKARG_OPENALLOCATION ends before SubresourceOffset and Pitch: writing them corrupted dxgkrnl's stack (0x7E)
- no StopDeviceAndReleasePostDisplayOwnership: the vsync thread is stopped in StopDevice's path too (0xCE without)
- no high-resolution timers (ExAllocateTimer), no KeQuerySystemTimePrecise: ExSetTimerResolution, KeQueryInterruptTime
- one node (no D3D12/Venus queue), SubmitCommand without NodeOrdinal
- target modes the size of the pinned source mode (Windows 8 and later scale mode 0); KMDOD's rotation offer
Shared with Windows 8.1-11: a blit present appends VIOGPU_CMD_FLUSH_SCANOUT, after which the vsync thread flushes the
scanout if the blit drew on it (Windows 7 without DWM draws the desktop with blits, which never reached the screen);
its transfers take the box's offset and stride in the surface (offset 0 drew the desktop's top-left corner over the
taskbar), and the cover rectangle of the sub-rectangles was their intersection (min), now their union. The vsync
thread keeps the scanout's resource id and size instead of its allocation (a Direct3D 9Ex full-screen test destroyed
the primary and the flush then used it: bugcheck 0x7E in CtrlQueue::AllocCmd); the allocation's destructor clears the
id. VioGpuLog's lines go to COM1 too in the serial-trace build (COM_DEBUG).
---
diff --git a/viogpu/common/helper.h b/viogpu/common/helper.h
index 322fb9c..5ef7651 100644
--- a/viogpu/common/helper.h
+++ b/viogpu/common/helper.h
@@ -108,6 +108,17 @@ extern "C"
 #define VIOGPU_WDDM2 0
 #endif
 
+// Windows 7 (VIOGPU_WIN7, with VIOGPU_WDDM1_3): the WDDM 1.3 driver offering WDDM 1.1's interface. Windows 7's
+// dxgkrnl has no Windows 8 boot display hand-over (DxgkCbAcquirePostDisplayOwnership): the driver starts at its
+// default mode
+// The Windows 8 DDIs (DxgkDdiSystemDisplayEnable, engine reset, node metadata...): not in the WDDM 1.1 headers of
+// the Windows 7 build
+#define VIOGPU_WIN8_DDI (DXGKDDI_INTERFACE_VERSION >= DXGKDDI_INTERFACE_VERSION_WIN8)
+
+#ifndef VIOGPU_WIN7
+#define VIOGPU_WIN7 0
+#endif
+
 // GPU page tables (VIOGPU_WDDM2): 4 levels of 512 entries (DXGK_PTE, 16 bytes: 8 KB a table) over 4 KB pages, a
 // 48-bit GPU virtual address space (Direct3D feature level 12_2 wants at least 40 bits a process). The CPU updates them (DXGK_PAGETABLEUPDATE_CPU_VIRTUAL) and the virtual
 // GPU never reads them: its commands name host resources, not addresses
diff --git a/viogpu/shared/viogpum.h b/viogpu/shared/viogpum.h
index ccfb3ee..c14c0c6 100644
--- a/viogpu/shared/viogpum.h
+++ b/viogpu/shared/viogpum.h
@@ -287,6 +287,8 @@ typedef struct _VIOGPU_CREATE_RESOURCE_EXCHANGE
 #pragma pack(1)
 // Kernel driver only, never sent to the host: a GDI surface (GetStandardAllocationDriverData), drawn by GDI with the CPU
 #define VIOGPU_RESOURCE_FLAG_GDI_SURFACE 0x80000000
+// Kernel driver only, never sent to the host: a primary (Windows 7 keeps these in its CPU-visible segment)
+#define VIOGPU_RESOURCE_FLAG_PRIMARY 0x40000000
 
 typedef struct _VIOGPU_CREATE_ALLOCATION_EXCHANGE
 {
@@ -300,6 +302,7 @@ typedef struct _VIOGPU_CREATE_ALLOCATION_EXCHANGE
 #define VIOGPU_CMD_SUBMIT             0x1 // Submit Command to virgl
 #define VIOGPU_CMD_TRANSFER_TO_HOST   0x2 // Transfer resource to host
 #define VIOGPU_CMD_TRANSFER_FROM_HOST 0x3 // Transfer resource to host
+#define VIOGPU_CMD_FLUSH_SCANOUT      0x4 // The kernel's blit presents: the display shows the resource (a UINT) again
 
 #pragma pack(1)
 typedef struct _VIOGPU_COMMAND_HDR
diff --git a/viogpu/viogpu3d/driver.cpp b/viogpu/viogpu3d/driver.cpp
index 1b24965..486f714 100644
--- a/viogpu/viogpu3d/driver.cpp
+++ b/viogpu/viogpu3d/driver.cpp
@@ -74,6 +74,22 @@ void InitializeDebugPrints(IN PDRIVER_OBJECT DriverObject, IN PUNICODE_STRING Re
 #include <ntddk.h>
 #include "viogpu_device.h"
 
+#if VIOGPU_WIN7
+// Windows 7's loader leaves the /GS cookie at its default value, and this WDK's GsDriverEntry then fails fast (int 29h,
+// which Windows 7 doesn't know: bugcheck 0x7E at boot). The entry point of the Windows 7 build (viogpu3d.vcxproj) sets
+// one first; it has no buffers of its own to check
+extern "C" ULONG_PTR __security_cookie;
+extern "C" DRIVER_INITIALIZE GsDriverEntry;
+extern "C" __declspec(safebuffers) NTSTATUS VioGpuWin7Entry(_In_ DRIVER_OBJECT *pDriverObject,
+                                                            _In_ UNICODE_STRING *pRegistryPath)
+{
+    LARGE_INTEGER counter = KeQueryPerformanceCounter(NULL);
+    ULONG_PTR cookie = (counter.QuadPart ^ KeQueryInterruptTime() ^ (ULONG_PTR)&counter) & 0x0000FFFFFFFFFFFFULL;
+    __security_cookie = (cookie == 0 || cookie == 0x2B992DDFA232ULL) ? cookie + 1 : cookie;
+    return GsDriverEntry(pDriverObject, pRegistryPath);
+}
+#endif
+
 #pragma code_seg(push)
 #pragma code_seg("PAGE")
 extern "C" NTSTATUS DriverEntry(_In_ DRIVER_OBJECT *pDriverObject, _In_ UNICODE_STRING *pRegistryPath)
@@ -85,6 +101,8 @@ extern "C" NTSTATUS DriverEntry(_In_ DRIVER_OBJECT *pDriverObject, _In_ UNICODE_
 
 #if VIOGPU_WDDM2
     InitialData.Version = DXGKDDI_INTERFACE_VERSION_WDDM2_0;
+#elif VIOGPU_WIN7
+    InitialData.Version = DXGKDDI_INTERFACE_VERSION_WIN7;
 #else
     InitialData.Version = DXGKDDI_INTERFACE_VERSION_WDDM1_3;
 #endif
@@ -134,10 +152,16 @@ extern "C" NTSTATUS DriverEntry(_In_ DRIVER_OBJECT *pDriverObject, _In_ UNICODE_
     InitialData.DxgkDdiSetVidPnSourceAddress = VioGpu3DSetVidPnSourceAddress;
     InitialData.DxgkDdiRecommendMonitorModes = VioGpu3DRecommendMonitorModes;
     InitialData.DxgkDdiQueryVidPnHWCapability = VioGpu3DQueryVidPnHWCapability;
+#if VIOGPU_WIN8_DDI
     InitialData.DxgkDdiSystemDisplayEnable = VioGpu3DSystemDisplayEnable;
+#endif // VIOGPU_WIN8_DDI
+#if VIOGPU_WIN8_DDI
     InitialData.DxgkDdiSystemDisplayWrite = VioGpu3DSystemDisplayWrite;
+#endif // VIOGPU_WIN8_DDI
 
+#if VIOGPU_WIN8_DDI
     InitialData.DxgkDdiStopDeviceAndReleasePostDisplayOwnership = VioGpu3DStopDeviceAndReleasePostDisplayOwnership;
+#endif // VIOGPU_WIN8_DDI
 
     InitialData.DxgkDdiCreateDevice = VioGpu3DCreateDevice;
     InitialData.DxgkDdiDestroyDevice = VioGpu3DDestroyDevice;
@@ -148,19 +172,31 @@ extern "C" NTSTATUS DriverEntry(_In_ DRIVER_OBJECT *pDriverObject, _In_ UNICODE_
     InitialData.DxgkDdiCollectDbgInfo = VioGpu3DDdiCollectDbgInfo;
     InitialData.DxgkDdiQueryCurrentFence = VioGpu3DDdiQueryCurrentFence;
 
+#if VIOGPU_WIN8_DDI
     InitialData.DxgkDdiQueryEngineStatus = VioGpu3DDdiQueryEngineStatus;
+#endif // VIOGPU_WIN8_DDI
     // Windows 8.1 doesn't start a display driver with engine reset (ResetEngine) without it
+#if VIOGPU_WIN8_DDI
     InitialData.DxgkDdiQueryDependentEngineGroup = VioGpu3DDdiQueryDependentEngineGroup;
+#endif // VIOGPU_WIN8_DDI
     // nor without SetPalette (dxgkrnl's ADAPTER_DISPLAY::CreateDisplayCore; no palettized modes here)
     InitialData.DxgkDdiSetPalette = VioGpu3DDdiSetPalette;
+#if VIOGPU_WIN8_DDI
     InitialData.DxgkDdiResetEngine = VioGpu3DDdiResetEngine;
+#endif // VIOGPU_WIN8_DDI
+#if VIOGPU_WIN8_DDI
     InitialData.DxgkDdiCancelCommand = VioGpu3DDdiCancelCommand;
+#endif // VIOGPU_WIN8_DDI
 
+#if VIOGPU_WIN8_DDI
     InitialData.DxgkDdiGetNodeMetadata = VioGpu3DDdiGetNodeMetadata;
+#endif // VIOGPU_WIN8_DDI
     InitialData.DxgkDdiControlInterrupt = VioGpu3DDdiControlInterrupt;
 #if !VIOGPU_WDDM2
     // Windows 8.1's dxgkrnl calls it unchecked (DXGADAPTER::DdiControlInterrupt2): a null pointer bugchecked (0x3B)
+#if VIOGPU_WIN8_DDI
     InitialData.DxgkDdiControlInterrupt2 = VioGpu3DDdiControlInterrupt2;
+#endif // VIOGPU_WIN8_DDI
 #endif
     InitialData.DxgkDdiGetScanLine = VioGpu3DDdiGetScanLine;
 
@@ -364,6 +400,7 @@ VioGpu3DQueryAdapterInfo(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_QUERYADA
     return pAdapter->QueryAdapterInfo(pQueryAdapterInfo);
 }
 
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DDdiGetNodeMetadata(_In_ CONST HANDLE hAdapter,
@@ -389,6 +426,7 @@ VioGpu3DDdiGetNodeMetadata(_In_ CONST HANDLE hAdapter,
 
     return STATUS_SUCCESS;
 };
+#endif // VIOGPU_WIN8_DDI
 
 #if VIOGPU_WDDM2
 // WDDM 2.0: GPU virtual addresses. Windows keeps the page tables (VIOGPU_PAGE_TABLE_*); the virtual GPU has no MMU,
@@ -725,8 +763,12 @@ VioGpu3DSubmitCommand(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_SUBMITCOMMA
         // pAdapter));
         return STATUS_UNSUCCESSFUL;
     }
+#if VIOGPU_WIN8_DDI
     VioGpuCommander &commander =
         pSubmitCommand->NodeOrdinal == VIOGPU_VENUS_NODE ? pAdapter->venusCommander : pAdapter->commander;
+#else
+    VioGpuCommander &commander = pAdapter->commander; // (one node: Windows 7's submissions name none)
+#endif
     return commander.SubmitCommand(pSubmitCommand);
 };
 
@@ -876,6 +918,7 @@ VioGpu3DRender(_In_ CONST HANDLE hDevice, _Inout_ DXGKARG_RENDER *pRender)
     return pDxContext->Render(pRender);
 }
 
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DStopDeviceAndReleasePostDisplayOwnership(_In_ VOID *pDeviceContext,
@@ -894,6 +937,7 @@ VioGpu3DStopDeviceAndReleasePostDisplayOwnership(_In_ VOID *pDeviceContext,
     }
     return status;
 }
+#endif // VIOGPU_WIN8_DDI
 
 NTSTATUS
 APIENTRY
@@ -1072,6 +1116,7 @@ VioGpu3DDdiControlInterrupt(_In_ CONST HANDLE hAdapter,
 
 #if !VIOGPU_WDDM2
 // Like ControlInterrupt: the vsync interrupts come from a timer whether asked for or not
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DDdiControlInterrupt2(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_CONTROLINTERRUPT2 InterruptControl)
@@ -1081,6 +1126,7 @@ VioGpu3DDdiControlInterrupt2(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_CONT
     UNREFERENCED_PARAMETER(InterruptControl);
     return STATUS_SUCCESS;
 }
+#endif // VIOGPU_WIN8_DDI
 #endif
 
 NTSTATUS
@@ -1149,6 +1195,7 @@ VOID VioGpu3DResetDevice(_In_ VOID *pDeviceContext)
     pAdapter->ResetDevice();
 }
 
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DSystemDisplayEnable(_In_ VOID *pDeviceContext,
@@ -1164,7 +1211,9 @@ VioGpu3DSystemDisplayEnable(_In_ VOID *pDeviceContext,
     VioGpuAdapter *pAdapter = reinterpret_cast<VioGpuAdapter *>(pDeviceContext);
     return pAdapter->vidpn.SystemDisplayEnable(TargetId, Flags, Width, Height, ColorFormat);
 }
+#endif // VIOGPU_WIN8_DDI
 
+#if VIOGPU_WIN8_DDI
 VOID APIENTRY VioGpu3DSystemDisplayWrite(_In_ VOID *pDeviceContext,
                                          _In_ VOID *Source,
                                          _In_ UINT SourceWidth,
@@ -1179,6 +1228,7 @@ VOID APIENTRY VioGpu3DSystemDisplayWrite(_In_ VOID *pDeviceContext,
     VioGpuAdapter *pAdapter = reinterpret_cast<VioGpuAdapter *>(pDeviceContext);
     pAdapter->vidpn.SystemDisplayWrite(Source, SourceWidth, SourceHeight, SourceStride, PositionX, PositionY);
 }
+#endif // VIOGPU_WIN8_DDI
 
 NTSTATUS
 APIENTRY
@@ -1199,6 +1249,7 @@ VioGpu3DDdiRestartFromTimeout(_In_ CONST HANDLE hAdapter)
     return STATUS_SUCCESS;
 };
 
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DDdiCancelCommand(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_CANCELCOMMAND *pCancelCommand)
@@ -1210,6 +1261,7 @@ VioGpu3DDdiCancelCommand(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_CANCELCO
 
     return STATUS_SUCCESS;
 };
+#endif // VIOGPU_WIN8_DDI
 
 NTSTATUS
 APIENTRY
@@ -1225,6 +1277,7 @@ VioGpu3DDdiQueryCurrentFence(_In_ CONST HANDLE hAdapter, _Inout_ DXGKARG_QUERYCU
     return STATUS_SUCCESS;
 };
 
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DDdiResetEngine(_In_ CONST HANDLE hAdapter, _Inout_ DXGKARG_RESETENGINE *pResetEngine)
@@ -1236,7 +1289,9 @@ VioGpu3DDdiResetEngine(_In_ CONST HANDLE hAdapter, _Inout_ DXGKARG_RESETENGINE *
 
     return STATUS_SUCCESS;
 };
+#endif // VIOGPU_WIN8_DDI
 
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DDdiQueryEngineStatus(_In_ CONST HANDLE hAdapter, _Inout_ DXGKARG_QUERYENGINESTATUS *pQueryEngineStatus)
@@ -1248,6 +1303,7 @@ VioGpu3DDdiQueryEngineStatus(_In_ CONST HANDLE hAdapter, _Inout_ DXGKARG_QUERYEN
 
     return STATUS_SUCCESS;
 };
+#endif // VIOGPU_WIN8_DDI
 
 // No palettized (8-bit) modes: nothing to set
 NTSTATUS
@@ -1260,6 +1316,7 @@ VioGpu3DDdiSetPalette(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_SETPALETTE
 }
 
 // The engines reset on their own: no node depends on another's
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DDdiQueryDependentEngineGroup(_In_ CONST HANDLE hAdapter,
@@ -1269,6 +1326,7 @@ VioGpu3DDdiQueryDependentEngineGroup(_In_ CONST HANDLE hAdapter,
     pQueryDependentEngineGroup->DependentNodeOrdinalMask = 0;
     return STATUS_SUCCESS;
 }
+#endif // VIOGPU_WIN8_DDI
 
 NTSTATUS
 APIENTRY
diff --git a/viogpu/viogpu3d/driver.h b/viogpu/viogpu3d/driver.h
index d4c1529..b052a2b 100644
--- a/viogpu/viogpu3d/driver.h
+++ b/viogpu/viogpu3d/driver.h
@@ -87,11 +87,13 @@ NTSTATUS
 APIENTRY
 VioGpu3DQueryAdapterInfo(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_QUERYADAPTERINFO *pQueryAdapterInfo);
 
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DDdiGetNodeMetadata(_In_ CONST HANDLE hAdapter,
                            UINT NodeOrdinal,
                            _Out_ DXGKARG_GETNODEMETADATA *pGetNodeMetadata);
+#endif // VIOGPU_WIN8_DDI
 
 NTSTATUS
 APIENTRY
@@ -217,20 +219,25 @@ VioGpu3DDdiControlInterrupt(_In_ CONST HANDLE hAdapter,
                             _In_ CONST DXGK_INTERRUPT_TYPE InterruptType,
                             _In_ BOOLEAN EnableInterrupt);
 
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DDdiControlInterrupt2(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_CONTROLINTERRUPT2 InterruptControl);
+#endif // VIOGPU_WIN8_DDI
 
 NTSTATUS
 APIENTRY
 VioGpu3DDdiGetScanLine(_In_ CONST HANDLE hAdapter, _Inout_ DXGKARG_GETSCANLINE *pGetScanLine);
 
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DStopDeviceAndReleasePostDisplayOwnership(_In_ VOID *pDeviceContext,
                                                  _In_ D3DDDI_VIDEO_PRESENT_TARGET_ID TargetId,
                                                  _Out_ DXGK_DISPLAY_INFORMATION *DisplayInfo);
+#endif // VIOGPU_WIN8_DDI
 
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DSystemDisplayEnable(_In_ VOID *pDeviceContext,
@@ -239,7 +246,9 @@ VioGpu3DSystemDisplayEnable(_In_ VOID *pDeviceContext,
                             _Out_ UINT *Width,
                             _Out_ UINT *Height,
                             _Out_ D3DDDIFORMAT *ColorFormat);
+#endif // VIOGPU_WIN8_DDI
 
+#if VIOGPU_WIN8_DDI
 VOID APIENTRY VioGpu3DSystemDisplayWrite(_In_ VOID *pDeviceContext,
                                          _In_ VOID *Source,
                                          _In_ UINT SourceWidth,
@@ -247,6 +256,7 @@ VOID APIENTRY VioGpu3DSystemDisplayWrite(_In_ VOID *pDeviceContext,
                                          _In_ UINT SourceStride,
                                          _In_ UINT PositionX,
                                          _In_ UINT PositionY);
+#endif // VIOGPU_WIN8_DDI
 
 NTSTATUS
 APIENTRY
@@ -256,9 +266,11 @@ NTSTATUS
 APIENTRY
 VioGpu3DDdiRestartFromTimeout(_In_ CONST HANDLE hAdapter);
 
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DDdiCancelCommand(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_CANCELCOMMAND *pCancelCommand);
+#endif // VIOGPU_WIN8_DDI
 
 NTSTATUS
 APIENTRY
@@ -293,22 +305,28 @@ VioGpu3DCalibrateGpuClock(_In_ CONST HANDLE hAdapter,
                           _Out_ DXGKARG_CALIBRATEGPUCLOCK *pClockCalibration);
 #endif
 
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DDdiResetEngine(_In_ CONST HANDLE hAdapter, _Inout_ DXGKARG_RESETENGINE *pResetEngine);
+#endif // VIOGPU_WIN8_DDI
 
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DDdiQueryEngineStatus(_In_ CONST HANDLE hAdapter, _Inout_ DXGKARG_QUERYENGINESTATUS *pQueryEngineStatus);
+#endif // VIOGPU_WIN8_DDI
 
 NTSTATUS
 APIENTRY
 VioGpu3DDdiSetPalette(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_SETPALETTE *pSetPalette);
 
+#if VIOGPU_WIN8_DDI
 NTSTATUS
 APIENTRY
 VioGpu3DDdiQueryDependentEngineGroup(_In_ CONST HANDLE hAdapter,
                                      _Inout_ DXGKARG_QUERYDEPENDENTENGINEGROUP *pQueryDependentEngineGroup);
+#endif // VIOGPU_WIN8_DDI
 
 NTSTATUS
 APIENTRY
diff --git a/viogpu/viogpu3d/viogpu3d.vcxproj b/viogpu/viogpu3d/viogpu3d.vcxproj
index 69a16e7..eeb9daa 100644
--- a/viogpu/viogpu3d/viogpu3d.vcxproj
+++ b/viogpu/viogpu3d/viogpu3d.vcxproj
@@ -139,12 +139,16 @@
     <ClCompile>
       <AdditionalIncludeDirectories>$(IntDir);%(AdditionalIncludeDirectories);$(DDK_INC_PATH);$(SDK_INC_PATH);..\common;..\shared;..\..\VirtIO;..\viogpu3d\;</AdditionalIncludeDirectories>
       <PreprocessorDefinitions>VIOGPU_3D=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
+      <!-- Windows 7 (build-driver.ps1 -Win7): the headers at WDDM 1.1, so nothing of Windows 8's interface compiles -->
+      <PreprocessorDefinitions Condition="'$(VIOGPU_WIN7)'=='1'">DXGKDDI_INTERFACE_VERSION=0x2005;%(PreprocessorDefinitions)</PreprocessorDefinitions>
       <WppEnabled>true</WppEnabled>
       <WppScanConfigurationData>trace.h</WppScanConfigurationData>
     </ClCompile>
     <Link>
       <AdditionalDependencies>%(AdditionalDependencies);$(KernelBufferOverflowLib);$(DDK_LIB_PATH)ntoskrnl.lib;$(DDK_LIB_PATH)hal.lib;$(DDK_LIB_PATH)wmilib.lib;$(DDK_LIB_PATH)\displib.lib;virtiolib.lib</AdditionalDependencies>
       <AdditionalLibraryDirectories>..\..\VirtIO\$(OutDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
+      <!-- Windows 7 (build-driver.ps1 -Win7): driver.cpp's VioGpuWin7Entry sets the /GS cookie first -->
+      <EntryPointSymbol Condition="'$(VIOGPU_WIN7)'=='1'">VioGpuWin7Entry</EntryPointSymbol>
     </Link>
     <PostBuildEvent>
     </PostBuildEvent>
diff --git a/viogpu/viogpu3d/viogpu_adapter.cpp b/viogpu/viogpu3d/viogpu_adapter.cpp
index 5d7ec48..30fee70 100644
--- a/viogpu/viogpu3d/viogpu_adapter.cpp
+++ b/viogpu/viogpu3d/viogpu_adapter.cpp
@@ -72,6 +72,9 @@ void VioGpuLog(_In_z_ _Printf_format_string_ const char *format, ...)
 
     // also to the kernel debugger / DebugView (kernel capture), which still works when escapes are stuck
     DbgPrintEx(DPFLTR_IHVVIDEO_ID, DPFLTR_ERROR_LEVEL, "viogpu: %s", line);
+#ifdef COM_DEBUG
+    DbgPrint(TRACE_LEVEL_FATAL, ("log: %s", line)); // (and to COM1 in the serial-trace build)
+#endif
 
     KIRQL irql;
     KeAcquireSpinLock(&g_LogLock, &irql);
@@ -473,7 +476,9 @@ NTSTATUS VioGpuAdapter::SetPowerState(_In_ ULONG HardwareUid,
     {
         if (DevicePowerState == PowerDeviceD0)
         {
+#if VIOGPU_WIN8_DDI
             vidpn.AcquirePostDisplayOwnership();
+#endif
 
             if (m_AdapterPowerState == PowerDeviceD3)
             {
@@ -624,6 +629,7 @@ NTSTATUS VioGpuAdapter::QueryAdapterInfo(_In_ CONST DXGKARG_QUERYADAPTERINFO *pQ
                 info->SupportedCapsetIDs = m_supportedCapsetIDs;
                 return STATUS_SUCCESS;
             }
+#if VIOGPU_WIN8_DDI
         case DXGKQAITYPE_HISTORYBUFFERPRECISION:
             {
                 // WDDM 1.3 asks (Windows 8.1 removed the device when it wasn't answered), one entry per node, each 0 or
@@ -640,6 +646,7 @@ NTSTATUS VioGpuAdapter::QueryAdapterInfo(_In_ CONST DXGKARG_QUERYADAPTERINFO *pQ
                 }
                 return STATUS_SUCCESS;
             }
+#endif // VIOGPU_WIN8_DDI
         case DXGKQAITYPE_DRIVERCAPS:
             {
                 if (!pQueryAdapterInfo->OutputDataSize)
@@ -663,6 +670,10 @@ NTSTATUS VioGpuAdapter::QueryAdapterInfo(_In_ CONST DXGKARG_QUERYADAPTERINFO *pQ
                 pDriverCaps->WDDMVersion = DXGKDDI_WDDMv2;
                 pDriverCaps->MemoryManagementCaps.VirtualAddressingSupported = TRUE;
                 pDriverCaps->MemoryManagementCaps.GpuMmuSupported = TRUE;
+#elif VIOGPU_WIN7
+                // Windows 7's caps end at WDDMVersion (the Windows 8 fields below would be past its buffer), and its
+                // dxgkrnl knows WDDMv1 only
+                pDriverCaps->WDDMVersion = DXGKDDI_WDDMv1;
 #else
                 pDriverCaps->WDDMVersion = DXGKDDI_WDDMv1_3;
 #endif
@@ -674,22 +685,31 @@ NTSTATUS VioGpuAdapter::QueryAdapterInfo(_In_ CONST DXGKARG_QUERYADAPTERINFO *pQ
 
                 pDriverCaps->MemoryManagementCaps.SectionBackedPrimary = TRUE;
 
+#if !VIOGPU_WIN7
                 pDriverCaps->SupportDirectFlip = 1;
+#endif
