+#pragma pack(1)
+typedef struct _VIOGPU_RES_ATTACH_REQ
+{
+    ULONG ResId;
+} VIOGPU_RES_ATTACH_REQ;
+#pragma pack()
+
 #pragma pack(1)
 typedef struct _VIOGPU_ESCAPE
