@@ -1037,10 +1039,14 @@ NTSTATUS VioGpuAdapter::Escape(_In_ CONST DXGKARG_ESCAPE *pEscape)
         case VIOGPU_BLOB_MAP:
         case VIOGPU_BLOB_DESTROY:
