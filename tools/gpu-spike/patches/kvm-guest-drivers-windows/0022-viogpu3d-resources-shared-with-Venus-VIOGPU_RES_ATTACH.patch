\ No newline at end of file
+}
+
+// The shared resources' ids (a short list: a process's swap chain buffers)
+struct SharedResource
+{
+    LIST_ENTRY entry;
+    ULONG resId;
+};
+
+void VioGpuAdapter::AddSharedResource(ULONG resId)
+{
+    PAGED_CODE();
+
+    SharedResource *shared = new (NonPagedPoolNx) SharedResource;
+    if (!shared)
+    {
+        return;
+    }
+    shared->resId = resId;
+    ExAcquireFastMutex(&m_SharedLock);
+    InsertTailList(&m_SharedResources, &shared->entry);
+    ExReleaseFastMutex(&m_SharedLock);
+}
+
+void VioGpuAdapter::RemoveSharedResource(ULONG resId)
+{
+    PAGED_CODE();
+
+    ExAcquireFastMutex(&m_SharedLock);
+    for (LIST_ENTRY *e = m_SharedResources.Flink; e != &m_SharedResources; e = e->Flink)
+    {
+        SharedResource *shared = CONTAINING_RECORD(e, SharedResource, entry);
+        if (shared->resId == resId)
+        {
+            RemoveEntryList(e);
+            delete shared;
+            break;
+        }
+    }
+    ExReleaseFastMutex(&m_SharedLock);
+}
+
+bool VioGpuAdapter::IsSharedResource(ULONG resId)
+{
+    PAGED_CODE();
+
+    bool found = false;
+    ExAcquireFastMutex(&m_SharedLock);
+    for (LIST_ENTRY *e = m_SharedResources.Flink; e != &m_SharedResources && !found; e = e->Flink)
+    {
+        found = CONTAINING_RECORD(e, SharedResource, entry)->resId == resId;
+    }
+    ExReleaseFastMutex(&m_SharedLock);
+    return found;
+}
diff --git a/viogpu/viogpu3d/viogpu_adapter.h b/viogpu/viogpu3d/viogpu_adapter.h
index e954764..252ab99 100644
--- a/viogpu/viogpu3d/viogpu_adapter.h
+++ b/viogpu/viogpu3d/viogpu_adapter.h
@@ -145,6 +145,15 @@ class VioGpuAdapter : IVioGpuPCI
     FAST_MUTEX m_HostmemLock;
     LIST_ENTRY m_HostmemRanges;
 
+    // Resources made to be shared with Venus (VIRGL_BIND_VK_SHARED): the only ones VIOGPU_RES_ATTACH attaches
+    FAST_MUTEX m_SharedLock;
+    LIST_ENTRY m_SharedResources;
+
+  public:
+    void AddSharedResource(ULONG resId);
+    void RemoveSharedResource(ULONG resId);
+    bool IsSharedResource(ULONG resId);
+
   public:
     VioGpuAdapter(_In_ DEVICE_OBJECT *pPhysicalDeviceObject);
     ~VioGpuAdapter(void);
diff --git a/viogpu/viogpu3d/viogpu_allocation.cpp b/viogpu/viogpu3d/viogpu_allocation.cpp
index 279605b..edd53eb 100644
--- a/viogpu/viogpu3d/viogpu_allocation.cpp
+++ b/viogpu/viogpu3d/viogpu_allocation.cpp
@@ -15,6 +15,10 @@ VioGpuAllocation::VioGpuAllocation(VioGpuAdapter *adapter, VIOGPU_RESOURCE_OPTIO
 
     // m_adapter->ctrlQueue.CreateResource(m_Id, m_options.format, m_options.width, m_options.height);
     m_adapter->ctrlQueue.CreateResource3D(m_Id, options);
+    if (options->bind & VIRGL_BIND_VK_SHARED)
+    {
+        m_adapter->AddSharedResource(m_Id);
+    }
 
     m_pMDL = NULL;
     m_pageCount = 0;
@@ -30,6 +34,10 @@ VioGpuAllocation::VioGpuAllocation(VioGpuAdapter *adapter, VIOGPU_RESOURCE_OPTIO
 VioGpuAllocation::~VioGpuAllocation(void)
 {
     DbgPrint(TRACE_LEVEL_INFORMATION, ("---> %s res_id=%d\n", __FUNCTION__, m_Id));
+    if (m_options.bind & VIRGL_BIND_VK_SHARED)
+    {
+        m_adapter->RemoveSharedResource(m_Id);
+    }
     m_adapter->ctrlQueue.DestroyResource(m_Id);
     m_adapter->resourceIdr.PutId(m_Id);
     m_adapter->UnchargeAllocation(m_ChargedSize);
diff --git a/viogpu/viogpu3d/viogpu_device.cpp b/viogpu/viogpu3d/viogpu_device.cpp
index 858463b..e9ea05a 100644
--- a/viogpu/viogpu3d/viogpu_device.cpp
+++ b/viogpu/viogpu3d/viogpu_device.cpp
@@ -281,6 +281,20 @@ void VioGpuDevice::DestroyBlob(Blob *blob)
     delete blob;
 }
 
+// A shared resource (VIOGPU_RES_ATTACH_REQ) to this device's context; only those: any other would hand another
+// process's textures to this one
+NTSTATUS VioGpuDevice::ResAttach(ULONG resId)
+{
+    PAGED_CODE();
+
+    if (!m_pAdapter->IsSharedResource(resId))
+    {
+        return STATUS_ACCESS_DENIED;
+    }
+    m_pAdapter->ctrlQueue.AttachResource(m_id, resId);
+    return STATUS_SUCCESS;
+}
+
 NTSTATUS VioGpuDevice::BlobDestroy(ULONG resId)
 {
     PAGED_CODE();
