+// A D3D12 queue (VIOGPU_QUEUE_REGISTER), in the calling process: its semaphore referenced for the markers to release
+NTSTATUS VioGpuAdapter::RegisterVenusQueue(HANDLE semaphore, PVOID owner, ULONG *queue)
+{
+    PAGED_CODE();
+
+    PKSEMAPHORE object = NULL;
+    NTSTATUS status = ObReferenceObjectByHandle(semaphore, SEMAPHORE_MODIFY_STATE, *ExSemaphoreObjectType, UserMode,
+                                                (PVOID *)&object, NULL);
+    if (!NT_SUCCESS(status))
+    {
+        VioGpuLog("venus queue registration: semaphore 0x%I64x: 0x%08x", (UINT64)(ULONG_PTR)semaphore, status);
+        return status;
+    }
+    KIRQL irql;
+    KeAcquireSpinLock(&m_VenusLock, &irql);
+    ULONG i = 0;
+    while (i < MaxVenusQueues && m_VenusQueues[i].semaphore)
+    {
+        i++;
+    }
+    if (i < MaxVenusQueues)
+    {
+        m_VenusQueues[i].semaphore = object;
+        m_VenusQueues[i].owner = owner;
+        m_VenusQueues[i].process = PsGetCurrentProcess();
+        ObReferenceObject(m_VenusQueues[i].process);
+        m_VenusQueues[i].gated = 0;
+        m_VenusQueues[i].done = 0;
+    }
+    KeReleaseSpinLock(&m_VenusLock, irql);
+    if (i == MaxVenusQueues)
+    {
+        ObDereferenceObject(object);
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+    *queue = i;
+    VioGpuLog("venus queue %u registered", i);
+    return STATUS_SUCCESS;
+}
+
+void VioGpuAdapter::UnregisterVenusQueue(ULONG queue, PVOID owner)
+{
+    PAGED_CODE();
+
+    PKSEMAPHORE object = NULL;
+    PEPROCESS process = NULL;
+    KIRQL irql;
+    KeAcquireSpinLock(&m_VenusLock, &irql);
+    if (queue < MaxVenusQueues && m_VenusQueues[queue].semaphore && m_VenusQueues[queue].owner == owner)
+    {
+        object = m_VenusQueues[queue].semaphore;
+        process = m_VenusQueues[queue].process;
+        m_VenusQueues[queue].semaphore = NULL;
+        m_VenusQueues[queue].owner = NULL;
+        m_VenusQueues[queue].process = NULL;
+    }
+    KeReleaseSpinLock(&m_VenusLock, irql);
+    if (object)
+    {
+        ObDereferenceObject(object);
+        ObDereferenceObject(process);
+    }
+}
+
+// The device's queues, when it goes (the process exited, or didn't clean up)
+void VioGpuAdapter::UnregisterVenusQueues(PVOID owner)
+{
+    PAGED_CODE();
+
+    for (ULONG i = 0; i < MaxVenusQueues; i++)
+    {
+        UnregisterVenusQueue(i, owner);
+    }
+}
+
+// A marker taken: its queue's lists up to seq may run (the semaphore released once for each not released yet; a
+// marker handed over again after a preemption opens nothing)
+void VioGpuAdapter::GateVenusQueue(ULONG queue, UINT64 seq)
+{
+    KIRQL irql;
+    KeAcquireSpinLock(&m_VenusLock, &irql);
+    if (queue < MaxVenusQueues && m_VenusQueues[queue].semaphore && seq > m_VenusQueues[queue].gated)
+    {
+        LONG count = (LONG)(seq - m_VenusQueues[queue].gated);
+        m_VenusQueues[queue].gated = seq;
+        KeReleaseSemaphore(m_VenusQueues[queue].semaphore, IO_NO_INCREMENT, count, FALSE);
+    }
+    KeReleaseSpinLock(&m_VenusLock, irql);
+}
+
+// How far the queue's lists are done; a queue gone, or whose process is exiting (its threads that report it are
+// gone, and Windows waits for its work before it tears the process down), has nothing left to wait for
+UINT64 VioGpuAdapter::VenusQueueDone(ULONG queue)
+{
+    UINT64 done = MAXULONG64;
+    KIRQL irql;
+    KeAcquireSpinLock(&m_VenusLock, &irql);
+    if (queue < MaxVenusQueues && m_VenusQueues[queue].semaphore &&
+        PsGetProcessExitStatus(m_VenusQueues[queue].process) == STATUS_PENDING)
+    {
+        done = m_VenusQueues[queue].done;
+    }
+    KeReleaseSpinLock(&m_VenusLock, irql);
+    return done;
+}
+
+NTSTATUS VioGpuAdapter::SetVenusQueueDone(ULONG queue, PVOID owner, UINT64 done)
+{
+    NTSTATUS status = STATUS_INVALID_PARAMETER;
+    KIRQL irql;
+    KeAcquireSpinLock(&m_VenusLock, &irql);
+    if (queue < MaxVenusQueues && m_VenusQueues[queue].semaphore && m_VenusQueues[queue].owner == owner)
+    {
+        if (done > m_VenusQueues[queue].done)
+        {
+            m_VenusQueues[queue].done = done;
+        }
+        status = STATUS_SUCCESS;
+    }
+    KeReleaseSpinLock(&m_VenusLock, irql);
+    return status;
+}
