+#if VIOGPU_WDDM2
+        case DXGK_OPERATION_UPDATE_PAGE_TABLE:
+            {
+                // Page tables the CPU updates: copy the entries in. Nothing reads them but Windows itself (the
+                // virtual GPU's commands name host resources), so this is all a page table update takes
+                DXGK_PTE *pte = (DXGK_PTE *)pBuildPagingBuffer->UpdatePageTable.PageTableAddress.CpuVirtual;
+                const DXGK_PTE *src = pBuildPagingBuffer->UpdatePageTable.pPageTableEntries;
+                if (pte == NULL || src == NULL)
+                {
+                    return STATUS_SUCCESS;
+                }
+                const UINT step = pBuildPagingBuffer->UpdatePageTable.Flags.Repeat ? 0 : 1;
+                pte += pBuildPagingBuffer->UpdatePageTable.StartIndex;
+                for (UINT i = 0; i < pBuildPagingBuffer->UpdatePageTable.NumPageTableEntries; i++, src += step)
+                {
+                    pte[i] = *src;
+                }
+                return STATUS_SUCCESS;
+            }
+        case DXGK_OPERATION_FLUSH_TLB:
+        case DXGK_OPERATION_UPDATE_CONTEXT_ALLOCATION:
+        case DXGK_OPERATION_NOTIFY_RESIDENCY:
+        case DXGK_OPERATION_DISCARD_CONTENT:
+            // No TLB, no context allocations, nothing to do on residency changes or discards
+            return STATUS_SUCCESS;
+#endif
         default:
             {
                 DbgPrint(TRACE_LEVEL_ERROR,
@@ -599,6 +713,34 @@
     return pAdapter->commander.SubmitCommand(pSubmitCommand);
 };
 
+#if VIOGPU_WDDM2
+// A command buffer addressed by GPU virtual address (a user-mode driver that uses GPU virtual addresses, Direct3D 12).
+// Its private data is the user-mode driver's, not a VioGpuCommand: the submission completes in order with the
+// device's other work
+NTSTATUS
+APIENTRY
+VioGpu3DSubmitCommandVirtual(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_SUBMITCOMMANDVIRTUAL *pSubmitCommand)
+{
+    VIOGPU_ASSERT_CHK(hAdapter != NULL);
+
+    VioGpuAdapter *pAdapter = reinterpret_cast<VioGpuAdapter *>(hAdapter);
+    if (!pAdapter->IsDriverActive())
+    {
+        return STATUS_UNSUCCESSFUL;
+    }
+    DXGKARG_SUBMITCOMMAND submit = {};
+    submit.hContext = pSubmitCommand->hContext;
+    submit.DmaBufferSize = pSubmitCommand->DmaBufferSize;
+    submit.SubmissionFenceId = pSubmitCommand->SubmissionFenceId;
+    submit.VidPnSourceId = pSubmitCommand->VidPnSourceId;
+    submit.FlipInterval = pSubmitCommand->FlipInterval;
+    submit.Flags = pSubmitCommand->Flags;
+    submit.EngineOrdinal = pSubmitCommand->EngineOrdinal;
+    submit.NodeOrdinal = pSubmitCommand->NodeOrdinal;
+    return pAdapter->commander.SubmitCommand(&submit);
+}
+#endif
