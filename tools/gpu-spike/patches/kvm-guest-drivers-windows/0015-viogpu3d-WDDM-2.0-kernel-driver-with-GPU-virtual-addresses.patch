+// On the worker thread, after the completions it notified
+void VioGpuCommander::NotifyPreemptionIfIdle()
+{
+    PAGED_CODE();
+
+    KIRQL oldIrql;
+    LockQueue(&oldIrql);
+    UINT preemptionFence = 0;
+    UINT lastCompletedFence = m_lastCompletedFence;
+    if (m_preemptionFence != 0 && m_pending == 0)
+    {
+        preemptionFence = m_preemptionFence;
+        m_preemptionFence = 0;
+    }
+    UnlockQueue(oldIrql);
+    if (preemptionFence == 0)
+    {
+        return;
+    }
+
+    DXGKARGCB_NOTIFY_INTERRUPT_DATA interrupt = {};
+    interrupt.InterruptType = DXGK_INTERRUPT_DMA_PREEMPTED;
+    interrupt.DmaPreempted.PreemptionFenceId = preemptionFence;
+    interrupt.DmaPreempted.LastCompletedFenceId = lastCompletedFence;
+    interrupt.DmaPreempted.NodeOrdinal = 0;
+    interrupt.DmaPreempted.EngineOrdinal = 0;
+    m_pAdapter->NotifyInterrupt(&interrupt, true);
+}
