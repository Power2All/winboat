+VioGpu3DCreateProcess(_In_ CONST HANDLE hAdapter, _Inout_ DXGKARG_CREATEPROCESS *pArgs)
+{
+    PAGED_CODE();
+    UNREFERENCED_PARAMETER(hAdapter);
