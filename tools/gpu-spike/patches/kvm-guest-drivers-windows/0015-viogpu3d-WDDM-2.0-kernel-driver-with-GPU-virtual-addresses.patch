+APIENTRY
+VioGpu3DDestroyProcess(_In_ CONST HANDLE hAdapter, _In_ CONST HANDLE hKmdProcess)
+{
+    PAGED_CODE();
+    UNREFERENCED_PARAMETER(hAdapter);
+    UNREFERENCED_PARAMETER(hKmdProcess);
+    return STATUS_SUCCESS;
+}
+
+VOID APIENTRY VioGpu3DSetRootPageTable(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_SETROOTPAGETABLE *pSetPageTable)
+{
+    PAGED_CODE();
+    UNREFERENCED_PARAMETER(hAdapter);
+    UNREFERENCED_PARAMETER(pSetPageTable);
+}
+
+SIZE_T
+APIENTRY
+VioGpu3DGetRootPageTableSize(_In_ CONST HANDLE hAdapter, _Inout_ DXGKARG_GETROOTPAGETABLESIZE *pArgs)
+{
+    PAGED_CODE();
+    UNREFERENCED_PARAMETER(hAdapter);
+    return (SIZE_T)pArgs->NumberOfPte * sizeof(DXGK_PTE);
+}
+
+// Stable clocks for profiling: the virtual GPU has no clocks of its own
+VOID APIENTRY VioGpu3DSetStablePowerState(_In_ CONST HANDLE hAdapter, _In_ CONST DXGKARG_SETSTABLEPOWERSTATE *pArgs)
+{
+    PAGED_CODE();
+    UNREFERENCED_PARAMETER(hAdapter);
+    UNREFERENCED_PARAMETER(pArgs);
+}
+
+NTSTATUS
+APIENTRY
+VioGpu3DCalibrateGpuClock(_In_ CONST HANDLE hAdapter,
+                          _In_ UINT32 NodeOrdinal,
+                          _In_ UINT32 EngineOrdinal,
+                          _Out_ DXGKARG_CALIBRATEGPUCLOCK *pClockCalibration)
+{
+    PAGED_CODE();
+    UNREFERENCED_PARAMETER(hAdapter);
+    UNREFERENCED_PARAMETER(NodeOrdinal);
+    UNREFERENCED_PARAMETER(EngineOrdinal);
+    // The virtual GPU's timestamps are the guest's performance counter
+    LARGE_INTEGER frequency;
+    LARGE_INTEGER counter = KeQueryPerformanceCounter(&frequency);
+    RtlZeroMemory(pClockCalibration, sizeof(*pClockCalibration));
+    pClockCalibration->GpuFrequency = frequency.QuadPart;
+    pClockCalibration->GpuClockCounter = counter.QuadPart;
+    pClockCalibration->CpuClockCounter = counter.QuadPart;
+    return STATUS_SUCCESS;
+}
+#endif
