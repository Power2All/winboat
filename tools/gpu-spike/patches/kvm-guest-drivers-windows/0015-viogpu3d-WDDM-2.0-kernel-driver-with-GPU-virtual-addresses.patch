+#if VIOGPU_WDDM2
+        case DXGKQAITYPE_QUERYSEGMENT4:
+            {
+                // The same aperture segment as with WDDM 1.3 (QUERYSEGMENT3): the allocations the D3D/OpenGL drivers
+                // use are accessed physically and stay there. GpuMmu adds the system memory segment (2)
+                if (pQueryAdapterInfo->OutputDataSize < sizeof(DXGK_QUERYSEGMENTOUT4))
+                {
+                    return STATUS_BUFFER_TOO_SMALL;
+                }
+                DXGK_QUERYSEGMENTOUT4 *pSegmentInfo = (DXGK_QUERYSEGMENTOUT4 *)pQueryAdapterInfo->pOutputData;
+                if (!pSegmentInfo->pSegmentDescriptor)
+                {
+                    pSegmentInfo->NbSegment = 1;
+                    return STATUS_SUCCESS;
+                }
+                // Paging buffers in system memory (segment 0): the CPU fills them, and the aperture isn't CPU-visible.
+                // Their private data is the size every context reports (VioGpu3DDdiCreateContext)
+                pSegmentInfo->PagingBufferPrivateDataSize = 40;
+                pSegmentInfo->PagingBufferSegmentId = 0;
+                pSegmentInfo->PagingBufferSize = 10 * PAGE_SIZE;
+
+                DXGK_SEGMENTDESCRIPTOR4 *pSegmentDesc = (DXGK_SEGMENTDESCRIPTOR4 *)pSegmentInfo->pSegmentDescriptor;
+                memset(pSegmentDesc, 0, pSegmentInfo->SegmentDescriptorStride ? pSegmentInfo->SegmentDescriptorStride
+                                                                               : sizeof(*pSegmentDesc));
+                pSegmentDesc->BaseAddress.QuadPart = 0xC0000000;
+                pSegmentDesc->Flags.Aperture = TRUE;
+                pSegmentDesc->Flags.CacheCoherent = TRUE;
+                pSegmentDesc->Flags.CpuVisible = FALSE;
+                pSegmentDesc->Flags.DirectFlip = TRUE;
+                pSegmentDesc->Size = 256 * 1024 * 4096;
+                pSegmentDesc->CommitLimit = 256 * 1024 * 4096;
+                return STATUS_SUCCESS;
+            }
+        case DXGKQAITYPE_GPUMMUCAPS:
+            {
+                if (pQueryAdapterInfo->OutputDataSize < sizeof(DXGK_GPUMMUCAPS))
+                {
+                    return STATUS_BUFFER_TOO_SMALL;
+                }
+                DXGK_GPUMMUCAPS *pCaps = (DXGK_GPUMMUCAPS *)pQueryAdapterInfo->pOutputData;
+                RtlZeroMemory(pCaps, sizeof(*pCaps));
+                pCaps->ZeroInPteSupported = 1;
+                pCaps->CacheCoherentMemorySupported = 1;
+                pCaps->PageTableUpdateMode = DXGK_PAGETABLEUPDATE_CPU_VIRTUAL;
+                pCaps->VirtualAddressBitCount = VIOGPU_GPU_VA_BITS;
+                pCaps->PageTableLevelCount = VIOGPU_PAGE_TABLE_LEVELS;
+                return STATUS_SUCCESS;
+            }
+        case DXGKQAITYPE_PAGETABLELEVELDESC:
+            {
