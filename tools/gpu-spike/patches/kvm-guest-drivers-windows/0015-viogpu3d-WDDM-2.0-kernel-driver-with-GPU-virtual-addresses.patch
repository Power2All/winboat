diff --git a/viogpu/viogpu3d/viogpu_adapter.cpp b/viogpu/viogpu3d/viogpu_adapter.cpp
--- a/viogpu/viogpu3d/viogpu_adapter.cpp
+++ b/viogpu/viogpu3d/viogpu_adapter.cpp
@@ -38,6 +38,69 @@
 #include "viogpudo.tmh"
 #endif
 
+#include <ntstrsafe.h>
+
+#pragma code_seg(push)
+#pragma code_seg()
+static char g_LogRing[32768];
+static ULONG g_LogPos; // bytes written so far (the ring holds the last sizeof(g_LogRing))
+static KSPIN_LOCK g_LogLock;
+static LONG g_LogInit;
+
+void VioGpuLog(_In_z_ _Printf_format_string_ const char *format, ...)
+{
+    if (InterlockedCompareExchange(&g_LogInit, 1, 0) == 0)
+    {
+        KeInitializeSpinLock(&g_LogLock);
+        InterlockedExchange(&g_LogInit, 2);
+    }
+    while (g_LogInit != 2)
+    {
+    }
+    char line[256];
+    va_list args;
+    va_start(args, format);
+    RtlStringCbVPrintfA(line, sizeof(line) - 2, format, args);
+    va_end(args);
+    size_t length = 0;
+    RtlStringCbLengthA(line, sizeof(line), &length);
+    line[length++] = '\n';
+    line[length] = 0;
+
+    // also to the kernel debugger / DebugView (kernel capture), which still works when escapes are stuck
+    DbgPrintEx(DPFLTR_IHVVIDEO_ID, DPFLTR_ERROR_LEVEL, "viogpu: %s", line);
+
+    KIRQL irql;
+    KeAcquireSpinLock(&g_LogLock, &irql);
+    for (size_t i = 0; i < length; i++)
+    {
+        g_LogRing[(g_LogPos + i) % sizeof(g_LogRing)] = line[i];
+    }
+    g_LogPos += (ULONG)length;
+    KeReleaseSpinLock(&g_LogLock, irql);
+}
+
+// The log, oldest first, into a nonpaged copy (the caller copies it out at PASSIVE_LEVEL)
+static ULONG VioGpuLogSnapshot(char *out, ULONG size)
+{
+    if (g_LogInit != 2)
+    {
+        return 0;
+    }
+    KIRQL irql;
+    KeAcquireSpinLock(&g_LogLock, &irql);
+    ULONG available = min(g_LogPos, (ULONG)sizeof(g_LogRing));
+    ULONG count = min(available, size);
+    ULONG start = g_LogPos - count;
+    for (ULONG i = 0; i < count; i++)
+    {
+        out[i] = g_LogRing[(start + i) % sizeof(g_LogRing)];
+    }
+    KeReleaseSpinLock(&g_LogLock, irql);
+    return count;
+}
