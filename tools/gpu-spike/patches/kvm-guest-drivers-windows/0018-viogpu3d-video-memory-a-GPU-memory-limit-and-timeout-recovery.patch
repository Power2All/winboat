+// An abandoned command: its allocations are no longer busy for it, and it is gone
+void VioGpuCommand::Discard()
+{
+    PAGED_CODE();
+    if (m_allocations)
+    {
+        for (UINT i = 0; i < m_allocationsLength; i++)
+        {
+            if (m_allocations[i])
+            {
+                m_allocations[i]->UnmarkBusy();
+            }
+        }
+        delete m_allocations;
+    }
+    delete this;
+}
