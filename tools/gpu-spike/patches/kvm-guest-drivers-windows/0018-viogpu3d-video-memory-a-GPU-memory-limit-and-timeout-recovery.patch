 {
     KIRQL oldIrql;
     LockQueue(&oldIrql);
     InsertTailList(&m_SubmittedQueue, &cmd->list_entry);
     m_pending++;
+    cmd->m_generation = m_generation;
     UnlockQueue(oldIrql);
 
     KeSetEvent(&m_QueueEvent, IO_NO_INCREMENT, FALSE);
