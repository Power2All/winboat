diff --git a/viogpu/viogpu3d/viogpu_adapter.h b/viogpu/viogpu3d/viogpu_adapter.h
index 53b7947..e954764 100644
--- a/viogpu/viogpu3d/viogpu_adapter.h
+++ b/viogpu/viogpu3d/viogpu_adapter.h
@@ -110,6 +110,38 @@ class VioGpuAdapter : IVioGpuPCI
     // HOSTMEM_RANGEs, sorted by offset
     PHYSICAL_ADDRESS m_HostmemPA;
     ULONGLONG m_HostmemSize;
+
+    // GPU resource memory in use, and its limit (GpuMemoryLimitMB)
+    volatile LONG64 m_AllocatedBytes = 0;
+    ULONGLONG m_AllocationLimit = 8192ULL << 20;
+
+  public:
+    // Charges a new resource's size to the limit; false (nothing charged) when it would go over
+    bool ChargeAllocation(ULONGLONG size)
+    {
+        if ((ULONGLONG)InterlockedAdd64(&m_AllocatedBytes, (LONG64)size) > m_AllocationLimit)
+        {
+            InterlockedAdd64(&m_AllocatedBytes, -(LONG64)size);
+            return false;
+        }
+        return true;
+    }
+    void UnchargeAllocation(ULONGLONG size)
+    {
+        InterlockedAdd64(&m_AllocatedBytes, -(LONG64)size);
+    }
+    ULONGLONG AllocationLimit() const
+    {
+        return m_AllocationLimit;
+    }
+
+    // The system memory segment GpuMmu adds, after ours (helper.h)
+    UINT SysmemSegmentId() const
+    {
+        return m_HostmemSize ? 3 : 2;
+    }
+
+  private:
     FAST_MUTEX m_HostmemLock;
     LIST_ENTRY m_HostmemRanges;
 
