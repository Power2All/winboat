+// GPU timeout recovery: a new generation, with nothing running or pending. Nonpaged and without waits: what was
+// queued is discarded by the worker thread, a command the host still holds when its reply comes (or never)
+void VioGpuCommander::Reset()
+{
+    KIRQL oldIrql;
+    LockQueue(&oldIrql);
+    m_generation++;
+    m_running = 0;
+    m_pending = 0;
+    m_preemptionFence = 0;
+    UnlockQueue(oldIrql);
+    VioGpuLog("GPU timeout: reset, the work submitted so far is abandoned\n");
+    KeSetEvent(&m_QueueEvent, IO_NO_INCREMENT, FALSE);
+}
