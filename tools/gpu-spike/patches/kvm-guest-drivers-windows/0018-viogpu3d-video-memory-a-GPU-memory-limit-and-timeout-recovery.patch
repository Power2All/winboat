@@ -1151,9 +1151,8 @@ NTSTATUS
 APIENTRY
 VioGpu3DDdiRestartFromTimeout(_In_ CONST HANDLE hAdapter)
 {
+    // Nothing to restart: the reset left the commander running
     UNREFERENCED_PARAMETER(hAdapter);
-    DbgPrint(TRACE_LEVEL_ERROR, ("<---> %s UNSUPPORTED PREEMPTION FUNCTION\n", __FUNCTION__));
-
     return STATUS_SUCCESS;
 };
 
@@ -1221,10 +1220,9 @@ NTSTATUS
 APIENTRY
 VioGpu3DDdiResetFromTimeout(_In_ CONST HANDLE hAdapter)
 {
-    UNREFERENCED_PARAMETER(hAdapter);
-
-    DbgPrint(TRACE_LEVEL_ERROR, ("<---> %s UNSUPPORTED PREEMPTION FUNCTION\n", __FUNCTION__));
-
+    // A GPU timeout (TDR): what was submitted is abandoned, and the commander takes new work at once. Commands the
+    // host still holds complete into the void; Windows recreates the devices it had
+    reinterpret_cast<VioGpuAdapter *>(hAdapter)->commander.Reset();
     return STATUS_SUCCESS;
 };
 
