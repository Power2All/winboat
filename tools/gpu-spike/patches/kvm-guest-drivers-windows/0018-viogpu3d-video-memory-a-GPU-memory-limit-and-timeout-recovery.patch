@@ -761,6 +764,18 @@ NTSTATUS VioGpuAdapter::QueryAdapterInfo(_In_ CONST DXGKARG_QUERYADAPTERINFO *pQ
                 pSegmentDesc->Flags.DirectFlip = TRUE;
