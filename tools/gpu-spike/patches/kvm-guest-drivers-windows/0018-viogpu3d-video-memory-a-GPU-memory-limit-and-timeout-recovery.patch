+// A resource's size on the host, estimated from its description: 4 bytes a texel (most formats; wider ones are
+// undercounted), all layers, samples and mip levels (a full chain adds a third); buffers are their width in bytes.
+// ponytail: a per-format texel size table if wide formats (RGBA16F/32F) need counting exactly
+static ULONGLONG HostSize(const VIOGPU_RESOURCE_OPTIONS *o)
+{
+    if (o->target == 0) // PIPE_BUFFER
+    {
+        return o->width;
+    }
+    ULONGLONG size = (ULONGLONG)o->width * max(o->height, 1UL) * max(o->depth, 1UL) * max(o->array_size, 1UL) *
+                     max(o->nr_samples, 1UL) * 4;
+    return o->last_level ? size + size / 3 : size;
+}
+
 NTSTATUS VioGpuAllocation::DxgkCreateAllocation(VioGpuAdapter *adapter, DXGKARG_CREATEALLOCATION *pCreateAllocation)
 {
     PAGED_CODE();
@@ -291,10 +306,29 @@ NTSTATUS VioGpuAllocation::DxgkCreateAllocation(VioGpuAdapter *adapter, DXGKARG_
         resourceExchange = (VIOGPU_CREATE_ALLOCATION_EXCHANGE *)pCreateAllocation->pPrivateDriverData;
     }
 
+    // Over the VM's GPU memory limit: out of memory, as a full graphics card answers. Charged by the resource's own
+    // size: textures the CPU never maps have no guest memory (Size 0) and live on the host only
+    ULONGLONG charge = HostSize(&resourceExchange->ResourceOptions);
+    if (charge < resourceExchange->Size)
+    {
+        charge = resourceExchange->Size;
+    }
+    if (!adapter->ChargeAllocation(charge))
+    {
+        static LONG logged;
+        if (!InterlockedExchange(&logged, 1))
+        {
+            VioGpuLog("GPU memory limit reached (%I64u MB): resources over it fail with out-of-memory\n",
+                      adapter->AllocationLimit() >> 20);
+        }
+        return STATUS_NO_MEMORY;
+    }
+
     VIOGPU_RESOURCE_OPTIONS options = resourceExchange->ResourceOptions;
     bool gdiSurface = (options.flags & VIOGPU_RESOURCE_FLAG_GDI_SURFACE) != 0;
     options.flags &= ~VIOGPU_RESOURCE_FLAG_GDI_SURFACE;
     VioGpuAllocation *allocation = new (NonPagedPoolNx) VioGpuAllocation(adapter, &options);
+    allocation->m_ChargedSize = charge;
     allocationInfo->hAllocation = allocation;
     if (gdiSurface)
     {
