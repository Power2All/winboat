-    {
-        result = RemoveHeadList(&m_SubmittedQueue);
-    }
-    UnlockQueue(oldIrql);
-    if (!result)
-    {
-        return NULL;
-    }
-    return CONTAINING_RECORD(result, VioGpuCommand, list_entry);
-}
-
