 #define VIOGPU_GPU_VA_BITS           (VIOGPU_PAGE_TABLE_LEVELS * VIOGPU_PAGE_TABLE_INDEX_BITS + 12)
-// The aperture segment is segment 1, so the system memory segment GpuMmu adds is segment 2
-#define VIOGPU_SYSMEM_SEGMENT_ID     2
+// The aperture segment is segment 1; with a host-visible memory window, segment 2 reports it as the adapter's local
+// (dedicated) memory. The system memory segment GpuMmu adds comes after them: VioGpuAdapter::SysmemSegmentId()
 
 // A diagnostic log kept in memory (32 KB, oldest lines dropped), read with the VIOGPU_GET_LOG escape. Any IRQL up to
 // DISPATCH_LEVEL
