-VOID VioGpuVidPN::BuildVideoSignalInfo(D3DKMDT_VIDEO_SIGNAL_INFO *pVideoSignalInfo, PVIDEO_MODE_INFORMATION pModeInfo)
+// The refresh rates every mode is offered at: the vblank timer runs at the one Windows commits, so a SPICE client
+// on a faster monitor can get the frames it shows (WinBoat picks the rate of the monitor the viewer is on)
+static const UINT g_RefreshRates[] = {60, 75, 90, 100, 120, 144, 165, 180, 240};
+#define DEFAULT_REFRESH_RATE 60
+
+VOID VioGpuVidPN::BuildVideoSignalInfo(D3DKMDT_VIDEO_SIGNAL_INFO *pVideoSignalInfo,
+                                       PVIDEO_MODE_INFORMATION pModeInfo,
+                                       UINT RefreshRate)
 {
     PAGED_CODE();
 
@@ -979,11 +1021,11 @@ VOID VioGpuVidPN::BuildVideoSignalInfo(D3DKMDT_VIDEO_SIGNAL_INFO *pVideoSignalIn
     pVideoSignalInfo->TotalSize.cy = pModeInfo->VisScreenHeight;
 
 #if 1
-    pVideoSignalInfo->VSyncFreq.Numerator = 148500000;
-    pVideoSignalInfo->VSyncFreq.Denominator = 2475000;
-    pVideoSignalInfo->HSyncFreq.Numerator = 67500;
+    pVideoSignalInfo->VSyncFreq.Numerator = RefreshRate;
+    pVideoSignalInfo->VSyncFreq.Denominator = 1;
+    pVideoSignalInfo->HSyncFreq.Numerator = RefreshRate * pModeInfo->VisScreenHeight;
     pVideoSignalInfo->HSyncFreq.Denominator = 1;
-    pVideoSignalInfo->PixelRate = 148500000;
+    pVideoSignalInfo->PixelRate = (SIZE_T)RefreshRate * pModeInfo->VisScreenWidth * pModeInfo->VisScreenHeight;
 #else
 
     pVideoSignalInfo->VSyncFreq.Numerator = D3DKMDT_FREQUENCY_NOTSPECIFIED;
@@ -1008,7 +1050,7 @@ NTSTATUS VioGpuVidPN::AddSingleTargetMode(_In_ CONST DXGK_VIDPNTARGETMODESET_INT
     D3DKMDT_VIDPN_TARGET_MODE *pVidPnTargetModeInfo = NULL;
     NTSTATUS Status = STATUS_SUCCESS;
 
-    for (UINT ModeIndex = 0; ModeIndex < GetModeCount(); ++ModeIndex)
+    for (UINT RateIndex = 0; RateIndex < ARRAYSIZE(g_RefreshRates); ++RateIndex)
     {
         PVIDEO_MODE_INFORMATION pModeInfo = &m_ModeInfo[SourceId];
         pVidPnTargetModeInfo = NULL;
@@ -1022,10 +1064,11 @@ NTSTATUS VioGpuVidPN::AddSingleTargetMode(_In_ CONST DXGK_VIDPNTARGETMODESET_INT
             return Status;
         }
         pVidPnTargetModeInfo->VideoSignalInfo.ActiveSize = pVidPnTargetModeInfo->VideoSignalInfo.TotalSize;
-        BuildVideoSignalInfo(&pVidPnTargetModeInfo->VideoSignalInfo, pModeInfo);
+        BuildVideoSignalInfo(&pVidPnTargetModeInfo->VideoSignalInfo, pModeInfo, g_RefreshRates[RateIndex]);
 
-        pVidPnTargetModeInfo->Preference = D3DKMDT_MP_NOTPREFERRED; // TODO: another logic for prefferred mode. Maybe
-                                                                    // the pinned source mode
+        // 60 Hz unless a faster rate is asked for
