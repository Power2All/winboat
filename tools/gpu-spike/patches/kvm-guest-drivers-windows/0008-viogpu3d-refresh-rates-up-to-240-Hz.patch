+                                                                                              : D3DKMDT_MP_NOTPREFERRED;
 
         Status = pVidPnTargetModeSetInterface->pfnAddMode(hVidPnTargetModeSet, pVidPnTargetModeInfo);
         if (!NT_SUCCESS(Status))
@@ -1071,7 +1114,7 @@ NTSTATUS VioGpuVidPN::AddSingleMonitorMode(_In_ CONST DXGKARG_RECOMMENDMONITORMO
 
     pVbeModeInfo = &m_ModeInfo[m_CurrentModeIndex];
 
-    BuildVideoSignalInfo(&pMonitorSourceMode->VideoSignalInfo, pVbeModeInfo);
+    BuildVideoSignalInfo(&pMonitorSourceMode->VideoSignalInfo, pVbeModeInfo, DEFAULT_REFRESH_RATE);
 
     pMonitorSourceMode->Origin = D3DKMDT_MCO_DRIVER;
     pMonitorSourceMode->Preference = D3DKMDT_MP_PREFERRED;
@@ -1106,8 +1149,9 @@ NTSTATUS VioGpuVidPN::AddSingleMonitorMode(_In_ CONST DXGKARG_RECOMMENDMONITORMO
         return Status;
     }
 
-    for (UINT Idx = 0; Idx < GetModeCount(); ++Idx)
+    for (UINT ModeRate = 0; ModeRate < GetModeCount() * ARRAYSIZE(g_RefreshRates); ++ModeRate)
     {
+        UINT Idx = ModeRate / ARRAYSIZE(g_RefreshRates);
         pVbeModeInfo = &m_ModeInfo[Idx];
 
         Status = pRecommendMonitorModes->pMonitorSourceModeSetInterface->pfnCreateNewModeInfo(pRecommendMonitorModes->hMonitorSourceModeSet,
@@ -1127,7 +1171,9 @@ NTSTATUS VioGpuVidPN::AddSingleMonitorMode(_In_ CONST DXGKARG_RECOMMENDMONITORMO
                   pVbeModeInfo->VisScreenWidth,
                   pVbeModeInfo->VisScreenHeight));
 
-        BuildVideoSignalInfo(&pMonitorSourceMode->VideoSignalInfo, pVbeModeInfo);
+        BuildVideoSignalInfo(&pMonitorSourceMode->VideoSignalInfo,
+                             pVbeModeInfo,
+                             g_RefreshRates[ModeRate % ARRAYSIZE(g_RefreshRates)]);
 
         pMonitorSourceMode->Origin = D3DKMDT_MCO_DRIVER;
         pMonitorSourceMode->Preference = D3DKMDT_MP_NOTPREFERRED;
@@ -1696,14 +1742,47 @@ int VioGpuVidPN::ProcessEdid(void)
     if (virtio_is_feature_enabled(m_pAdapter->m_u64HostFeatures, VIRTIO_GPU_F_EDID))
     {
         GetEdids();
+        for (UINT32 i = 0; m_bEDID && i < m_pAdapter->m_u32NumScanouts && i < MAX_CHILDREN; i++)
+        {
+            WidenEdidRanges(m_EDIDs[i]);
+        }
     }
     else
     {
         FixEdid();
+        WidenEdidRanges(GetEdidData(0));
     }
     return AddEdidModes();
 }
 
+// Windows drops the modes outside the monitor's range limits, and QEMU's EDID allows 50-125 Hz and 30-160 kHz: the
+// faster refresh rates this driver offers (g_RefreshRates) need 24-240 Hz and, at 2160 lines, up to 518 kHz
+void VioGpuVidPN::WidenEdidRanges(PUCHAR Edid)
+{
+    PAGED_CODE();
+
+    for (ULONG Offset = 54; Offset <= 108; Offset += 18)
+    {
+        PUCHAR Desc = Edid + Offset;
+        // A display descriptor (no pixel clock) of type 0xFD: display range limits
+        if (Desc[0] == 0 && Desc[1] == 0 && Desc[3] == 0xFD)
+        {
+            Desc[4] = 0x08;  // EDID 1.4 offsets: maximum horizontal rate + 255 kHz
+            Desc[5] = 24;    // vertical Hz
+            Desc[6] = 240;
+            Desc[7] = 1;     // horizontal kHz
+            Desc[8] = 255;   // 510 kHz with the offset
+            Desc[9] = 255;   // maximum pixel clock: 2550 MHz
+        }
+    }
+    UCHAR Sum = 0;
+    for (ULONG i = 0; i < EDID_V1_BLOCK_SIZE - 1; i++)
+    {
+        Sum += Edid[i];
+    }
+    Edid[EDID_V1_BLOCK_SIZE - 1] = -Sum;
+}
