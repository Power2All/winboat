 }
 
+// The vblank timer follows the refresh rate of the target mode Windows pinned
+void VioGpuVidPN::UpdateRefreshRate(CONST DXGK_VIDPN_INTERFACE *pVidPnInterface,
+                                    D3DKMDT_HVIDPN hVidPn,
+                                    D3DDDI_VIDEO_PRESENT_TARGET_ID TargetId)
+{
+    PAGED_CODE();
+
+    D3DKMDT_HVIDPNTARGETMODESET hTargetModeSet = 0;
+    CONST DXGK_VIDPNTARGETMODESET_INTERFACE *pTargetModeSetInterface = NULL;
+    CONST D3DKMDT_VIDPN_TARGET_MODE *pPinnedTargetMode = NULL;
+
+    if (!NT_SUCCESS(pVidPnInterface->pfnAcquireTargetModeSet(hVidPn, TargetId, &hTargetModeSet, &pTargetModeSetInterface)))
+    {
+        return;
+    }
+    if (NT_SUCCESS(pTargetModeSetInterface->pfnAcquirePinnedModeInfo(hTargetModeSet, &pPinnedTargetMode)) &&
+        pPinnedTargetMode != NULL)
+    {
+        CONST D3DDDI_RATIONAL *VSync = &pPinnedTargetMode->VideoSignalInfo.VSyncFreq;
+        if (VSync->Denominator != 0 && VSync->Denominator != D3DKMDT_FREQUENCY_NOTSPECIFIED)
+        {
+            LONG Rate = (LONG)((VSync->Numerator + VSync->Denominator / 2) / VSync->Denominator);
+            if (Rate >= 24 && Rate <= 480)
+            {
+                InterlockedExchange(&m_RefreshRate, Rate);
+                DbgPrint(TRACE_LEVEL_INFORMATION, ("%s: %d Hz\n", __FUNCTION__, Rate));
+            }
+        }
+        pTargetModeSetInterface->pfnReleaseModeInfo(hTargetModeSet, pPinnedTargetMode);
+    }
+    pVidPnInterface->pfnReleaseTargetModeSet(hVidPn, hTargetModeSet);
+}
