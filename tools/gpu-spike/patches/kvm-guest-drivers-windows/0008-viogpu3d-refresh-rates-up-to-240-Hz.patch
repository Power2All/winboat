 BOOLEAN VioGpuVidPN::UpdateModes(USHORT xres, USHORT yres, int &cnt)
 {
     int idx = 0;
@@ -2015,21 +2094,27 @@ void VioGpuVidPN::FlipThread(void *ctx)
 
     VioGpuVidPN *vidpn = reinterpret_cast<VioGpuVidPN *>(ctx);
     LARGE_INTEGER interval;
-    interval.QuadPart = -166666LL;
+    LONG rate = 0;
 
-    // A vblank every 1/60 s. A plain delay is rounded up to the system timer tick (15.6 ms by default), so it lasted
-    // two ticks: 32 Hz, and DWM composed at that rate. A high-resolution periodic timer keeps 60 Hz.
+    // A vblank at the committed mode's refresh rate. A plain delay is rounded up to the system timer tick (15.6 ms by
+    // default), so at 60 Hz it lasted two ticks: 32 Hz, and DWM composed at that rate. A high-resolution periodic
+    // timer keeps the rate; it is set again when a mode with another rate is committed.
     KeInitializeEvent(&vidpn->m_flipEvent, SynchronizationEvent, FALSE);
     PEX_TIMER timer = ExAllocateTimer(VioGpuVidPN::FlipTimerCallback, vidpn, EX_TIMER_HIGH_RESOLUTION);
-    if (timer != NULL)
-    {
-        ExSetTimer(timer, interval.QuadPart, -interval.QuadPart, NULL);
-    }
     // A new frame goes to the host as soon as Windows flips to it, not at the next vblank: that saved up to a frame
     // of latency. Windows still learns at the vblank that the flip completed, so it composes once per vblank.
     PVOID events[] = {&vidpn->m_flipNowEvent, &vidpn->m_flipEvent};
     while (true)
     {
+        if (vidpn->m_RefreshRate != rate)
+        {
+            rate = vidpn->m_RefreshRate;
+            interval.QuadPart = -10000000LL / rate;
+            if (timer != NULL)
+            {
+                ExSetTimer(timer, interval.QuadPart, -interval.QuadPart, NULL);
+            }
+        }
         bool vsync = true;
         if (timer != NULL)
         {
