 {
-   *levels = sampleCount == 1 ? 1 : 0;
+   ID3D12Device *vkd3d = device_from(hDevice)->vkd3d;
+   D3D12_FEATURE_DATA_MULTISAMPLE_QUALITY_LEVELS data = {};
+   data.Format = format;
+   data.SampleCount = sampleCount;
+   data.Flags = (D3D12_MULTISAMPLE_QUALITY_LEVEL_FLAGS)flags;
+   if (FAILED(vkd3d->CheckFeatureSupport(D3D12_FEATURE_MULTISAMPLE_QUALITY_LEVELS, &data, sizeof(data))))
+      data.NumQualityLevels = sampleCount == 1 ? 1 : 0;
+   if (sampleCount > 1 && data.NumQualityLevels) {
+      D3D12_FEATURE_DATA_FORMAT_SUPPORT fs = {};
+      fs.Format = format;
+      /* a typeless format (no loads, no targets) has its family's levels */
+      const UINT typed = D3D12_FORMAT_SUPPORT1_SHADER_LOAD | D3D12_FORMAT_SUPPORT1_RENDER_TARGET |
+                         D3D12_FORMAT_SUPPORT1_DEPTH_STENCIL;
+      if (FAILED(vkd3d->CheckFeatureSupport(D3D12_FEATURE_FORMAT_SUPPORT, &fs, sizeof(fs))) ||
+          ((fs.Support1 & typed) && !(fs.Support1 & D3D12_FORMAT_SUPPORT1_MULTISAMPLE_RENDERTARGET)))
