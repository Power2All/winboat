+      D3D12_PIPELINE_STATE_SUBOBJECT_TYPE type;
+      T value;
+   } s = {type, value};
+   size_t at = (stream.size() + alignof(void *) - 1) & ~(alignof(void *) - 1);
+   stream.resize(at + sizeof(s));
+   memcpy(&stream[at], &s, sizeof(s));
