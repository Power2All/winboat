 static void APIENTRY
-device_check_multisample_quality_levels(D3D12DDI_HDEVICE, DXGI_FORMAT, UINT sampleCount,
-                                        D3D12DDI_MULTISAMPLE_QUALITY_LEVEL_FLAGS, UINT *levels)
+device_check_multisample_quality_levels(D3D12DDI_HDEVICE hDevice, DXGI_FORMAT format, UINT sampleCount,
