diff --git a/libs/viogpu_umd/umd_raytracing.cpp b/libs/viogpu_umd/umd_raytracing.cpp
new file mode 100644
index 00000000..7d3a7661
--- /dev/null
+++ b/libs/viogpu_umd/umd_raytracing.cpp
@@ -0,0 +1,377 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/* Ray tracing: state objects (collections, ray tracing pipelines) and acceleration structures.
+ *
+ * The DDI's subobjects are the API's (same types, same layouts) except that the runtime resolves the associations
+ * itself: no SUBOBJECT_TO_EXPORTS_ASSOCIATION, but a summary of every export's associated subobjects instead. The
+ * state object passed on to vkd3d-proton gets an explicit association per export and associated subobject. DXIL
+ * libraries come as the bare program (like shaders: umd_state.cpp) and get a container. The acceleration structure
+ * arguments are the API's as they are. */
+
+#include "umd_private.h"
+#include <deque>
+
+struct viogpu_state_object {
+   ID3D12StateObject *so;
+   ID3D12StateObjectProperties *props;
+   D3D12DDI_HRTSTATEOBJECT_0054 hRT;
+};
+
+static ID3D12StateObject *
+state_object_of(D3D12DDI_HSTATEOBJECT_0054 h)
+{
+   return h.pDrvPrivate ? ((viogpu_state_object *)h.pDrvPrivate)->so : NULL;
+}
+
+static_assert(sizeof(D3D12DDI_EXPORT_DESC_0054) == sizeof(D3D12_EXPORT_DESC), "export desc");
+static_assert(offsetof(D3D12DDI_HIT_GROUP_DESC_0054, IntersectionShaderImport) ==
+              offsetof(D3D12_HIT_GROUP_DESC, IntersectionShaderImport), "hit group desc");
+static_assert(sizeof(D3D12DDI_RAYTRACING_SHADER_CONFIG_0054) == sizeof(D3D12_RAYTRACING_SHADER_CONFIG),
+              "shader config");
+static_assert(sizeof(D3D12DDI_RAYTRACING_PIPELINE_CONFIG_0075) == sizeof(D3D12_RAYTRACING_PIPELINE_CONFIG1),
+              "pipeline config");
+
+/* A DXIL library in a container (as is when it is one already) */
+static std::vector<BYTE>
+library_container(const UINT *code)
+{
+   const BYTE *bytes = (const BYTE *)code;
+   if (code[0] == ('D' | 'X' << 8 | 'B' << 16 | (UINT)'C' << 24))
+      return std::vector<BYTE>(bytes, bytes + code[6]);
+   UINT program = code[1] * 4;
+   UINT header[] = {('D' | 'X' << 8 | 'B' << 16 | (UINT)'C' << 24), 0, 0, 0, 0, 1, 0, 1, 36,
+                    ('D' | 'X' << 8 | 'I' << 16 | (UINT)'L' << 24), program};
+   header[6] = sizeof(header) + program;
+   std::vector<BYTE> c((const BYTE *)header, (const BYTE *)header + sizeof(header));
+   c.insert(c.end(), bytes, bytes + program);
+   return c;
+}
+
+/* The API's description of a DDI one, and what it points to */
+struct state_object_desc {
+   D3D12_STATE_OBJECT_DESC desc;
+   std::vector<D3D12_STATE_SUBOBJECT> subobjects;
+   std::deque<std::vector<BYTE>> containers;
+   std::deque<D3D12_DXIL_LIBRARY_DESC> libraries;
+   std::deque<D3D12_EXISTING_COLLECTION_DESC> collections;
+   std::deque<D3D12_GLOBAL_ROOT_SIGNATURE> globals;
+   std::deque<D3D12_LOCAL_ROOT_SIGNATURE> locals;
+   std::deque<D3D12_SUBOBJECT_TO_EXPORTS_ASSOCIATION> associations;
+};
+
+static void
+translate(D3D12DDI_STATE_OBJECT_TYPE type, UINT count, const D3D12DDI_STATE_SUBOBJECT_0054 *in,
+          state_object_desc &out)
+{
+   /* every pointer into subobjects must stay put: room for the associations up front */
+   size_t associations = 0;
+   for (UINT i = 0; i < count; i++)
+      if (in[i].Type == D3D12DDI_STATE_SUBOBJECT_TYPE_SHADER_EXPORT_SUMMARY) {
+         const D3D12DDI_FUNCTION_SUMMARY_0054 *summary = (const D3D12DDI_FUNCTION_SUMMARY_0054 *)in[i].pDesc;
+         for (UINT j = 0; j < summary->NumExportedFunctions; j++)
+            associations += summary->pSummaries[j].NumAssociatedSubobjects;
+      }
+   out.subobjects.reserve(count + associations);
+   /* where each DDI subobject went (the summary refers to them) */
+   std::vector<const D3D12DDI_STATE_SUBOBJECT_0054 *> from;
+
+   for (UINT i = 0; i < count; i++) {
+      D3D12_STATE_SUBOBJECT s = {(D3D12_STATE_SUBOBJECT_TYPE)in[i].Type, in[i].pDesc};
+      switch (in[i].Type) {
+      case D3D12DDI_STATE_SUBOBJECT_TYPE_DXIL_LIBRARY: {
+         const D3D12DDI_DXIL_LIBRARY_DESC_0054 *lib = (const D3D12DDI_DXIL_LIBRARY_DESC_0054 *)in[i].pDesc;
+         out.containers.push_back(library_container(lib->pDXILLibrary));
+         D3D12_DXIL_LIBRARY_DESC d = {};
+         d.DXILLibrary.pShaderBytecode = out.containers.back().data();
+         d.DXILLibrary.BytecodeLength = out.containers.back().size();
+         d.NumExports = lib->NumExports;
+         d.pExports = (D3D12_EXPORT_DESC *)lib->pExports;
+         out.libraries.push_back(d);
+         s.pDesc = &out.libraries.back();
+         break;
+      }
+      case D3D12DDI_STATE_SUBOBJECT_TYPE_EXISTING_COLLECTION: {
+         const D3D12DDI_EXISTING_COLLECTION_DESC_0054 *c = (const D3D12DDI_EXISTING_COLLECTION_DESC_0054 *)in[i].pDesc;
+         out.collections.push_back({state_object_of(c->hExistingCollection), c->NumExports,
+                                    (D3D12_EXPORT_DESC *)c->pExports});
+         s.pDesc = &out.collections.back();
+         break;
+      }
+      case D3D12DDI_STATE_SUBOBJECT_TYPE_GLOBAL_ROOT_SIGNATURE:
+         out.globals.push_back({viogpu_root_signature_of(
+            ((const D3D12DDI_GLOBAL_ROOT_SIGNATURE_0054 *)in[i].pDesc)->hGlobalRootSignature)});
+         s.pDesc = &out.globals.back();
+         break;
+      case D3D12DDI_STATE_SUBOBJECT_TYPE_LOCAL_ROOT_SIGNATURE:
+         out.locals.push_back({viogpu_root_signature_of(
+            ((const D3D12DDI_LOCAL_ROOT_SIGNATURE_0054 *)in[i].pDesc)->hLocalRootSignature)});
+         s.pDesc = &out.locals.back();
+         break;
+      case D3D12DDI_STATE_SUBOBJECT_TYPE_RAYTRACING_PIPELINE_CONFIG:
+         /* DDI 0075 on: with the flags (the API's PIPELINE_CONFIG1) */
+         s.Type = D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_PIPELINE_CONFIG1;
+         break;
+      case D3D12DDI_STATE_SUBOBJECT_TYPE_STATE_OBJECT_CONFIG:
+      case D3D12DDI_STATE_SUBOBJECT_TYPE_NODE_MASK:
+      case D3D12DDI_STATE_SUBOBJECT_TYPE_RAYTRACING_SHADER_CONFIG:
+      case D3D12DDI_STATE_SUBOBJECT_TYPE_HIT_GROUP:
+         break;
+      case D3D12DDI_STATE_SUBOBJECT_TYPE_SHADER_EXPORT_SUMMARY:
+         continue;
+      default:
+         viogpu_log("CreateStateObject: subobject type %u passed on as is", (UINT)in[i].Type);
+         break;
+      }
+      out.subobjects.push_back(s);
+      from.push_back(&in[i]);
+   }
+
+   for (UINT i = 0; i < count; i++) {
+      if (in[i].Type != D3D12DDI_STATE_SUBOBJECT_TYPE_SHADER_EXPORT_SUMMARY)
+         continue;
+      const D3D12DDI_FUNCTION_SUMMARY_0054 *summary = (const D3D12DDI_FUNCTION_SUMMARY_0054 *)in[i].pDesc;
+      for (UINT j = 0; j < summary->NumExportedFunctions; j++) {
+         const D3D12DDI_FUNCTION_SUMMARY_NODE_0054 &node = summary->pSummaries[j];
+         for (UINT k = 0; k < node.NumAssociatedSubobjects; k++) {
+            size_t at = 0;
+            while (at < from.size() && from[at] != node.ppAssociatedSubobjects[k])
+               at++;
+            if (at == from.size())
+               continue; /* a collection's: it has it already */
+            switch (out.subobjects[at].Type) {
+            case D3D12_STATE_SUBOBJECT_TYPE_GLOBAL_ROOT_SIGNATURE:
+            case D3D12_STATE_SUBOBJECT_TYPE_LOCAL_ROOT_SIGNATURE:
+            case D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_SHADER_CONFIG:
+            case D3D12_STATE_SUBOBJECT_TYPE_RAYTRACING_PIPELINE_CONFIG1:
+               break;
+            default:
+               continue;
+            }
+            out.associations.push_back({&out.subobjects[at], 1, (LPCWSTR *)&node.ExportNameUnmangled});
+            out.subobjects.push_back({D3D12_STATE_SUBOBJECT_TYPE_SUBOBJECT_TO_EXPORTS_ASSOCIATION,
+                                      &out.associations.back()});
+         }
+      }
+   }
+
+   out.desc.Type = (D3D12_STATE_OBJECT_TYPE)type;
+   out.desc.NumSubobjects = (UINT)out.subobjects.size();
+   out.desc.pSubobjects = out.subobjects.data();
+}
+
+static void
+state_object_finish(viogpu_state_object *so)
+{
+   if (so->so)
+      so->so->QueryInterface(IID_PPV_ARGS(&so->props));
+}
+
+static SIZE_T APIENTRY
+calc_state_object_size(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATE_STATE_OBJECT_0054 *)
+{
+   return sizeof(viogpu_state_object);
+}
+
+static HRESULT APIENTRY
+create_state_object(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_STATE_OBJECT_0054 *args,
+                    D3D12DDI_HSTATEOBJECT_0054 h, D3D12DDI_HRTSTATEOBJECT_0054 hRT)
+{
+   viogpu_state_object *so = new (h.pDrvPrivate) viogpu_state_object();
+   so->hRT = hRT;
+   ID3D12Device5 *device5 = NULL;
+   HRESULT hr = device_from(hDevice)->vkd3d->QueryInterface(IID_PPV_ARGS(&device5));
+   if (SUCCEEDED(hr)) {
+      state_object_desc desc;
+      translate(args->Type, args->NumSubobjects, args->pSubobjects, desc);
+      hr = device5->CreateStateObject(&desc.desc, IID_PPV_ARGS(&so->so));
+      device5->Release();
+   }
+   if (FAILED(hr))
+      viogpu_log("CreateStateObject (type %u, %u subobjects): 0x%08lx", (UINT)args->Type, args->NumSubobjects,
+                 (unsigned long)hr);
+   state_object_finish(so);
+   return hr;
+}
+
+static SIZE_T APIENTRY
+calc_add_to_state_object_size(D3D12DDI_HDEVICE, const D3D12DDIARG_ADD_TO_STATE_OBJECT_0072 *)
+{
+   return sizeof(viogpu_state_object);
+}
+
+static HRESULT APIENTRY
+add_to_state_object(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_ADD_TO_STATE_OBJECT_0072 *args,
+                    D3D12DDI_HSTATEOBJECT_0054 h, D3D12DDI_HRTSTATEOBJECT_0054 hRT)
+{
+   viogpu_state_object *so = new (h.pDrvPrivate) viogpu_state_object();
+   so->hRT = hRT;
+   ID3D12Device7 *device7 = NULL;
+   HRESULT hr = device_from(hDevice)->vkd3d->QueryInterface(IID_PPV_ARGS(&device7));
+   if (SUCCEEDED(hr)) {
+      state_object_desc desc;
+      translate(args->Type, args->NumSubobjects, args->pSubobjects, desc);
+      hr = device7->AddToStateObject(&desc.desc, state_object_of(args->StateObjectToGrowFrom),
+                                     IID_PPV_ARGS(&so->so));
+      device7->Release();
+   }
+   if (FAILED(hr))
+      viogpu_log("AddToStateObject (%u subobjects): 0x%08lx", args->NumSubobjects, (unsigned long)hr);
+   state_object_finish(so);
+   return hr;
+}
+
+static VOID APIENTRY
+destroy_state_object(D3D12DDI_HDEVICE, D3D12DDI_HSTATEOBJECT_0054 h)
+{
+   viogpu_state_object *so = (viogpu_state_object *)h.pDrvPrivate;
+   if (so->props)
+      so->props->Release();
+   if (so->so)
+      so->so->Release();
+   so->~viogpu_state_object();
+}
+
+static void *APIENTRY
+get_shader_identifier(D3D12DDI_HSTATEOBJECT_0054 h, LPCWSTR name)
+{
+   viogpu_state_object *so = (viogpu_state_object *)h.pDrvPrivate;
+   return so->props ? so->props->GetShaderIdentifier(name) : NULL;
+}
+
+static UINT APIENTRY
+get_shader_stack_size(D3D12DDI_HSTATEOBJECT_0054 h, LPCWSTR name)
+{
+   viogpu_state_object *so = (viogpu_state_object *)h.pDrvPrivate;
+   return so->props ? (UINT)so->props->GetShaderStackSize(name) : 0;
+}
+
+static UINT APIENTRY
+get_pipeline_stack_size(D3D12DDI_HSTATEOBJECT_0054 h)
+{
+   viogpu_state_object *so = (viogpu_state_object *)h.pDrvPrivate;
+   return so->props ? (UINT)so->props->GetPipelineStackSize() : 0;
+}
+
+static VOID APIENTRY
+set_pipeline_stack_size(D3D12DDI_HSTATEOBJECT_0054 h, UINT size)
+{
+   viogpu_state_object *so = (viogpu_state_object *)h.pDrvPrivate;
+   if (so->props)
+      so->props->SetPipelineStackSize(size);
+}
