+static VOID APIENTRY
+get_prebuild_info(D3D12DDI_HDEVICE hDevice, const D3D12DDI_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS_0054 *inputs,
+                  D3D12DDI_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO_0054 *info)
+{
+   memset(info, 0, sizeof(*info));
+   ID3D12Device5 *device5 = NULL;
+   if (FAILED(device_from(hDevice)->vkd3d->QueryInterface(IID_PPV_ARGS(&device5))))
+      return;
+   device5->GetRaytracingAccelerationStructurePrebuildInfo(
+      (const D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS *)inputs,
+      (D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO *)info);
+   device5->Release();
+}
+
+static D3D12DDI_DRIVER_MATCHING_IDENTIFIER_STATUS APIENTRY
+check_driver_matching_identifier(D3D12DDI_HDEVICE hDevice, D3D12DDI_SERIALIZED_DATA_TYPE type,
+                                 const D3D12DDI_SERIALIZED_DATA_DRIVER_MATCHING_IDENTIFIER_0054 *id)
+{
+   ID3D12Device5 *device5 = NULL;
+   if (FAILED(device_from(hDevice)->vkd3d->QueryInterface(IID_PPV_ARGS(&device5))))
+      return D3D12DDI_DRIVER_MATCHING_IDENTIFIER_UNRECOGNIZED;
+   D3D12_DRIVER_MATCHING_IDENTIFIER_STATUS status = device5->CheckDriverMatchingIdentifier(
+      (D3D12_SERIALIZED_DATA_TYPE)type, (const D3D12_SERIALIZED_DATA_DRIVER_MATCHING_IDENTIFIER *)id);
+   device5->Release();
+   return (D3D12DDI_DRIVER_MATCHING_IDENTIFIER_STATUS)status;
+}
+
+static VOID APIENTRY
+build_acceleration_structure(D3D12DDI_HCOMMANDLIST h, const D3D12DDIARG_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_0054 *a)
+{
+   if (list_from(h)->list4)
+      list_from(h)->list4->BuildRaytracingAccelerationStructure(
+         (const D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC *)a, a->NumPostbuildInfoDescs,
+         (const D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_DESC *)a->pPostbuildInfoDescs);
+}
+
+static VOID APIENTRY
+emit_postbuild_info(D3D12DDI_HCOMMANDLIST h,
+                    const D3D12DDIARG_EMIT_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_0054 *a)
+{
+   if (list_from(h)->list4)
+      list_from(h)->list4->EmitRaytracingAccelerationStructurePostbuildInfo(
+         (const D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_DESC *)&a->Desc,
+         a->NumSourceAccelerationStructures, a->pSourceAccelerationStructureData);
+}
+
+static VOID APIENTRY
+copy_acceleration_structure(D3D12DDI_HCOMMANDLIST h, const D3D12DDIARG_COPY_RAYTRACING_ACCELERATION_STRUCTURE_0054 *a)
+{
+   if (list_from(h)->list4)
+      list_from(h)->list4->CopyRaytracingAccelerationStructure(
+         a->DestAccelerationStructureData, a->SourceAccelerationStructureData,
+         (D3D12_RAYTRACING_ACCELERATION_STRUCTURE_COPY_MODE)a->Mode);
+}
+
+static VOID APIENTRY
+set_pipeline_state1(D3D12DDI_HCOMMANDLIST h, D3D12DDI_HSTATEOBJECT_0054 so)
+{
+   if (list_from(h)->list4)
+      list_from(h)->list4->SetPipelineState1(state_object_of(so));
+}
+
+static VOID APIENTRY
+dispatch_rays(D3D12DDI_HCOMMANDLIST h, const D3D12DDIARG_DISPATCH_RAYS_0054 *a)
+{
+   if (list_from(h)->list4)
+      list_from(h)->list4->DispatchRays((const D3D12_DISPATCH_RAYS_DESC *)a);
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+
+void
+viogpu_fill_raytracing_funcs(viogpu_device_funcs *f)
+{
+   f->pfnCalcPrivateStateObjectSize = calc_state_object_size;
+   f->pfnCreateStateObject = create_state_object;
+   f->pfnDestroyStateObject = destroy_state_object;
+   f->pfnGetRaytracingAccelerationStructurePrebuildInfo = get_prebuild_info;
+   f->pfnCheckDriverMatchingIdentifier = check_driver_matching_identifier;
+   f->pfnGetShaderIdentifier = get_shader_identifier;
+   f->pfnGetShaderStackSize = get_shader_stack_size;
+   f->pfnGetPipelineStackSize = get_pipeline_stack_size;
+   f->pfnSetPipelineStackSize = set_pipeline_stack_size;
+   f->pfnCalcPrivateAddToStateObjectSize = calc_add_to_state_object_size;
+   f->pfnAddToStateObject = add_to_state_object;
+}
+
+void
+viogpu_fill_raytracing_list_funcs(viogpu_command_list_funcs *f)
+{
+   f->pfnBuildRaytracingAccelerationStructure = build_acceleration_structure;
+   f->pfnEmitRaytracingAccelerationStructurePostbuildInfo = emit_postbuild_info;
+   f->pfnCopyRaytracingAccelerationStructure = copy_acceleration_structure;
+   f->pfnSetPipelineState1 = set_pipeline_state1;
+   f->pfnDispatchRays = dispatch_rays;
+}
