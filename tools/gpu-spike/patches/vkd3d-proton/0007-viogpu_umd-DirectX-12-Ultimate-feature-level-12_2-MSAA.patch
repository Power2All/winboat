+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Acceleration structures */
+
+static_assert(sizeof(D3D12DDI_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS_0054) ==
+              sizeof(D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS), "build inputs");
+static_assert(sizeof(D3D12DDI_RAYTRACING_GEOMETRY_DESC_0054) == sizeof(D3D12_RAYTRACING_GEOMETRY_DESC), "geometry");
+static_assert(offsetof(D3D12DDIARG_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_0054, NumPostbuildInfoDescs) ==
+              sizeof(D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_DESC), "build desc");
+static_assert(sizeof(D3D12DDI_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO_0054) ==
+              sizeof(D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO), "prebuild info");
+static_assert(sizeof(D3D12DDI_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_DESC_0054) ==
+              sizeof(D3D12_RAYTRACING_ACCELERATION_STRUCTURE_POSTBUILD_INFO_DESC), "postbuild info");
+static_assert(sizeof(D3D12DDIARG_DISPATCH_RAYS_0054) == sizeof(D3D12_DISPATCH_RAYS_DESC), "dispatch rays");
+static_assert(sizeof(D3D12DDI_SERIALIZED_DATA_DRIVER_MATCHING_IDENTIFIER_0054) ==
+              sizeof(D3D12_SERIALIZED_DATA_DRIVER_MATCHING_IDENTIFIER), "driver matching identifier");
