+/* Present's conversion of a BGRA swap chain buffer into its shared image (umd_resource.cpp), recorded into list */
+bool viogpu_shared_blit(viogpu_device *device, struct viogpu_resource *res, ID3D12GraphicsCommandList *list);
+
 /* Device-level errors from DDIs without a return value */
 void viogpu_device_error(viogpu_device *device, HRESULT hr);
 
@@ -114,6 +119,12 @@ struct viogpu_resource {
    D3DKMT_HANDLE kmAllocation;
    UINT kmPitch;
    ID3D12Resource *readback;
+   /* a swap chain buffer DWM composes as it is (umd_resource.cpp's shared_swap_chain_buffer): its Venus image and
