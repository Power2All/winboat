+/* The VPS, SPS and PPS the picture parameters stand for (ids 0; scaling lists in the PPS). The SPS's short-term
+ * reference picture sets aren't in DXVA: slices that use them are parsed by their count, and the references come
+ * from the picture parameters, so they are left empty. */
+static void
+h265_params_fill(const decode_caps *c, const decode_profile &profile, const DXVA_PicParams_HEVC *pp,
+                 const DXVA_Qmatrix_HEVC *qm, h265_params *p)
+{
+   memset(p, 0, sizeof(*p));
+   p->ptl.flags.general_progressive_source_flag = 1;
+   p->ptl.flags.general_frame_only_constraint_flag = 1;
+   p->ptl.general_profile_idc = profile.h265.stdProfileIdc;
+   p->ptl.general_level_idc = c->h265.maxLevelIdc;
+   p->dpbm.max_dec_pic_buffering_minus1[0] = pp->sps_max_dec_pic_buffering_minus1;
+   p->dpbm.max_num_reorder_pics[0] = pp->sps_max_dec_pic_buffering_minus1;
+
+   p->vps.flags.vps_temporal_id_nesting_flag = 1;
+
+   StdVideoH265SequenceParameterSet &sps = p->sps;
+   UINT log2MinCb = pp->log2_min_luma_coding_block_size_minus3 + 3;
+   sps.flags.sps_temporal_id_nesting_flag = 1;
+   sps.flags.separate_colour_plane_flag = pp->separate_colour_plane_flag;
+   sps.flags.scaling_list_enabled_flag = pp->scaling_list_enabled_flag;
+   sps.flags.amp_enabled_flag = pp->amp_enabled_flag;
+   sps.flags.sample_adaptive_offset_enabled_flag = pp->sample_adaptive_offset_enabled_flag;
+   sps.flags.pcm_enabled_flag = pp->pcm_enabled_flag;
+   sps.flags.pcm_loop_filter_disabled_flag = pp->pcm_loop_filter_disabled_flag;
+   sps.flags.long_term_ref_pics_present_flag = pp->long_term_ref_pics_present_flag;
+   sps.flags.sps_temporal_mvp_enabled_flag = pp->sps_temporal_mvp_enabled_flag;
+   sps.flags.strong_intra_smoothing_enabled_flag = pp->strong_intra_smoothing_enabled_flag;
+   sps.chroma_format_idc = (StdVideoH265ChromaFormatIdc)pp->chroma_format_idc;
+   sps.pic_width_in_luma_samples = (uint32_t)pp->PicWidthInMinCbsY << log2MinCb;
+   sps.pic_height_in_luma_samples = (uint32_t)pp->PicHeightInMinCbsY << log2MinCb;
+   sps.bit_depth_luma_minus8 = pp->bit_depth_luma_minus8;
+   sps.bit_depth_chroma_minus8 = pp->bit_depth_chroma_minus8;
+   sps.log2_max_pic_order_cnt_lsb_minus4 = pp->log2_max_pic_order_cnt_lsb_minus4;
+   sps.log2_min_luma_coding_block_size_minus3 = pp->log2_min_luma_coding_block_size_minus3;
+   sps.log2_diff_max_min_luma_coding_block_size = pp->log2_diff_max_min_luma_coding_block_size;
+   sps.log2_min_luma_transform_block_size_minus2 = pp->log2_min_transform_block_size_minus2;
+   sps.log2_diff_max_min_luma_transform_block_size = pp->log2_diff_max_min_transform_block_size;
+   sps.max_transform_hierarchy_depth_inter = pp->max_transform_hierarchy_depth_inter;
+   sps.max_transform_hierarchy_depth_intra = pp->max_transform_hierarchy_depth_intra;
+   sps.num_short_term_ref_pic_sets = pp->num_short_term_ref_pic_sets;
+   sps.num_long_term_ref_pics_sps = pp->num_long_term_ref_pics_sps;
+   sps.pcm_sample_bit_depth_luma_minus1 = pp->pcm_sample_bit_depth_luma_minus1;
+   sps.pcm_sample_bit_depth_chroma_minus1 = pp->pcm_sample_bit_depth_chroma_minus1;
+   sps.log2_min_pcm_luma_coding_block_size_minus3 = pp->log2_min_pcm_luma_coding_block_size_minus3;
+   sps.log2_diff_max_min_pcm_luma_coding_block_size = pp->log2_diff_max_min_pcm_luma_coding_block_size;
+
+   StdVideoH265PictureParameterSet &pps = p->pps;
+   pps.flags.dependent_slice_segments_enabled_flag = pp->dependent_slice_segments_enabled_flag;
+   pps.flags.output_flag_present_flag = pp->output_flag_present_flag;
+   pps.flags.sign_data_hiding_enabled_flag = pp->sign_data_hiding_enabled_flag;
+   pps.flags.cabac_init_present_flag = pp->cabac_init_present_flag;
+   pps.flags.constrained_intra_pred_flag = pp->constrained_intra_pred_flag;
+   pps.flags.transform_skip_enabled_flag = pp->transform_skip_enabled_flag;
+   pps.flags.cu_qp_delta_enabled_flag = pp->cu_qp_delta_enabled_flag;
+   pps.flags.pps_slice_chroma_qp_offsets_present_flag = pp->pps_slice_chroma_qp_offsets_present_flag;
+   pps.flags.weighted_pred_flag = pp->weighted_pred_flag;
+   pps.flags.weighted_bipred_flag = pp->weighted_bipred_flag;
+   pps.flags.transquant_bypass_enabled_flag = pp->transquant_bypass_enabled_flag;
+   pps.flags.tiles_enabled_flag = pp->tiles_enabled_flag;
+   pps.flags.entropy_coding_sync_enabled_flag = pp->entropy_coding_sync_enabled_flag;
+   pps.flags.uniform_spacing_flag = pp->uniform_spacing_flag;
+   pps.flags.loop_filter_across_tiles_enabled_flag = pp->loop_filter_across_tiles_enabled_flag;
+   pps.flags.pps_loop_filter_across_slices_enabled_flag = pp->pps_loop_filter_across_slices_enabled_flag;
+   /* only gates the PPS's own syntax; the slice header's override depends on the override flag */
+   pps.flags.deblocking_filter_control_present_flag = 1;
+   pps.flags.deblocking_filter_override_enabled_flag = pp->deblocking_filter_override_enabled_flag;
+   pps.flags.pps_deblocking_filter_disabled_flag = pp->pps_deblocking_filter_disabled_flag;
+   pps.flags.pps_scaling_list_data_present_flag = pp->scaling_list_enabled_flag && qm;
+   pps.flags.lists_modification_present_flag = pp->lists_modification_present_flag;
+   pps.flags.slice_segment_header_extension_present_flag = pp->slice_segment_header_extension_present_flag;
+   pps.num_extra_slice_header_bits = pp->num_extra_slice_header_bits;
+   pps.num_ref_idx_l0_default_active_minus1 = pp->num_ref_idx_l0_default_active_minus1;
+   pps.num_ref_idx_l1_default_active_minus1 = pp->num_ref_idx_l1_default_active_minus1;
+   pps.init_qp_minus26 = pp->init_qp_minus26;
+   pps.diff_cu_qp_delta_depth = pp->diff_cu_qp_delta_depth;
+   pps.pps_cb_qp_offset = pp->pps_cb_qp_offset;
+   pps.pps_cr_qp_offset = pp->pps_cr_qp_offset;
+   pps.pps_beta_offset_div2 = pp->pps_beta_offset_div2;
+   pps.pps_tc_offset_div2 = pp->pps_tc_offset_div2;
+   pps.log2_parallel_merge_level_minus2 = pp->log2_parallel_merge_level_minus2;
+   pps.num_tile_columns_minus1 = pp->num_tile_columns_minus1;
+   pps.num_tile_rows_minus1 = pp->num_tile_rows_minus1;
+   for (int i = 0; i < 19; i++)
+      pps.column_width_minus1[i] = pp->column_width_minus1[i];
+   for (int i = 0; i < 21; i++)
+      pps.row_height_minus1[i] = pp->row_height_minus1[i];
+   if (pps.flags.pps_scaling_list_data_present_flag) {
+      /* the same layout and order (up-right diagonal) */
+      memcpy(p->lists.ScalingList4x4, qm->ucScalingLists0, sizeof(qm->ucScalingLists0));
+      memcpy(p->lists.ScalingList8x8, qm->ucScalingLists1, sizeof(qm->ucScalingLists1));
+      memcpy(p->lists.ScalingList16x16, qm->ucScalingLists2, sizeof(qm->ucScalingLists2));
+      memcpy(p->lists.ScalingList32x32, qm->ucScalingLists3, sizeof(qm->ucScalingLists3));
+      memcpy(p->lists.ScalingListDCCoef16x16, qm->ucScalingListDCCoefSizeID2, sizeof(qm->ucScalingListDCCoefSizeID2));
+      memcpy(p->lists.ScalingListDCCoef32x32, qm->ucScalingListDCCoefSizeID3, sizeof(qm->ucScalingListDCCoefSizeID3));
+   }
+}
+
+static bool
+h265_params_get(decode_session *s, const DXVA_PicParams_HEVC *pp, const DXVA_Qmatrix_HEVC *qm)
+{
+   h265_params p;
+   h265_params_fill(s->caps, s->profile, pp, qm, &p);
+   if (!params_changed(s, p))
+      return true;
+   p.vps.pDecPicBufMgr = &p.dpbm;
+   p.vps.pProfileTierLevel = &p.ptl;
+   p.sps.pProfileTierLevel = &p.ptl;
+   p.sps.pDecPicBufMgr = &p.dpbm;
+   p.sps.pShortTermRefPicSet = p.sps.num_short_term_ref_pic_sets ? p.rps : NULL;
+   p.sps.pLongTermRefPicsSps = &p.ltr;
+   if (p.pps.flags.pps_scaling_list_data_present_flag)
+      p.pps.pScalingLists = &p.lists;
+   VkVideoDecodeH265SessionParametersAddInfoKHR add = {VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_SESSION_PARAMETERS_ADD_INFO_KHR};
+   add.stdVPSCount = 1;
+   add.pStdVPSs = &p.vps;
+   add.stdSPSCount = 1;
+   add.pStdSPSs = &p.sps;
+   add.stdPPSCount = 1;
+   add.pStdPPSs = &p.pps;
+   VkVideoDecodeH265SessionParametersCreateInfoKHR info = {
+      VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_SESSION_PARAMETERS_CREATE_INFO_KHR};
+   info.maxStdVPSCount = 1;
+   info.maxStdSPSCount = 1;
+   info.maxStdPPSCount = 1;
+   info.pParametersAddInfo = &add;
+   return params_create(s, &info);
+}
+
+static bool
+decode_h265(const decode_input &d, decode_picture *pic, h265_picture *h)
+{
+   const auto *pp = (const DXVA_PicParams_HEVC *)frame_argument(
+      d.in, D3D12DDI_VIDEO_DECODE_PARAMETER_TYPE_0020_PICTURE_PARAMETERS, sizeof(DXVA_PicParams_HEVC));
+   const auto *qm = (const DXVA_Qmatrix_HEVC *)frame_argument(
+      d.in, D3D12DDI_VIDEO_DECODE_PARAMETER_TYPE_0020_INVERSE_QUANTIZATION_MATRIX, sizeof(DXVA_Qmatrix_HEVC));
+   if (!pp || !h265_params_get(d.s, pp, qm))
+      return false;
+   UINT log2MinCb = pp->log2_min_luma_coding_block_size_minus3 + 3;
+   pic->extent = {(UINT)pp->PicWidthInMinCbsY << log2MinCb, (UINT)pp->PicHeightInMinCbsY << log2MinCb};
+   for (UINT i = 0; i < 15; i++)
+      if (pp->RefPicList[i].bPicEntry != DXVA_INVALID_ENTRY)
+         keep_add(pic, d.in->ReferenceFrames, pp->RefPicList[i].Index7Bits);
+   if (!decode_slots_assign(d.s, pic, d.output, d.outputSub))
+      return false;
+   /* RefPicList index -> DPB slot */
+   int slotOf[15];
+   UINT n = 0;
+   for (UINT i = 0; i < 15; i++) {
+      slotOf[i] = -1;
+      if (pp->RefPicList[i].bPicEntry == DXVA_INVALID_ENTRY)
+         continue;
+      int k = keep_index(pic, d.in->ReferenceFrames, pp->RefPicList[i].Index7Bits);
+      if (k < 0 || pic->keep[k].slot < 0)
+         continue;
+      slotOf[i] = pic->keep[k].slot;
+      StdVideoDecodeH265ReferenceInfo &ri = h->refInfo[n];
+      ri.flags.used_for_long_term_reference = pp->RefPicList[i].AssociatedFlag;
+      ri.PicOrderCntVal = pp->PicOrderCntValList[i];
+      h->refSlot[n].sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_DPB_SLOT_INFO_KHR;
+      h->refSlot[n].pStdReferenceInfo = &ri;
+      use_add(pic, k, &h->refSlot[n]);
+      n++;
+   }
+   StdVideoDecodeH265PictureInfo &std = h->std;
+   std.flags.IrapPicFlag = pp->IrapPicFlag;
+   std.flags.IdrPicFlag = pp->IdrPicFlag;
+   /* DXVA doesn't say: a picture no later one names just leaves its slot */
+   std.flags.IsReference = 1;
+   /* slices that pick an SPS set code no set of their own */
+   std.flags.short_term_ref_pic_set_sps_flag =
+      !pp->IdrPicFlag && pp->num_short_term_ref_pic_sets && !pp->wNumBitsForShortTermRPSInSlice;
+   std.NumDeltaPocsOfRefRpsIdx = pp->ucNumDeltaPocsOfRefRpsIdx;
+   std.PicOrderCntVal = pp->CurrPicOrderCntVal;
+   std.NumBitsForSTRefPicSetInSlice = pp->wNumBitsForShortTermRPSInSlice;
+   /* the RPS lists: DXVA's are RefPicList indices, Vulkan's DPB slots */
+   auto slot_of = [&](UINT8 index) -> uint8_t { return index < 15 && slotOf[index] >= 0 ? (uint8_t)slotOf[index] : 0xff; };
+   for (int i = 0; i < 8; i++) {
+      std.RefPicSetStCurrBefore[i] = slot_of(pp->RefPicSetStCurrBefore[i]);
+      std.RefPicSetStCurrAfter[i] = slot_of(pp->RefPicSetStCurrAfter[i]);
+      std.RefPicSetLtCurr[i] = slot_of(pp->RefPicSetLtCurr[i]);
+   }
+   h->setupInfo.PicOrderCntVal = pp->CurrPicOrderCntVal;
+   h->setupSlot.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_DPB_SLOT_INFO_KHR;
+   h->setupSlot.pStdReferenceInfo = &h->setupInfo;
+   pic->setupInfo = &h->setupSlot;
+   for (UINT i = 0; i < d.sliceBytes / sizeof(DXVA_Slice_Short); i++)
+      h->sliceOffsets.push_back(((const DXVA_Slice_Short *)d.slices)[i].BSNALunitDataLocation);
+   h->info.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_PICTURE_INFO_KHR;
+   h->info.pStdPictureInfo = &std;
+   h->info.sliceSegmentCount = (uint32_t)h->sliceOffsets.size();
+   h->info.pSliceSegmentOffsets = h->sliceOffsets.data();
+   pic->pictureInfo = &h->info;
+   return true;
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* VP9 */
+
+struct vp9_picture {
+   VkVideoDecodeVP9PictureInfoKHR info;
+   StdVideoDecodeVP9PictureInfo std;
+   StdVideoVP9ColorConfig color;
+   StdVideoVP9LoopFilter loopFilter;
+   StdVideoVP9Segmentation segmentation;
+};
+
+/* DXVA's VP9 parameters are the uncompressed header's, with two kinds of differences: no refresh_frame_flags or color
+ * space (the references come from the DPB slots, and the color space only matters for 4:4:4 RGB), and loop filter
+ * deltas and segmentation data as in effect rather than as updated: they are given as all updated. The bitstream
+ * is the whole frame (headers included). */
+static bool
+decode_vp9(const decode_input &d, decode_picture *pic, vp9_picture *h)
+{
+   const auto *pp = (const DXVA_PicParams_VP9 *)frame_argument(
+      d.in, D3D12DDI_VIDEO_DECODE_PARAMETER_TYPE_0020_PICTURE_PARAMETERS, sizeof(DXVA_PicParams_VP9));
+   if (!pp)
+      return false;
+   pic->extent = {pp->width, pp->height};
+   for (int i = 0; i < 8; i++)
+      if (pp->ref_frame_map[i].bPicEntry != DXVA_INVALID_ENTRY)
+         keep_add(pic, d.in->ReferenceFrames, pp->ref_frame_map[i].Index7Bits);
+   if (!decode_slots_assign(d.s, pic, d.output, d.outputSub))
+      return false;
+   for (int i = 0; i < 3; i++) {
+      int k = pp->frame_refs[i].bPicEntry != DXVA_INVALID_ENTRY
+                 ? keep_index(pic, d.in->ReferenceFrames, pp->frame_refs[i].Index7Bits)
+                 : -1;
+      h->info.referenceNameSlotIndices[i] = k >= 0 ? pic->keep[k].slot : -1;
+      use_add(pic, k, NULL);
+   }
+
+   h->color.BitDepth = 8 + pp->BitDepthMinus8Luma;
+   h->color.subsampling_x = pp->subsampling_x;
+   h->color.subsampling_y = pp->subsampling_y;
+
+   h->loopFilter.flags.loop_filter_delta_enabled = pp->mode_ref_delta_enabled;
+   h->loopFilter.flags.loop_filter_delta_update = pp->mode_ref_delta_enabled;
+   h->loopFilter.loop_filter_level = pp->filter_level;
+   h->loopFilter.loop_filter_sharpness = pp->sharpness_level;
+   h->loopFilter.update_ref_delta = pp->mode_ref_delta_enabled ? 0xf : 0;
+   h->loopFilter.update_mode_delta = pp->mode_ref_delta_enabled ? 0x3 : 0;
+   for (int i = 0; i < 4; i++)
+      h->loopFilter.loop_filter_ref_deltas[i] = pp->ref_deltas[i];
+   for (int i = 0; i < 2; i++)
+      h->loopFilter.loop_filter_mode_deltas[i] = pp->mode_deltas[i];
+
+   const auto &seg = pp->stVP9Segments;
+   h->segmentation.flags.segmentation_update_map = seg.update_map;
+   h->segmentation.flags.segmentation_temporal_update = seg.temporal_update;
+   h->segmentation.flags.segmentation_update_data = seg.enabled;
+   h->segmentation.flags.segmentation_abs_or_delta_update = seg.abs_delta;
+   memcpy(h->segmentation.segmentation_tree_probs, seg.tree_probs, sizeof(seg.tree_probs));
+   memcpy(h->segmentation.segmentation_pred_prob, seg.pred_probs, sizeof(seg.pred_probs));
+   for (int i = 0; i < 8; i++) {
+      h->segmentation.FeatureEnabled[i] = seg.feature_mask[i];
+      for (int j = 0; j < 4; j++)
+         h->segmentation.FeatureData[i][j] = seg.feature_data[i][j];
+   }
+
+   StdVideoDecodeVP9PictureInfo &std = h->std;
+   std.flags.error_resilient_mode = pp->error_resilient_mode;
+   std.flags.intra_only = pp->intra_only;
+   std.flags.allow_high_precision_mv = pp->allow_high_precision_mv;
+   std.flags.refresh_frame_context = pp->refresh_frame_context;
+   std.flags.frame_parallel_decoding_mode = pp->frame_parallel_decoding_mode;
+   std.flags.segmentation_enabled = seg.enabled;
+   std.flags.show_frame = pp->show_frame;
+   std.flags.UsePrevFrameMvs = pp->use_prev_in_find_mv_refs;
+   std.profile = (StdVideoVP9Profile)pp->profile;
+   std.frame_type = (StdVideoVP9FrameType)pp->frame_type;
+   std.frame_context_idx = pp->frame_context_idx;
+   std.reset_frame_context = pp->reset_frame_context;
+   for (int i = 1; i < 4; i++)
+      std.ref_frame_sign_bias_mask |= (pp->ref_frame_sign_bias[i] ? 1 : 0) << i;
+   /* DXVA's numbering is Vulkan's (EIGHTTAP 0, EIGHTTAP_SMOOTH 1) */
+   std.interpolation_filter = (StdVideoVP9InterpolationFilter)pp->interp_filter;
+   std.base_q_idx = (uint8_t)pp->base_qindex;
+   std.delta_q_y_dc = pp->y_dc_delta_q;
+   std.delta_q_uv_dc = pp->uv_dc_delta_q;
+   std.delta_q_uv_ac = pp->uv_ac_delta_q;
+   std.tile_cols_log2 = pp->log2_tile_cols;
+   std.tile_rows_log2 = pp->log2_tile_rows;
+   std.pColorConfig = &h->color;
+   std.pLoopFilter = &h->loopFilter;
+   std.pSegmentation = &h->segmentation;
+   h->info.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_VP9_PICTURE_INFO_KHR;
+   h->info.pStdPictureInfo = &std;
+   h->info.uncompressedHeaderOffset = 0;
+   h->info.compressedHeaderOffset = pp->uncompressed_header_size_byte_aligned;
+   h->info.tilesOffset = pp->uncompressed_header_size_byte_aligned + pp->first_partition_size;
+   pic->setupInfo = NULL;
+   pic->pictureInfo = &h->info;
+   return true;
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* AV1 */
+
+struct av1_params {
+   StdVideoAV1SequenceHeader seq;
+   StdVideoAV1ColorConfig color;
+};
+
+struct av1_picture {
+   VkVideoDecodeAV1PictureInfoKHR info;
+   StdVideoDecodeAV1PictureInfo std;
+   StdVideoAV1TileInfo tiles;
+   uint16_t colStarts[64], rowStarts[64], widths[64], heights[64];
+   StdVideoAV1Quantization quantization;
+   StdVideoAV1Segmentation segmentation;
+   StdVideoAV1LoopFilter loopFilter;
+   StdVideoAV1CDEF cdef;
+   StdVideoAV1LoopRestoration restoration;
+   StdVideoAV1GlobalMotion globalMotion;
+   std::vector<uint32_t> tileOffsets, tileSizes;
+   StdVideoDecodeAV1ReferenceInfo setupInfo;
+   VkVideoDecodeAV1DpbSlotInfoKHR setupSlot;
+   StdVideoDecodeAV1ReferenceInfo refInfo[7];
+   VkVideoDecodeAV1DpbSlotInfoKHR refSlot[7];
+};
+
+static UINT
+bit_length(UINT v)
+{
+   UINT n = 0;
+   while (v >> n)
+      n++;
+   return n;
+}
+
+/* The sequence header, from the sequence-level values in DXVA's parameters. What only parsing frame headers needs
+ * (frame size and id bits, warped motion's enable) is set to allow everything: the decoder gets tile data only;
+ * superres is enabled as far as frames use it. */
+static bool
+av1_params_get(decode_session *s, const DXVA_PicParams_AV1 *pp)
+{
+   av1_params p;
+   memset(&p, 0, sizeof(p));
+   StdVideoAV1SequenceHeader &seq = p.seq;
+   seq.flags.use_128x128_superblock = pp->coding.use_128x128_superblock;
+   seq.flags.enable_filter_intra = pp->coding.filter_intra;
+   seq.flags.enable_intra_edge_filter = pp->coding.intra_edge_filter;
+   seq.flags.enable_interintra_compound = pp->coding.interintra_compound;
+   seq.flags.enable_masked_compound = pp->coding.masked_compound;
+   seq.flags.enable_warped_motion = 1;
+   seq.flags.enable_dual_filter = pp->coding.dual_filter;
+   seq.flags.enable_order_hint = pp->order_hint_bits != 0;
+   seq.flags.enable_jnt_comp = pp->coding.jnt_comp;
+   seq.flags.enable_ref_frame_mvs = pp->coding.enable_ref_frame_mvs;
+   seq.flags.enable_superres = pp->coding.superres;
+   seq.flags.enable_cdef = pp->coding.cdef;
+   seq.flags.enable_restoration = pp->coding.restoration;
+   seq.flags.film_grain_params_present = pp->coding.film_grain;
+   seq.seq_profile = (StdVideoAV1Profile)pp->seq_profile;
+   seq.frame_width_bits_minus_1 = (uint8_t)(std::max(bit_length(pp->max_width - 1), 1u) - 1);
+   seq.frame_height_bits_minus_1 = (uint8_t)(std::max(bit_length(pp->max_height - 1), 1u) - 1);
+   seq.max_frame_width_minus_1 = (uint16_t)(pp->max_width - 1);
+   seq.max_frame_height_minus_1 = (uint16_t)(pp->max_height - 1);
+   seq.order_hint_bits_minus_1 = pp->order_hint_bits ? pp->order_hint_bits - 1 : 0;
+   seq.seq_force_integer_mv = 2; /* SELECT_INTEGER_MV */
+   seq.seq_force_screen_content_tools = 2; /* SELECT_SCREEN_CONTENT_TOOLS */
+   p.color.BitDepth = pp->bitdepth;
+   p.color.subsampling_x = pp->format.subsampling_x;
+   p.color.subsampling_y = pp->format.subsampling_y;
+   p.color.flags.mono_chrome = pp->format.mono_chrome;
+   /* not in DXVA: unspecified (0 would be identity matrix coefficients, RGB) */
+   p.color.color_primaries = STD_VIDEO_AV1_COLOR_PRIMARIES_UNSPECIFIED;
+   p.color.transfer_characteristics = STD_VIDEO_AV1_TRANSFER_CHARACTERISTICS_UNSPECIFIED;
+   p.color.matrix_coefficients = STD_VIDEO_AV1_MATRIX_COEFFICIENTS_UNSPECIFIED;
+   if (!params_changed(s, p))
+      return true;
+   p.seq.pColorConfig = &p.color;
+   VkVideoDecodeAV1SessionParametersCreateInfoKHR info = {
+      VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_SESSION_PARAMETERS_CREATE_INFO_KHR};
+   info.pStdSequenceHeader = &p.seq;
+   return params_create(s, &info);
+}
+
+/* DXVA's AV1 parameters lack what is about the references: their order hints and frame types, the skip mode frames,
+ * sign biases. Each DPB slot keeps that of its picture (decode_slot::av1); the rest is derived as the AV1 spec does.
+ * Film grain isn't applied (ponytail: it needs an output picture apart from the DPB, VK_KHR_video's distinct mode). */
+static bool
+decode_av1(const decode_input &d, decode_picture *pic, av1_picture *h)
+{
+   UINT tileBytes = d.sliceBytes;
+   const auto *pp = (const DXVA_PicParams_AV1 *)frame_argument(
+      d.in, D3D12DDI_VIDEO_DECODE_PARAMETER_TYPE_0020_PICTURE_PARAMETERS, sizeof(DXVA_PicParams_AV1));
+   if (!pp || !av1_params_get(d.s, pp))
+      return false;
+   pic->extent = {pp->width, pp->height};
+   for (int i = 0; i < 8; i++)
+      if (pp->RefFrameMapTextureIndex[i] != DXVA_INVALID_ENTRY)
+         keep_add(pic, d.in->ReferenceFrames, pp->RefFrameMapTextureIndex[i]);
+   if (!decode_slots_assign(d.s, pic, d.output, d.outputSub))
+      return false;
+
+   bool intra = pp->format.frame_type == STD_VIDEO_AV1_FRAME_TYPE_KEY ||
+                pp->format.frame_type == STD_VIDEO_AV1_FRAME_TYPE_INTRA_ONLY;
+   int bits = pp->order_hint_bits;
+   auto relative = [bits](int a, int b) {
+      if (!bits)
+         return 0;
+      int diff = a - b, m = 1 << (bits - 1);
+      return (diff & (m - 1)) - (diff & m);
+   };
+   int cur = pp->order_hint;
+   int refHint[7] = {};
+   bool refOk[7] = {};
+   UINT n = 0;
+   for (int i = 0; i < 7; i++) {
+      h->info.referenceNameSlotIndices[i] = -1;
+      UINT map = pp->frame_refs[i].Index;
+      if (intra || map >= 8 || pp->RefFrameMapTextureIndex[map] == DXVA_INVALID_ENTRY)
+         continue;
+      int k = keep_index(pic, d.in->ReferenceFrames, pp->RefFrameMapTextureIndex[map]);
+      if (k < 0 || pic->keep[k].slot < 0)
+         continue;
+      const decode_slot &slot = d.s->slots[pic->keep[k].slot];
+      h->info.referenceNameSlotIndices[i] = pic->keep[k].slot;
+      refHint[i] = slot.av1.OrderHint;
+      refOk[i] = true;
+      if (std::find(pic->used.begin(), pic->used.end(), k) == pic->used.end()) {
+         h->refInfo[n] = slot.av1;
+         h->refSlot[n].sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_DPB_SLOT_INFO_KHR;
+         h->refSlot[n].pStdReferenceInfo = &h->refInfo[n];
+         use_add(pic, k, &h->refSlot[n]);
+         n++;
+      }
+   }
+
+   StdVideoDecodeAV1PictureInfo &std = h->std;
+   /* OrderHints[LAST_FRAME + i], the sign biases (order hints after the current one) */
+   uint8_t signBias = 0;
+   for (int i = 0; i < 7; i++) {
+      std.OrderHints[1 + i] = (uint8_t)refHint[i];
+      if (refOk[i] && relative(refHint[i], cur) > 0)
+         signBias |= 1 << (1 + i);
+   }
+   /* skip mode frames (AV1 spec 5.9.22) */
+   if (pp->coding.skip_mode && !intra) {
+      int forward = -1, backward = -1, second = -1;
+      for (int i = 0; i < 7; i++) {
+         if (!refOk[i])
+            continue;
+         int r = relative(refHint[i], cur);
+         if (r < 0 && (forward < 0 || relative(refHint[i], refHint[forward]) > 0))
+            forward = i;
+         else if (r > 0 && (backward < 0 || relative(refHint[i], refHint[backward]) < 0))
+            backward = i;
+      }
+      if (forward >= 0 && backward < 0) {
+         for (int i = 0; i < 7; i++)
+            if (refOk[i] && relative(refHint[i], refHint[forward]) < 0 &&
+                (second < 0 || relative(refHint[i], refHint[second]) > 0))
+               second = i;
+         backward = second;
+      }
+      if (forward >= 0 && backward >= 0) {
+         std.SkipModeFrame[0] = (uint8_t)(1 + std::min(forward, backward));
+         std.SkipModeFrame[1] = (uint8_t)(1 + std::max(forward, backward));
+      }
+   }
+
+   /* tiles: DXVA's sizes in superblocks; the starts in 4x4 units (MiColStarts) */
+   UINT cols = std::min<UINT>(pp->tiles.cols, 64), rows = std::min<UINT>(pp->tiles.rows, 64);
+   UINT miPerSb = pp->coding.use_128x128_superblock ? 32 : 16;
+   for (UINT i = 0, start = 0; i < cols; start += pp->tiles.widths[i], i++) {
+      h->colStarts[i] = (uint16_t)(start * miPerSb);
+      h->widths[i] = (uint16_t)(pp->tiles.widths[i] - 1);
+   }
+   for (UINT i = 0, start = 0; i < rows; start += pp->tiles.heights[i], i++) {
+      h->rowStarts[i] = (uint16_t)(start * miPerSb);
+      h->heights[i] = (uint16_t)(pp->tiles.heights[i] - 1);
+   }
+   h->tiles.TileCols = (uint8_t)cols;
+   h->tiles.TileRows = (uint8_t)rows;
+   h->tiles.context_update_tile_id = pp->tiles.context_update_id;
+   /* the tile size fields' length: the gap before each tile's data after the first */
+   h->tiles.tile_size_bytes_minus_1 = 3;
+   if (tileBytes >= 2 * sizeof(DXVA_Tile_AV1)) {
+      const auto *t = (const DXVA_Tile_AV1 *)d.slices;
+      UINT gap = t[1].DataOffset - (t[0].DataOffset + t[0].DataSize);
+      if (gap >= 1 && gap <= 4)
+         h->tiles.tile_size_bytes_minus_1 = (uint8_t)(gap - 1);
+   }
+   /* uniform spacing: all tiles but the last the same size, the last no larger */
+   bool uniform = true;
+   for (UINT i = 1; i < cols; i++)
+      uniform &= i + 1 < cols ? pp->tiles.widths[i] == pp->tiles.widths[0] : pp->tiles.widths[i] <= pp->tiles.widths[0];
+   for (UINT i = 1; i < rows; i++)
+      uniform &= i + 1 < rows ? pp->tiles.heights[i] == pp->tiles.heights[0] : pp->tiles.heights[i] <= pp->tiles.heights[0];
+   h->tiles.flags.uniform_tile_spacing_flag = uniform;
+   h->tiles.pMiColStarts = h->colStarts;
+   h->tiles.pMiRowStarts = h->rowStarts;
+   h->tiles.pWidthInSbsMinus1 = h->widths;
+   h->tiles.pHeightInSbsMinus1 = h->heights;
+   for (UINT i = 0; i < tileBytes / sizeof(DXVA_Tile_AV1); i++) {
+      const auto &t = ((const DXVA_Tile_AV1 *)d.slices)[i];
+      h->tileOffsets.push_back(t.DataOffset);
+      h->tileSizes.push_back(t.DataSize);
+   }
+
+   const auto &q = pp->quantization;
+   h->quantization.flags.using_qmatrix = q.qm_y != 0xff;
+   h->quantization.flags.diff_uv_delta = q.u_dc_delta_q != q.v_dc_delta_q || q.u_ac_delta_q != q.v_ac_delta_q;
+   h->quantization.base_q_idx = q.base_qindex;
+   h->quantization.DeltaQYDc = q.y_dc_delta_q;
+   h->quantization.DeltaQUDc = q.u_dc_delta_q;
+   h->quantization.DeltaQUAc = q.u_ac_delta_q;
+   h->quantization.DeltaQVDc = q.v_dc_delta_q;
+   h->quantization.DeltaQVAc = q.v_ac_delta_q;
+   if (h->quantization.flags.using_qmatrix) {
+      h->quantization.qm_y = q.qm_y;
+      h->quantization.qm_u = q.qm_u;
+      h->quantization.qm_v = q.qm_v;
+   }
+
+   for (int i = 0; i < 8; i++) {
+      h->segmentation.FeatureEnabled[i] = pp->segmentation.feature_mask[i];
+      for (int j = 0; j < 8; j++)
+         h->segmentation.FeatureData[i][j] = pp->segmentation.feature_data[i][j];
+   }
+
+   const auto &lf = pp->loop_filter;
+   h->loopFilter.flags.loop_filter_delta_enabled = lf.mode_ref_delta_enabled;
+   h->loopFilter.flags.loop_filter_delta_update = lf.mode_ref_delta_update;
+   h->loopFilter.loop_filter_level[0] = lf.filter_level[0];
+   h->loopFilter.loop_filter_level[1] = lf.filter_level[1];
+   h->loopFilter.loop_filter_level[2] = lf.filter_level_u;
+   h->loopFilter.loop_filter_level[3] = lf.filter_level_v;
+   h->loopFilter.loop_filter_sharpness = lf.sharpness_level;
+   for (int i = 0; i < 8; i++)
+      h->loopFilter.loop_filter_ref_deltas[i] = lf.ref_deltas[i];
+   for (int i = 0; i < 2; i++)
+      h->loopFilter.loop_filter_mode_deltas[i] = lf.mode_deltas[i];
+
+   h->cdef.cdef_damping_minus_3 = pp->cdef.damping;
+   h->cdef.cdef_bits = pp->cdef.bits;
+   for (int i = 0; i < 8; i++) {
+      h->cdef.cdef_y_pri_strength[i] = pp->cdef.y_strengths[i].primary;
+      h->cdef.cdef_y_sec_strength[i] = pp->cdef.y_strengths[i].secondary;
+      h->cdef.cdef_uv_pri_strength[i] = pp->cdef.uv_strengths[i].primary;
+      h->cdef.cdef_uv_sec_strength[i] = pp->cdef.uv_strengths[i].secondary;
+   }
+
+   /* restoration types as the spec numbers them (both); unit sizes: DXVA's log2, Vulkan's log2 - 5 */
+   for (int i = 0; i < 3; i++) {
+      h->restoration.FrameRestorationType[i] = (StdVideoAV1FrameRestorationType)lf.frame_restoration_type[i];
+      h->restoration.LoopRestorationSize[i] =
+         lf.frame_restoration_type[i] && lf.log2_restoration_unit_size[i] >= 5 ? lf.log2_restoration_unit_size[i] - 5 : 1;
+   }
+
+   /* global motion per reference (index 0, the intra frame: unused) */
+   for (int i = 0; i < 7; i++) {
+      h->globalMotion.GmType[1 + i] = pp->frame_refs[i].wmtype;
+      for (int j = 0; j < 6; j++)
+         h->globalMotion.gm_params[1 + i][j] = pp->frame_refs[i].wmmat[j];
+   }
+
+   /* shown key frames are error resilient (the spec infers it) */
+   std.flags.error_resilient_mode = pp->format.frame_type == STD_VIDEO_AV1_FRAME_TYPE_KEY && pp->format.show_frame;
+   std.flags.disable_cdf_update = pp->coding.disable_cdf_update;
+   std.flags.use_superres = pp->coding.superres;
+   std.flags.allow_screen_content_tools = pp->coding.screen_content_tools;
+   std.flags.is_filter_switchable = pp->interp_filter == STD_VIDEO_AV1_INTERPOLATION_FILTER_SWITCHABLE;
+   std.flags.force_integer_mv = pp->coding.integer_mv;
+   std.flags.allow_intrabc = pp->coding.intrabc;
+   std.flags.allow_high_precision_mv = pp->coding.high_precision_mv;
+   std.flags.is_motion_mode_switchable = pp->coding.switchable_motion_mode;
+   std.flags.use_ref_frame_mvs = pp->coding.use_ref_frame_mvs;
+   std.flags.disable_frame_end_update_cdf = pp->coding.disable_frame_end_update_cdf;
+   std.flags.allow_warped_motion = pp->coding.warped_motion;
+   std.flags.reduced_tx_set = pp->coding.reduced_tx_set;
+   std.flags.reference_select = pp->coding.reference_mode;
+   std.flags.skip_mode_present = pp->coding.skip_mode;
+   std.flags.delta_q_present = q.delta_q_present;
+   std.flags.delta_lf_present = lf.delta_lf_present;
+   std.flags.delta_lf_multi = lf.delta_lf_multi;
+   std.flags.segmentation_enabled = pp->segmentation.enabled;
+   std.flags.segmentation_update_map = pp->segmentation.update_map;
+   std.flags.segmentation_temporal_update = pp->segmentation.temporal_update;
+   std.flags.segmentation_update_data = pp->segmentation.update_data;
+   std.flags.UsesLr = lf.frame_restoration_type[0] || lf.frame_restoration_type[1] || lf.frame_restoration_type[2];
+   std.flags.usesChromaLr = lf.frame_restoration_type[1] || lf.frame_restoration_type[2];
+   std.frame_type = (StdVideoAV1FrameType)pp->format.frame_type;
+   std.OrderHint = (uint8_t)cur;
+   std.primary_ref_frame = pp->primary_ref_frame;
+   /* not in DXVA (NVIDIA's decoder does use it, consistently 0xff keeps its reference state consistent); ponytail:
+    * multi-tile 8-bit streams then decode with off-by-one chroma samples here and there (one test clip: U at ~75 dB,
+    * all else bit-exact), the real value would need the frame header, which DXVA doesn't pass */
+   std.refresh_frame_flags = pp->coding.reference_frame_update ? 0xff : 0;
+   std.interpolation_filter = (StdVideoAV1InterpolationFilter)pp->interp_filter;
+   std.TxMode = (StdVideoAV1TxMode)pp->coding.tx_mode;
+   std.delta_q_res = q.delta_q_res;
+   std.delta_lf_res = lf.delta_lf_res;
+   std.coded_denom = pp->coding.superres && pp->superres_denom >= 9 ? pp->superres_denom - 9 : 0;
+   std.pTileInfo = &h->tiles;
+   std.pQuantization = &h->quantization;
+   std.pSegmentation = &h->segmentation;
+   std.pLoopFilter = &h->loopFilter;
+   std.pCDEF = &h->cdef;
+   std.pLoopRestoration = &h->restoration;
+   std.pGlobalMotion = &h->globalMotion;
+
+   /* what later pictures need of this one */
+   StdVideoDecodeAV1ReferenceInfo &self = d.s->slots[pic->setup].av1;
+   memset(&self, 0, sizeof(self));
+   self.flags.disable_frame_end_update_cdf = pp->coding.disable_frame_end_update_cdf;
+   self.flags.segmentation_enabled = pp->segmentation.enabled;
+   self.frame_type = pp->format.frame_type;
+   self.RefFrameSignBias = signBias;
+   self.OrderHint = (uint8_t)cur;
+   memcpy(self.SavedOrderHints, std.OrderHints, sizeof(self.SavedOrderHints));
+   h->setupInfo = self;
+   /* the picture's own saved order hints aren't the setup's (as ffmpeg's decoder, verified on NVIDIA) */
+   memset(h->setupInfo.SavedOrderHints, 0, sizeof(h->setupInfo.SavedOrderHints));
+   h->setupSlot.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_DPB_SLOT_INFO_KHR;
+   h->setupSlot.pStdReferenceInfo = &h->setupInfo;
+   pic->setupInfo = &h->setupSlot;
+
+   h->info.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_PICTURE_INFO_KHR;
+   h->info.pStdPictureInfo = &std;
+   h->info.tileCount = (uint32_t)h->tileOffsets.size();
+   h->info.pTileOffsets = h->tileOffsets.data();
+   h->info.pTileSizes = h->tileSizes.data();
+   pic->pictureInfo = &h->info;
+   return true;
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* DecodeFrame */
+
+static void APIENTRY
+decode_frame(D3D12DDI_HCOMMANDLIST hList, D3D12DDI_HVIDEODECODER_0020,
+             const D3D12DDI_VIDEO_DECODE_OUTPUT_STREAM_ARGUMENTS_0041_1 *out,
+             const D3D12DDI_VIDEO_DECODE_INPUT_STREAM_ARGUMENTS_0032 *in)
+{
+   viogpu_command_list *list = list_from(hList);
+   viogpu_device *device = list->device;
+   auto fail = [list](HRESULT hr, const char *why) {
+      viogpu_log("video: DecodeFrame: %s", why);
+      viogpu_command_list_error(list, hr);
+   };
+   viogpu_video *v = device->video;
+   viogpu_video_decoder_heap *heap = (viogpu_video_decoder_heap *)in->hDrvVideoDecoderHeap.pDrvPrivate;
+   decode_session *s = v && heap ? decode_session_get(heap) : NULL;
+   if (!s)
+      return fail(E_FAIL, "no session");
+   if (out->ConversionArguments.Enable)
+      return fail(E_INVALIDARG, "conversion not supported");
+   viogpu_resource *output = (viogpu_resource *)out->hDrvOutputTexture2D.pDrvPrivate;
+   viogpu_resource *bitstream = (viogpu_resource *)in->CompressedBitstream.hDrvBuffer.pDrvPrivate;
+   decode_input d = {s, in, output ? output->resource : NULL, out->OutputSubresource, NULL, 0};
+   d.slices = frame_argument(in, D3D12DDI_VIDEO_DECODE_PARAMETER_TYPE_0020_SLICE_CONTROL, 1, &d.sliceBytes);
+   if (!output || !bitstream || !d.slices)
+      return fail(E_INVALIDARG, "no output, bitstream or slice control");
+
+   /* the picture: parameters, references, the codec's Vulkan structures */
+   decode_picture pic;
+   pic.setup = -1;
+   pic.setupInfo = pic.pictureInfo = NULL;
+   h264_picture h264 = {};
+   h265_picture h265 = {};
+   vp9_picture vp9 = {};
+   av1_picture av1 = {};
+   bool ok = false;
+   switch (s->profile.codec) {
+   case CODEC_H264: ok = decode_h264(d, &pic, &h264); break;
+   case CODEC_HEVC: ok = decode_h265(d, &pic, &h265); break;
+   case CODEC_VP9: ok = decode_vp9(d, &pic, &vp9); break;
+   case CODEC_AV1: ok = decode_av1(d, &pic, &av1); break;
+   }
+   if (!ok)
+      return fail(E_INVALIDARG, "picture parameters");
+
+   /* the picture resources: the DPB's layers */
+   auto picture_resource = [&](int slot) {
+      VkVideoPictureResourceInfoKHR r = {VK_STRUCTURE_TYPE_VIDEO_PICTURE_RESOURCE_INFO_KHR};
+      r.codedExtent = s->slots[slot].extent;
+      r.imageViewBinding = s->dpbViews[slot];
+      return r;
+   };
+   std::vector<VkVideoPictureResourceInfoKHR> refPictures(pic.used.size());
+   std::vector<VkVideoReferenceSlotInfoKHR> refSlots(pic.used.size());
+   for (size_t u = 0; u < pic.used.size(); u++) {
+      int slot = pic.keep[pic.used[u]].slot;
+      refPictures[u] = picture_resource(slot);
+      refSlots[u] = {VK_STRUCTURE_TYPE_VIDEO_REFERENCE_SLOT_INFO_KHR};
+      refSlots[u].pNext = pic.usedInfo[u];
+      refSlots[u].slotIndex = slot;
+      refSlots[u].pPictureResource = &refPictures[u];
+   }
+   VkVideoPictureResourceInfoKHR setupPicture = picture_resource(pic.setup);
+   VkVideoReferenceSlotInfoKHR setupSlot = {VK_STRUCTURE_TYPE_VIDEO_REFERENCE_SLOT_INFO_KHR};
+   setupSlot.pNext = pic.setupInfo;
+   setupSlot.slotIndex = pic.setup;
+   setupSlot.pPictureResource = &setupPicture;
+   VkExtent2D extent = s->slots[pic.setup].extent;
+
+   /* the bitstream: the application's buffer as it is */
+   UINT64 bufferHandle = 0, bufferOffset = 0, outputHandle = 0, unused = 0;
+   int bufferFormat = 0, outputFormat = 0;
+   if (FAILED(viogpu_bridge_resource_info(device->vkd3d, bitstream->resource, &bufferHandle, &bufferOffset, &bufferFormat)) ||
+       FAILED(viogpu_bridge_resource_info(device->vkd3d, output->resource, &outputHandle, &unused, &outputFormat)))
+      return fail(E_INVALIDARG, "resource info");
+   VkDeviceSize offsetAlign = std::max<VkDeviceSize>(s->caps->caps.minBitstreamBufferOffsetAlignment, 1);
+   VkDeviceSize sizeAlign = std::max<VkDeviceSize>(s->caps->caps.minBitstreamBufferSizeAlignment, 1);
+   VkDeviceSize srcOffset = bufferOffset + in->CompressedBitstream.Offset;
+   VkDeviceSize srcRange = (in->CompressedBitstream.Size + sizeAlign - 1) / sizeAlign * sizeAlign;
+   /* the aligned size may reach past the buffer's end, into the 4 KiB vkd3d-proton pads decode buffers' Vulkan
+    * buffers to (ponytail: offsets as applications use them, a buffer's start; a misaligned one would need a copy) */
+   if (srcOffset % offsetAlign || in->CompressedBitstream.Offset + srcRange > align_up((UINT)bitstream->desc.Width, 4096)) {
+      viogpu_log("video: bitstream at %llu (+%llu bytes) in a %llu byte buffer: not aligned for the decoder",
+                 (unsigned long long)srcOffset, (unsigned long long)in->CompressedBitstream.Size,
+                 (unsigned long long)bitstream->desc.Width);
+      return fail(E_INVALIDARG, "bitstream alignment");
+   }
+   VkImage outputImage = vk_handle<VkImage>(outputHandle);
+   UINT outputLayer = texture_layer(output, out->OutputSubresource);
+   VkImageLayout outputLayout =
+      (VkImageLayout)viogpu_bridge_image_layout(device->vkd3d, output->resource, D3D12_RESOURCE_STATE_VIDEO_DECODE_WRITE);
+
+   /* record (the output texture's first use: vkd3d-proton's initial transition first, or it discards the picture) */
+   viogpu_bridge_track_resource(list->list, output->resource);
+   VkCommandBuffer cmd;
+   if (FAILED(viogpu_bridge_begin_vk_commands(device->vkd3d, list->list, (void **)&cmd)))
+      return fail(E_FAIL, "BeginVkCommandBufferInterop");
+   std::vector<VkImageMemoryBarrier2> images;
+   for (size_t slot = 0; slot < s->slots.size(); slot++) {
+      if (s->slots[slot].used && !s->slots[slot].initialized) {
+         images.push_back(image_barrier(s->dpb[slot], 0, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_VIDEO_DECODE_DPB_KHR));
+         s->slots[slot].initialized = true;
+      }
+   }
+   /* earlier decodes' and copies' DPB accesses before this one */
+   barrier(v, cmd, images.data(), (uint32_t)images.size(), VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+           VK_ACCESS_2_MEMORY_WRITE_BIT, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+           VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT);
+
+   std::vector<VkVideoReferenceSlotInfoKHR> beginSlots(refSlots);
+   VkVideoReferenceSlotInfoKHR activate = setupSlot;
+   activate.slotIndex = -1;
+   activate.pNext = NULL;
+   beginSlots.push_back(activate);
+   VkVideoBeginCodingInfoKHR begin = {VK_STRUCTURE_TYPE_VIDEO_BEGIN_CODING_INFO_KHR};
+   begin.videoSession = s->session;
+   begin.videoSessionParameters = s->params;
+   begin.referenceSlotCount = (uint32_t)beginSlots.size();
+   begin.pReferenceSlots = beginSlots.data();
+   v->CmdBeginVideoCodingKHR(cmd, &begin);
+   if (!s->reset) {
+      VkVideoCodingControlInfoKHR control = {VK_STRUCTURE_TYPE_VIDEO_CODING_CONTROL_INFO_KHR};
+      control.flags = VK_VIDEO_CODING_CONTROL_RESET_BIT_KHR;
+      v->CmdControlVideoCodingKHR(cmd, &control);
+      s->reset = true;
+   }
+   VkVideoDecodeInfoKHR decode = {VK_STRUCTURE_TYPE_VIDEO_DECODE_INFO_KHR};
+   decode.pNext = pic.pictureInfo;
+   decode.srcBuffer = vk_handle<VkBuffer>(bufferHandle);
+   decode.srcBufferOffset = srcOffset;
+   decode.srcBufferRange = srcRange;
+   decode.dstPictureResource = setupPicture;
+   decode.pSetupReferenceSlot = &setupSlot;
+   decode.referenceSlotCount = (uint32_t)refSlots.size();
+   decode.pReferenceSlots = refSlots.data();
+   v->CmdDecodeVideoKHR(cmd, &decode);
+   VkVideoEndCodingInfoKHR end = {VK_STRUCTURE_TYPE_VIDEO_END_CODING_INFO_KHR};
+   v->CmdEndVideoCodingKHR(cmd, &end);
+
+   /* the picture into the application's texture (both planes) */
+   VkImageLayout dstLayout = outputLayout == VK_IMAGE_LAYOUT_GENERAL ? VK_IMAGE_LAYOUT_GENERAL
+                                                                     : VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+   VkImageMemoryBarrier2 toCopy[2] = {
+      image_barrier(s->dpb[pic.setup], 0, VK_IMAGE_LAYOUT_VIDEO_DECODE_DPB_KHR, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL),
+      image_barrier(outputImage, outputLayer, outputLayout, dstLayout),
+   };
+   barrier(v, cmd, toCopy, dstLayout != outputLayout ? 2 : 1, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+           VK_ACCESS_2_MEMORY_WRITE_BIT, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+           VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT);
+   UINT width = std::min<UINT>(extent.width, (UINT)output->desc.Width);
+   UINT height = std::min<UINT>(extent.height, output->desc.Height);
+   VkImageCopy planes[2] = {};
+   for (int plane = 0; plane < 2; plane++) {
+      VkImageAspectFlagBits aspect = plane ? VK_IMAGE_ASPECT_PLANE_1_BIT : VK_IMAGE_ASPECT_PLANE_0_BIT;
+      planes[plane].srcSubresource = {(VkImageAspectFlags)aspect, 0, 0, 1};
+      planes[plane].dstSubresource = {(VkImageAspectFlags)aspect, 0, outputLayer, 1};
+      planes[plane].extent = {plane ? (width + 1) / 2 : width, plane ? (height + 1) / 2 : height, 1};
+   }
+   v->CmdCopyImage(cmd, s->dpb[pic.setup], VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, outputImage, dstLayout, 2, planes);
+   images.clear();
+   images.push_back(image_barrier(s->dpb[pic.setup], 0, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_VIDEO_DECODE_DPB_KHR));
+   if (dstLayout != outputLayout)
+      images.push_back(image_barrier(outputImage, outputLayer, dstLayout, outputLayout));
+   barrier(v, cmd, images.data(), (uint32_t)images.size(), VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+           VK_ACCESS_2_MEMORY_WRITE_BIT, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+           VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT);
+   viogpu_bridge_end_vk_commands(device->vkd3d, list->list);
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Tables */
+
+void
+decode_fill_device_table(D3D12DDI_DEVICE_FUNCS_VIDEO_0082_0 *f)
+{
+   f->pfnCalcPrivateVideoDecoderSize = calc_decoder_size;
+   f->pfnCreateVideoDecoder = create_decoder;
+   f->pfnDestroyVideoDecoder = destroy_decoder;
+   f->pfnCalcPrivateVideoDecoderHeapSize = calc_decoder_heap_size;
+   f->pfnCreateVideoDecoderHeap = create_decoder_heap;
+   f->pfnDestroyVideoDecoderHeap = destroy_decoder_heap;
+}
+
+void
+decode_fill_list_table(D3D12DDI_COMMAND_LIST_FUNCS_VIDEO_DECODE_0063 *f)
+{
+   f->pfnDecodeFrame = decode_frame;
+}
