+/* ---------------------------------------------------------------------------------------------------------------- */
+/* H.264 */
+
+/* DecodeFrame's codec-specific Vulkan structures, kept together while the command is recorded */
+struct h264_picture {
+   VkVideoDecodeH264PictureInfoKHR info;
+   StdVideoDecodeH264PictureInfo std;
+   std::vector<uint32_t> sliceOffsets;
+   StdVideoDecodeH264ReferenceInfo setupInfo;
+   VkVideoDecodeH264DpbSlotInfoKHR setupSlot;
+   StdVideoDecodeH264ReferenceInfo refInfo[16];
+   VkVideoDecodeH264DpbSlotInfoKHR refSlot[16];
+};
+
+static StdVideoH264LevelIdc
+h264_level(const decode_caps *c)
+{
+   return c->h264.maxLevelIdc;
+}
+
+/* The SPS and PPS the picture parameters stand for (ids 0; scaling lists in the PPS, as DXVA has the ones in
+ * effect) */
+static void
+h264_params_fill(const decode_caps *c, const DXVA_PicParams_H264 *pp, const DXVA_Qmatrix_H264 *qm, h264_params *p)
+{
+   memset(p, 0, sizeof(*p));
+   StdVideoH264SequenceParameterSet &sps = p->sps;
+   sps.flags.direct_8x8_inference_flag = pp->direct_8x8_inference_flag;
+   sps.flags.mb_adaptive_frame_field_flag = pp->MbaffFrameFlag;
+   sps.flags.frame_mbs_only_flag = pp->frame_mbs_only_flag;
+   sps.flags.delta_pic_order_always_zero_flag = pp->delta_pic_order_always_zero_flag;
+   sps.flags.gaps_in_frame_num_value_allowed_flag = 1;
+   sps.profile_idc = STD_VIDEO_H264_PROFILE_IDC_HIGH;
+   sps.level_idc = h264_level(c);
+   sps.chroma_format_idc = (StdVideoH264ChromaFormatIdc)pp->chroma_format_idc;
+   sps.bit_depth_luma_minus8 = pp->bit_depth_luma_minus8;
+   sps.bit_depth_chroma_minus8 = pp->bit_depth_chroma_minus8;
+   sps.log2_max_frame_num_minus4 = pp->log2_max_frame_num_minus4;
+   sps.pic_order_cnt_type = (StdVideoH264PocType)pp->pic_order_cnt_type;
+   sps.log2_max_pic_order_cnt_lsb_minus4 = pp->log2_max_pic_order_cnt_lsb_minus4;
+   sps.max_num_ref_frames = pp->num_ref_frames;
+   sps.pic_width_in_mbs_minus1 = pp->wFrameWidthInMbsMinus1;
+   /* map units: frames or field pairs */
+   sps.pic_height_in_map_units_minus1 =
+      pp->frame_mbs_only_flag ? pp->wFrameHeightInMbsMinus1 : (pp->wFrameHeightInMbsMinus1 + 1) / 2 - 1;
+
+   StdVideoH264PictureParameterSet &pps = p->pps;
+   pps.flags.transform_8x8_mode_flag = pp->transform_8x8_mode_flag;
+   pps.flags.redundant_pic_cnt_present_flag = pp->redundant_pic_cnt_present_flag;
+   pps.flags.constrained_intra_pred_flag = pp->constrained_intra_pred_flag;
+   pps.flags.deblocking_filter_control_present_flag = pp->deblocking_filter_control_present_flag;
+   pps.flags.weighted_pred_flag = pp->weighted_pred_flag;
+   pps.flags.bottom_field_pic_order_in_frame_present_flag = pp->pic_order_present_flag;
+   pps.flags.entropy_coding_mode_flag = pp->entropy_coding_mode_flag;
+   pps.flags.pic_scaling_matrix_present_flag = qm != NULL;
+   pps.num_ref_idx_l0_default_active_minus1 = pp->num_ref_idx_l0_active_minus1;
+   pps.num_ref_idx_l1_default_active_minus1 = pp->num_ref_idx_l1_active_minus1;
+   pps.weighted_bipred_idc = (StdVideoH264WeightedBipredIdc)pp->weighted_bipred_idc;
+   pps.pic_init_qp_minus26 = pp->pic_init_qp_minus26;
+   pps.pic_init_qs_minus26 = pp->pic_init_qs_minus26;
+   pps.chroma_qp_index_offset = pp->chroma_qp_index_offset;
+   pps.second_chroma_qp_index_offset = pp->second_chroma_qp_index_offset;
+   if (qm) {
+      /* DXVA's lists are in zigzag order as Vulkan's; its 8x8 ones are intra and inter luma, Vulkan's first two */
+      p->lists.scaling_list_present_mask = 0xff;
+      memcpy(p->lists.ScalingList4x4, qm->bScalingLists4x4, sizeof(qm->bScalingLists4x4));
+      memcpy(p->lists.ScalingList8x8, qm->bScalingLists8x8, sizeof(qm->bScalingLists8x8));
+   }
+}
+
+static bool
+h264_params_get(decode_session *s, const DXVA_PicParams_H264 *pp, const DXVA_Qmatrix_H264 *qm)
+{
+   h264_params p;
+   h264_params_fill(s->caps, pp, qm, &p);
+   if (!params_changed(s, p))
+      return true;
+   if (qm)
+      p.pps.pScalingLists = &p.lists;
+   VkVideoDecodeH264SessionParametersAddInfoKHR add = {VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_SESSION_PARAMETERS_ADD_INFO_KHR};
+   add.stdSPSCount = 1;
+   add.pStdSPSs = &p.sps;
+   add.stdPPSCount = 1;
+   add.pStdPPSs = &p.pps;
+   VkVideoDecodeH264SessionParametersCreateInfoKHR info = {
+      VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_SESSION_PARAMETERS_CREATE_INFO_KHR};
+   info.maxStdSPSCount = 1;
+   info.maxStdPPSCount = 1;
+   info.pParametersAddInfo = &add;
+   return params_create(s, &info);
+}
+
+static bool
+decode_h264(const decode_input &d, decode_picture *pic, h264_picture *h)
+{
+   const auto *pp = (const DXVA_PicParams_H264 *)frame_argument(
+      d.in, D3D12DDI_VIDEO_DECODE_PARAMETER_TYPE_0020_PICTURE_PARAMETERS, sizeof(DXVA_PicParams_H264));
+   const auto *qm = (const DXVA_Qmatrix_H264 *)frame_argument(
+      d.in, D3D12DDI_VIDEO_DECODE_PARAMETER_TYPE_0020_INVERSE_QUANTIZATION_MATRIX, sizeof(DXVA_Qmatrix_H264));
+   if (!pp || !h264_params_get(d.s, pp, qm))
+      return false;
+   pic->extent = {(pp->wFrameWidthInMbsMinus1 + 1u) * 16, (pp->wFrameHeightInMbsMinus1 + 1u) * 16};
+   /* the references DXVA lists (the DPB's reference pictures: all of them are Vulkan's references too) */
+   std::vector<UINT> listed;
+   for (UINT i = 0; i < 16; i++) {
+      if (pp->RefFrameList[i].bPicEntry == DXVA_INVALID_ENTRY || (pp->NonExistingFrameFlags & (1u << i)) ||
+          !((pp->UsedForReferenceFlags >> (2 * i)) & 3))
+         continue;
+      keep_add(pic, d.in->ReferenceFrames, pp->RefFrameList[i].Index7Bits);
+      listed.push_back(i);
+   }
+   if (!decode_slots_assign(d.s, pic, d.output, d.outputSub))
+      return false;
+   UINT n = 0;
+   for (UINT i : listed) {
+      UINT used = (pp->UsedForReferenceFlags >> (2 * i)) & 3;
+      StdVideoDecodeH264ReferenceInfo &ri = h->refInfo[n];
+      ri.flags.top_field_flag = used == 1;
+      ri.flags.bottom_field_flag = used == 2;
+      ri.flags.used_for_long_term_reference = pp->RefFrameList[i].AssociatedFlag;
+      ri.FrameNum = pp->FrameNumList[i];
+      ri.PicOrderCnt[0] = pp->FieldOrderCntList[i][0];
+      ri.PicOrderCnt[1] = pp->FieldOrderCntList[i][1];
+      h->refSlot[n].sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_DPB_SLOT_INFO_KHR;
+      h->refSlot[n].pStdReferenceInfo = &ri;
+      use_add(pic, keep_index(pic, d.in->ReferenceFrames, pp->RefFrameList[i].Index7Bits), &h->refSlot[n]);
+      n++;
+   }
+   StdVideoDecodeH264PictureInfo &std = h->std;
+   std.flags.field_pic_flag = pp->field_pic_flag;
+   std.flags.is_intra = pp->IntraPicFlag;
+   /* DXVA has no IDR flag: an intra picture with frame_num 0 and no references is one */
+   std.flags.IdrPicFlag = pp->IntraPicFlag && pp->frame_num == 0 && listed.empty();
+   std.flags.bottom_field_flag = pp->field_pic_flag && pp->CurrPic.AssociatedFlag;
+   std.flags.is_reference = pp->RefPicFlag;
+   std.frame_num = pp->frame_num;
+   std.PicOrderCnt[0] = pp->CurrFieldOrderCnt[0];
+   std.PicOrderCnt[1] = pp->CurrFieldOrderCnt[1];
+   h->setupInfo.FrameNum = pp->frame_num;
+   h->setupInfo.PicOrderCnt[0] = pp->CurrFieldOrderCnt[0];
+   h->setupInfo.PicOrderCnt[1] = pp->CurrFieldOrderCnt[1];
+   h->setupSlot.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_DPB_SLOT_INFO_KHR;
+   h->setupSlot.pStdReferenceInfo = &h->setupInfo;
+   pic->setupInfo = &h->setupSlot;
+   for (UINT i = 0; i < d.sliceBytes / sizeof(DXVA_Slice_Short); i++)
+      h->sliceOffsets.push_back(((const DXVA_Slice_Short *)d.slices)[i].BSNALunitDataLocation);
+   h->info.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_PICTURE_INFO_KHR;
+   h->info.pStdPictureInfo = &std;
+   h->info.sliceCount = (uint32_t)h->sliceOffsets.size();
+   h->info.pSliceOffsets = h->sliceOffsets.data();
+   pic->pictureInfo = &h->info;
+   return true;
+}
