index 00000000..a19f33ff
--- /dev/null
+++ b/libs/viogpu_umd/umd_video_decode.cpp
@@ -0,0 +1,1765 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/* D3D12 video decoding (H.264, HEVC Main/Main 10, VP9 profiles 0/2, AV1 Main 8/10-bit) on Vulkan Video's decode
+ * queue, the same way as the encoder
+ * (umd_video.cpp): video decoding lists are vkd3d-proton direct lists on the decode queue family, into which
+ * DecodeFrame records Vulkan Video.
+ *
+ * What D3D12 and Vulkan Video see differently:
+ * - Parameter sets: D3D12 gets DXVA's picture parameters (the parameter sets' values and the slice headers' that
+ *   matter, per picture); Vulkan wants SPS/PPS (VPS) objects. They are rebuilt from the picture parameters, and
+ *   new session parameters made when they change.
+ * - References: DXVA names reference pictures by their index in the application's reference texture list; Vulkan
+ *   by DPB slot. The decoder keeps its own DPB (images with the session's profile) and decodes into it
+ *   (DPB and output coincide), then copies the picture into the application's output texture: application
+ *   textures need no video usage (vkd3d-proton makes P010 G16; video wants G10X6, the same bytes). The slots
+ *   follow the application's textures (texture and subresource -> slot).
+ * The decoder's objects: the session (parameters, DPB) lives in the decoder heap, which D3D12 makes per resolution
+ * and DPB size; ponytail: one decoder per heap (what applications do). */
+
+#include "umd_video.h"
+#include "umd_dxva.h"
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Profiles and caps */
+
+enum decode_codec { CODEC_H264, CODEC_HEVC, CODEC_VP9, CODEC_AV1 };
+
+/* What is offered: a D3D12 decode profile with an output format (a Vulkan profile each) */
+struct decode_profile_def {
+   GUID guid;
+   decode_codec codec;
+   DXGI_FORMAT format;
+   int stdProfile;
+};
+
+static const decode_profile_def DECODE_PROFILES[] = {
+   /* D3D12_VIDEO_DECODE_PROFILE_H264 (DXVA2_ModeH264_VLD_NoFGT) */
+   {{0x1b81be68, 0xa0c7, 0x11d3, {0xb9, 0x84, 0x00, 0xc0, 0x4f, 0x2e, 0x73, 0xc5}}, CODEC_H264, DXGI_FORMAT_NV12,
+    STD_VIDEO_H264_PROFILE_IDC_HIGH},
+   /* D3D12_VIDEO_DECODE_PROFILE_HEVC_MAIN, _MAIN10 */
+   {{0x5b11d51b, 0x2f4c, 0x4452, {0xbc, 0xc3, 0x09, 0xf2, 0xa1, 0x16, 0x0c, 0xc0}}, CODEC_HEVC, DXGI_FORMAT_NV12,
+    STD_VIDEO_H265_PROFILE_IDC_MAIN},
+   {{0x107af0e0, 0xef1a, 0x4d19, {0xab, 0xa8, 0x67, 0xa1, 0x63, 0x07, 0x3d, 0x13}}, CODEC_HEVC, DXGI_FORMAT_P010,
+    STD_VIDEO_H265_PROFILE_IDC_MAIN_10},
+   /* D3D12_VIDEO_DECODE_PROFILE_VP9, _VP9_10BIT_PROFILE2 */
+   {{0x463707f8, 0xa1d0, 0x4585, {0x87, 0x6d, 0x83, 0xaa, 0x6d, 0x60, 0xb8, 0x9e}}, CODEC_VP9, DXGI_FORMAT_NV12,
+    STD_VIDEO_VP9_PROFILE_0},
+   {{0xa4c749ef, 0x6ecf, 0x48aa, {0x84, 0x48, 0x50, 0xa7, 0xa1, 0x16, 0x5f, 0xf7}}, CODEC_VP9, DXGI_FORMAT_P010,
+    STD_VIDEO_VP9_PROFILE_2},
+   /* D3D12_VIDEO_DECODE_PROFILE_AV1_PROFILE0: 8 and 10 bits */
+   {{0xb8be4ccb, 0xcf53, 0x46ba, {0x8d, 0x59, 0xd6, 0xb8, 0xa6, 0xda, 0x5d, 0x2a}}, CODEC_AV1, DXGI_FORMAT_NV12,
+    STD_VIDEO_AV1_PROFILE_MAIN},
+   {{0xb8be4ccb, 0xcf53, 0x46ba, {0x8d, 0x59, 0xd6, 0xb8, 0xa6, 0xda, 0x5d, 0x2a}}, CODEC_AV1, DXGI_FORMAT_P010,
+    STD_VIDEO_AV1_PROFILE_MAIN},
+};
+#define DECODE_PROFILE_COUNT (sizeof(DECODE_PROFILES) / sizeof(DECODE_PROFILES[0]))
+
+/* DXVA_NoEncrypt */
+static const GUID decode_encryption_none = {0x1b81bed0, 0xa0c7, 0x11d3, {0xb9, 0x84, 0x00, 0xc0, 0x4f, 0x2e, 0x73, 0xc5}};
+
+struct decode_profile {
+   VkVideoProfileInfoKHR info;
+   VkVideoDecodeH264ProfileInfoKHR h264;
+   VkVideoDecodeH265ProfileInfoKHR h265;
+   VkVideoDecodeVP9ProfileInfoKHR vp9;
+   VkVideoDecodeAV1ProfileInfoKHR av1;
+   VkVideoProfileListInfoKHR list;
+   VkFormat format;
+   decode_codec codec;
+};
+
+struct decode_caps {
+   bool queried, ok;
+   VkVideoCapabilitiesKHR caps;
+   VkVideoDecodeCapabilitiesKHR decode;
+   VkVideoDecodeH264CapabilitiesKHR h264;
+   VkVideoDecodeH265CapabilitiesKHR h265;
+   VkVideoDecodeVP9CapabilitiesKHR vp9;
+   VkVideoDecodeAV1CapabilitiesKHR av1;
+};
+
+static void
+decode_profile_fill(decode_profile *p, int index)
+{
+   const decode_profile_def &d = DECODE_PROFILES[index];
+   memset(p, 0, sizeof(*p));
+   p->codec = d.codec;
+   bool ten = d.format == DXGI_FORMAT_P010;
+   p->info.sType = VK_STRUCTURE_TYPE_VIDEO_PROFILE_INFO_KHR;
+   p->info.chromaSubsampling = VK_VIDEO_CHROMA_SUBSAMPLING_420_BIT_KHR;
+   p->info.lumaBitDepth = p->info.chromaBitDepth =
+      ten ? VK_VIDEO_COMPONENT_BIT_DEPTH_10_BIT_KHR : VK_VIDEO_COMPONENT_BIT_DEPTH_8_BIT_KHR;
+   switch (d.codec) {
+   case CODEC_H264:
+      p->info.videoCodecOperation = VK_VIDEO_CODEC_OPERATION_DECODE_H264_BIT_KHR;
+      p->h264.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_PROFILE_INFO_KHR;
+      p->h264.stdProfileIdc = (StdVideoH264ProfileIdc)d.stdProfile;
+      /* ponytail: progressive only; interlaced H.264 (field pictures, MBAFF) would need the interleaved layout */
+      p->h264.pictureLayout = VK_VIDEO_DECODE_H264_PICTURE_LAYOUT_PROGRESSIVE_KHR;
+      p->info.pNext = &p->h264;
+      break;
+   case CODEC_HEVC:
+      p->info.videoCodecOperation = VK_VIDEO_CODEC_OPERATION_DECODE_H265_BIT_KHR;
+      p->h265.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_PROFILE_INFO_KHR;
+      p->h265.stdProfileIdc = (StdVideoH265ProfileIdc)d.stdProfile;
+      p->info.pNext = &p->h265;
+      break;
+   case CODEC_VP9:
+      p->info.videoCodecOperation = VK_VIDEO_CODEC_OPERATION_DECODE_VP9_BIT_KHR;
+      p->vp9.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_VP9_PROFILE_INFO_KHR;
+      p->vp9.stdProfile = (StdVideoVP9Profile)d.stdProfile;
+      p->info.pNext = &p->vp9;
+      break;
+   case CODEC_AV1:
+      p->info.videoCodecOperation = VK_VIDEO_CODEC_OPERATION_DECODE_AV1_BIT_KHR;
+      p->av1.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_PROFILE_INFO_KHR;
+      p->av1.stdProfile = (StdVideoAV1Profile)d.stdProfile;
+      /* film grain needs an output picture apart from the DPB (see decode_av1) */
+      p->av1.filmGrainSupport = VK_FALSE;
+      p->info.pNext = &p->av1;
+      break;
+   }
+   p->list.sType = VK_STRUCTURE_TYPE_VIDEO_PROFILE_LIST_INFO_KHR;
+   p->list.profileCount = 1;
+   p->list.pProfiles = &p->info;
+   p->format = ten ? VK_FORMAT_G10X6_B10X6R10X6_2PLANE_420_UNORM_3PACK16 : VK_FORMAT_G8_B8R8_2PLANE_420_UNORM;
+}
+
+/* The DPB usage the decoder needs of a profile's pictures: decoded into (coinciding with the output), copied out */
+static const VkImageUsageFlags DPB_USAGE =
+   VK_IMAGE_USAGE_VIDEO_DECODE_DPB_BIT_KHR | VK_IMAGE_USAGE_VIDEO_DECODE_DST_BIT_KHR | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+
+static bool
+decode_format_ok(viogpu_video *v, decode_profile *p)
+{
+   VkPhysicalDeviceVideoFormatInfoKHR info = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VIDEO_FORMAT_INFO_KHR};
+   info.pNext = &p->list;
+   info.imageUsage = DPB_USAGE;
+   uint32_t count = 0;
+   if (v->GetPhysicalDeviceVideoFormatPropertiesKHR(v->physical, &info, &count, NULL) != VK_SUCCESS || !count)
+      return false;
+   std::vector<VkVideoFormatPropertiesKHR> props(count, {VK_STRUCTURE_TYPE_VIDEO_FORMAT_PROPERTIES_KHR});
+   if (v->GetPhysicalDeviceVideoFormatPropertiesKHR(v->physical, &info, &count, props.data()) != VK_SUCCESS)
+      return false;
+   for (const auto &f : props)
+      if (f.format == p->format && f.imageTiling == VK_IMAGE_TILING_OPTIMAL)
+         return true;
+   return false;
+}
+
+static const decode_caps *
+decode_caps_get(viogpu_video *v, int index)
+{
+   if (!v || index < 0 || index >= (int)DECODE_PROFILE_COUNT || v->decodeFamily == VK_QUEUE_FAMILY_IGNORED)
+      return NULL;
+   if (!v->decodeCaps)
+      v->decodeCaps = new decode_caps[DECODE_PROFILE_COUNT]();
+   decode_caps *c = &v->decodeCaps[index];
+   if (!c->queried) {
+      c->queried = true;
+      decode_profile p;
+      decode_profile_fill(&p, index);
+      c->caps.sType = VK_STRUCTURE_TYPE_VIDEO_CAPABILITIES_KHR;
+      c->caps.pNext = &c->decode;
+      c->decode.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_CAPABILITIES_KHR;
+      switch (p.codec) {
+      case CODEC_H264:
+         c->decode.pNext = &c->h264;
+         c->h264.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H264_CAPABILITIES_KHR;
+         break;
+      case CODEC_HEVC:
+         c->decode.pNext = &c->h265;
+         c->h265.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_H265_CAPABILITIES_KHR;
+         break;
+      case CODEC_VP9:
+         c->decode.pNext = &c->vp9;
+         c->vp9.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_VP9_CAPABILITIES_KHR;
+         break;
+      case CODEC_AV1:
+         c->decode.pNext = &c->av1;
+         c->av1.sType = VK_STRUCTURE_TYPE_VIDEO_DECODE_AV1_CAPABILITIES_KHR;
+         break;
+      }
+      VkResult r = v->GetPhysicalDeviceVideoCapabilitiesKHR(v->physical, &p.info, &c->caps);
+      /* decoding into the DPB and copying out needs coinciding DPB and output pictures (ponytail: a decoder with
+       * distinct ones only would need an output picture of its own) */
+      c->ok = r == VK_SUCCESS && c->caps.maxDpbSlots >= 2 &&
+              (c->decode.flags & VK_VIDEO_DECODE_CAPABILITY_DPB_AND_OUTPUT_COINCIDE_BIT_KHR) && decode_format_ok(v, &p);
+      viogpu_log("video: decode profile %d: %s (result %d, flags 0x%x, %ux%u..%ux%u, %u slots, %u active references)",
+                 index, c->ok ? "supported" : "not supported", (int)r, (unsigned)c->decode.flags,
+                 c->caps.minCodedExtent.width, c->caps.minCodedExtent.height, c->caps.maxCodedExtent.width,
+                 c->caps.maxCodedExtent.height, c->caps.maxDpbSlots, c->caps.maxActiveReferencePictures);
+   }
+   return c->ok ? c : NULL;
+}
+
+void
+decode_caps_destroy(viogpu_video *v)
+{
+   delete[] v->decodeCaps;
+   v->decodeCaps = NULL;
+}
+
+bool
+decode_supported(viogpu_video *v)
+{
+   for (int i = 0; i < (int)DECODE_PROFILE_COUNT; i++)
+      if (decode_caps_get(v, i))
+         return true;
+   return false;
+}
+
+/* A configuration and format -> the profile index, or -1 */
+static int
+decode_profile_index(const D3D12DDI_VIDEO_DECODE_CONFIGURATION_0020 &config, DXGI_FORMAT format)
+{
+   static const GUID none = {};
+   if (config.BitstreamEncryption != none && config.BitstreamEncryption != decode_encryption_none)
+      return -1;
+   /* ponytail: progressive pictures only (see decode_profile_fill) */
+   if (config.InterlaceType != D3D12DDI_VIDEO_CODED_INTERLACE_TYPE_0020_NONE)
+      return -1;
+   for (int i = 0; i < (int)DECODE_PROFILE_COUNT; i++)
+      if (DECODE_PROFILES[i].guid == config.DecodeProfile && DECODE_PROFILES[i].format == format)
+         return i;
+   return -1;
+}
+
+/* The distinct profile GUIDs offered (H.264 when nothing is: the runtime wants a decode profile on a graphics device,
+ * only compute-only ones may have none, so then it is listed and DECODE_SUPPORT says no) */
+static std::vector<GUID>
+decode_guids(viogpu_video *v)
+{
+   std::vector<GUID> guids;
+   for (int i = 0; i < (int)DECODE_PROFILE_COUNT; i++)
+      if (decode_caps_get(v, i) && std::find(guids.begin(), guids.end(), DECODE_PROFILES[i].guid) == guids.end())
+         guids.push_back(DECODE_PROFILES[i].guid);
+   if (guids.empty())
+      guids.push_back(DECODE_PROFILES[0].guid);
+   return guids;
+}
+
+static std::vector<DXGI_FORMAT>
+decode_formats(viogpu_video *v, const GUID &guid)
+{
+   std::vector<DXGI_FORMAT> formats;
+   for (int i = 0; i < (int)DECODE_PROFILE_COUNT; i++)
+      if (DECODE_PROFILES[i].guid == guid && decode_caps_get(v, i))
+         formats.push_back(DECODE_PROFILES[i].format);
+   if (formats.empty())
+      formats.push_back(DXGI_FORMAT_NV12);
+   return formats;
+}
+
+#define CAPS(T) (args->DataSize >= sizeof(T) ? (T *)args->pData : NULL)
+
+HRESULT
+decode_get_caps(viogpu_video *v, const D3D12DDIARG_VIDEO_GETCAPS_0020 *args)
+{
+   switch (args->Type) {
+   case D3D12DDICAPS_TYPE_VIDEO_0032_DECODE_PROFILE_COUNT: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_PROFILE_COUNT_DATA_0032);
+      if (!d)
+         return E_INVALIDARG;
+      d->ProfileCount = (UINT)decode_guids(v).size();
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0020_DECODE_PROFILES: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_PROFILES_DATA_0020);
+      std::vector<GUID> guids = decode_guids(v);
+      if (!d || d->ProfileCount < guids.size() || !d->pProfiles)
+         return E_INVALIDARG;
+      std::copy(guids.begin(), guids.end(), d->pProfiles);
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0032_DECODE_FORMAT_COUNT: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_FORMAT_COUNT_DATA_0032);
+      if (!d)
+         return E_INVALIDARG;
+      d->FormatCount = (UINT)decode_formats(v, d->Configuration.DecodeProfile).size();
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0020_DECODE_FORMATS: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_FORMATS_DATA_0020);
+      std::vector<DXGI_FORMAT> formats = d ? decode_formats(v, d->Configuration.DecodeProfile) : std::vector<DXGI_FORMAT>();
+      if (!d || d->FormatCount < formats.size() || !d->pOutputFormats)
+         return E_INVALIDARG;
+      std::copy(formats.begin(), formats.end(), d->pOutputFormats);
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0032_DECODE_BITSTREAM_ENCRYPTION_SCHEME_COUNT: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_BITSTREAM_ENCRYPTION_SCHEME_COUNT_DATA_0032);
+      if (!d)
+         return E_INVALIDARG;
+      d->BitstreamEncryptionSchemeCount = 1;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0020_DECODE_BITSTREAM_ENCRYPTION_SCHEMES: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_BITSTREAM_ENCRYPTION_SCHEMES_DATA_0020);
+      if (!d || d->EncryptionSchemeCount < 1 || !d->pEncryptionSchemes)
+         return E_INVALIDARG;
+      d->pEncryptionSchemes[0] = decode_encryption_none;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0020_DECODE_SUPPORT: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_SUPPORT_DATA_0020);
+      if (!d)
+         return E_INVALIDARG;
+      const decode_caps *c = decode_caps_get(v, decode_profile_index(d->Configuration, d->DecodeFormat));
+      bool ok = c && d->Width >= c->caps.minCodedExtent.width && d->Height >= c->caps.minCodedExtent.height &&
+                d->Width <= c->caps.maxCodedExtent.width && d->Height <= c->caps.maxCodedExtent.height;
+      d->SupportFlags = ok ? D3D12DDI_VIDEO_DECODE_SUPPORT_FLAG_0020_SUPPORTED : D3D12DDI_VIDEO_DECODE_SUPPORT_FLAG_0020_NONE;
+      d->ConfigurationFlags = D3D12DDI_VIDEO_DECODE_CONFIGURATION_FLAG_0020_NONE;
+      /* tier 2: references in separate textures or texture arrays (the DPB is the decoder's own either way) */
+      d->DecodeTier = ok ? D3D12DDI_VIDEO_DECODE_TIER_0020_2 : D3D12DDI_VIDEO_DECODE_TIER_0020_NOT_SUPPORTED;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0020_DECODE_CONVERSION_SUPPORT: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_CONVERSION_SUPPORT_DATA_0032);
+      if (!d)
+         return E_INVALIDARG;
+      /* no decode-time conversion or scaling (the video processor's job) */
+      d->SupportFlags = D3D12DDI_VIDEO_DECODE_CONVERSION_SUPPORT_FLAG_0020_NONE;
+      memset(&d->ScaleSupport, 0, sizeof(d->ScaleSupport));
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0032_DECODER_HEAP_SIZE: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODER_HEAP_SIZE_DATA_0072);
+      if (!d)
+         return E_INVALIDARG;
+      d->MemoryPoolL0Size = 0;
+      d->MemoryPoolL1Size = 0;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0040_DECODE_HISTOGRAM: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_HISTOGRAM_DATA_0041);
+      if (!d)
+         return E_INVALIDARG;
+      d->Components = D3D12DDI_VIDEO_DECODE_HISTOGRAM_COMPONENT_FLAG_0041_NONE;
+      d->BinCount = 0;
+      d->CounterBitDepth = 0;
+      return S_OK;
+   }
+   default:
+      return E_INVALIDARG;
+   }
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Decoders, heaps and the session */
+
+struct viogpu_video_decoder {
+   D3D12DDI_VIDEO_DECODE_CONFIGURATION_0020 config;
+};
+
+/* What a DPB slot holds: the application's picture it stands for, its size, and (AV1) what pictures that reference
+ * it need to know of it */
+struct decode_slot {
+   bool used;
+   bool initialized;
+   ID3D12Resource *texture;
+   UINT subresource;
+   VkExtent2D extent;
+   StdVideoDecodeAV1ReferenceInfo av1;
+};
+
+/* The parameter sets as last made (pointers cleared: compared bytewise) */
+struct h264_params {
+   StdVideoH264SequenceParameterSet sps;
+   StdVideoH264PictureParameterSet pps;
+   StdVideoH264ScalingLists lists;
+};
+
+struct h265_params {
+   StdVideoH265VideoParameterSet vps;
+   StdVideoH265SequenceParameterSet sps;
+   StdVideoH265PictureParameterSet pps;
+   StdVideoH265ProfileTierLevel ptl;
+   StdVideoH265DecPicBufMgr dpbm;
+   StdVideoH265ScalingLists lists;
+   StdVideoH265ShortTermRefPicSet rps[STD_VIDEO_H265_MAX_SHORT_TERM_REF_PIC_SETS];
+   StdVideoH265LongTermRefPicsSps ltr;
+};
+
+struct decode_session {
+   viogpu_video *video;
+   decode_profile profile;
+   const decode_caps *caps;
+   VkExtent2D maxExtent;
+   VkVideoSessionKHR session;
+   std::vector<VkDeviceMemory> memory;
+   VkVideoSessionParametersKHR params;
+   std::vector<uint8_t> paramsKey;
+   /* parameters replaced while lists may still use them: freed with the session */
+   std::vector<VkVideoSessionParametersKHR> oldParams;
+   /* one image per slot (as ffmpeg's Vulkan decoder has them) */
+   std::vector<VkImage> dpb;
+   std::vector<VkDeviceMemory> dpbMemory;
+   std::vector<VkImageView> dpbViews;
+   std::vector<decode_slot> slots;
+   bool reset;
+};
+
+struct viogpu_video_decoder_heap {
+   viogpu_device *device;
+   int profile;
+   UINT width, height;
+   UINT dpbCount;
+   decode_session *session;
+};
+
+static SIZE_T APIENTRY
+calc_decoder_size(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATE_VIDEO_DECODER_0072 *)
+{
+   return sizeof(viogpu_video_decoder);
+}
+
+static HRESULT APIENTRY
+create_decoder(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_VIDEO_DECODER_0072 *args, D3D12DDI_HVIDEODECODER_0020 h)
+{
+   viogpu_video *v = video_get(device_from(hDevice));
+   bool any = false;
+   for (int i = 0; i < (int)DECODE_PROFILE_COUNT; i++)
+      any |= DECODE_PROFILES[i].guid == args->Configuration.DecodeProfile && decode_caps_get(v, i);
+   if (!any) {
+      viogpu_log("video: CreateVideoDecoder: profile not supported");
+      return E_INVALIDARG;
+   }
+   viogpu_video_decoder *decoder = new (h.pDrvPrivate) viogpu_video_decoder();
+   decoder->config = args->Configuration;
+   return S_OK;
+}
+
+static VOID APIENTRY
+destroy_decoder(D3D12DDI_HDEVICE, D3D12DDI_HVIDEODECODER_0020 h)
+{
+   ((viogpu_video_decoder *)h.pDrvPrivate)->~viogpu_video_decoder();
+}
+
+static SIZE_T APIENTRY
+calc_decoder_heap_size(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATE_VIDEO_DECODER_HEAP_0072 *)
+{
+   return sizeof(viogpu_video_decoder_heap);
+}
+
+static HRESULT APIENTRY
+create_decoder_heap(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_VIDEO_DECODER_HEAP_0072 *args,
+                    D3D12DDI_HVIDEODECODERHEAP_0032 h)
+{
+   viogpu_device *device = device_from(hDevice);
+   int index = decode_profile_index(args->Configuration, args->Format);
+   const decode_caps *c = decode_caps_get(video_get(device), index);
+   if (!c || args->DecodeWidth > c->caps.maxCodedExtent.width || args->DecodeHeight > c->caps.maxCodedExtent.height) {
+      viogpu_log("video: CreateVideoDecoderHeap: profile %d, %ux%u not supported", index, args->DecodeWidth,
+                 args->DecodeHeight);
+      return E_INVALIDARG;
+   }
+   viogpu_video_decoder_heap *heap = new (h.pDrvPrivate) viogpu_video_decoder_heap();
+   heap->device = device;
+   heap->profile = index;
+   heap->width = args->DecodeWidth;
+   heap->height = args->DecodeHeight;
+   heap->dpbCount = args->MaxDecodePictureBufferCount;
+   viogpu_log("video: CreateVideoDecoderHeap: profile %d, %ux%u, %u pictures", index, heap->width, heap->height,
+              heap->dpbCount);
+   return S_OK;
+}
+
+static void
+decode_session_destroy(decode_session *s)
+{
+   viogpu_video *v = s->video;
+   for (VkImageView view : s->dpbViews)
+      v->DestroyImageView(v->device, view, NULL);
+   for (VkImage image : s->dpb)
+      v->DestroyImage(v->device, image, NULL);
+   for (VkDeviceMemory m : s->dpbMemory)
+      v->FreeMemory(v->device, m, NULL);
+   for (VkVideoSessionParametersKHR p : s->oldParams)
+      v->DestroyVideoSessionParametersKHR(v->device, p, NULL);
+   if (s->params)
+      v->DestroyVideoSessionParametersKHR(v->device, s->params, NULL);
+   if (s->session)
+      v->DestroyVideoSessionKHR(v->device, s->session, NULL);
+   for (VkDeviceMemory m : s->memory)
+      v->FreeMemory(v->device, m, NULL);
+   delete s;
+}
+
+static VOID APIENTRY
+destroy_decoder_heap(D3D12DDI_HDEVICE, D3D12DDI_HVIDEODECODERHEAP_0032 h)
+{
+   viogpu_video_decoder_heap *heap = (viogpu_video_decoder_heap *)h.pDrvPrivate;
+   if (heap->session)
+      decode_session_destroy(heap->session);
+   heap->~viogpu_video_decoder_heap();
+}
+
+static UINT
+align_up(UINT v, UINT a)
+{
+   return a ? (v + a - 1) / a * a : v;
+}
+
+/* The session and its DPB, made by the heap's first DecodeFrame */
+static decode_session *
+decode_session_get(viogpu_video_decoder_heap *heap)
+{
+   if (heap->session)
+      return heap->session;
+   viogpu_video *v = heap->device->video;
+   decode_session *s = new decode_session();
+   s->video = v;
+   decode_profile_fill(&s->profile, heap->profile);
+   s->caps = decode_caps_get(v, heap->profile);
+   /* the heap's size as the codecs' coded sizes (macroblock, CTB aligned) and the decoder's access granularity round
+    * it */
+   VkExtent2D granularity = s->caps->caps.pictureAccessGranularity;
+   UINT block = s->profile.codec == CODEC_H264 ? 16 : s->profile.codec == CODEC_HEVC ? 64 : 8;
+   s->maxExtent.width = std::min(align_up(align_up(heap->width, block), std::max(granularity.width, 1u)),
+                                 s->caps->caps.maxCodedExtent.width);
+   s->maxExtent.height = std::min(align_up(align_up(heap->height, block), std::max(granularity.height, 1u)),
+                                  s->caps->caps.maxCodedExtent.height);
+   /* the application's references and the current picture */
+   uint32_t slots = std::min(s->caps->caps.maxDpbSlots, std::max(heap->dpbCount, 2u) + 1);
+
+   VkVideoSessionCreateInfoKHR info = {VK_STRUCTURE_TYPE_VIDEO_SESSION_CREATE_INFO_KHR};
+   info.queueFamilyIndex = v->decodeFamily;
+   info.pVideoProfile = &s->profile.info;
+   info.pictureFormat = s->profile.format;
+   info.maxCodedExtent = s->maxExtent;
+   info.referencePictureFormat = s->profile.format;
+   info.maxDpbSlots = slots;
+   info.maxActiveReferencePictures = std::min(s->caps->caps.maxActiveReferencePictures, slots - 1);
+   info.pStdHeaderVersion = &s->caps->caps.stdHeaderVersion;
+   VkResult r = v->CreateVideoSessionKHR(v->device, &info, NULL, &s->session);
+   if (r != VK_SUCCESS) {
+      viogpu_log("video: decode vkCreateVideoSessionKHR: %d", (int)r);
+      decode_session_destroy(s);
+      return NULL;
+   }
+
+   uint32_t count = 0;
+   v->GetVideoSessionMemoryRequirementsKHR(v->device, s->session, &count, NULL);
+   std::vector<VkVideoSessionMemoryRequirementsKHR> reqs(count, {VK_STRUCTURE_TYPE_VIDEO_SESSION_MEMORY_REQUIREMENTS_KHR});
+   v->GetVideoSessionMemoryRequirementsKHR(v->device, s->session, &count, reqs.data());
+   std::vector<VkBindVideoSessionMemoryInfoKHR> binds;
+   for (const auto &req : reqs) {
+      VkDeviceMemory memory = memory_allocate(v, req.memoryRequirements.size, req.memoryRequirements.memoryTypeBits);
+      if (!memory) {
+         decode_session_destroy(s);
+         return NULL;
+      }
+      s->memory.push_back(memory);
+      VkBindVideoSessionMemoryInfoKHR bind = {VK_STRUCTURE_TYPE_BIND_VIDEO_SESSION_MEMORY_INFO_KHR};
+      bind.memoryBindIndex = req.memoryBindIndex;
+      bind.memory = memory;
+      bind.memorySize = req.memoryRequirements.size;
+      binds.push_back(bind);
+   }
+   if (count && (r = v->BindVideoSessionMemoryKHR(v->device, s->session, count, binds.data())) != VK_SUCCESS) {
+      viogpu_log("video: decode vkBindVideoSessionMemoryKHR: %d", (int)r);
+      decode_session_destroy(s);
+      return NULL;
+   }
+
+   /* the DPB: an image per slot */
+   VkImageCreateInfo image = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+   image.pNext = &s->profile.list;
+   image.imageType = VK_IMAGE_TYPE_2D;
+   image.format = s->profile.format;
+   image.extent = {s->maxExtent.width, s->maxExtent.height, 1};
+   image.mipLevels = 1;
+   image.arrayLayers = 1;
+   image.samples = VK_SAMPLE_COUNT_1_BIT;
+   image.tiling = VK_IMAGE_TILING_OPTIMAL;
+   image.usage = DPB_USAGE;
+   image.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+   image.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+   for (uint32_t i = 0; i < slots; i++) {
+      VkImage handle;
+      if ((r = v->CreateImage(v->device, &image, NULL, &handle)) != VK_SUCCESS) {
+         viogpu_log("video: decode DPB image: %d", (int)r);
+         decode_session_destroy(s);
+         return NULL;
+      }
+      s->dpb.push_back(handle);
+      VkMemoryRequirements req;
+      v->GetImageMemoryRequirements(v->device, handle, &req);
+      VkDeviceMemory memory = memory_allocate(v, req.size, req.memoryTypeBits);
+      if (memory)
+         s->dpbMemory.push_back(memory);
+      if (!memory || v->BindImageMemory(v->device, handle, memory, 0) != VK_SUCCESS) {
+         viogpu_log("video: no memory for the decode DPB (%llu bytes)", (unsigned long long)req.size);
+         decode_session_destroy(s);
+         return NULL;
+      }
+      VkImageViewCreateInfo view = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+      view.image = handle;
+      view.viewType = VK_IMAGE_VIEW_TYPE_2D;
+      view.format = s->profile.format;
+      view.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+      VkImageView viewHandle;
+      if (v->CreateImageView(v->device, &view, NULL, &viewHandle) != VK_SUCCESS) {
+         decode_session_destroy(s);
+         return NULL;
+      }
+      s->dpbViews.push_back(viewHandle);
+   }
+   s->slots.resize(slots);
+   viogpu_log("video: decode session %ux%u, %u slots", s->maxExtent.width, s->maxExtent.height, slots);
+   heap->session = s;
+   return s;
+}
+
+/* New session parameters when the parameter sets changed (a copy of them, pointers cleared, is the key) */
+template <typename P>
+static bool
+params_changed(decode_session *s, const P &p)
+{
+   if (s->params && s->paramsKey.size() == sizeof(p) && !memcmp(s->paramsKey.data(), &p, sizeof(p)))
+      return false;
+   s->paramsKey.assign((const uint8_t *)&p, (const uint8_t *)&p + sizeof(p));
+   return true;
+}
+
+static bool
+params_create(decode_session *s, const void *codecInfo)
+{
+   viogpu_video *v = s->video;
+   VkVideoSessionParametersCreateInfoKHR info = {VK_STRUCTURE_TYPE_VIDEO_SESSION_PARAMETERS_CREATE_INFO_KHR};
+   info.pNext = codecInfo;
+   info.videoSession = s->session;
+   VkVideoSessionParametersKHR params;
+   VkResult r = v->CreateVideoSessionParametersKHR(v->device, &info, NULL, &params);
+   if (r != VK_SUCCESS) {
+      viogpu_log("video: decode vkCreateVideoSessionParametersKHR: %d", (int)r);
+      s->paramsKey.clear();
+      return false;
+   }
+   if (s->params)
+      s->oldParams.push_back(s->params);
+   s->params = params;
+   return true;
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Slots and pictures */
+
+/* A reference the picture parameters name: the application's texture */
+struct decode_ref {
+   ID3D12Resource *texture;
+   UINT subresource;
+   int slot;
+};
+
+/* A picture as a codec builds it for the recording */
+struct decode_picture {
+   VkExtent2D extent;
+   /* the references the stream still has (their slots stay) */
+   std::vector<decode_ref> keep;
+   /* the ones this picture uses (indices into keep), with their codec DPB slot info (NULL: the codec has none) */
+   std::vector<int> used;
+   std::vector<const void *> usedInfo;
+   int setup;
+   const void *setupInfo;
+   const void *pictureInfo;
+};
+
+/* A DXVA texture index -> the application's texture */
+static bool
+ref_texture(const D3D12DDI_VIDEO_DECODE_REFERENCE_FRAMES_0032 &frames, UINT index, decode_ref *ref)
+{
+   if (index >= frames.NumTexture2Ds || !frames.hDrvTexture2Ds)
+      return false;
+   ref->texture = resource_of(frames.hDrvTexture2Ds[index]);
+   ref->subresource = frames.pSubresources ? frames.pSubresources[index] : 0;
+   ref->slot = -1;
+   return ref->texture != NULL;
+}
+
+/* The kept references' slots (-1: never decoded, as at a stream starting with a non-key picture; pictures that use
+ * one decode without it), the slots of textures no reference names free again, and a slot for the current picture */
+static bool
+decode_slots_assign(decode_session *s, decode_picture *pic, ID3D12Resource *output, UINT outputSub)
+{
+   pic->extent.width = std::min(pic->extent.width, s->maxExtent.width);
+   pic->extent.height = std::min(pic->extent.height, s->maxExtent.height);
+   std::vector<bool> keep(s->slots.size(), false);
+   for (decode_ref &ref : pic->keep) {
+      ref.slot = -1;
+      for (size_t slot = 0; slot < s->slots.size(); slot++) {
+         const decode_slot &d = s->slots[slot];
+         if (d.used && d.texture == ref.texture && d.subresource == ref.subresource) {
+            ref.slot = (int)slot;
+            keep[slot] = true;
+            break;
+         }
+      }
+   }
+   for (size_t slot = 0; slot < s->slots.size(); slot++)
+      if (!keep[slot])
+         s->slots[slot].used = false;
+   pic->setup = -1;
+   for (size_t slot = 0; slot < s->slots.size() && pic->setup < 0; slot++) {
+      decode_slot &d = s->slots[slot];
+      if (!d.used) {
+         d.used = true;
+         d.texture = output;
+         d.subresource = outputSub;
+         d.extent = pic->extent;
+         pic->setup = (int)slot;
+      }
+   }
+   if (pic->setup < 0)
+      viogpu_log("video: no free decode DPB slot");
+   return pic->setup >= 0;
+}
+
+/* The kept reference for a texture index (-1: none) */
+static int
+keep_index(const decode_picture *pic, const D3D12DDI_VIDEO_DECODE_REFERENCE_FRAMES_0032 &frames, UINT index)
+{
+   decode_ref ref;
+   if (!ref_texture(frames, index, &ref))
+      return -1;
+   for (size_t k = 0; k < pic->keep.size(); k++)
+      if (pic->keep[k].texture == ref.texture && pic->keep[k].subresource == ref.subresource)
+         return (int)k;
+   return -1;
+}
+
+static void
+keep_add(decode_picture *pic, const D3D12DDI_VIDEO_DECODE_REFERENCE_FRAMES_0032 &frames, UINT index)
+{
+   decode_ref ref;
+   if (ref_texture(frames, index, &ref) && keep_index(pic, frames, index) < 0)
+      pic->keep.push_back(ref);
+}
+
+/* A reference this picture uses (once each) */
+static void
+use_add(decode_picture *pic, int k, const void *info)
+{
+   if (k < 0 || pic->keep[k].slot < 0 || std::find(pic->used.begin(), pic->used.end(), k) != pic->used.end())
+      return;
+   pic->used.push_back(k);
+   pic->usedInfo.push_back(info);
+}
+
+static const void *
+frame_argument(const D3D12DDI_VIDEO_DECODE_INPUT_STREAM_ARGUMENTS_0032 *in, D3D12DDI_VIDEO_DECODE_PARAMETER_TYPE_0020 type,
+               UINT minSize, UINT *size = NULL)
+{
+   for (UINT i = 0; i < in->NumFrameArguments && i < D3D12DDI_VIDEO_DECODE_MAX_ARGUMENTS_0020; i++) {
+      const auto &a = in->FrameArguments[i];
+      if (a.Type == type && a.pData && a.Size >= minSize) {
+         if (size)
+            *size = a.Size;
+         return a.pData;
+      }
+   }
+   return NULL;
+}
+
+/* What a codec's picture builder gets */
+struct decode_input {
+   decode_session *s;
+   const D3D12DDI_VIDEO_DECODE_INPUT_STREAM_ARGUMENTS_0032 *in;
+   ID3D12Resource *output;
+   UINT outputSub;
+   const void *slices;
+   UINT sliceBytes;
+};
