+HRESULT decode_get_caps(viogpu_video *video, const D3D12DDIARG_VIDEO_GETCAPS_0020 *args);
+void decode_fill_device_table(D3D12DDI_DEVICE_FUNCS_VIDEO_0082_0 *f);
+void decode_fill_list_table(D3D12DDI_COMMAND_LIST_FUNCS_VIDEO_DECODE_0063 *f);
+void decode_caps_destroy(viogpu_video *video);
