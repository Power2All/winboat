+         s->slots[refs.setupSlot].frameNum = frameNum;
+      }
+   } else {
+      bool idr = h265->FrameType == D3D12DDI_VIDEO_ENCODER_FRAME_TYPE_HEVC_0080_IDR_FRAME;
+      kind = h265->FrameType == D3D12DDI_VIDEO_ENCODER_FRAME_TYPE_HEVC_0080_P_FRAME   ? 1
+             : h265->FrameType == D3D12DDI_VIDEO_ENCODER_FRAME_TYPE_HEVC_0080_B_FRAME ? 2
+                                                                                      : 0;
+      qp = cqp_for(seq.RateControl, kind);
+      StdVideoH265PictureType type = idr ? STD_VIDEO_H265_PICTURE_TYPE_IDR
+                                     : kind == 1 ? STD_VIDEO_H265_PICTURE_TYPE_P
+                                     : kind == 2 ? STD_VIDEO_H265_PICTURE_TYPE_B
+                                                 : STD_VIDEO_H265_PICTURE_TYPE_I;
+      INT poc = (INT)h265->PictureOrderCountNumber;
+      bool sao = !!(encoder->hevc.ConfigurationFlags & D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_FLAG_0082_0_ENABLE_SAO_FILTER);
+      vp.std.flags.is_reference = reference;
+      vp.std.flags.IrapPicFlag = idr;
+      vp.std.flags.pic_output_flag = 1;
+      vp.std.pic_type = type;
+      vp.std.pps_pic_parameter_set_id = (uint8_t)h265->slice_pic_parameter_set_id;
+      vp.std.PicOrderCntVal = poc;
+      vp.std.TemporalId = (uint8_t)h265->TemporalLayerIndex;
+
+      /* the short-term reference picture set: every DPB picture, before and after this one by POC */
+      std::vector<std::pair<INT, bool>> before, after;
+      for (UINT i = 0; i < descCount; i++) {
+         const auto &d = h265->pReferenceFramesReconPictureDescriptors[i];
+         if (d.IsLongTermReference)
+            continue;
+         ((INT)d.PictureOrderCountNumber < poc ? before : after)
+            .push_back({(INT)d.PictureOrderCountNumber, !!d.IsRefUsedByCurrentPic});
+      }
+      std::sort(before.begin(), before.end(), [](const auto &a, const auto &b) { return a.first > b.first; });
+      std::sort(after.begin(), after.end(), [](const auto &a, const auto &b) { return a.first < b.first; });
+      INT prev = poc;
+      for (size_t i = 0; i < before.size() && i < STD_VIDEO_H265_MAX_DPB_SIZE; i++) {
+         vp.rps.delta_poc_s0_minus1[i] = (uint16_t)(prev - before[i].first - 1);
+         vp.rps.used_by_curr_pic_s0_flag |= (uint16_t)(before[i].second << i);
+         prev = before[i].first;
+      }
+      prev = poc;
+      for (size_t i = 0; i < after.size() && i < STD_VIDEO_H265_MAX_DPB_SIZE; i++) {
+         vp.rps.delta_poc_s1_minus1[i] = (uint16_t)(after[i].first - prev - 1);
+         vp.rps.used_by_curr_pic_s1_flag |= (uint16_t)(after[i].second << i);
+         prev = after[i].first;
+      }
+      vp.rps.num_negative_pics = (uint8_t)std::min<size_t>(before.size(), STD_VIDEO_H265_MAX_DPB_SIZE);
+      vp.rps.num_positive_pics = (uint8_t)std::min<size_t>(after.size(), STD_VIDEO_H265_MAX_DPB_SIZE);
+      vp.std.pShortTermRefPicSet = &vp.rps;
+      vp.std.pLongTermRefPics = &vp.ltr;
+
+      memset(vp.lists.RefPicList0, STD_VIDEO_H265_NO_REFERENCE_PICTURE, sizeof(vp.lists.RefPicList0));
+      memset(vp.lists.RefPicList1, STD_VIDEO_H265_NO_REFERENCE_PICTURE, sizeof(vp.lists.RefPicList1));
+      UINT l0 = std::min<UINT>(h265->List0ReferenceFramesCount, STD_VIDEO_H265_MAX_NUM_LIST_REF);
+      UINT l1 = std::min<UINT>(h265->List1ReferenceFramesCount, STD_VIDEO_H265_MAX_NUM_LIST_REF);
+      for (UINT i = 0; i < l0; i++)
+         if (h265->pList0ReferenceFrames[i] < descCount)
+            vp.lists.RefPicList0[i] = (uint8_t)refs.slotOf[h265->pList0ReferenceFrames[i]];
+      for (UINT i = 0; i < l1; i++)
+         if (h265->pList1ReferenceFrames[i] < descCount)
+            vp.lists.RefPicList1[i] = (uint8_t)refs.slotOf[h265->pList1ReferenceFrames[i]];
+      vp.lists.num_ref_idx_l0_active_minus1 = (uint8_t)(l0 ? l0 - 1 : 0);
+      vp.lists.num_ref_idx_l1_active_minus1 = (uint8_t)(l1 ? l1 - 1 : 0);
+      vp.std.pRefLists = &vp.lists;
+
+      vp.sliceHeader.flags.first_slice_segment_in_pic_flag = 1;
+      vp.sliceHeader.flags.slice_sao_luma_flag = sao;
+      vp.sliceHeader.flags.slice_sao_chroma_flag = sao;
+      vp.sliceHeader.flags.num_ref_idx_active_override_flag =
+         (kind >= 1 && vp.lists.num_ref_idx_l0_active_minus1) || (kind == 2 && vp.lists.num_ref_idx_l1_active_minus1);
+      vp.sliceHeader.flags.collocated_from_l0_flag = 1;
+      vp.sliceHeader.flags.slice_loop_filter_across_slices_enabled_flag =
+         !(encoder->hevc.ConfigurationFlags & D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_FLAG_0082_0_DISABLE_LOOP_FILTER_ACROSS_SLICES);
+      vp.sliceHeader.slice_type = kind == 1 ? STD_VIDEO_H265_SLICE_TYPE_P
+                                  : kind == 2 ? STD_VIDEO_H265_SLICE_TYPE_B
+                                              : STD_VIDEO_H265_SLICE_TYPE_I;
+      vp.sliceHeader.MaxNumMergeCand = 5;
+      vp.sliceHeader.slice_qp_delta = qp ? (int8_t)((INT)qp - 26) : 0;
+      vp.slice.sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_NALU_SLICE_SEGMENT_INFO_KHR;
+      vp.slice.constantQp = (int32_t)qp;
+      vp.slice.pStdSliceSegmentHeader = &vp.sliceHeader;
+      vp.info.sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_PICTURE_INFO_KHR;
+      vp.info.naluSliceSegmentEntryCount = 1;
+      vp.info.pNaluSliceSegmentEntries = &vp.slice;
+      vp.info.pStdPictureInfo = &vp.std;
+      encode.pNext = &vp.info;
+
+      for (UINT i = 0; i < descCount; i++) {
+         const auto &d = h265->pReferenceFramesReconPictureDescriptors[i];
+         const dpb_slot &slot = s->slots[refs.slotOf[i]];
+         vp.refInfo[i].flags.used_for_long_term_reference = !!d.IsLongTermReference;
+         vp.refInfo[i].pic_type = (StdVideoH265PictureType)slot.pictureType;
+         vp.refInfo[i].PicOrderCntVal = (INT)d.PictureOrderCountNumber;
+         vp.refInfo[i].TemporalId = (uint8_t)d.TemporalLayerIndex;
+         vp.refSlot[i].sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_DPB_SLOT_INFO_KHR;
+         vp.refSlot[i].pStdReferenceInfo = &vp.refInfo[i];
+         refSlots[i].pNext = &vp.refSlot[i];
+      }
+      if (refs.setupSlot >= 0) {
+         vp.setupInfo.pic_type = type;
+         vp.setupInfo.PicOrderCntVal = poc;
+         vp.setupInfo.TemporalId = vp.std.TemporalId;
+         vp.setupSlot.sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_DPB_SLOT_INFO_KHR;
+         vp.setupSlot.pStdReferenceInfo = &vp.setupInfo;
+         setupSlot.pNext = &vp.setupSlot;
+         s->slots[refs.setupSlot].pictureType = type;
+      }
+   }
+
+   /* rate control: the session's state now, and what this frame asks for */
+   UINT gop = hevc ? h265Gop->GOPLength : h264Gop->GOPLength;
+   UINT pPeriod = hevc ? h265Gop->PPicturePeriod : h264Gop->PPicturePeriod;
+   rc_key rc = rc_from(seq.RateControl, gop, pPeriod);
+   bool rcChange = !s->rcSet || s->rc != rc;
+
+   /* record */
+   VkCommandBuffer cmd;
+   if (FAILED(viogpu_bridge_begin_vk_commands(device->vkd3d, list->list, (void **)&cmd))) {
+      viogpu_command_list_error(list, E_FAIL);
+      return;
+   }
+   std::vector<VkImageMemoryBarrier2> images;
+   if (copyInput) {
+      /* both planes into the copy, which then is the input */
+      /* vkd3d-proton keeps read-only textures in SHADER_READ_ONLY_OPTIMAL, no copy source layout */
+      VkImageLayout srcLayout = inputLayout == VK_IMAGE_LAYOUT_GENERAL ? VK_IMAGE_LAYOUT_GENERAL
+                                                                       : VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+      VkImageMemoryBarrier2 toCopy[2] = {
+         image_barrier(s->copy, 0, s->copyUsed ? VK_IMAGE_LAYOUT_VIDEO_ENCODE_SRC_KHR : VK_IMAGE_LAYOUT_UNDEFINED,
+                       VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL),
+         image_barrier(inputImage, inputLayer, inputLayout, srcLayout),
+      };
+      barrier(v, cmd, toCopy, srcLayout != inputLayout ? 2 : 1, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+              VK_ACCESS_2_MEMORY_WRITE_BIT, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+              VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT);
+      VkImageCopy planes[2] = {};
+      for (int plane = 0; plane < 2; plane++) {
+         VkImageAspectFlagBits aspect = plane ? VK_IMAGE_ASPECT_PLANE_1_BIT : VK_IMAGE_ASPECT_PLANE_0_BIT;
+         planes[plane].srcSubresource = {(VkImageAspectFlags)aspect, 0, inputLayer, 1};
+         planes[plane].dstSubresource = {(VkImageAspectFlags)aspect, 0, 0, 1};
+         planes[plane].extent = {plane ? (extent.width + 1) / 2 : extent.width,
+                                 plane ? (extent.height + 1) / 2 : extent.height, 1};
+      }
+      v->CmdCopyImage(cmd, inputImage, srcLayout, s->copy, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 2, planes);
+      images.push_back(image_barrier(s->copy, 0, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_VIDEO_ENCODE_SRC_KHR));
+      if (srcLayout != inputLayout)
+         images.push_back(image_barrier(inputImage, inputLayer, srcLayout, inputLayout));
+      s->copyUsed = true;
+   } else if (inputLayout != VK_IMAGE_LAYOUT_VIDEO_ENCODE_SRC_KHR) {
+      images.push_back(image_barrier(inputImage, inputLayer, inputLayout, VK_IMAGE_LAYOUT_VIDEO_ENCODE_SRC_KHR));
+   }
+   for (size_t slot = 0; slot < s->slots.size(); slot++) {
+      if ((s->slots[slot].used || (int)slot == refs.setupSlot) && !s->slots[slot].initialized) {
+         images.push_back(image_barrier(s->dpb, (UINT)slot, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_VIDEO_ENCODE_DPB_KHR));
+         s->slots[slot].initialized = true;
+      }
+   }
+   /* earlier encodes' DPB writes before this one's reads */
+   barrier(v, cmd, images.data(), (uint32_t)images.size(), VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+           VK_ACCESS_2_MEMORY_WRITE_BIT, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+           VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT);
+
+   uint32_t query = s->nextQuery;
+   s->nextQuery = (s->nextQuery + 1) % QUERY_COUNT;
+   v->CmdResetQueryPool(cmd, s->queries, query, 1);
+
+   std::vector<VkVideoReferenceSlotInfoKHR> beginSlots(refSlots);
+   if (refs.setupSlot >= 0) {
+      VkVideoReferenceSlotInfoKHR activate = setupSlot;
+      activate.slotIndex = -1;
+      activate.pNext = NULL;
+      beginSlots.push_back(activate);
+   }
+   VkVideoBeginCodingInfoKHR begin = {VK_STRUCTURE_TYPE_VIDEO_BEGIN_CODING_INFO_KHR};
+   begin.pNext = s->rcSet ? (const void *)rc_build(s, s->rc) : NULL;
+   begin.videoSession = s->session;
+   begin.videoSessionParameters = s->params;
+   begin.referenceSlotCount = (uint32_t)beginSlots.size();
+   begin.pReferenceSlots = beginSlots.data();
+   v->CmdBeginVideoCodingKHR(cmd, &begin);
+   if (!s->reset || rcChange) {
+      VkVideoCodingControlInfoKHR control = {VK_STRUCTURE_TYPE_VIDEO_CODING_CONTROL_INFO_KHR};
+      control.flags = VK_VIDEO_CODING_CONTROL_ENCODE_RATE_CONTROL_BIT_KHR;
+      if (!s->reset)
+         control.flags |= VK_VIDEO_CODING_CONTROL_RESET_BIT_KHR;
+      control.pNext = rc_build(s, rc);
+      v->CmdControlVideoCodingKHR(cmd, &control);
+      s->reset = true;
+      s->rcSet = true;
+      s->rc = rc;
+   }
+
+   encode.dstBuffer = vk_handle<VkBuffer>(bufferHandle);
+   encode.dstBufferOffset = dstOffset;
+   encode.dstBufferRange = dstRange;
+   encode.srcPictureResource = srcPicture;
+   encode.pSetupReferenceSlot = refs.setupSlot >= 0 ? &setupSlot : NULL;
+   encode.referenceSlotCount = descCount;
+   encode.pReferenceSlots = refSlots.data();
+   v->CmdBeginQuery(cmd, s->queries, query, 0);
+   v->CmdEncodeVideoKHR(cmd, &encode);
+   v->CmdEndQuery(cmd, s->queries, query);
+   VkVideoEndCodingInfoKHR end = {VK_STRUCTURE_TYPE_VIDEO_END_CODING_INFO_KHR};
+   v->CmdEndVideoCodingKHR(cmd, &end);
+
+   /* the input back to vkd3d-proton's layout; the bitstream and the DPB to whoever comes next (the host too) */
+   images.clear();
+   if (!copyInput && inputLayout != VK_IMAGE_LAYOUT_VIDEO_ENCODE_SRC_KHR)
+      images.push_back(image_barrier(inputImage, inputLayer, VK_IMAGE_LAYOUT_VIDEO_ENCODE_SRC_KHR, inputLayout));
+   barrier(v, cmd, images.data(), (uint32_t)images.size(), VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+           VK_ACCESS_2_MEMORY_WRITE_BIT, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT | VK_PIPELINE_STAGE_2_HOST_BIT,
+           VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT | VK_ACCESS_2_HOST_READ_BIT);
+   viogpu_bridge_end_vk_commands(device->vkd3d, list->list);
+
+   /* the metadata buffer stands for this encode's feedback query from now on */
+   ID3D12Resource *metadata = resource_of(out->HWLayoutEncoderMetadataDrvBuffer.hDrvBuffer);
+   EnterCriticalSection(&v->lock);
+   v->metadata[{metadata, out->HWLayoutEncoderMetadataDrvBuffer.Offset}] = {s, query};
+   LeaveCriticalSection(&v->lock);
+}
+
+static void APIENTRY
+resolve_metadata(D3D12DDI_HCOMMANDLIST hList, const D3D12DDI_VIDEO_ENCODER_RESOLVE_METADATA_INPUT_ARGUMENTS_0080_2 *in,
+                 const D3D12DDI_VIDEO_ENCODER_RESOLVE_METADATA_OUTPUT_ARGUMENTS_0082_0 *out)
+{
+   viogpu_command_list *list = list_from(hList);
+   viogpu_video *v = list->device->video;
+   ID3D12Resource *metadata = resource_of(in->HWLayoutEncoderMetadataDrvBuffer.hDrvBuffer);
+   metadata_resolve r = {};
+   EnterCriticalSection(&v->lock);
+   auto it = v->metadata.find({metadata, in->HWLayoutEncoderMetadataDrvBuffer.Offset});
+   if (it != v->metadata.end()) {
+      r.session = it->second.first;
+      r.query = it->second.second;
+      /* applications make metadata buffers per picture: one resolve each */
+      v->metadata.erase(it);
+   }
+   LeaveCriticalSection(&v->lock);
+   r.buffer = resource_of(out->ResolvedLayoutEncoderMetadataDrvBuffer.hDrvBuffer);
+   r.offset = out->ResolvedLayoutEncoderMetadataDrvBuffer.Offset;
+   if (!r.session)
+      viogpu_log("video: ResolveEncoderOutputMetadata: no encode wrote that metadata buffer");
+   list->video->resolves.push_back(r);
+}
