diff --git a/libs/viogpu_umd/umd_bridge.c b/libs/viogpu_umd/umd_bridge.c
index 1aabb336..f352f0f6 100644
--- a/libs/viogpu_umd/umd_bridge.c
+++ b/libs/viogpu_umd/umd_bridge.c
@@ -11,6 +11,7 @@
 #include "vkd3d_win32.h"
 #include "vkd3d.h"
 #include "vkd3d_debug.h"
+#include "vkd3d_device_vkd3d_ext.h"
 #include "umd_bridge.h"
 
 /* The package's own Vulkan driver (Venus, viogpu_vk[_x86].dll next to this DLL), used directly instead of through
@@ -75,6 +76,97 @@ long viogpu_bridge_serialize_root_signature(const void *versioned_desc, void **b
             (ID3DBlob **)blob, NULL);
 }
 
+void *viogpu_bridge_get_instance_proc_addr(void)
+{
+    return (void *)bridge_get_instance_proc_addr();
+}
+
+static ID3D12DXVKInteropDevice1 *bridge_interop(void *device)
+{
+    ID3D12DXVKInteropDevice1 *interop = NULL;
+    ID3D12Device *d = device;
+
+    if (FAILED(d->lpVtbl->QueryInterface(d, &IID_ID3D12DXVKInteropDevice1, (void **)&interop)))
+        return NULL;
+    /* the device holds it: the callers keep the device */
+    interop->lpVtbl->Release(interop);
+    return interop;
+}
+
+long viogpu_bridge_vk_handles(void *device, void **instance, void **physical_device, void **vk_device)
+{
+    ID3D12DXVKInteropDevice1 *interop = bridge_interop(device);
+
+    if (!interop)
+        return E_NOINTERFACE;
+    return interop->lpVtbl->GetVulkanHandles(interop, (VkInstance *)instance, (VkPhysicalDevice *)physical_device,
+            (VkDevice *)vk_device);
+}
+
+long viogpu_bridge_resource_info(void *device, void *resource, unsigned long long *vk_handle,
+        unsigned long long *buffer_offset, int *vk_format)
+{
+    ID3D12DXVKInteropDevice1 *interop = bridge_interop(device);
+    VkFormat format = VK_FORMAT_UNDEFINED;
+    UINT64 handle = 0, offset = 0;
+    HRESULT hr;
+
+    if (!interop)
+        return E_NOINTERFACE;
+    hr = interop->lpVtbl->GetVulkanResourceInfo1(interop, resource, &handle, &offset, &format);
+    *vk_handle = handle;
+    *buffer_offset = offset;
+    *vk_format = format;
+    return hr;
+}
+
+int viogpu_bridge_image_layout(void *device, void *resource, unsigned int state)
+{
+    ID3D12DXVKInteropDevice1 *interop = bridge_interop(device);
+    VkImageLayout layout = VK_IMAGE_LAYOUT_GENERAL;
+
+    if (interop)
+        interop->lpVtbl->GetVulkanImageLayout(interop, resource, (D3D12_RESOURCE_STATES)state, &layout);
+    return layout;
+}
+
+long viogpu_bridge_create_interop_queue(void *device, const void *desc, unsigned int family, void **queue)
+{
+    ID3D12DXVKInteropDevice1 *interop = bridge_interop(device);
+
+    if (!interop)
+        return E_NOINTERFACE;
+    return interop->lpVtbl->CreateInteropCommandQueue(interop, desc, family, (ID3D12CommandQueue **)queue);
+}
+
+long viogpu_bridge_create_interop_allocator(void *device, int type, unsigned int family, void **allocator)
+{
+    ID3D12DXVKInteropDevice1 *interop = bridge_interop(device);
+
+    if (!interop)
+        return E_NOINTERFACE;
+    return interop->lpVtbl->CreateInteropCommandAllocator(interop, (D3D12_COMMAND_LIST_TYPE)type, family,
+            (ID3D12CommandAllocator **)allocator);
+}
+
+long viogpu_bridge_begin_vk_commands(void *device, void *list, void **command_buffer)
+{
+    ID3D12DXVKInteropDevice1 *interop = bridge_interop(device);
+
+    if (!interop)
+        return E_NOINTERFACE;
+    return interop->lpVtbl->BeginVkCommandBufferInterop(interop, list, (VkCommandBuffer *)command_buffer);
+}
+
+long viogpu_bridge_end_vk_commands(void *device, void *list)
+{
+    ID3D12DXVKInteropDevice1 *interop = bridge_interop(device);
+
+    if (!interop)
+        return E_NOINTERFACE;
+    return interop->lpVtbl->EndVkCommandBufferInterop(interop, list);
+}
+
 /* d3d12core.dll implements vkd3d-proton's test-suite and debug-layer controls; this driver has neither */
 bool vkd3d_debug_control_is_test_suite(void)
 {
