+
+static void
+barrier(viogpu_video *v, VkCommandBuffer cmd, const VkImageMemoryBarrier2 *images, uint32_t imageCount,
+        VkPipelineStageFlags2 srcStage, VkAccessFlags2 srcAccess, VkPipelineStageFlags2 dstStage, VkAccessFlags2 dstAccess)
+{
+   VkMemoryBarrier2 memory = {VK_STRUCTURE_TYPE_MEMORY_BARRIER_2};
+   memory.srcStageMask = srcStage;
+   memory.srcAccessMask = srcAccess;
+   memory.dstStageMask = dstStage;
+   memory.dstAccessMask = dstAccess;
+   VkDependencyInfo dep = {VK_STRUCTURE_TYPE_DEPENDENCY_INFO};
+   dep.memoryBarrierCount = 1;
+   dep.pMemoryBarriers = &memory;
+   dep.imageMemoryBarrierCount = imageCount;
+   dep.pImageMemoryBarriers = images;
+   v->CmdPipelineBarrier2(cmd, &dep);
+}
+
+static VkImageMemoryBarrier2
+image_barrier(VkImage image, UINT layer, VkImageLayout from, VkImageLayout to)
+{
+   VkImageMemoryBarrier2 b = {VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2};
+   b.srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+   b.srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT;
+   b.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+   b.dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT;
+   b.oldLayout = from;
+   b.newLayout = to;
+   b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+   b.image = image;
+   b.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, layer, 1};
+   return b;
+}
+
+static VkImageView
+input_view(video_session *s, VkImage image, UINT layer)
+{
+   auto it = s->inputViews.find({image, layer});
+   if (it != s->inputViews.end())
+      return it->second;
+   viogpu_video *v = s->video;
+   VkImageViewUsageCreateInfo usage = {VK_STRUCTURE_TYPE_IMAGE_VIEW_USAGE_CREATE_INFO};
+   usage.usage = VK_IMAGE_USAGE_VIDEO_ENCODE_SRC_BIT_KHR;
+   VkImageViewCreateInfo info = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+   info.pNext = &usage;
+   info.image = image;
+   info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+   info.format = s->profile.format;
+   info.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, layer, 1};
+   VkImageView view = VK_NULL_HANDLE;
+   VkResult r = v->CreateImageView(v->device, &info, NULL, &view);
+   if (r != VK_SUCCESS)
+      viogpu_log("video: input picture view: %d", (int)r);
+   else
+      s->inputViews[{image, layer}] = view;
+   return view;
+}
+
+static bool
+copy_make(video_session *s)
+{
+   if (s->copyView)
+      return true;
+   viogpu_video *v = s->video;
+   VkImageCreateInfo image = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+   image.pNext = &s->profile.list;
+   image.imageType = VK_IMAGE_TYPE_2D;
+   image.format = s->profile.format;
+   image.extent = {s->maxExtent.width, s->maxExtent.height, 1};
+   image.mipLevels = image.arrayLayers = 1;
+   image.samples = VK_SAMPLE_COUNT_1_BIT;
+   image.tiling = VK_IMAGE_TILING_OPTIMAL;
+   image.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_VIDEO_ENCODE_SRC_BIT_KHR;
+   image.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+   if (v->CreateImage(v->device, &image, NULL, &s->copy) != VK_SUCCESS)
+      return false;
+   VkMemoryRequirements req;
+   v->GetImageMemoryRequirements(v->device, s->copy, &req);
+   if (!(s->copyMemory = memory_allocate(v, req.size, req.memoryTypeBits)) ||
+       v->BindImageMemory(v->device, s->copy, s->copyMemory, 0) != VK_SUCCESS)
+      return false;
+   VkImageViewCreateInfo view = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+   view.image = s->copy;
+   view.viewType = VK_IMAGE_VIEW_TYPE_2D;
+   view.format = s->profile.format;
+   view.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+   if (v->CreateImageView(v->device, &view, NULL, &s->copyView) != VK_SUCCESS) {
+      s->copyView = VK_NULL_HANDLE;
+      return false;
+   }
+   viogpu_log("video: input pictures are copied (texture format differs from the profile's)");
+   return true;
+}
+
+/* The application's texture (and subresource) -> the image's array layer (one mip, one plane slice per layer: what
+ * video textures have) */
+static UINT
+texture_layer(const viogpu_resource *res, UINT subresource)
+{
+   UINT layers = std::max<UINT>(res->desc.DepthOrArraySize, 1);
+   UINT mips = std::max<UINT>(res->desc.MipLevels, 1);
+   return (subresource / mips) % layers;
+}
+
+struct encode_refs {
+   /* per reference descriptor: its DPB slot */
+   std::vector<int> slotOf;
+   int setupSlot;
+};
+
+/* Which DPB slot each reference descriptor's picture and the reconstructed picture are in: slots follow the
+ * application's (texture, subresource); the ones no descriptor names are free again */
+static bool
+slots_assign(video_session *s, const D3D12DDI_VIDEO_ENCODE_REFERENCE_FRAMES_0080 &frames,
+             const UINT *descIndices, UINT descCount, bool reference, ID3D12Resource *recon, UINT reconSub,
+             encode_refs *out)
+{
+   out->slotOf.assign(descCount, -1);
+   std::vector<bool> keep(s->slots.size(), false);
+   for (UINT i = 0; i < descCount; i++) {
+      UINT index = descIndices[i];
+      if (index >= frames.NumTexture2Ds)
+         return false;
+      ID3D12Resource *texture = resource_of(frames.hDrvTexture2Ds[index]);
+      UINT sub = frames.pSubresources ? frames.pSubresources[index] : 0;
+      for (size_t slot = 0; slot < s->slots.size(); slot++) {
+         if (s->slots[slot].used && s->slots[slot].texture == texture && s->slots[slot].subresource == sub) {
+            out->slotOf[i] = (int)slot;
+            keep[slot] = true;
+            break;
+         }
+      }
+      if (out->slotOf[i] < 0) {
+         viogpu_log("video: reference picture %p/%u was never reconstructed", (void *)texture, sub);
+         return false;
+      }
+   }
+   for (size_t slot = 0; slot < s->slots.size(); slot++)
+      if (!keep[slot])
+         s->slots[slot].used = false;
+   /* Vulkan wants a reconstructed picture's slot even for a picture that isn't a reference (is_reference 0: the
+    * slot isn't activated); only a reference keeps it */
+   out->setupSlot = -1;
+   for (size_t slot = 0; slot < s->slots.size(); slot++) {
+      if (!s->slots[slot].used) {
+         out->setupSlot = (int)slot;
+         break;
+      }
+   }
+   if (out->setupSlot < 0) {
+      viogpu_log("video: no free DPB slot");
+      return false;
+   }
+   dpb_slot &setup = s->slots[out->setupSlot];
+   setup.used = reference;
+   setup.texture = recon;
+   setup.subresource = reconSub;
+   return true;
+}
+
+/* EncodeFrame's codec-specific Vulkan structures, kept together while the command is recorded */
+struct h264_picture {
+   VkVideoEncodeH264PictureInfoKHR info;
+   StdVideoEncodeH264PictureInfo std;
+   StdVideoEncodeH264ReferenceListsInfo lists;
+   StdVideoEncodeH264RefListModEntry mods[2][STD_VIDEO_H264_MAX_NUM_LIST_REF];
+   StdVideoEncodeH264RefPicMarkingEntry mmco[STD_VIDEO_H264_MAX_NUM_LIST_REF];
+   VkVideoEncodeH264NaluSliceInfoKHR slice;
+   StdVideoEncodeH264SliceHeader sliceHeader;
+   StdVideoEncodeH264ReferenceInfo setupInfo;
+   VkVideoEncodeH264DpbSlotInfoKHR setupSlot;
+   StdVideoEncodeH264ReferenceInfo refInfo[17];
+   VkVideoEncodeH264DpbSlotInfoKHR refSlot[17];
+};
+
+struct h265_picture {
+   VkVideoEncodeH265PictureInfoKHR info;
+   StdVideoEncodeH265PictureInfo std;
+   StdVideoEncodeH265ReferenceListsInfo lists;
+   StdVideoH265ShortTermRefPicSet rps;
+   StdVideoEncodeH265LongTermRefPics ltr;
+   VkVideoEncodeH265NaluSliceSegmentInfoKHR slice;
+   StdVideoEncodeH265SliceSegmentHeader sliceHeader;
+   StdVideoEncodeH265ReferenceInfo setupInfo;
+   VkVideoEncodeH265DpbSlotInfoKHR setupSlot;
+   StdVideoEncodeH265ReferenceInfo refInfo[17];
+   VkVideoEncodeH265DpbSlotInfoKHR refSlot[17];
+};
+
+static UINT
+cqp_for(const D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_0080_2 &rc, int kind /* 0 intra, 1 P, 2 B */)
+{
+   if (rc.Mode != D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_MODE_0080_CQP || !rc.ConfigParams.pConfiguration_CQP)
+      return 0;
+   const auto *c = rc.ConfigParams.pConfiguration_CQP;
+   return kind == 0 ? c->ConstantQP_FullIntracodedFrame
+          : kind == 1 ? c->ConstantQP_InterPredictedFrame_PrevRefOnly
+                      : c->ConstantQP_InterPredictedFrame_BiDirectionalRef;
+}
+
+static void APIENTRY
+encode_frame(D3D12DDI_HCOMMANDLIST hList, D3D12DDI_HVIDEOENCODER_0080 hEncoder, D3D12DDI_HVIDEOENCODERHEAP_0080 hHeap,
+             const D3D12DDI_VIDEO_ENCODER_ENCODEFRAME_INPUT_STREAM_ARGUMENTS_0082_0 *in,
+             const D3D12DDI_VIDEO_ENCODER_ENCODEFRAME_OUTPUT_STREAM_ARGUMENTS_0080_2 *out)
+{
+   viogpu_command_list *list = list_from(hList);
+   viogpu_device *device = list->device;
+   viogpu_video *v = device->video;
+   viogpu_video_encoder *encoder = (viogpu_video_encoder *)hEncoder.pDrvPrivate;
+   viogpu_video_heap *heap = (viogpu_video_heap *)hHeap.pDrvPrivate;
+   const auto &seq = in->SequenceControlDesc;
+   const auto &pic = in->PictureControlDesc;
+   video_session *s = v ? session_get(heap, encoder) : NULL;
+   if (!s) {
+      viogpu_command_list_error(list, E_FAIL);
+      return;
+   }
+   bool hevc = s->hevc;
+   const auto *h264 = pic.PictureControlCodecData.pH264PicData;
+   const auto *h265 = pic.PictureControlCodecData.pHEVCPicData;
+   const auto *h264Gop = seq.CodecGopSequence.pH264GroupOfPictures;
+   const auto *h265Gop = seq.CodecGopSequence.pHEVCGroupOfPictures;
+   if (hevc ? (!h265 || !h265Gop) : (!h264 || !h264Gop)) {
+      viogpu_command_list_error(list, E_INVALIDARG);
+      return;
+   }
+
+   /* parameters */
+   params_key key;
+   memset(&key, 0, sizeof(key));
+   key.width = seq.PictureTargetResolution.Width;
+   key.height = seq.PictureTargetResolution.Height;
+   key.ppsId = hevc ? h265->slice_pic_parameter_set_id : h264->pic_parameter_set_id;
+   key.pocType = hevc ? 0 : h264Gop->pic_order_cnt_type;
+   key.log2MaxFrameNum = hevc ? 0 : h264Gop->log2_max_frame_num_minus4;
+   key.log2MaxPocLsb = hevc ? h265Gop->log2_max_pic_order_cnt_lsb_minus4 : h264Gop->log2_max_pic_order_cnt_lsb_minus4;
+   /* ffmpeg's h264_d3d12va leaves the GOP's log2_max_pic_order_cnt_lsb_minus4 at 0 and writes 4 in its SPS (the
+    * value its other encoders use): 0 means 4 here. ponytail: an application that really wants 4-bit POC LSBs
+    * (rare: they wrap every 16 pictures) gets slices it can't parse */
+   if (!hevc && key.pocType == 0 && key.log2MaxPocLsb == 0)
+      key.log2MaxPocLsb = 4;
+   key.maxRefs = (UINT)s->slots.size() - 1;
+   key.bFrames = (hevc ? h265Gop->PPicturePeriod : h264Gop->PPicturePeriod) > 1;
+   if (!params_get(s, heap, encoder, key)) {
+      viogpu_command_list_error(list, E_FAIL);
+      return;
+   }
+
+   /* references: descriptors -> slots */
+   UINT descCount = hevc ? h265->ReferenceFramesReconPictureDescriptorsCount
+                         : h264->ReferenceFramesReconPictureDescriptorsCount;
+   if (descCount >= s->slots.size()) {
+      viogpu_log("video: %u reference pictures, the DPB has %zu slots", descCount, s->slots.size());
+      viogpu_command_list_error(list, E_INVALIDARG);
+      return;
+   }
+   std::vector<UINT> descIndices(descCount);
+   for (UINT i = 0; i < descCount; i++)
+      descIndices[i] = hevc ? h265->pReferenceFramesReconPictureDescriptors[i].ReconstructedPictureResourceIndex
+                            : h264->pReferenceFramesReconPictureDescriptors[i].ReconstructedPictureResourceIndex;
+   bool reference = pic.Flags & D3D12DDI_VIDEO_ENCODER_PICTURE_CONTROL_FLAG_0080_USED_AS_REFERENCE_PICTURE;
+   encode_refs refs;
+   if (!slots_assign(s, pic.ReferenceFrames, descIndices.data(), descCount, reference,
+                     resource_of(out->ReconstructedPicture.hDrvTexture2D),
+                     out->ReconstructedPicture.InputFrameSubresource, &refs)) {
+      viogpu_command_list_error(list, E_INVALIDARG);
+      return;
+   }
+
+   /* the input picture and the bitstream buffer */
+   viogpu_resource *input = (viogpu_resource *)in->hDrvInputTexture2D.pDrvPrivate;
+   viogpu_resource *bitstream = (viogpu_resource *)out->CompressedBitstream.hDrvBuffer.pDrvPrivate;
+   UINT64 inputHandle = 0, bufferHandle = 0, unused = 0, bufferOffset = 0;
+   int inputFormat = 0, bufferFormat = 0;
+   if (!input || !bitstream ||
+       FAILED(viogpu_bridge_resource_info(device->vkd3d, input->resource, &inputHandle, &unused, &inputFormat)) ||
+       FAILED(viogpu_bridge_resource_info(device->vkd3d, bitstream->resource, &bufferHandle, &bufferOffset,
+                                          &bufferFormat))) {
+      viogpu_command_list_error(list, E_INVALIDARG);
+      return;
+   }
+   VkImage inputImage = vk_handle<VkImage>(inputHandle);
+   UINT inputLayer = texture_layer(input, in->InputFrameSubresource);
+   bool copyInput = (VkFormat)inputFormat != s->profile.format;
+   VkImageView inputView = copyInput ? (copy_make(s) ? s->copyView : VK_NULL_HANDLE)
+                                     : input_view(s, inputImage, inputLayer);
+   if (!inputView) {
+      viogpu_command_list_error(list, E_FAIL);
+      return;
+   }
+   VkImageLayout inputLayout =
+      (VkImageLayout)viogpu_bridge_image_layout(device->vkd3d, input->resource, D3D12_RESOURCE_STATE_VIDEO_ENCODE_READ);
+   VkDeviceSize sizeAlign = std::max<VkDeviceSize>(s->caps->caps.minBitstreamBufferSizeAlignment, 1);
+   VkDeviceSize dstOffset = bufferOffset + out->CompressedBitstream.Offset;
+   VkDeviceSize dstRange = (bitstream->desc.Width - out->CompressedBitstream.Offset) / sizeAlign * sizeAlign;
+
+   VkExtent2D extent = {seq.PictureTargetResolution.Width, seq.PictureTargetResolution.Height};
+   auto picture_resource = [&](VkImageView view) {
+      VkVideoPictureResourceInfoKHR r = {VK_STRUCTURE_TYPE_VIDEO_PICTURE_RESOURCE_INFO_KHR};
+      r.codedExtent = extent;
+      r.imageViewBinding = view;
+      return r;
+   };
+   VkVideoPictureResourceInfoKHR srcPicture = picture_resource(inputView);
+   std::vector<VkVideoPictureResourceInfoKHR> refPictures(descCount);
+   std::vector<VkVideoReferenceSlotInfoKHR> refSlots(descCount);
+   VkVideoPictureResourceInfoKHR setupPicture = {};
+   VkVideoReferenceSlotInfoKHR setupSlot = {VK_STRUCTURE_TYPE_VIDEO_REFERENCE_SLOT_INFO_KHR};
+   for (UINT i = 0; i < descCount; i++) {
+      refPictures[i] = picture_resource(s->dpbViews[refs.slotOf[i]]);
+      refSlots[i] = {VK_STRUCTURE_TYPE_VIDEO_REFERENCE_SLOT_INFO_KHR};
+      refSlots[i].slotIndex = refs.slotOf[i];
+      refSlots[i].pPictureResource = &refPictures[i];
+   }
+   if (refs.setupSlot >= 0) {
+      setupPicture = picture_resource(s->dpbViews[refs.setupSlot]);
+      setupSlot.slotIndex = refs.setupSlot;
+      setupSlot.pPictureResource = &setupPicture;
+   }
+
+   /* codec picture information */
+   int kind;
+   UINT qp;
+   h264_picture hp;
+   h265_picture vp;
+   memset(&hp, 0, sizeof(hp));
+   memset(&vp, 0, sizeof(vp));
+   VkVideoEncodeInfoKHR encode = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_INFO_KHR};
+   if (!hevc) {
+      bool idr = h264->FrameType == D3D12DDI_VIDEO_ENCODER_FRAME_TYPE_H264_0080_IDR_FRAME;
+      kind = h264->FrameType == D3D12DDI_VIDEO_ENCODER_FRAME_TYPE_H264_0080_P_FRAME   ? 1
+             : h264->FrameType == D3D12DDI_VIDEO_ENCODER_FRAME_TYPE_H264_0080_B_FRAME ? 2
+                                                                                      : 0;
+      qp = cqp_for(seq.RateControl, kind);
+      StdVideoH264PictureType type = idr ? STD_VIDEO_H264_PICTURE_TYPE_IDR
+                                     : kind == 1 ? STD_VIDEO_H264_PICTURE_TYPE_P
+                                     : kind == 2 ? STD_VIDEO_H264_PICTURE_TYPE_B
+                                                 : STD_VIDEO_H264_PICTURE_TYPE_I;
+      UINT frameNumMask = (1u << (key.log2MaxFrameNum + 4)) - 1;
+      /* frame_num as H.264 has it (7.4.3): 0 at an IDR, one more after each reference picture. That's what
+       * FrameDecodingOrderNumber is meant to be; ffmpeg's h264_d3d12va gives the display order instead, which with
+       * B-frames breaks the references (temporal direct prediction especially).
+       * ponytail: no frame_num gaps (temporal layers that leave pictures out) */
+      UINT frameNum = idr ? 0 : (s->lastFrameNum + (s->lastReference ? 1 : 0)) & frameNumMask;
+      s->lastFrameNum = frameNum;
+      s->lastReference = reference;
+      /* POC type 2 counts in steps of two (8.2.1.3) */
+      INT poc = key.pocType == 2 ? 2 * (INT)h264->PictureOrderCountNumber : (INT)h264->PictureOrderCountNumber;
+      hp.std.flags.IdrPicFlag = idr;
+      hp.std.flags.is_reference = reference;
+      hp.std.flags.adaptive_ref_pic_marking_mode_flag = h264->adaptive_ref_pic_marking_mode_flag;
+      hp.std.seq_parameter_set_id = 0;
+      hp.std.pic_parameter_set_id = (uint8_t)h264->pic_parameter_set_id;
+      hp.std.idr_pic_id = (uint16_t)h264->idr_pic_id;
+      hp.std.primary_pic_type = type;
+      hp.std.frame_num = frameNum;
+      hp.std.PicOrderCnt = poc;
+      hp.std.temporal_id = (uint8_t)h264->TemporalLayerIndex;
+      memset(hp.lists.RefPicList0, STD_VIDEO_H264_NO_REFERENCE_PICTURE, sizeof(hp.lists.RefPicList0));
+      memset(hp.lists.RefPicList1, STD_VIDEO_H264_NO_REFERENCE_PICTURE, sizeof(hp.lists.RefPicList1));
+      UINT l0 = std::min<UINT>(h264->List0ReferenceFramesCount, STD_VIDEO_H264_MAX_NUM_LIST_REF);
+      UINT l1 = std::min<UINT>(h264->List1ReferenceFramesCount, STD_VIDEO_H264_MAX_NUM_LIST_REF);
+      for (UINT i = 0; i < l0; i++)
+         if (h264->pList0ReferenceFrames[i] < descCount)
+            hp.lists.RefPicList0[i] = (uint8_t)refs.slotOf[h264->pList0ReferenceFrames[i]];
