+/* viogpu's D3D12 video encoder records Vulkan Video on the encode queue family (interop): any NV12/P010 texture
+ * can be its input and any buffer its bitstream output, so both are made profile-independent with the video
+ * usage up front (video_maintenance1). Encoder-private pictures (the DPB) are the encoder's own. */
+static bool vkd3d_device_has_video_encode(const struct d3d12_device *device)
+{
+    return device->queue_families[VKD3D_QUEUE_FAMILY_VIDEO_ENCODE] &&
+            device->device_info.video_maintenance1_features.videoMaintenance1;
+}
+
+static bool vkd3d_image_can_be_video_encode_src(struct d3d12_device *device, const VkImageCreateInfo *image_info)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    VkFormatProperties props;
+
+    if (!vkd3d_device_has_video_encode(device) ||
+            (image_info->format != VK_FORMAT_G8_B8R8_2PLANE_420_UNORM &&
+            image_info->format != VK_FORMAT_G10X6_B10X6R10X6_2PLANE_420_UNORM_3PACK16) ||
+            image_info->imageType != VK_IMAGE_TYPE_2D || image_info->samples != VK_SAMPLE_COUNT_1_BIT ||
+            image_info->tiling != VK_IMAGE_TILING_OPTIMAL || (image_info->flags & VK_IMAGE_CREATE_SPARSE_BINDING_BIT))
+        return false;
+
+    VK_CALL(vkGetPhysicalDeviceFormatProperties(device->vk_physical_device, image_info->format, &props));
+    return !!(props.optimalTilingFeatures & VK_FORMAT_FEATURE_VIDEO_ENCODE_INPUT_BIT_KHR);
+}
