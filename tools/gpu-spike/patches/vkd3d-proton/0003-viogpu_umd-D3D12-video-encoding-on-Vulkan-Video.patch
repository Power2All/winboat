diff --git a/libs/viogpu_umd/umd_video.cpp b/libs/viogpu_umd/umd_video.cpp
new file mode 100644
index 00000000..3e09ab39
--- /dev/null
+++ b/libs/viogpu_umd/umd_video.cpp
@@ -0,0 +1,2426 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/* D3D12 video encoding (H.264 Main/High, HEVC Main/Main 10) on Vulkan Video, the video DDI's "extended feature"
+ * (version 0083_0: the first Microsoft calls complete).
+ *
+ * vkd3d-proton has no video. Its Vulkan device does have the encode queue family and the video extensions (patched
+ * in), and it gives NV12/P010 textures and buffers the video usages, profile-independent (video_maintenance1): the
+ * application's input pictures and bitstream buffers are used as they are. Video encoding lists are vkd3d-proton
+ * direct lists on the encode queue family (its DXVK interop), into which EncodeFrame records Vulkan Video.
+ *
+ * What D3D12 and Vulkan Video see differently:
+ * - Parameter sets: D3D12 drivers write slices only; the application writes VPS/SPS/PPS with the values the D3D12
+ *   video encoding spec lists ("Expected ... values"), derived from the codec configuration, GOP structure, profile,
+ *   level and resolution. Vulkan wants the parameter sets: they are built here from the same inputs, by those tables.
+ * - The reconstructed (reference) pictures: the encoder keeps its own DPB (a texture array with the session's
+ *   profile); the application's reconstructed textures only name the slots (texture and subresource -> slot).
+ * - Output metadata: the bitstream size comes from an encode feedback query. ResolveEncoderOutputMetadata is done on
+ *   the CPU once the GPU finished the submission, before the queue's fence is signaled (viogpu_video_queue): the
+ *   encode queue family has no compute, and Vulkan has no way to write query results there.
+ * The encoder's objects: the session (with its parameters, DPB and queries) lives in the encoder heap, which D3D12
+ * makes per resolution set; ponytail: one encoder per heap (what applications do). */
+
+#define VK_NO_PROTOTYPES
+#include "umd_private.h"
+#include <vulkan/vulkan.h>
+#include <algorithm>
+#include <deque>
+#include <map>
+
+/* windows.h's */
+#undef min
+#undef max
+
+D3D12DDI_HRTTABLE viogpu_video_encode_rt_table;
+
+#define INSTANCE_FUNCS(X)                                                                                              \
+   X(GetDeviceProcAddr)                                                                                                \
+   X(GetPhysicalDeviceQueueFamilyProperties)                                                                           \
+   X(GetPhysicalDeviceMemoryProperties)                                                                                \
+   X(GetPhysicalDeviceVideoCapabilitiesKHR)
+
+#define DEVICE_FUNCS(X)                                                                                                \
+   X(CreateVideoSessionKHR)                                                                                            \
+   X(DestroyVideoSessionKHR)                                                                                           \
+   X(GetVideoSessionMemoryRequirementsKHR)                                                                             \
+   X(BindVideoSessionMemoryKHR)                                                                                        \
+   X(CreateVideoSessionParametersKHR)                                                                                  \
+   X(DestroyVideoSessionParametersKHR)                                                                                 \
+   X(GetEncodedVideoSessionParametersKHR)                                                                              \
+   X(AllocateMemory)                                                                                                   \
+   X(FreeMemory)                                                                                                       \
+   X(CreateImage)                                                                                                      \
+   X(DestroyImage)                                                                                                     \
+   X(GetImageMemoryRequirements)                                                                                       \
+   X(BindImageMemory)                                                                                                  \
+   X(CreateImageView)                                                                                                  \
+   X(DestroyImageView)                                                                                                 \
+   X(CreateQueryPool)                                                                                                  \
+   X(DestroyQueryPool)                                                                                                 \
+   X(GetQueryPoolResults)                                                                                              \
+   X(CmdBeginVideoCodingKHR)                                                                                           \
+   X(CmdEndVideoCodingKHR)                                                                                             \
+   X(CmdControlVideoCodingKHR)                                                                                         \
+   X(CmdEncodeVideoKHR)                                                                                                \
+   X(CmdResetQueryPool)                                                                                                \
+   X(CmdBeginQuery)                                                                                                    \
+   X(CmdEndQuery)                                                                                                      \
+   X(CmdPipelineBarrier2)                                                                                              \
+   X(CmdCopyImage)
+
+/* The profiles offered: H.264 Main and High (NV12), HEVC Main (NV12) and Main 10 (P010) */
+enum { PROFILE_H264_MAIN, PROFILE_H264_HIGH, PROFILE_HEVC_MAIN, PROFILE_HEVC_MAIN10, PROFILE_COUNT };
+
+/* A Vulkan video profile; pNext points into the struct itself, so it stays where it was filled */
+struct video_profile {
+   VkVideoProfileInfoKHR info;
+   VkVideoEncodeH264ProfileInfoKHR h264;
+   VkVideoEncodeH265ProfileInfoKHR h265;
+   VkVideoProfileListInfoKHR list;
+   VkFormat format;
+   DXGI_FORMAT dxgiFormat;
+   bool hevc;
+};
+
+struct video_caps {
+   bool queried, ok;
+   VkVideoCapabilitiesKHR caps;
+   VkVideoEncodeCapabilitiesKHR encode;
+   VkVideoEncodeH264CapabilitiesKHR h264;
+   VkVideoEncodeH265CapabilitiesKHR h265;
+};
+
+struct video_session;
+
+struct viogpu_video {
+   bool tried, ok;
+   VkInstance instance;
+   VkPhysicalDevice physical;
+   VkDevice device;
+   uint32_t family;
+   VkPhysicalDeviceMemoryProperties memory;
+#define X(f) PFN_vk##f f;
+   INSTANCE_FUNCS(X)
+   DEVICE_FUNCS(X)
+#undef X
+   video_caps caps[PROFILE_COUNT];
+   /* HEVC: whether the encoder forces asymmetric motion partitions (0: not probed yet, 1: no, 2: yes) */
+   int ampRequired[PROFILE_COUNT];
+   /* an encoder's hardware metadata buffer (resource, offset) -> the feedback query of the encode that wrote it */
+   CRITICAL_SECTION lock;
+   std::map<std::pair<ID3D12Resource *, UINT64>, std::pair<video_session *, uint32_t>> metadata;
+};
+
+template <typename T>
+static T
+vk_handle(UINT64 h)
+{
+   T t;
+   memcpy(&t, &h, sizeof(t));
+   return t;
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* The device's Vulkan side */
+
+static viogpu_video *
+video_get(viogpu_device *device)
+{
+   if (!device->video) {
+      viogpu_video *video = new viogpu_video();
+      InitializeCriticalSection(&video->lock);
+      device->video = video;
+   }
+   viogpu_video *video = device->video;
+   if (video->tried)
+      return video->ok ? video : NULL;
+   video->tried = true;
+
+   PFN_vkGetInstanceProcAddr gipa = (PFN_vkGetInstanceProcAddr)viogpu_bridge_get_instance_proc_addr();
+   if (!gipa || FAILED(viogpu_bridge_vk_handles(device->vkd3d, (void **)&video->instance, (void **)&video->physical,
+                                                (void **)&video->device)))
+      return NULL;
+#define X(f)                                                                                                           \
+   if (!(video->f = (PFN_vk##f)gipa(video->instance, "vk" #f))) {                                                     \
+      viogpu_log("video: no vk" #f);                                                                                   \
+      return NULL;                                                                                                     \
+   }
+   INSTANCE_FUNCS(X)
+#undef X
+#define X(f)                                                                                                           \
+   if (!(video->f = (PFN_vk##f)video->GetDeviceProcAddr(video->device, "vk" #f))) {                                   \
+      viogpu_log("video: no vk" #f " (the device has no video encoding)");                                            \
+      return NULL;                                                                                                     \
+   }
+   DEVICE_FUNCS(X)
+#undef X
+
+   /* the family vkd3d-proton made its encode queue on: the first with video encoding */
+   uint32_t count = 0;
+   video->GetPhysicalDeviceQueueFamilyProperties(video->physical, &count, NULL);
+   std::vector<VkQueueFamilyProperties> families(count);
+   video->GetPhysicalDeviceQueueFamilyProperties(video->physical, &count, families.data());
+   video->family = VK_QUEUE_FAMILY_IGNORED;
+   for (uint32_t i = 0; i < count && video->family == VK_QUEUE_FAMILY_IGNORED; i++)
+      if (families[i].queueFlags & VK_QUEUE_VIDEO_ENCODE_BIT_KHR)
+         video->family = i;
+   if (video->family == VK_QUEUE_FAMILY_IGNORED)
+      return NULL;
+   video->GetPhysicalDeviceMemoryProperties(video->physical, &video->memory);
+   video->ok = true;
+   viogpu_log("video: encoding on queue family %u", video->family);
+   return video;
+}
+
+bool
+viogpu_video_supported(viogpu_device *device)
+{
+   return video_get(device) != NULL;
+}
+
+void
+viogpu_video_destroy(viogpu_device *device)
+{
+   if (!device->video)
+      return;
+   DeleteCriticalSection(&device->video->lock);
+   delete device->video;
+   device->video = NULL;
+}
+
+HRESULT
+viogpu_video_create_allocator(viogpu_device *device, ID3D12CommandAllocator **allocator)
+{
+   viogpu_video *video = video_get(device);
+   HRESULT hr = video ? viogpu_bridge_create_interop_allocator(device->vkd3d, D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                                               video->family, (void **)allocator)
+                      : E_FAIL;
+   if (FAILED(hr))
+      viogpu_log("video: CreateInteropCommandAllocator: 0x%08lx", (unsigned long)hr);
+   return hr;
+}
+
+HRESULT
+viogpu_video_create_queue(viogpu_device *device, const D3D12_COMMAND_QUEUE_DESC *desc, ID3D12CommandQueue **queue)
+{
+   viogpu_video *video = video_get(device);
+   HRESULT hr = video ? viogpu_bridge_create_interop_queue(device->vkd3d, desc, video->family, (void **)queue) : E_FAIL;
+   if (FAILED(hr))
+      viogpu_log("video: CreateInteropCommandQueue: 0x%08lx", (unsigned long)hr);
+   return hr;
+}
+
+static bool
+profile_fill(video_profile *p, int index)
+{
+   memset(p, 0, sizeof(*p));
+   p->hevc = index >= PROFILE_HEVC_MAIN;
+   bool ten = index == PROFILE_HEVC_MAIN10;
+   p->info.sType = VK_STRUCTURE_TYPE_VIDEO_PROFILE_INFO_KHR;
+   p->info.videoCodecOperation =
+      p->hevc ? VK_VIDEO_CODEC_OPERATION_ENCODE_H265_BIT_KHR : VK_VIDEO_CODEC_OPERATION_ENCODE_H264_BIT_KHR;
+   p->info.chromaSubsampling = VK_VIDEO_CHROMA_SUBSAMPLING_420_BIT_KHR;
+   p->info.lumaBitDepth = p->info.chromaBitDepth =
+      ten ? VK_VIDEO_COMPONENT_BIT_DEPTH_10_BIT_KHR : VK_VIDEO_COMPONENT_BIT_DEPTH_8_BIT_KHR;
+   if (p->hevc) {
+      p->h265.sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_PROFILE_INFO_KHR;
+      p->h265.stdProfileIdc = ten ? STD_VIDEO_H265_PROFILE_IDC_MAIN_10 : STD_VIDEO_H265_PROFILE_IDC_MAIN;
+      p->info.pNext = &p->h265;
+   } else {
+      p->h264.sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_PROFILE_INFO_KHR;
+      p->h264.stdProfileIdc =
+         index == PROFILE_H264_HIGH ? STD_VIDEO_H264_PROFILE_IDC_HIGH : STD_VIDEO_H264_PROFILE_IDC_MAIN;
+      p->info.pNext = &p->h264;
+   }
+   p->list.sType = VK_STRUCTURE_TYPE_VIDEO_PROFILE_LIST_INFO_KHR;
+   p->list.profileCount = 1;
+   p->list.pProfiles = &p->info;
+   p->format = ten ? VK_FORMAT_G10X6_B10X6R10X6_2PLANE_420_UNORM_3PACK16 : VK_FORMAT_G8_B8R8_2PLANE_420_UNORM;
+   p->dxgiFormat = ten ? DXGI_FORMAT_P010 : DXGI_FORMAT_NV12;
+   return true;
+}
+
+static const video_caps *
+caps_get(viogpu_video *video, int index)
+{
+   if (index < 0 || index >= PROFILE_COUNT)
+      return NULL;
+   video_caps *c = &video->caps[index];
+   if (!c->queried) {
+      c->queried = true;
+      video_profile p;
+      profile_fill(&p, index);
+      c->caps.sType = VK_STRUCTURE_TYPE_VIDEO_CAPABILITIES_KHR;
+      c->caps.pNext = &c->encode;
+      c->encode.sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_CAPABILITIES_KHR;
+      if (p.hevc) {
+         c->encode.pNext = &c->h265;
+         c->h265.sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_CAPABILITIES_KHR;
+      } else {
+         c->encode.pNext = &c->h264;
+         c->h264.sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_CAPABILITIES_KHR;
+      }
+      VkResult r = video->GetPhysicalDeviceVideoCapabilitiesKHR(video->physical, &p.info, &c->caps);
+      c->ok = r == VK_SUCCESS && c->caps.maxDpbSlots >= 2;
+      viogpu_log("video: profile %d: %s (result %d, %ux%u..%ux%u, %u slots, %u active references)", index,
+                 c->ok ? "supported" : "not supported", (int)r, c->caps.minCodedExtent.width,
+                 c->caps.minCodedExtent.height, c->caps.maxCodedExtent.width, c->caps.maxCodedExtent.height,
+                 c->caps.maxDpbSlots, c->caps.maxActiveReferencePictures);
+   }
+   return c->ok ? c : NULL;
+}
+
+/* D3D12's codec and profile -> the profile index, or -1 */
+static int
+profile_index(D3D12DDI_VIDEO_ENCODER_CODEC_0080 codec, const D3D12DDI_VIDEO_ENCODER_PROFILE_DESC_0080_2 *profile)
+{
+   if (codec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_H264 && profile->pH264Profile) {
+      switch (*profile->pH264Profile) {
+      case D3D12DDI_VIDEO_ENCODER_PROFILE_H264_0080_MAIN: return PROFILE_H264_MAIN;
+      case D3D12DDI_VIDEO_ENCODER_PROFILE_H264_0080_HIGH: return PROFILE_H264_HIGH;
+      default: return -1;
+      }
+   }
+   if (codec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_HEVC && profile->pHEVCProfile) {
+      switch (*profile->pHEVCProfile) {
+      case D3D12DDI_VIDEO_ENCODER_PROFILE_HEVC_0080_MAIN: return PROFILE_HEVC_MAIN;
+      case D3D12DDI_VIDEO_ENCODER_PROFILE_HEVC_0080_MAIN10: return PROFILE_HEVC_MAIN10;
+      default: return -1;
+      }
+   }
+   return -1;
+}
+
+/* D3D12's levels and Vulkan's (StdVideoH264LevelIdc has no 1b; StdVideoH265LevelIdc has D3D12's order) */
+static StdVideoH264LevelIdc
+h264_level_to_vk(UINT level)
+{
+   return (StdVideoH264LevelIdc)(level <= D3D12DDI_VIDEO_ENCODER_LEVELS_H264_0080_1b ? 0 : level - 1);
+}
+
+static UINT
+h264_level_from_vk(StdVideoH264LevelIdc level)
+{
+   return level == STD_VIDEO_H264_LEVEL_IDC_1_0 ? 0 : (UINT)level + 1;
+}
+
+/* the size of the coding block a picture's dimensions are aligned to: macroblocks, the HEVC CTB */
+static UINT
+block_size(const video_caps *c, bool hevc)
+{
+   if (!hevc)
+      return 16;
+   VkVideoEncodeH265CtbSizeFlagsKHR ctbs = c->h265.ctbSizes;
+   return (ctbs & VK_VIDEO_ENCODE_H265_CTB_SIZE_32_BIT_KHR) ? 32 : (ctbs & VK_VIDEO_ENCODE_H265_CTB_SIZE_64_BIT_KHR) ? 64 : 16;
+}
+
+static UINT
+log2_of(UINT v)
+{
+   UINT l = 0;
+   while ((1u << (l + 1)) <= v)
+      l++;
+   return l;
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Caps */
+
+static void
+level_set(D3D12DDI_VIDEO_ENCODER_LEVEL_SETTING_0080_2 *setting, bool hevc, UINT level)
+{
+   if (!hevc && setting->pH264LevelSetting)
+      *setting->pH264LevelSetting = (D3D12DDI_VIDEO_ENCODER_LEVELS_H264_0080)level;
+   if (hevc && setting->pHEVCLevelSetting) {
+      setting->pHEVCLevelSetting->Level = (D3D12DDI_VIDEO_ENCODER_LEVELS_HEVC_0080)level;
+      setting->pHEVCLevelSetting->Tier = D3D12DDI_VIDEO_ENCODER_TIER_HEVC_0080_MAIN;
+   }
+}
+
+static UINT
+max_level(const video_caps *c, bool hevc)
+{
+   return hevc ? (UINT)c->h265.maxLevelIdc : h264_level_from_vk(c->h264.maxLevelIdc);
+}
+
+static bool
+rc_supported(const video_caps *c, D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_MODE_0080 mode)
+{
+   switch (mode) {
+   case D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_MODE_0080_CQP:
+      return c->encode.rateControlModes & VK_VIDEO_ENCODE_RATE_CONTROL_MODE_DISABLED_BIT_KHR;
+   case D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_MODE_0080_CBR:
+      return c->encode.rateControlModes & VK_VIDEO_ENCODE_RATE_CONTROL_MODE_CBR_BIT_KHR;
+   case D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_MODE_0080_VBR:
+      return c->encode.rateControlModes & VK_VIDEO_ENCODE_RATE_CONTROL_MODE_VBR_BIT_KHR;
+   default:
+      return false;
+   }
+}
+
+static void
+resolution_limits(const video_caps *c, bool hevc, D3D12DDI_VIDEO_ENCODER_RESOLUTION_SUPPORT_LIMITS_0080_2 *limits)
+{
+   limits->MaxSubregionsNumber = 1;
+   limits->MaxIntraRefreshFrameDuration = 0;
+   limits->SubregionBlockPixelsSize = block_size(c, hevc);
+   limits->QPMapRegionPixelsSize = block_size(c, hevc);
+}
+
+static UINT
+dpb_capacity(const video_caps *c)
+{
+   /* one slot for the picture being encoded */
+   return std::min(c->caps.maxDpbSlots, 17u) - 1;
+}
+
+#define CAPS(T) (args->DataSize >= sizeof(T) ? (T *)args->pData : NULL)
+
+/* D3D12DDI_VIDEO_DECODE_PROFILE_H264, D3D12DDI_VIDEO_DECODE_BITSTREAM_ENCRYPTION_NONE */
+static const GUID decode_profile_h264 = {0x1b81be68, 0xa0c7, 0x11d3, {0xb9, 0x84, 0x00, 0xc0, 0x4f, 0x2e, 0x73, 0xc5}};
+static const GUID decode_encryption_none = {0x1b81bed0, 0xa0c7, 0x11d3, {0xb9, 0x84, 0x00, 0xc0, 0x4f, 0x2e, 0x73, 0xc5}};
+
+static HRESULT video_get_caps_(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_VIDEO_GETCAPS_0020 *args);
+static bool hevc_amp_required(viogpu_video *v, int index);
+
+static HRESULT APIENTRY
+video_get_caps(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_VIDEO_GETCAPS_0020 *args)
+{
+   HRESULT hr = video_get_caps_(hDevice, args);
+   if (FAILED(hr))
+      viogpu_log("video: GetCaps type %d, %u bytes: 0x%08lx", (int)args->Type, args->DataSize, (unsigned long)hr);
+   return hr;
+}
+
+static HRESULT
+video_get_caps_(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_VIDEO_GETCAPS_0020 *args)
+{
+   viogpu_video *video = video_get(device_from(hDevice));
+   switch (args->Type) {
+   case D3D12DDICAPS_TYPE_VIDEO_0053_FEATURE_AREA_SUPPORT: {
+      auto *d = CAPS(D3D12DDI_VIDEO_FEATURE_AREA_SUPPORT_DATA_0053);
+      if (!d)
+         return E_INVALIDARG;
+      d->VideoDecodeSupport = FALSE;
+      d->VideoProcessSupport = FALSE;
+      d->VideoEncodeSupport = video != NULL;
+      return S_OK;
+   }
+   /* Decoding: none (D3D11 video has it). The runtime still wants a decode profile on a graphics device (only
+    * compute-only ones may have none), so H.264 is listed, with its format and no encryption, and DECODE_SUPPORT
+    * says no to every configuration. */
+   case D3D12DDICAPS_TYPE_VIDEO_0032_DECODE_PROFILE_COUNT: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_PROFILE_COUNT_DATA_0032);
+      if (!d)
+         return E_INVALIDARG;
+      d->ProfileCount = 1;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0020_DECODE_PROFILES: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_PROFILES_DATA_0020);
+      if (!d || d->ProfileCount < 1 || !d->pProfiles)
+         return E_INVALIDARG;
+      d->pProfiles[0] = decode_profile_h264;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0032_DECODE_FORMAT_COUNT: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_FORMAT_COUNT_DATA_0032);
+      if (!d)
+         return E_INVALIDARG;
+      d->FormatCount = 1;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0020_DECODE_FORMATS: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_FORMATS_DATA_0020);
+      if (!d || d->FormatCount < 1 || !d->pOutputFormats)
+         return E_INVALIDARG;
+      d->pOutputFormats[0] = DXGI_FORMAT_NV12;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0032_DECODE_BITSTREAM_ENCRYPTION_SCHEME_COUNT: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_BITSTREAM_ENCRYPTION_SCHEME_COUNT_DATA_0032);
+      if (!d)
+         return E_INVALIDARG;
+      d->BitstreamEncryptionSchemeCount = 1;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0020_DECODE_BITSTREAM_ENCRYPTION_SCHEMES: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_BITSTREAM_ENCRYPTION_SCHEMES_DATA_0020);
+      if (!d || d->EncryptionSchemeCount < 1 || !d->pEncryptionSchemes)
+         return E_INVALIDARG;
+      d->pEncryptionSchemes[0] = decode_encryption_none;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0020_DECODE_SUPPORT: {
+      auto *d = CAPS(D3D12DDI_VIDEO_DECODE_SUPPORT_DATA_0020);
+      if (!d)
+         return E_INVALIDARG;
+      d->SupportFlags = D3D12DDI_VIDEO_DECODE_SUPPORT_FLAG_0020_NONE;
+      d->ConfigurationFlags = D3D12DDI_VIDEO_DECODE_CONFIGURATION_FLAG_0020_NONE;
+      d->DecodeTier = D3D12DDI_VIDEO_DECODE_TIER_0020_NOT_SUPPORTED;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0020_PROCESS_MAX_INPUT_STREAMS: {
+      auto *d = CAPS(D3D12DDI_VIDEO_PROCESS_MAX_INPUT_STREAMS_DATA_0020);
+      if (!d)
+         return E_INVALIDARG;
+      d->MaxInputStreams = 1;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0063_EXTENSION_COMMAND_COUNT: {
+      auto *d = CAPS(D3D12DDI_VIDEO_EXTENSION_COMMAND_COUNT_DATA_0063);
+      if (!d)
+         return E_INVALIDARG;
+      d->CommandCount = 0;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0032_CONTENT_PROTECTION_SYSTEM_COUNT: {
+      auto *d = CAPS(D3D12DDI_VIDEO_CONTENT_PROTECTION_SYSTEM_COUNT_DATA_0030);
+      if (!d)
+         return E_INVALIDARG;
+      d->ContentProtectionSystemCount = 0;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0072_DECODE_PROTECTED_RESOURCES:
+   case D3D12DDICAPS_TYPE_VIDEO_0072_PROCESS_PROTECTED_RESOURCES:
+   case D3D12DDICAPS_TYPE_VIDEO_0072_MOTION_ESTIMATOR_PROTECTED_RESOURCES:
+      /* no protected resources: the support flags are these structs' last member */
+      if (args->DataSize < sizeof(UINT))
+         return E_INVALIDARG;
+      memset((char *)args->pData + args->DataSize - sizeof(UINT), 0, sizeof(UINT));
+      return S_OK;
+   case D3D12DDICAPS_TYPE_VIDEO_0080_ENCODER_CODEC: {
+      auto *d = CAPS(D3D12DDICAPS_VIDEO_ENCODER_CODEC_DATA_0080);
+      if (!d)
+         return E_INVALIDARG;
+      bool hevc = d->Codec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_HEVC;
+      d->IsSupported = video && (d->Codec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_H264 || hevc) &&
+                       (caps_get(video, hevc ? PROFILE_HEVC_MAIN : PROFILE_H264_HIGH) ||
+                        caps_get(video, hevc ? PROFILE_HEVC_MAIN10 : PROFILE_H264_MAIN));
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0080_ENCODER_PROFILE_LEVEL: {
+      auto *d = CAPS(D3D12DDICAPS_VIDEO_ENCODER_PROFILE_LEVEL_DATA_0080_2);
+      if (!d)
+         return E_INVALIDARG;
+      const video_caps *c = video ? caps_get(video, profile_index(d->Codec, &d->Profile)) : NULL;
+      bool hevc = d->Codec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_HEVC;
+      d->IsSupported = c != NULL;
+      if (c) {
+         level_set(&d->MinSupportedLevel, hevc, 0);
+         level_set(&d->MaxSupportedLevel, hevc, max_level(c, hevc));
+      }
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0080_ENCODER_OUTPUT_RESOLUTION_RATIOS_COUNT: {
+      auto *d = CAPS(D3D12DDICAPS_VIDEO_ENCODER_OUTPUT_RESOLUTION_RATIOS_COUNT_DATA_0080_2);
+      if (!d)
+         return E_INVALIDARG;
+      d->ResolutionRatiosCount = 0;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0080_ENCODER_OUTPUT_RESOLUTION: {
+      auto *d = CAPS(D3D12DDICAPS_VIDEO_ENCODER_OUTPUT_RESOLUTION_DATA_0080_2);
+      if (!d)
+         return E_INVALIDARG;
+      bool hevc = d->Codec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_HEVC;
+      const video_caps *c = video ? caps_get(video, hevc ? PROFILE_HEVC_MAIN : PROFILE_H264_HIGH) : NULL;
+      d->IsSupported = c != NULL;
+      if (c) {
+         d->MinResolutionSupported.Width = c->caps.minCodedExtent.width;
+         d->MinResolutionSupported.Height = c->caps.minCodedExtent.height;
+         d->MaxResolutionSupported.Width = c->caps.maxCodedExtent.width;
+         d->MaxResolutionSupported.Height = c->caps.maxCodedExtent.height;
+         /* 4:2:0; the encoder's input granularity is how it pads (the parameter sets' cropping hides that) */
+         d->ResolutionWidthMultipleRequirement = 2;
+         d->ResolutionHeightMultipleRequirement = 2;
+      }
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0080_ENCODER_INPUT_FORMAT: {
+      auto *d = CAPS(D3D12DDICAPS_VIDEO_ENCODER_INPUT_FORMAT_DATA_0080_2);
+      if (!d)
+         return E_INVALIDARG;
+      int index = profile_index(d->Codec, &d->Profile);
+      video_profile p;
+      d->IsSupported = video && caps_get(video, index) && profile_fill(&p, index) && p.dxgiFormat == d->Format;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0080_ENCODER_RATE_CONTROL_MODE: {
+      auto *d = CAPS(D3D12DDICAPS_VIDEO_ENCODER_RATE_CONTROL_MODE_DATA_0080);
+      if (!d)
+         return E_INVALIDARG;
+      bool hevc = d->Codec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_HEVC;
+      const video_caps *c = video ? caps_get(video, hevc ? PROFILE_HEVC_MAIN : PROFILE_H264_HIGH) : NULL;
+      d->IsSupported = c && rc_supported(c, d->RateControlMode);
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0080_ENCODER_INTRA_REFRESH_MODE: {
+      auto *d = CAPS(D3D12DDICAPS_VIDEO_ENCODER_INTRA_REFRESH_MODE_DATA_0080_2);
+      if (!d)
+         return E_INVALIDARG;
+      d->IsSupported = d->IntraRefreshMode == D3D12DDI_VIDEO_ENCODER_INTRA_REFRESH_MODE_NONE_0080;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0080_ENCODER_FRAME_SUBREGION_LAYOUT_MODE: {
+      auto *d = CAPS(D3D12DDICAPS_VIDEO_ENCODER_FRAME_SUBREGION_LAYOUT_MODE_DATA_0080_2);
+      if (!d)
+         return E_INVALIDARG;
+      d->IsSupported = d->SubregionMode == D3D12DDI_VIDEO_ENCODER_FRAME_SUBREGION_LAYOUT_MODE_0080_FULL_FRAME;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0080_ENCODER_HEAP_SIZE: {
+      auto *d = CAPS(D3D12DDICAPS_VIDEO_ENCODER_HEAP_SIZE_DATA_0080_2);
+      if (!d)
+         return E_INVALIDARG;
+      d->IsSupported = video && caps_get(video, profile_index(d->HeapDesc.EncodeCodec, &d->HeapDesc.EncodeProfile));
+      d->MemoryPoolL0Size = 0;
+      d->MemoryPoolL1Size = 0;
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0080_ENCODER_CODEC_CONFIGURATION_SUPPORT: {
+      auto *d = CAPS(D3D12DDICAPS_VIDEO_ENCODER_CODEC_CONFIGURATION_SUPPORT_DATA_0083_0);
+      if (!d)
+         return E_INVALIDARG;
+      const video_caps *c = video ? caps_get(video, profile_index(d->Codec, &d->Profile)) : NULL;
+      d->IsSupported = c != NULL;
+      if (!c)
+         return S_OK;
+      if (d->Codec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_H264 && d->CodecSupportLimits.pH264Support) {
+         auto *s = d->CodecSupportLimits.pH264Support;
+         VkVideoEncodeH264StdFlagsKHR std = c->h264.stdSyntaxFlags;
+         s->SupportFlags = D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_SUPPORT_H264_FLAG_0080_CABAC_ENCODING_SUPPORT |
+                           D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_SUPPORT_H264_FLAG_0080_DIRECT_SPATIAL_ENCODING_SUPPORT;
+         if (std & VK_VIDEO_ENCODE_H264_STD_TRANSFORM_8X8_MODE_FLAG_SET_BIT_KHR)
+            s->SupportFlags |=
+               D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_SUPPORT_H264_FLAG_0080_ADAPTIVE_8x8_TRANSFORM_ENCODING_SUPPORT;
+         if (std & VK_VIDEO_ENCODE_H264_STD_CONSTRAINED_INTRA_PRED_FLAG_SET_BIT_KHR)
+            s->SupportFlags |=
+               D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_SUPPORT_H264_FLAG_0080_CONSTRAINED_INTRAPREDICTION_SUPPORT;
+         /* disable_deblocking_filter_idc 0, 1, 2 (the values H.264 has) */
+         s->DisableDeblockingFilterSupportedModes =
+            D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_H264_SLICES_DEBLOCKING_MODE_0082_0_FLAG_0_ALL_LUMA_CHROMA_SLICE_BLOCK_EDGES_ALWAYS_FILTERED |
+            D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_H264_SLICES_DEBLOCKING_MODE_0082_0_FLAG_1_DISABLE_ALL_SLICE_BLOCK_EDGES |
+            D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_H264_SLICES_DEBLOCKING_MODE_0082_0_FLAG_2_DISABLE_SLICE_BOUNDARIES_BLOCKS;
+      } else if (d->Codec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_HEVC && d->CodecSupportLimits.pHEVCSupport) {
+         auto *s = d->CodecSupportLimits.pHEVCSupport;
+         VkVideoEncodeH265StdFlagsKHR std = c->h265.stdSyntaxFlags;
+         s->SupportFlags =
+            D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_SUPPORT_HEVC_FLAG_0083_0_DISABLING_LOOP_FILTER_ACROSS_SLICES_SUPPORT;
+         if (std & VK_VIDEO_ENCODE_H265_STD_SAMPLE_ADAPTIVE_OFFSET_ENABLED_FLAG_SET_BIT_KHR)
+            s->SupportFlags |= D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_SUPPORT_HEVC_FLAG_0083_0_SAO_FILTER_SUPPORT;
+         if (std & VK_VIDEO_ENCODE_H265_STD_TRANSFORM_SKIP_ENABLED_FLAG_SET_BIT_KHR)
+            s->SupportFlags |= D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_SUPPORT_HEVC_FLAG_0083_0_TRANSFORM_SKIP_SUPPORT;
+         if (std & VK_VIDEO_ENCODE_H265_STD_CONSTRAINED_INTRA_PRED_FLAG_SET_BIT_KHR)
+            s->SupportFlags |=
+               D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_SUPPORT_HEVC_FLAG_0083_0_CONSTRAINED_INTRAPREDICTION_SUPPORT;
+         /* AMP changes the CU syntax of P/B slices, and Vulkan lets the encoder override amp_enabled_flag (NVIDIA
+          * sets it): such an encoder needs applications to write it */
+         if (hevc_amp_required(video, profile_index(d->Codec, &d->Profile)))
+            s->SupportFlags |=
+               D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_SUPPORT_HEVC_FLAG_0083_0_ASYMETRIC_MOTION_PARTITION_SUPPORT |
+               D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_SUPPORT_HEVC_FLAG_0083_0_ASYMETRIC_MOTION_PARTITION_REQUIRED;
+         /* coding units 8x8 up to the CTB, transform units 4x4 up to 32x32, the full hierarchy */
+         UINT ctb = block_size(c, true);
+         s->MinLumaCodingUnitSize = D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_0080_CUSIZE_8x8;
+         s->MaxLumaCodingUnitSize = (D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_CUSIZE_0080)(log2_of(ctb) - 3);
+         s->MinLumaTransformUnitSize = D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_TUSIZE_0082_0_4x4;
+         s->MaxLumaTransformUnitSize = D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_TUSIZE_0082_0_32x32;
+         s->max_transform_hierarchy_depth_inter = (UCHAR)(log2_of(ctb) - 2);
+         s->max_transform_hierarchy_depth_intra = (UCHAR)(log2_of(ctb) - 2);
+      }
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0080_ENCODER_SUPPORT: {
+      auto *d = CAPS(D3D12DDICAPS_VIDEO_ENCODER_SUPPORT_DATA_0083_0);
+      if (!d)
+         return E_INVALIDARG;
+      bool hevc = d->Codec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_HEVC;
+      /* the profile is the one the input format implies (the request names none) */
+      int index = hevc ? (d->InputFormat == DXGI_FORMAT_P010 ? PROFILE_HEVC_MAIN10 : PROFILE_HEVC_MAIN)
+                       : PROFILE_H264_HIGH;
+      const video_caps *c = video ? caps_get(video, index) : NULL;
+      UINT flags = 0;
+      video_profile p;
+      profile_fill(&p, index);
+      if (!c || (d->Codec != D3D12DDI_VIDEO_ENCODER_CODEC_0080_H264 && !hevc))
+         flags |= D3D12DDI_VIDEO_ENCODER_VALIDATION_FLAG_0082_0_CODEC_NOT_SUPPORTED;
+      if (c && d->InputFormat != p.dxgiFormat)
+         flags |= D3D12DDI_VIDEO_ENCODER_VALIDATION_FLAG_0082_0_INPUT_FORMAT_NOT_SUPPORTED;
+      if (c && !rc_supported(c, d->RateControl.Mode))
+         flags |= D3D12DDI_VIDEO_ENCODER_VALIDATION_FLAG_0082_0_RATE_CONTROL_MODE_NOT_SUPPORTED;
+      if (d->IntraRefresh != D3D12DDI_VIDEO_ENCODER_INTRA_REFRESH_MODE_NONE_0080)
+         flags |= D3D12DDI_VIDEO_ENCODER_VALIDATION_FLAG_0082_0_INTRA_REFRESH_MODE_NOT_SUPPORTED;
+      if (d->SubregionFrameEncoding != D3D12DDI_VIDEO_ENCODER_FRAME_SUBREGION_LAYOUT_MODE_0080_FULL_FRAME)
+         flags |= D3D12DDI_VIDEO_ENCODER_VALIDATION_FLAG_0082_0_SUBREGION_LAYOUT_MODE_NOT_SUPPORTED;
+      if (c && d->MaxReferenceFramesInDPB > dpb_capacity(c))
+         flags |= D3D12DDI_VIDEO_ENCODER_VALIDATION_FLAG_0082_0_GOP_STRUCTURE_NOT_SUPPORTED;
+      if (c && !hevc && d->CodecGopSequence.pH264GroupOfPictures &&
+          d->CodecGopSequence.pH264GroupOfPictures->pic_order_cnt_type != 0 &&
+          d->CodecGopSequence.pH264GroupOfPictures->pic_order_cnt_type != 2)
+         flags |= D3D12DDI_VIDEO_ENCODER_VALIDATION_FLAG_0082_0_GOP_STRUCTURE_NOT_SUPPORTED;
+      for (UINT i = 0; c && i < d->ResolutionsListCount; i++) {
+         const auto &r = d->pResolutionList[i];
+         if (r.Width < c->caps.minCodedExtent.width || r.Height < c->caps.minCodedExtent.height ||
+             r.Width > c->caps.maxCodedExtent.width || r.Height > c->caps.maxCodedExtent.height)
+            flags |= D3D12DDI_VIDEO_ENCODER_VALIDATION_FLAG_0082_0_RESOLUTION_NOT_SUPPORTED_IN_LIST;
+         if (d->pResolutionDependentSupport)
+            resolution_limits(c, hevc, &d->pResolutionDependentSupport[i]);
+      }
+      d->ValidationFlags = (D3D12DDI_VIDEO_ENCODER_VALIDATION_FLAGS_0082_0)flags;
+      d->SupportFlags = flags ? D3D12DDI_VIDEO_ENCODER_SUPPORT_FLAG_0083_0_NONE
+                              : D3D12DDI_VIDEO_ENCODER_SUPPORT_FLAG_0083_0_GENERAL_SUPPORT_OK |
+                                   D3D12DDI_VIDEO_ENCODER_SUPPORT_FLAG_0083_0_RATE_CONTROL_RECONFIGURATION_AVAILABLE |
+                                   D3D12DDI_VIDEO_ENCODER_SUPPORT_FLAG_0083_0_RATE_CONTROL_VBV_SIZE_CONFIG_AVAILABLE |
+                                   D3D12DDI_VIDEO_ENCODER_SUPPORT_FLAG_0083_0_RATE_CONTROL_ADJUSTABLE_QP_RANGE_AVAILABLE |
+                                   D3D12DDI_VIDEO_ENCODER_SUPPORT_FLAG_0083_0_SEQUENCE_GOP_RECONFIGURATION_AVAILABLE;
+      if (c) {
+         if (!hevc && d->SuggestedProfile.pH264Profile)
+            *d->SuggestedProfile.pH264Profile = D3D12DDI_VIDEO_ENCODER_PROFILE_H264_0080_HIGH;
+         if (hevc && d->SuggestedProfile.pHEVCProfile)
+            *d->SuggestedProfile.pHEVCProfile = index == PROFILE_HEVC_MAIN10 ? D3D12DDI_VIDEO_ENCODER_PROFILE_HEVC_0080_MAIN10
+                                                                             : D3D12DDI_VIDEO_ENCODER_PROFILE_HEVC_0080_MAIN;
+         level_set(&d->SuggestedLevel, hevc, max_level(c, hevc));
+      }
+      if (flags)
+         viogpu_log("video: encoder support (codec %d, format %d): validation flags 0x%x", (int)d->Codec,
+                    (int)d->InputFormat, flags);
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0080_ENCODER_CODEC_PICTURE_CONTROL_SUPPORT: {
+      auto *d = CAPS(D3D12DDICAPS_VIDEO_ENCODER_CODEC_PICTURE_CONTROL_SUPPORT_DATA_0080_2);
+      if (!d)
+         return E_INVALIDARG;
+      const video_caps *c = video ? caps_get(video, profile_index(d->Codec, &d->Profile)) : NULL;
+      d->IsSupported = c != NULL;
+      if (!c)
+         return S_OK;
+      if (d->Codec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_H264 && d->PictureSupport.pH264Support) {
+         auto *s = d->PictureSupport.pH264Support;
+         s->MaxL0ReferencesForP = c->h264.maxPPictureL0ReferenceCount;
+         s->MaxL0ReferencesForB = c->h264.maxBPictureL0ReferenceCount;
+         s->MaxL1ReferencesForB = c->h264.maxL1ReferenceCount;
+         s->MaxLongTermReferences = 0;
+         s->MaxDPBCapacity = dpb_capacity(c);
+      } else if (d->Codec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_HEVC && d->PictureSupport.pHEVCSupport) {
+         auto *s = d->PictureSupport.pHEVCSupport;
+         s->MaxL0ReferencesForP = c->h265.maxPPictureL0ReferenceCount;
+         s->MaxL0ReferencesForB = c->h265.maxBPictureL0ReferenceCount;
+         s->MaxL1ReferencesForB = c->h265.maxL1ReferenceCount;
+         s->MaxLongTermReferences = 0;
+         s->MaxDPBCapacity = dpb_capacity(c);
+      }
+      return S_OK;
+   }
+   case D3D12DDICAPS_TYPE_VIDEO_0080_ENCODER_RESOURCE_REQUIREMENTS: {
+      auto *d = CAPS(D3D12DDICAPS_VIDEO_ENCODER_RESOURCE_REQUIREMENTS_DATA_0080_2);
+      if (!d)
+         return E_INVALIDARG;
+      const video_caps *c = video ? caps_get(video, profile_index(d->Codec, &d->Profile)) : NULL;
+      d->IsSupported = c != NULL;
+      if (c) {
+         d->CompressedBitstreamBufferAccessAlignment =
+            (UINT)std::max(c->caps.minBitstreamBufferOffsetAlignment, c->caps.minBitstreamBufferSizeAlignment);
+         d->EncoderMetadataBufferAccessAlignment = 16;
+         d->MaxEncoderOutputMetadataBufferSize = 64;
+      }
+      return S_OK;
+   }
+   default:
+      return E_INVALIDARG;
+   }
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Encoders and heaps */
+
+struct viogpu_video_encoder {
+   D3D12DDI_VIDEO_ENCODER_CODEC_0080 codec;
+   int profile;
+   DXGI_FORMAT format;
+   D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_H264_0082_0 h264;
+   D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_0082_0 hevc;
+};
+
+/* What a DPB slot holds: the application's reconstructed picture it stands for, and the reference information */
+struct dpb_slot {
+   bool used;
+   bool initialized;
+   ID3D12Resource *texture;
+   UINT subresource;
+   UINT pictureType; /* StdVideoH264PictureType / StdVideoH265PictureType */
+   UINT frameNum;
+   INT poc;
+   UINT temporalId;
+};
+
+/* The parameter sets' inputs: a change makes new session parameters */
+struct params_key {
+   UINT width, height;
+   UINT ppsId;
+   UINT pocType, log2MaxFrameNum, log2MaxPocLsb;
+   UINT maxRefs;
+   bool bFrames;
+   bool operator!=(const params_key &o) const { return memcmp(this, &o, sizeof(*this)) != 0; }
+};
+
+/* The rate control the session has (normalized for comparison) */
+struct rc_key {
+   UINT mode;
+   UINT64 average, peak, vbv, initialVbv;
+   UINT minQp, maxQp;
+   UINT fpsNum, fpsDen;
+   UINT gop, idrPeriod, bFrames;
+   bool operator!=(const rc_key &o) const { return memcmp(this, &o, sizeof(*this)) != 0; }
+};
+
+#define QUERY_COUNT 64
+
+struct video_session {
+   viogpu_video *video;
+   video_profile profile;
+   const video_caps *caps;
+   bool hevc;
+   VkExtent2D maxExtent;
+   VkVideoSessionKHR session;
+   std::vector<VkDeviceMemory> memory;
+   VkVideoSessionParametersKHR params;
+   params_key paramsKey;
+   /* parameters replaced while lists may still use them: freed with the session */
+   std::vector<VkVideoSessionParametersKHR> oldParams;
+   VkImage dpb;
+   VkDeviceMemory dpbMemory;
+   std::vector<VkImageView> dpbViews;
+   std::vector<dpb_slot> slots;
+   VkQueryPool queries;
+   uint32_t nextQuery;
+   bool reset;
+   /* H.264 frame_num: the last picture's, and whether it was a reference */
+   UINT lastFrameNum;
+   bool lastReference;
+   /* the rate control state (Begin's pNext must name it once set) */
+   bool rcSet;
+   rc_key rc;
+   VkVideoEncodeRateControlInfoKHR rcInfo;
+   VkVideoEncodeRateControlLayerInfoKHR rcLayer;
+   VkVideoEncodeH264RateControlInfoKHR h264Rc;
+   VkVideoEncodeH264RateControlLayerInfoKHR h264RcLayer;
+   VkVideoEncodeH265RateControlInfoKHR h265Rc;
+   VkVideoEncodeH265RateControlLayerInfoKHR h265RcLayer;
+   /* views of the application's input pictures; ponytail: kept until the session ends (Venus never reuses handles,
+    * a destroyed texture's view just stays unused), an LRU when long sessions see many different textures */
+   std::map<std::pair<VkImage, UINT>, VkImageView> inputViews;
+   /* An input picture copy, for textures vkd3d-proton makes in another format than the profile's (P010: G16 there,
+    * G10X6 for video; the same bytes) */
+   VkImage copy;
+   VkDeviceMemory copyMemory;
+   VkImageView copyView;
+   bool copyUsed;
+};
+
+struct viogpu_video_heap {
+   viogpu_device *device;
+   D3D12DDI_VIDEO_ENCODER_CODEC_0080 codec;
+   int profile;
+   UINT level;
+   D3D12DDI_VIDEO_ENCODER_TIER_HEVC_0080 tier;
+   UINT maxWidth, maxHeight;
+   video_session *session;
+};
+
+static SIZE_T APIENTRY
+calc_encoder_size(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATE_VIDEO_ENCODER_0082_0 *)
+{
+   return sizeof(viogpu_video_encoder);
+}
+
+static HRESULT APIENTRY
+create_encoder(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_VIDEO_ENCODER_0082_0 *args,
+               D3D12DDI_HVIDEOENCODER_0080 h)
+{
+   viogpu_video *video = video_get(device_from(hDevice));
+   int index = profile_index(args->EncodeCodec, &args->EncodeProfile);
+   if (!video || !caps_get(video, index)) {
+      viogpu_log("video: CreateVideoEncoder: codec %d profile %d not supported", (int)args->EncodeCodec, index);
+      return E_INVALIDARG;
+   }
+   viogpu_video_encoder *encoder = new (h.pDrvPrivate) viogpu_video_encoder();
+   encoder->codec = args->EncodeCodec;
+   encoder->profile = index;
+   encoder->format = args->InputFormat;
+   if (args->EncodeCodec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_H264 && args->CodecConfiguration.pH264Config)
+      encoder->h264 = *args->CodecConfiguration.pH264Config;
+   if (args->EncodeCodec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_HEVC && args->CodecConfiguration.pHEVCConfig)
+      encoder->hevc = *args->CodecConfiguration.pHEVCConfig;
+   viogpu_log("video: CreateVideoEncoder: codec %d profile %d format %d", (int)args->EncodeCodec, index,
+              (int)args->InputFormat);
+   return S_OK;
+}
+
+static VOID APIENTRY
+destroy_encoder(D3D12DDI_HDEVICE, D3D12DDI_HVIDEOENCODER_0080 h)
+{
+   ((viogpu_video_encoder *)h.pDrvPrivate)->~viogpu_video_encoder();
+}
+
+static SIZE_T APIENTRY
+calc_heap_size(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATE_VIDEO_ENCODER_HEAP_0080_2 *)
+{
+   return sizeof(viogpu_video_heap);
+}
+
+static HRESULT APIENTRY
+create_heap(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_VIDEO_ENCODER_HEAP_0080_2 *args,
+            D3D12DDI_HVIDEOENCODERHEAP_0080 h)
+{
+   viogpu_device *device = device_from(hDevice);
+   viogpu_video *video = video_get(device);
+   int index = profile_index(args->EncodeCodec, &args->EncodeProfile);
+   if (!video || !caps_get(video, index))
+      return E_INVALIDARG;
+   viogpu_video_heap *heap = new (h.pDrvPrivate) viogpu_video_heap();
+   heap->device = device;
+   heap->codec = args->EncodeCodec;
+   heap->profile = index;
+   if (args->EncodeCodec == D3D12DDI_VIDEO_ENCODER_CODEC_0080_HEVC && args->EncodeLevel.pHEVCLevelSetting) {
+      heap->level = args->EncodeLevel.pHEVCLevelSetting->Level;
+      heap->tier = args->EncodeLevel.pHEVCLevelSetting->Tier;
+   } else if (args->EncodeLevel.pH264LevelSetting) {
+      heap->level = *args->EncodeLevel.pH264LevelSetting;
+   }
+   for (UINT i = 0; i < args->ResolutionsListCount; i++) {
+      heap->maxWidth = std::max(heap->maxWidth, args->pResolutionList[i].Width);
+      heap->maxHeight = std::max(heap->maxHeight, args->pResolutionList[i].Height);
+   }
+   viogpu_log("video: CreateVideoEncoderHeap: codec %d profile %d level %u, up to %ux%u", (int)heap->codec, index,
+              heap->level, heap->maxWidth, heap->maxHeight);
+   return S_OK;
+}
+
+static void session_destroy(video_session *s);
+
+static VOID APIENTRY
+destroy_heap(D3D12DDI_HDEVICE, D3D12DDI_HVIDEOENCODERHEAP_0080 h)
+{
+   viogpu_video_heap *heap = (viogpu_video_heap *)h.pDrvPrivate;
+   if (heap->session)
+      session_destroy(heap->session);
+   heap->~viogpu_video_heap();
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* The session */
+
+static VkDeviceMemory
+memory_allocate(viogpu_video *video, VkDeviceSize size, uint32_t typeBits)
+{
+   /* device-local first */
+   for (int pass = 0; pass < 2; pass++) {
+      for (uint32_t i = 0; i < video->memory.memoryTypeCount; i++) {
+         if (!(typeBits & (1u << i)))
+            continue;
+         if (!pass && !(video->memory.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT))
+            continue;
+         VkMemoryAllocateInfo info = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+         info.allocationSize = size;
+         info.memoryTypeIndex = i;
+         VkDeviceMemory memory;
+         if (video->AllocateMemory(video->device, &info, NULL, &memory) == VK_SUCCESS)
+            return memory;
+      }
+   }
+   return VK_NULL_HANDLE;
+}
+
+static void
+session_destroy(video_session *s)
+{
+   viogpu_video *v = s->video;
+   EnterCriticalSection(&v->lock);
+   for (auto it = v->metadata.begin(); it != v->metadata.end();)
+      it = it->second.first == s ? v->metadata.erase(it) : std::next(it);
+   LeaveCriticalSection(&v->lock);
+   for (auto &view : s->inputViews)
+      v->DestroyImageView(v->device, view.second, NULL);
+   if (s->copyView)
+      v->DestroyImageView(v->device, s->copyView, NULL);
+   if (s->copy)
+      v->DestroyImage(v->device, s->copy, NULL);
+   if (s->copyMemory)
+      v->FreeMemory(v->device, s->copyMemory, NULL);
+   for (VkImageView view : s->dpbViews)
+      v->DestroyImageView(v->device, view, NULL);
+   if (s->dpb)
+      v->DestroyImage(v->device, s->dpb, NULL);
+   if (s->dpbMemory)
+      v->FreeMemory(v->device, s->dpbMemory, NULL);
+   if (s->queries)
+      v->DestroyQueryPool(v->device, s->queries, NULL);
+   for (VkVideoSessionParametersKHR p : s->oldParams)
+      v->DestroyVideoSessionParametersKHR(v->device, p, NULL);
+   if (s->params)
+      v->DestroyVideoSessionParametersKHR(v->device, s->params, NULL);
+   if (s->session)
+      v->DestroyVideoSessionKHR(v->device, s->session, NULL);
+   for (VkDeviceMemory m : s->memory)
+      v->FreeMemory(v->device, m, NULL);
+   delete s;
+}
+
+/* The session, its DPB and feedback queries, made by the heap's first EncodeFrame */
+static video_session *
+session_get(viogpu_video_heap *heap, const viogpu_video_encoder *encoder)
+{
+   if (heap->session)
+      return heap->session;
+   viogpu_video *v = heap->device->video;
+   video_session *s = new video_session();
+   s->video = v;
+   profile_fill(&s->profile, encoder->profile);
+   s->caps = caps_get(v, encoder->profile);
+   s->hevc = s->profile.hevc;
+   UINT block = block_size(s->caps, s->hevc);
+   s->maxExtent.width = std::min((heap->maxWidth + block - 1) / block * block, s->caps->caps.maxCodedExtent.width);
+   s->maxExtent.height = std::min((heap->maxHeight + block - 1) / block * block, s->caps->caps.maxCodedExtent.height);
+   uint32_t slots = std::min(s->caps->caps.maxDpbSlots, 17u);
+
+   VkVideoSessionCreateInfoKHR info = {VK_STRUCTURE_TYPE_VIDEO_SESSION_CREATE_INFO_KHR};
+   info.queueFamilyIndex = v->family;
+   info.pVideoProfile = &s->profile.info;
+   info.pictureFormat = s->profile.format;
+   info.maxCodedExtent = s->maxExtent;
+   info.referencePictureFormat = s->profile.format;
+   info.maxDpbSlots = slots;
+   info.maxActiveReferencePictures = std::min(s->caps->caps.maxActiveReferencePictures, slots - 1);
+   info.pStdHeaderVersion = &s->caps->caps.stdHeaderVersion;
+   VkResult r = v->CreateVideoSessionKHR(v->device, &info, NULL, &s->session);
+   if (r != VK_SUCCESS) {
+      viogpu_log("video: vkCreateVideoSessionKHR: %d", (int)r);
+      session_destroy(s);
+      return NULL;
+   }
+
+   uint32_t count = 0;
+   v->GetVideoSessionMemoryRequirementsKHR(v->device, s->session, &count, NULL);
+   std::vector<VkVideoSessionMemoryRequirementsKHR> reqs(count, {VK_STRUCTURE_TYPE_VIDEO_SESSION_MEMORY_REQUIREMENTS_KHR});
+   v->GetVideoSessionMemoryRequirementsKHR(v->device, s->session, &count, reqs.data());
+   std::vector<VkBindVideoSessionMemoryInfoKHR> binds;
+   for (const auto &req : reqs) {
+      VkDeviceMemory memory = memory_allocate(v, req.memoryRequirements.size, req.memoryRequirements.memoryTypeBits);
+      if (!memory) {
+         viogpu_log("video: no memory for the session (%llu bytes)", (unsigned long long)req.memoryRequirements.size);
+         session_destroy(s);
+         return NULL;
+      }
+      s->memory.push_back(memory);
+      VkBindVideoSessionMemoryInfoKHR bind = {VK_STRUCTURE_TYPE_BIND_VIDEO_SESSION_MEMORY_INFO_KHR};
+      bind.memoryBindIndex = req.memoryBindIndex;
+      bind.memory = memory;
+      bind.memorySize = req.memoryRequirements.size;
+      binds.push_back(bind);
+   }
+   if (count && (r = v->BindVideoSessionMemoryKHR(v->device, s->session, count, binds.data())) != VK_SUCCESS) {
+      viogpu_log("video: vkBindVideoSessionMemoryKHR: %d", (int)r);
+      session_destroy(s);
+      return NULL;
+   }
+
+   /* the DPB: one layer per slot */
+   VkImageCreateInfo image = {VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+   image.pNext = &s->profile.list;
+   image.imageType = VK_IMAGE_TYPE_2D;
+   image.format = s->profile.format;
+   image.extent = {s->maxExtent.width, s->maxExtent.height, 1};
+   image.mipLevels = 1;
+   image.arrayLayers = slots;
+   image.samples = VK_SAMPLE_COUNT_1_BIT;
+   image.tiling = VK_IMAGE_TILING_OPTIMAL;
+   image.usage = VK_IMAGE_USAGE_VIDEO_ENCODE_DPB_BIT_KHR;
+   image.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+   image.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+   if ((r = v->CreateImage(v->device, &image, NULL, &s->dpb)) != VK_SUCCESS) {
+      viogpu_log("video: DPB image: %d", (int)r);
+      session_destroy(s);
+      return NULL;
+   }
+   VkMemoryRequirements req;
+   v->GetImageMemoryRequirements(v->device, s->dpb, &req);
+   if (!(s->dpbMemory = memory_allocate(v, req.size, req.memoryTypeBits)) ||
+       v->BindImageMemory(v->device, s->dpb, s->dpbMemory, 0) != VK_SUCCESS) {
+      viogpu_log("video: no memory for the DPB (%llu bytes)", (unsigned long long)req.size);
+      session_destroy(s);
+      return NULL;
+   }
+   for (uint32_t i = 0; i < slots; i++) {
+      VkImageViewCreateInfo view = {VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+      view.image = s->dpb;
+      view.viewType = VK_IMAGE_VIEW_TYPE_2D;
+      view.format = s->profile.format;
+      view.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, i, 1};
+      VkImageView handle;
+      if (v->CreateImageView(v->device, &view, NULL, &handle) != VK_SUCCESS) {
+         session_destroy(s);
+         return NULL;
+      }
+      s->dpbViews.push_back(handle);
+   }
+   s->slots.resize(slots);
+
+   VkQueryPoolVideoEncodeFeedbackCreateInfoKHR feedback = {
+      VK_STRUCTURE_TYPE_QUERY_POOL_VIDEO_ENCODE_FEEDBACK_CREATE_INFO_KHR};
+   feedback.pNext = &s->profile.info;
+   feedback.encodeFeedbackFlags =
+      VK_VIDEO_ENCODE_FEEDBACK_BITSTREAM_BUFFER_OFFSET_BIT_KHR | VK_VIDEO_ENCODE_FEEDBACK_BITSTREAM_BYTES_WRITTEN_BIT_KHR;
+   VkQueryPoolCreateInfo pool = {VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+   pool.pNext = &feedback;
+   pool.queryType = VK_QUERY_TYPE_VIDEO_ENCODE_FEEDBACK_KHR;
+   pool.queryCount = QUERY_COUNT;
+   if ((r = v->CreateQueryPool(v->device, &pool, NULL, &s->queries)) != VK_SUCCESS) {
+      viogpu_log("video: feedback query pool: %d", (int)r);
+      session_destroy(s);
+      return NULL;
+   }
+   viogpu_log("video: session %ux%u, %u slots", s->maxExtent.width, s->maxExtent.height, slots);
+   heap->session = s;
+   return s;
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Parameter sets: the values the D3D12 video encoding spec has drivers expect */
+
+struct h264_sets {
+   StdVideoH264SequenceParameterSet sps;
+   StdVideoH264PictureParameterSet pps;
+};
+
+static void
+h264_sets_fill(h264_sets *s, const viogpu_video_heap *heap, const viogpu_video_encoder *encoder, const params_key &k)
+{
+   memset(s, 0, sizeof(*s));
+   StdVideoH264SequenceParameterSet &sps = s->sps;
+   UINT mbWidth = (k.width + 15) / 16, mbHeight = (k.height + 15) / 16;
+   sps.flags.direct_8x8_inference_flag = 1;
+   sps.flags.frame_mbs_only_flag = 1;
+   sps.flags.frame_cropping_flag = mbWidth * 16 != k.width || mbHeight * 16 != k.height;
+   sps.profile_idc = encoder->profile == PROFILE_H264_HIGH ? STD_VIDEO_H264_PROFILE_IDC_HIGH : STD_VIDEO_H264_PROFILE_IDC_MAIN;
+   sps.level_idc = h264_level_to_vk(heap->level);
+   sps.chroma_format_idc = STD_VIDEO_H264_CHROMA_FORMAT_IDC_420;
+   sps.seq_parameter_set_id = 0;
+   sps.log2_max_frame_num_minus4 = (uint8_t)k.log2MaxFrameNum;
+   sps.pic_order_cnt_type = (StdVideoH264PocType)k.pocType;
+   sps.log2_max_pic_order_cnt_lsb_minus4 = (uint8_t)k.log2MaxPocLsb;
+   sps.max_num_ref_frames = (uint8_t)std::max(1u, k.maxRefs);
+   sps.pic_width_in_mbs_minus1 = mbWidth - 1;
+   sps.pic_height_in_map_units_minus1 = mbHeight - 1;
+   sps.frame_crop_right_offset = (mbWidth * 16 - k.width) / 2;
+   sps.frame_crop_bottom_offset = (mbHeight * 16 - k.height) / 2;
+
+   StdVideoH264PictureParameterSet &pps = s->pps;
+   UINT flags = encoder->h264.ConfigurationFlags;
+   pps.flags.entropy_coding_mode_flag = !!(flags & D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_H264_FLAG_ENABLE_CABAC_ENCODING_0080);
+   pps.flags.constrained_intra_pred_flag =
+      !!(flags & D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_H264_FLAG_USE_CONSTRAINED_INTRAPREDICTION_0080);
+   pps.flags.deblocking_filter_control_present_flag = 1;
+   /* The spec has transform_8x8_mode_flag follow USE_ADAPTIVE_8x8_TRANSFORM; ffmpeg's d3d12va encoder writes 1 for
+    * High profile without setting it (as real drivers evidently encode), so High has it either way.
+    * ponytail: an application writing 0 for High without the flag would get a broken stream */
+   pps.flags.transform_8x8_mode_flag = encoder->profile == PROFILE_H264_HIGH;
+   pps.seq_parameter_set_id = 0;
+   pps.pic_parameter_set_id = (uint8_t)k.ppsId;
+   pps.weighted_bipred_idc = STD_VIDEO_H264_WEIGHTED_BIPRED_IDC_DEFAULT;
+}
+
+struct h265_sets {
+   StdVideoH265ProfileTierLevel ptl;
+   StdVideoH265DecPicBufMgr dpbm;
+   StdVideoH265VideoParameterSet vps;
+   StdVideoH265SequenceParameterSet sps;
+   StdVideoH265PictureParameterSet pps;
+};
+
+static void
+h265_sets_fill(h265_sets *s, const viogpu_video_heap *heap, const viogpu_video_encoder *encoder,
+               const video_session *session, const params_key &k)
+{
+   memset(s, 0, sizeof(*s));
+   s->ptl.flags.general_tier_flag = heap->tier == D3D12DDI_VIDEO_ENCODER_TIER_HEVC_0080_HIGH;
+   s->ptl.flags.general_progressive_source_flag = 1;
+   s->ptl.flags.general_non_packed_constraint_flag = 1;
+   s->ptl.flags.general_frame_only_constraint_flag = 1;
+   s->ptl.general_profile_idc =
+      encoder->profile == PROFILE_HEVC_MAIN10 ? STD_VIDEO_H265_PROFILE_IDC_MAIN_10 : STD_VIDEO_H265_PROFILE_IDC_MAIN;
+   s->ptl.general_level_idc = (StdVideoH265LevelIdc)heap->level;
+   s->dpbm.max_dec_pic_buffering_minus1[0] = (uint8_t)k.maxRefs;
+   s->dpbm.max_num_reorder_pics[0] = k.bFrames ? (uint8_t)k.maxRefs : 0;
+   s->dpbm.max_latency_increase_plus1[0] = 1;
+
+   StdVideoH265VideoParameterSet &vps = s->vps;
+   vps.flags.vps_temporal_id_nesting_flag = 1;
+   vps.vps_video_parameter_set_id = 0;
+   vps.pDecPicBufMgr = &s->dpbm;
+   vps.pProfileTierLevel = &s->ptl;
+
+   const D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_0082_0 &c = encoder->hevc;
+   UINT block = block_size(session->caps, true);
+   UINT width = (k.width + block - 1) / block * block, height = (k.height + block - 1) / block * block;
+   UINT minCu = 8u << c.MinLumaCodingUnitSize, maxCu = 8u << c.MaxLumaCodingUnitSize;
+   UINT minTu = 4u << c.MinLumaTransformUnitSize, maxTu = 4u << c.MaxLumaTransformUnitSize;
+   StdVideoH265SequenceParameterSet &sps = s->sps;
+   sps.flags.sps_temporal_id_nesting_flag = 1;
+   sps.flags.conformance_window_flag = width != k.width || height != k.height;
+   sps.flags.amp_enabled_flag =
+      !!(c.ConfigurationFlags & D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_FLAG_0082_0_USE_ASYMETRIC_MOTION_PARTITION);
+   sps.flags.sample_adaptive_offset_enabled_flag =
+      !!(c.ConfigurationFlags & D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_FLAG_0082_0_ENABLE_SAO_FILTER);
+   sps.flags.long_term_ref_pics_present_flag =
+      !!(c.ConfigurationFlags & D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_FLAG_0082_0_ENABLE_LONG_TERM_REFERENCES);
+   sps.chroma_format_idc = STD_VIDEO_H265_CHROMA_FORMAT_IDC_420;
+   sps.pic_width_in_luma_samples = width;
+   sps.pic_height_in_luma_samples = height;
+   sps.sps_video_parameter_set_id = 0;
+   sps.sps_seq_parameter_set_id = 0;
+   sps.bit_depth_luma_minus8 = sps.bit_depth_chroma_minus8 = encoder->profile == PROFILE_HEVC_MAIN10 ? 2 : 0;
+   sps.log2_max_pic_order_cnt_lsb_minus4 = (uint8_t)k.log2MaxPocLsb;
+   sps.log2_min_luma_coding_block_size_minus3 = (uint8_t)(log2_of(minCu) - 3);
+   sps.log2_diff_max_min_luma_coding_block_size = (uint8_t)(log2_of(maxCu) - log2_of(minCu));
+   sps.log2_min_luma_transform_block_size_minus2 = (uint8_t)(log2_of(minTu) - 2);
+   sps.log2_diff_max_min_luma_transform_block_size = (uint8_t)(log2_of(maxTu) - log2_of(minTu));
+   sps.max_transform_hierarchy_depth_inter = c.max_transform_hierarchy_depth_inter;
+   sps.max_transform_hierarchy_depth_intra = c.max_transform_hierarchy_depth_intra;
+   sps.conf_win_right_offset = (width - k.width) / 2;
+   sps.conf_win_bottom_offset = (height - k.height) / 2;
+   sps.pProfileTierLevel = &s->ptl;
+   sps.pDecPicBufMgr = &s->dpbm;
+
+   StdVideoH265PictureParameterSet &pps = s->pps;
+   pps.flags.cabac_init_present_flag = 1;
+   pps.flags.constrained_intra_pred_flag =
+      !!(c.ConfigurationFlags & D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_FLAG_0082_0_USE_CONSTRAINED_INTRAPREDICTION);
+   pps.flags.transform_skip_enabled_flag =
+      !!(c.ConfigurationFlags & D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_FLAG_0082_0_ENABLE_TRANSFORM_SKIPPING);
+   pps.flags.cu_qp_delta_enabled_flag = 1;
+   pps.flags.pps_slice_chroma_qp_offsets_present_flag = 1;
+   pps.flags.pps_loop_filter_across_slices_enabled_flag =
+      !(c.ConfigurationFlags & D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_FLAG_0082_0_DISABLE_LOOP_FILTER_ACROSS_SLICES);
+   pps.flags.deblocking_filter_control_present_flag = 1;
+   pps.pps_pic_parameter_set_id = (uint8_t)k.ppsId;
+   pps.pps_seq_parameter_set_id = 0;
+   pps.sps_video_parameter_set_id = 0;
+}
+
+/* Probe: parameters with AMP off for a small session; an SPS override means the encoder forces AMP on */
+static bool
+hevc_amp_required(viogpu_video *v, int index)
+{
+   if (index < 0 || index >= PROFILE_COUNT)
+      return false;
+   if (v->ampRequired[index])
+      return v->ampRequired[index] == 2;
+   v->ampRequired[index] = 1;
+   video_session s = {};
+   s.video = v;
+   s.hevc = true;
+   s.caps = caps_get(v, index);
+   if (!s.caps)
+      return false;
+   profile_fill(&s.profile, index);
+   UINT ctb = block_size(s.caps, true);
+   VkVideoSessionCreateInfoKHR info = {VK_STRUCTURE_TYPE_VIDEO_SESSION_CREATE_INFO_KHR};
+   info.queueFamilyIndex = v->family;
+   info.pVideoProfile = &s.profile.info;
+   info.pictureFormat = info.referencePictureFormat = s.profile.format;
+   info.maxCodedExtent = {std::max(s.caps->caps.minCodedExtent.width, 256u), std::max(s.caps->caps.minCodedExtent.height, 256u)};
+   info.maxDpbSlots = 2;
+   info.maxActiveReferencePictures = 1;
+   info.pStdHeaderVersion = &s.caps->caps.stdHeaderVersion;
+   VkVideoSessionKHR session;
+   if (v->CreateVideoSessionKHR(v->device, &info, NULL, &session) != VK_SUCCESS)
+      return false;
+   viogpu_video_heap heap = {};
+   heap.level = (UINT)s.caps->h265.maxLevelIdc;
+   viogpu_video_encoder encoder = {};
+   encoder.profile = index;
+   encoder.hevc.MaxLumaCodingUnitSize = (D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_CUSIZE_0080)(log2_of(ctb) - 3);
+   encoder.hevc.MaxLumaTransformUnitSize = D3D12DDI_VIDEO_ENCODER_CODEC_CONFIGURATION_HEVC_TUSIZE_0082_0_32x32;
+   encoder.hevc.max_transform_hierarchy_depth_inter = encoder.hevc.max_transform_hierarchy_depth_intra = (UCHAR)(log2_of(ctb) - 2);
+   params_key k = {};
+   k.width = info.maxCodedExtent.width;
+   k.height = info.maxCodedExtent.height;
+   k.log2MaxPocLsb = 4;
+   k.maxRefs = 1;
+   h265_sets sets;
+   h265_sets_fill(&sets, &heap, &encoder, &s, k);
+   VkVideoEncodeH265SessionParametersAddInfoKHR add = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_SESSION_PARAMETERS_ADD_INFO_KHR};
+   add.stdVPSCount = add.stdSPSCount = add.stdPPSCount = 1;
+   add.pStdVPSs = &sets.vps;
+   add.pStdSPSs = &sets.sps;
+   add.pStdPPSs = &sets.pps;
+   VkVideoEncodeH265SessionParametersCreateInfoKHR h265 = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_SESSION_PARAMETERS_CREATE_INFO_KHR};
+   h265.maxStdVPSCount = h265.maxStdSPSCount = h265.maxStdPPSCount = 1;
+   h265.pParametersAddInfo = &add;
+   VkVideoSessionParametersCreateInfoKHR create = {VK_STRUCTURE_TYPE_VIDEO_SESSION_PARAMETERS_CREATE_INFO_KHR};
+   create.pNext = &h265;
+   create.videoSession = session;
+   VkVideoSessionParametersKHR params;
+   if (v->CreateVideoSessionParametersKHR(v->device, &create, NULL, &params) == VK_SUCCESS) {
+      VkVideoEncodeH265SessionParametersGetInfoKHR which = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_SESSION_PARAMETERS_GET_INFO_KHR};
+      which.writeStdSPS = VK_TRUE;
+      VkVideoEncodeSessionParametersGetInfoKHR get = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_SESSION_PARAMETERS_GET_INFO_KHR};
+      get.pNext = &which;
+      get.videoSessionParameters = params;
+      VkVideoEncodeH265SessionParametersFeedbackInfoKHR codec = {
+         VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_SESSION_PARAMETERS_FEEDBACK_INFO_KHR};
+      VkVideoEncodeSessionParametersFeedbackInfoKHR feedback = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_SESSION_PARAMETERS_FEEDBACK_INFO_KHR};
+      feedback.pNext = &codec;
+      UINT8 data[512];
+      size_t size = sizeof(data);
+      /* ponytail: any SPS override counts as AMP (the only one seen); parse the SPS when another shows up */
+      if (v->GetEncodedVideoSessionParametersKHR(v->device, &get, &feedback, &size, data) == VK_SUCCESS &&
+          codec.hasStdSPSOverrides)
+         v->ampRequired[index] = 2;
+      v->DestroyVideoSessionParametersKHR(v->device, params, NULL);
+   }
+   v->DestroyVideoSessionKHR(v->device, session, NULL);
+   viogpu_log("video: HEVC profile %d: the encoder %s AMP", index, v->ampRequired[index] == 2 ? "forces" : "leaves");
+   return v->ampRequired[index] == 2;
+}
+
+/* Whether the encoder overrides parameter-set values (Vulkan lets it): the application writes its own headers, so
+ * an override would make them disagree with the slices. Logged with the encoder's own parameter sets. */
+static void
+params_check(video_session *s)
+{
+   viogpu_video *v = s->video;
+   VkVideoEncodeSessionParametersGetInfoKHR get = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_SESSION_PARAMETERS_GET_INFO_KHR};
+   get.videoSessionParameters = s->params;
+   VkVideoEncodeH264SessionParametersGetInfoKHR h264 = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_SESSION_PARAMETERS_GET_INFO_KHR};
+   VkVideoEncodeH265SessionParametersGetInfoKHR h265 = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_SESSION_PARAMETERS_GET_INFO_KHR};
+   if (s->hevc) {
+      h265.writeStdVPS = h265.writeStdSPS = h265.writeStdPPS = VK_TRUE;
+      h265.stdPPSId = (uint32_t)s->paramsKey.ppsId;
+      get.pNext = &h265;
+   } else {
+      h264.writeStdSPS = h264.writeStdPPS = VK_TRUE;
+      h264.stdPPSId = (uint32_t)s->paramsKey.ppsId;
+      get.pNext = &h264;
+   }
+   VkVideoEncodeSessionParametersFeedbackInfoKHR feedback = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_SESSION_PARAMETERS_FEEDBACK_INFO_KHR};
+   VkVideoEncodeH264SessionParametersFeedbackInfoKHR h264Feedback = {
+      VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_SESSION_PARAMETERS_FEEDBACK_INFO_KHR};
+   VkVideoEncodeH265SessionParametersFeedbackInfoKHR h265Feedback = {
+      VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_SESSION_PARAMETERS_FEEDBACK_INFO_KHR};
+   feedback.pNext = s->hevc ? (void *)&h265Feedback : (void *)&h264Feedback;
+   UINT8 data[1024];
+   size_t size = sizeof(data);
+   VkResult r = v->GetEncodedVideoSessionParametersKHR(v->device, &get, &feedback, &size, data);
+   char hex[600];
+   size_t n = 0;
+   for (size_t i = 0; i < size && n + 3 < sizeof(hex); i++)
+      n += snprintf(hex + n, sizeof(hex) - n, "%02x", data[i]);
+   hex[n] = 0;
+   viogpu_log("video: encoder parameter sets (result %d, overrides: any %u, sps %u, pps %u, vps %u): %s", (int)r,
+              feedback.hasOverrides, s->hevc ? h265Feedback.hasStdSPSOverrides : h264Feedback.hasStdSPSOverrides,
+              s->hevc ? h265Feedback.hasStdPPSOverrides : h264Feedback.hasStdPPSOverrides,
+              s->hevc ? h265Feedback.hasStdVPSOverrides : 0, hex);
+}
+
+static bool
+params_get(video_session *s, const viogpu_video_heap *heap, const viogpu_video_encoder *encoder, const params_key &k)
+{
+   if (s->params && !(s->paramsKey != k))
+      return true;
+   viogpu_video *v = s->video;
+   VkVideoSessionParametersCreateInfoKHR info = {VK_STRUCTURE_TYPE_VIDEO_SESSION_PARAMETERS_CREATE_INFO_KHR};
+   info.videoSession = s->session;
+   h264_sets h264;
+   h265_sets h265;
+   VkVideoEncodeH264SessionParametersAddInfoKHR h264Add = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_SESSION_PARAMETERS_ADD_INFO_KHR};
+   VkVideoEncodeH264SessionParametersCreateInfoKHR h264Info = {
+      VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_SESSION_PARAMETERS_CREATE_INFO_KHR};
+   VkVideoEncodeH265SessionParametersAddInfoKHR h265Add = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_SESSION_PARAMETERS_ADD_INFO_KHR};
+   VkVideoEncodeH265SessionParametersCreateInfoKHR h265Info = {
+      VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_SESSION_PARAMETERS_CREATE_INFO_KHR};
+   if (s->hevc) {
+      h265_sets_fill(&h265, heap, encoder, s, k);
+      h265Add.stdVPSCount = 1;
+      h265Add.pStdVPSs = &h265.vps;
+      h265Add.stdSPSCount = 1;
+      h265Add.pStdSPSs = &h265.sps;
+      h265Add.stdPPSCount = 1;
+      h265Add.pStdPPSs = &h265.pps;
+      h265Info.maxStdVPSCount = h265Info.maxStdSPSCount = h265Info.maxStdPPSCount = 1;
+      h265Info.pParametersAddInfo = &h265Add;
+      info.pNext = &h265Info;
+   } else {
+      h264_sets_fill(&h264, heap, encoder, k);
+      h264Add.stdSPSCount = 1;
+      h264Add.pStdSPSs = &h264.sps;
+      h264Add.stdPPSCount = 1;
+      h264Add.pStdPPSs = &h264.pps;
+      h264Info.maxStdSPSCount = h264Info.maxStdPPSCount = 1;
+      h264Info.pParametersAddInfo = &h264Add;
+      info.pNext = &h264Info;
+   }
+   VkVideoSessionParametersKHR params;
+   VkResult r = v->CreateVideoSessionParametersKHR(v->device, &info, NULL, &params);
+   if (r != VK_SUCCESS) {
+      viogpu_log("video: vkCreateVideoSessionParametersKHR: %d", (int)r);
+      return false;
+   }
+   if (s->params)
+      s->oldParams.push_back(s->params);
+   s->params = params;
+   s->paramsKey = k;
+   params_check(s);
+   viogpu_log("video: parameters for %ux%u (PPS %u, POC type %u, frame_num %u bits, POC LSB %u bits)", k.width, k.height,
+              k.ppsId, k.pocType, k.log2MaxFrameNum + 4, k.log2MaxPocLsb + 4);
+   return true;
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Rate control */
+
+static rc_key
+rc_from(const D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_0080_2 &rc, UINT gop, UINT pPeriod)
+{
+   rc_key k;
+   memset(&k, 0, sizeof(k));
+   k.mode = rc.Mode;
+   k.fpsNum = rc.TargetFrameRate.Numerator ? rc.TargetFrameRate.Numerator : 30;
+   k.fpsDen = rc.TargetFrameRate.Denominator ? rc.TargetFrameRate.Denominator : 1;
+   k.gop = gop;
+   k.idrPeriod = gop;
+   k.bFrames = pPeriod > 1 ? pPeriod - 1 : 0;
+   bool range = rc.Flags & D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_FLAG_0080_ENABLE_QP_RANGE;
+   bool vbv = rc.Flags & D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_FLAG_0080_1_ENABLE_VBV_SIZES;
+   if (rc.Mode == D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_MODE_0080_CBR && rc.ConfigParams.pConfiguration_CBR) {
+      const auto *c = rc.ConfigParams.pConfiguration_CBR;
+      k.average = k.peak = c->TargetBitRate;
+      if (vbv) {
+         k.vbv = c->VBVCapacity;
+         k.initialVbv = c->InitialVBVFullness;
+      }
+      if (range) {
+         k.minQp = c->MinQP;
+         k.maxQp = c->MaxQP;
+      }
+   } else if (rc.Mode == D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_MODE_0080_VBR && rc.ConfigParams.pConfiguration_VBR) {
+      const auto *c = rc.ConfigParams.pConfiguration_VBR;
+      k.average = c->TargetAvgBitRate;
+      k.peak = std::max(c->PeakBitRate, c->TargetAvgBitRate);
+      if (vbv) {
+         k.vbv = c->VBVCapacity;
+         k.initialVbv = c->InitialVBVFullness;
+      }
+      if (range) {
+         k.minQp = c->MinQP;
+         k.maxQp = c->MaxQP;
+      }
+   }
+   return k;
+}
+
+/* The rate control structures for k (pointing into the session) */
+static VkVideoEncodeRateControlInfoKHR *
+rc_build(video_session *s, const rc_key &k)
+{
+   s->rcInfo = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_RATE_CONTROL_INFO_KHR};
+   s->rcLayer = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_RATE_CONTROL_LAYER_INFO_KHR};
+   bool on = k.mode == D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_MODE_0080_CBR ||
+             k.mode == D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_MODE_0080_VBR;
+   s->rcInfo.rateControlMode = k.mode == D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_MODE_0080_CBR
+                                  ? VK_VIDEO_ENCODE_RATE_CONTROL_MODE_CBR_BIT_KHR
+                               : k.mode == D3D12DDI_VIDEO_ENCODER_RATE_CONTROL_MODE_0080_VBR
+                                  ? VK_VIDEO_ENCODE_RATE_CONTROL_MODE_VBR_BIT_KHR
+                                  : VK_VIDEO_ENCODE_RATE_CONTROL_MODE_DISABLED_BIT_KHR;
+   if (on) {
+      UINT64 rate = std::max<UINT64>(k.average, 1);
+      UINT64 bufferMs = k.vbv ? k.vbv * 1000 / rate : 1000;
+      bufferMs = std::max<UINT64>(bufferMs, 1);
+      s->rcInfo.virtualBufferSizeInMs = (uint32_t)bufferMs;
+      s->rcInfo.initialVirtualBufferSizeInMs =
+         (uint32_t)std::min<UINT64>(k.vbv ? k.initialVbv * 1000 / rate : bufferMs / 2, bufferMs);
+      s->rcInfo.layerCount = 1;
+      s->rcInfo.pLayers = &s->rcLayer;
+      s->rcLayer.averageBitrate = k.average;
+      s->rcLayer.maxBitrate = k.peak;
+      s->rcLayer.frameRateNumerator = k.fpsNum;
+      s->rcLayer.frameRateDenominator = k.fpsDen;
+   }
+   if (s->hevc) {
+      s->h265Rc = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_RATE_CONTROL_INFO_KHR};
+      s->h265Rc.flags = VK_VIDEO_ENCODE_H265_RATE_CONTROL_REGULAR_GOP_BIT_KHR;
+      s->h265Rc.gopFrameCount = k.gop;
+      s->h265Rc.idrPeriod = k.idrPeriod;
+      s->h265Rc.consecutiveBFrameCount = k.bFrames;
+      s->h265Rc.subLayerCount = on ? 1 : 0;
+      s->rcInfo.pNext = &s->h265Rc;
+      s->h265RcLayer = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_H265_RATE_CONTROL_LAYER_INFO_KHR};
+      s->h265RcLayer.useMinQp = s->h265RcLayer.useMaxQp = k.maxQp != 0;
+      s->h265RcLayer.minQp = {(int32_t)k.minQp, (int32_t)k.minQp, (int32_t)k.minQp};
+      s->h265RcLayer.maxQp = {(int32_t)k.maxQp, (int32_t)k.maxQp, (int32_t)k.maxQp};
+      s->rcLayer.pNext = &s->h265RcLayer;
+   } else {
+      s->h264Rc = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_RATE_CONTROL_INFO_KHR};
+      s->h264Rc.flags = VK_VIDEO_ENCODE_H264_RATE_CONTROL_REGULAR_GOP_BIT_KHR;
+      s->h264Rc.gopFrameCount = k.gop;
+      s->h264Rc.idrPeriod = k.idrPeriod;
+      s->h264Rc.consecutiveBFrameCount = k.bFrames;
+      s->h264Rc.temporalLayerCount = on ? 1 : 0;
+      s->rcInfo.pNext = &s->h264Rc;
+      s->h264RcLayer = {VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_RATE_CONTROL_LAYER_INFO_KHR};
+      s->h264RcLayer.useMinQp = s->h264RcLayer.useMaxQp = k.maxQp != 0;
+      s->h264RcLayer.minQp = {(int32_t)k.minQp, (int32_t)k.minQp, (int32_t)k.minQp};
+      s->h264RcLayer.maxQp = {(int32_t)k.maxQp, (int32_t)k.maxQp, (int32_t)k.maxQp};
+      s->rcLayer.pNext = &s->h264RcLayer;
+   }
+   return &s->rcInfo;
+}
