+         const dpb_slot &slot = s->slots[refs.slotOf[i]];
+         hp.refInfo[i].flags.used_for_long_term_reference = !!d.IsLongTermReference;
+         hp.refInfo[i].primary_pic_type = (StdVideoH264PictureType)slot.pictureType;
+         hp.refInfo[i].FrameNum = slot.frameNum;
+         hp.refInfo[i].PicOrderCnt = key.pocType == 2 ? 2 * (INT)d.PictureOrderCountNumber : (INT)d.PictureOrderCountNumber;
+         hp.refInfo[i].long_term_pic_num = (uint16_t)d.LongTermPictureIdx;
+         hp.refInfo[i].long_term_frame_idx = (uint16_t)d.LongTermPictureIdx;
+         hp.refInfo[i].temporal_id = (uint8_t)d.TemporalLayerIndex;
+         hp.refSlot[i].sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_DPB_SLOT_INFO_KHR;
+         hp.refSlot[i].pStdReferenceInfo = &hp.refInfo[i];
+         refSlots[i].pNext = &hp.refSlot[i];
+      }
+      if (refs.setupSlot >= 0) {
+         hp.setupInfo.primary_pic_type = type;
+         hp.setupInfo.FrameNum = hp.std.frame_num;
+         hp.setupInfo.PicOrderCnt = poc;
+         hp.setupInfo.temporal_id = hp.std.temporal_id;
+         hp.setupSlot.sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_DPB_SLOT_INFO_KHR;
+         hp.setupSlot.pStdReferenceInfo = &hp.setupInfo;
+         setupSlot.pNext = &hp.setupSlot;
