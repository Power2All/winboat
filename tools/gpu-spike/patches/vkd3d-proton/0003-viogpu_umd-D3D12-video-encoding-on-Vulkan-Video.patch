+      hp.sliceHeader.flags.num_ref_idx_active_override_flag =
+         (kind >= 1 && hp.lists.num_ref_idx_l0_active_minus1) || (kind == 2 && hp.lists.num_ref_idx_l1_active_minus1);
+      hp.sliceHeader.first_mb_in_slice = 0;
+      hp.sliceHeader.slice_type = kind == 1 ? STD_VIDEO_H264_SLICE_TYPE_P
+                                  : kind == 2 ? STD_VIDEO_H264_SLICE_TYPE_B
+                                              : STD_VIDEO_H264_SLICE_TYPE_I;
+      hp.sliceHeader.cabac_init_idc = STD_VIDEO_H264_CABAC_INIT_IDC_0;
+      hp.sliceHeader.disable_deblocking_filter_idc =
+         (StdVideoH264DisableDeblockingFilterIdc)std::min<UINT>(encoder->h264.DisableDeblockingFilterConfig, 2);
+      hp.sliceHeader.slice_qp_delta = qp ? (int8_t)((INT)qp - 26) : 0;
+      hp.slice.sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_NALU_SLICE_INFO_KHR;
+      hp.slice.constantQp = (int32_t)qp;
+      hp.slice.pStdSliceHeader = &hp.sliceHeader;
+      hp.info.sType = VK_STRUCTURE_TYPE_VIDEO_ENCODE_H264_PICTURE_INFO_KHR;
+      hp.info.naluSliceEntryCount = 1;
+      hp.info.pNaluSliceEntries = &hp.slice;
+      hp.info.pStdPictureInfo = &hp.std;
