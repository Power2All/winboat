+
+static VOID APIENTRY
+video_set_predication(D3D12DDI_HCOMMANDLIST, D3D12DDI_HRESOURCE hResource, UINT64, D3D12DDI_PREDICATION_OP)
+{
+   /* applications clear it (no buffer): predicated video encoding isn't offered */
+   if (hResource.pDrvPrivate)
+      viogpu_log("video: predication not supported");
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Video encoding queues: the resolves after the GPU */
+
+struct video_batch {
+   UINT64 n;
+   std::vector<metadata_resolve> resolves;
+};
+
+struct viogpu_video_queue {
+   viogpu_device *device;
+   ID3D12Fence *gpuDone;
+   ID3D12Fence *done;
+   CRITICAL_SECTION lock;
+   CONDITION_VARIABLE wake;
+   std::deque<video_batch> batches;
+   bool stop;
+   HANDLE thread;
+};
+
+static void
+resolve(viogpu_video *v, const metadata_resolve &r)
+{
+   D3D12DDI_VIDEO_ENCODER_OUTPUT_METADATA_0083_0 meta = {};
+   D3D12DDI_VIDEO_ENCODER_FRAME_SUBREGION_METADATA_0083_0 region = {};
+   if (r.session) {
+      /* offset, bytes written, status (VkQueryResultStatusKHR), as 32-bit values: asked for 64-bit ones, the
+       * spike got them packed as 32-bit anyway (NVIDIA through Venus; not looked into) */
+      int32_t result[3] = {0, 0, 0};
+      VkResult vr = v->GetQueryPoolResults(v->device, r.session->queries, r.query, 1, sizeof(result), result,
+                                           sizeof(result), VK_QUERY_RESULT_WITH_STATUS_BIT_KHR);
+      if (vr != VK_SUCCESS || result[2] != VK_QUERY_RESULT_STATUS_COMPLETE_KHR) {
+         viogpu_log("video: encode feedback: result %d status %d", (int)vr, result[2]);
+         meta.EncodeErrorFlags = D3D12DDI_VIDEO_ENCODER_ENCODE_ERROR_FLAG_0082_0_CODEC_PICTURE_CONTROL_NOT_SUPPORTED;
+      } else {
+         /* applications read the frame from the offset they gave: a driver offset would be lost
+          * (ponytail: NVIDIA writes at 0; another driver's offset would need moving the data) */
+         if (result[0])
+            viogpu_log("video: the encoder wrote at offset %d", result[0]);
+         meta.EncodedBitstreamWrittenBytesCount = (UINT64)result[1];
+         meta.WrittenSubregionsCount = 1;
+         region.bSize = (UINT64)result[1];
+         region.bStartOffset = (UINT64)result[0];
+      }
+   } else {
+      meta.EncodeErrorFlags = D3D12DDI_VIDEO_ENCODER_ENCODE_ERROR_FLAG_0082_0_INVALID_METADATA_BUFFER_SOURCE;
+   }
+   /* ponytail: resolved metadata in a CPU-visible buffer (readback, as applications use); a default-heap one would
+    * need a copy queue */
+   UINT8 *data = NULL;
+   D3D12_RANGE none = {0, 0};
+   if (!r.buffer || FAILED(r.buffer->Map(0, &none, (void **)&data)) || !data) {
+      viogpu_log("video: the resolved metadata buffer is not CPU-visible");
+      return;
+   }
+   memcpy(data + r.offset, &meta, sizeof(meta));
+   memcpy(data + r.offset + sizeof(meta), &region, sizeof(region));
+   D3D12_RANGE written = {(SIZE_T)r.offset, (SIZE_T)(r.offset + sizeof(meta) + sizeof(region))};
+   r.buffer->Unmap(0, &written);
+}
+
+static DWORD WINAPI
+video_queue_thread(void *param)
+{
+   viogpu_video_queue *queue = (viogpu_video_queue *)param;
+   for (;;) {
+      EnterCriticalSection(&queue->lock);
+      while (!queue->stop && queue->batches.empty())
+         SleepConditionVariableCS(&queue->wake, &queue->lock, INFINITE);
+      if (queue->batches.empty()) {
+         LeaveCriticalSection(&queue->lock);
+         return 0;
+      }
+      video_batch batch = std::move(queue->batches.front());
+      queue->batches.pop_front();
+      LeaveCriticalSection(&queue->lock);
+
+      queue->gpuDone->SetEventOnCompletion(batch.n, NULL);
+      for (const metadata_resolve &r : batch.resolves)
+         resolve(queue->device->video, r);
+      queue->done->Signal(batch.n);
+   }
+}
+
+viogpu_video_queue *
+viogpu_video_queue_create(viogpu_device *device, ID3D12Fence *gpuDone, ID3D12Fence *done)
+{
+   viogpu_video_queue *queue = new viogpu_video_queue();
+   queue->device = device;
+   queue->gpuDone = gpuDone;
+   queue->done = done;
+   InitializeCriticalSection(&queue->lock);
+   InitializeConditionVariable(&queue->wake);
+   if (!(queue->thread = CreateThread(NULL, 0, video_queue_thread, queue, 0, NULL))) {
+      DeleteCriticalSection(&queue->lock);
+      delete queue;
+      return NULL;
+   }
+   return queue;
+}
+
+void
+viogpu_video_queue_destroy(viogpu_video_queue *queue)
+{
+   EnterCriticalSection(&queue->lock);
+   queue->stop = true;
+   LeaveCriticalSection(&queue->lock);
+   WakeAllConditionVariable(&queue->wake);
+   WaitForSingleObject(queue->thread, INFINITE);
+   CloseHandle(queue->thread);
+   DeleteCriticalSection(&queue->lock);
+   delete queue;
+}
+
+void
+viogpu_video_queue_submitted(viogpu_video_queue *queue, UINT64 n, UINT count, const D3D12DDI_HCOMMANDLIST *lists)
+{
+   video_batch batch;
+   batch.n = n;
+   for (UINT i = 0; i < count; i++) {
+      viogpu_command_list *list = list_from(lists[i]);
+      if (list->video)
+         batch.resolves.insert(batch.resolves.end(), list->video->resolves.begin(), list->video->resolves.end());
+   }
+   EnterCriticalSection(&queue->lock);
+   queue->batches.push_back(std::move(batch));
+   LeaveCriticalSection(&queue->lock);
+   WakeAllConditionVariable(&queue->wake);
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Tables (umd_ddi.cpp puts logging stubs in every entry first) */
+
+HRESULT
+viogpu_fill_video_table(D3D12DDI_TABLE_TYPE type, void *table, SIZE_T size, D3D12DDI_HRTTABLE hRTTable)
+{
+   viogpu_log("video: FillDDITable type %d, %zu bytes", (int)type, size);
+   switch (type) {
+   case D3D12DDI_TABLE_TYPE_0020_DEVICE_VIDEO: {
+      if (size < sizeof(D3D12DDI_DEVICE_FUNCS_VIDEO_0082_0))
+         return E_INVALIDARG;
+      auto *f = (D3D12DDI_DEVICE_FUNCS_VIDEO_0082_0 *)table;
+      f->pfnGetCaps = video_get_caps;
+      f->pfnCalcPrivateVideoEncoderSize = calc_encoder_size;
+      f->pfnCreateVideoEncoder = create_encoder;
+      f->pfnDestroyVideoEncoder = destroy_encoder;
+      f->pfnCalcPrivateVideoEncoderHeapSize = calc_heap_size;
+      f->pfnCreateVideoEncoderHeap = create_heap;
+      f->pfnDestroyVideoEncoderHeap = destroy_heap;
+      return S_OK;
+   }
+   case D3D12DDI_TABLE_TYPE_0053_COMMAND_LIST_VIDEO_ENCODE: {
+      if (size < sizeof(D3D12DDI_COMMAND_LIST_FUNCS_VIDEO_ENCODE_0082_0))
+         return E_INVALIDARG;
+      viogpu_video_encode_rt_table = hRTTable;
+      auto *f = (D3D12DDI_COMMAND_LIST_FUNCS_VIDEO_ENCODE_0082_0 *)table;
+      /* the reset is the common one (umd_command.cpp: it takes the pool's encode-family allocator) */
+      viogpu_command_list_funcs common = {};
+      viogpu_fill_command_list_table(&common, sizeof(common), 2, hRTTable);
+      f->pfnCloseCommandList = video_close;
+      f->pfnResetCommandList = common.pfnResetCommandList;
+      f->pfnDiscardResource = video_discard;
+      f->pfnSetMarker = video_set_marker;
+      f->pfnSetPredication = video_set_predication;
+      f->pfnResourceBarrier = video_barrier;
+      f->pfnResolveEncoderOutputMetadata = resolve_metadata;
+      f->pfnEncodeFrame = encode_frame;
+      return S_OK;
+   }
+   case D3D12DDI_TABLE_TYPE_0053_COMMAND_QUEUE_VIDEO_ENCODE:
+   case D3D12DDI_TABLE_TYPE_0022_COMMAND_QUEUE_VIDEO_DECODE:
+   case D3D12DDI_TABLE_TYPE_0022_COMMAND_QUEUE_VIDEO_PROCESS: {
+      if (size < sizeof(D3D12DDI_COMMAND_QUEUE_FUNCS_VIDEO_0020))
+         return E_INVALIDARG;
+      /* the common queue functions (execute, tile mappings, fences) in the video table's order */
+      D3D12DDI_COMMAND_QUEUE_FUNCS_CORE_0001 common = {};
+      viogpu_fill_command_queue_table(&common, sizeof(common));
+      auto *f = (D3D12DDI_COMMAND_QUEUE_FUNCS_VIDEO_0020 *)table;
+      f->pfnExecuteCommandLists = common.pfnExecuteCommandLists;
+      f->pfnUpdateTileMappings = common.pfnUpdateTileMappings;
+      f->pfnCopyTileMappings = common.pfnCopyTileMappings;
+      f->pfnSignalFence = common.pfnSignalFence;
+      f->pfnWaitForFence = common.pfnWaitForFence;
+      return S_OK;
+   }
+   default:
+      return E_UNEXPECTED;
+   }
+}
