+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Root signatures: the runtime passes a deserialized 1.1 desc, laid out as the API's D3D12_ROOT_SIGNATURE_DESC1 */
+
+static_assert(sizeof(D3D12DDI_ROOT_SIGNATURE_0013) == sizeof(D3D12_ROOT_SIGNATURE_DESC1), "root signature desc");
+static_assert(sizeof(D3D12DDI_ROOT_PARAMETER_0013) == sizeof(D3D12_ROOT_PARAMETER1), "root parameter");
+static_assert(sizeof(D3D12DDI_DESCRIPTOR_RANGE_0013) == sizeof(D3D12_DESCRIPTOR_RANGE1), "descriptor range");
+static_assert(sizeof(D3D12DDI_STATIC_SAMPLER) == sizeof(D3D12_STATIC_SAMPLER_DESC), "static sampler");
+
+struct viogpu_root_signature {
+   ID3D12RootSignature *rs;
+};
+
+ID3D12RootSignature *
+viogpu_root_signature_of(D3D12DDI_HROOTSIGNATURE h)
+{
+   return h.pDrvPrivate ? ((viogpu_root_signature *)h.pDrvPrivate)->rs : NULL;
+}
+
+static SIZE_T APIENTRY
+calc_root_signature_size(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATE_ROOT_SIGNATURE_0013 *)
+{
+   return sizeof(viogpu_root_signature);
+}
+
+static HRESULT APIENTRY
+create_root_signature(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_ROOT_SIGNATURE_0013 *args,
+                      D3D12DDI_HROOTSIGNATURE h)
+{
+   viogpu_device *device = device_from(hDevice);
+   viogpu_root_signature *rs = new (h.pDrvPrivate) viogpu_root_signature();
+   D3D12_VERSIONED_ROOT_SIGNATURE_DESC desc = {};
+   desc.Version = D3D_ROOT_SIGNATURE_VERSION_1_1;
+   memcpy(&desc.Desc_1_1, args->pRootSignature_1_1, sizeof(desc.Desc_1_1));
+   ID3DBlob *blob = NULL;
+   HRESULT hr = viogpu_bridge_serialize_root_signature(&desc, (void **)&blob);
+   if (SUCCEEDED(hr)) {
+      hr = device->vkd3d->CreateRootSignature(args->NodeMask, blob->GetBufferPointer(), blob->GetBufferSize(),
+                                              IID_PPV_ARGS(&rs->rs));
+      blob->Release();
+   }
+   if (FAILED(hr))
+      viogpu_log("CreateRootSignature: 0x%08lx", (unsigned long)hr);
+   return hr;
+}
+
+static VOID APIENTRY
+destroy_root_signature(D3D12DDI_HDEVICE, D3D12DDI_HROOTSIGNATURE h)
+{
+   viogpu_root_signature *rs = (viogpu_root_signature *)h.pDrvPrivate;
+   if (rs->rs)
+      rs->rs->Release();
+   rs->~viogpu_root_signature();
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Pipeline states */
+
+struct viogpu_pipeline_state {
+   ID3D12PipelineState *pso;
+   D3D12DDI_HRTPIPELINESTATE hRT;
+};
+
+ID3D12PipelineState *
+viogpu_pipeline_state_of(D3D12DDI_HPIPELINESTATE h)
+{
+   return h.pDrvPrivate ? ((viogpu_pipeline_state *)h.pDrvPrivate)->pso : NULL;
+}
+
+static D3D12_SHADER_BYTECODE
+bytecode(D3D12DDI_HSHADER h)
+{
+   D3D12_SHADER_BYTECODE b = {};
+   viogpu_shader *shader = (viogpu_shader *)h.pDrvPrivate;
+   if (shader && !shader->container.empty()) {
+      b.pShaderBytecode = shader->container.data();
+      b.BytecodeLength = shader->container.size();
+   }
+   return b;
+}
+
+static SIZE_T APIENTRY
+calc_pipeline_state_size(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATE_PIPELINE_STATE_0075 *)
+{
+   return sizeof(viogpu_pipeline_state);
+}
+
+static HRESULT APIENTRY
+create_pipeline_state(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_PIPELINE_STATE_0075 *args,
+                      D3D12DDI_HPIPELINESTATE h, D3D12DDI_HRTPIPELINESTATE hRT)
+{
+   viogpu_device *device = device_from(hDevice);
+   viogpu_pipeline_state *pso = new (h.pDrvPrivate) viogpu_pipeline_state();
+   pso->hRT = hRT;
+   HRESULT hr;
+
+   if (args->hComputeShader.pDrvPrivate) {
+      D3D12_COMPUTE_PIPELINE_STATE_DESC desc = {};
+      desc.pRootSignature = viogpu_root_signature_of(args->hRootSignature);
+      desc.CS = bytecode(args->hComputeShader);
+      desc.NodeMask = args->NodeMask;
+      hr = device->vkd3d->CreateComputePipelineState(&desc, IID_PPV_ARGS(&pso->pso));
+   } else {
+      D3D12_GRAPHICS_PIPELINE_STATE_DESC desc = {};
+      desc.pRootSignature = viogpu_root_signature_of(args->hRootSignature);
+      desc.VS = bytecode(args->hVertexShader);
+      desc.PS = bytecode(args->hPixelShader);
+      desc.DS = bytecode(args->hDomainShader);
+      desc.HS = bytecode(args->hHullShader);
+      desc.GS = bytecode(args->hGeometryShader);
+      /* stream output: from the geometry shader's object, or the last stage's when there is none */
+      viogpu_shader *so = (viogpu_shader *)args->hGeometryShader.pDrvPrivate;
+      if (so && !so->soDecl.empty()) {
+         desc.StreamOutput.pSODeclaration = so->soDecl.data();
+         desc.StreamOutput.NumEntries = (UINT)so->soDecl.size();
+         desc.StreamOutput.pBufferStrides = so->soStrides.data();
+         desc.StreamOutput.NumStrides = (UINT)so->soStrides.size();
+         desc.StreamOutput.RasterizedStream = so->rasterizedStream;
+      }
+      if (args->hBlendState.pDrvPrivate)
+         desc.BlendState = *(const D3D12_BLEND_DESC *)args->hBlendState.pDrvPrivate;
+      desc.SampleMask = args->SampleMask;
+      if (args->hRasterizerState.pDrvPrivate)
+         desc.RasterizerState = *(const D3D12_RASTERIZER_DESC *)args->hRasterizerState.pDrvPrivate;
+      if (args->hDepthStencilState.pDrvPrivate) {
+         /* the plain desc has no depth bounds test; it's DESC1's prefix */
+         memcpy(&desc.DepthStencilState, args->hDepthStencilState.pDrvPrivate, sizeof(desc.DepthStencilState));
+      }
+      viogpu_element_layout *layout = (viogpu_element_layout *)args->hElementLayout.pDrvPrivate;
+      if (layout) {
+         desc.InputLayout.pInputElementDescs = layout->elements.data();
+         desc.InputLayout.NumElements = (UINT)layout->elements.size();
+      }
