diff --git a/libs/viogpu_umd/umd_state.cpp b/libs/viogpu_umd/umd_state.cpp
new file mode 100644
--- /dev/null
+++ b/libs/viogpu_umd/umd_state.cpp
@@ -0,0 +1,638 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/* Shaders, input layouts, blend/depth-stencil/rasterizer states, root signatures and pipeline states.
+ *
+ * The runtime hands shaders over as the bare program (the SM4/5 token stream, or the DXIL program part) with
+ * signatures that list registers and system values but no semantic names. vkd3d-proton wants DXBC containers and
+ * matches input layouts and stages by semantic: each shader gets a container with made-up names that are the same on
+ * both sides of every link (stages link by register): WBREG<register * 4 + first component> for plain varyings,
+ * WBATTR<register> for vertex inputs (input layouts use the same names), SV_Target<register> for pixel shader
+ * outputs, the usual SV_ names for system values. */
+
+#include "umd_private.h"
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* DXBC containers */
+
+enum viogpu_stage { STAGE_VS, STAGE_PS, STAGE_GS, STAGE_HS, STAGE_DS, STAGE_CS };
+
+struct viogpu_sig_entry {
+   D3D12DDIARG_SIGNATURE_ENTRY_0012 e;
+};
+
+struct viogpu_shader {
+   viogpu_stage stage;
+   std::vector<BYTE> container;
+   /* stream output (a geometry shader created with it, or the vertex/domain shader's, code-less) */
+   std::vector<D3D12_SO_DECLARATION_ENTRY> soDecl;
+   std::vector<UINT> soStrides;
+   UINT rasterizedStream;
+};
+
+static void
+put32(std::vector<BYTE> &v, UINT x)
+{
+   v.push_back(x & 0xff);
+   v.push_back((x >> 8) & 0xff);
+   v.push_back((x >> 16) & 0xff);
+   v.push_back((x >> 24) & 0xff);
+}
+
+static void
+set32(std::vector<BYTE> &v, size_t offset, UINT x)
+{
+   memcpy(&v[offset], &x, 4);
+}
+
+static UINT
+fourcc(const char *c)
+{
+   return (UINT)c[0] | ((UINT)c[1] << 8) | ((UINT)c[2] << 16) | ((UINT)c[3] << 24);
+}
+
+static UINT
+first_component(BYTE mask)
+{
+   for (UINT i = 0; i < 4; i++)
+      if (mask & (1 << i))
+         return i;
+   return 0;
+}
+
+/* The semantic of a signature entry: name, index and D3D_NAME. Clip/cull distances count up per signature. */
+static void
+entry_semantic(const D3D12DDIARG_SIGNATURE_ENTRY_0012 &e, viogpu_stage stage, bool input, bool patchConstant,
+               UINT clipCount, UINT cullCount, const char **name, UINT *index, UINT *sysval)
+{
+   *index = 0;
+   *sysval = D3D_NAME_UNDEFINED;
+   switch ((UINT)e.SystemValue) {
+   case D3D10_SB_NAME_UNDEFINED:
+      if (stage == STAGE_PS && !input) {
+         *name = "SV_Target";
+         *index = e.Register;
+         *sysval = D3D_NAME_TARGET;
+      } else if (stage == STAGE_VS && input) {
+         *name = "WBATTR";
+         *index = e.Register;
+      } else {
+         *name = patchConstant ? "WBPATCH" : "WBREG";
+         *index = e.Register * 4 + first_component(e.Mask);
+      }
+      return;
+   case D3D10_SB_NAME_POSITION: *name = "SV_Position"; *sysval = D3D_NAME_POSITION; return;
+   case D3D10_SB_NAME_CLIP_DISTANCE: *name = "SV_ClipDistance"; *index = clipCount; *sysval = D3D_NAME_CLIP_DISTANCE; return;
+   case D3D10_SB_NAME_CULL_DISTANCE: *name = "SV_CullDistance"; *index = cullCount; *sysval = D3D_NAME_CULL_DISTANCE; return;
+   case D3D10_SB_NAME_RENDER_TARGET_ARRAY_INDEX:
+      *name = "SV_RenderTargetArrayIndex"; *sysval = D3D_NAME_RENDER_TARGET_ARRAY_INDEX; return;
+   case D3D10_SB_NAME_VIEWPORT_ARRAY_INDEX:
+      *name = "SV_ViewportArrayIndex"; *sysval = D3D_NAME_VIEWPORT_ARRAY_INDEX; return;
+   case D3D10_SB_NAME_VERTEX_ID: *name = "SV_VertexID"; *sysval = D3D_NAME_VERTEX_ID; return;
+   case D3D10_SB_NAME_PRIMITIVE_ID: *name = "SV_PrimitiveID"; *sysval = D3D_NAME_PRIMITIVE_ID; return;
+   case D3D10_SB_NAME_INSTANCE_ID: *name = "SV_InstanceID"; *sysval = D3D_NAME_INSTANCE_ID; return;
+   case D3D10_SB_NAME_IS_FRONT_FACE: *name = "SV_IsFrontFace"; *sysval = D3D_NAME_IS_FRONT_FACE; return;
+   case D3D10_SB_NAME_SAMPLE_INDEX: *name = "SV_SampleIndex"; *sysval = D3D_NAME_SAMPLE_INDEX; return;
+   /* the token stream has one name per tessellation factor, signatures one per kind with an index */
+   case D3D11_SB_NAME_FINAL_QUAD_U_EQ_0_EDGE_TESSFACTOR:
+   case D3D11_SB_NAME_FINAL_QUAD_V_EQ_0_EDGE_TESSFACTOR:
+   case D3D11_SB_NAME_FINAL_QUAD_U_EQ_1_EDGE_TESSFACTOR:
+   case D3D11_SB_NAME_FINAL_QUAD_V_EQ_1_EDGE_TESSFACTOR:
+      *name = "SV_TessFactor";
+      *index = (UINT)e.SystemValue - D3D11_SB_NAME_FINAL_QUAD_U_EQ_0_EDGE_TESSFACTOR;
+      *sysval = D3D_NAME_FINAL_QUAD_EDGE_TESSFACTOR;
+      return;
+   case D3D11_SB_NAME_FINAL_QUAD_U_INSIDE_TESSFACTOR:
+   case D3D11_SB_NAME_FINAL_QUAD_V_INSIDE_TESSFACTOR:
+      *name = "SV_InsideTessFactor";
+      *index = (UINT)e.SystemValue - D3D11_SB_NAME_FINAL_QUAD_U_INSIDE_TESSFACTOR;
+      *sysval = D3D_NAME_FINAL_QUAD_INSIDE_TESSFACTOR;
+      return;
+   case D3D11_SB_NAME_FINAL_TRI_U_EQ_0_EDGE_TESSFACTOR:
+   case D3D11_SB_NAME_FINAL_TRI_V_EQ_0_EDGE_TESSFACTOR:
+   case D3D11_SB_NAME_FINAL_TRI_W_EQ_0_EDGE_TESSFACTOR:
+      *name = "SV_TessFactor";
+      *index = (UINT)e.SystemValue - D3D11_SB_NAME_FINAL_TRI_U_EQ_0_EDGE_TESSFACTOR;
+      *sysval = D3D_NAME_FINAL_TRI_EDGE_TESSFACTOR;
+      return;
+   case D3D11_SB_NAME_FINAL_TRI_INSIDE_TESSFACTOR:
+      *name = "SV_InsideTessFactor"; *sysval = D3D_NAME_FINAL_TRI_INSIDE_TESSFACTOR; return;
+   case D3D11_SB_NAME_FINAL_LINE_DETAIL_TESSFACTOR:
+      *name = "SV_TessFactor"; *index = 1; *sysval = D3D_NAME_FINAL_LINE_DETAIL_TESSFACTOR; return;
+   case D3D11_SB_NAME_FINAL_LINE_DENSITY_TESSFACTOR:
+      *name = "SV_TessFactor"; *sysval = D3D_NAME_FINAL_LINE_DENSITY_TESSFACTOR; return;
+   default:
+      viogpu_log("signature: unknown system value %u", (UINT)e.SystemValue);
+      *name = "WBREG";
+      *index = e.Register * 4 + first_component(e.Mask);
+      return;
+   }
+}
+
+/* A signature chunk: ISGN/OSGN/PCSG (24-byte entries), OSG5 (28: stream first) or ISG1/OSG1/PSG1 (32: stream, then
+ * the minimum precision at the end) */
+static std::vector<BYTE>
+signature_chunk(const D3D12DDIARG_SIGNATURE_ENTRY_0012 *entries, UINT count, viogpu_stage stage, bool input,
+                bool patchConstant, const char **tag)
+{
+   bool minPrecision = false, streams = false;
+   for (UINT i = 0; i < count; i++) {
+      minPrecision |= entries[i].MinPrecision != D3D11_SB_OPERAND_MIN_PRECISION_DEFAULT;
+      streams |= entries[i].Stream != 0;
+   }
+   UINT entrySize;
+   if (minPrecision) {
+      *tag = patchConstant ? "PSG1" : input ? "ISG1" : "OSG1";
+      entrySize = 32;
+   } else if (streams && !input) {
+      *tag = "OSG5";
+      entrySize = 28;
+   } else {
+      *tag = patchConstant ? "PCSG" : input ? "ISGN" : "OSGN";
+      entrySize = 24;
+   }
+
+   std::vector<BYTE> chunk;
+   put32(chunk, count);
+   put32(chunk, 8);
+   std::vector<std::pair<size_t, std::string>> names;
+   UINT clipCount = 0, cullCount = 0;
+   for (UINT i = 0; i < count; i++) {
+      const D3D12DDIARG_SIGNATURE_ENTRY_0012 &e = entries[i];
+      const char *name;
+      UINT index, sysval;
+      entry_semantic(e, stage, input, patchConstant, clipCount, cullCount, &name, &index, &sysval);
+      clipCount += e.SystemValue == D3D10_SB_NAME_CLIP_DISTANCE;
+      cullCount += e.SystemValue == D3D10_SB_NAME_CULL_DISTANCE;
+      if (entrySize != 24)
+         put32(chunk, e.Stream);
+      names.push_back({chunk.size(), name});
+      put32(chunk, 0); /* name offset, below */
+      put32(chunk, index);
+      put32(chunk, sysval);
+      put32(chunk, (UINT)e.RegisterComponentType);
+      put32(chunk, e.Register);
+      chunk.push_back(e.Mask);
+      /* inputs: the components read; outputs: the ones never written */
+      chunk.push_back(input ? e.Mask : 0);
+      chunk.push_back(0);
+      chunk.push_back(0);
+      if (entrySize == 32)
+         put32(chunk, (UINT)e.MinPrecision);
+   }
+   for (auto &n : names) {
+      set32(chunk, n.first, (UINT)chunk.size());
+      chunk.insert(chunk.end(), n.second.begin(), n.second.end());
+      chunk.push_back(0);
+   }
+   while (chunk.size() & 3)
+      chunk.push_back(0xab);
+   return chunk;
+}
+
+static std::vector<BYTE>
+build_container(const std::vector<std::pair<const char *, std::vector<BYTE>>> &chunks)
+{
+   std::vector<BYTE> c;
+   put32(c, fourcc("DXBC"));
+   for (int i = 0; i < 4; i++)
+      put32(c, 0); /* checksum: vkd3d-proton doesn't check it */
+   put32(c, 1);
+   size_t sizeAt = c.size();
+   put32(c, 0);
+   put32(c, (UINT)chunks.size());
+   size_t offsetsAt = c.size();
+   for (size_t i = 0; i < chunks.size(); i++)
+      put32(c, 0);
+   for (size_t i = 0; i < chunks.size(); i++) {
+      set32(c, offsetsAt + i * 4, (UINT)c.size());
+      put32(c, fourcc(chunks[i].first));
+      put32(c, (UINT)chunks[i].second.size());
+      c.insert(c.end(), chunks[i].second.begin(), chunks[i].second.end());
+   }
+   set32(c, sizeAt, (UINT)c.size());
+   return c;
+}
+
+static void
+shader_build(viogpu_shader *shader, viogpu_stage stage, const D3D12DDIARG_CREATE_SHADER_0026 *args)
+{
+   shader->stage = stage;
+   shader->rasterizedStream = 0;
+   const UINT *code = args->pShaderCode;
+   if (!code)
+      return;
+
+   std::vector<std::pair<const char *, std::vector<BYTE>>> chunks;
+   const char *tag;
+   if (stage == STAGE_HS || stage == STAGE_DS) {
+      const D3D12DDIARG_TESSELLATION_IO_SIGNATURES *sig = args->IOSignatures.Tessellation;
+      if (sig) {
+         std::vector<BYTE> in = signature_chunk(sig->pInputSignature, sig->NumInputSignatureEntries, stage, true,
+                                                false, &tag);
+         chunks.push_back({tag, in});
+         std::vector<BYTE> out = signature_chunk(sig->pOutputSignature, sig->NumOutputSignatureEntries, stage, false,
+                                                 false, &tag);
+         chunks.push_back({tag, out});
+         std::vector<BYTE> patch = signature_chunk(sig->pPatchConstantSignature,
+                                                   sig->NumPatchConstantSignatureEntries, stage,
+                                                   stage == STAGE_DS, true, &tag);
+         chunks.push_back({tag, patch});
+      }
+   } else {
+      const D3D12DDIARG_STAGE_IO_SIGNATURES *sig = args->IOSignatures.Standard;
+      if (sig) {
+         std::vector<BYTE> in = signature_chunk(sig->pInputSignature, sig->NumInputSignatureEntries, stage, true,
+                                                false, &tag);
+         chunks.push_back({tag, in});
+         std::vector<BYTE> out = signature_chunk(sig->pOutputSignature, sig->NumOutputSignatureEntries, stage, false,
+                                                 false, &tag);
+         chunks.push_back({tag, out});
+      }
+   }
+
+   /* The program: a DXBC container already (then as is), the SM4/5 token stream, or the DXIL program part */
+   if (code[0] == fourcc("DXBC")) {
+      const BYTE *bytes = (const BYTE *)code;
+      shader->container.assign(bytes, bytes + code[6]);
+      return;
+   }
+   UINT major = (code[0] >> 4) & 0xf;
+   std::vector<BYTE> program((const BYTE *)code, (const BYTE *)(code + code[1]));
+   chunks.push_back({major >= 6 ? "DXIL" : major == 5 ? "SHEX" : "SHDR", program});
+   shader->container = build_container(chunks);
+}
