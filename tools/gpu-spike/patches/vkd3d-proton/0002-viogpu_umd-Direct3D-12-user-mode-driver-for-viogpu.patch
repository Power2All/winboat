+static bool
+resource_is_array(const viogpu_resource *res)
+{
+   return res && res->desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE3D && res->desc.DepthOrArraySize > 1;
+}
+
+static bool
+resource_is_ms(const viogpu_resource *res)
+{
+   return res && res->desc.SampleDesc.Count > 1;
+}
+
+static VOID APIENTRY
+create_srv(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_SHADER_RESOURCE_VIEW_0002 *args,
+           D3D12DDI_CPU_DESCRIPTOR_HANDLE dest)
+{
+   viogpu_resource *res = (viogpu_resource *)args->hDrvResource.pDrvPrivate;
+   D3D12_SHADER_RESOURCE_VIEW_DESC d = {};
+   d.Format = args->Format;
+   d.Shader4ComponentMapping = args->Shader4ComponentMapping;
+   bool array = resource_is_array(res);
+   switch (args->ResourceDimension) {
+   case D3D12DDI_RD_BUFFER:
+      d.ViewDimension = D3D12_SRV_DIMENSION_BUFFER;
+      d.Buffer.FirstElement = args->Buffer.FirstElement;
+      d.Buffer.NumElements = args->Buffer.NumElements;
+      d.Buffer.StructureByteStride = args->Buffer.StructureByteStride;
+      d.Buffer.Flags = (D3D12_BUFFER_SRV_FLAGS)args->Buffer.Flags;
+      break;
+   case D3D12DDI_RD_TEXTURE1D:
+      if (array) {
+         d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE1DARRAY;
+         d.Texture1DArray.MostDetailedMip = args->Tex1D.MostDetailedMip;
+         d.Texture1DArray.MipLevels = args->Tex1D.MipLevels;
+         d.Texture1DArray.FirstArraySlice = args->Tex1D.FirstArraySlice;
+         d.Texture1DArray.ArraySize = args->Tex1D.ArraySize;
+         d.Texture1DArray.ResourceMinLODClamp = args->Tex1D.ResourceMinLODClamp;
+      } else {
+         d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE1D;
+         d.Texture1D.MostDetailedMip = args->Tex1D.MostDetailedMip;
+         d.Texture1D.MipLevels = args->Tex1D.MipLevels;
+         d.Texture1D.ResourceMinLODClamp = args->Tex1D.ResourceMinLODClamp;
+      }
+      break;
+   case D3D12DDI_RD_TEXTURE2D:
+      if (resource_is_ms(res)) {
+         if (array) {
+            d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DMSARRAY;
+            d.Texture2DMSArray.FirstArraySlice = args->Tex2D.FirstArraySlice;
+            d.Texture2DMSArray.ArraySize = args->Tex2D.ArraySize;
+         } else {
+            d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DMS;
+         }
+      } else if (array) {
+         d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DARRAY;
+         d.Texture2DArray.MostDetailedMip = args->Tex2D.MostDetailedMip;
+         d.Texture2DArray.MipLevels = args->Tex2D.MipLevels;
+         d.Texture2DArray.FirstArraySlice = args->Tex2D.FirstArraySlice;
+         d.Texture2DArray.ArraySize = args->Tex2D.ArraySize;
+         d.Texture2DArray.PlaneSlice = args->Tex2D.PlaneSlice;
+         d.Texture2DArray.ResourceMinLODClamp = args->Tex2D.ResourceMinLODClamp;
+      } else {
+         d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+         d.Texture2D.MostDetailedMip = args->Tex2D.MostDetailedMip;
+         d.Texture2D.MipLevels = args->Tex2D.MipLevels;
+         d.Texture2D.PlaneSlice = args->Tex2D.PlaneSlice;
+         d.Texture2D.ResourceMinLODClamp = args->Tex2D.ResourceMinLODClamp;
+      }
+      break;
+   case D3D12DDI_RD_TEXTURE3D:
+      d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE3D;
+      d.Texture3D.MostDetailedMip = args->Tex3D.MostDetailedMip;
+      d.Texture3D.MipLevels = args->Tex3D.MipLevels;
+      d.Texture3D.ResourceMinLODClamp = args->Tex3D.ResourceMinLODClamp;
+      break;
+   case D3D12DDI_RD_TEXTURECUBE:
+      if (res && res->desc.DepthOrArraySize > 6) {
+         d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURECUBEARRAY;
+         d.TextureCubeArray.MostDetailedMip = args->TexCube.MostDetailedMip;
+         d.TextureCubeArray.MipLevels = args->TexCube.MipLevels;
+         d.TextureCubeArray.First2DArrayFace = args->TexCube.First2DArrayFace;
+         d.TextureCubeArray.NumCubes = args->TexCube.NumCubes;
+         d.TextureCubeArray.ResourceMinLODClamp = args->TexCube.ResourceMinLODClamp;
+      } else {
+         d.ViewDimension = D3D12_SRV_DIMENSION_TEXTURECUBE;
+         d.TextureCube.MostDetailedMip = args->TexCube.MostDetailedMip;
+         d.TextureCube.MipLevels = args->TexCube.MipLevels;
+         d.TextureCube.ResourceMinLODClamp = args->TexCube.ResourceMinLODClamp;
+      }
+      break;
+   case D3D12DDI_RD_RAYTRACING_ACCELERATION_STRUCTURE_0042:
+      d.ViewDimension = D3D12_SRV_DIMENSION_RAYTRACING_ACCELERATION_STRUCTURE;
+      d.RaytracingAccelerationStructure.Location = args->RaytracingAccelerationStructure.Location;
+      break;
+   }
+   device_from(hDevice)->vkd3d->CreateShaderResourceView(res ? res->resource : NULL, &d, cpu_handle(dest));
+}
