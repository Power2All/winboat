+static void
+allocation_info(viogpu_device *device, const D3D12_RESOURCE_DESC &desc, UINT visibleNodeMask,
+                D3D12DDI_RESOURCE_ALLOCATION_INFO_0022 *info)
+{
+   D3D12_RESOURCE_ALLOCATION_INFO a = device->vkd3d->GetResourceAllocationInfo(visibleNodeMask, 1, &desc);
+   memset(info, 0, sizeof(*info));
+   info->ResourceDataSize = a.SizeInBytes;
+   info->ResourceDataAlignment = (UINT32)a.Alignment;
+   info->AdditionalDataHeaderAlignment = 1;
+   info->AdditionalDataAlignment = 1;
+   info->Layout = desc.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER ? D3D12DDI_TL_ROW_MAJOR
+                                                                    : (D3D12DDI_TEXTURE_LAYOUT)desc.Layout;
+}
+
+static VOID APIENTRY
+check_resource_allocation_info(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATERESOURCE_0075 *resDesc,
+                               D3D12DDI_RESOURCE_OPTIMIZATION_FLAGS, UINT32 alignmentRestriction,
+                               UINT visibleNodeMask, D3D12DDI_RESOURCE_ALLOCATION_INFO_0022 *info)
+{
+   D3D12_RESOURCE_DESC desc = resource_desc(resDesc);
+   desc.Alignment = alignmentRestriction;
+   allocation_info(device_from(hDevice), desc, visibleNodeMask, info);
+}
+
+static VOID APIENTRY
+check_existing_resource_allocation_info(D3D12DDI_HDEVICE hDevice, D3D12DDI_HRESOURCE hResource,
+                                        D3D12DDI_RESOURCE_ALLOCATION_INFO_0022 *info)
+{
+   viogpu_resource *res = (viogpu_resource *)hResource.pDrvPrivate;
+   allocation_info(device_from(hDevice), res->desc, 0, info);
+}
+
+/* Where a subresource is in the mapped heap memory (Map, WriteToSubresource): a buffer is its own bytes, a texture
+ * the CPU can map is laid out as its copy footprints */
+static VOID APIENTRY
+check_subresource_info(D3D12DDI_HDEVICE hDevice, D3D12DDI_HRESOURCE hResource, UINT subresource,
+                       D3D12DDI_SUBRESOURCE_INFO *info)
+{
+   viogpu_resource *res = (viogpu_resource *)hResource.pDrvPrivate;
+   memset(info, 0, sizeof(*info));
+   if (res->desc.Dimension == D3D12_RESOURCE_DIMENSION_BUFFER) {
+      info->RowStride = res->desc.Width;
+      info->DepthStride = res->desc.Width;
+      return;
+   }
+   D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint = {};
+   UINT rows = 0;
+   UINT64 rowSize = 0, total = 0;
+   device_from(hDevice)->vkd3d->GetCopyableFootprints(&res->desc, subresource, 1, 0, &footprint, &rows, &rowSize,
+                                                     &total);
+   info->Offset = footprint.Offset;
+   info->RowStride = footprint.Footprint.RowPitch;
+   info->DepthStride = (UINT64)footprint.Footprint.RowPitch * rows;
+}
