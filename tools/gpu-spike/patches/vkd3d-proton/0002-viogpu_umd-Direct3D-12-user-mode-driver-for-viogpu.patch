+static HRESULT APIENTRY
+create_command_signature(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_COMMAND_SIGNATURE_0001 *args,
+                         D3D12DDI_HCOMMANDSIGNATURE h)
+{
+   static_assert(sizeof(D3D12DDI_INDIRECT_ARGUMENT_DESC) == sizeof(D3D12_INDIRECT_ARGUMENT_DESC), "argument desc");
+   viogpu_command_signature *sig = new (h.pDrvPrivate) viogpu_command_signature();
+   D3D12_COMMAND_SIGNATURE_DESC desc = {};
+   desc.ByteStride = args->ByteStride;
+   desc.NumArgumentDescs = args->NumArgumentDescs;
+   desc.pArgumentDescs = (const D3D12_INDIRECT_ARGUMENT_DESC *)args->pArgumentDescs;
+   desc.NodeMask = args->NodeMask;
+   HRESULT hr = device_from(hDevice)->vkd3d->CreateCommandSignature(
+      &desc, viogpu_root_signature_of(args->hRootSignature), IID_PPV_ARGS(&sig->signature));
+   if (FAILED(hr))
+      viogpu_log("CreateCommandSignature: 0x%08lx", (unsigned long)hr);
+   return hr;
+}
