+
+void
+viogpu_fill_command_funcs(viogpu_device_funcs *f)
+{
+   f->pfnCalcPrivateCommandQueueSize = calc_command_queue_size;
+   f->pfnCreateCommandQueue = create_command_queue;
+   f->pfnDestroyCommandQueue = destroy_command_queue;
+   f->pfnCalcPrivateCommandPoolSize = calc_command_pool_size;
+   f->pfnCreateCommandPool = create_command_pool;
+   f->pfnDestroyCommandPool = destroy_command_pool;
+   f->pfnResetCommandPool = reset_command_pool;
+   f->pfnCalcPrivateCommandListSize = calc_command_list_size;
+   f->pfnCreateCommandList = create_command_list;
+   f->pfnDestroyCommandList = destroy_command_list;
+   f->pfnCalcPrivateFenceSize = calc_fence_size;
+   f->pfnCreateFence = create_fence;
+   f->pfnDestroyFence = destroy_fence;
+   f->pfnCalcPrivateCommandRecorderSize = calc_command_recorder_size;
+   f->pfnCreateCommandRecorder = create_command_recorder;
+   f->pfnDestroyCommandRecorder = destroy_command_recorder;
+   f->pfnCommandRecorderSetCommandPoolAsTarget = recorder_set_pool;
+}
