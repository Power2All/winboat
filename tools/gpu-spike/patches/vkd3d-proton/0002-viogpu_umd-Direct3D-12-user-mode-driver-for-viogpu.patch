+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Presents: the runtime presents a swap chain buffer's kernel allocation (DWM composes it). The image is
+ * vkd3d-proton's (Venus): copy it there first, through a readback buffer and the CPU */
+
+static bool
+present_init(viogpu_device *device)
+{
+   if (device->presentFence)
+      return true;
+   HRESULT hr;
+   D3D12_COMMAND_QUEUE_DESC desc = {};
+   desc.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+   hr = device->vkd3d->CreateCommandQueue(&desc, IID_PPV_ARGS(&device->presentQueue));
+   if (SUCCEEDED(hr))
+      hr = device->vkd3d->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                                 IID_PPV_ARGS(&device->presentAllocator));
+   if (SUCCEEDED(hr))
+      hr = device->vkd3d->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, device->presentAllocator, NULL,
+                                            IID_PPV_ARGS(&device->presentList));
+   if (SUCCEEDED(hr))
+      hr = device->presentList->Close();
+   if (SUCCEEDED(hr))
+      hr = device->vkd3d->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&device->presentFence));
+   if (FAILED(hr)) {
+      viogpu_log("present setup: 0x%08lx", (unsigned long)hr);
+      return false;
+   }
+   return true;
+}
+
+void
+viogpu_present_destroy(viogpu_device *device)
+{
+   if (device->presentFence)
+      device->presentFence->Release();
+   if (device->presentList)
+      device->presentList->Release();
+   if (device->presentAllocator)
+      device->presentAllocator->Release();
+   if (device->presentQueue)
+      device->presentQueue->Release();
+}
+
+static void queue_wait_idle(viogpu_command_queue *queue);
+
+static void
+present_copy(viogpu_device *device, viogpu_resource *res)
+{
+   EnterCriticalSection(&device->presentLock);
+   if (!present_init(device)) {
+      LeaveCriticalSection(&device->presentLock);
+      return;
+   }
+
+   D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint = {};
+   UINT rows = 0;
+   UINT64 rowSize = 0, total = 0;
+   device->vkd3d->GetCopyableFootprints(&res->desc, 0, 1, 0, &footprint, &rows, &rowSize, &total);
+   HRESULT hr = S_OK;
+   if (!res->readback) {
+      D3D12_HEAP_PROPERTIES props = {};
+      props.Type = D3D12_HEAP_TYPE_READBACK;
+      D3D12_RESOURCE_DESC bd = {};
+      bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+      bd.Width = total;
+      bd.Height = 1;
+      bd.DepthOrArraySize = 1;
+      bd.MipLevels = 1;
+      bd.SampleDesc.Count = 1;
+      bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+      hr = device->vkd3d->CreateCommittedResource(&props, D3D12_HEAP_FLAG_NONE, &bd, D3D12_RESOURCE_STATE_COPY_DEST,
+                                                   NULL, IID_PPV_ARGS(&res->readback));
+   }
+
+   /* the buffer is in the PRESENT (common) state: a copy promotes it */
+   if (SUCCEEDED(hr))
+      hr = device->presentAllocator->Reset();
+   if (SUCCEEDED(hr))
+      hr = device->presentList->Reset(device->presentAllocator, NULL);
+   if (SUCCEEDED(hr)) {
+      D3D12_TEXTURE_COPY_LOCATION dst = {}, src = {};
+      dst.pResource = res->readback;
+      dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+      dst.PlacedFootprint = footprint;
+      src.pResource = res->resource;
+      src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+      src.SubresourceIndex = 0;
+      device->presentList->CopyTextureRegion(&dst, 0, 0, 0, &src, NULL);
+      hr = device->presentList->Close();
+   }
+   if (SUCCEEDED(hr)) {
+      ID3D12CommandList *list = device->presentList;
+      device->presentQueue->ExecuteCommandLists(1, &list);
+      hr = device->presentQueue->Signal(device->presentFence, ++device->presentFenceValue);
+   }
+   if (SUCCEEDED(hr))
+      hr = device->presentFence->SetEventOnCompletion(device->presentFenceValue, NULL);
+
+   void *pixels = NULL;
+   if (SUCCEEDED(hr))
+      hr = res->readback->Map(0, NULL, &pixels);
+   if (SUCCEEDED(hr)) {
+      D3DDDICB_LOCK2 lock = {};
+      lock.hAllocation = res->kmAllocation;
+      hr = device->ktCallbacks->pfnLock2Cb(device->hRTDevice.handle, &lock);
+      if (SUCCEEDED(hr)) {
+         UINT bytes = (UINT)(rowSize < res->kmPitch ? rowSize : res->kmPitch);
+         for (UINT y = 0; y < rows; y++)
+            memcpy((BYTE *)lock.pData + (SIZE_T)y * res->kmPitch,
+                   (const BYTE *)pixels + footprint.Offset + (SIZE_T)y * footprint.Footprint.RowPitch, bytes);
+         D3DDDICB_UNLOCK2 unlock = {};
+         unlock.hAllocation = res->kmAllocation;
+         device->ktCallbacks->pfnUnlock2Cb(device->hRTDevice.handle, &unlock);
+      }
+      D3D12_RANGE none = {0, 0};
+      res->readback->Unmap(0, &none);
+   }
+   if (FAILED(hr))
+      viogpu_log("present copy: 0x%08lx", (unsigned long)hr);
+   LeaveCriticalSection(&device->presentLock);
+}
+
+static VOID APIENTRY
+present(D3D12DDI_HCOMMANDLIST, D3D12DDI_HCOMMANDQUEUE hQueue, const D3D12DDIARG_PRESENT_0001 *args,
+        D3D12DDI_PRESENT_0051 *out, D3D12DDI_PRESENT_CONTEXTS_0051 *contexts, D3D12DDI_PRESENT_HWQUEUES_0051 *hwQueues)
+{
+   struct viogpu_command_queue *queue = (struct viogpu_command_queue *)hQueue.pDrvPrivate;
+   viogpu_device *device = queue->device;
+   memset(out, 0, sizeof(*out));
+   viogpu_resource *src =
+      args->SurfacesToPresent ? (viogpu_resource *)args->phSurfacesToPresent[0].hSurface.pDrvPrivate : NULL;
+   viogpu_resource *dst = (viogpu_resource *)args->hDstResource.pDrvPrivate;
+   if (src && src->kmAllocation) {
+      queue_wait_idle(queue);
+      present_copy(device, src);
+   }
+   static LONG logged;
+   if (InterlockedIncrement(&logged) <= 4)
+      viogpu_log("Present: %u surfaces, source allocation 0x%x, destination 0x%x, flags 0x%x", args->SurfacesToPresent,
+                 src ? src->kmAllocation : 0, dst ? dst->kmAllocation : 0, args->Flags.Value);
+   out->BroadcastSrcAllocation[0] = src ? src->kmAllocation : 0;
+   out->BroadcastDstAllocation[0] = dst ? dst->kmAllocation : 0;
+   out->AddedGpuWork = FALSE;
+   out->BackBufferMultiplicity = 1;
+   if (contexts) {
+      memset(contexts, 0, sizeof(*contexts));
+      /* the context, and no others to broadcast to (the context itself among them is refused) */
+      contexts->hContext = queue->hContext;
+      contexts->BroadcastContextCount = 0;
+   }
+   if (hwQueues)
+      memset(hwQueues, 0, sizeof(*hwQueues));
+}
