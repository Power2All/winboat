diff --git a/libs/viogpu_umd/gen_tables.py b/libs/viogpu_umd/gen_tables.py
new file mode 100644
--- /dev/null
+++ b/libs/viogpu_umd/gen_tables.py
@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+# Generates umd_tables.h: the entries of the D3D12 DDI tables viogpu_d3d12 fills, in order, for the logging stubs
+# (every entry the driver doesn't implement yet says which one the runtime called): their names, and an X-macro
+# over the members (the stubs take each member's own type, so that __stdcall pops the right arguments on x86)
+import re, sys
+h12, hdxgi, out = sys.argv[1:4]
+tables = [
+    ("DEVICE", h12, "D3D12DDI_DEVICE_FUNCS_CORE_0080"),
+    ("COMMAND_LIST", h12, "D3D12DDI_COMMAND_LIST_FUNCS_3D_0074"),
+    ("COMMAND_QUEUE", h12, "D3D12DDI_COMMAND_QUEUE_FUNCS_CORE_0001"),
+    ("DXGI", hdxgi, "DXGI1_4_DDI_BASE_FUNCTIONS"),
+    ("EXTENDED_FEATURES", h12, "D3D12DDI_EXTENDED_FEATURES_FUNCS_0020"),
+]
+lines = ["/* Generated by gen_tables.py from the WDK's d3d12umddi.h and dxgiddi.h: do not edit */", "#pragma once", ""]
+for tag, path, struct in tables:
+    text = open(path, encoding="utf-8", errors="replace").read()
+    m = re.search(r"typedef struct " + struct + r"\s*\{(.*?)\}\s*" + struct + ";", text, re.S)
+    body = re.sub(r"//[^\n]*|/\*.*?\*/", "", m.group(1), flags=re.S)
+    names = []
+    for decl in body.split(";"):
+        decl = decl.strip()
+        if not decl:
+            continue
+        fn = re.search(r"\*\s*(\w+)\s*\)", decl)   # function pointer declared inline: HRESULT (__stdcall * pfnX)(...)
+        names.append(fn.group(1) if fn else decl.split()[-1])
+    lines.append("#define VIOGPU_D3D12_%s_ENTRIES %d /* %s */" % (tag, len(names), struct))
+    lines.append("static const char *const viogpu_d3d12_%s_names[] = {" % tag.lower())
+    lines += ['   "%s",' % n for n in names]
+    lines += ["};", ""]
+    lines.append("#define VIOGPU_D3D12_%s_MEMBERS(X) \\" % tag)
+    lines += ["   X(%d, %s) \\" % (i, n) for i, n in enumerate(names)]
+    lines.append("")
+open(out, "w").write("\n".join(lines))
diff --git a/libs/viogpu_umd/meson.build b/libs/viogpu_umd/meson.build
new file mode 100644
--- /dev/null
+++ b/libs/viogpu_umd/meson.build
@@ -0,0 +1,15 @@
+# viogpu's Direct3D 12 user-mode driver (Windows, x64 and x86): the D3D12 DDI on vkd3d-proton. The runtime loads it as the
+# fourth name of the viogpu3d kernel driver's UserModeDriverName and calls OpenAdapter12.
+# umd_tables.h comes from the WDK's headers: gen_tables.py.
+
+# The bridge builds with vkd3d-proton's own headers, umd_ddi.cpp with the Windows SDK's and WDK's
+viogpu_umd_bridge = static_library('viogpu_umd_bridge', 'umd_bridge.c',
+  dependencies        : [ vkd3d_dep ],
+  include_directories : vkd3d_private_includes)
+
+viogpu_umd_lib = shared_library(get_option('viogpu_umd_name'), ['umd_ddi.cpp', 'umd_state.cpp', 'umd_resource.cpp', 'umd_command.cpp'],
+  name_prefix         : '',
+  link_with           : [ viogpu_umd_bridge ],
+  dependencies        : [ vkd3d_dep ],
+  vs_module_defs      : 'viogpu_umd.def',
+  install             : true)
diff --git a/libs/viogpu_umd/umd_bridge.c b/libs/viogpu_umd/umd_bridge.c
new file mode 100644
--- /dev/null
+++ b/libs/viogpu_umd/umd_bridge.c
@@ -0,0 +1,102 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+#define VK_NO_PROTOTYPES
+
+#include <string.h>
+#include <wchar.h>
+#include "vkd3d_win32.h"
+#include "vkd3d.h"
+#include "vkd3d_debug.h"
+#include "umd_bridge.h"
+
+/* The package's own Vulkan driver (Venus, viogpu_vk[_x86].dll next to this DLL), used directly instead of through
+ * the Vulkan loader: the loader would also load other installed drivers and layers into every D3D12 program. One of
+ * them, Dozen (Vulkan on D3D12, from Microsoft's OpenCL, OpenGL and Vulkan Compatibility Pack), calls back into the
+ * D3D12 runtime, which deadlocks inside D3D12CreateDevice. The loader is the fallback. */
+static PFN_vkGetInstanceProcAddr bridge_get_instance_proc_addr(void)
+{
+    static PFN_vkGetInstanceProcAddr proc;
+    WCHAR path[MAX_PATH];
+    HMODULE self = NULL, vulkan;
+    DWORD length;
+    WCHAR *name;
+
+    if (proc)
+        return proc;
+    if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            (LPCWSTR)(void *)bridge_get_instance_proc_addr, &self)
+            && (length = GetModuleFileNameW(self, path, ARRAY_SIZE(path))) && length < ARRAY_SIZE(path) - 32
+            && (name = wcsrchr(path, L'\\')))
+    {
+        wcscpy(name + 1, sizeof(void *) == 8 ? L"viogpu_vk.dll" : L"viogpu_vk_x86.dll");
+        if ((vulkan = LoadLibraryW(path)))
+            proc = (PFN_vkGetInstanceProcAddr)(void *)GetProcAddress(vulkan, "vk_icdGetInstanceProcAddr");
+    }
+    if (!proc && (vulkan = LoadLibraryA("vulkan-1.dll")))
+        proc = (PFN_vkGetInstanceProcAddr)(void *)GetProcAddress(vulkan, "vkGetInstanceProcAddr");
+    return proc;
+}
+
+long viogpu_bridge_create_device(const void *luid, unsigned int minimum_feature_level, void **device)
+{
+    struct vkd3d_instance_create_info instance_info;
+    struct vkd3d_device_create_info device_info;
+    struct vkd3d_instance *instance;
+    HRESULT hr;
+
+    *device = NULL;
+    memset(&instance_info, 0, sizeof(instance_info));
+    if (!(instance_info.pfn_vkGetInstanceProcAddr = bridge_get_instance_proc_addr()))
+    {
+        ERR("viogpu: no Vulkan driver (viogpu_vk.dll) or loader (vulkan-1.dll).\n");
+        return E_FAIL;
+    }
+    /* No surfaces: presents go through the kernel driver */
+    if (FAILED(hr = vkd3d_create_instance(&instance_info, &instance)))
+        return hr;
+
+    memset(&device_info, 0, sizeof(device_info));
+    device_info.minimum_feature_level = (D3D_FEATURE_LEVEL)minimum_feature_level;
+    device_info.instance = instance;
+    if (luid)
+        memcpy(&device_info.adapter_luid, luid, sizeof(device_info.adapter_luid));
+    hr = vkd3d_create_device(&device_info, &IID_ID3D12Device, device);
+    vkd3d_instance_decref(instance);
+    return hr;
+}
+
+long viogpu_bridge_serialize_root_signature(const void *versioned_desc, void **blob)
+{
+    return vkd3d_serialize_versioned_root_signature((const D3D12_VERSIONED_ROOT_SIGNATURE_DESC *)versioned_desc,
+            (ID3DBlob **)blob, NULL);
+}
+
+/* d3d12core.dll implements vkd3d-proton's test-suite and debug-layer controls; this driver has neither */
+bool vkd3d_debug_control_is_test_suite(void)
+{
+    return false;
+}
+
+bool vkd3d_debug_control_explode_on_vvl_error(void)
+{
+    return false;
+}
+
+bool vkd3d_debug_control_has_out_of_spec_test_behavior(VKD3D_DEBUG_CONTROL_OUT_OF_SPEC_BEHAVIOR behavior)
+{
+    return false;
+}
+
+VKD3D_DEBUG_CONTROL_BEHAVIOR_FLAGS vkd3d_debug_control_get_behavior_flags(void)
+{
+    return 0;
+}
+
+bool vkd3d_debug_control_mute_message_id(const char *vuid)
+{
+    return false;
+}
diff --git a/libs/viogpu_umd/umd_bridge.h b/libs/viogpu_umd/umd_bridge.h
new file mode 100644
--- /dev/null
+++ b/libs/viogpu_umd/umd_bridge.h
@@ -0,0 +1,29 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/* The few vkd3d-proton functions viogpu's Direct3D 12 user-mode driver needs besides the D3D12 API itself. The
+ * driver's DDI code includes the Windows SDK's d3d12.h, vkd3d-proton has headers of its own for the same API: they
+ * don't mix in one file, so these take and return the API objects as void pointers (the same COM objects; the
+ * caller casts them to the SDK's interfaces). */
+
+#ifndef VIOGPU_UMD_BRIDGE_H
+#define VIOGPU_UMD_BRIDGE_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* An ID3D12Device (vkd3d-proton) on the first Vulkan device: the virtual GPU's (Venus). luid is the adapter's,
+ * minimum_feature_level a D3D_FEATURE_LEVEL. Returns an HRESULT. */
+long viogpu_bridge_create_device(const void *luid, unsigned int minimum_feature_level, void **device);
+
+/* vkd3d_serialize_versioned_root_signature: the ID3DBlob of a D3D12_VERSIONED_ROOT_SIGNATURE_DESC */
+long viogpu_bridge_serialize_root_signature(const void *versioned_desc, void **blob);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/libs/viogpu_umd/umd_command.cpp b/libs/viogpu_umd/umd_command.cpp
new file mode 100644
--- /dev/null
+++ b/libs/viogpu_umd/umd_command.cpp
@@ -0,0 +1,1240 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/* Command pools, recorders, lists and queues, fences.
+ *
+ * The DDI's command pool is an allocator without a list type: one vkd3d-proton allocator per type, made when first
+ * needed. A recorder is the pen that writes into its target pool; a list resets into its recorder's pool.
+ *
+ * The runtime implements ID3D12Fence and the queues' Signal/Wait itself, on the kernel context each queue creates
+ * here. vkd3d-proton's work reaches the GPU its own way (Venus), so for the runtime's signals to come after the work
+ * they follow, ExecuteCommandLists waits until the GPU is done with it (correct, not fast: the next step is to tie the
+ * work to the kernel context's timeline). */
+
+#include "umd_private.h"
+#include <stdlib.h>
+
+D3D12DDI_HRTTABLE viogpu_command_list_rt_tables[2];
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Pools and recorders */
+
+struct viogpu_command_pool {
+   viogpu_device *device;
+   /* by D3D12_COMMAND_LIST_TYPE: direct, bundle, compute, copy */
+   ID3D12CommandAllocator *allocators[4];
+};
+
+struct viogpu_command_recorder {
+   D3D12DDI_COMMAND_QUEUE_FLAGS queueFlags;
+   viogpu_command_pool *pool;
+};
+
+static ID3D12CommandAllocator *
+pool_allocator(viogpu_command_pool *pool, D3D12_COMMAND_LIST_TYPE type)
+{
+   if (!pool->allocators[type]) {
+      HRESULT hr = pool->device->vkd3d->CreateCommandAllocator(type, IID_PPV_ARGS(&pool->allocators[type]));
+      if (FAILED(hr))
+         viogpu_log("CreateCommandAllocator (type %d): 0x%08lx", (int)type, (unsigned long)hr);
+   }
+   return pool->allocators[type];
+}
+
+static SIZE_T APIENTRY
+calc_command_pool_size(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATE_COMMAND_POOL_0040 *)
+{
+   return sizeof(viogpu_command_pool);
+}
+
+static HRESULT APIENTRY
+create_command_pool(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_COMMAND_POOL_0040 *,
+                    D3D12DDI_HCOMMANDPOOL_0040 h)
+{
+   viogpu_command_pool *pool = new (h.pDrvPrivate) viogpu_command_pool();
+   pool->device = device_from(hDevice);
+   return S_OK;
+}
+
+static VOID APIENTRY
+destroy_command_pool(D3D12DDI_HDEVICE, D3D12DDI_HCOMMANDPOOL_0040 h)
+{
+   viogpu_command_pool *pool = (viogpu_command_pool *)h.pDrvPrivate;
+   for (ID3D12CommandAllocator *a : pool->allocators)
+      if (a)
+         a->Release();
+   pool->~viogpu_command_pool();
+}
+
+static VOID APIENTRY
+reset_command_pool(D3D12DDI_HDEVICE hDevice, D3D12DDI_HCOMMANDPOOL_0040 h)
+{
+   viogpu_command_pool *pool = (viogpu_command_pool *)h.pDrvPrivate;
+   for (ID3D12CommandAllocator *a : pool->allocators) {
+      if (!a)
+         continue;
+      HRESULT hr = a->Reset();
+      if (FAILED(hr))
+         viogpu_log("ResetCommandPool: 0x%08lx", (unsigned long)hr);
+   }
+}
+
+static SIZE_T APIENTRY
+calc_command_recorder_size(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATE_COMMAND_RECORDER_0040 *)
+{
+   return sizeof(viogpu_command_recorder);
+}
+
+static HRESULT APIENTRY
+create_command_recorder(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATE_COMMAND_RECORDER_0040 *args,
+                        D3D12DDI_HCOMMANDRECORDER_0040 h)
+{
+   viogpu_command_recorder *recorder = new (h.pDrvPrivate) viogpu_command_recorder();
+   recorder->queueFlags = args->QueueFlags;
+   return S_OK;
+}
+
+static VOID APIENTRY
+destroy_command_recorder(D3D12DDI_HDEVICE, D3D12DDI_HCOMMANDRECORDER_0040 h)
+{
+   ((viogpu_command_recorder *)h.pDrvPrivate)->~viogpu_command_recorder();
+}
+
+static VOID APIENTRY
+recorder_set_pool(D3D12DDI_HDEVICE, D3D12DDI_HCOMMANDRECORDER_0040 hRecorder, D3D12DDI_HCOMMANDPOOL_0040 hPool)
+{
+   ((viogpu_command_recorder *)hRecorder.pDrvPrivate)->pool = (viogpu_command_pool *)hPool.pDrvPrivate;
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Command lists */
+
+struct viogpu_command_list {
+   viogpu_device *device;
+   D3D12DDI_HRTCOMMANDLIST hRT;
+   D3D12_COMMAND_LIST_TYPE type;
+   ID3D12GraphicsCommandList *list;
+   ID3D12GraphicsCommandList1 *list1;
+   ID3D12GraphicsCommandList2 *list2;
+   ID3D12GraphicsCommandList4 *list4;
+};
+
+static inline viogpu_command_list *
+list_from(D3D12DDI_HCOMMANDLIST h)
+{
+   return (viogpu_command_list *)h.pDrvPrivate;
+}
+
+#define L(h) (list_from(h)->list)
+
+static void
+list_error(viogpu_command_list *list, HRESULT hr)
+{
+   viogpu_log("command list error 0x%08lx", (unsigned long)hr);
+   list->device->umCallbacks->pfnSetCommandListErrorCb(list->hRT, hr);
+}
+
+static D3D12_COMMAND_LIST_TYPE
+list_type(D3D12DDI_COMMAND_LIST_TYPE type, D3D12DDI_COMMAND_QUEUE_FLAGS flags)
+{
+   if (type == D3D12DDI_COMMAND_LIST_TYPE_BUNDLE)
+      return D3D12_COMMAND_LIST_TYPE_BUNDLE;
+   if (flags & D3D12DDI_COMMAND_QUEUE_FLAG_3D)
+      return D3D12_COMMAND_LIST_TYPE_DIRECT;
+   if (flags & D3D12DDI_COMMAND_QUEUE_FLAG_COMPUTE)
+      return D3D12_COMMAND_LIST_TYPE_COMPUTE;
+   if (flags & D3D12DDI_COMMAND_QUEUE_FLAG_COPY)
+      return D3D12_COMMAND_LIST_TYPE_COPY;
+   return D3D12_COMMAND_LIST_TYPE_DIRECT;
+}
+
+static SIZE_T APIENTRY
+calc_command_list_size(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATE_COMMAND_LIST_0040 *)
+{
+   return sizeof(viogpu_command_list);
+}
+
+static HRESULT APIENTRY
+create_command_list(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_COMMAND_LIST_0040 *args,
+                    D3D12DDI_HCOMMANDLIST h, D3D12DDI_HRTCOMMANDLIST hRT)
+{
+   viogpu_device *device = device_from(hDevice);
+   viogpu_command_list *list = new (h.pDrvPrivate) viogpu_command_list();
+   list->device = device;
+   list->hRT = hRT;
+   list->type = list_type(args->Type, args->QueueFlags);
+
+   /* created closed, without an allocator: the first reset gives it one */
+   ID3D12Device4 *device4 = NULL;
+   HRESULT hr = device->vkd3d->QueryInterface(IID_PPV_ARGS(&device4));
+   if (SUCCEEDED(hr)) {
+      hr = device4->CreateCommandList1(args->NodeMask, list->type, D3D12_COMMAND_LIST_FLAG_NONE,
+                                       IID_PPV_ARGS(&list->list));
+      device4->Release();
+   }
+   if (FAILED(hr)) {
+      viogpu_log("CreateCommandList (type %d): 0x%08lx", (int)list->type, (unsigned long)hr);
+      return hr;
+   }
+   list->list->QueryInterface(IID_PPV_ARGS(&list->list1));
+   list->list->QueryInterface(IID_PPV_ARGS(&list->list2));
+   list->list->QueryInterface(IID_PPV_ARGS(&list->list4));
+
+   bool compute = list->type == D3D12_COMMAND_LIST_TYPE_COMPUTE || list->type == D3D12_COMMAND_LIST_TYPE_COPY;
+   device->umCallbacks->pfnSetCommandListDDITableCb(hRT, viogpu_command_list_rt_tables[compute ? 0 : 1]);
+   return S_OK;
+}
+
+static VOID APIENTRY
+destroy_command_list(D3D12DDI_HDEVICE, D3D12DDI_HCOMMANDLIST h)
+{
+   viogpu_command_list *list = list_from(h);
+   if (list->list4)
+      list->list4->Release();
+   if (list->list2)
+      list->list2->Release();
+   if (list->list1)
+      list->list1->Release();
+   if (list->list)
+      list->list->Release();
+   list->~viogpu_command_list();
+}
+
+static VOID APIENTRY
+close_command_list(D3D12DDI_HCOMMANDLIST h)
+{
+   HRESULT hr = L(h)->Close();
+   if (FAILED(hr))
+      list_error(list_from(h), hr);
+}
+
+static VOID APIENTRY
