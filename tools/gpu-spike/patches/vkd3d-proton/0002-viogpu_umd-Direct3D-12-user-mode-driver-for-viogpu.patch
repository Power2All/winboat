+ */
+
+/* The viogpu3d kernel driver's allocation private data (its shared/viogpum.h, as Mesa's viogpu_wddm_driver.h has
+ * it) and the virgl values in it: what the D3D10/11 driver that opens a shared surface (DWM's) reads */
+
+#ifndef VIOGPU_UMD_VIOGPU_H
+#define VIOGPU_UMD_VIOGPU_H
+
+#include <windows.h>
+
+#pragma pack(push, 1)
+typedef struct VIOGPU_UMD_RESOURCE_OPTIONS {
+   ULONG target;
+   ULONG format;
+   ULONG bind;
+   ULONG width;
+   ULONG height;
+   ULONG depth;
+   ULONG array_size;
+   ULONG last_level;
+   ULONG nr_samples;
+   ULONG flags;
+} VIOGPU_UMD_RESOURCE_OPTIONS;
+
+typedef struct VIOGPU_UMD_CREATE_RESOURCE_EXCHANGE {
+   ULONG magic;
+} VIOGPU_UMD_CREATE_RESOURCE_EXCHANGE;
+
+typedef struct VIOGPU_UMD_CREATE_ALLOCATION_EXCHANGE {
+   VIOGPU_UMD_RESOURCE_OPTIONS ResourceOptions;
+   ULONGLONG Size;
+} VIOGPU_UMD_CREATE_ALLOCATION_EXCHANGE;
+#pragma pack(pop)
+
+/* The kernel driver copies a GDI surface's pages to the host before every submission that uses it */
+#define VIOGPU_UMD_RESOURCE_FLAG_GDI_SURFACE 0x80000000u
+
+#define VIOGPU_UMD_PIPE_TEXTURE_2D 2
+#define VIOGPU_UMD_VIRGL_BIND_RENDER_TARGET (1u << 1)
+#define VIOGPU_UMD_VIRGL_BIND_SAMPLER_VIEW (1u << 3)
+#define VIOGPU_UMD_VIRGL_RESOURCE_FLAG_MAP_COHERENT (1u << 2)
+
+#define VIOGPU_UMD_VIRGL_FORMAT_B8G8R8A8_UNORM 1
+#define VIOGPU_UMD_VIRGL_FORMAT_B8G8R8X8_UNORM 2
+#define VIOGPU_UMD_VIRGL_FORMAT_R10G10B10A2_UNORM 8
+#define VIOGPU_UMD_VIRGL_FORMAT_R8G8B8A8_UNORM 67
+#define VIOGPU_UMD_VIRGL_FORMAT_R16G16B16A16_FLOAT 94
+#define VIOGPU_UMD_VIRGL_FORMAT_B8G8R8A8_SRGB 100
+#define VIOGPU_UMD_VIRGL_FORMAT_R8G8B8A8_SRGB 104
+
+#endif
