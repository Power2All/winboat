+static VOID APIENTRY
+copy_descriptors(D3D12DDI_HDEVICE hDevice, UINT numDest, const D3D12DDI_CPU_DESCRIPTOR_HANDLE *destStarts,
+                 const UINT *destSizes, UINT numSrc, const D3D12DDI_CPU_DESCRIPTOR_HANDLE *srcStarts,
