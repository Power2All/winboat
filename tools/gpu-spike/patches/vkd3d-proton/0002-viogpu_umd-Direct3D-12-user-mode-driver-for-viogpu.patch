+/* Residency: vkd3d-proton keeps its memory resident; swap chain buffers' kernel allocations go to the kernel */
+static HRESULT APIENTRY
+make_resident(D3D12DDI_HDEVICE hDevice, D3D12DDIARG_MAKERESIDENT_0001 *args)
+{
+   args->WaitMask = 0;
+   std::vector<D3DKMT_HANDLE> allocations;
+   for (UINT i = 0; i < args->NumObjects; i++) {
+      const D3D12DDI_HANDLE_AND_TYPE &o = args->pObjects[i];
+      viogpu_resource *res = NULL;
+      if (o.Type == D3D12DDI_HT_HEAP && o.Handle)
+         res = ((viogpu_heap *)o.Handle)->committedResource;
+      else if (o.Type == D3D12DDI_HT_0012_RESOURCE)
+         res = (viogpu_resource *)o.Handle;
+      if (res && res->kmAllocation)
+         allocations.push_back(res->kmAllocation);
+   }
+   if (allocations.empty() || !args->NumAdapters)
+      return S_OK;
+
+   viogpu_device *device = device_from(hDevice);
+   D3DDDI_MAKERESIDENT resident = {};
+   resident.NumAllocations = (UINT)allocations.size();
+   resident.AllocationList = allocations.data();
+   resident.Flags = args->Flags;
+   HRESULT hr = device->umCallbacks->pfnMakeResidentCb(device->hRTDevice, args->pRTPagingQueue[0], &resident);
+   if (hr == E_PENDING) {
+      args->pPagingFenceValue[0] = resident.PagingFenceValue;
+      args->WaitMask = 1;
+   } else if (FAILED(hr)) {
+      viogpu_log("MakeResident: 0x%08lx", (unsigned long)hr);
+   }
+   return hr;
+}
