+
+#define CREATE_SHADER(fn, stage)                                                                                  \
+   static VOID APIENTRY fn(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATE_SHADER_0026 *args, D3D12DDI_HSHADER h)      \
+   {                                                                                                              \
+      viogpu_shader *shader = new (h.pDrvPrivate) viogpu_shader();                                                \
+      shader_build(shader, stage, args);                                                                          \
+   }
+CREATE_SHADER(create_vertex_shader, STAGE_VS)
+CREATE_SHADER(create_pixel_shader, STAGE_PS)
+CREATE_SHADER(create_geometry_shader, STAGE_GS)
+CREATE_SHADER(create_compute_shader, STAGE_CS)
+CREATE_SHADER(create_hull_shader, STAGE_HS)
+CREATE_SHADER(create_domain_shader, STAGE_DS)
+
+/* Stream output: entries name output registers; the same names as the output signature's */
+static VOID APIENTRY
+create_gs_with_so(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATE_GEOMETRY_SHADER_WITH_STREAM_OUTPUT_0026 *args,
+                  D3D12DDI_HSHADER h)
+{
+   viogpu_shader *shader = new (h.pDrvPrivate) viogpu_shader();
+   shader_build(shader, STAGE_GS, &args->CreateShader);
+   /* names must outlive the shader: one static string, indices carry the register */
+   for (UINT i = 0; i < args->NumEntries; i++) {
+      const D3D12DDIARG_STREAM_OUTPUT_DECLARATION_ENTRY &d = args->pOutputStreamDecl[i];
+      D3D12_SO_DECLARATION_ENTRY e = {};
+      e.Stream = d.Stream;
+      e.OutputSlot = (BYTE)d.OutputSlot;
+      if (d.RegisterIndex == (UINT)-1) {
+         /* a gap */
+         e.SemanticName = NULL;
+         e.ComponentCount = (BYTE)__popcnt(d.RegisterMask);
+      } else {
+         /* the output signature's entry holding these components: its name, and where they start in it */
+         UINT first = first_component(d.RegisterMask);
+         UINT entryFirst = first;
+         const D3D12DDIARG_STAGE_IO_SIGNATURES *sig = args->CreateShader.IOSignatures.Standard;
+         for (UINT j = 0; sig && j < sig->NumOutputSignatureEntries; j++) {
+            const D3D12DDIARG_SIGNATURE_ENTRY_0012 &o = sig->pOutputSignature[j];
+            if (o.Register == d.RegisterIndex && (o.Mask & d.RegisterMask) == d.RegisterMask) {
+               entryFirst = first_component(o.Mask);
+               break;
+            }
+         }
+         e.SemanticName = "WBREG";
+         e.SemanticIndex = d.RegisterIndex * 4 + entryFirst;
+         e.StartComponent = (BYTE)(first - entryFirst);
+         e.ComponentCount = (BYTE)__popcnt(d.RegisterMask);
+      }
+      shader->soDecl.push_back(e);
+   }
+   shader->soStrides.assign(args->BufferStridesInBytes, args->BufferStridesInBytes + args->NumStrides);
+   shader->rasterizedStream = args->RasterizedStream;
+}
