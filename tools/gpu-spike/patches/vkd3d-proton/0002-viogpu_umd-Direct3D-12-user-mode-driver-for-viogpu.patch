+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Queues */
+
+
+static HRESULT
+km_fence_create(viogpu_device *device, D3DKMT_HANDLE *handle, const volatile UINT64 **value)
+{
+   D3DDDICB_CREATESYNCHRONIZATIONOBJECT2 create = {};
+   create.Info.Type = D3DDDI_MONITORED_FENCE;
+   HRESULT hr = device->ktCallbacks->pfnCreateSynchronizationObject2Cb(device->hRTDevice.handle, &create);
+   *handle = create.hSyncObject;
+   if (value)
+      *value = (const volatile UINT64 *)create.Info.MonitoredFence.FenceValueCPUVirtualAddress;
+   return hr;
+}
+
+static void
+km_fence_destroy(viogpu_device *device, D3DKMT_HANDLE handle)
+{
+   if (!handle)
+      return;
+   D3DDDICB_DESTROYSYNCHRONIZATIONOBJECT destroy = {};
+   destroy.hSyncObject = handle;
+   device->ktCallbacks->pfnDestroySynchronizationObjectCb(device->hRTDevice.handle, &destroy);
+}
+
+/* Opens vkd3d-proton's gate for the submissions whose place on the kernel context has been reached */
+static DWORD WINAPI
+gate_thread(void *param)
+{
+   viogpu_command_queue *queue = (viogpu_command_queue *)param;
+   viogpu_device *device = queue->device;
+   for (;;) {
+      EnterCriticalSection(&queue->lock);
+      while (!queue->stop && queue->gateNext > queue->submitted)
+         SleepConditionVariableCS(&queue->wake, &queue->lock, INFINITE);
+      if (queue->stop) {
+         LeaveCriticalSection(&queue->lock);
+         return 0;
+      }
+      UINT64 n = queue->gateNext;
+      UINT64 last = queue->submitted;
+      LeaveCriticalSection(&queue->lock);
+
+      if (*queue->kmInValue < n) {
+         D3DDDICB_WAITFORSYNCHRONIZATIONOBJECTFROMCPU wait = {};
+         wait.ObjectCount = 1;
+         wait.ObjectHandleArray = &queue->kmIn;
+         wait.FenceValueArray = &n;
+         device->ktCallbacks->pfnWaitForSynchronizationObjectFromCpuCb(device->hRTDevice.handle, &wait);
+      }
+      /* everything the kernel context has reached at once */
+      UINT64 reached = *queue->kmInValue;
+      if (reached > last)
+         reached = last;
+      if (reached < n)
+         reached = n;
+      queue->gate->Signal(reached);
+      EnterCriticalSection(&queue->lock);
+      queue->gateNext = reached + 1;
+      LeaveCriticalSection(&queue->lock);
+   }
+}
+
+/* Tells the kernel context which submissions the GPU has done */
+static DWORD WINAPI
+done_thread(void *param)
+{
+   viogpu_command_queue *queue = (viogpu_command_queue *)param;
+   viogpu_device *device = queue->device;
+   for (;;) {
+      EnterCriticalSection(&queue->lock);
+      while (!queue->stop && queue->doneNext > queue->submitted)
+         SleepConditionVariableCS(&queue->wake, &queue->lock, INFINITE);
+      if (queue->stop) {
+         LeaveCriticalSection(&queue->lock);
+         return 0;
+      }
+      UINT64 n = queue->doneNext;
+      LeaveCriticalSection(&queue->lock);
+
+      queue->done->SetEventOnCompletion(n, NULL);
+      UINT64 completed = queue->done->GetCompletedValue();
+      if (completed < n)
+         completed = n;
+      D3DDDICB_SIGNALSYNCHRONIZATIONOBJECTFROMCPU signal = {};
+      signal.ObjectCount = 1;
+      signal.ObjectHandleArray = &queue->kmOut;
+      signal.FenceValueArray = &completed;
+      device->ktCallbacks->pfnSignalSynchronizationObjectFromCpuCb(device->hRTDevice.handle, &signal);
+      EnterCriticalSection(&queue->lock);
+      queue->doneNext = completed + 1;
+      LeaveCriticalSection(&queue->lock);
+   }
+}
+
+/* What the queue has been given is done on the GPU (presents read its results) */
+static void
+queue_wait_idle(viogpu_command_queue *queue)
+{
+   EnterCriticalSection(&queue->lock);
+   UINT64 n = queue->submitted;
+   LeaveCriticalSection(&queue->lock);
+   if (n && queue->done->GetCompletedValue() < n)
+      queue->done->SetEventOnCompletion(n, NULL);
+}
