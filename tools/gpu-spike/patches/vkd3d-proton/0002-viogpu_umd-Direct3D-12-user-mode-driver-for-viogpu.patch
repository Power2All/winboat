+static HRESULT APIENTRY
+create_descriptor_heap(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_DESCRIPTOR_HEAP_0001 *args,
+                       D3D12DDI_HDESCRIPTORHEAP h)
+{
