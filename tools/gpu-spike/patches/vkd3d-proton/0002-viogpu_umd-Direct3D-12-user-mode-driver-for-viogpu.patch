+struct viogpu_command_queue {
+   viogpu_device *device;
+   D3D12DDI_HRTCOMMANDQUEUE hRT;
+   ID3D12CommandQueue *queue;
+   /* the kernel context the runtime signals and waits on */
+   HANDLE hContext;
+
+   /* Submission n: the kernel context signals kmIn = n (after the runtime's waits queued before it), then waits for
+    * kmOut >= n (so the runtime's signals queued after it come once the lists ran). vkd3d-proton waits for
+    * gate >= n, runs the lists and signals done = n. gateThread opens the gate once kmIn reaches n, doneThread
+    * signals kmOut once done does.
+    * ponytail: the runtime signals and waits on the context itself, unseen (it never calls pfnSignalFence), so every
+    * submission waits for the one before to finish (~100 us an empty one). Overlapping them takes knowing where the
+    * runtime's operations are, e.g. a kernel-side queue that completes a DMA buffer per submission. */
+   ID3D12Fence *gate;
+   ID3D12Fence *done;
+   D3DKMT_HANDLE kmIn, kmOut;
+   const volatile UINT64 *kmInValue;
+   UINT64 submitted;
+   UINT64 gateNext, doneNext;
+   bool stop;
+   CRITICAL_SECTION lock;
+   CONDITION_VARIABLE wake;
+   HANDLE gateThread, doneThread;
+};
