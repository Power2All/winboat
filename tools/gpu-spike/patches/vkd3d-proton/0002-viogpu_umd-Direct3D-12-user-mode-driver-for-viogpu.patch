+static VOID APIENTRY
+resource_barrier(D3D12DDI_HCOMMANDLIST h, UINT count, const D3D12DDIARG_RESOURCE_BARRIER_0022 *barriers)
+{
+   std::vector<D3D12_RESOURCE_BARRIER> api;
+   api.reserve(count);
+   for (UINT i = 0; i < count; i++) {
+      const D3D12DDIARG_RESOURCE_BARRIER_0022 &b = barriers[i];
+      D3D12_RESOURCE_BARRIER a = {};
+      a.Flags = (D3D12_RESOURCE_BARRIER_FLAGS)(b.Flags & (D3D12DDI_RESOURCE_BARRIER_FLAG_BEGIN_ONLY |
+                                                          D3D12DDI_RESOURCE_BARRIER_FLAG_END_ONLY));
+      switch (b.Type) {
+      case D3D12DDI_RESOURCE_BARRIER_TYPE_TRANSITION:
+         a.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+         a.Transition.pResource = resource_of(b.Transition.hResource);
+         a.Transition.Subresource = b.Transition.Subresource;
+         a.Transition.StateBefore = (D3D12_RESOURCE_STATES)b.Transition.StateBefore;
+         a.Transition.StateAfter = (D3D12_RESOURCE_STATES)b.Transition.StateAfter;
+         break;
+      case D3D12DDI_RESOURCE_BARRIER_TYPE_UAV:
+         a.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV;
+         a.UAV.pResource = resource_of(b.UAV.hResource);
+         break;
+      case D3D12DDI_RESOURCE_BARRIER_TYPE_0022_RANGED:
+         /* the runtime's aliasing barriers; atomic copies get a full UAV barrier */
+         if (b.Flags & D3D12DDI_RESOURCE_BARRIER_FLAG_0022_ALIASING) {
+            a.Type = D3D12_RESOURCE_BARRIER_TYPE_ALIASING;
+            a.Aliasing.pResourceBefore = NULL;
+            a.Aliasing.pResourceAfter = resource_of(b.Ranged.hResource);
+         } else {
+            a.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV;
+            a.UAV.pResource = NULL;
+         }
+         break;
+      default:
+         continue;
+      }
+      api.push_back(a);
+   }
+   if (!api.empty())
+      L(h)->ResourceBarrier((UINT)api.size(), api.data());
+}
