diff --git a/libs/viogpu_umd/umd_ddi.cpp b/libs/viogpu_umd/umd_ddi.cpp
new file mode 100644
--- /dev/null
+++ b/libs/viogpu_umd/umd_ddi.cpp
@@ -0,0 +1,622 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/* viogpu's Direct3D 12 user-mode driver: the D3D12 DDI the Windows runtime calls, on vkd3d-proton's implementation of
+ * the D3D12 API (Vulkan, on the virtual GPU's Venus driver). This file speaks the DDI with the Windows SDK's and
+ * WDK's headers; vkd3d-proton's objects are the same COM objects as the SDK's interfaces, so they are called through
+ * those directly, and umd_bridge.c holds the rest of vkd3d-proton the driver uses.
+ *
+ * Every DDI table entry the driver doesn't implement yet is a stub that logs which entry the runtime called
+ * (OutputDebugString, and the file VIOGPU_D3D12_LOG names) and returns 0. Each stub has its entry's own type, so that
+ * on x86 it pops the caller's arguments (__stdcall).
+ *
+ * DDI versions: D3D12DDI_SUPPORTED_0082 (interface R8, build 2: shader model 6.6) and, for older runtimes,
+ * D3D12DDI_SUPPORTED_0052 (R5, build 2, the version of Microsoft's compute-only sample driver). The tables and caps
+ * are 0082's; an older runtime's are a prefix of them (umd_private.h).
+ */
+
+#include "umd_private.h"
+#include "umd_tables.h"
+
+#include <type_traits>
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Log */
+
+void
+viogpu_log(const char *format, ...)
+{
+   char line[512];
+   va_list args;
+   va_start(args, format);
+   int n = _vsnprintf_s(line, sizeof(line) - 2, _TRUNCATE, format, args);
+   va_end(args);
+   if (n < 0)
+      n = (int)strlen(line);
+   line[n++] = '\n';
+   line[n] = 0;
+   OutputDebugStringA("viogpu_d3d12: ");
+   OutputDebugStringA(line);
+
+   static char path[MAX_PATH];
+   static LONG pathState; /* 0: not read yet, 1: no log file, 2: path */
+   if (pathState == 0)
+      pathState = GetEnvironmentVariableA("VIOGPU_D3D12_LOG", path, sizeof(path)) ? 2 : 1;
+   if (pathState == 2) {
+      HANDLE file = CreateFileA(path, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_ALWAYS,
+                                FILE_ATTRIBUTE_NORMAL, NULL);
+      if (file != INVALID_HANDLE_VALUE) {
+         char prefixed[600];
+         int length = _snprintf_s(prefixed, sizeof(prefixed), _TRUNCATE, "[%lu] %s", GetCurrentProcessId(), line);
+         DWORD written;
+         WriteFile(file, prefixed, length > 0 ? (DWORD)length : 0, &written, NULL);
+         CloseHandle(file);
+      }
+   }
+}
+
+void
+viogpu_device_error(viogpu_device *device, HRESULT hr)
+{
+   viogpu_log("device error 0x%08lx", (unsigned long)hr);
+   device->umCallbacks->pfnSetErrorCb(device->hRTDevice, hr);
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Stubs: one function per table entry, so that each knows which entry it stands for */
+
+enum viogpu_table {
+   TABLE_DEVICE,
+   TABLE_COMMAND_LIST,
+   TABLE_COMMAND_QUEUE,
+   TABLE_DXGI,
+   TABLE_EXTENDED_FEATURES,
+};
+
+static const char *const *const table_names[] = {
+   viogpu_d3d12_device_names,
+   viogpu_d3d12_command_list_names,
+   viogpu_d3d12_command_queue_names,
+   viogpu_d3d12_dxgi_names,
+   viogpu_d3d12_extended_features_names,
+};
+static const char *const table_tags[] = { "device", "command list", "command queue", "DXGI", "extended features" };
+
+static void
+stub_called(int table, int entry)
+{
+   /* every call of the first ones, then every 1000th, so a draw loop doesn't flood the log */
+   static LONG counts[5][128];
+   LONG count = InterlockedIncrement(&counts[table][entry & 127]);
+   if (count <= 20 || count % 1000 == 0)
+      viogpu_log("not implemented: %s %s (call %ld)", table_tags[table], table_names[table][entry], count);
+}
+
+template <int Table, int Entry, typename F>
+struct stub {
+   /* entries that aren't functions (pfnUnused): never called */
+   static_assert(std::is_same<F, void *>::value, "a DDI entry with an unexpected calling convention");
+   static SIZE_T APIENTRY fn() { stub_called(Table, Entry); return 0; }
+   static void *get() { return (void *)&fn; }
+};
+template <int Table, int Entry, typename R, typename... A>
+struct stub<Table, Entry, R (APIENTRY *)(A...)> {
+   static R APIENTRY fn(A...) { stub_called(Table, Entry); return R(); }
+   static R (APIENTRY *get())(A...) { return &fn; }
+};
+
+/* the runtime's table of size bytes: a stub in every entry of Funcs that fits */
+#define STUB_ENTRY(i, m)                                                                                         \
+   if ((char *)&funcs->m - (char *)funcs < (ptrdiff_t)size)                                                      \
+      funcs->m = stub<table_, i, decltype(funcs->m)>::get();
+#define FILL_STUBS(tag, Funcs, table, size)                                                                     \
+   do {                                                                                                          \
+      constexpr int table_ = TABLE_##tag;                                                                        \
+      Funcs *funcs = (Funcs *)(table);                                                                           \
+      VIOGPU_D3D12_##tag##_MEMBERS(STUB_ENTRY)                                                                   \
+   } while (0)
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Device */
+
+
+static void APIENTRY
+device_check_format_support(D3D12DDI_HDEVICE, DXGI_FORMAT format, UINT *support)
+{
+   /* What the feature level requires, the runtime knows; these bits are the optional extras. None yet, besides
+    * the formats DXGI swap chains show */
+   switch (format) {
+   case DXGI_FORMAT_R8G8B8A8_UNORM:
+   case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+   case DXGI_FORMAT_B8G8R8A8_UNORM:
+   case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+   case DXGI_FORMAT_R10G10B10A2_UNORM:
+   case DXGI_FORMAT_R16G16B16A16_FLOAT:
+      *support = D3D12DDI_FORMAT_SUPPORT_DISPLAY;
+      break;
+   case DXGI_FORMAT_R10G10B10_XR_BIAS_A2_UNORM:
+      *support = D3D12DDI_FORMAT_SUPPORT_NOT_SUPPORTED;
+      break;
+   default:
+      *support = 0;
+      break;
+   }
+}
+
+static void APIENTRY
+device_check_multisample_quality_levels(D3D12DDI_HDEVICE, DXGI_FORMAT, UINT sampleCount,
+                                        D3D12DDI_MULTISAMPLE_QUALITY_LEVEL_FLAGS, UINT *levels)
+{
+   *levels = sampleCount == 1 ? 1 : 0;
+}
+
+static UINT APIENTRY
+device_get_implicit_physical_adapter_mask(D3D12DDI_HDEVICE)
+{
+   return 1;
+}
+
+static VOID APIENTRY
+device_query_node_map(D3D12DDI_HDEVICE, UINT numPhysicalAdapters, UINT *map)
+{
+   for (UINT i = 0; i < numPhysicalAdapters; i++)
+      map[i] = i;
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Extended features (video, shader cache, render passes, meta commands...): none */
+
+static HRESULT APIENTRY
+device_get_supported_extended_features(D3D12DDI_HDEVICE, UINT32 *count, D3D12DDI_FEATURE_0020 *)
+{
+   *count = 0;
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+device_get_supported_extended_feature_versions(D3D12DDI_HDEVICE, D3D12DDI_FEATURE_0020, UINT32 *count, UINT32 *)
+{
+   *count = 0;
+   return S_OK;
+}
+
+static HRESULT APIENTRY
+device_enable_extended_feature(D3D12DDI_HDEVICE, D3D12DDI_FEATURE_0020 feature, UINT32 version)
+{
+   viogpu_log("EnableExtendedFeature %d version %u: not supported", (int)feature, version);
+   return E_INVALIDARG;
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Adapter */
+
+struct viogpu_caps;
+
+struct viogpu_adapter {
+   D3D12DDI_HRTADAPTER hRTAdapter;
+   const D3DDDI_ADAPTERCALLBACKS *callbacks;
+   /* vkd3d-proton's device, made on first use (the caps come from it): the runtime keeps one D3D12 device per
+    * adapter and process, which uses this one */
+   ID3D12Device *vkd3d;
+   HRESULT vkd3dResult;
+   bool vkd3dTried;
+   viogpu_caps *caps;
+};
+
+static ID3D12Device *
+adapter_vkd3d(viogpu_adapter *adapter)
+{
+   if (!adapter->vkd3dTried) {
+      adapter->vkd3dTried = true;
+      void *device = NULL;
+      HRESULT hr = viogpu_bridge_create_device(NULL, D3D_FEATURE_LEVEL_11_0, &device);
+      adapter->vkd3d = (ID3D12Device *)device;
+      viogpu_log("vkd3d-proton device: 0x%08lx", (unsigned long)hr);
+      /* No Venus, or a host whose Vulkan lacks what D3D12 needs: the GPU has no Direct3D 12, as a vendor driver
+       * of such a GPU says */
+      adapter->vkd3dResult = SUCCEEDED(hr) ? hr : DXGI_ERROR_UNSUPPORTED;
+   }
+   return adapter->vkd3d;
+}
+
+static const UINT64 supported_versions[] = { D3D12DDI_SUPPORTED_0082 };
+
+static HRESULT APIENTRY
+adapter_get_supported_versions(D3D12DDI_HADAPTER, UINT32 *entries, UINT64 *versions)
+{
+   if (versions && *entries < ARRAYSIZE(supported_versions))
+      return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+   *entries = ARRAYSIZE(supported_versions);
+   if (versions)
+      memcpy(versions, supported_versions, sizeof(supported_versions));
+   return S_OK;
+}
+
+/* the caps struct, as much of it as the runtime's version has room for */
+template <typename T>
+static HRESULT
+answer(const D3D12DDIARG_GETCAPS *caps, const T &value)
+{
+   if (!caps->pData || caps->DataSize == 0)
+      return E_INVALIDARG;
+   memset(caps->pData, 0, caps->DataSize);
+   memcpy(caps->pData, &value, caps->DataSize < sizeof(T) ? caps->DataSize : sizeof(T));
+   return S_OK;
+}
+
+/* What the device can do, from vkd3d-proton's answers, in the DDI's terms */
+struct viogpu_caps {
+   D3D12DDI_3DPIPELINELEVEL level;
+   BOOL uma, cacheCoherentUma;
+   D3D12DDI_SHADER_CAPS_0082 shader;
+   D3D12DDI_D3D12_OPTIONS_DATA_0081 options;
+   UINT gpuvaBits;
+   /* highest shader model, in D3D_SHADER_MODEL's terms (0x51, 0x60...) */
+   UINT shaderModel;
+};
+
+static void
+caps_from_vkd3d(ID3D12Device *device, viogpu_caps *caps)
+{
+   static const D3D_FEATURE_LEVEL levels[] = {
+      D3D_FEATURE_LEVEL_11_0, D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_12_0, D3D_FEATURE_LEVEL_12_1,
+      D3D_FEATURE_LEVEL_12_2,
+   };
+   D3D12_FEATURE_DATA_FEATURE_LEVELS fl = {};
+   fl.NumFeatureLevels = ARRAYSIZE(levels);
+   fl.pFeatureLevelsRequested = levels;
+   device->CheckFeatureSupport(D3D12_FEATURE_FEATURE_LEVELS, &fl, sizeof(fl));
+   switch (fl.MaxSupportedFeatureLevel) {
+   /* ponytail: 12_2 (DirectX 12 Ultimate) needs ray tracing, mesh shaders, VRS and sampler feedback through the
+    * DDI (state objects, DispatchRays/DispatchMesh, shading rate entries), none of them passed on yet: 12_1 */
+   case D3D_FEATURE_LEVEL_12_2:
+   case D3D_FEATURE_LEVEL_12_1: caps->level = D3D12DDI_3DPIPELINELEVEL_12_1; break;
+   case D3D_FEATURE_LEVEL_12_0: caps->level = D3D12DDI_3DPIPELINELEVEL_12_0; break;
+   case D3D_FEATURE_LEVEL_11_1: caps->level = D3D12DDI_3DPIPELINELEVEL_11_1; break;
+   default: caps->level = D3D12DDI_3DPIPELINELEVEL_11_0; break;
+   }
+
+   D3D12_FEATURE_DATA_D3D12_OPTIONS o = {};
+   D3D12_FEATURE_DATA_D3D12_OPTIONS1 o1 = {};
+   D3D12_FEATURE_DATA_D3D12_OPTIONS2 o2 = {};
+   D3D12_FEATURE_DATA_D3D12_OPTIONS3 o3 = {};
+   D3D12_FEATURE_DATA_D3D12_OPTIONS4 o4 = {};
+   D3D12_FEATURE_DATA_D3D12_OPTIONS5 o5 = {};
+   device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS, &o, sizeof(o));
+   device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS1, &o1, sizeof(o1));
+   device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS2, &o2, sizeof(o2));
+   device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS3, &o3, sizeof(o3));
+   device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS4, &o4, sizeof(o4));
+   device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS5, &o5, sizeof(o5));
+
+   /* The DDI's enums have the API's values */
+   D3D12DDI_SHADER_CAPS_0082 &shader = caps->shader;
+   shader.MinPrecision = (D3D12DDI_SHADER_MIN_PRECISION)o.MinPrecisionSupport;
+   shader.DoubleOps = o.DoublePrecisionFloatShaderOps;
+   shader.ShaderSpecifiedStencilRef = o.PSSpecifiedStencilRefSupported;
+   shader.TypedUAVLoadAdditionalFormats = o.TypedUAVLoadAdditionalFormats;
+   shader.ROVs = o.ROVsSupported;
+   shader.WaveOps = o1.WaveOps;
+   /* valid even without wave operations: at least 4 */
+   shader.WaveLaneCountMin = o1.WaveLaneCountMin >= 4 ? o1.WaveLaneCountMin : 4;
+   shader.WaveLaneCountMax = o1.WaveLaneCountMax >= shader.WaveLaneCountMin ? o1.WaveLaneCountMax
+                                                                            : shader.WaveLaneCountMin;
+   shader.TotalLaneCount = o1.TotalLaneCount >= shader.WaveLaneCountMax ? o1.TotalLaneCount : shader.WaveLaneCountMax;
+   shader.Int64Ops = o1.Int64ShaderOps;
+   shader.Native16BitOps = o4.Native16BitShaderOpsSupported;
+   /* 0082: 64-bit atomics on typed resources and in group shared memory (shader model 6.6) */
+   D3D12_FEATURE_DATA_D3D12_OPTIONS9 o9 = {};
+   device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS9, &o9, sizeof(o9));
+   shader.AtomicInt64OnTypedResource = o9.AtomicInt64OnTypedResourceSupported;
+   shader.AtomicInt64OnGroupShared = o9.AtomicInt64OnGroupSharedSupported;
+
+   D3D12DDI_D3D12_OPTIONS_DATA_0081 &options = caps->options;
+   options.ResourceBindingTier = (D3D12DDI_RESOURCE_BINDING_TIER)o.ResourceBindingTier;
+   options.ConservativeRasterizationTier = (D3D12DDI_CONSERVATIVE_RASTERIZATION_TIER)o.ConservativeRasterizationTier;
+   options.TiledResourcesTier = (D3D12DDI_TILED_RESOURCES_TIER)o.TiledResourcesTier;
+   options.CrossNodeSharingTier = D3D12DDI_CROSS_NODE_SHARING_TIER_NOT_SUPPORTED;
+   options.VPAndRTArrayIndexFromAnyShaderFeedingRasterizerSupportedWithoutGSEmulation =
+      o.VPAndRTArrayIndexFromAnyShaderFeedingRasterizerSupportedWithoutGSEmulation;
+   options.OutputMergerLogicOp = o.OutputMergerLogicOp;
+   options.ResourceHeapTier = (D3D12DDI_RESOURCE_HEAP_TIER)o.ResourceHeapTier;
+   options.DepthBoundsTestSupported = o2.DepthBoundsTestSupported;
+   options.ProgrammableSamplePositionsTier =
+      (D3D12DDI_PROGRAMMABLE_SAMPLE_POSITIONS_TIER)o2.ProgrammableSamplePositionsTier;
+   options.CopyQueueTimestampQueriesSupported = o3.CopyQueueTimestampQueriesSupported;
+   /* WriteBufferImmediate isn't implemented yet */
+   options.WriteBufferImmediateQueueFlags = D3D12DDI_COMMAND_QUEUE_FLAG_NONE;
+   options.ViewInstancingTier = (D3D12DDI_VIEW_INSTANCING_TIER)o3.ViewInstancingTier;
+   options.BarycentricsSupported = o3.BarycentricsSupported;
+   options.ReservedBufferPlacementSupported = o4.MSAA64KBAlignedTextureSupported;
+   options.SRVOnlyTiledResourceTier3 = o5.SRVOnlyTiledResourceTier3;
+
+   /* the heaps the runtime makes out of DEFAULT/UPLOAD/READBACK follow this, vkd3d-proton's custom heaps too */
+   D3D12_FEATURE_DATA_ARCHITECTURE arch = {};
+   device->CheckFeatureSupport(D3D12_FEATURE_ARCHITECTURE, &arch, sizeof(arch));
+   caps->uma = arch.UMA;
+   caps->cacheCoherentUma = arch.CacheCoherentUMA;
+
+   D3D12_FEATURE_DATA_GPU_VIRTUAL_ADDRESS_SUPPORT va = {};
+   device->CheckFeatureSupport(D3D12_FEATURE_GPU_VIRTUAL_ADDRESS_SUPPORT, &va, sizeof(va));
+   caps->gpuvaBits = va.MaxGPUVirtualAddressBitsPerResource ? va.MaxGPUVirtualAddressBitsPerResource : 32;
+
+   /* the highest shader model DDI 0082 knows is 6.6 */
+   D3D12_FEATURE_DATA_SHADER_MODEL sm = {};
+   sm.HighestShaderModel = D3D_SHADER_MODEL_6_6;
+   if (FAILED(device->CheckFeatureSupport(D3D12_FEATURE_SHADER_MODEL, &sm, sizeof(sm))))
+      sm.HighestShaderModel = D3D_SHADER_MODEL_5_1;
+   caps->shaderModel = sm.HighestShaderModel;
+
+   /* What the runtime insists on: view instancing needs shader model 6.1, native 16-bit operations 6.2 */
+   if (caps->shaderModel < D3D_SHADER_MODEL_6_1)
+      options.ViewInstancingTier = D3D12DDI_VIEW_INSTANCING_TIER_NOT_SUPPORTED;
+   if (caps->shaderModel < D3D_SHADER_MODEL_6_2)
+      shader.Native16BitOps = FALSE;
+
+   viogpu_log("caps: pipeline level %d, shader model 0x%x, binding tier %d, heap tier %d, VA bits %u",
+              (int)caps->level, caps->shaderModel, (int)options.ResourceBindingTier, (int)options.ResourceHeapTier,
+              caps->gpuvaBits);
+}
+
+static const viogpu_caps *
+adapter_caps(viogpu_adapter *adapter)
+{
+   if (!adapter->caps) {
+      ID3D12Device *device = adapter_vkd3d(adapter);
+      if (!device)
+         return NULL;
+      adapter->caps = new (std::nothrow) viogpu_caps();
+      if (adapter->caps)
+         caps_from_vkd3d(device, adapter->caps);
+   }
+   return adapter->caps;
+}
+
+static HRESULT
+adapter_get_caps_answer(viogpu_adapter *adapter, const D3D12DDIARG_GETCAPS *caps);
+
+static HRESULT APIENTRY
+adapter_get_caps(D3D12DDI_HADAPTER hAdapter, const D3D12DDIARG_GETCAPS *caps)
+{
+   HRESULT hr = adapter_get_caps_answer((viogpu_adapter *)hAdapter.pDrvPrivate, caps);
+   viogpu_log("GetCaps: type %d, %u bytes: 0x%08lx", (int)caps->Type, caps->DataSize, (unsigned long)hr);
+   return hr;
+}
+
+static HRESULT
+adapter_get_caps_answer(viogpu_adapter *adapter, const D3D12DDIARG_GETCAPS *caps)
+{
+   const viogpu_caps *dev = adapter_caps(adapter);
+   if (!dev)
+      return adapter->vkd3dResult;
+
+   switch (caps->Type) {
+   case D3D12DDICAPS_TYPE_3DPIPELINESUPPORT:
+      return answer(caps, dev->level);
+
+   case D3D12DDICAPS_TYPE_0081_3DPIPELINESUPPORT1: {
+      D3D12DDI_3DPIPELINESUPPORT1_DATA_0081 *data = (D3D12DDI_3DPIPELINESUPPORT1_DATA_0081 *)caps->pData;
+      if (!data || caps->DataSize < sizeof(*data))
+         return E_INVALIDARG;
+      data->MaximumDriverSupportedFeatureLevel =
+         dev->level < data->HighestRuntimeSupportedFeatureLevel ? dev->level : data->HighestRuntimeSupportedFeatureLevel;
+      return S_OK;
+   }
+
+   case D3D12DDICAPS_TYPE_SHADER:
+      return answer(caps, dev->shader);
+
+   case D3D12DDICAPS_TYPE_D3D12_OPTIONS:
+      return answer(caps, dev->options);
+
+   case D3D12DDICAPS_TYPE_ARCHITECTURE_INFO: {
+      D3D12DDI_ARCHITECTURE_INFO_DATA info = {};
+      return answer(caps, info);
+   }
+
+   case D3D12DDICAPS_TYPE_MEMORY_ARCHITECTURE: {
+      /* vkd3d-proton's (its custom heaps follow it too). IOCoherent is required on x86/amd64: the runtime refuses
+       * the device otherwise */
+      D3D12DDI_MEMORY_ARCHITECTURE_CAPS_0041 memory = {};
+      memory.UMA = dev->uma;
+      memory.IOCoherent = TRUE;
+      memory.CacheCoherent = dev->cacheCoherentUma;
+      memory.HeapSerializationTier = D3D12DDI_HEAP_SERIALIZATION_TIER_0041_0;
+      memory.ResourceSerializationTier = D3D12DDI_RESOURCE_SERIALIZATION_TIER_0041_0;
+      return answer(caps, memory);
+   }
+
+   case D3D12DDICAPS_TYPE_GPUVA_CAPS: {
+      D3D12DDI_GPUVA_CAPS_0004 gpuva = {};
+      gpuva.MaxGPUVirtualAddressBitsPerResource = dev->gpuvaBits;
+      return answer(caps, gpuva);
+   }
+
+   case D3D12DDICAPS_TYPE_TEXTURE_LAYOUT: {
+      D3D12DDI_TEXTURE_LAYOUT_CAPS_0001 layout = {};
+      return answer(caps, layout);
+   }
+
+   case D3D12DDICAPS_TYPE_0022_TEXTURE_LAYOUT: {
+      D3D12DDI_TEXTURE_LAYOUT_CAPS_0026 layout = {};
+      return answer(caps, layout);
+   }
+
+   case D3D12DDICAPS_TYPE_TEXTURE_LAYOUT_SETS: {
+      /* pInfo = UINT[2] { layout, functional unit }: the only layout offered is row major (cross-adapter textures),
+       * with the alignments of D3D12's copy footprints */
+      const UINT *info = (const UINT *)caps->pInfo;
+      if (!info || info[0] != D3D12DDI_TL_ROW_MAJOR)
+         return E_NOTIMPL;
+      D3D12DDI_ROW_MAJOR_LAYOUT_CAPS layout = {};
+      layout.SubCaps[0].MaxElementSize = 0xFFFF;
+      layout.SubCaps[0].BaseOffsetAlignment = D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT;
+      layout.SubCaps[0].PitchAlignment = D3D12_TEXTURE_DATA_PITCH_ALIGNMENT;
+      layout.SubCaps[0].DepthPitchAlignment = D3D12_TEXTURE_DATA_PITCH_ALIGNMENT;
+      layout.Flags = D3D12DDI_ROW_MAJOR_LAYOUT_FLAG_NONE;
+      return answer(caps, layout);
+   }
+
+   case D3D12DDICAPS_TYPE_0011_SHADER_MODELS: {
+      /* every release model up to the highest: 5.1, then 6.x (the DDI's value is major << 16 | minor << 4 | 5) */
+      D3D12DDI_SHADER_MODEL models[8];
+      UINT count = 0;
+      models[count++] = D3D12DDI_SHADER_MODEL_5_1_RELEASE_0011;
+      for (UINT minor = 0; dev->shaderModel >= 0x60 + minor && minor <= 6; minor++)
+         models[count++] = (D3D12DDI_SHADER_MODEL)((6 << 16) | (minor << 4) | 5);
+      D3D12DDI_D3D12_SHADER_MODELS_DATA_0011 *data = (D3D12DDI_D3D12_SHADER_MODELS_DATA_0011 *)caps->pData;
+      if (!data || !data->pNumShaderModelsSupported)
+         return E_INVALIDARG;
+      if (data->pShaderModelsSupported) {
+         UINT n = *data->pNumShaderModelsSupported < count ? *data->pNumShaderModelsSupported : count;
+         memcpy(data->pShaderModelsSupported, models, n * sizeof(models[0]));
+      }
+      *data->pNumShaderModelsSupported = count;
+      return S_OK;
+   }
+
+   case D3D12DDICAPS_TYPE_0022_CPU_PAGE_TABLE_FALSE_POSITIVES:
+   case D3D12DDICAPS_TYPE_0023_UMD_BASED_COMMAND_QUEUE_PRIORITY:
+   case D3D12DDICAPS_TYPE_0033_ADAPTER_COMPUTE_ONLY:
+   case D3D12DDICAPS_TYPE_0050_HARDWARE_SCHEDULING_CAPS:
+   case D3D12DDICAPS_TYPE_EXECUTECOMMANDLISTS_PARALLELISM:
+   case D3D12DDICAPS_TYPE_0073_SUPPORT_BATCHED_MARKERS:
+      /* none of it: queue flags 0, not compute-only, no hardware scheduling, FALSE */
+      if (!caps->pData)
+         return E_INVALIDARG;
+      memset(caps->pData, 0, caps->DataSize);
+      return S_OK;
+
+   default:
+      return E_NOTIMPL;
+   }
+}
+
+static HRESULT APIENTRY
+adapter_get_optional_ddi_tables(D3D12DDI_HADAPTER, UINT32 *entries, D3D12DDI_TABLE_REQUEST *)
+{
+   *entries = 0;
+   return S_OK;
+}
+
+static SIZE_T APIENTRY
+adapter_calc_private_device_size(D3D12DDI_HADAPTER, const D3D12DDIARG_CALCPRIVATEDEVICESIZE *)
+{
+   return sizeof(viogpu_device);
+}
+
+static HRESULT APIENTRY
+adapter_create_device(D3D12DDI_HADAPTER hAdapter, const D3D12DDIARG_CREATEDEVICE_0003 *args)
+{
+   viogpu_adapter *adapter = (viogpu_adapter *)hAdapter.pDrvPrivate;
+   ID3D12Device *vkd3d = adapter_vkd3d(adapter);
+   if (!vkd3d)
+      return adapter->vkd3dResult;
+   viogpu_log("CreateDevice: interface 0x%x version 0x%x flags 0x%x", args->Interface, args->Version,
+              (UINT)args->Flags);
+   if (args->Interface != D3D12DDI_INTERFACE_VERSION_R5 && args->Interface != D3D12DDI_INTERFACE_VERSION_R8)
+      return E_INVALIDARG;
+   viogpu_device *device = new (args->hDrvDevice.pDrvPrivate) viogpu_device();
+   device->vkd3d = vkd3d;
+   vkd3d->AddRef();
+   InitializeCriticalSection(&device->presentLock);
+   device->hRTDevice = args->hRTDevice;
+   device->interfaceVersion = args->Interface;
+   device->version = args->Version;
+   device->ktCallbacks = args->pKTCallbacks;
+   device->umCallbacks = args->p12UMCallbacks_0050;
+   return S_OK;
+}
+
+static VOID APIENTRY
+adapter_destroy_device(D3D12DDI_HDEVICE hDevice)
+{
+   viogpu_log("DestroyDevice");
+   viogpu_device *device = (viogpu_device *)hDevice.pDrvPrivate;
+   viogpu_present_destroy(device);
+   DeleteCriticalSection(&device->presentLock);
+   device->vkd3d->Release();
+   device->~viogpu_device();
+}
+
+static HRESULT APIENTRY
+adapter_fill_ddi_table(D3D12DDI_HADAPTER, D3D12DDI_TABLE_TYPE type, VOID *table, SIZE_T size, UINT number,
+                       D3D12DDI_HRTTABLE hRTTable)
+{
+   viogpu_log("FillDDITable: type %d, %zu bytes, table %u", (int)type, size, number);
+   switch (type) {
+   case D3D12DDI_TABLE_TYPE_DEVICE_CORE: {
+      if (size < sizeof(D3D12DDI_DEVICE_FUNCS_CORE_0052))
+         return E_INVALIDARG;
+      FILL_STUBS(DEVICE, viogpu_device_funcs, table, size);
+      viogpu_device_funcs *funcs = (viogpu_device_funcs *)table;
+      funcs->pfnCheckFormatSupport = device_check_format_support;
+      funcs->pfnCheckMultisampleQualityLevels = device_check_multisample_quality_levels;
+      funcs->pfnGetImplicitPhysicalAdapterMask = device_get_implicit_physical_adapter_mask;
+      funcs->pfnQueryNodeMap = device_query_node_map;
+      viogpu_fill_state_funcs(funcs);
+      viogpu_fill_resource_funcs(funcs);
+      viogpu_fill_command_funcs(funcs);
+      return S_OK;
+   }
+   case D3D12DDI_TABLE_TYPE_COMMAND_LIST_3D:
+      FILL_STUBS(COMMAND_LIST, viogpu_command_list_funcs, table, size);
+      return viogpu_fill_command_list_table(table, size, number, hRTTable);
+   case D3D12DDI_TABLE_TYPE_COMMAND_QUEUE_3D:
+      FILL_STUBS(COMMAND_QUEUE, D3D12DDI_COMMAND_QUEUE_FUNCS_CORE_0001, table, size);
+      return viogpu_fill_command_queue_table(table, size);
+   case D3D12DDI_TABLE_TYPE_DXGI:
+      FILL_STUBS(DXGI, DXGI1_4_DDI_BASE_FUNCTIONS, table, size);
+      return S_OK;
+   case D3D12DDI_TABLE_TYPE_0020_EXTENDED_FEATURES: {
+      if (size < sizeof(D3D12DDI_EXTENDED_FEATURES_FUNCS_0020))
+         return E_INVALIDARG;
+      FILL_STUBS(EXTENDED_FEATURES, D3D12DDI_EXTENDED_FEATURES_FUNCS_0020, table, size);
+      D3D12DDI_EXTENDED_FEATURES_FUNCS_0020 *funcs = (D3D12DDI_EXTENDED_FEATURES_FUNCS_0020 *)table;
+      funcs->pfnGetSupportedExtendedFeatures = device_get_supported_extended_features;
+      funcs->pfnGetSupportedExtendedFeatureVersions = device_get_supported_extended_feature_versions;
+      funcs->pfnEnableExtendedFeature = device_enable_extended_feature;
+      return S_OK;
+   }
+   default:
+      /* video, content protection, shader cache, render passes, meta commands: not offered */
+      return E_UNEXPECTED;
+   }
+}
+
+static HRESULT APIENTRY
+adapter_close(D3D12DDI_HADAPTER hAdapter)
+{
+   viogpu_log("CloseAdapter");
+   viogpu_adapter *adapter = (viogpu_adapter *)hAdapter.pDrvPrivate;
+   if (adapter->vkd3d)
+      adapter->vkd3d->Release();
+   delete adapter->caps;
+   delete adapter;
+   return S_OK;
+}
+
+extern "C" __declspec(dllexport) HRESULT APIENTRY
+OpenAdapter12(D3D12DDIARG_OPENADAPTER *args)
+{
+   viogpu_log("OpenAdapter12");
+   viogpu_adapter *adapter = new (std::nothrow) viogpu_adapter();
+   if (!adapter)
+      return E_OUTOFMEMORY;
+   adapter->hRTAdapter = args->hRTAdapter;
+   adapter->callbacks = args->pAdapterCallbacks;
+
+   D3D12DDI_ADAPTERFUNCS *funcs = args->pAdapterFuncs;
+   funcs->pfnCalcPrivateDeviceSize = adapter_calc_private_device_size;
+   funcs->pfnCreateDevice = adapter_create_device;
+   funcs->pfnCloseAdapter = adapter_close;
+   funcs->pfnGetSupportedVersions = adapter_get_supported_versions;
+   funcs->pfnGetCaps = adapter_get_caps;
+   funcs->pfnGetOptionalDDITables = adapter_get_optional_ddi_tables;
+   funcs->pfnFillDDITable = adapter_fill_ddi_table;
+   funcs->pfnDestroyDevice = adapter_destroy_device;
+   args->hAdapter.pDrvPrivate = adapter;
+   return S_OK;
+}
diff --git a/libs/viogpu_umd/umd_private.h b/libs/viogpu_umd/umd_private.h
new file mode 100644
--- /dev/null
+++ b/libs/viogpu_umd/umd_private.h
@@ -0,0 +1,127 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/* Shared by the files of viogpu's Direct3D 12 user-mode driver (umd_ddi.cpp has the overview) */
+
+#ifndef VIOGPU_UMD_PRIVATE_H
+#define VIOGPU_UMD_PRIVATE_H
+
+#include "umd_compat.h"
+#include <stdio.h>
+#include <stdarg.h>
+#include <string.h>
+#include <new>
+
+#define D3D10DDI_MINOR_HEADER_VERSION 2
+/* d3d10umddi.h defines the D3D10 constants as variables: d3d10_1.h first avoids duplicate symbols */
+#include <d3d10_1.h>
+#include <d3d12.h>
+#include <d3d10umddi.h>
+#include <d3d12umddi.h>
+
+#include "umd_bridge.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+void viogpu_log(const char *format, ...);
+
+/* The tables of the newest DDI version the driver offers (umd_ddi.cpp); a runtime of an older version gets the part
+ * its own tables have (the tables only grow, and arguments of a newer version extend the older ones) */
+typedef D3D12DDI_DEVICE_FUNCS_CORE_0080 viogpu_device_funcs;
+typedef D3D12DDI_COMMAND_LIST_FUNCS_3D_0074 viogpu_command_list_funcs;
+
+struct viogpu_device {
+   /* vkd3d-proton's device (the adapter's, referenced) */
+   ID3D12Device *vkd3d;
+   /* presents: copies of swap chain buffers into their kernel allocations (umd_command.cpp) */
+   CRITICAL_SECTION presentLock;
+   ID3D12CommandQueue *presentQueue;
+   ID3D12CommandAllocator *presentAllocator;
+   ID3D12GraphicsCommandList *presentList;
+   ID3D12Fence *presentFence;
+   UINT64 presentFenceValue;
+   D3D12DDI_HRTDEVICE hRTDevice;
+   UINT interfaceVersion;
+   UINT version;
+   const D3DDDI_DEVICECALLBACKS *ktCallbacks;
+   const D3D12DDI_CORELAYER_DEVICECALLBACKS_0050 *umCallbacks;
+};
+
+static inline viogpu_device *
+device_from(D3D12DDI_HDEVICE h)
+{
+   return (viogpu_device *)h.pDrvPrivate;
+}
+
+/* Device-level errors from DDIs without a return value */
+void viogpu_device_error(viogpu_device *device, HRESULT hr);
+
+/* Objects other files reach (each lives in the runtime's memory at its handle's pDrvPrivate) */
+
+/* A heap: from CreateHeap (heap; mapBuffer spans it when the CPU can map it), or the implicit heap of a committed
+ * resource (committed borrows the resource) */
+struct viogpu_resource;
+
+struct viogpu_heap {
+   ID3D12Heap *heap;
+   ID3D12Resource *committed;
+   struct viogpu_resource *committedResource;
+   ID3D12Resource *mapBuffer;
+   void *mapped;
+};
+
+/* A swap chain buffer (a committed texture on a "primary" heap) also has a kernel allocation, a virgl texture DWM
+ * opens: presents copy the image into it, through a readback buffer */
+struct viogpu_resource {
+   ID3D12Resource *resource;
+   D3D12_RESOURCE_DESC desc;
+   D3D12DDI_HRTRESOURCE hRT;
+   D3DKMT_HANDLE kmAllocation;
+   UINT kmPitch;
+   ID3D12Resource *readback;
+};
+
+struct viogpu_descriptor_heap {
+   ID3D12DescriptorHeap *heap;
+};
+
+struct viogpu_query_heap {
+   ID3D12QueryHeap *heap;
+};
+
+struct viogpu_command_signature {
+   ID3D12CommandSignature *signature;
+};
+
+static inline ID3D12Resource *
+resource_of(D3D12DDI_HRESOURCE h)
+{
+   return h.pDrvPrivate ? ((viogpu_resource *)h.pDrvPrivate)->resource : NULL;
+}
+
+static inline ID3D12Heap *
+heap_of(D3D12DDI_HHEAP h)
+{
+   return h.pDrvPrivate ? ((viogpu_heap *)h.pDrvPrivate)->heap : NULL;
+}
+
+/* umd_state.cpp: shaders, input layouts, blend/depth-stencil/rasterizer states, root signatures, pipeline states */
+void viogpu_fill_state_funcs(viogpu_device_funcs *funcs);
+ID3D12RootSignature *viogpu_root_signature_of(D3D12DDI_HROOTSIGNATURE h);
+ID3D12PipelineState *viogpu_pipeline_state_of(D3D12DDI_HPIPELINESTATE h);
+
+/* umd_resource.cpp: heaps, resources, descriptor heaps and views, query heaps, command signatures, residency */
+void viogpu_fill_resource_funcs(viogpu_device_funcs *funcs);
+
+/* umd_command.cpp: command pools, recorders, lists and queues, fences, presents */
+void viogpu_present_destroy(viogpu_device *device);
+void viogpu_fill_command_funcs(viogpu_device_funcs *funcs);
+HRESULT viogpu_fill_command_list_table(void *table, SIZE_T size, UINT number, D3D12DDI_HRTTABLE hRTTable);
+HRESULT viogpu_fill_command_queue_table(void *table, SIZE_T size);
+extern D3D12DDI_HRTTABLE viogpu_command_list_rt_tables[2];
+
+#endif
diff --git a/libs/viogpu_umd/umd_resource.cpp b/libs/viogpu_umd/umd_resource.cpp
new file mode 100644
--- /dev/null
+++ b/libs/viogpu_umd/umd_resource.cpp
@@ -0,0 +1,1008 @@
+/*
+ * Copyright 2026 WinBoat contributors
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+/* Heaps and resources, descriptor heaps and views, query heaps, command signatures, residency.
+ *
+ * Descriptor handles, descriptor sizes and GPU virtual addresses are vkd3d-proton's own: the runtime only hands them
+ * back, so they pass through unchanged. The DDI's heap is always "custom" (memory pool + CPU page property, each one
+ * below the API's values), says which resources it allows where the API says which it denies, and its views say
+ * "2D" for 2D, 2D array and multisampled alike: the resource's desc tells which. */
+
+#include "umd_private.h"
+#include "umd_viogpu.h"
+#include <stdlib.h>
+
+/* ---------------------------------------------------------------------------------------------------------------- */
+/* Heaps and resources */
+
+static D3D12_HEAP_PROPERTIES
+heap_properties(const D3D12DDIARG_CREATEHEAP_0001 *desc)
+{
+   D3D12_HEAP_PROPERTIES p = {};
+   p.Type = D3D12_HEAP_TYPE_CUSTOM;
+   p.CPUPageProperty = (D3D12_CPU_PAGE_PROPERTY)(desc->CPUPageProperty + 1);
+   p.MemoryPoolPreference = (D3D12_MEMORY_POOL)(desc->MemoryPool + 1);
+   p.CreationNodeMask = desc->CreationNodeMask;
+   p.VisibleNodeMask = desc->VisibleNodeMask;
+   return p;
+}
+
+static D3D12_HEAP_FLAGS
+heap_flags(const D3D12DDIARG_CREATEHEAP_0001 *desc)
+{
+   D3D12_HEAP_FLAGS f = D3D12_HEAP_FLAG_NONE;
+   if (!(desc->Flags & D3D12DDI_HEAP_FLAG_BUFFERS))
+      f |= D3D12_HEAP_FLAG_DENY_BUFFERS;
+   if (!(desc->Flags & D3D12DDI_HEAP_FLAG_RT_DS_TEXTURES))
+      f |= D3D12_HEAP_FLAG_DENY_RT_DS_TEXTURES;
+   if (!(desc->Flags & D3D12DDI_HEAP_FLAG_NON_RT_DS_TEXTURES))
+      f |= D3D12_HEAP_FLAG_DENY_NON_RT_DS_TEXTURES;
+   if (desc->Flags & D3D12DDI_HEAP_FLAG_PRIMARY)
+      f |= D3D12_HEAP_FLAG_ALLOW_DISPLAY;
+   if (desc->Flags & D3D12DDI_HEAP_FLAG_COHERENT_SYSTEMWIDE)
+      f |= D3D12_HEAP_FLAG_SHARED_CROSS_ADAPTER | D3D12_HEAP_FLAG_SHARED;
+   return f;
+}
+
+static D3D12_RESOURCE_DESC
+resource_desc(const D3D12DDIARG_CREATERESOURCE_0075 *r)
+{
+   D3D12_RESOURCE_DESC d = {};
+   d.Dimension = (D3D12_RESOURCE_DIMENSION)r->ResourceType;
+   d.Alignment = 0;
+   d.Width = r->Width;
+   d.Height = r->Height;
+   d.DepthOrArraySize = r->DepthOrArraySize;
+   d.MipLevels = r->MipLevels;
+   d.Format = r->Format;
+   d.SampleDesc = r->SampleDesc;
+   d.Layout = (D3D12_TEXTURE_LAYOUT)r->Layout;
+   D3D12_RESOURCE_FLAGS f = D3D12_RESOURCE_FLAG_NONE;
+   if (r->Flags & D3D12DDI_RESOURCE_FLAG_0003_RENDER_TARGET)
+      f |= D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+   if (r->Flags & D3D12DDI_RESOURCE_FLAG_0003_DEPTH_STENCIL) {
+      f |= D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
+      if (!(r->Flags & D3D12DDI_RESOURCE_FLAG_0003_SHADER_RESOURCE))
+         f |= D3D12_RESOURCE_FLAG_DENY_SHADER_RESOURCE;
+   }
+   if (r->Flags & D3D12DDI_RESOURCE_FLAG_0022_UNORDERED_ACCESS)
+      f |= D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+   if (r->Flags & D3D12DDI_RESOURCE_FLAG_0003_CROSS_ADAPTER)
+      f |= D3D12_RESOURCE_FLAG_ALLOW_CROSS_ADAPTER;
+   if (r->Flags & D3D12DDI_RESOURCE_FLAG_0003_SIMULTANEOUS_ACCESS)
+      f |= D3D12_RESOURCE_FLAG_ALLOW_SIMULTANEOUS_ACCESS;
+   if (r->Flags & D3D12DDI_RESOURCE_FLAG_0020_VIDEO_DECODE_REFERENCE_ONLY)
+      f |= D3D12_RESOURCE_FLAG_VIDEO_DECODE_REFERENCE_ONLY;
+   if (r->Flags & D3D12DDI_RESOURCE_FLAG_0080_VIDEO_ENCODE_REFERENCE_ONLY)
+      f |= D3D12_RESOURCE_FLAG_VIDEO_ENCODE_REFERENCE_ONLY;
+   if (r->Flags & D3D12DDI_RESOURCE_FLAG_0088_RAYTRACING_ACCELERATION_STRUCTURE)
+      f |= D3D12_RESOURCE_FLAG_RAYTRACING_ACCELERATION_STRUCTURE;
+   d.Flags = f;
+   return d;
+}
+
+/* A swap chain buffer's kernel allocation: a virgl texture of its size and format, which DWM's driver opens (as it
+ * would one of the D3D10/11 driver's) and the kernel driver uploads before each use (a "GDI surface") */
+static ULONG
+virgl_format(DXGI_FORMAT format, UINT *bytes)
+{
+   *bytes = 4;
+   switch (format) {
+   case DXGI_FORMAT_B8G8R8A8_UNORM: return VIOGPU_UMD_VIRGL_FORMAT_B8G8R8A8_UNORM;
+   case DXGI_FORMAT_B8G8R8X8_UNORM: return VIOGPU_UMD_VIRGL_FORMAT_B8G8R8X8_UNORM;
+   case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB: return VIOGPU_UMD_VIRGL_FORMAT_B8G8R8A8_SRGB;
+   case DXGI_FORMAT_R8G8B8A8_UNORM: return VIOGPU_UMD_VIRGL_FORMAT_R8G8B8A8_UNORM;
+   case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB: return VIOGPU_UMD_VIRGL_FORMAT_R8G8B8A8_SRGB;
+   case DXGI_FORMAT_R10G10B10A2_UNORM: return VIOGPU_UMD_VIRGL_FORMAT_R10G10B10A2_UNORM;
+   case DXGI_FORMAT_R16G16B16A16_FLOAT: *bytes = 8; return VIOGPU_UMD_VIRGL_FORMAT_R16G16B16A16_FLOAT;
+   default: return 0;
+   }
+}
+
+static HRESULT
+create_km_allocation(viogpu_device *device, viogpu_resource *res)
+{
+   UINT bytes;
+   ULONG format = virgl_format(res->desc.Format, &bytes);
+   if (!format || res->desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D) {
+      viogpu_log("swap chain buffer: format %d not presentable", (int)res->desc.Format);
+      return S_OK;
+   }
+   VIOGPU_UMD_CREATE_ALLOCATION_EXCHANGE allocation = {};
+   allocation.ResourceOptions.target = VIOGPU_UMD_PIPE_TEXTURE_2D;
+   allocation.ResourceOptions.format = format;
+   allocation.ResourceOptions.bind = VIOGPU_UMD_VIRGL_BIND_RENDER_TARGET | VIOGPU_UMD_VIRGL_BIND_SAMPLER_VIEW;
+   allocation.ResourceOptions.width = (ULONG)res->desc.Width;
+   allocation.ResourceOptions.height = res->desc.Height;
+   allocation.ResourceOptions.depth = 1;
+   allocation.ResourceOptions.array_size = 1;
+   allocation.ResourceOptions.flags = VIOGPU_UMD_VIRGL_RESOURCE_FLAG_MAP_COHERENT | VIOGPU_UMD_RESOURCE_FLAG_GDI_SURFACE;
+   allocation.Size = res->desc.Width * res->desc.Height * bytes;
+   VIOGPU_UMD_CREATE_RESOURCE_EXCHANGE resource = {};
+
+   D3D12DDI_ALLOCATION_INFO_0022 info = {};
+   info.pPrivateDriverData = &allocation;
+   info.PrivateDriverDataSize = sizeof(allocation);
+   D3D12DDICB_ALLOCATE_0022 allocate = {};
+   allocate.pPrivateDriverData = &resource;
+   allocate.PrivateDriverDataSize = sizeof(resource);
+   /* the runtime's resource: it shares it with DWM and keeps it resident (through MakeResident) */
+   allocate.hResource = (HANDLE)res->hRT.handle;
+   allocate.NumAllocations = 1;
+   allocate.pAllocationInfo = &info;
+   HRESULT hr = device->umCallbacks->pfnAllocateCb(device->hRTDevice, &allocate);
+   if (FAILED(hr)) {
+      viogpu_log("swap chain buffer allocation: 0x%08lx", (unsigned long)hr);
+      return hr;
+   }
+   res->kmAllocation = info.hAllocation;
+   res->kmPitch = (UINT)res->desc.Width * bytes;
+   return S_OK;
+}
+
+static D3D12DDI_HEAP_AND_RESOURCE_SIZES APIENTRY
+calc_heap_and_resource_sizes(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATEHEAP_0001 *, const D3D12DDIARG_CREATERESOURCE_0075 *,
+                             D3D12DDI_HPROTECTEDRESOURCESESSION_0030)
+{
+   D3D12DDI_HEAP_AND_RESOURCE_SIZES sizes = {};
+   sizes.Heap = sizeof(viogpu_heap);
+   sizes.Resource = sizeof(viogpu_resource);
+   return sizes;
+}
+
+/* Committed (heap desc + resource desc), a heap (heap desc only), placed (resource desc into the existing heap
+ * hHeap, at ReuseBufferGPUVA's offset) or reserved (resource desc only) */
+static HRESULT APIENTRY
+create_heap_and_resource(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATEHEAP_0001 *heapDesc, D3D12DDI_HHEAP hHeap,
+                         D3D12DDI_HRTRESOURCE hRTResource, const D3D12DDIARG_CREATERESOURCE_0075 *resDesc,
+                         const D3D12DDI_CLEAR_VALUES *clear, D3D12DDI_HPROTECTEDRESOURCESESSION_0030,
+                         D3D12DDI_HRESOURCE hResource)
+{
+   viogpu_device *device = device_from(hDevice);
+   const D3D12_CLEAR_VALUE *clearValue = (const D3D12_CLEAR_VALUE *)clear;
+   HRESULT hr = S_OK;
+   if (getenv("VIOGPU_D3D12_TRACE_RESOURCES"))
+      viogpu_log("CreateHeapAndResource: heap %s (pool %d, cpu %d, flags 0x%x, %llu bytes), heap handle %p, rt %p, "
+                 "resource %s (type %d, %llux%u, format %d, flags 0x%x, layout %d)",
+                 heapDesc ? "yes" : "no", heapDesc ? (int)heapDesc->MemoryPool : -1,
+                 heapDesc ? (int)heapDesc->CPUPageProperty : -1, heapDesc ? (UINT)heapDesc->Flags : 0,
+                 heapDesc ? (unsigned long long)heapDesc->ByteSize : 0ull, hHeap.pDrvPrivate, hRTResource.handle,
+                 resDesc ? "yes" : "no", resDesc ? (int)resDesc->ResourceType : 0,
+                 resDesc ? (unsigned long long)resDesc->Width : 0ull, resDesc ? resDesc->Height : 0,
+                 resDesc ? (int)resDesc->Format : 0, resDesc ? (UINT)resDesc->Flags : 0,
+                 resDesc ? (int)resDesc->Layout : 0);
+
+   viogpu_resource *res = NULL;
+   D3D12_RESOURCE_DESC desc = {};
+   D3D12_RESOURCE_STATES state = D3D12_RESOURCE_STATE_COMMON;
+   if (resDesc) {
+      res = new (hResource.pDrvPrivate) viogpu_resource();
+      res->hRT = hRTResource;
+      desc = resource_desc(resDesc);
+      state = (D3D12_RESOURCE_STATES)resDesc->InitialResourceState;
+      /* clear values only for render targets and depth-stencil buffers */
+      if (!(desc.Flags & (D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET | D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL)))
+         clearValue = NULL;
+   }
+
+   if (heapDesc && resDesc) {
+      viogpu_heap *heap = new (hHeap.pDrvPrivate) viogpu_heap();
+      D3D12_HEAP_PROPERTIES props = heap_properties(heapDesc);
+      hr = device->vkd3d->CreateCommittedResource(&props, D3D12_HEAP_FLAG_NONE, &desc, state, clearValue,
+                                                   IID_PPV_ARGS(&res->resource));
+      heap->committed = res->resource;
+      heap->committedResource = res;
+      if (SUCCEEDED(hr) && (heapDesc->Flags & D3D12DDI_HEAP_FLAG_PRIMARY)) {
+         res->desc = res->resource->GetDesc();
+         hr = create_km_allocation(device, res);
+      }
+   } else if (heapDesc) {
+      viogpu_heap *heap = new (hHeap.pDrvPrivate) viogpu_heap();
+      D3D12_HEAP_DESC hd = {};
+      hd.SizeInBytes = heapDesc->ByteSize;
+      hd.Properties = heap_properties(heapDesc);
+      hd.Alignment = heapDesc->Alignment;
+      hd.Flags = heap_flags(heapDesc);
+      hr = device->vkd3d->CreateHeap(&hd, IID_PPV_ARGS(&heap->heap));
+      /* MapHeap maps the whole heap: a buffer over all of it, where the CPU can map it and buffers may live */
+      if (SUCCEEDED(hr) && hd.Properties.CPUPageProperty != D3D12_CPU_PAGE_PROPERTY_NOT_AVAILABLE &&
+          !(hd.Flags & D3D12_HEAP_FLAG_DENY_BUFFERS)) {
+         D3D12_RESOURCE_DESC bd = {};
+         bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+         bd.Width = heapDesc->ByteSize;
+         bd.Height = 1;
+         bd.DepthOrArraySize = 1;
+         bd.MipLevels = 1;
+         bd.SampleDesc.Count = 1;
+         bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+         if (FAILED(device->vkd3d->CreatePlacedResource(heap->heap, 0, &bd, D3D12_RESOURCE_STATE_COMMON, NULL,
+                                                        IID_PPV_ARGS(&heap->mapBuffer))))
+            heap->mapBuffer = NULL;
+      }
+   } else if (resDesc && hHeap.pDrvPrivate) {
+      viogpu_heap *heap = (viogpu_heap *)hHeap.pDrvPrivate;
+      hr = device->vkd3d->CreatePlacedResource(heap->heap, resDesc->ReuseBufferGPUVA.BaseAddress.UMD.Offset, &desc,
+                                               state, clearValue, IID_PPV_ARGS(&res->resource));
+   } else if (resDesc) {
+      hr = device->vkd3d->CreateReservedResource(&desc, state, clearValue, IID_PPV_ARGS(&res->resource));
+   }
+
+   if (res && res->resource)
+      res->desc = res->resource->GetDesc();
+   if (FAILED(hr))
+      viogpu_log("CreateHeapAndResource (heap %d, resource %d, dimension %d, %llux%u, format %d): 0x%08lx",
+                 heapDesc != NULL, resDesc != NULL, resDesc ? (int)resDesc->ResourceType : 0,
+                 resDesc ? (unsigned long long)resDesc->Width : 0ull, resDesc ? resDesc->Height : 0,
+                 resDesc ? (int)resDesc->Format : 0, (unsigned long)hr);
+   return hr;
+}
+
+static VOID APIENTRY
+destroy_heap_and_resource(D3D12DDI_HDEVICE hDevice, D3D12DDI_HHEAP hHeap, D3D12DDI_HRESOURCE hResource)
+{
+   if (hResource.pDrvPrivate) {
+      viogpu_resource *res = (viogpu_resource *)hResource.pDrvPrivate;
+      if (res->kmAllocation) {
+         viogpu_device *device = device_from(hDevice);
+         D3D12DDICB_DEALLOCATE_0022 deallocate = {};
+         deallocate.NumAllocations = 1;
+         deallocate.HandleList = &res->kmAllocation;
+         device->umCallbacks->pfnDeallocateCb(device->hRTDevice, &deallocate);
+      }
+      if (res->readback)
+         res->readback->Release();
+      if (res->resource)
+         res->resource->Release();
+      res->~viogpu_resource();
+   }
+   if (hHeap.pDrvPrivate) {
+      /* a committed resource's heap only borrows it */
+      viogpu_heap *heap = (viogpu_heap *)hHeap.pDrvPrivate;
+      if (heap->mapBuffer)
+         heap->mapBuffer->Release();
+      if (heap->heap)
+         heap->heap->Release();
+      heap->~viogpu_heap();
+   }
+}
+
+static HRESULT APIENTRY
+map_heap(D3D12DDI_HDEVICE, D3D12DDI_HHEAP hHeap, VOID **data)
+{
+   viogpu_heap *heap = (viogpu_heap *)hHeap.pDrvPrivate;
+   if (!heap->mapped) {
+      ID3D12Resource *buffer = heap->committed ? heap->committed : heap->mapBuffer;
+      if (!buffer)
+         return E_INVALIDARG;
+      HRESULT hr = buffer->Map(0, NULL, &heap->mapped);
+      if (FAILED(hr)) {
+         viogpu_log("MapHeap: 0x%08lx", (unsigned long)hr);
+         return hr;
+      }
+   }
+   *data = heap->mapped;
+   return S_OK;
+}
