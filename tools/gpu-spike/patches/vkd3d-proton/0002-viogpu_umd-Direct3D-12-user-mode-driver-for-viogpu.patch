+static HRESULT APIENTRY
+create_query_heap(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_QUERY_HEAP_0001 *args, D3D12DDI_HQUERYHEAP h)
+{
+   viogpu_query_heap *heap = new (h.pDrvPrivate) viogpu_query_heap();
