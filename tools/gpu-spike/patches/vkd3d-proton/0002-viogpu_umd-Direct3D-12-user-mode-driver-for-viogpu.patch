+static VOID APIENTRY
+copy_texture_region(D3D12DDI_HCOMMANDLIST h, const D3D12DDIARG_BUFFER_PLACEMENT *dst,
+                    D3D12DDIARG_PLACED_RESOURCE dstLayout, UINT dstX, UINT dstY, UINT dstZ,
+                    const D3D12DDIARG_BUFFER_PLACEMENT *src, D3D12DDIARG_PLACED_RESOURCE srcLayout,
+                    const D3D12DDI_BOX *srcBox)
