+static SIZE_T APIENTRY
+calc_command_queue_size(D3D12DDI_HDEVICE, const D3D12DDIARG_CREATECOMMANDQUEUE_0050 *)
+{
+   return sizeof(viogpu_command_queue);
+}
+
+static HRESULT APIENTRY
+create_command_queue(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATECOMMANDQUEUE_0050 *args,
+                     D3D12DDI_HCOMMANDQUEUE h, D3D12DDI_HRTCOMMANDQUEUE hRT)
+{
+   viogpu_device *device = device_from(hDevice);
+   viogpu_command_queue *queue = new (h.pDrvPrivate) viogpu_command_queue();
+   queue->device = device;
+   queue->hRT = hRT;
+   queue->gateNext = queue->doneNext = 1;
+   InitializeCriticalSection(&queue->lock);
+   InitializeConditionVariable(&queue->wake);
+
+   D3D12_COMMAND_QUEUE_DESC desc = {};
+   desc.Type = list_type(D3D12DDI_COMMAND_LIST_TYPE_DIRECT, args->QueueFlags);
+   desc.Priority = (args->QueueCreationFlags & D3D12DDI_COMMAND_QUEUE_CREATION_FLAG_GLOBAL_REALTIME_PRIORITY)
+                      ? D3D12_COMMAND_QUEUE_PRIORITY_GLOBAL_REALTIME
+                      : D3D12_COMMAND_QUEUE_PRIORITY_NORMAL;
+   desc.NodeMask = args->NodeMask;
+   HRESULT hr = device->vkd3d->CreateCommandQueue(&desc, IID_PPV_ARGS(&queue->queue));
+   if (SUCCEEDED(hr))
+      hr = device->vkd3d->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&queue->gate));
+   if (SUCCEEDED(hr))
+      hr = device->vkd3d->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&queue->done));
+   if (SUCCEEDED(hr)) {
+      D3DDDICB_CREATECONTEXTVIRTUAL context = {};
+      context.NodeOrdinal = 0;
+      context.EngineAffinity = 1;
+      hr = device->umCallbacks->pfnCreateContextVirtualCb(hRT, &context);
+      queue->hContext = context.hContext;
+   }
+   if (SUCCEEDED(hr))
+      hr = km_fence_create(device, &queue->kmIn, &queue->kmInValue);
+   if (SUCCEEDED(hr))
+      hr = km_fence_create(device, &queue->kmOut, NULL);
+   if (SUCCEEDED(hr)) {
+      queue->gateThread = CreateThread(NULL, 0, gate_thread, queue, 0, NULL);
+      queue->doneThread = CreateThread(NULL, 0, done_thread, queue, 0, NULL);
+      if (!queue->gateThread || !queue->doneThread)
+         hr = E_OUTOFMEMORY;
+   }
+   if (FAILED(hr))
+      viogpu_log("CreateCommandQueue (flags 0x%x): 0x%08lx", (UINT)args->QueueFlags, (unsigned long)hr);
+   return hr;
+}
+
+static VOID APIENTRY
+destroy_command_queue(D3D12DDI_HDEVICE, D3D12DDI_HCOMMANDQUEUE h)
+{
+   viogpu_command_queue *queue = (viogpu_command_queue *)h.pDrvPrivate;
+   viogpu_device *device = queue->device;
+   /* the runtime waits for the queue before destroying it: the threads have nothing left to do */
+   if (queue->done)
+      queue_wait_idle(queue);
+   EnterCriticalSection(&queue->lock);
+   queue->stop = true;
+   LeaveCriticalSection(&queue->lock);
+   WakeAllConditionVariable(&queue->wake);
+   for (HANDLE t : {queue->gateThread, queue->doneThread}) {
+      if (t) {
+         WaitForSingleObject(t, INFINITE);
+         CloseHandle(t);
+      }
+   }
+   km_fence_destroy(device, queue->kmIn);
+   km_fence_destroy(device, queue->kmOut);
+   if (queue->hContext) {
+      D3DDDICB_DESTROYCONTEXT destroy = {};
+      destroy.hContext = queue->hContext;
+      device->umCallbacks->pfnDestroyContextCb(queue->hRT, &destroy);
+   }
+   if (queue->done)
+      queue->done->Release();
+   if (queue->gate)
+      queue->gate->Release();
+   if (queue->queue)
+      queue->queue->Release();
+   DeleteCriticalSection(&queue->lock);
+   queue->~viogpu_command_queue();
+}
+
+/* temporary timing */
+
+static VOID APIENTRY
+execute_command_lists(D3D12DDI_HCOMMANDQUEUE h, UINT count, const D3D12DDI_HCOMMANDLIST *lists)
+{
+   viogpu_command_queue *queue = (viogpu_command_queue *)h.pDrvPrivate;
+   viogpu_device *device = queue->device;
+   std::vector<ID3D12CommandList *> api(count);
+   for (UINT i = 0; i < count; i++)
+      api[i] = list_from(lists[i])->list;
+
+   EnterCriticalSection(&queue->lock);
+   UINT64 n = queue->submitted + 1;
+   /* its place on the kernel context (see viogpu_command_queue) */
+   D3DDDICB_SIGNALSYNCHRONIZATIONOBJECTFROMGPU signal = {};
+   signal.hContext = queue->hContext;
+   signal.ObjectCount = 1;
+   signal.ObjectHandleArray = &queue->kmIn;
+   signal.MonitoredFenceValueArray = &n;
+   HRESULT hr = device->ktCallbacks->pfnSignalSynchronizationObjectFromGpuCb(device->hRTDevice.handle, &signal);
+   /* vkd3d-proton takes the lists now (the application may reset them right away) and runs them once the gate
+    * opens */
+   if (SUCCEEDED(hr))
+      hr = queue->queue->Wait(queue->gate, n);
+   if (SUCCEEDED(hr)) {
+      queue->queue->ExecuteCommandLists(count, api.data());
+      hr = queue->queue->Signal(queue->done, n);
+   }
+   if (SUCCEEDED(hr)) {
+      D3DDDICB_WAITFORSYNCHRONIZATIONOBJECTFROMGPU wait = {};
+      wait.hContext = queue->hContext;
+      wait.ObjectCount = 1;
+      wait.ObjectHandleArray = &queue->kmOut;
+      wait.MonitoredFenceValueArray = &n;
+      hr = device->ktCallbacks->pfnWaitForSynchronizationObjectFromGpuCb(device->hRTDevice.handle, &wait);
+      queue->submitted = n;
+   }
+   LeaveCriticalSection(&queue->lock);
+   WakeAllConditionVariable(&queue->wake);
+   if (FAILED(hr))
+      viogpu_device_error(device, hr);
+}
