+static VOID APIENTRY
+create_uav(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_UNORDERED_ACCESS_VIEW_0002 *args,
+           D3D12DDI_CPU_DESCRIPTOR_HANDLE dest)
+{
+   viogpu_resource *res = (viogpu_resource *)args->hDrvResource.pDrvPrivate;
+   ID3D12Resource *counter = NULL;
+   D3D12_UNORDERED_ACCESS_VIEW_DESC d = {};
+   d.Format = args->Format;
+   bool array = resource_is_array(res);
+   switch (args->ResourceDimension) {
+   case D3D12DDI_RD_BUFFER:
+      d.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+      d.Buffer.FirstElement = args->Buffer.FirstElement;
+      d.Buffer.NumElements = args->Buffer.NumElements;
+      d.Buffer.StructureByteStride = args->Buffer.StructureByteStride;
+      d.Buffer.CounterOffsetInBytes = args->Buffer.CounterOffsetInBytes;
+      d.Buffer.Flags = (D3D12_BUFFER_UAV_FLAGS)args->Buffer.Flags;
+      counter = resource_of(args->Buffer.hDrvCounterResource);
+      break;
+   case D3D12DDI_RD_TEXTURE1D:
+      if (array) {
+         d.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE1DARRAY;
+         d.Texture1DArray.MipSlice = args->Tex1D.MipSlice;
+         d.Texture1DArray.FirstArraySlice = args->Tex1D.FirstArraySlice;
+         d.Texture1DArray.ArraySize = args->Tex1D.ArraySize;
+      } else {
+         d.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE1D;
+         d.Texture1D.MipSlice = args->Tex1D.MipSlice;
+      }
+      break;
+   case D3D12DDI_RD_TEXTURE2D:
+      if (array) {
+         d.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2DARRAY;
+         d.Texture2DArray.MipSlice = args->Tex2D.MipSlice;
+         d.Texture2DArray.FirstArraySlice = args->Tex2D.FirstArraySlice;
+         d.Texture2DArray.ArraySize = args->Tex2D.ArraySize;
+         d.Texture2DArray.PlaneSlice = args->Tex2D.PlaneSlice;
+      } else {
+         d.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+         d.Texture2D.MipSlice = args->Tex2D.MipSlice;
+         d.Texture2D.PlaneSlice = args->Tex2D.PlaneSlice;
+      }
+      break;
+   case D3D12DDI_RD_TEXTURE3D:
+      d.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE3D;
+      d.Texture3D.MipSlice = args->Tex3D.MipSlice;
+      d.Texture3D.FirstWSlice = args->Tex3D.FirstW;
+      d.Texture3D.WSize = args->Tex3D.WSize;
+      break;
+   default:
+      viogpu_log("CreateUnorderedAccessView: dimension %d", (int)args->ResourceDimension);
+      return;
+   }
+   device_from(hDevice)->vkd3d->CreateUnorderedAccessView(res ? res->resource : NULL, counter, &d, cpu_handle(dest));
+}
+
+static VOID APIENTRY
+create_rtv(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_RENDER_TARGET_VIEW_0002 *args,
+           D3D12DDI_CPU_DESCRIPTOR_HANDLE dest)
+{
+   viogpu_resource *res = (viogpu_resource *)args->hDrvResource.pDrvPrivate;
+   D3D12_RENDER_TARGET_VIEW_DESC d = {};
+   d.Format = args->Format;
+   bool array = resource_is_array(res);
+   switch (args->ResourceDimension) {
+   case D3D12DDI_RD_BUFFER:
+      d.ViewDimension = D3D12_RTV_DIMENSION_BUFFER;
+      d.Buffer.FirstElement = args->Buffer.FirstElement;
+      d.Buffer.NumElements = args->Buffer.NumElements;
+      break;
+   case D3D12DDI_RD_TEXTURE1D:
+      if (array) {
+         d.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE1DARRAY;
+         d.Texture1DArray.MipSlice = args->Tex1D.MipSlice;
+         d.Texture1DArray.FirstArraySlice = args->Tex1D.FirstArraySlice;
+         d.Texture1DArray.ArraySize = args->Tex1D.ArraySize;
+      } else {
+         d.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE1D;
+         d.Texture1D.MipSlice = args->Tex1D.MipSlice;
+      }
+      break;
+   case D3D12DDI_RD_TEXTURE2D:
+   case D3D12DDI_RD_TEXTURECUBE:
+      if (resource_is_ms(res)) {
+         if (array) {
+            d.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE2DMSARRAY;
+            d.Texture2DMSArray.FirstArraySlice = args->Tex2D.FirstArraySlice;
+            d.Texture2DMSArray.ArraySize = args->Tex2D.ArraySize;
+         } else {
+            d.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE2DMS;
+         }
+      } else if (array || args->ResourceDimension == D3D12DDI_RD_TEXTURECUBE) {
+         d.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE2DARRAY;
+         d.Texture2DArray.MipSlice = args->Tex2D.MipSlice;
+         d.Texture2DArray.FirstArraySlice = args->Tex2D.FirstArraySlice;
+         d.Texture2DArray.ArraySize = args->Tex2D.ArraySize;
+         d.Texture2DArray.PlaneSlice = args->Tex2D.PlaneSlice;
+      } else {
+         d.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE2D;
+         d.Texture2D.MipSlice = args->Tex2D.MipSlice;
+         d.Texture2D.PlaneSlice = args->Tex2D.PlaneSlice;
+      }
+      break;
+   case D3D12DDI_RD_TEXTURE3D:
+      d.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE3D;
+      d.Texture3D.MipSlice = args->Tex3D.MipSlice;
+      d.Texture3D.FirstWSlice = args->Tex3D.FirstW;
+      d.Texture3D.WSize = args->Tex3D.WSize;
+      break;
+   default:
+      viogpu_log("CreateRenderTargetView: dimension %d", (int)args->ResourceDimension);
+      return;
+   }
+   device_from(hDevice)->vkd3d->CreateRenderTargetView(res ? res->resource : NULL, &d, cpu_handle(dest));
+}
+
+static VOID APIENTRY
+create_dsv(D3D12DDI_HDEVICE hDevice, const D3D12DDIARG_CREATE_DEPTH_STENCIL_VIEW *args,
+           D3D12DDI_CPU_DESCRIPTOR_HANDLE dest)
+{
+   viogpu_resource *res = (viogpu_resource *)args->hDrvResource.pDrvPrivate;
+   D3D12_DEPTH_STENCIL_VIEW_DESC d = {};
+   d.Format = args->Format;
+   d.Flags = (D3D12_DSV_FLAGS)args->Flags;
+   bool array = resource_is_array(res);
+   switch (args->ResourceDimension) {
+   case D3D12DDI_RD_TEXTURE1D:
+      if (array) {
+         d.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE1DARRAY;
+         d.Texture1DArray.MipSlice = args->Tex1D.MipSlice;
+         d.Texture1DArray.FirstArraySlice = args->Tex1D.FirstArraySlice;
+         d.Texture1DArray.ArraySize = args->Tex1D.ArraySize;
+      } else {
+         d.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE1D;
+         d.Texture1D.MipSlice = args->Tex1D.MipSlice;
+      }
+      break;
+   case D3D12DDI_RD_TEXTURE2D:
+   case D3D12DDI_RD_TEXTURECUBE:
+      if (resource_is_ms(res)) {
+         if (array) {
+            d.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE2DMSARRAY;
+            d.Texture2DMSArray.FirstArraySlice = args->Tex2D.FirstArraySlice;
+            d.Texture2DMSArray.ArraySize = args->Tex2D.ArraySize;
+         } else {
+            d.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE2DMS;
+         }
+      } else if (array || args->ResourceDimension == D3D12DDI_RD_TEXTURECUBE) {
+         d.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE2DARRAY;
+         d.Texture2DArray.MipSlice = args->Tex2D.MipSlice;
+         d.Texture2DArray.FirstArraySlice = args->Tex2D.FirstArraySlice;
+         d.Texture2DArray.ArraySize = args->Tex2D.ArraySize;
+      } else {
+         d.ViewDimension = D3D12_DSV_DIMENSION_TEXTURE2D;
+         d.Texture2D.MipSlice = args->Tex2D.MipSlice;
+      }
+      break;
+   default:
+      viogpu_log("CreateDepthStencilView: dimension %d", (int)args->ResourceDimension);
+      return;
+   }
+   device_from(hDevice)->vkd3d->CreateDepthStencilView(res ? res->resource : NULL, &d, cpu_handle(dest));
+}
