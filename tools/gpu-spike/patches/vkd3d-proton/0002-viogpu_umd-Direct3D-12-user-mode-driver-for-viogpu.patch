+static D3D12_TEXTURE_COPY_LOCATION
+copy_location(const D3D12DDIARG_BUFFER_PLACEMENT *placement, D3D12DDIARG_PLACED_RESOURCE layout)
+{
+   D3D12_TEXTURE_COPY_LOCATION loc = {};
+   loc.pResource = resource_of(placement->BaseAddress.UMD.hResource);
+   switch ((UINT)layout.Layout) {
+   case D3D12DDI_RL_SELECT_SUBRESOURCE:
+      loc.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+      loc.SubresourceIndex = (UINT)placement->BaseAddress.UMD.Offset;
+      break;
+   case D3D12DDI_RL_PLACED_PHYSICAL_SUBRESOURCE_PITCHED: {
+      const D3D12DDIARG_PHYSICAL_SUBRESOURCE_PITCHED_LAYOUT *p =
+         (const D3D12DDIARG_PHYSICAL_SUBRESOURCE_PITCHED_LAYOUT *)layout.pLayout;
+      UINT block = is_block_compressed(p->Format) ? 4 : 1;
+      loc.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+      loc.PlacedFootprint.Offset = placement->BaseAddress.UMD.Offset;
+      loc.PlacedFootprint.Footprint.Format = p->Format;
+      loc.PlacedFootprint.Footprint.Width = p->PhysicalWidth * block;
+      loc.PlacedFootprint.Footprint.Height = p->PhysicalHeight * block;
+      loc.PlacedFootprint.Footprint.Depth = p->PhysicalDepth;
+      loc.PlacedFootprint.Footprint.RowPitch = p->Pitch;
+      break;
+   }
+   case D3D12DDI_RL_PLACED_VIRTUAL_SUBRESOURCE_PITCHED: {
+      const D3D12DDIARG_VIRTUAL_SUBRESOURCE_PITCHED_LAYOUT *p =
+         (const D3D12DDIARG_VIRTUAL_SUBRESOURCE_PITCHED_LAYOUT *)layout.pLayout;
+      loc.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+      loc.PlacedFootprint.Offset = placement->BaseAddress.UMD.Offset;
+      loc.PlacedFootprint.Footprint.Format = p->Format;
+      loc.PlacedFootprint.Footprint.Width = p->VirtualWidth;
+      loc.PlacedFootprint.Footprint.Height = p->VirtualHeight;
+      loc.PlacedFootprint.Footprint.Depth = p->VirtualDepth;
+      loc.PlacedFootprint.Footprint.RowPitch = p->Pitch;
+      break;
+   }
+   default:
+      viogpu_log("CopyTextureRegion: layout %u", (UINT)layout.Layout);
+      break;
+   }
+   return loc;
+}
