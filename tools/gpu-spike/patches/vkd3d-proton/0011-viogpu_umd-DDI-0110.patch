From: WinBoat
Subject: [PATCH] viogpu_umd: DDI 0110

The driver offers DDI 0110 where it offered 0102 (the same conditions:
sampler heaps of 4096, UAV-only rendering at 1-16 samples); 0100 and 0082
stay. What came between:

- 0103: work graphs not supported (their DDIs, 0108, aren't implemented;
  the tables' new entries stay logging stubs), no wave matrix operations.
- 0106: feature level 1_0_GENERIC's optional features (predication, placed
  resources, hardware copies) all there.
- 0109: resource descs gain CreateAtVirtualAddress (unused: no RecreateAt
  tier) and CreateDevice reserved VA ranges (none asked for without it).
- 0110: ExecuteIndirect's tier and shader model 6.8's SampleCmpGrad/Bias
  and extended command info, from vkd3d-proton's OPTIONS21 (on Venus:
  tier 1.0, no SampleCmpGrad/Bias - those need device-generated commands
  and VK_KHR_maintenance8, which Venus doesn't carry yet).
---
diff --git a/libs/viogpu_umd/gen_tables.py b/libs/viogpu_umd/gen_tables.py
index 6190c375..323ff3d0 100644
--- a/libs/viogpu_umd/gen_tables.py
+++ b/libs/viogpu_umd/gen_tables.py
@@ -5,8 +5,8 @@
 import re, sys
 h12, hdxgi, out = sys.argv[1:4]
 tables = [
-    ("DEVICE", h12, "D3D12DDI_DEVICE_FUNCS_CORE_0102"),
-    ("COMMAND_LIST", h12, "D3D12DDI_COMMAND_LIST_FUNCS_3D_0099"),
+    ("DEVICE", h12, "D3D12DDI_DEVICE_FUNCS_CORE_0109"),
+    ("COMMAND_LIST", h12, "D3D12DDI_COMMAND_LIST_FUNCS_3D_0108"),
     ("COMMAND_QUEUE", h12, "D3D12DDI_COMMAND_QUEUE_FUNCS_CORE_0001"),
     ("DXGI", hdxgi, "DXGI1_4_DDI_BASE_FUNCTIONS"),
     ("EXTENDED_FEATURES", h12, "D3D12DDI_EXTENDED_FEATURES_FUNCS_0020"),
diff --git a/libs/viogpu_umd/umd_ddi.cpp b/libs/viogpu_umd/umd_ddi.cpp
index 019ae595..4d355fd2 100644
--- a/libs/viogpu_umd/umd_ddi.cpp
+++ b/libs/viogpu_umd/umd_ddi.cpp
@@ -12,11 +12,12 @@
  * (OutputDebugString, and the file VIOGPU_D3D12_LOG names) and returns 0. Each stub has its entry's own type, so that
  * on x86 it pops the caller's arguments (__stdcall).
  *
- * DDI versions: D3D12DDI_SUPPORTED_0102 (interface R8, build 102: the Vulkan-on-12 caps, line rasterization modes),
- * 0100 (shader models 6.7 and 6.8) and, for older runtimes, 0082 (shader model 6.6). The tables are 0102's; an older
- * runtime's are a prefix of them, and the arguments that changed meaning on the way go by the build the runtime chose
- * (device_ddi, umd_private.h). 0102 only where the device has the sampler heaps of 4096 descriptors and the UAV-only
- * rendering at every sample count up to 16 that runtime insists on (adapter_offers_0102).
+ * DDI versions: D3D12DDI_SUPPORTED_0110 (interface R8, build 110: 0102's Vulkan-on-12 caps and line rasterization
+ * modes, 0110's ExecuteIndirect tier and shader model 6.8 caps; work graphs, 0108, not implemented), 0100 (shader
+ * models 6.7 and 6.8) and, for older runtimes, 0082 (shader model 6.6). The tables are 0110's; an older runtime's are a
+ * prefix of them, and the arguments that changed meaning on the way go by the build the runtime chose (device_ddi,
+ * umd_private.h). 0110 only where the device has the sampler heaps of 4096 descriptors and the UAV-only rendering at
+ * every sample count up to 16 the runtimes of 0102 on insist on (adapter_offers_0110).
  */
 
 #include "umd_private.h"
@@ -324,6 +325,8 @@ struct viogpu_caps {
    D3D12DDI_OPTIONS_DATA_0091 options0091;
    D3D12DDI_OPTIONS_DATA_0093 options0093;
    D3D12DDI_OPTIONS_DATA_0102 options0102;
+   D3D12DDI_OPTIONS_DATA_0110 options0110;
+   D3D12DDI_SHADER_MODEL_6_8_OPTIONS_0110 sm68;
    UINT gpuvaBits;
    /* highest shader model, in D3D_SHADER_MODEL's terms (0x51, 0x60...) */
    UINT shaderModel;
@@ -461,6 +464,15 @@ caps_from_vkd3d(ID3D12Device *device, viogpu_caps *caps)
    caps->options0102.MaxSamplerDescriptorHeapSize = o19.MaxSamplerDescriptorHeapSize;
    caps->options0102.MaxSamplerDescriptorHeapSizeWithStaticSamplers = o19.MaxSamplerDescriptorHeapSizeWithStaticSamplers;
    caps->options0102.MaxViewDescriptorHeapSize = o19.MaxViewDescriptorHeapSize;
+   /* 0110: ExecuteIndirect's incrementing constants (tier 1.1, device-generated commands), shader model 6.8's
+    * SampleCmpGrad/SampleCmpBias; the tiers have the API's values. Work graphs (0103/0108) stay off: their DDIs aren't
+    * implemented */
+   D3D12_FEATURE_DATA_D3D12_OPTIONS21 o21 = {};
+   if (FAILED(device->CheckFeatureSupport(D3D12_FEATURE_D3D12_OPTIONS21, &o21, sizeof(o21))))
+      o21.ExecuteIndirectTier = D3D12_EXECUTE_INDIRECT_TIER_1_0;
+   caps->options0110.ExecuteIndirectTier = (D3D12DDI_EXECUTE_INDIRECT_TIER)o21.ExecuteIndirectTier;
+   caps->sm68.SampleCmpGradientAndBiasSupported = o21.SampleCmpGradientAndBiasSupported;
+   caps->sm68.ExtendedCommandInfoSupported = o21.ExtendedCommandInfoSupported;
 
    /* the heaps the runtime makes out of DEFAULT/UPLOAD/READBACK follow this, vkd3d-proton's custom heaps too */
    D3D12_FEATURE_DATA_ARCHITECTURE arch = {};
@@ -504,12 +516,12 @@ adapter_caps(viogpu_adapter *adapter)
    return adapter->caps;
 }
 
-static const UINT64 supported_versions[] = { D3D12DDI_SUPPORTED_0102, D3D12DDI_SUPPORTED_0100, D3D12DDI_SUPPORTED_0082 };
+static const UINT64 supported_versions[] = { D3D12DDI_SUPPORTED_0110, D3D12DDI_SUPPORTED_0100, D3D12DDI_SUPPORTED_0082 };
 
-/* 0102 where the device has what that runtime insists on (it refuses the device otherwise, saying nothing): sampler
- * heaps of 4096 descriptors and UAV-only rendering at 1, 2, 4, 8 and 16 samples */
+/* 0110 where the device has what the runtimes of 0102 on insist on (they refuse the device otherwise, saying nothing):
+ * sampler heaps of 4096 descriptors and UAV-only rendering at 1, 2, 4, 8 and 16 samples */
 static bool
-adapter_offers_0102(viogpu_adapter *adapter)
+adapter_offers_0110(viogpu_adapter *adapter)
 {
    const viogpu_caps *caps = adapter_caps(adapter);
    return caps && (caps->options0102.SupportedSampleCountsWithNoOutputs & 0x1f) == 0x1f &&
@@ -521,7 +533,7 @@ adapter_get_supported_versions(D3D12DDI_HADAPTER hAdapter, UINT32 *entries, UINT
 {
    const UINT64 *offered = supported_versions;
    UINT32 count = ARRAYSIZE(supported_versions);
-   if (!adapter_offers_0102((viogpu_adapter *)hAdapter.pDrvPrivate)) {
+   if (!adapter_offers_0110((viogpu_adapter *)hAdapter.pDrvPrivate)) {
       offered++;
       count--;
    }
@@ -576,6 +588,36 @@ adapter_get_caps_answer(viogpu_adapter *adapter, const D3D12DDIARG_GETCAPS *caps
       return answer(caps, dev->options0090);
    case D3D12DDICAPS_TYPE_OPTIONS_0102:
       return answer(caps, dev->options0102);
+   case D3D12DDICAPS_TYPE_OPTIONS_0110:
+      return answer(caps, dev->options0110);
+   case D3D12DDICAPS_TYPE_SHADER_MODEL_6_8_OPTIONS_0110:
+      return answer(caps, dev->sm68);
+
+   /* no wave matrix operations (the query's input fields stay) */
+   case D3D12DDICAPS_TYPE_0103_WAVE_MMA: {
+      D3D12DDI_WAVE_MMA_DATA_0103 *data = (D3D12DDI_WAVE_MMA_DATA_0103 *)caps->pData;
+      if (!data || caps->DataSize < sizeof(*data))
+         return E_INVALIDARG;
+      data->Supported = FALSE;
+      return S_OK;
+   }
+
+   /* 0106, the optional features of feature level 1_0_GENERIC devices: predication, placed resources and copies are
+    * all there */
+   case D3D12DDI_FEATURE_D3D12_PREDICATION_106:
+   case D3D12DDI_FEATURE_HARDWARE_COPY_106:
+      if (!caps->pData || caps->DataSize < sizeof(BOOL))
+         return E_INVALIDARG;
+      *(BOOL *)caps->pData = TRUE;
+      return S_OK;
+   case D3D12DDI_FEATURE_PLACED_RESOURCE_SUPPORT_INFO_106: {
+      D3D12DDI_FEATURE_DATA_PLACED_RESOURCE_SUPPORT_INFO_106 *data =
+         (D3D12DDI_FEATURE_DATA_PLACED_RESOURCE_SUPPORT_INFO_106 *)caps->pData;
+      if (!data || caps->DataSize < sizeof(*data))
+         return E_INVALIDARG;
+      data->Supported = TRUE;
+      return S_OK;
+   }
    case D3D12DDICAPS_TYPE_OPTIONS_0093:
       return answer(caps, dev->options0093);
 
@@ -655,8 +697,10 @@ adapter_get_caps_answer(viogpu_adapter *adapter, const D3D12DDIARG_GETCAPS *caps
    case D3D12DDICAPS_TYPE_0073_SUPPORT_BATCHED_MARKERS:
    case D3D12DDICAPS_TYPE_OPTIONS_0098:
    case D3D12DDICAPS_TYPE_OPTIONS_0101:
-      /* none of it: queue flags 0, not compute-only, no hardware scheduling, FALSE; no fully CPU-accessible L1 memory
-       * or compute-only custom heaps */
+   case D3D12DDICAPS_TYPE_OPTIONS1_0103:
+   case D3D12DDICAPS_TYPE_OPTIONS_0109:
+      /* none of it: queue flags 0, not compute-only, no hardware scheduling, FALSE; no fully CPU-accessible L1 memory,
+       * compute-only custom heaps, work graphs or resources recreated at a virtual address */
       if (!caps->pData)
          return E_INVALIDARG;
       memset(caps->pData, 0, caps->DataSize);
