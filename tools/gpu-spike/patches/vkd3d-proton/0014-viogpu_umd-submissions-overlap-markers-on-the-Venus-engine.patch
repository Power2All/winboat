 /* Opens vkd3d-proton's gate for the submissions whose place on the kernel context has been reached */
+/* The kernel driver's VIOGPU_QUEUE_* escapes, on the device */
+static HRESULT
+queue_escape(viogpu_device *device, VIOGPU_UMD_ESCAPE_QUEUE_DATA *data, USHORT type)
+{
+   data->Type = type;
+   data->DataLength = sizeof(*data) - 2 * sizeof(USHORT);
+   D3DDDICB_ESCAPE escape = {};
+   escape.hDevice = device->hRTDevice.handle;
+   escape.pPrivateDriverData = data;
+   escape.PrivateDriverDataSize = sizeof(*data);
+   return device->ktCallbacks->pfnEscapeCb(device->hRTAdapter, &escape);
+}
+
+/* Markers: one gate opening for each marker the scheduler hands over (the semaphore's count), in order */
+static DWORD WINAPI
+marker_gate_thread(void *param)
+{
+   viogpu_command_queue *queue = (viogpu_command_queue *)param;
+   for (UINT64 n = 1;; n++) {
+      WaitForSingleObject(queue->semaphore, INFINITE);
+      EnterCriticalSection(&queue->lock);
+      bool stop = queue->stop;
+      LeaveCriticalSection(&queue->lock);
+      if (stop)
+         return 0;
+      /* the kernel releases one count per sequence number, a failed submission's included (opened here early) */
+      if (queue->gate->GetCompletedValue() < n)
+         queue->gate->Signal(n);
+   }
+}
