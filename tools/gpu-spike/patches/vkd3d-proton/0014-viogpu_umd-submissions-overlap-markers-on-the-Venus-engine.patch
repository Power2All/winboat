+/* The kernel driver's D3D12 queues on its Venus engine (VIOGPU_QUEUE_*, kvm-guest-drivers-windows 0023): markers
+ * (command buffers whose private data is a VIOGPU_UMD_MARKER) open the queue's gate when the scheduler hands them
+ * over and complete once the queue reports its lists done */
+#define VIOGPU_UMD_VENUS_NODE 1
+#define VIOGPU_UMD_ESCAPE_QUEUE_REGISTER 0x305
+#define VIOGPU_UMD_ESCAPE_QUEUE_UNREGISTER 0x306
+#define VIOGPU_UMD_ESCAPE_QUEUE_DONE 0x307
+#pragma pack(push, 1)
+typedef struct VIOGPU_UMD_ESCAPE_QUEUE_DATA {
+   USHORT Type;
+   USHORT DataLength;
+   UINT64 Semaphore; /* REGISTER: a semaphore HANDLE */
+   ULONG Queue;      /* REGISTER: out */
+   UINT64 Done;      /* DONE: the queue's submissions up to this one are done */
+} VIOGPU_UMD_ESCAPE_QUEUE_DATA;
+#pragma pack(pop)
+#define VIOGPU_UMD_MARKER_MAGIC 0x4b52414du
+typedef struct VIOGPU_UMD_MARKER {
+   ULONG Magic;
+   ULONG Queue;
+   UINT64 Seq;
+} VIOGPU_UMD_MARKER;
