+{
+   viogpu_state_object *so = (viogpu_state_object *)h.pDrvPrivate;
+   memset(req, 0, sizeof(*req));
+   ID3D12WorkGraphProperties *wg = NULL;
+   if (so->so && SUCCEEDED(so->so->QueryInterface(IID_PPV_ARGS(&wg)))) {
+      wg->GetWorkGraphMemoryRequirements(wg->GetWorkGraphIndex(name), (D3D12_WORK_GRAPH_MEMORY_REQUIREMENTS *)req);
