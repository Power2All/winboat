+static D3D12DDI_PROGRAM_IDENTIFIER_0108 APIENTRY
+get_program_identifier(D3D12DDI_HSTATEOBJECT_0054 h, LPCWSTR name)
+{
+   viogpu_state_object *so = (viogpu_state_object *)h.pDrvPrivate;
+   D3D12DDI_PROGRAM_IDENTIFIER_0108 id = {};
+   ID3D12StateObjectProperties1 *props1 = NULL;
+   if (so->props && SUCCEEDED(so->props->QueryInterface(IID_PPV_ARGS(&props1)))) {
+      D3D12_PROGRAM_IDENTIFIER pid = props1->GetProgramIdentifier(name);
+      memcpy(&id, &pid, sizeof(id));
+      props1->Release();
+   }
+   return id;
+}
