    bool compute = list->type == D3D12_COMMAND_LIST_TYPE_COMPUTE || list->type == D3D12_COMMAND_LIST_TYPE_COPY;
    device->umCallbacks->pfnSetCommandListDDITableCb(
@@ -200,6 +201,8 @@ destroy_command_list(D3D12DDI_HDEVICE, D3D12DDI_HCOMMANDLIST h)
       list->list5->Release();
    if (list->list6)
       list->list6->Release();
+   if (list->list9)
+      list->list9->Release();
    if (list->list2)
       list->list2->Release();
    if (list->list1)
@@ -529,6 +532,28 @@ om_set_stencil_ref(D3D12DDI_HCOMMANDLIST h, UINT ref)
    L(h)->OMSetStencilRef(ref);
 }
 
+/* DDI 0095/0099 */
+static VOID APIENTRY
+om_set_front_and_back_stencil_ref(D3D12DDI_HCOMMANDLIST h, UINT front, UINT back)
+{
+   if (list_from(h)->list9)
+      list_from(h)->list9->OMSetFrontAndBackStencilRef(front, back);
+}
+
+static VOID APIENTRY
+rs_set_depth_bias(D3D12DDI_HCOMMANDLIST h, FLOAT bias, FLOAT clamp, FLOAT slopeScaled)
+{
+   if (list_from(h)->list9)
+      list_from(h)->list9->RSSetDepthBias(bias, clamp, slopeScaled);
+}
+
+static VOID APIENTRY
+ia_set_index_buffer_strip_cut_value(D3D12DDI_HCOMMANDLIST h, D3D12DDI_INDEX_BUFFER_STRIP_CUT_VALUE value)
+{
+   if (list_from(h)->list9)
+      list_from(h)->list9->IASetIndexBufferStripCutValue((D3D12_INDEX_BUFFER_STRIP_CUT_VALUE)value);
+}
+
 static VOID APIENTRY
 set_pipeline_state(D3D12DDI_HCOMMANDLIST h, D3D12DDI_HPIPELINESTATE pso)
 {
@@ -895,6 +920,12 @@ viogpu_fill_command_list_table(void *table, SIZE_T size, UINT number, D3D12DDI_H
       f->pfnDispatchMesh = dispatch_mesh;
    if (size >= offsetof(D3D12DDI_COMMAND_LIST_FUNCS_3D_0054, pfnDispatchRays) + sizeof(void *))
       viogpu_fill_raytracing_list_funcs(f);
+   if (size >= offsetof(D3D12DDI_COMMAND_LIST_FUNCS_3D_0095, pfnOmSetFrontAndBackStencilRef) + sizeof(void *))
+      f->pfnOmSetFrontAndBackStencilRef = om_set_front_and_back_stencil_ref;
+   if (size >= offsetof(D3D12DDI_COMMAND_LIST_FUNCS_3D_0099, pfnIASetIndexBufferStripCutValue) + sizeof(void *)) {
+      f->pfnRSSetDepthBias = rs_set_depth_bias;
+      f->pfnIASetIndexBufferStripCutValue = ia_set_index_buffer_strip_cut_value;
+   }
    f->pfnClearUnorderedAccessViewUint = clear_uav_uint;
    f->pfnClearUnorderedAccessViewFloat = clear_uav_float;
    f->pfnClearRenderTargetView = clear_rtv;
