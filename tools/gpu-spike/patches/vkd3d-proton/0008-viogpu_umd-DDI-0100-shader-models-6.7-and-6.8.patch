+/* 0096 on: the runtime says the highest feature it knows (video's is far below it) */
+static HRESULT APIENTRY
+device_get_supported_extended_features_0096(D3D12DDI_HDEVICE hDevice, D3D12DDI_FEATURE_0020, UINT32 *count,
+                                            D3D12DDI_FEATURE_0020 *features)
+{
+   return device_get_supported_extended_features(hDevice, count, features);
+}
+
+/* Video 0094_0 (core DDI 0094 on: a runtime of DDI 0100 takes nothing older) is 0083_0 with an enhanced barrier entry
+ * in each video list table (a stub: enhanced barriers are off) */
