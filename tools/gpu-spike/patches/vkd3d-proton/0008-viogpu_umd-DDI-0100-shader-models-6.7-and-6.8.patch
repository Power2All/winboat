                                                UINT32 *versions)
 {
-   UINT32 n = feature == D3D12DDI_FEATURE_0020_VIDEO && viogpu_video_supported(device_from(hDevice)) ? 1 : 0;
+   UINT32 n = feature == D3D12DDI_FEATURE_0020_VIDEO && viogpu_video_supported(device_from(hDevice))
+                 ? ARRAYSIZE(video_versions)
+                 : 0;
    if (versions && *count >= n && n)
-      versions[0] = D3D12DDI_FEATURE_VERSION_VIDEO_0083_0;
+      memcpy(versions, video_versions, sizeof(video_versions));
    *count = n;
    return S_OK;
 }
