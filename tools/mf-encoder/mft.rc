#include <winver.h>
// CompanyName "WinBoat": the driver's uninstall (gpu-driver.ps1) unregisters and removes only this file
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "WinBoat"
      VALUE "FileDescription", "Media Foundation H.264/HEVC encoders for WinBoat's virtual GPU (Vulkan Video)"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "OriginalFilename", "winboat_mft64.dll"
      VALUE "ProductName", "WinBoat"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
