+/**
+ * spice_display_set_window_area:
+ * @display: a #SpiceDisplay
+ * @x: left edge, in display pixels
+ * @y: top edge
+ * @width: width
+ * @height: height
+ *
+ * Shows only this part of the display, like a guest window of its own (several widgets of one display channel
+ * can each show a part). Pointer positions are sent for the whole display. Sizes of 0 show the monitor again.
+ **/
+void spice_display_set_window_area(SpiceDisplay *display, gint x, gint y, gint width, gint height)
+{
+    SpiceDisplayPrivate *d;
+
+    g_return_if_fail(SPICE_IS_DISPLAY(display));
+    d = display->priv;
+    d->window_area_set = width > 0 && height > 0;
+    d->window_area = (GdkRectangle) { .x = x, .y = y, .width = width, .height = height };
+    if (d->display)
+        spice_display_widget_update_monitor_area(display);
+}
