+/**
+ * spice_display_set_transparent_color:
+ * @display: a #SpiceDisplay
+ * @enabled: whether pixels of @rgb are left out
+ * @rgb: the color, as 0xRRGGBB
+ *
+ * Leaves out the pixels of one color (OpenGL drawing): what is behind the window shows there, when the window
+ * has an alpha channel (a 32-bit visual: set SPICE_GTK_EGL_ALPHA before creating displays).
+ **/
+void spice_display_set_transparent_color(SpiceDisplay *display, gboolean enabled, guint32 rgb)
+{
+    SpiceDisplayPrivate *d;
+
+    g_return_if_fail(SPICE_IS_DISPLAY(display));
+    d = display->priv;
+    d->transparent_set = enabled;
+    d->transparent_color = rgb & 0xffffff;
+    gtk_widget_queue_draw(GTK_WIDGET(display));
+}
