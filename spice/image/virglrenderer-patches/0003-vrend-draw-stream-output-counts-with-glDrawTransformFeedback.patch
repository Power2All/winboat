vrend: draw stream output counts with glDrawTransformFeedback

A draw with a count from a stream output target (D3D's DrawAuto, GL's
glDrawTransformFeedback) came as the target's size, the buffer's capacity:
the guest can't know how much a capture wrote. The draw used it as a vertex
count, so it drew the whole buffer, garbage after the written vertices.
Draw with the transform feedback object that last captured into vertex
buffer 0 instead, ending its capture first (transform feedback objects stay
paused between draws otherwise; a later capture starts over at the target's
offset). Without such a capture the count stays as before.

--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -681,6 +681,9 @@
    struct list_head head;
    int xfb_state;
    struct vrend_so_target *so_targets[16];
+   /* when it last captured (vrend_sub_context's so_captures), and whether a capture ended (draws can use its count) */
+   uint64_t last_capture;
+   bool ended;
 };
 
 #define XFB_STATE_OFF 0
@@ -785,6 +788,7 @@
 
    struct list_head streamout_list;
    struct vrend_streamout_object *current_so;
+   uint64_t so_captures;
 
    struct pipe_blend_color blend_color;
 
@@ -5888,6 +5892,49 @@
    ctx->sub->prog = prev_prog;
 }
 
+/* A draw of what stream output wrote (the guest sends a count from a stream output target: D3D's DrawAuto, GL's
+ * glDrawTransformFeedback). The guest's count is the target's size, the buffer's capacity: only the capture knows
+ * how much it wrote. Draws with the transform feedback object that last captured into vertex buffer 0, ending its
+ * capture (a later one starts over at the target's offset). False when no capture wrote that buffer. */
+static bool vrend_draw_stream_output(struct vrend_sub_context *sub_ctx, GLenum mode,
+                                     const struct pipe_draw_info *info)
+{
+   struct vrend_resource *res = (struct vrend_resource *)sub_ctx->vbo[0].base.buffer;
+   struct vrend_streamout_object *found = NULL;
+
+   if (!res || !has_feature(feat_transform_feedback2))
+      return false;
+   list_for_each_entry(struct vrend_streamout_object, obj, &sub_ctx->streamout_list, head) {
+      if (obj == sub_ctx->current_so || !obj->last_capture)
+         continue;
+      for (unsigned i = 0; i < obj->num_targets; i++) {
+         if (obj->so_targets[i] && obj->so_targets[i]->buffer == res &&
+             (!found || obj->last_capture > found->last_capture)) {
+            found = obj;
+            break;
+         }
+      }
+   }
+   if (!found)
+      return false;
+
+   if (found->xfb_state == XFB_STATE_PAUSED || found->xfb_state == XFB_STATE_STARTED) {
+      glBindTransformFeedback(GL_TRANSFORM_FEEDBACK, found->id);
+      glEndTransformFeedback();
+      glBindTransformFeedback(GL_TRANSFORM_FEEDBACK, sub_ctx->current_so ? sub_ctx->current_so->id : 0);
+      found->xfb_state = XFB_STATE_STARTED_NEED_BEGIN;
+      found->ended = true;
+   }
+   if (!found->ended)
+      return true; /* nothing captured: nothing to draw */
+
+   if (info->instance_count > 1)
+      glDrawTransformFeedbackInstanced(mode, found->id, info->instance_count);
+   else
+      glDrawTransformFeedback(mode, found->id);
+   return true;
+}
+
 int vrend_draw_vbo(struct vrend_context *ctx,
                    const struct pipe_draw_info *info,
                    uint32_t cso, uint32_t indirect_handle,
@@ -6044,6 +6091,7 @@
          glResumeTransformFeedback();
          sub_ctx->current_so->xfb_state = XFB_STATE_STARTED;
       }
+      sub_ctx->current_so->last_capture = ++sub_ctx->so_captures;
    }
 
    if (info->primitive_restart) {
@@ -6096,7 +6144,9 @@
       int count = cso ? cso : info->count;
       int start = cso ? 0 : info->start;
 
-      if (indirect_handle) {
+      if (cso && !indirect_handle && vrend_draw_stream_output(sub_ctx, mode, info)) {
+         /* drawn */
+      } else if (indirect_handle) {
          if (indirect_params_res)
             glMultiDrawArraysIndirectCountARB(mode, (GLvoid const *)(uintptr_t)info->indirect.offset,
                                               info->indirect.indirect_draw_count_offset, info->indirect.draw_count, info->indirect.stride);
