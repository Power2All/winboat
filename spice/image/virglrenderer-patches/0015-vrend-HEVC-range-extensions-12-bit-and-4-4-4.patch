+/*
+ * read_images: how a picture is read (vaGetImage in a format the driver has) and handed to the guest's planes
+ * (WinBoat). 4:2:0 in two planes as NV12/P010/P016; 4:4:4 packed into one RGBA plane the way D3D's AYUV (V, U, Y, A
+ * bytes), Y410 (U, Y, V, A in 10:10:10:2 from bit 0) and Y416 (U, Y, V, A in 16 bits, the samples at the top) are:
+ * NVIDIA's driver reads 4:4:4 only as three planes (444P, Q416), packed here.
+ */
+struct read_layout {
+    enum pipe_format format;
+    uint32_t fourcc, bits_per_pixel, drm_format;
+    unsigned packed_bytes;              /* 4:4:4: bytes per packed pixel; 0: planes as read */
+};
+
+static const struct read_layout *read_layout(enum pipe_format format)
+{
+    static const struct read_layout layouts[] = {
+        {PIPE_FORMAT_NV12, VA_FOURCC_NV12, 12, DRM_FORMAT_NV12, 0},
+        {PIPE_FORMAT_P010, VA_FOURCC_P010, 24, DRM_FORMAT_P010, 0},
+        {PIPE_FORMAT_P016, VA_FOURCC_P016, 24, DRM_FORMAT_P016, 0},
+        {PIPE_FORMAT_R8G8B8A8_UNORM, VA_FOURCC_444P, 24, DRM_FORMAT_AYUV, 4},
+        {PIPE_FORMAT_R10G10B10A2_UNORM, VA_FOURCC_Q416, 48, DRM_FORMAT_Y410, 4},
+        {PIPE_FORMAT_R16G16B16A16_UNORM, VA_FOURCC_Q416, 48, DRM_FORMAT_Y416, 8},
+    };
+    for (unsigned i = 1; i < ARRAY_SIZE(layouts); i++) {
+        if (layouts[i].format == format)
+            return &layouts[i];
+    }
+    return &layouts[0];
+}
+
+/* The three planes read (444P, Q416: 16-bit samples at the top) packed into buffer->packed */
+static void pack_444(struct virgl_video_buffer *buffer, const uint8_t *data)
+{
+    const VAImage *img = &buffer->image;
+    for (unsigned y = 0; y < buffer->height; y++) {
+        const uint8_t *py = data + img->offsets[0] + (size_t)y * img->pitches[0];
+        const uint8_t *pu = data + img->offsets[1] + (size_t)y * img->pitches[1];
+        const uint8_t *pv = data + img->offsets[2] + (size_t)y * img->pitches[2];
+        if (buffer->format == PIPE_FORMAT_R8G8B8A8_UNORM) {
+            uint8_t *o = (uint8_t *)buffer->packed + (size_t)y * buffer->width * 4;
+            for (unsigned x = 0; x < buffer->width; x++, o += 4) {
+                o[0] = pv[x];
+                o[1] = pu[x];
+                o[2] = py[x];
+                o[3] = 0xff;
+            }
+        } else if (buffer->format == PIPE_FORMAT_R10G10B10A2_UNORM) {
+            const uint16_t *y16 = (const uint16_t *)py, *u16 = (const uint16_t *)pu, *v16 = (const uint16_t *)pv;
+            uint32_t *o = (uint32_t *)buffer->packed + (size_t)y * buffer->width;
+            for (unsigned x = 0; x < buffer->width; x++)
+                o[x] = (uint32_t)(u16[x] >> 6) | (uint32_t)(y16[x] >> 6) << 10 | (uint32_t)(v16[x] >> 6) << 20 | 3u << 30;
+        } else {
+            const uint16_t *y16 = (const uint16_t *)py, *u16 = (const uint16_t *)pu, *v16 = (const uint16_t *)pv;
+            uint16_t *o = (uint16_t *)buffer->packed + (size_t)y * buffer->width * 4;
+            for (unsigned x = 0; x < buffer->width; x++, o += 4) {
+                o[0] = u16[x];
+                o[1] = y16[x];
+                o[2] = v16[x];
+                o[3] = 0xffff;
+            }
+        }
+    }
+}
