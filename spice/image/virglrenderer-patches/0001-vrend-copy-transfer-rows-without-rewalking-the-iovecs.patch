vrend: copy a transfer's rows without walking the iovecs again for each row

read_transfer_data/write_transfer_data copy row by row when the rows aren't
contiguous in the guest's memory, and vrend_read_from_iovec/
vrend_write_to_iovec walk the iovec list from its start to each row's offset.
With a backing of 4 KiB pages that is rows times pages steps: for a guest
screen of 5120x2065 (2065 rows, ~10000 pages) more time than the copying, on
the thread that also runs the guest's other GL work. Keep the iovec the last
row was in (the rows' offsets increase, also when inverting).

--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -8964,6 +8964,41 @@
    }
 }
 
+/*
+ * A transfer copies its rows one by one when they aren't contiguous in the guest's memory, at increasing offsets.
+ * vrend_read_from_iovec/vrend_write_to_iovec walk the iovec list from its start to each row's offset: with a
+ * backing of 4 KiB pages, that is rows times pages steps (a 5120x2065 screen: 2065 rows, 10000 pages), more than the
+ * copying itself. The cursor keeps the iovec the last row was in.
+ */
+struct iov_cursor {
+   const struct iovec *iov;   /* the current iovec */
+   int left;                  /* iovecs from it to the end */
+   uint64_t base;             /* the offset it starts at */
+};
+
+static void iov_cursor_init(struct iov_cursor *c, const struct iovec *iov, int num_iovs)
+{
+   c->iov = iov;
+   c->left = num_iovs;
+   c->base = 0;
+}
+
+/* The iovecs from the one offset is in, and offset within it (a smaller offset than before starts over) */
+static const struct iovec *iov_cursor_seek(struct iov_cursor *c, const struct iovec *iov, int num_iovs,
+                                           uint64_t offset, int *left, size_t *rel)
+{
+   if (offset < c->base)
+      iov_cursor_init(c, iov, num_iovs);
+   while (c->left > 1 && offset >= c->base + c->iov->iov_len) {
+      c->base += c->iov->iov_len;
+      c->iov++;
+      c->left--;
+   }
+   *left = c->left;
+   *rel = offset - c->base;
+   return c->iov;
+}
+
