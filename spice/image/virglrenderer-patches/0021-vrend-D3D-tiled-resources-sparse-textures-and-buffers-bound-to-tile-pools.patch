From: WinBoat
Subject: [PATCH] vrend: D3D tiled resources: sparse textures and buffers bound to tile pools

Direct3D 11.2's tiled resources: a resource with no memory of its own whose 64 KB tiles an application binds to tiles
of a tile pool, the same pool tile under several resources if it likes (aliasing); unbound tiles read 0 and drop
writes (tier 2). On the host: a resource created with VIRGL_BIND_SPARSE gets sparse storage (ARB_sparse_texture2,
ARB_sparse_buffer: unbound pages read 0, writes to them are dropped), one with VIRGL_BIND_TILE_POOL is only memory,
device-local Vulkan memory imported as a GL memory object (vrend_vk_memory_create). A new command,
VIRGL_CCMD_TILE_MAP, binds a region of a sparse resource to a pool at an offset or unbinds it
(NV_memory_object_sparse's TexturePageCommitmentMemNV / NamedBufferPageCommitmentMemNV: pages of several resources in
the same memory are D3D's aliasing); a level of the mip tail binds the tail. The two bind bits are taken off before
GL's bind checks. The host announces it with VIRGL_CAP_V2_TILED (bit 26) where the extensions, Vulkan memory and the
entry points are there and the page shapes are D3D's standard tile shapes (NVIDIA's are).
---
diff --git a/src/virgl_hw.h b/src/virgl_hw.h
index 89ed800..3b7f2ef 100644
--- a/src/virgl_hw.h
+++ b/src/virgl_hw.h
@@ -640,6 +640,9 @@ enum virgl_formats {
 #define VIRGL_CAP_V2_CONSERVATIVE_RASTER  (1u << 28)
 /* WinBoat: TGSI_PROPERTY_FS_INTERLOCK (GL_ARB_fragment_shader_interlock) */
 #define VIRGL_CAP_V2_FS_INTERLOCK         (1u << 27)
+/* WinBoat: D3D tiled resources - sparse textures and buffers (VIRGL_BIND_SPARSE) whose pages VIRGL_CCMD_TILE_MAP binds
+ * to tile pools (VIRGL_BIND_TILE_POOL); page shapes are D3D's standard tile shapes */
+#define VIRGL_CAP_V2_TILED                (1u << 26)
 
 /* virgl bind flags - these are compatible with mesa 10.5 gallium.
  * but are fixed, no other should be passed to virgl either.
@@ -653,6 +656,10 @@ enum virgl_formats {
 #define VIRGL_BIND_DISPLAY_TARGET (1u << 7)
 #define VIRGL_BIND_COMMAND_ARGS  (1u << 8)
 #define VIRGL_BIND_STREAM_OUTPUT (1u << 11)
+/* WinBoat (VIRGL_CAP_V2_TILED): sparse storage, pages bound by VIRGL_CCMD_TILE_MAP */
+#define VIRGL_BIND_SPARSE        (1u << 10)
+/* WinBoat (VIRGL_CAP_V2_TILED): a tile pool, a buffer resource of width bytes that is only memory (no GL object) */
+#define VIRGL_BIND_TILE_POOL     (1u << 12)
 /* WinBoat: a texture the guest also renders to through Venus (vrend_vk.h); storage in exportable Vulkan memory */
 #define VIRGL_BIND_VK_SHARED     (1u << 13)
 #define VIRGL_BIND_SHADER_BUFFER (1u << 14)
diff --git a/src/virgl_protocol.h b/src/virgl_protocol.h
index d7bb59e..2228e5c 100644
--- a/src/virgl_protocol.h
+++ b/src/virgl_protocol.h
@@ -147,6 +147,7 @@ enum virgl_context_cmd {
    /* WinBoat */
    VIRGL_CCMD_SET_RASTER_SAMPLES,
    VIRGL_CCMD_SET_CONSERVATIVE_RASTER,
+   VIRGL_CCMD_TILE_MAP,
 
    VIRGL_MAX_COMMANDS
 };
@@ -803,4 +804,20 @@ enum vrend_tweak_type {
 #define VIRGL_SET_CONSERVATIVE_RASTER_SIZE 1
 #define VIRGL_SET_CONSERVATIVE_RASTER_MODE 1
 
+/* VIRGL_CCMD_TILE_MAP (WinBoat): a region of a sparse resource (VIRGL_BIND_SPARSE) bound to tile pool memory
+ * (VIRGL_BIND_TILE_POOL) at an offset, or unbound (pool 0). Textures: texels of a level, layer = z for arrays (whole
+ * pages, or up to the level's edge); buffers: x and width in bytes. A level of the mip tail binds the whole tail */
+#define VIRGL_TILE_MAP_SIZE 11
+#define VIRGL_TILE_MAP_HANDLE 1
+#define VIRGL_TILE_MAP_LEVEL 2
+#define VIRGL_TILE_MAP_X 3
+#define VIRGL_TILE_MAP_Y 4
+#define VIRGL_TILE_MAP_Z 5
+#define VIRGL_TILE_MAP_WIDTH 6
+#define VIRGL_TILE_MAP_HEIGHT 7
+#define VIRGL_TILE_MAP_DEPTH 8
+#define VIRGL_TILE_MAP_POOL 9
+#define VIRGL_TILE_MAP_OFFSET_LO 10
+#define VIRGL_TILE_MAP_OFFSET_HI 11
+
 #endif
