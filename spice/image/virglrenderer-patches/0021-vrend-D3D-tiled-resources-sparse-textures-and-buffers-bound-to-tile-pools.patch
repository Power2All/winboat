diff --git a/src/vrend/vrend_decode.c b/src/vrend/vrend_decode.c
index a4fc162..4b85623 100644
--- a/src/vrend/vrend_decode.c
+++ b/src/vrend/vrend_decode.c
@@ -1072,6 +1072,18 @@ static int vrend_decode_set_conservative_raster(struct vrend_context *ctx, const
    return 0;
 }
 
+static int vrend_decode_tile_map(struct vrend_context *ctx, const uint32_t *buf, uint32_t length)
+{
+   if (length != VIRGL_TILE_MAP_SIZE)
+      return EINVAL;
+   uint64_t offset = get_buf_entry(buf, VIRGL_TILE_MAP_OFFSET_LO) | (uint64_t)get_buf_entry(buf, VIRGL_TILE_MAP_OFFSET_HI) << 32;
+   return vrend_tile_map(ctx, get_buf_entry(buf, VIRGL_TILE_MAP_HANDLE), get_buf_entry(buf, VIRGL_TILE_MAP_LEVEL),
+                         get_buf_entry(buf, VIRGL_TILE_MAP_X), get_buf_entry(buf, VIRGL_TILE_MAP_Y),
+                         get_buf_entry(buf, VIRGL_TILE_MAP_Z), get_buf_entry(buf, VIRGL_TILE_MAP_WIDTH),
+                         get_buf_entry(buf, VIRGL_TILE_MAP_HEIGHT), get_buf_entry(buf, VIRGL_TILE_MAP_DEPTH),
+                         get_buf_entry(buf, VIRGL_TILE_MAP_POOL), offset);
+}
+
 static int vrend_decode_resource_copy_region(struct vrend_context *ctx, const uint32_t *buf, uint32_t length)
 {
    struct pipe_box box;
@@ -2049,6 +2061,7 @@ static const vrend_decode_callback decode_table[VIRGL_MAX_COMMANDS] = {
    [VIRGL_CCMD_GET_PIPE_RESOURCE_LAYOUT] = vrend_decode_get_pipe_resource_layout,
    [VIRGL_CCMD_SET_RASTER_SAMPLES] = vrend_decode_set_raster_samples,
    [VIRGL_CCMD_SET_CONSERVATIVE_RASTER] = vrend_decode_set_conservative_raster,
+   [VIRGL_CCMD_TILE_MAP] = vrend_decode_tile_map,
 };
 
