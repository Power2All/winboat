    FEAT(conservative_raster, UNAVAIL, UNAVAIL, "GL_NV_conservative_raster"),
    FEAT(fragment_shader_interlock, UNAVAIL, UNAVAIL, "GL_ARB_fragment_shader_interlock"),
+   FEAT(sparse_texture2, UNAVAIL, UNAVAIL, "GL_ARB_sparse_texture2"),
+   FEAT(sparse_buffer, UNAVAIL, UNAVAIL, "GL_ARB_sparse_buffer"),
