+/* VIRGL_CCMD_SET_RASTER_SAMPLES (WinBoat): rasterization samples apart from the framebuffer's, 0 for the
+ * framebuffer's (D3D 11.1's ForcedSampleCount) */
+#define VIRGL_SET_RASTER_SAMPLES_SIZE 1
+#define VIRGL_SET_RASTER_SAMPLES_COUNT 1
+
 #endif
