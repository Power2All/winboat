+/* Rasterization samples apart from the framebuffer's (GL_EXT_raster_multisample), for the guest's draws only:
+ * enabled around them in vrend_draw_vbo, so that the renderer's own blits and clears don't get them */
+void vrend_set_raster_samples(struct vrend_context *ctx, unsigned samples)
+{
+   if (!has_feature(feat_raster_multisample))
+      return;
+   ctx->sub->raster_samples = samples > 1 ? samples : 0;
+}
