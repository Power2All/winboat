+/*
+ * VA-API takes one slice parameter buffer per slice, and its slice_data_size says how many bytes of the slice data
+ * buffer after it are that slice: NVIDIA's VA-API driver (nvidia-vaapi-driver) copies exactly that many, Mesa's use
+ * them too. The guest sends a picture's slices as one Annex B byte stream (start code, NAL unit, start code, ...):
+ * split it at the start codes and send each NAL unit without its start code (both drivers add their own) after its
+ * own slice parameters. Every codec's slice parameter struct starts with the three slice data fields (WinBoat).
+ */
+struct va_slice_data_fields {
+    uint32_t slice_data_size;
+    uint32_t slice_data_offset;
+    uint32_t slice_data_flag;
+};
+
+static int render_slice(struct virgl_video_codec *codec, void *slice_param, size_t param_size,
+                        const uint8_t *data, unsigned size)
+{
+    struct va_slice_data_fields *fields = slice_param;
+    VABufferID bufs[2];
+    VAStatus va_stat;
+
+    fields->slice_data_size = size;
+    fields->slice_data_offset = 0;
+    fields->slice_data_flag = VA_SLICE_DATA_FLAG_ALL;
+    vaCreateBuffer(va_dpy, codec->va_ctx, VASliceParameterBufferType, param_size, 1, slice_param, &bufs[0]);
+    vaCreateBuffer(va_dpy, codec->va_ctx, VASliceDataBufferType, size, 1, (void *)data, &bufs[1]);
+    va_stat = vaRenderPicture(va_dpy, codec->va_ctx, bufs, 2);
+    vaDestroyBuffer(va_dpy, bufs[0]);
+    vaDestroyBuffer(va_dpy, bufs[1]);
+    if (VA_STATUS_SUCCESS != va_stat) {
+        virgl_error("render slice failed, err = 0x%x\n", va_stat);
+        return -1;
+    }
+    return 0;
+}
+
+static int render_nal_slices(struct virgl_video_codec *codec, void *slice_param, size_t param_size,
+                             unsigned num_buffers, const void * const *buffers, const unsigned *sizes,
+                             bool keep_start_codes,
+                             void (*fill)(void *slice_param, const uint8_t *data, unsigned size))
+{
+    int err = 0;
+
+    for (unsigned b = 0; b < num_buffers; b++) {
+        const uint8_t *p = buffers[b];
+        unsigned size = sizes[b], nal = UINT32_MAX;
+
+        for (unsigned i = 0; i <= size; i++) {
+            bool start_code = i + 2 < size && !p[i] && !p[i + 1] && p[i + 2] == 1;
+            if (!start_code && i < size)
+                continue;
+            /* no start code at all: the buffer is one NAL unit */
+            if (nal == UINT32_MAX && i == size)
+                nal = 0;
+            if (nal != UINT32_MAX) {
+                unsigned end = i;
+                /* the zero byte of the next 4-byte start code */
+                while (end > nal && !p[end - 1])
+                    end--;
+                /* MPEG-2's slices are with their start codes */
+                unsigned start = keep_start_codes && nal >= 3 ? nal - 3 : nal;
+                if (end > nal && fill)
+                    fill(slice_param, p + start, end - start);
+                if (end > nal && render_slice(codec, slice_param, param_size, p + start, end - start))
+                    err = -1;
+            }
+            nal = i + 3;
+            i += 2;
+        }
+    }
+    return err;
+}
