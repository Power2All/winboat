From: WinBoat
Subject: [PATCH] vrend: half-float pack and unpack (TGSI UP2H, PK2H)

Mesa's virgl gives the host TGSI's UP2H and PK2H for GLSL's and SPIR-V's unpackHalf2x16 and packHalf2x16. The shader
translator had no case for them and left them out of the GLSL: the destinations kept zeros. GravityMark's OpenGL
asteroid vertex shader unpacks its normals and tangents that way, so every asteroid was lit black. They are
unpackHalf2x16 and packHalf2x16 now (GL_ARB_shading_language_packing on desktop GL); the operands come as float bits.
---
--- a/src/vrend/vrend_shader.c
+++ b/src/vrend/vrend_shader.c
@@ -88,6 +88,7 @@
 #define SHADER_REQ_FRAGMENT_SHADER_INTERLOCK (1ULL << 43)
 #define SHADER_REQ_SPARSE_TEXTURE2 (1ULL << 44)
 #define SHADER_REQ_SPARSE_TEXTURE_CLAMP (1ULL << 45)
+#define SHADER_REQ_SHADING_LANGUAGE_PACKING (1ULL << 46)
 
 #define FRONT_COLOR_EMITTED (1 << 0)
 #define BACK_COLOR_EMITTED  (1 << 1);
@@ -375,6 +376,7 @@
     { SHADER_REQ_FRAGMENT_SHADER_INTERLOCK, "ARB_fragment_shader_interlock"},
     { SHADER_REQ_SPARSE_TEXTURE2, "ARB_sparse_texture2"},
     { SHADER_REQ_SPARSE_TEXTURE_CLAMP, "ARB_sparse_texture_clamp"},
+    { SHADER_REQ_SHADING_LANGUAGE_PACKING, "ARB_shading_language_packing"},
 };
 
 enum vrend_type_qualifier {
@@ -6156,6 +6158,22 @@
       emit_buff(&ctx->glsl_strbufs, "%s = %s(uintBitsToFloat(bitfieldInsert(%s, %s, int(%s), int(%s))));\n", dsts[0], get_string(dinfo.dstconv), srcs[0], srcs[1], srcs[2], srcs[3]);
       ctx->shader_req_bits |= SHADER_REQ_GPU_SHADER5;
       break;
+   /* WinBoat: two half floats in each 32-bit component, unpacked (dst.xy from src.x, dst.zw from src.y) and packed
+    * back. Mesa's virgl gives them to the host for SPIR-V shaders (unpackHalf2x16 in GravityMark's OpenGL asteroid
+    * vertex shader: its normals and tangents); they were left out of the GLSL, the destinations kept zeros: black
+    * asteroids. The operands come as float bits */
+   case TGSI_OPCODE_UP2H:
+      emit_buff(&ctx->glsl_strbufs, "%s = %s(vec4(unpackHalf2x16(floatBitsToUint(%s.x)), unpackHalf2x16(floatBitsToUint(%s.y)))%s);\n",
+                dsts[0], get_string(dinfo.dstconv), srcs[0], srcs[0], writemask);
+      if (!ctx->cfg->use_gles)
+         ctx->shader_req_bits |= SHADER_REQ_SHADING_LANGUAGE_PACKING;
+      break;
+   case TGSI_OPCODE_PK2H:
+      emit_buff(&ctx->glsl_strbufs, "%s = %s(uintBitsToFloat(uvec4(packHalf2x16(%s.xy), packHalf2x16(%s.zw), packHalf2x16(%s.xy), packHalf2x16(%s.zw)))%s);\n",
+                dsts[0], get_string(dinfo.dstconv), srcs[0], srcs[0], srcs[0], srcs[0], writemask);
+      if (!ctx->cfg->use_gles)
+         ctx->shader_req_bits |= SHADER_REQ_SHADING_LANGUAGE_PACKING;
+      break;
    case TGSI_OPCODE_BREV:
       emit_buff(&ctx->glsl_strbufs, "%s = %s(%s(bitfieldReverse(%s)));\n", dsts[0], get_string(dinfo.dstconv), get_string(dinfo.dtypeprefix), srcs[0]);
       ctx->shader_req_bits |= SHADER_REQ_GPU_SHADER5;
