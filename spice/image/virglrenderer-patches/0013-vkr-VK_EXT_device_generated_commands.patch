+static inline void vn_decode_vkCmdExecuteGeneratedCommandsEXT_args_temp(struct vn_cs_decoder *dec, struct vn_command_vkCmdExecuteGeneratedCommandsEXT *args)
+{
+    vn_decode_VkCommandBuffer_lookup(dec, &args->commandBuffer);
+    vn_decode_VkBool32(dec, &args->isPreprocessed);
+    if (vn_decode_simple_pointer(dec)) {
+        args->pGeneratedCommandsInfo = vn_cs_decoder_alloc_temp(dec, sizeof(*args->pGeneratedCommandsInfo));
+        if (!args->pGeneratedCommandsInfo) return;
+        vn_decode_VkGeneratedCommandsInfoEXT_temp(dec, (VkGeneratedCommandsInfoEXT *)args->pGeneratedCommandsInfo);
+    } else {
+        args->pGeneratedCommandsInfo = NULL;
+        vn_cs_decoder_set_fatal(dec);
+    }
+}
+
+static inline void vn_replace_vkCmdExecuteGeneratedCommandsEXT_args_handle(struct vn_command_vkCmdExecuteGeneratedCommandsEXT *args)
+{
+    vn_replace_VkCommandBuffer_handle(&args->commandBuffer);
+    /* skip args->isPreprocessed */
+    if (args->pGeneratedCommandsInfo)
+        vn_replace_VkGeneratedCommandsInfoEXT_handle((VkGeneratedCommandsInfoEXT *)args->pGeneratedCommandsInfo);
+}
