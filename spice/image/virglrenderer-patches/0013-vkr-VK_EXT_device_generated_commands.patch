+/* struct VkGeneratedCommandsInfoEXT chain */
+
+static inline void *
+vn_decode_VkGeneratedCommandsInfoEXT_pnext_temp(struct vn_cs_decoder *dec)
+{
+    VkBaseOutStructure *pnext;
+    VkStructureType stype;
+
+    if (!vn_decode_simple_pointer(dec))
+        return NULL;
+
+    vn_decode_VkStructureType(dec, &stype);
+    switch ((int32_t)stype) {
+    case VK_STRUCTURE_TYPE_GENERATED_COMMANDS_PIPELINE_INFO_EXT:
+        pnext = vn_cs_decoder_alloc_temp(dec, sizeof(VkGeneratedCommandsPipelineInfoEXT));
+        if (pnext) {
+            pnext->sType = stype;
+            pnext->pNext = vn_decode_VkGeneratedCommandsInfoEXT_pnext_temp(dec);
+            vn_decode_VkGeneratedCommandsPipelineInfoEXT_self_temp(dec, (VkGeneratedCommandsPipelineInfoEXT *)pnext);
+        }
+        break;
+    case VK_STRUCTURE_TYPE_GENERATED_COMMANDS_SHADER_INFO_EXT:
+        pnext = vn_cs_decoder_alloc_temp(dec, sizeof(VkGeneratedCommandsShaderInfoEXT));
+        if (pnext) {
+            pnext->sType = stype;
+            pnext->pNext = vn_decode_VkGeneratedCommandsInfoEXT_pnext_temp(dec);
+            vn_decode_VkGeneratedCommandsShaderInfoEXT_self_temp(dec, (VkGeneratedCommandsShaderInfoEXT *)pnext);
+        }
+        break;
+    default:
+        /* unexpected struct */
+        pnext = NULL;
+        vn_cs_decoder_set_fatal(dec);
+        break;
+    }
+
+    return pnext;
+}
+
+static inline void
+vn_decode_VkGeneratedCommandsInfoEXT_self_temp(struct vn_cs_decoder *dec, VkGeneratedCommandsInfoEXT *val)
+{
+    /* skip val->{sType,pNext} */
+    vn_decode_VkFlags(dec, &val->shaderStages);
+    vn_decode_VkIndirectExecutionSetEXT_lookup(dec, &val->indirectExecutionSet);
+    vn_decode_VkIndirectCommandsLayoutEXT_lookup(dec, &val->indirectCommandsLayout);
+    vn_decode_VkDeviceAddress(dec, &val->indirectAddress);
+    vn_decode_VkDeviceSize(dec, &val->indirectAddressSize);
+    vn_decode_VkDeviceAddress(dec, &val->preprocessAddress);
+    vn_decode_VkDeviceSize(dec, &val->preprocessSize);
+    vn_decode_uint32_t(dec, &val->maxSequenceCount);
+    vn_decode_VkDeviceAddress(dec, &val->sequenceCountAddress);
+    vn_decode_uint32_t(dec, &val->maxDrawCount);
+}
+
+static inline void
+vn_decode_VkGeneratedCommandsInfoEXT_temp(struct vn_cs_decoder *dec, VkGeneratedCommandsInfoEXT *val)
+{
+    VkStructureType stype;
+    vn_decode_VkStructureType(dec, &stype);
+    if (stype != VK_STRUCTURE_TYPE_GENERATED_COMMANDS_INFO_EXT)
+        vn_cs_decoder_set_fatal(dec);
+
+    val->sType = stype;
+    val->pNext = vn_decode_VkGeneratedCommandsInfoEXT_pnext_temp(dec);
+    vn_decode_VkGeneratedCommandsInfoEXT_self_temp(dec, val);
+}
+
+static inline void
+vn_replace_VkGeneratedCommandsInfoEXT_handle_self(VkGeneratedCommandsInfoEXT *val)
+{
+    /* skip val->sType */
+    /* skip val->pNext */
+    /* skip val->shaderStages */
+    vn_replace_VkIndirectExecutionSetEXT_handle(&val->indirectExecutionSet);
+    vn_replace_VkIndirectCommandsLayoutEXT_handle(&val->indirectCommandsLayout);
+    /* skip val->indirectAddress */
+    /* skip val->indirectAddressSize */
+    /* skip val->preprocessAddress */
+    /* skip val->preprocessSize */
+    /* skip val->maxSequenceCount */
+    /* skip val->sequenceCountAddress */
+    /* skip val->maxDrawCount */
+}
+
+static inline void
+vn_replace_VkGeneratedCommandsInfoEXT_handle(VkGeneratedCommandsInfoEXT *val)
+{
+    struct VkBaseOutStructure *pnext = (struct VkBaseOutStructure *)val;
+
+    do {
+        switch ((int32_t)pnext->sType) {
+        case VK_STRUCTURE_TYPE_GENERATED_COMMANDS_INFO_EXT:
+            vn_replace_VkGeneratedCommandsInfoEXT_handle_self((VkGeneratedCommandsInfoEXT *)pnext);
+            break;
+        case VK_STRUCTURE_TYPE_GENERATED_COMMANDS_PIPELINE_INFO_EXT:
+            vn_replace_VkGeneratedCommandsPipelineInfoEXT_handle_self((VkGeneratedCommandsPipelineInfoEXT *)pnext);
+            break;
+        case VK_STRUCTURE_TYPE_GENERATED_COMMANDS_SHADER_INFO_EXT:
+            vn_replace_VkGeneratedCommandsShaderInfoEXT_handle_self((VkGeneratedCommandsShaderInfoEXT *)pnext);
+            break;
+        default:
+            /* ignore unknown/unsupported struct */
+            break;
+        }
+        pnext = pnext->pNext;
+    } while (pnext);
+}
