diff --git a/src/venus/vkr_video.c b/src/venus/vkr_video.c
new file mode 100644
index 0000000..21c3aa1
--- /dev/null
+++ b/src/venus/vkr_video.c
@@ -0,0 +1,198 @@
+/*
+ * Copyright 2026 WinBoat
+ * SPDX-License-Identifier: MIT
+ *
+ * Vulkan Video (VK_KHR_video_queue, video_decode/encode_queue, H.264 and H.265): the commands go to the host
+ * driver as they are, with handles translated; sessions and their parameters are tracked like other objects.
+ */
+
+#include "vkr_video.h"
+
+#include "vkr_command_buffer.h"
+#include "vkr_device.h"
+#include "vkr_physical_device.h"
+#include "vkr_video_gen.h"
+#include "venus-protocol/vn_protocol_renderer_command_buffer.h"
+
+#define VKR_PHYSICAL_DEVICE_CALL(name, args, ...)                                        \
+   do {                                                                                  \
+      struct vkr_physical_device *_pdev =                                                \
+         vkr_physical_device_from_handle(args->physicalDevice);                          \
+      vn_replace_vk##name##_args_handle(args);                                           \
+      args->ret = _pdev->proc_table.name(args->physicalDevice, __VA_ARGS__);              \
+   } while (0)
+
+#define VKR_DEVICE_CALL(name, args, ...)                                                 \
+   do {                                                                                  \
+      struct vkr_device *_dev = vkr_device_from_handle(args->device);                    \
+      vn_replace_vk##name##_args_handle(args);                                           \
+      args->ret = _dev->proc_table.name(args->device, __VA_ARGS__);                       \
+   } while (0)
+
+#define VKR_CMD_CALL(name, args, ...)                                                    \
+   do {                                                                                  \
+      struct vkr_command_buffer *_cmd =                                                  \
+         vkr_command_buffer_from_handle(args->commandBuffer);                            \
+      vn_replace_vk##name##_args_handle(args);                                           \
+      _cmd->device->proc_table.name(args->commandBuffer, __VA_ARGS__);                    \
+   } while (0)
+
+static void
+vkr_dispatch_vkGetPhysicalDeviceVideoCapabilitiesKHR(
+   UNUSED struct vn_dispatch_context *dispatch,
+   struct vn_command_vkGetPhysicalDeviceVideoCapabilitiesKHR *args)
+{
+   VKR_PHYSICAL_DEVICE_CALL(GetPhysicalDeviceVideoCapabilitiesKHR, args, args->pVideoProfile,
+                            args->pCapabilities);
+}
+
+static void
+vkr_dispatch_vkGetPhysicalDeviceVideoFormatPropertiesKHR(
+   UNUSED struct vn_dispatch_context *dispatch,
+   struct vn_command_vkGetPhysicalDeviceVideoFormatPropertiesKHR *args)
+{
+   VKR_PHYSICAL_DEVICE_CALL(GetPhysicalDeviceVideoFormatPropertiesKHR, args,
+                            args->pVideoFormatInfo, args->pVideoFormatPropertyCount,
+                            args->pVideoFormatProperties);
+}
+
+static void
+vkr_dispatch_vkGetPhysicalDeviceVideoEncodeQualityLevelPropertiesKHR(
+   UNUSED struct vn_dispatch_context *dispatch,
+   struct vn_command_vkGetPhysicalDeviceVideoEncodeQualityLevelPropertiesKHR *args)
+{
+   VKR_PHYSICAL_DEVICE_CALL(GetPhysicalDeviceVideoEncodeQualityLevelPropertiesKHR, args,
+                            args->pQualityLevelInfo, args->pQualityLevelProperties);
+}
+
+static void
+vkr_dispatch_vkCreateVideoSessionKHR(struct vn_dispatch_context *dispatch,
+                                     struct vn_command_vkCreateVideoSessionKHR *args)
+{
+   vkr_video_session_create_and_add(dispatch->data, args);
+}
+
+static void
+vkr_dispatch_vkDestroyVideoSessionKHR(struct vn_dispatch_context *dispatch,
+                                      struct vn_command_vkDestroyVideoSessionKHR *args)
+{
+   vkr_video_session_destroy_and_remove(dispatch->data, args);
+}
+
+static void
+vkr_dispatch_vkGetVideoSessionMemoryRequirementsKHR(
+   UNUSED struct vn_dispatch_context *dispatch,
+   struct vn_command_vkGetVideoSessionMemoryRequirementsKHR *args)
+{
+   VKR_DEVICE_CALL(GetVideoSessionMemoryRequirementsKHR, args, args->videoSession,
+                   args->pMemoryRequirementsCount, args->pMemoryRequirements);
+}
+
+static void
+vkr_dispatch_vkBindVideoSessionMemoryKHR(UNUSED struct vn_dispatch_context *dispatch,
+                                         struct vn_command_vkBindVideoSessionMemoryKHR *args)
+{
+   VKR_DEVICE_CALL(BindVideoSessionMemoryKHR, args, args->videoSession,
+                   args->bindSessionMemoryInfoCount, args->pBindSessionMemoryInfos);
+}
+
+static void
+vkr_dispatch_vkCreateVideoSessionParametersKHR(
+   struct vn_dispatch_context *dispatch,
+   struct vn_command_vkCreateVideoSessionParametersKHR *args)
+{
+   vkr_video_session_parameters_create_and_add(dispatch->data, args);
+}
+
+static void
+vkr_dispatch_vkUpdateVideoSessionParametersKHR(
+   UNUSED struct vn_dispatch_context *dispatch,
+   struct vn_command_vkUpdateVideoSessionParametersKHR *args)
+{
+   VKR_DEVICE_CALL(UpdateVideoSessionParametersKHR, args, args->videoSessionParameters,
+                   args->pUpdateInfo);
+}
+
+static void
+vkr_dispatch_vkDestroyVideoSessionParametersKHR(
+   struct vn_dispatch_context *dispatch,
+   struct vn_command_vkDestroyVideoSessionParametersKHR *args)
+{
+   vkr_video_session_parameters_destroy_and_remove(dispatch->data, args);
+}
+
+static void
+vkr_dispatch_vkGetEncodedVideoSessionParametersKHR(
+   UNUSED struct vn_dispatch_context *dispatch,
+   struct vn_command_vkGetEncodedVideoSessionParametersKHR *args)
+{
+   VKR_DEVICE_CALL(GetEncodedVideoSessionParametersKHR, args,
+                   args->pVideoSessionParametersInfo, args->pFeedbackInfo, args->pDataSize,
+                   args->pData);
+}
+
+static void
+vkr_dispatch_vkCmdBeginVideoCodingKHR(UNUSED struct vn_dispatch_context *dispatch,
+                                      struct vn_command_vkCmdBeginVideoCodingKHR *args)
+{
+   VKR_CMD_CALL(CmdBeginVideoCodingKHR, args, args->pBeginInfo);
+}
+
+static void
+vkr_dispatch_vkCmdEndVideoCodingKHR(UNUSED struct vn_dispatch_context *dispatch,
+                                    struct vn_command_vkCmdEndVideoCodingKHR *args)
+{
+   VKR_CMD_CALL(CmdEndVideoCodingKHR, args, args->pEndCodingInfo);
+}
+
+static void
+vkr_dispatch_vkCmdControlVideoCodingKHR(UNUSED struct vn_dispatch_context *dispatch,
+                                        struct vn_command_vkCmdControlVideoCodingKHR *args)
+{
+   VKR_CMD_CALL(CmdControlVideoCodingKHR, args, args->pCodingControlInfo);
+}
+
+static void
+vkr_dispatch_vkCmdDecodeVideoKHR(UNUSED struct vn_dispatch_context *dispatch,
+                                 struct vn_command_vkCmdDecodeVideoKHR *args)
+{
+   VKR_CMD_CALL(CmdDecodeVideoKHR, args, args->pDecodeInfo);
+}
+
+static void
+vkr_dispatch_vkCmdEncodeVideoKHR(UNUSED struct vn_dispatch_context *dispatch,
+                                 struct vn_command_vkCmdEncodeVideoKHR *args)
+{
+   VKR_CMD_CALL(CmdEncodeVideoKHR, args, args->pEncodeInfo);
+}
+
+void
+vkr_context_init_video_dispatch(struct vkr_context *ctx)
+{
+   struct vn_dispatch_context *dispatch = &ctx->dispatch;
+
+   dispatch->dispatch_vkGetPhysicalDeviceVideoCapabilitiesKHR =
+      vkr_dispatch_vkGetPhysicalDeviceVideoCapabilitiesKHR;
+   dispatch->dispatch_vkGetPhysicalDeviceVideoFormatPropertiesKHR =
+      vkr_dispatch_vkGetPhysicalDeviceVideoFormatPropertiesKHR;
+   dispatch->dispatch_vkGetPhysicalDeviceVideoEncodeQualityLevelPropertiesKHR =
+      vkr_dispatch_vkGetPhysicalDeviceVideoEncodeQualityLevelPropertiesKHR;
+   dispatch->dispatch_vkCreateVideoSessionKHR = vkr_dispatch_vkCreateVideoSessionKHR;
+   dispatch->dispatch_vkDestroyVideoSessionKHR = vkr_dispatch_vkDestroyVideoSessionKHR;
+   dispatch->dispatch_vkGetVideoSessionMemoryRequirementsKHR =
+      vkr_dispatch_vkGetVideoSessionMemoryRequirementsKHR;
+   dispatch->dispatch_vkBindVideoSessionMemoryKHR = vkr_dispatch_vkBindVideoSessionMemoryKHR;
+   dispatch->dispatch_vkCreateVideoSessionParametersKHR =
+      vkr_dispatch_vkCreateVideoSessionParametersKHR;
+   dispatch->dispatch_vkUpdateVideoSessionParametersKHR =
+      vkr_dispatch_vkUpdateVideoSessionParametersKHR;
+   dispatch->dispatch_vkDestroyVideoSessionParametersKHR =
+      vkr_dispatch_vkDestroyVideoSessionParametersKHR;
+   dispatch->dispatch_vkGetEncodedVideoSessionParametersKHR =
+      vkr_dispatch_vkGetEncodedVideoSessionParametersKHR;
+   dispatch->dispatch_vkCmdBeginVideoCodingKHR = vkr_dispatch_vkCmdBeginVideoCodingKHR;
+   dispatch->dispatch_vkCmdEndVideoCodingKHR = vkr_dispatch_vkCmdEndVideoCodingKHR;
+   dispatch->dispatch_vkCmdControlVideoCodingKHR = vkr_dispatch_vkCmdControlVideoCodingKHR;
+   dispatch->dispatch_vkCmdDecodeVideoKHR = vkr_dispatch_vkCmdDecodeVideoKHR;
+   dispatch->dispatch_vkCmdEncodeVideoKHR = vkr_dispatch_vkCmdEncodeVideoKHR;
+}
