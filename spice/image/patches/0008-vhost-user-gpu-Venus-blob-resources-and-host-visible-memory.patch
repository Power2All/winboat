+static void
+virgl_cmd_resource_create_blob(VuGpu *g,
+                               struct virtio_gpu_ctrl_command *cmd)
+{
+    struct virgl_renderer_resource_create_blob_args args = { 0 };
+    struct virtio_gpu_resource_create_blob cblob;
+    struct iovec *iovs = NULL;
+    struct vg_blob *blob;
+    int ret;
+
+    if (!g->venus) {
+        cmd->error = VIRTIO_GPU_RESP_ERR_UNSPEC;
+        return;
+    }
+
+    VUGPU_FILL_CMD(cblob);
+
+    if (cblob.resource_id == 0 ||
+        g_hash_table_contains(g->blobs, GUINT_TO_POINTER(cblob.resource_id))) {
+        cmd->error = VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID;
+        return;
+    }
+
+    /* Blobs in (or mirrored to) the guest's memory come with its pages */
+    if (cblob.blob_mem != VIRTIO_GPU_BLOB_MEM_HOST3D && cblob.nr_entries) {
+        if (vg_create_mapping_iov_at(g, cblob.resource_id, cblob.nr_entries,
+                                     sizeof(cblob), cmd, &iovs) != 0) {
+            cmd->error = VIRTIO_GPU_RESP_ERR_UNSPEC;
+            return;
+        }
+    }
+
+    args.res_handle = cblob.resource_id;
+    args.ctx_id = cblob.hdr.ctx_id;
+    args.blob_mem = cblob.blob_mem;
+    args.blob_id = cblob.blob_id;
+    args.blob_flags = cblob.blob_flags;
+    args.size = cblob.size;
+    args.iovecs = iovs;
+    args.num_iovs = iovs ? cblob.nr_entries : 0;
+
+    ret = virgl_renderer_resource_create_blob(&args);
+    if (ret) {
+        g_warning("%s: resource %u: %s", __func__, cblob.resource_id,
+                  strerror(-ret));
+        if (iovs) {
+            vg_cleanup_mapping_iov(g, iovs, cblob.nr_entries);
+        }
+        cmd->error = VIRTIO_GPU_RESP_ERR_UNSPEC;
+        return;
+    }
+
+    blob = g_new0(struct vg_blob, 1);
+    blob->size = cblob.size;
+    g_hash_table_insert(g->blobs, GUINT_TO_POINTER(cblob.resource_id), blob);
+}
+
+/*
+ * The frontend maps the blob's memory (a dma-buf or shared memory file) into
+ * the device's host-visible memory window at the offset the guest chose
+ */
+static void
+virgl_cmd_resource_map_blob(VuGpu *g,
+                            struct virtio_gpu_ctrl_command *cmd)
+{
+    struct virtio_gpu_resource_map_blob mblob;
+    struct virtio_gpu_resp_map_info resp;
+    struct vg_blob *blob;
+    uint32_t fd_type;
+    int fd = -1;
+
+    VUGPU_FILL_CMD(mblob);
+
+    blob = g_hash_table_lookup(g->blobs, GUINT_TO_POINTER(mblob.resource_id));
+    if (!blob || blob->mapped) {
+        cmd->error = VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID;
+        return;
+    }
+
+    if (virgl_renderer_resource_export_blob(mblob.resource_id, &fd_type, &fd)
+        || fd < 0) {
+        g_warning("%s: resource %u can't be exported", __func__,
+                  mblob.resource_id);
+        cmd->error = VIRTIO_GPU_RESP_ERR_UNSPEC;
+        return;
+    }
+    if (fd_type != VIRGL_RENDERER_BLOB_FD_TYPE_DMABUF &&
+        fd_type != VIRGL_RENDERER_BLOB_FD_TYPE_SHM) {
+        g_warning("%s: resource %u: fd type %u can't be mapped", __func__,
+                  mblob.resource_id, fd_type);
+        close(fd);
+        cmd->error = VIRTIO_GPU_RESP_ERR_UNSPEC;
+        return;
+    }
+
+    if (!vu_shmem_map(&g->dev.parent, VIRTIO_GPU_SHM_ID_HOST_VISIBLE, 0,
+                      mblob.offset, blob->size, VHOST_USER_FLAG_MAP_RW, fd)) {
+        g_warning("%s: mapping resource %u at 0x%" PRIx64 " failed", __func__,
+                  mblob.resource_id, mblob.offset);
+        close(fd);
+        cmd->error = VIRTIO_GPU_RESP_ERR_UNSPEC;
+        return;
+    }
+    close(fd);
+    blob->offset = mblob.offset;
+    blob->mapped = true;
+
+    memset(&resp, 0, sizeof(resp));
+    resp.hdr.type = VIRTIO_GPU_RESP_OK_MAP_INFO;
+    virgl_renderer_resource_get_map_info(mblob.resource_id, &resp.map_info);
+    vg_ctrl_response(g, cmd, &resp.hdr, sizeof(resp));
+}
+
+static void
+virgl_cmd_resource_unmap_blob(VuGpu *g,
+                              struct virtio_gpu_ctrl_command *cmd)
+{
+    struct virtio_gpu_resource_unmap_blob ublob;
+    struct vg_blob *blob;
+
+    VUGPU_FILL_CMD(ublob);
+
+    blob = g_hash_table_lookup(g->blobs, GUINT_TO_POINTER(ublob.resource_id));
+    if (!blob || !blob->mapped) {
+        cmd->error = VIRTIO_GPU_RESP_ERR_INVALID_RESOURCE_ID;
+        return;
+    }
+    if (!vu_shmem_unmap(&g->dev.parent, VIRTIO_GPU_SHM_ID_HOST_VISIBLE,
+                        blob->offset, blob->size)) {
+        cmd->error = VIRTIO_GPU_RESP_ERR_UNSPEC;
+        return;
+    }
+    blob->mapped = false;
+}
