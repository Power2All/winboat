+
+/* The capsets the guest can use, in the order it enumerates them */
+static uint32_t
+vg_virgl_capsets(VuGpu *g, uint32_t *ids)
+{
+    uint32_t n = 0, max_ver, max_size;
+
+    ids[n++] = VIRTIO_GPU_CAPSET_VIRGL;
+    virgl_renderer_get_cap_set(VIRTIO_GPU_CAPSET_VIRGL2, &max_ver, &max_size);
+    if (max_ver) {
+        ids[n++] = VIRTIO_GPU_CAPSET_VIRGL2;
+    }
+    if (g->venus) {
+        virgl_renderer_get_cap_set(VIRTIO_GPU_CAPSET_VENUS, &max_ver,
+                                   &max_size);
+        if (max_size) {
+            ids[n++] = VIRTIO_GPU_CAPSET_VENUS;
+        }
+    }
+    return n;
+}
