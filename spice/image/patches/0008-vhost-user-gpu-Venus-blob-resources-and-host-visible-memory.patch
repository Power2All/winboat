+/* A blob resource, and where it is mapped in the host-visible memory window */
+struct vg_blob {
+    uint64_t size;
+    uint64_t offset;
+    bool mapped;
+};
+
+static void
+vg_blob_forget(VuGpu *g, uint32_t resource_id)
+{
+    struct vg_blob *blob;
+
+    blob = g_hash_table_lookup(g->blobs, GUINT_TO_POINTER(resource_id));
+    if (!blob) {
+        return;
+    }
+    if (blob->mapped &&
+        !vu_shmem_unmap(&g->dev.parent, VIRTIO_GPU_SHM_ID_HOST_VISIBLE,
+                        blob->offset, blob->size)) {
+        g_warning("%s: unmapping resource %u failed", __func__, resource_id);
+    }
+    g_hash_table_remove(g->blobs, GUINT_TO_POINTER(resource_id));
+}
