av1: film grain, the grain-free reference on a decode surface of its own (WinBoat)

NVDEC writes a picture with film grain applied to CurrPicIdx and the picture
without it, which later frames reference, to decodePicIdx. Both were the
render target's index, and the output came out without grain. VA-API's
current_display_picture would name the surface for the grained picture, but
virglrenderer (WinBoat's guests decode through it) has one surface per
picture. So a picture that applies grain keeps its grain-free version on a
decode surface of its own while a reference slot holds it, taken from the
indices the surfaces didn't (an AV1 decoder now has NVDEC's maximum of 32),
and references map to it.

diff --git a/src/av1.c b/src/av1.c
index 0957165..5eacf07 100644
--- a/src/av1.c
+++ b/src/av1.c
@@ -11,6 +11,64 @@ static int get_relative_dist(CUVIDAV1PICPARAMS *pps, int ref_hint, int order_hin
     return (diff & (m - 1)) - (diff & m);
 }
 
+//Film grain: NVDEC writes the picture with grain to CurrPicIdx and the one without, which later frames reference, to
+//decodePicIdx. VA-API's current_display_picture would be the surface for the former, but virglrenderer (WinBoat's
+//client) has one surface per picture and doesn't pass a surface there, so the grain-free picture gets a decode surface
+//of its own while it's referenced (the 8 reference slots and the current picture at most), from those the surfaces'
+//pictureIdx didn't take. ponytail: a client with a separate current_display_picture gets the upstream behavior (no grain)
+static int av1RefIdx(NVDriver *drv, VASurfaceID id) {
+    NVSurface *surf = nvSurfaceFromSurfaceId(drv, id);
+    if (surf == NULL) {
+        return -1;
+    }
+    return surf->refPictureIdx >= 0 ? surf->refPictureIdx : surf->pictureIdx;
+}
+
+static void av1ReleaseGrainIdx(NVContext *ctx, int idx) {
+    NVSurface *owner = nvSurfaceFromSurfaceId(ctx->drv, ctx->grainIdxOwner[idx]);
+    if (owner != NULL && owner->refPictureIdx == idx) {
+        owner->refPictureIdx = -1;
+    }
+    ctx->grainIdxUsed &= ~(1u << idx);
+}
+
+static void av1GrainFreePicture(NVContext *ctx, VADecPictureParameterBufferAV1 *buf, CUVIDAV1PICPARAMS *pps) {
+    //the grain-free pictures no longer referenced (the current surface's own is reused)
+    for (int i = 0; i < ctx->decodeSurfaceCount; i++) {
+        if (!(ctx->grainIdxUsed & (1u << i)) || ctx->grainIdxOwner[i] == ctx->renderTargetId) {
+            continue;
+        }
+        bool referenced = false;
+        for (int j = 0; j < 8; j++) {
+            referenced |= buf->ref_frame_map[j] == ctx->grainIdxOwner[i];
+        }
+        if (!referenced) {
+            av1ReleaseGrainIdx(ctx, i);
+        }
+    }
+    NVSurface *target = ctx->renderTarget;
+    if (!pps->apply_grain) {
+        if (target->refPictureIdx >= 0) {
+            av1ReleaseGrainIdx(ctx, target->refPictureIdx);
+        }
+        return;
+    }
+    int idx = target->refPictureIdx;
+    for (int i = ctx->decodeSurfaceCount - 1; idx < 0 && i >= 0; i--) {
+        if (!((ctx->pictureIdxUsed | ctx->grainIdxUsed) & (1u << i))) {
+            idx = i;
+        }
+    }
+    if (idx < 0) {
+        LOG("No decode surface left for the picture without film grain, not applying it");
+        return;
+    }
+    ctx->grainIdxUsed |= 1u << idx;
+    ctx->grainIdxOwner[idx] = ctx->renderTargetId;
+    target->refPictureIdx = idx;
+    pps->decodePicIdx = idx;
+}
+
 static void copyAV1PicParam(NVContext *ctx, NVBuffer* buffer, CUVIDPICPARAMS *picParams) {
     static const int bit_depth_map[] = {0, 2, 4}; //8-bpc, 10-bpc, 12-bpc
 
@@ -152,7 +210,7 @@ static void copyAV1PicParam(NVContext *ctx, NVBuffer* buffer, CUVIDPICPARAMS *pi
 
     for (int i = 0; i < 8; i++) { //MAX_REF_FRAMES
         pps->loop_filter_ref_deltas[i] = buf->ref_deltas[i];
-        pps->ref_frame_map[i] = pictureIdxFromSurfaceId(ctx->drv, buf->ref_frame_map[i]);
+        pps->ref_frame_map[i] = av1RefIdx(ctx->drv, buf->ref_frame_map[i]);
     }
 
     pps->base_qindex = buf->base_qindex;
@@ -298,6 +356,7 @@ static void copyAV1PicParam(NVContext *ctx, NVBuffer* buffer, CUVIDPICPARAMS *pi
             pps->ar_coeffs_cr[i] = buf->film_grain_info.ar_coeffs_cr[i];
         }
     }
+    av1GrainFreePicture(ctx, buf, pps);
 
     //printCUVIDPICPARAMS(picParams);
 }
