direct: the decoded frame's planes at the decoder's height (WinBoat)

copyFrameToSurface copied each plane of the mapped NVDEC frame from rows
surface->height apart, but the mapped frame's planes are the decoder's height
apart. With surfaces taller than the decoder's pictures (ffmpeg's d3d11va pads
HEVC surfaces to 128 rows: 1280x768 for 720p; WinBoat's guests decode into
those) the chroma plane was read from below the picture, and came out empty.
Copy the planes of the decoder's height, from where they are.

diff --git a/src/direct/direct-export-buf.c b/src/direct/direct-export-buf.c
index 47843e9..54ebfd4 100644
--- a/src/direct/direct-export-buf.c
+++ b/src/direct/direct-export-buf.c
@@ -289,6 +289,12 @@ static void direct_destroyAllBackingImage(NVDriver *drv) {
 static bool copyFrameToSurface(NVDriver *drv, CUdeviceptr ptr, NVSurface *surface, uint32_t pitch) {
     const NVFormatInfo *fmtInfo = &formatsInfo[surface->backingImage->format];
     uint32_t y = 0;
+    //the mapped frame's planes are the decoder's height apart, which can be less than the surface's (surfaces padded
+    //beyond the picture: the chroma plane was read from below it)
+    uint32_t height = surface->height;
+    if (surface->context != NULL && surface->context->height != 0 && surface->context->height < height) {
+        height = surface->context->height;
+    }
 
     for (uint32_t i = 0; i < fmtInfo->numPlanes; i++) {
         const NVFormatPlane *p = &fmtInfo->plane[i];
@@ -299,7 +305,7 @@ static bool copyFrameToSurface(NVDriver *drv, CUdeviceptr ptr, NVSurface *surfac
             .srcPitch = pitch,
             .dstMemoryType = CU_MEMORYTYPE_ARRAY,
             .dstArray = surface->backingImage->arrays[i],
-            .Height = surface->height >> p->ss.y,
+            .Height = height >> p->ss.y,
             .WidthInBytes = (surface->width >> p->ss.x) * fmtInfo->bppc * p->channelCount
         };
         if (i == fmtInfo->numPlanes - 1) {
@@ -307,7 +313,7 @@ static bool copyFrameToSurface(NVDriver *drv, CUdeviceptr ptr, NVSurface *surfac
         } else {
             CHECK_CUDA_RESULT(drv->cu->cuMemcpy2DAsync(&cpy, 0));
         }
-        y += surface->height >> p->ss.y;
+        y += ((height + 1) & ~1u) >> p->ss.y;
     }
 
     //notify anyone waiting for us to be resolved
